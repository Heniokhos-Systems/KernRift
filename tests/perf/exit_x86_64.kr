// The x86_64 Linux exits of the perf ports (xor edi,edi / mov edi,1; mov eax,60; syscall),
// as raw bytes: KR's x86 assembler does not take `mov rdi, 0` (spec 8.5).
fn pe_exit_ok() {
    asm { "0x31 0xFF 0xB8 0x3C 0x00 0x00 0x00 0x0F 0x05" }
}
fn pe_exit_bad() {
    asm { "0xBF 0x01 0x00 0x00 0x00 0xB8 0x3C 0x00 0x00 0x00 0x0F 0x05" }
}
