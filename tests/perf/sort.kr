// Port of benchmarks/sort.kr: bubble sort of a descending array. The array is
// a local (stack) array passed by address: static arrays crash arm64
// --freestanding --target=windows images (a pre-existing defect, see README).
fn fill(uint64 a, uint64 n) {
    uint64 i = 0
    while i < n { store64(a + i * 8, n - i)  i = i + 1 }
}
fn bubble(uint64 a, uint64 n) {
    uint64 swapped = 1
    while swapped != 0 {
        swapped = 0
        uint64 i = 0
        while i < n - 1 {
            uint64 x = load64(a + i * 8)
            uint64 y = load64(a + i * 8 + 8)
            if x > y { store64(a + i * 8, y)  store64(a + i * 8 + 8, x)  swapped = 1 }
            i = i + 1
        }
    }
}
fn check(uint64 a, uint64 n) -> uint64 {
    uint64 i = 0
    while i < n { if load64(a + i * 8) != i + 1 { return 0 }  i = i + 1 }
    return 1
}
fn main() {
    uint64[500] a
    fill(a, 500)
    bubble(a, 500)
    if check(a, 500) == 1 { pe_exit_ok() }
    pe_exit_bad()
}
