# C1 option-compatibility matrix (#233 #234/#129 #236 #237 #238 #240 #244 #253 #254 #257 #258 #259).
# One suite row per line, run by the c1_* block of tests/run_tests.sh with the RAW compiler
# ($KRC_RAW: `make test`'s $KRC injects --arch=, which would change what every line asks for).
#
#   name|flags|expect|arch_id|source
#
# name: [A-Za-z0-9_] only (the native corpus tooling reads no other name): a spelling's "-" is
# written "_", and linux-x86-64 as linux_x86dash64 (linux-x86_64 is already linux_x86_64).
# source: a path from the repository root (empty = tests/fixtures/c1/p.kr, exit 42).
# expect:
#   <container token>  tests/helpers/container_kind.py's verdict on the output (elf-exec-x86_64,
#                      pe-exe-arm64, macho-obj-x86_64, krbo-8, text, ...); exit 0.
#                      arch_id N: the same flags (-g dropped) build `sink = get_arch_id()` and
#                      `sink = N` (tests/fixtures/c1/arch_e.kr, arch_e_bm.kr for bm.kr rows)
#                      to byte-identical files -- the code's folded OS and arch, not only the
#                      container (1/2 Linux x86_64/arm64, 3/4 Windows, 5/6 macOS, 7/8 Android
#                      arm64/x86_64, 9/10 --target=none).
#   refuse:<line>      exit 1, no output file, stderr's FIRST line is exactly <line>.
#   refnote:<slice>    exit 1, no output, a located error (file:line:col: error:) and, as the LAST
#                      stderr line and exactly once, the fat-slice note naming <slice>.
#   refnoteu:<slice>   the same with an unlocated error (a line starting `error: `).
#   ir:<flags>         exit 0, an IR dump on stdout identical to the dump <flags> print.
#   krbo:<names>       exit 0, a fat binary whose slices are exactly <names> (krbo_slices.py).
#   control:<N>        `sink = N` and `sink = N+1` built with the flags DIFFER: the arch_id probe
#                      can fail in this container family.
#   name:<file>        run in an empty directory with no -o: exactly <file> appears.
#   oname:<file>       the same with the row's own -o (source first; a leading check/lc
#                      subcommand stays first); empty <file> = nothing may appear.
#   orefuse:<line>     no -o of the runner's: exit 1, nothing written, first stderr line <line>.
c1_noarch_none_noemit||krbo-8||
c1_noarch_none_elfexe|--emit=elfexe|elf-exec-x86_64|1|
c1_noarch_none_macho|--emit=macho|macho-exe-x86_64|5|
c1_noarch_none_pe|--emit=pe|pe-exe-x86_64|3|
c1_noarch_none_android|--emit=android|elf-android-arm64|7|
