// #143 A19d(ii) differential gate: exec_process from an SP-moving function;
// the process exits with the child's status (7).
fn run(u64 x) -> u64 {
    asm { "nop" }
    u64 av = alloc(32)
    store64(av, "child.exe")
    store64(av + 8, 0)
    return exec_process("child.exe") + x
}
fn main() {
    run(0)
}
