// Print-free probes for tests/helpers/win_file_err_shape.py: each sh_*
// function holds one Windows I/O builtin (or alloc), so the helper can check
// the lowering of exactly that builtin, located by its label in the
// --emit=asm listing. Never run; main only keeps every probe alive.

fn sh_read(uint64 fd, uint64 b, uint64 n) -> uint64 {
    return file_read(fd, b, n)
}

fn sh_size(uint64 fd) -> uint64 {
    return file_size(fd)
}

fn sh_write(uint64 fd, uint64 b, uint64 n) -> uint64 {
    return write(fd, b, n)
}

fn sh_fwrite(uint64 fd, uint64 b, uint64 n) -> uint64 {
    return file_write(fd, b, n)
}

fn sh_alloc(uint64 n) -> uint64 {
    return alloc(n)
}

fn main() -> uint32 {
    uint64 b = sh_alloc(16)
    uint64 x = sh_fwrite(1, "ab", 2) + sh_write(1, "cd", 2)
    x = x + sh_size(0) + sh_read(0, b, 4)
    uint32 rc = x & 0x7F
    return rc
}
