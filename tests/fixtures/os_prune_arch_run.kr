// Hosted Linux: the x86_64 build must exit 1, the arm64 build 2 (the
// get_arch_id ids from docs/LANGUAGE.md). Any other id, or a pruned arm the
// program would have taken, gives a different status.
fn main() -> uint32 {
    uint64 r = 0
    if get_arch_id() == 1 {
        r = 1
    } else if get_arch_id() == 2 {
        r = 2
    } else {
        r = 64
    }
    exit(r)
    return 0
}
