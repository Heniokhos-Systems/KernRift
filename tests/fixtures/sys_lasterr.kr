// std/sys.kr (arsh Stage 1b, spec S1): sys_last_errno after a failed
// file_open, called IMMEDIATELY (nothing in between may reach Win32).
// argv[1] does not exist -> "missing 2". argv[2], when given (the Wine row),
// is a file a second process holds with share mode 0 -> "held 16" (EBUSY):
// on Windows file_open is INVALID_HANDLE_VALUE for every cause, and only
// GetLastError() tells "held" from "missing".
import "../../std/sys.kr"
import "../../std/args.kr"

fn le_dec(uint64 v) {
    u8[24] d
    uint64 dp = d
    uint64 k = 0
    if v == 0 { file_write(1, "0", 1) }
    while v != 0 { store8(dp + k, 48 + v % 10)  v = v / 10  k = k + 1 }
    while k != 0 { k = k - 1  file_write(1, dp + k, 1) }
}

fn main() -> uint32 {
    uint64 p1 = sys_arg(1)
    if p1 == 0 { return 1 }
    uint64 fd = file_open(p1, 0)
    uint64 e = sys_last_errno(fd)
    file_write(1, "missing ", 8)  le_dec(e)  file_write(1, "\n", 1)
    if sys_argc() > 2 {
        uint64 p2 = sys_arg(2)
        uint64 h = file_open(p2, 0)
        uint64 e2 = sys_last_errno(h)
        file_write(1, "held ", 5)  le_dec(e2)  file_write(1, "\n", 1)
    }
    return 0
}
