// #143 option C emitter-coverage set (spec 2.5.1 check 2; plan A19g): an
// arm64 asm block that moves SP (sub/add sp). Row pe_unwind_sp_sites_reached;
// manifest.txt says which site ids it reaches on which backend.
fn site(uint64 x) -> uint64 {
    asm { "sub sp, sp, #16"; "add sp, sp, #16" }
    return x
}
fn main() { exit(site(3) & 0) }
