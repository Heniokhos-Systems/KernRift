// #143 option C emitter-coverage set (spec 2.5.1 check 2; plan A19g):
// exec_process_argv. Row pe_unwind_sp_sites_reached; manifest.txt says which
// site ids it reaches on which backend.
fn site(uint64 x) -> uint64 {
    uint64 av = alloc(16)
    store64(av, "child.exe")
    store64(av + 8, 0)
    return exec_process_argv("child.exe", av) + x
}
fn main() { exit(site(3) & 0) }
