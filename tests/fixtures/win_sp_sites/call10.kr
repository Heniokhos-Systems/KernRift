// #143 option C emitter-coverage set (spec 2.5.1 check 2; plan A19g): a named
// call with 10 arguments. Row pe_unwind_sp_sites_reached; manifest.txt says
// which site ids it reaches on which backend.
fn g10(uint64 a, uint64 b, uint64 c, uint64 d, uint64 e, uint64 f, uint64 g, uint64 h, uint64 i, uint64 j) -> uint64 {
    if a == 99 { return 0 }
    return a + j
}
fn site(uint64 x) -> uint64 {
    return g10(x, 1, 2, 3, 4, 5, 6, 7, 8, 9)
}
fn main() { exit(site(3) & 0) }
