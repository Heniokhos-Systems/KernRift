// #143 option C emitter-coverage set (spec 2.5.1 check 2; plan A19g):
// get_module_path. Row pe_unwind_sp_sites_reached; manifest.txt says which
// site ids it reaches on which backend.
fn site(uint64 x) -> uint64 {
    u8[256] b
    return get_module_path(b, 256) + x
}
fn main() { exit(site(3) & 0) }
