// #143 option C emitter-coverage set (spec 2.5.1 check 2; plan A19g): alloc
// and dealloc from a non-main function. Row pe_unwind_sp_sites_reached;
// manifest.txt says which site ids it reaches on which backend.
fn site(uint64 x) -> uint64 {
    uint64 p = alloc(64)
    store64(p, x)
    uint64 v = load64(p)
    dealloc(p)
    return v
}
fn main() { exit(site(3) & 0) }
