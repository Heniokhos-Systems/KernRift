// std/sys.kr (Task 11 fix 1): sys_send stays pipe-compatible on Linux (spec
// C3). It is sendto(MSG_NOSIGNAL) now; on a non-socket fd that says -ENOTSOCK
// and sys_send falls back to write(2). The harness runs this with stdout
// connected to a PIPE: "piped" must arrive and the count must be 6.
import "../../std/sys.kr"

fn main() -> uint32 {
    if sys_send(1, "piped\n", 6) != 6 { return 1 }
    return 0
}
