struct P {
    uint64 a
    uint64 b
}
struct Q {
    uint64 x
}
struct R {
    uint64 a
    uint64 b
    uint64 c
}
struct F {
    f64 u
    f64 v
}
fn g(uint64 a1, uint64 a2, uint64 a3, uint64 a4, Q q, uint64 z) -> uint64 { uint64 r = 0; while r < 1 { r = r + 1 } return a1 + q.x * 10 + z * 100 }
fn f() -> uint64 { Q p; p.x = 4; uint64 v = g(1, 0, 0, 0, p, 1); return v }
fn main() { exit(f() - 100) }
