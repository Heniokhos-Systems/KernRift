struct R8 {
    uint32 a
    uint32 b
}
extern fn c_arg(R8 q) -> uint32
extern fn c_ret(uint32 x) -> R8
@export
fn k_arg(R8 q) -> uint32 {
    uint32 s = q.a * 100 + q.b * 10
    q.a = 9
    return s
}
@export
fn k_ret(uint32 x) -> R8 {
    R8 r
    r.a = x + 0
    r.b = x + 1
    return r
}
@export
fn f(uint32 z) -> uint32 {
    R8 t
    t.a = 1
    t.b = 2
    uint32 bad = 0
    if z == 1 {
        uint32 v1 = c_arg(t)
        if v1 != 120 { bad = bad + 1 }
        if t.a != 1 { bad = bad + 2 }
    }
    if z == 4 {
        R8 u = c_ret(5)
        uint32 v2 = u.a * 100 + u.b * 10
        if v2 != 560 { bad = bad + 4 }
    }
    return bad
}
