struct P {
    uint64 a
    uint64 b
}
struct Q {
    uint64 x
}
struct R {
    uint64 a
    uint64 b
    uint64 c
}
struct F {
    f64 u
    f64 v
}
struct H {
    uint32 a
    uint32 b
}
fn g1(P q) -> uint64 { uint64 r = 0; while r < 1 { r = r + 1 } return q.a * 10 + q.b }
fn gs(uint64 z, P q) -> uint64 { uint64 r = 0; while r < 1 { r = r + 1 } return z * 100 + q.a * 10 + q.b }
fn sg(P q, uint64 z) -> uint64 { uint64 r = 0; while r < 1 { r = r + 1 } return z * 100 + q.a * 10 + q.b }
fn g2(P q, P w) -> uint64 { uint64 r = 0; while r < 1 { r = r + 1 } return q.a * 64 + q.b * 16 + w.a * 4 + w.b }
fn gq(Q q) -> uint64 { uint64 r = 0; while r < 1 { r = r + 1 } return q.x + 40 }
fn gh(H q) -> uint64 { uint64 r = 0; while r < 1 { r = r + 1 } return q.a * 10 + q.b }
fn gr(R q) -> uint64 { uint64 r = 0; while r < 1 { r = r + 1 } return q.a * 100 + q.b * 10 + q.c }
fn gf(F q) -> uint64 { uint64 r = 0; while r < 1 { r = r + 1 } f64 s = q.u + q.v; return f64_to_int(s) }
fn g7(uint64 a1, uint64 a2, uint64 a3, uint64 a4, uint64 a5, uint64 a6, P q) -> uint64 { uint64 r = 0; while r < 1 { r = r + 1 } return a1 + a6 + q.a * 10 + q.b }
fn gm(P q) -> uint64 { q.a = 99; return q.b }
fn mk() -> P { P r; r.a = 7; r.b = 8; return r }
fn mkr() -> R { R r; r.a = 1; r.b = 2; r.c = 3; return r }
fn f() -> uint64 { P p; p.a = 3; p.b = 2; return load64(p) }
fn main() { exit(f()) }
