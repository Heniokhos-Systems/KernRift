struct F16 {
    f64 a
    f64 b
}
extern fn c_arg(F16 q) -> uint64
extern fn c_ret(uint64 x) -> F16
@export
fn k_arg(F16 q) -> uint64 {
    uint64 s = f64_to_int(q.a) * 100 + f64_to_int(q.b) * 10
    q.a = int_to_f64(9)
    return s
}
@export
fn k_ret(uint64 x) -> F16 {
    F16 r
    r.a = int_to_f64(x + 0)
    r.b = int_to_f64(x + 1)
    return r
}
@export
fn f(uint64 z) -> uint64 {
    F16 t
    t.a = int_to_f64(1)
    t.b = int_to_f64(2)
    uint64 bad = 0
    if z == 1 {
        uint64 v1 = c_arg(t)
        if v1 != 120 { bad = bad + 1 }
        if f64_to_int(t.a) != 1 { bad = bad + 2 }
    }
    if z == 4 {
        F16 u = c_ret(5)
        uint64 v2 = f64_to_int(u.a) * 100 + f64_to_int(u.b) * 10
        if v2 != 560 { bad = bad + 4 }
    }
    return bad
}
