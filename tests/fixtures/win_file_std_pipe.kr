// The pipe twin of win_file_std.kr (#163): stdin is a pipe. The print-free
// copy reads a 2-byte prefix and the printing copy reads the rest to end of
// file. No size is printed: a pipe has none (Linux -ESPIPE; Windows -5, 0 or
// the bytes queued). On native Windows the last read of an anonymous pipe whose
// writer has closed is FALSE + ERROR_BROKEN_PIPE, which must still be 0.

fn p_rd2(uint64 b) -> uint64 {
    uint64 got = 0
    while got < 2 {
        uint64 n = file_read(0, b + got, 2 - got)
        if n == 0 { return got }
        if n > 0xFFFFFFFFFFFFF000 { return n }
        got = got + n
    }
    return got
}

fn s_rest(uint64 b) {
    uint64 total = 0
    uint64 last = 0
    uint64 going = 1
    while going == 1 {
        uint64 n = file_read(0, b, 64)
        last = n
        if n == 0 { going = 0 }
        if n > 0xFFFFFFFFFFFFF000 { going = 0 }
        if going == 1 { total = total + n }
    }
    int64 st = total
    int64 sl = last
    print("total_m ")
    println(st)
    print("eof_m ")
    println(sl)
}

fn main() {
    uint64 b = alloc(64)
    int64 r2 = p_rd2(b)
    print("rd_p ")
    println(r2)
    s_rest(b)
}
