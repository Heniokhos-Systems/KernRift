// #235 (M3): Windows x64 caller probe. main keeps a sentinel in rsi across
// f, whose asm names rsi and rdi; h names rdi and calls println. Exit 7 =
// preserved, 120 = rsi destroyed.
fn g(uint64 a) -> uint64 {
    uint64 t = a + 1
    return t
}
fn f(uint64 a) -> uint64 {
    uint64 r = g(a)
    asm { "mov rsi, rcx"; "mov rdi, rcx"; "mov rsi, rcx" } in(a -> rcx) clobbers(rsi, rdi)
    return r
}
fn h(uint64 a) -> uint64 {
    asm { "mov rdi, rcx" } in(a -> rcx) clobbers(rdi)
    println("h")
    return a
}
fn main() {
    uint64 s = 0x5A5A
    uint64 got = 0
    asm { "mov rsi, rcx" } in(s -> rcx) clobbers(rsi)
    uint64 z = f(77)
    asm { "mov rcx, rsi" } out(rcx -> got)
    if got != 0x5A5A { exit(120) }
    uint64 _y = h(3)
    if z != 78 { exit(122) }
    exit(7)
}
