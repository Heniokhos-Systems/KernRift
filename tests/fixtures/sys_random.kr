// sys_random fills the buffer: 32 bytes, not all zero, and a second call
// differs from the first. Prints OK.
import "../../std/sys.kr"

static u8[32] rb1
static u8[32] rb2

fn rb_zero(uint64 p) {
    uint64 i = 0
    while i < 32 { store8(p + i, 0)  i = i + 1 }
}

fn rb_same() -> uint64 {
    uint64 i = 0
    while i < 32 {
        if load8(rb1 + i) != load8(rb2 + i) { return 0 }
        i = i + 1
    }
    return 1
}

fn rb_nonzero(uint64 p) -> uint64 {
    uint64 i = 0
    while i < 32 {
        if load8(p + i) != 0 { return 1 }
        i = i + 1
    }
    return 0
}

fn main() -> uint32 {
    rb_zero(rb1)
    rb_zero(rb2)
    if sys_random(rb1, 32) != 1 { return 1 }
    if sys_random(rb2, 32) != 1 { return 2 }
    if rb_nonzero(rb1) == 0 { return 3 }
    if rb_nonzero(rb2) == 0 { return 4 }
    if rb_same() != 0 { return 5 }
    file_write(1, "OK\n", 3)
    return 0
}
