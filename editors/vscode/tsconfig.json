{
  "compilerOptions": {
    "target": "ES2020",
    // Node16 (rather than plain commonjs) is required to pair with the
    // Node16 resolver below. The package has no "type": "module", so .ts
    // still emits CommonJS — which is what a VS Code extension needs.
    "module": "Node16",
    // vscode-languageclient 10 exposes its subpaths (e.g. the /node entry)
    // through an "exports" map, which the classic "node" resolver cannot see.
    // esbuild resolves it regardless, so without this tsc is the only thing
    // that catches the mismatch.
    "moduleResolution": "node16",
    "lib": ["ES2020"],
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"]
}
