// Smoke test for the page manager in docs/tutorial-btree.md §2.
//
// Opens a file, maps it, writes a magic + a value into page 0 and a marker
// into page 1, msyncs, re-opens it in a second mapping, and checks the bytes
// survived. That is the whole persistence claim the tutorial's B-tree rests
// on.
//
// The page-1 marker is read back at the RAW byte offset (base2 + 8192), not
// through db_page. That is deliberate: a broken stride is self-consistent --
// with db_page reduced to base + pageno, writing and reading page 1 through
// db_page still round-trips (measured; only page 0 was exercised and the
// check stayed green). Pinning the read to the file offset the tutorial
// promises (8 KiB pages) is what makes the stride observable at all.
import "pager.kr"

// "KRBTEER1" in the big-endian reading; stored little-endian these bytes
// land as "1REETBRK" on disk. A magic number is a bit pattern, not a string.
const u64 MAGIC = 0x4B52425445455231
const u64 PAGE1_MARK = 0x50414745314F4B21
const u64 DBSIZE = 65536

fn main() -> uint32 {
    u64 path = "/tmp/kr_tutorial_btree.db"
    u64[1] fdslot

    u64 base = db_open(path, DBSIZE, fdslot)
    if base == 0 { exit(1) }
    u64 p0 = db_page(base, 0)
    store64(p0, MAGIC)
    store64(p0 + 8, 424242)
    u64 p1 = db_page(base, 1)
    store64(p1, PAGE1_MARK)
    if db_sync(base, DBSIZE) != 0 { exit(2) }
    db_close(load64(fdslot))

    // Re-open: a fresh mapping of the same file must see the same bytes.
    u64[1] fdslot2
    u64 base2 = db_open(path, DBSIZE, fdslot2)
    if base2 == 0 { exit(3) }
    u64 q0 = db_page(base2, 0)
    if load64(q0) != MAGIC { exit(4) }
    if load64(q0 + 8) != 424242 { exit(5) }
    // Page 1 must be AT 8 KiB in the file, and page 0 must be intact -- a
    // stride smaller than a page makes the page-1 write land inside page 0,
    // which exit(4) above also catches.
    if load64(base2 + 8192) != PAGE1_MARK { exit(6) }
    db_close(load64(fdslot2))

    println_str("pager: pages 0 and 1 survived msync + reopen at 8 KiB stride")
    exit(0)
}
