// gpu_imu_load_demo.kr — parse real IMU firmware + self-test load offsets.
// Does NOT run imu_load_microcode/imu_start (writes; OS-owned card only).
import "../std/io.kr"
import "../std/gpu_portable.kr"
import "../std/gpu_navi32.kr"
import "../std/gpu_imu_load.kr"
fn phex(u64 v){u64 b=alloc(11);store8(b,48);store8(b+1,120);u64 i=0;while i<8{u64 sh=(7-i)*4;u64 n=(v>>sh)&0xf;u64 c=n+48;if n>=10{c=n+87}store8(b+2+i,c);i=i+1}store8(b+10,0);print_str(b)}
fn check(u64 got,u64 want,u64 lab){print_str(lab);if got==want{print_str(" PASS ")}else{print_str(" FAIL ")}print_str("got=");phex(got);print_str(" want=");phex(want);print_str("\n")}
fn main(){
    print_str("gpu_imu_load.kr self-test (real firmware parse)\n")
    u64 fw=read_file("/tmp/imu.bin")
    if fw==0 {print_str("FAIL read /tmp/imu.bin\n");exit(1)}
    check(imu_ucode_arr_off(fw),0x100,"ucode_arr_off")
    check(imu_iram_size(fw),0x10200,"iram_size")
    check(imu_iram_off(fw),0x0,"iram_off")
    check(imu_dram_size(fw),0x10200,"dram_size")
    check(imu_dram_off(fw),0x10200,"dram_off")
    check(gpu_reg_off(NAVI32_GC1,regGFX_IMU_I_RAM_ADDR),(0xa000+0x5f90)*4,"I_RAM_ADDR off")
    check(gpu_reg_off(NAVI32_GC1,regGFX_IMU_CORE_CTRL),(0xa000+0x40b6)*4,"CORE_CTRL off")
    print_str("done — IMU fw parsed + load/start prepped (run only on owned card)\n")
    exit(0)
}
