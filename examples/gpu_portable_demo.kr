// gpu_portable_demo.kr — compile + logic self-test for std/gpu_portable.kr.
//
// KernRift runs freestanding (no /dev/mem), so this test exercises the pure
// address math and the SMN index/data protocol against an alloc'd buffer that
// stands in for BAR5. On your OS, pass a real identity-mapped BAR5 pointer
// instead of `bar` and the same calls drive the hardware.
//
// Build: ./build/krc2 --arch=x86_64 --target=linux --emit=elfexe examples/gpu_portable_demo.kr -o /tmp/gpd
// Run:   /tmp/gpd

import "../std/io.kr"
import "../std/gpu_portable.kr"
import "../std/gpu_navi32.kr"

fn phex(u64 v) {
    u64 buf = alloc(11)
    store8(buf, 48); store8(buf + 1, 120)      // "0x"
    u64 i = 0
    while i < 8 {
        u64 sh = (7 - i) * 4
        u64 nyb = (v >> sh) & 0xf
        u64 ch = nyb + 48
        if nyb >= 10 { ch = nyb + 87 }
        store8(buf + 2 + i, ch)
        i = i + 1
    }
    store8(buf + 10, 0)
    print_str(buf)
}

fn check(u64 got, u64 want, u64 lab) {
    print_str(lab)
    if got == want { print_str(" PASS ") } else { print_str(" FAIL ") }
    print_str("got="); phex(got); print_str(" want="); phex(want); print_str("\n")
}

fn main() {
    print_str("gpu_portable.kr self-test\n")

    // 1) ECAM device offset math (bus 3, dev 0, fn 0) -> 0x300000
    check(ecam_dev_off(3, 0, 0), 0x300000, "ecam_dev_off(3,0,0)")
    check(ecam_dev_off(3, 2, 1), (((3 << 20) | (2 << 15)) | (1 << 12)), "ecam_dev_off(3,2,1)")

    // 2) SMN index/data protocol against a fake BAR5 buffer.
    u64 bar = alloc(0x100)
    smn_w32(bar, 0x0c400000, 0x0000cafe)
    // INDEX2 must hold the SMN byte address reg<<2 = 0x31000000
    check(mmio_r32(bar, 0x38), 0x31000000, "INDEX2 after smn_w32")
    // DATA2 must hold the value; smn_r32 sets INDEX2 again then reads it back
    check(smn_r32(bar, 0x0c400000), 0x0000cafe, "smn_r32 round-trip")
    check(mmio_r32(bar, 0x38), 0x31000000, "INDEX2 after smn_r32")

    // 3) MCFG ECAM base parse (fake table: base 0xe0000000 at +0x2c)
    u64 mcfg = alloc(0x40)
    mmio_w32(mcfg, 0x2c, 0xe0000000)
    mmio_w32(mcfg, 0x30, 0x00000000)
    check(mcfg_ecam_base(mcfg), 0xe0000000, "mcfg_ecam_base")

    // 4) PCI bus scan + BAR read against a synthetic ECAM bus window with an
    //    AMD display device planted at dev=2 fn=0.
    u64 busw = alloc(0x11000)
    u64 cfg = busw + pci_dev_off(2, 0)
    mmio_w32(cfg, 0x00, (0x747e << 16) | 0x1002)   // vendor/device
    mmio_w32(cfg, 0x08, 0x03 << 24)                // base class = display
    mmio_w32(cfg, 0x10, 0x00000004)                // BAR0 lo: 64-bit mem type
    mmio_w32(cfg, 0x14, 0x000000f8)                // BAR0 hi
    mmio_w32(cfg, 0x24, 0xdfb00000)                // BAR5: 32-bit mem

    check(pci_scan_bus_for_gpu(busw, PCI_VENDOR_AMD), (2 << 3) | 0, "scan finds dev2.fn0")
    check(pci_vendor(cfg), 0x1002, "pci_vendor")
    check(pci_device(cfg), 0x747e, "pci_device")
    check(pci_baseclass(cfg), 0x03, "pci_baseclass")
    check(pci_bar(cfg, PCI_CFG_BAR0), 0xf800000000, "BAR0 (64-bit) VRAM")
    check(pci_bar(cfg, 0x24), 0xdfb00000, "BAR5 (32-bit) regs")

    // 5) direct SOC15 register offset math (byte = (base+reg)*4)
    check(gpu_reg_off(NAVI32_GC0, regGRBM_STATUS), (0x1260 + 0xda4) * 4, "GRBM_STATUS off")
    check(gpu_reg_off(NAVI32_NBIF2, regRCC_CONFIG_MEMSIZE), (0xd20 + 0xc3) * 4, "MEMSIZE off")
    // round-trip a direct register through a fake BAR
    gpu_reg_w32(busw, NAVI32_GC0, regGRBM_STATUS, 0x12345678)
    check(gpu_reg_r32(busw, NAVI32_GC0, regGRBM_STATUS), 0x12345678, "gpu_reg round-trip")

    print_str("done\n")
    exit(0)
}
