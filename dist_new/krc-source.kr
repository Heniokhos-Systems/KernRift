                uint8 ov_rex = 0x48
                if tgt >= 8 { ov_rex = ov_rex | 4 }
                emit_byte(ov_rex)
                emit_byte(0x8B)
                if overflow_off < 128 {
                    uint8 ovm = 0x44 | ((tgt & 7) << 3)
                    emit_byte(ovm)
                    emit_byte(0x24)
                    uint8 ovo = overflow_off
                    emit_byte(ovo)
                } else {
                    uint8 ovm = 0x84 | ((tgt & 7) << 3)
                    emit_byte(ovm)
                    emit_byte(0x24)
                    emit_u32_le(overflow_off)
                }
                if dst_r == 0xFFFFFFFF {
                    ir_emit_store_spill(0, dest_v)
