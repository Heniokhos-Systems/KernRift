        // rsi = size + 8 (length)
        ir_emit_mov_r64_r64(6, size_reg)  // rsi = size
        // add rsi, 8
        emit_byte(0x48)
        emit_byte(0x83)
        emit_byte(0xC6)
        emit_byte(0x08)
