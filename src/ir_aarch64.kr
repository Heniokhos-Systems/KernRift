            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_ATOMIC_ADD (92): ldaxr/add/stlxr retry loop -----
    if op == 92 {
        uint64 ptr_r = ir_a64_resolve_src(s1_v, 10)
        uint64 val_r = ir_a64_resolve_src(s2_v, 11)
        // retry:
        uint64 aa_retry = out_len
        // LDAXR x9, [ptr_r] — x9 holds the OLD value (what we must return)
        emit_a64(0xC85FFC00 | (ptr_r << 5) | 9)
        // Compute new value in x13. x86's `xadd` returns the pre-add value;
        // the old code wrote the new value into x9 and returned that,
        // flipping the semantic (atomic_add(40,10) returned 50 instead of 40).
        emit_a64_add(13, 9, val_r)
        // STLXR w12, x13, [ptr_r] — store the NEW value back
        emit_a64(0xC800FC00 | (12 << 16) | (ptr_r << 5) | 13)
        // CBNZ w12, retry (32-bit CBNZ for status register)
        uint64 aa_back = aa_retry - out_len
        emit_a64(0x35000000 | (a64_check_b19(aa_back) << 5) | 12)
        // x9 still holds the old value — that's the return.
        if dst_r != 0xFFFFFFFF {
            emit_a64_mov(dst_r, 9)
        } else {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_ATOMIC_CAS (93): ldaxr/cmp/b.ne/stlxr retry loop -----
    if op == 93 {
        uint64 ptr_r = ir_a64_resolve_src(s1_v, 10)
        uint64 exp_r = ir_a64_resolve_src(s2_v, 11)
        // desired is in imm (vreg index)
        uint64 des_r = 0
        if imm > 0 && imm < ir_vreg_next {
            des_r = ir_a64_resolve_src(imm, 13)
        }
        // retry:
        uint64 cas_retry = out_len
        // LDAXR x9, [ptr_r]                                    (+0)
        emit_a64(0xC85FFC00 | (ptr_r << 5) | 9)
        // CMP x9, exp_r (SUBS xzr, x9, exp_r)                  (+1)
        emit_a64_cmp(9, exp_r)
        // B.NE fail — need +5 insns (STLXR, CBNZ, MOVZ d=1,
        // B done, then FAIL = MOVZ d=0). imm19=5 → 0x540000A1.
        // The old constant 0x54000061 encoded imm19=3, which landed
        // exactly on "Success: MOVZ d=1" — so CAS always reported
        // success, even when the compare mismatched.
        emit_a64(0x540000A1)                                    // (+2)
        // STLXR w12, des_r, [ptr_r]                            (+3)
        emit_a64(0xC800FC00 | (12 << 16) | (ptr_r << 5) | des_r)
        // CBNZ w12, retry                                      (+4)
        uint64 cas_back = cas_retry - out_len
        emit_a64(0x35000000 | (a64_check_b19(cas_back) << 5) | 12)
        // Success: result = 1                                  (+5)
        uint64 cas_d = dst_r
        if cas_d == 0xFFFFFFFF { cas_d = 9 }
        emit_a64_mov_imm(cas_d, 1)
        // B done (+2 insns = 8 bytes)                          (+6)
        emit_a64(0x14000002)
        // fail: result = 0                                     (+7)
        emit_a64_mov_imm(cas_d, 0)
        // done:                                                (+8)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_VSTORE (94): volatile store — stlr on ARM64 -----
    if op == 94 {
        uint64 addr_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 val_reg = ir_a64_resolve_src(s2_v, 10)
        // STLR Xt, [Xn]: 0xC89FFC00 | (Xn << 5) | Xt
        uint64 vs = 0xC89FFC00 | (addr_reg << 5) | val_reg
        emit_a64(vs)
        return
    }

    // ----- IR_VLOAD (95): volatile load — ldar on ARM64 -----
    if op == 95 {
        uint64 addr_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        // LDAR Xt, [Xn]: 0xC8DFFC00 | (Xn << 5) | Xt
        uint64 vl = 0xC8DFFC00 | (addr_reg << 5) | d
        emit_a64(vl)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_ASM_BLOCK (96): inline asm passthrough -----
    if op == 96 {
        uint64 asm_node = s1_v
        uint32 single_tok = ast_data1(asm_node)
        uint64 ws = single_tok
        if ws != 0 {
            asm_emit_a64(ws)
        }
        uint32 child_str = ast_child(asm_node)
        uint64 wcs = child_str
        while wcs != 0 {
            uint32 stk = ast_data1(wcs)
            uint64 wstk = stk
            asm_emit_a64(wstk)
            uint32 nxt = ast_next(wcs)
            wcs = nxt
        }
        return
    }

    // ----- IR_ATOMIC_SUB (109): ldaxr/sub/stlxr retry loop -----
    // Returns the OLD value (mirrors x86's xadd-based lowering).
    if op == 109 {
        uint64 ptr_r = ir_a64_resolve_src(s1_v, 10)
        uint64 val_r = ir_a64_resolve_src(s2_v, 11)
        uint64 as_retry = out_len
        emit_a64(0xC85FFC00 | (ptr_r << 5) | 9)       // LDAXR x9 (= old)
        emit_a64_sub(13, 9, val_r)                    // x13 = new
        emit_a64(0xC800FC00 | (12 << 16) | (ptr_r << 5) | 13)  // STLXR w12, x13
        uint64 as_back = as_retry - out_len
        emit_a64(0x35000000 | (a64_check_b19(as_back) << 5) | 12)
        if dst_r != 0xFFFFFFFF {
            emit_a64_mov(dst_r, 9)
        } else {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_ATOMIC_AND (110): ldaxr/and/stlxr retry loop — returns OLD -----
    if op == 110 {
        uint64 ptr_r = ir_a64_resolve_src(s1_v, 10)
        uint64 val_r = ir_a64_resolve_src(s2_v, 11)
        uint64 aand_retry = out_len
        emit_a64(0xC85FFC00 | (ptr_r << 5) | 9)       // LDAXR x9 (= old)
        emit_a64_and(13, 9, val_r)                    // x13 = new
        emit_a64(0xC800FC00 | (12 << 16) | (ptr_r << 5) | 13)
        uint64 aand_back = aand_retry - out_len
        emit_a64(0x35000000 | (a64_check_b19(aand_back) << 5) | 12)
        if dst_r != 0xFFFFFFFF {
            emit_a64_mov(dst_r, 9)
        } else {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_ATOMIC_OR (111): ldaxr/orr/stlxr retry loop — returns OLD -----
    if op == 111 {
        uint64 ptr_r = ir_a64_resolve_src(s1_v, 10)
        uint64 val_r = ir_a64_resolve_src(s2_v, 11)
        uint64 aor_retry = out_len
        emit_a64(0xC85FFC00 | (ptr_r << 5) | 9)       // LDAXR x9 (= old)
        emit_a64_orr(13, 9, val_r)                    // x13 = new
        emit_a64(0xC800FC00 | (12 << 16) | (ptr_r << 5) | 13)
        uint64 aor_back = aor_retry - out_len
        emit_a64(0x35000000 | (a64_check_b19(aor_back) << 5) | 12)
        if dst_r != 0xFFFFFFFF {
            emit_a64_mov(dst_r, 9)
        } else {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_ATOMIC_XOR (112): ldaxr/eor/stlxr retry loop — returns OLD -----
    if op == 112 {
        uint64 ptr_r = ir_a64_resolve_src(s1_v, 10)
        uint64 val_r = ir_a64_resolve_src(s2_v, 11)
        uint64 axor_retry = out_len
        emit_a64(0xC85FFC00 | (ptr_r << 5) | 9)       // LDAXR x9 (= old)
        emit_a64_eor(13, 9, val_r)                    // x13 = new
        emit_a64(0xC800FC00 | (12 << 16) | (ptr_r << 5) | 13)
        uint64 axor_back = axor_retry - out_len
        emit_a64(0x35000000 | (a64_check_b19(axor_back) << 5) | 12)
        if dst_r != 0xFFFFFFFF {
            emit_a64_mov(dst_r, 9)
        } else {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_EXEC (113): execve on Linux/macOS, CreateProcessA on Windows -----
    if op == 113 {
        uint64 path_r = ir_a64_resolve_src(s1_v, 9)
        if target_os == 2 {
            // Windows ARM64: CreateProcessA + WaitForSingleObject + ExitProcess
            // SP shift is safe — ExitProcess never returns.
            emit_a64_sub_sp_imm(0xD0)
            // Zero STARTUPINFOA+PI area: memset [sp+0x40], 0, 128
            emit_a64_mov_imm(9, 0)
            uint64 zi = 0
            while zi < 16 {
                emit_a64_str(9, 31, 0x40 + zi * 8)
                zi = zi + 1
            }
            // STARTUPINFOA.cb = 104 (at sp+0x40)
            emit_a64_mov_imm(9, 104)
            emit_a64_str32(9, 31, 0x40)
            // CreateProcessA(path, NULL, NULL, NULL, 0, 0, NULL, NULL, &si, &pi)
            // x0 = path (lpApplicationName)
            emit_a64_mov(0, path_r)
            // x1 = NULL (lpCommandLine)
            emit_a64_mov_imm(1, 0)
            // x2 = NULL, x3 = NULL
            emit_a64_mov_imm(2, 0)
            emit_a64_mov_imm(3, 0)
            // x4 = 0 (bInheritHandles)
            emit_a64_mov_imm(4, 0)
            // x5 = 0 (dwCreationFlags)
            emit_a64_mov_imm(5, 0)
            // x6 = NULL (lpEnvironment)
            emit_a64_mov_imm(6, 0)
            // x7 = NULL (lpCurrentDirectory)
            emit_a64_mov_imm(7, 0)
            // [sp+0x00] = &si (lpStartupInfo, 9th arg on stack for ARM64)
            emit_a64_add_imm(9, 31, 0x40)
            emit_a64_str(9, 31, 0)
            // [sp+0x08] = &pi (lpProcessInformation, 10th arg)
            emit_a64_add_imm(9, 31, 0xA8)
            emit_a64_str(9, 31, 8)
            emit_a64_win_call_iat(9)   // CreateProcessA
            // WaitForSingleObject(hProcess=[sp+0xA8], INFINITE=-1)
            emit_a64_ldr(0, 31, 0xA8)
            emit_a64_mov_imm(1, 0xFFFFFFFF)
            emit_a64_win_call_iat(10)  // WaitForSingleObject
            // GetExitCodeProcess(hProcess, &exitCode)
            emit_a64_ldr(0, 31, 0xA8)
            emit_a64_add_imm(1, 31, 0x20)
            emit_a64_win_call_iat(11)  // GetExitCodeProcess (slot 11 on ARM64?)
            // ExitProcess(exitCode)
            emit_a64_ldr32(0, 31, 0x20)
            emit_a64_add_sp_imm(0xD0)
            emit_a64_win_call_iat(0)   // ExitProcess
            return
        }
        // Linux/macOS: execve
        // Build argv on scratchpad: [path, NULL] = 16 bytes
        emit_a64_add_imm(11, 31, ir_a64_scratch_off)
        emit_a64_str(path_r, 11, 0)      // argv[0] = path
        emit_a64_mov_imm(10, 0)
        emit_a64_str(10, 11, 8)           // argv[1] = NULL
        // x0 = path
        emit_a64_mov(0, path_r)
        // x1 = argv (X11)
        emit_a64_mov(1, 11)
        // x2 = envp: try cli_envp static, else NULL
        uint64 envp_off = static_lookup_by_name("cli_envp", 8)
        if envp_off != 0xFFFFFFFF {
            emit_a64_static_load(envp_off)
            emit_a64_mov(2, 0)
            emit_a64_mov(0, path_r)       // restore x0 (clobbered by static_load)
        } else {
            emit_a64_mov_imm(2, 0)
        }
        // syscall execve
        uint64 execve_nr = ir_a64_syscall_nr(59)
        emit_a64_syscall_nr(execve_nr)
        emit_a64_svc("exec_process")
        // execve failed (only reached on error) — no SP restore needed (scratchpad)
        // Save errno to exec_errno if defined
        uint64 errno_off = static_lookup_by_name("exec_errno", 10)
        if errno_off != 0xFFFFFFFF {
            emit_a64_static_store(errno_off)
        }
        if dst_r != 0xFFFFFFFF && dst_r != 0 {
            emit_a64_mov(dst_r, 0)
        }
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(0, dest_v)
        }
        return
    }

    // ----- IR_EXEC_ARGV (114): execve on Linux/macOS, CreateProcessA on Windows -----
    if op == 114 {
        uint64 path_r = ir_a64_resolve_src(s1_v, 9)
        uint64 argv_r = ir_a64_resolve_src(s2_v, 10)
        if target_os == 2 {
            // Windows ARM64: build quoted cmdline from argv and pass as
            // lpCommandLine. Frame extends the existing 0xD0 layout by
            // 0x400 for the cmdline buffer at sp+0xD0.
            // Stash path & argv in x19/x20 BEFORE sub sp — regalloc scratch
            // regs would be clobbered by the zero-init and cmdline loop.
            emit_a64_mov(19, path_r)
            emit_a64_mov(20, argv_r)
            emit_a64_sub_sp_imm(0x4D0)
            emit_a64_mov_imm(9, 0)
            uint64 zi2 = 0
            while zi2 < 16 {
                emit_a64_str(9, 31, 0x40 + zi2 * 8)
                zi2 = zi2 + 1
            }
            emit_a64_mov_imm(9, 104)
            emit_a64_str32(9, 31, 0x40)
            // ---- Build space-separated cmdline at sp+0xD0 ----
            // No quoting — our child parser splits on 0x20 without
            // stripping quotes (src/main.kr:21 win_init_args).
            // x9 = write ptr, x20 = argv walk, x10 = arg*, x11 = byte
            emit_a64_add_imm(9, 31, 0xD0)
            // L_outer (+0): ldr x10,[x20]; cbz x10,L_done (+48)
            emit_a64_ldr(10, 20, 0)
            emit_a64_cbz(10, 48)
            // L_inner (+8): ldrb w11,[x10]; cbz x11,L_end_copy (+20)
            emit_a64_ldrb(11, 10, 0)
            emit_a64_cbz(11, 20)
            emit_a64_strb(11, 9, 0)
            emit_a64_add_imm(10, 10, 1)
            emit_a64_add_imm(9, 9, 1)
            emit_a64(0x17FFFFFB)                // b L_inner (-20)
            // L_end_copy (+32): space + advance
            emit_a64_mov_imm(11, 0x20)
            emit_a64_strb(11, 9, 0)
            emit_a64_add_imm(9, 9, 1)
            emit_a64_add_imm(20, 20, 8)
            emit_a64(0x17FFFFF4)                // b L_outer (-48)
            // L_done (+52): null-terminate
            emit_a64_strb(31, 9, 0)
            // ---- CreateProcessA ----
            emit_a64_mov(0, 19)                 // x0 = path
            emit_a64_add_imm(1, 31, 0xD0)       // x1 = cmdline
            emit_a64_mov_imm(2, 0)
            emit_a64_mov_imm(3, 0)
            emit_a64_mov_imm(4, 0)
            emit_a64_mov_imm(5, 0)
            emit_a64_mov_imm(6, 0)
            emit_a64_mov_imm(7, 0)
            emit_a64_add_imm(9, 31, 0x40)
            emit_a64_str(9, 31, 0)
            emit_a64_add_imm(9, 31, 0xA8)
            emit_a64_str(9, 31, 8)
            emit_a64_win_call_iat(9)
            emit_a64_ldr(0, 31, 0xA8)
            emit_a64_mov_imm(1, 0xFFFFFFFF)
            emit_a64_win_call_iat(10)
            emit_a64_ldr(0, 31, 0xA8)
            emit_a64_add_imm(1, 31, 0x20)
            emit_a64_win_call_iat(11)
            emit_a64_ldr32(0, 31, 0x20)
            emit_a64_add_sp_imm(0x4D0)
            emit_a64_win_call_iat(0)
            return
        }
        // Linux/macOS: execve
        // x0 = path
        emit_a64_mov(0, path_r)
        // x1 = argv
        emit_a64_mov(1, argv_r)
        // x2 = envp
        uint64 envp_off_a = static_lookup_by_name("cli_envp", 8)
        if envp_off_a != 0xFFFFFFFF {
            emit_a64_static_load(envp_off_a)
            emit_a64_mov(2, 0)
            emit_a64_mov(0, path_r)       // restore x0
        } else {
            emit_a64_mov_imm(2, 0)
        }
        // syscall execve
        uint64 execve_nr_a = ir_a64_syscall_nr(59)
        emit_a64_syscall_nr(execve_nr_a)
        emit_a64_svc("exec_process_argv")
        // Save errno
        uint64 errno_off_a = static_lookup_by_name("exec_errno", 10)
        if errno_off_a != 0xFFFFFFFF {
            emit_a64_static_store(errno_off_a)
        }
        if dst_r != 0xFFFFFFFF && dst_r != 0 {
            emit_a64_mov(dst_r, 0)
        }
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(0, dest_v)
        }
        return
    }

    // ----- IR_SET_EXEC (115): chmod(path, 0755) -----
    if op == 115 {
        uint64 path_r = ir_a64_resolve_src(s1_v, 9)
        if target_os == 0 || target_os == 3 {
            // Linux/Android: fchmodat(AT_FDCWD=-100, path, 0755, 0)
            emit_a64_mov_imm(0, 0xFFFFFFFFFFFFFF9C)  // AT_FDCWD = -100
            emit_a64_mov(1, path_r)
            emit_a64_mov_imm(2, 0x1ED)               // 0755 octal
            emit_a64_mov_imm(3, 0)                    // flags = 0
            uint64 chmod_nr = ir_a64_syscall_nr(90)
            emit_a64_syscall_nr(chmod_nr)
            emit_a64_svc("set_executable")
        } else if target_os == 1 {
            // macOS: chmod(path, 0755) — syscall 15
            emit_a64_mov(0, path_r)
            emit_a64_mov_imm(1, 0x1ED)
            uint64 chmod_nr_m = ir_a64_syscall_nr(15)
            emit_a64_syscall_nr(chmod_nr_m)
            emit_a64_svc("set_executable")
        } else if target_os == 4 {
            // Bare metal. Unreachable in practice -- ir.kr's set_executable
            // lowering refuses under target_os == 4 before any IR_SET_EXEC is
            // created -- but this arm is the reason the chain now HAS a final
            // else. Before it, target_os == 4 matched none of 0/3/1 and this
            // op emitted zero instructions, so `--arch=arm64 --target=none`
            // accepted set_executable() silently while x86_64 refused it at
            // the chmod syscall. No trap instruction is emitted on that path,
            // so Task 2's emitter guards structurally could not see it.
            uint64 bmse_a = "set_executable"
            ir_bare_metal_builtin_refused(bmse_a, "a bare-metal image has no filesystem, so there is nothing for this builtin to act on")
        }
        return
    }

    // ----- IR_MODULE_PATH (146): GetModuleFileNameA(NULL, buf, size) -----
    // Windows arm64 only; the lowering emits this solely when target_os == 2.
    // Mirrors the legacy arm64 path in src/codegen_aarch64.kr.
    if op == 146 {
        if target_os == 2 {
            uint64 mp_buf_r = ir_a64_resolve_src(s1_v, 9)
            emit_a64_mov(9, mp_buf_r)             // x9 = buf (survive 2nd resolve)
            uint64 mp_size_r = ir_a64_resolve_src(s2_v, 10)
            emit_a64_mov(2, mp_size_r)            // x2 = size
            emit_a64_mov(1, 9)                    // x1 = buf
            emit_a64_mov_imm(0, 0)                // x0 = NULL (this module)
            emit_a64_win_call_iat(12)             // GetModuleFileNameA
        } else {
            emit_a64_mov_imm(0, 0)
        }
        if dst_r != 0xFFFFFFFF && dst_r != 0 {
            emit_a64_mov(dst_r, 0)
        }
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(0, dest_v)
        }
        return
    }

    // ----- IR_TIME_NS (119): clock_gettime -> nanoseconds -----
    if op == 119 {
        if target_os == 0 || target_os == 3 {
            // Linux / Android arm64: clock_gettime(CLOCK_MONOTONIC=1, &ts)
            // via syscall 113. Returns {tv_sec, tv_nsec} into a 16-byte
            // scratchpad slot.
            emit_a64_mov_imm(1, ir_a64_scratch_off)
            ir_a64_add_sp_reg(1, 1)
            emit_a64_mov_imm(0, 1)
            uint64 cgt_nr = ir_a64_syscall_nr(228)
            emit_a64_syscall_nr(cgt_nr)
            emit_a64_svc("time_ns")
            emit_a64_mov_imm(11, ir_a64_scratch_off)
            ir_a64_add_sp_reg(11, 11)
            emit_a64_ldr(9, 11, 0)
            emit_a64_ldr(10, 11, 8)
            emit_a64_mov_imm(11, 1000000000)
            emit_a64_mul(9, 9, 11)
            emit_a64_add(0, 9, 10)
        } else if target_os == 1 {
            // macOS arm64: gettimeofday(&tv, NULL), x16=116, svc #0x80.
            // timeval = { tv_sec: i64, tv_usec: i64 }. Matches the
            // legacy codegen at src/codegen_aarch64.kr:3539. Without
            // this, the IR path was issuing clock_gettime-as-Linux
            // syscall 228 on Darwin, which is an invalid syscall that
            // silently returned 0 in x0 — so every time_ns() on
            // native arm64 macOS came back zero and the compiler's
            // '(X.XX ms)' self-timer stayed hidden.
            emit_a64_mov_imm(0, ir_a64_scratch_off)
            ir_a64_add_sp_reg(0, 0)
            emit_a64_mov_imm(1, 0)
            emit_a64_mov_imm(16, 116)
            emit_a64_svc("time_ns")
            emit_a64_mov_imm(11, ir_a64_scratch_off)
            ir_a64_add_sp_reg(11, 11)
            emit_a64_ldr(9, 11, 0)
            emit_a64_ldr(10, 11, 8)
            emit_a64_mov_imm(11, 1000000000)
            emit_a64_mul(9, 9, 11)
            emit_a64_mov_imm(11, 1000)
            emit_a64_mul(10, 10, 11)
            emit_a64_add(0, 9, 10)
        } else if target_os == 2 {
            // Windows arm64: QueryPerformanceFrequency(&freq),
            // QueryPerformanceCounter(&counter), then counter * 1e9 / freq
            // computed as (counter / freq) * 1e9 + ((counter % freq) * 1e9) / freq
            // so the multiplication can't overflow uint64 (counter on a
            // box with ~29 days of uptime × 1e9 already wraps).
            // Reserve 16 bytes on the scratchpad for the two qwords that
            // QueryPerformance* writes. Same layout the legacy codegen
            // uses — ir_a64_scratch_off points past the spill slots.
            emit_a64_mov_imm(1, ir_a64_scratch_off)
            ir_a64_add_sp_reg(1, 1)               // x1 = &scratch
            emit_a64_mov(0, 1)                    // x0 = &scratch (freq)
            emit_a64_win_call_iat(15)             // QueryPerformanceFrequency
            emit_a64_mov_imm(1, ir_a64_scratch_off + 8)
            ir_a64_add_sp_reg(1, 1)               // x1 = &scratch+8
            emit_a64_mov(0, 1)                    // x0 = &scratch+8 (counter)
            emit_a64_win_call_iat(14)             // QueryPerformanceCounter
            // x11 = &scratch, reload after the IAT clobber (same pattern
            // that bit us in daa1689's file_size fix).
            emit_a64_mov_imm(11, ir_a64_scratch_off)
            ir_a64_add_sp_reg(11, 11)
            emit_a64_ldr(12, 11, 0)               // x12 = freq
            emit_a64_ldr(13, 11, 8)               // x13 = counter
            emit_a64_udiv(9, 13, 12)              // x9  = counter / freq (secs)
            emit_a64_msub(10, 9, 12, 13)          // x10 = counter - secs*freq (frac)
            emit_a64_mov_imm(14, 1000000000)
            emit_a64_mul(9, 9, 14)                // x9  = secs * 1e9
            emit_a64_mul(10, 10, 14)              // x10 = frac * 1e9
            emit_a64_udiv(10, 10, 12)             // x10 = frac*1e9 / freq
            emit_a64_add(0, 9, 10)                // x0  = secs*1e9 + frac*1e9/freq
        } else if target_os == 4 {
            // Bare metal. Unreachable in practice -- ir.kr's time_ns lowering
            // refuses under target_os == 4 before any IR_TIME_NS is created --
            // but this arm replaces a `else { mov x0, #0 }` that made
            // `--arch=arm64 --target=none` compile time_ns() clean and return
            // a CONSTANT ZERO on every call, while x86_64 refused the same
            // program at the clock_gettime syscall. A silently wrong clock is
            // worse than a missing one, and no trap instruction is emitted on
            // this path for Task 2's emitter guards to catch.
            uint64 bmt_a = "time_ns"
            ir_bare_metal_builtin_refused(bmt_a, "there is no OS clock; read the platform's cycle counter with inline asm, or supply time_ns with @builtin_override")
        } else {
            emit_a64_mov_imm(0, 0)
        }
        if dst_r != 0xFFFFFFFF && dst_r != 0 {
            emit_a64_mov(dst_r, 0)
        }
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(0, dest_v)
        }
        return
    }

    // ----- IR_ISB (126): instruction-sync barrier -----
    // Use after writing new code to RAM to make sure the subsequent
    // instruction fetches see the writes. ARM64 I-cache is not
    // kept coherent with D-cache automatically (unlike x86).
    if op == 126 {
        emit_a64(0xD5033FDF)   // ISB
        return
    }

    // ----- IR_DCACHE_FLUSH (127): clean + invalidate one D-cache line to PoC -----
    // Emits: DC CIVAC, Xt ; DSB ISH ; ISB. Safe for post-DMA and
    // pre-handoff uses. Requires EL1+ on real hardware; user-space
    // code on Linux will fault with SIGILL unless the kernel emulates.
    if op == 127 {
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        emit_a64(0xD50B7E20 | a_reg)  // DC CIVAC, Xa
        emit_a64(0xD5033B9F)          // DSB ISH
        emit_a64(0xD5033FDF)          // ISB
        return
    }

    // ----- IR_ICACHE_INV (128): invalidate one I-cache line by VA to PoU -----
    // Emits: IC IVAU, Xt ; DSB ISH ; ISB. Use after writing new code
    // into RAM. IC IVAU is available at EL0.
    if op == 128 {
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        emit_a64(0xD50B7520 | a_reg)  // IC IVAU, Xa
        emit_a64(0xD5033B9F)          // DSB ISH
        emit_a64(0xD5033FDF)          // ISB
        return
    }

    // ----- IR_DSB (129): DSB SY — full-system data-sync barrier -----
    if op == 129 {
        emit_a64(0xD5033F9F)
        return
    }

    // ----- IR_DMB (130): DMB ISH — inner-shareable data-memory barrier -----
    if op == 130 {
        emit_a64(0xD5033BBF)
        return
    }

    // ----- IR_ARR_CHECK (131): trap if idx (s1_v) >= count (imm) -----
    // Emits: MOVZ x9, count ; CMP idx, x9 ; B.LO +<trap> ; trap ; ok:
    // Windows ARM64 uses ExitProcess via IAT which doesn't fit this
    // short-sequence pattern; fall back to no-check there.
    if op == 131 {
        if target_os == 2 { return }                      // Windows — skip
        uint64 idx_r = ir_a64_resolve_src(s1_v, 9)
        // Put count in x10 so idx can stay in its register.
        emit_a64_mov_imm(10, imm)
        emit_a64_cmp(idx_r, 10)
        // Compute trap length in instructions.
        //   Linux / Android: MOVZ x0 + MOVZ x8 + SVC #0 = 3 insns.
        //   macOS:           MOVZ x0 + MOVZ x16 + SVC #0 = 3 insns.
        // B.LO +3 insns (skip trap). Encoding: 0x54 | (3<<5) | 3.
        emit_a64(0x54000063)
        emit_a64_mov_imm(0, 1)
        if target_os == 1 {
            emit_a64_mov_imm(16, 1)                        // macOS: exit = 1 via x16
        } else {
            emit_a64_mov_imm(8, 93)                        // Linux/Android: exit = 93 via x8
        }
        emit_a64_svc_word(0xD4000001, "array bounds check (--debug)")                               // SVC #0
        return
    }

    // ----- IR_FADD (20), IR_FSUB (21), IR_FMUL (22), IR_FDIV (23) -----
    if op >= 20 && op <= 23 {
        uint64 fk = imm
        if fk == 2 {
            // f32: fmov s0, wA; fmov s1, wB; op s0, s0, s1; fmov wDst, s0
            uint64 a = ir_a64_resolve_src(s1_v, 9)
            uint64 b = ir_a64_resolve_src(s2_v, 10)
            uint64 d = dst_r
            if d == 0xFFFFFFFF { d = 9 }
            emit_a64(0x1E270000 | (a << 5) | 0)       // fmov s0, wA
            emit_a64(0x1E270000 | (b << 5) | 1)       // fmov s1, wB
            if op == 20 { emit_a64(0x1E202800 | (1 << 16) | (0 << 5) | 0) }  // fadd s0, s0, s1
            if op == 21 { emit_a64(0x1E203800 | (1 << 16) | (0 << 5) | 0) }  // fsub s0, s0, s1
            if op == 22 { emit_a64(0x1E200800 | (1 << 16) | (0 << 5) | 0) }  // fmul s0, s0, s1
            if op == 23 { emit_a64(0x1E201800 | (1 << 16) | (0 << 5) | 0) }  // fdiv s0, s0, s1
            emit_a64(0x1E260000 | (0 << 5) | d)       // fmov wDst, s0
            if dst_r == 0xFFFFFFFF { ir_a64_emit_store_spill(9, dest_v) }
            return
        }
        // f64: operate on d-registers directly. Homed operands are used in
        // place, others are materialised into d0/d1; the result is computed
        // straight into the dest's d-home when it has one.
        uint64 a_d = ir_a64_resolve_src_d(s1_v, 0)
        uint64 b_d = ir_a64_resolve_src_d(s2_v, 1)
        uint64 t = ir_a64_fpr_dest(dest_v, 0)
        if op == 20 { emit_a64(0x1E602800 | (b_d << 16) | (a_d << 5) | t) }  // fadd t, a, b
        if op == 21 { emit_a64(0x1E603800 | (b_d << 16) | (a_d << 5) | t) }  // fsub t, a, b
        if op == 22 { emit_a64(0x1E600800 | (b_d << 16) | (a_d << 5) | t) }  // fmul t, a, b
        if op == 23 { emit_a64(0x1E601800 | (b_d << 16) | (a_d << 5) | t) }  // fdiv t, a, b
        ir_a64_store_dest_d(dest_v, t)
        return
    }

    // ----- Float comparisons: IR_FCMP_EQ (24), IR_FCMP_LT (25), IR_FCMP_NE (99),
    //       IR_FCMP_LE (100), IR_FCMP_GT (101), IR_FCMP_GE (102) -----
    if op == 24 || op == 25 || op == 99 || op == 100 || op == 101 || op == 102 {
        uint64 fk = imm
        if fk == 2 {
            uint64 a = ir_a64_resolve_src(s1_v, 9)
            uint64 b = ir_a64_resolve_src(s2_v, 10)
            emit_a64(0x1E270000 | (a << 5) | 0)       // fmov s0, wA
            emit_a64(0x1E270000 | (b << 5) | 1)       // fmov s1, wB
            emit_a64(0x1E202000 | (1 << 16) | (0 << 5))  // fcmp s0, s1
        } else {
            uint64 a_d = ir_a64_resolve_src_d(s1_v, 0)
            uint64 b_d = ir_a64_resolve_src_d(s2_v, 1)
            emit_a64(0x1E602000 | (b_d << 16) | (a_d << 5))  // fcmp a, b
        }
        // ARM64 float condition codes after fcmp (NaN-safe: MI/LS are false on
        // unordered; the integer LT(11)/LE(13) would be TRUE for NaN — H13):
        // EQ: cond=0, NE: cond=1, LT: MI=4, LE: LS=9, GT: cond=12, GE: cond=10
        uint64 cond = 0
        if op == 24 { cond = 0 }   // EQ
        if op == 99 { cond = 1 }   // NE
        if op == 25 { cond = 4 }   // LT → mi (NaN-safe)
        if op == 100 { cond = 9 }  // LE → ls (NaN-safe)
        if op == 101 { cond = 12 } // GT
        if op == 102 { cond = 10 } // GE
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64_cset(d, cond)
        if dst_r == 0xFFFFFFFF { ir_a64_emit_store_spill(9, dest_v) }
        return
    }

    // ----- IR_ITOF (26): int64 to f64 -----
    if op == 26 {
        uint64 a = ir_a64_resolve_src(s1_v, 9)
        uint64 t = ir_a64_fpr_dest(dest_v, 0)
        emit_a64(0x9E620000 | (a << 5) | t)           // scvtf t, xA
        ir_a64_store_dest_d(dest_v, t)
        return
    }

    // ----- IR_FTOI (27): f64 to int64 (truncating) -----
    if op == 27 {
        uint64 a_d = ir_a64_resolve_src_d(s1_v, 0)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64(0x9E780000 | (a_d << 5) | d)         // fcvtzs xDst, a
        if dst_r == 0xFFFFFFFF { ir_a64_emit_store_spill(9, dest_v) }
        return
    }

    // ----- IR_FSQRT (97): f64 square root -----
    if op == 97 {
        uint64 a_d = ir_a64_resolve_src_d(s1_v, 0)
        uint64 t = ir_a64_fpr_dest(dest_v, 0)
        emit_a64(0x1E61C000 | (a_d << 5) | t)         // fsqrt t, a
        ir_a64_store_dest_d(dest_v, t)
        return
    }

    // ----- IR_FFMA (98): multiply-add: a*b + c (NOT fused — must stay
    // bit-identical to the x86 mulsd+addsd lowering) -----
    if op == 98 {
        uint64 a_d = ir_a64_resolve_src_d(s1_v, 0)
        uint64 b_d = ir_a64_resolve_src_d(s2_v, 1)
        uint64 c_vreg = imm
        uint64 c_d = 2
        if c_vreg > 0 && c_vreg < ir_vreg_next {
            c_d = ir_a64_resolve_src_d(c_vreg, 2)
        }
        // product into d0 (a_d/b_d already consumed; c_d is never d0)
        emit_a64(0x1E600800 | (b_d << 16) | (a_d << 5) | 0)  // fmul d0, a, b
        uint64 t = ir_a64_fpr_dest(dest_v, 0)
        emit_a64(0x1E602800 | (c_d << 16) | (0 << 5) | t)    // fadd t, d0, c
        ir_a64_store_dest_d(dest_v, t)
        return
    }

    // ----- IR_F32TOF64 (103): f32 to f64 -----
    if op == 103 {
        uint64 a = ir_a64_resolve_src(s1_v, 9)
        emit_a64(0x1E270000 | (a << 5) | 0)           // fmov s0, wA
        uint64 t = ir_a64_fpr_dest(dest_v, 0)
        emit_a64(0x1E22C000 | (0 << 5) | t)           // fcvt t, s0
        ir_a64_store_dest_d(dest_v, t)
        return
    }

    // ----- IR_F64TOF32 (104): f64 to f32 -----
    if op == 104 {
        uint64 a_d = ir_a64_resolve_src_d(s1_v, 0)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64(0x1E624000 | (a_d << 5) | 0)         // fcvt s0, a
        emit_a64(0x1E260000 | (0 << 5) | d)           // fmov wDst, s0
        if dst_r == 0xFFFFFFFF { ir_a64_emit_store_spill(9, dest_v) }
        return
    }

    // ----- IR_F32TOF16 (105): software f32-to-f16 bit conversion -----
    if op == 105 {
        uint64 a = ir_a64_resolve_src(s1_v, 9)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        // f32 bits in GPR, extract sign/exp/mantissa using integer ops
        // x10 = a (save f32 bits)
        emit_a64_mov(10, a)
        // sign: x11 = a >> 16; x11 = x11 & 0x8000
        emit_a64_mov(11, a)
        emit_a64_mov_imm(12, 16)
        emit_a64_lsr(11, 11, 12)
        emit_a64_mov_imm(12, 0x8000)
        emit_a64_and(11, 11, 12)
        // exp: x12 = a >> 23; x12 = x12 & 0xFF; x12 = x12 - 112; x12 = x12 & 0x1F; x12 = x12 << 10
        emit_a64_mov(12, 10)
        emit_a64_mov_imm(13, 23)
        emit_a64_lsr(12, 12, 13)
        emit_a64_mov_imm(13, 0xFF)
        emit_a64_and(12, 12, 13)
        emit_a64_mov_imm(13, 112)
        emit_a64_sub(12, 12, 13)
        emit_a64_mov_imm(13, 0x1F)
        emit_a64_and(12, 12, 13)
        emit_a64_mov_imm(13, 10)
        emit_a64_lsl(12, 12, 13)
        // sign | exp
        emit_a64_orr(11, 11, 12)
        // mantissa: x12 = a >> 13; x12 = x12 & 0x3FF
        emit_a64_mov(12, 10)
        emit_a64_mov_imm(13, 13)
        emit_a64_lsr(12, 12, 13)
        emit_a64_mov_imm(13, 0x3FF)
        emit_a64_and(12, 12, 13)
        // result = sign | exp | mantissa
        emit_a64_orr(d, 11, 12)
        if dst_r == 0xFFFFFFFF { ir_a64_emit_store_spill(9, dest_v) }
        return
    }

    // ----- IR_F16TOF32 (106): software f16-to-f32 bit conversion -----
    if op == 106 {
        uint64 a = ir_a64_resolve_src(s1_v, 9)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        // f16 bits in GPR (lower 16 bits), expand to f32 bit pattern
        // x10 = a (save f16 bits)
        emit_a64_mov(10, a)
        // sign: x11 = a << 16; x11 = x11 & 0x80000000
        emit_a64_mov(11, a)
        emit_a64_mov_imm(12, 16)
        emit_a64_lsl(11, 11, 12)
        emit_a64_mov_imm(12, 0x80000000)
        emit_a64_and(11, 11, 12)
        // exp: x12 = a >> 10; x12 = x12 & 0x1F; x12 = x12 + 112; x12 = x12 << 23
        emit_a64_mov(12, 10)
        emit_a64_mov_imm(13, 10)
        emit_a64_lsr(12, 12, 13)
        emit_a64_mov_imm(13, 0x1F)
        emit_a64_and(12, 12, 13)
        emit_a64_add_imm(12, 12, 112)
        emit_a64_mov_imm(13, 23)
        emit_a64_lsl(12, 12, 13)
        // sign | exp
        emit_a64_orr(11, 11, 12)
        // mantissa: x12 = a & 0x3FF; x12 = x12 << 13
        emit_a64_mov_imm(12, 0x3FF)
        emit_a64_and(12, 10, 12)
        emit_a64_mov_imm(13, 13)
        emit_a64_lsl(12, 12, 13)
        // result = sign | exp | mantissa
        emit_a64_orr(d, 11, 12)
        if dst_r == 0xFFFFFFFF { ir_a64_emit_store_spill(9, dest_v) }
        return
    }

    // ----- IR_ITOF32 (107): int64 to f32 -----
    if op == 107 {
        uint64 a = ir_a64_resolve_src(s1_v, 9)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        // SCVTF Sd, Xn (sf=1, type=00) — encode 0x9E220000. The old
        // constant 0x1E620000 decoded to SCVTF Dd, Wn (double destination,
        // 32-bit source), so a 64-bit int turned into a *double*, then
        // FMOV w, s read the low 32 bits of the double bit-pattern —
        // always garbage that rounded to 0 on the round-trip.
        emit_a64(0x9E220000 | (a << 5) | 0)           // scvtf s0, xA
        emit_a64(0x1E260000 | (0 << 5) | d)           // fmov wDst, s0
        if dst_r == 0xFFFFFFFF { ir_a64_emit_store_spill(9, dest_v) }
        return
    }

    // ----- IR_FTOI32 (108): f32 to int64 (truncating) -----
    if op == 108 {
        uint64 a = ir_a64_resolve_src(s1_v, 9)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64(0x1E270000 | (a << 5) | 0)           // fmov s0, wA
        // FCVTZS Xd, Sn (sf=1, type=00, rmode=11, opcode=000) — encode
        // 0x9E380000. Old constant 0x1E380000 was FCVTZS Wd which did
        // a 32-bit result write that zeroed the upper half of Xd; this
        // was only correct by accident for small values.
        emit_a64(0x9E380000 | (0 << 5) | d)           // fcvtzs xDst, s0
        if dst_r == 0xFFFFFFFF { ir_a64_emit_store_spill(9, dest_v) }
        return
    }

    // ----- IR_FSQRT32 (118): f32 square root -----
    if op == 118 {
        uint64 a = ir_a64_resolve_src(s1_v, 9)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64(0x1E270000 | (a << 5) | 0)           // fmov s0, wA
        emit_a64(0x1E21C000 | (0 << 5) | 0)           // fsqrt s0, s0
        emit_a64(0x1E260000 | (0 << 5) | d)           // fmov wDst, s0
        if dst_r == 0xFFFFFFFF { ir_a64_emit_store_spill(9, dest_v) }
        return
    }

    // ----- IR_FMT_BOOL (124): format bool as "true"/"false" -----
    // src1=buf, src2=val, dest=length
    if op == 124 {
        uint64 fb_buf = ir_a64_resolve_src(s1_v, 9)
        uint64 fb_val = ir_a64_resolve_src(s2_v, 10)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        // x13 = buf write ptr, x14 = val
        emit_a64_mov(13, fb_buf)
        emit_a64_mov(14, fb_val)
        // CBZ x14, false_path (5 true_path insns=20 bytes; false_path at CBZ_PC+24)
        emit_a64_cbz(14, 24)
        // true_path: store 'true' (0x65757274 LE) as 32-bit, then len=4, branch done
        emit_a64_mov_imm(11, 0x65757274)   // 2 insns: MOVZ+MOVK
        emit_a64_str32(11, 13, 0)          // STR W11, [X13]
        emit_a64_mov_imm(d, 4)             // len = 4 (1 insn)
        emit_a64_b(28)                     // B done (6 false_path insns=24 bytes; done at B_PC+28)
        // false_path: store 'fals' (0x736C6166 LE) then 'e' (0x65), len=5
        emit_a64_mov_imm(11, 0x736C6166)   // 2 insns: MOVZ+MOVK
        emit_a64_str32(11, 13, 0)          // STR W11, [X13]
        emit_a64_mov_imm(11, 0x65)         // 'e' = 101 (1 insn)
        emit_a64_strb(11, 13, 4)           // STRB W11, [X13, #4]
        emit_a64_mov_imm(d, 5)             // len = 5 (1 insn)
        // done:
        if dst_r == 0xFFFFFFFF { ir_a64_emit_store_spill(9, dest_v) }
        return
    }

    // ----- IR_FMT_F64 (125): format f64 as "[sign][int].[6frac]" -----
    // src1=buf, src2=f64-bits, dest=length
    // Registers: x9=buf_ptr, x10=len, x11=temp/int_part, x12=digit_scratch,
    //            x13=divisor10, x14=digit_count/pad, x15=saved_count
    // Float: d0=working_val, d1=constant, d2=saved abs_val
    if op == 125 {
        uint64 ff_buf  = ir_a64_resolve_src(s1_v, 9)
        uint64 ff_val  = ir_a64_resolve_src(s2_v, 10)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }

        // Set x9 = buf (safe, ff_val might be in x10 — do NOT set x10 yet)
        emit_a64_mov(9, ff_buf)

        // Load f64 bits into d0: fmov d0, ff_val (before possibly clobbering ff_val)
        emit_a64(0x9E670000 | (ff_val << 5) | 0)   // fmov d0, ff_val

        // Extract bits back to x11 for sign check: fmov x11, d0
        emit_a64(0x9E660000 | (0 << 5) | 11)        // fmov x11, d0

        // Now safe to set x10 = len = 0 (ff_val bits are in x11 and d0)
        emit_a64_mov_imm(10, 0)

        // Sign check via bit 63 of x11: TST x11, sign_mask
        // Load sign mask 0x8000000000000000 into x13 (2 insns: MOVZ+MOVK)
        emit_a64_mov_imm(13, 0x8000000000000000)    // 2 insns; x13 reused as divisor10 later
        // ANDS XZR, x11, x13 — sets flags; ZR==1 means non-negative
        emit_a64(0xEA000000 | (13 << 16) | (11 << 5) | 31)  // TST x11, x13
        // B.EQ .ff_pos (cond=0=EQ, non-negative → skip neg path)
        // neg path = FNEG(1)+mov_imm_minus(1)+strb(1)+add9(1)+add10(1) = 5 insns=20 bytes
        // .ff_pos is at B_PC + 4 + 20 = B_PC + 24
        emit_a64_bcond(0, 24)                       // B.EQ .ff_pos
        // Negative: negate d0, write '-', update x9 and x10
        emit_a64(0x1E614000)                        // FNEG d0, d0
        emit_a64_mov_imm(11, 0x2D)                  // '-' = 45 (1 insn)
        emit_a64_strb(11, 9, 0)                     // STRB W11, [X9]
        emit_a64_add_imm(9, 9, 1)                   // x9++
        emit_a64_add_imm(10, 10, 1)                 // x10++
        // .ff_pos: check for big value
        // Load 1e18 = 0x4DE0B6B3A7640000 into x11, fmov d1, x11 (4+1=5 insns)
        emit_a64_mov_imm(11, 0x43ABC16D674EC800)    // 1e18 IEEE bits; 4 insns
        emit_a64(0x9E670000 | (11 << 5) | 1)        // fmov d1, x11
        // FCMP d0, d1
        emit_a64(0x1E602000 | (1 << 16) | (0 << 5)) // fcmp d0, d1
        // B.HS .ff_big (cond=2=HS=C set): val>=1e18 or NaN → big. PATCH LATER.
        emit_a64_bcond(2, 0)                        // placeholder; patched below
        uint64 ff_bhs_off = out_len - 4

        // .ff_normal path starts here
        // Integer part: FCVTZS x11, d0 (truncate to int)
        emit_a64(0x9E780000 | (0 << 5) | 11)        // fcvtzs x11, d0
        // Save abs_val in d2: FMOV d2, d0 (1E604002)
        emit_a64(0x1E604000 | (0 << 5) | 2)         // fmov d2, d0

        // Setup integer formatting: x12=digit_scratch, x13=10, x14=0
        emit_a64_mov_imm(12, ir_a64_scratch_off)
        ir_a64_add_sp_reg(12, 12)
        emit_a64_mov_imm(13, 10)
        emit_a64_mov_imm(14, 0)

        // Digit extraction loop: divide by 10, store remainder+0x30 at [x12+x14]
        uint64 ff_uint_loop = out_len
        emit_a64_udiv(4, 11, 13)                    // x4 = x11 / 10
        emit_a64_msub(5, 4, 13, 11)                 // x5 = x11 - x4*10 (digit)
        emit_a64_add_imm(5, 5, 48)                  // x5 += '0'
        // STRB W5, [X12, X14] — register offset (unscaled)
        emit_a64(0x38206800 | (14 << 16) | (12 << 5) | 5)
        emit_a64_add_imm(14, 14, 1)
        emit_a64_mov(11, 4)
        uint64 ff_uint_back = ff_uint_loop - out_len
        emit_a64(0xB5000000 | (a64_check_b19(ff_uint_back) << 5) | 11)  // CBNZ x11, loop

        // Reverse copy to [x9]: x15 = digit count
        emit_a64_mov(15, 14)
        uint64 ff_copy_loop = out_len
        emit_a64_cbz(14, 20)                        // CBZ x14, copy_done (5 insns=20 bytes)
        emit_a64(0xD1000400 | (14 << 5) | 14)       // SUB x14, x14, #1
        emit_a64(0x38606800 | (14 << 16) | (12 << 5) | 5)  // LDRB W5, [X12, X14]
        emit_a64(0x38001525)                        // STRB W5, [X9], #1 (post-index x9)
        uint64 ff_copy_back = ff_copy_loop - out_len
        emit_a64(0x14000000 | a64_check_b26(ff_copy_back))  // B copy_loop
        // copy_done:
        emit_a64_add(10, 10, 15)                    // x10 += int_len (x15)

        // Write '.' at [x9], then x9++, x10++
        emit_a64_mov_imm(11, 0x2E)
        emit_a64_strb(11, 9, 0)
        emit_a64_add_imm(9, 9, 1)
        emit_a64_add_imm(10, 10, 1)

        // Recompute frac: fcvtzs x11, d2 → scvtf d1, x11 → fsub d0, d2, d1
        emit_a64(0x9E780000 | (2 << 5) | 11)        // fcvtzs x11, d2
        emit_a64(0x9E620000 | (11 << 5) | 1)        // scvtf d1, x11
        emit_a64(0x1E603800 | (1 << 16) | (2 << 5) | 0)  // fsub d0, d2, d1

        // Multiply by 1e6, truncate to int → frac_int in x11
        emit_a64_mov_imm(11, 0x412E848000000000)    // 1e6 IEEE bits; 4 insns
        emit_a64(0x9E670000 | (11 << 5) | 1)        // fmov d1, x11
        emit_a64(0x1E600800 | (1 << 16) | (0 << 5) | 0)  // fmul d0, d0, d1
        emit_a64(0x9E780000 | (0 << 5) | 11)        // fcvtzs x11, d0  → frac_int

        // Count digits in x11: x4=working, x14=count
        emit_a64_mov(4, 11)
        emit_a64_mov_imm(14, 0)
        emit_a64_cbz(4, 24)                         // CBZ x4, .ff_fz (5 insns+B = 24 bytes to .ff_fz)
        uint64 ff_cnt_loop = out_len
        emit_a64_udiv(5, 4, 13)
        emit_a64_add_imm(14, 14, 1)
        emit_a64_mov(4, 5)
        uint64 ff_cnt_back = ff_cnt_loop - out_len
        emit_a64(0xB5000000 | (a64_check_b19(ff_cnt_back) << 5) | 4)  // CBNZ x4, cnt_loop
        emit_a64_b(8)                               // B .ff_have_digits (skip .ff_fz = 1 insn = 8 bytes from B)
        // .ff_fz: frac_int=0 → digit_count=1
        emit_a64_mov_imm(14, 1)                     // 1 insn
        // .ff_have_digits: pad = 6 - x14 (always 0..5; no need for neg check since count ∈ 1..6)
        emit_a64_mov_imm(15, 6)
        emit_a64_sub(15, 15, 14)                    // x15 = pad
        // Pad zero loop. Body = 5 insns (mov+strb+add+sub+b). Use x3 as
        // the byte-constant scratch rather than x11: x11 holds frac_int
        // and is re-read by the fi_loop below. The earlier version used
        // `mov_imm x11, 48` which clobbered frac_int with the ASCII code
        // 0x30, so fi_loop then decomposed 48 into "84" — visible in
        // `println(1.0)` as "1.000004" (the trailing '8' got sliced off
        // by the `write(len)` call but the '4' landed). Also DO NOT
        // `add x10, x10, 1` here; the final `add x10, x10, 6` below
        // already accounts for every fraction byte.
        uint64 ff_pad_loop = out_len
        emit_a64_cbz(15, 24)                        // CBZ x15, pad_done (6 insns=24 bytes)
        emit_a64_mov_imm(3, 0x30)                   // x3 = '0'
        emit_a64_strb(3, 9, 0)
        emit_a64_add_imm(9, 9, 1)
        emit_a64(0xD1000400 | (15 << 5) | 15)       // SUB x15, x15, #1
        uint64 ff_pad_back = ff_pad_loop - out_len
        emit_a64(0x14000000 | a64_check_b26(ff_pad_back))  // B pad_loop
        // pad_done:

        // Format frac_int (x11) into [x9]: digit extract + reverse copy
        emit_a64_mov_imm(14, 0)
        uint64 ff_fi_loop = out_len
        emit_a64_udiv(4, 11, 13)
        emit_a64_msub(5, 4, 13, 11)
        emit_a64_add_imm(5, 5, 48)
        emit_a64(0x38206800 | (14 << 16) | (12 << 5) | 5)
        emit_a64_add_imm(14, 14, 1)
        emit_a64_mov(11, 4)
        uint64 ff_fi_back = ff_fi_loop - out_len
        emit_a64(0xB5000000 | (a64_check_b19(ff_fi_back) << 5) | 11)  // CBNZ x11, fi_loop

        uint64 ff_fi_copy = out_len
        emit_a64_cbz(14, 20)                        // CBZ x14, fi_done (5 insns=20 bytes)
        emit_a64(0xD1000400 | (14 << 5) | 14)       // SUB x14, x14, #1
        emit_a64(0x38606800 | (14 << 16) | (12 << 5) | 5)  // LDRB W5, [X12, X14]
        emit_a64(0x38001525)                        // STRB W5, [X9], #1
        uint64 ff_fi_back2 = ff_fi_copy - out_len
        emit_a64(0x14000000 | a64_check_b26(ff_fi_back2))
        // fi_done: x10 += 6 (pad + frac digits always total 6)
        emit_a64_add_imm(10, 10, 6)

        // Jump over big path: big path = 7 insns × 4 = 28 bytes, then .ff_end
        // B at PC, big path at PC+4 (7 insns=28 bytes), ff_end at PC+32
        emit_a64_b(32)                              // B .ff_end

        // .ff_big: patch B.HS, then write "big", add 3 to len
        uint64 ff_big = out_len
        uint64 ff_bhs_disp = ff_big - ff_bhs_off
        uint64 ff_bhs_p = out_buf + ff_bhs_off
        uint64 ff_bhs_rel19 = a64_check_b19(ff_bhs_disp)
        uint64 ff_bhs_insn = 0x54000002 | (ff_bhs_rel19 << 5)  // B.HS, cond=2
        uint32 ff_bhs_insn32 = ff_bhs_insn
        unsafe { *(ff_bhs_p as uint32) = ff_bhs_insn32 }
        // Write 'b', 'i', 'g'
        emit_a64_mov_imm(11, 0x62)
        emit_a64_strb(11, 9, 0)
        emit_a64_mov_imm(11, 0x69)
        emit_a64_strb(11, 9, 1)
        emit_a64_mov_imm(11, 0x67)
        emit_a64_strb(11, 9, 2)
        emit_a64_add_imm(10, 10, 3)
        // .ff_end:
        emit_a64_mov(d, 10)
        if dst_r == 0xFFFFFFFF { ir_a64_emit_store_spill(9, dest_v) }
        return
    }

    // Catch-all: every reachable opcode above ends in `return`. Anything
    // that falls through here is an IR op this backend does not lower —
    // emitting nothing would leave the dest unwritten and silently
    // miscompile (exactly how IR_ROR shipped broken in v2.8.32).
    a64_nyi_op(op)
}

// ---------------------------------------------------------------------------
// Function-level emitter
// ---------------------------------------------------------------------------

@export
fn ir_emit_arm64_function(uint64 fn_node) {
    // Check for @naked attribute
    uint32 ann_flags = ast_data4(fn_node)
    uint64 is_naked = ann_flags & 2

    // 1. Lower AST to IR
    ir_lower_function(fn_node)

    // 1a. Optimize
    if ir_opt_level > 0 {
        ir_optimize()
    }

    // 2. Compute liveness
    ir_compute_liveness()

    // 2a. Per-vreg use counts — consumed by ir_cmp_fuse_code so the
    // CMP+B.cond fusion below only fires when the compare's boolean has
    // exactly one consumer (the BR_COND terminator).
    ir_compute_use_count()

    // 3. Set up ARM64 register allocator. The wide 23-colour file
    // (x19-x28 plus x0-x8/x12-x15) applies to every function without
    // inline asm and not @naked; ir_a64_seed_wide_ceilings caps
    // everything a non-whitelisted op could clobber back to the
    // callee-saved ten, so call-free inner loops get the caller-saved
    // registers and everything else behaves exactly as before.
    uint64 saved_num_regs = IR_NUM_REGS
    ir_color_ceil_reset()
    if ir_a64_fn_wide_ok() != 0 && is_naked == 0 {
        ir_regalloc_init_arm64_wide()
        ir_a64_seed_param_ceilings()
        ir_a64_seed_wide_ceilings()
    } else {
        ir_regalloc_init_arm64()
    }
    ir_graph_color()

    // 3a. Dedicated f64 colouring over d8-d15 (sets ir_a64_uses_fpr,
    // which gates the FP callee-saved bank in the prologue/epilogue).
    ir_a64_fpr_alloc()

    // 4. Compute spill count — one slot per vreg, matching
    // ir_a64_spill_offset's vreg-indexed mapping (a colour ceiling can
    // spill ANY vreg, including low-numbered ones).
    ir_spill_count = 0
    if ir_vreg_next > 1 {
        ir_spill_count = ir_vreg_next - 1
    }

    // 4b. Pre-scan the (post-optimization) IR: leafness, outgoing
    // overflow-arg needs, and physical callee-saved registers written
    // directly by ASM argument constraints.
    //   - a64_has_call: IR_CALL(50) / IR_CALL_IND(87) emit BL/BLR, so x30
    //     must be saved. On Windows (target_os==2) nearly every lowered op
    //     may call through the IAT (BLR x16), so treat everything as
    //     non-leaf there.
    //   - a64_has_asm: an IR_ASM_BLOCK(96) can contain anything (BL,
    //     clobbers of any callee-saved reg, stack use), so fall back to
    //     the old maximally-conservative frame: save all 10 colours +
    //     x29/x30 and keep the full 128-byte overflow reserve.
    //   - a64_ovf_slots: highest outgoing stack-arg slot used by IR_ARG
    //     (imm 8..99) — sizes the bottom-of-frame overflow reserve.
    //   - a64_forced_mask: IR_ARG with a direct register target (imm >=
    //     100) that lands on x19-x28 clobbers a callee-saved reg the
    //     allocator never handed out; force it into the save mask.
    uint64 a64_has_call = 0
    uint64 a64_has_asm = 0
    uint64 a64_ovf_slots = 0
    uint64 a64_forced_mask = 0
    if target_os == 2 { a64_has_call = 1 }
    uint64 psb = 0
    while psb < ir_bb_count {
        uint64 psi = ir_bb_first_insn(psb)
        while psi != 0xFFFFFFFF {
            uint64 pso = ir_insn_opcode(psi)
            if pso == 50 || pso == 87 { a64_has_call = 1 }
            if pso == 96 { a64_has_asm = 1 }
            if pso == 51 {
                uint64 psimm = ir_insn_imm(psi)
                if psimm >= 8 && psimm < 100 {
                    uint64 slots = psimm - 7
                    if slots > a64_ovf_slots { a64_ovf_slots = slots }
                }
                if psimm >= 100 {
                    uint64 pt = psimm - 100
                    if pt >= 19 && pt <= 28 {
                        a64_forced_mask = a64_forced_mask | (1 << (pt - 19))
                    }
                }
            }
            psi = ir_insn_next(psi)
        }
        psb = psb + 1
    }
    uint64 a64_save_lr = 0
    if a64_has_call != 0 { a64_save_lr = 1 }
    if a64_has_asm != 0 { a64_save_lr = 1 }

    // Size the overflow-arg reserve to what this function's calls need.
    // MUST be set before ir_snapshot_debug_vars and before any emission:
    // ir_a64_spill_offset and IR_STACK_ADDR read the static. Windows and
    // ASM-block functions keep the historical full reserve (Windows
    // lowering writes stack args outside the IR_ARG path).
    IR_A64_OVERFLOW_RESERVE = a64_ovf_slots * 8
    // For ASM/Windows the historical 128 bytes is a FLOOR, not an override:
    // with up to 24 outgoing stack args (192 bytes) a hard 128 would let
    // IR_ARG store past the reserve and into the spill area.
    if a64_has_asm != 0 || target_os == 2 {
        if IR_A64_OVERFLOW_RESERVE < 128 { IR_A64_OVERFLOW_RESERVE = 128 }
    }

    // Callee-saved colours actually used by this function.
    uint64 a64_used_mask = ir_used_color_mask() | a64_forced_mask
    if a64_has_asm != 0 { a64_used_mask = 0x3FF }
    uint64 a64_nsave = 0
    uint64 a64_mc = 0
    while a64_mc < 10 {
        if ((a64_used_mask >> a64_mc) & 1) != 0 { a64_nsave = a64_nsave + 1 }
        a64_mc = a64_mc + 1
    }

    // FP callee-saved bank: only the d8-d15 homes ir_a64_fpr_alloc (step
    // 3a) actually handed out. An ASM block could clobber any d-register,
    // so has_asm forces the full bank whenever d-homes exist — the same
    // conservative fallback as the all-colours GPR mask above.
    uint64 a64_dmask = ir_a64_fpr_used_mask()
    if a64_has_asm != 0 && a64_dmask != 0 { a64_dmask = 0xFF }
    uint64 a64_dsave = 0
    uint64 a64_dc = 0
    while a64_dc < 8 {
        if ((a64_dmask >> a64_dc) & 1) != 0 { a64_dsave = a64_dsave + 1 }
        a64_dc = a64_dc + 1
    }

    // 4a. Snapshot the function's var map for DWARF (if -g)
    ir_snapshot_debug_vars()

    // NOTE: IR_NUM_REGS must stay at 10 through emission — ir_get_phys_reg()
    // uses it to distinguish colors from spills. Restore AFTER emission completes.

    // 5. Compute frame size
    // Callee-saved area: only the GPR colours actually used, plus x29/x30
    // for non-leaf functions (a BL clobbers x30; a leaf never touches it),
    // plus only the d8-d15 homes ir_a64_fpr_alloc actually handed out
    // (AAPCS64: d8-d15 must be preserved). A function using two d-homes
    // saves two d-registers, not eight.
    uint64 callee_save_size = a64_nsave * 8 + a64_dsave * 8
    if a64_save_lr != 0 { callee_save_size = callee_save_size + 16 }
    uint64 spill_size = ir_spill_count * 8
    // 32-byte scratchpad for mid-function temp buffers (fmt_uint digits,
    // clock_gettime timespec, execve argv, etc). Using a fixed offset avoids
    // dynamic SP shifts that invalidate spill slot addresses.
    uint64 scratch_size = 32
    // Total frame = spill + stack arrays + scratch + callee save, must be 16-aligned.
    // Layout from SP upward:
    //   [SP + 0 .. IR_A64_OVERFLOW_RESERVE)   — stack slots for outgoing calls' args 9+
    //   [spills ...]
    //   [stack arrays ...]                    — compile-time-sized local arrays (IR_STACK_ADDR)
    //   [scratchpad ...]
    //   [saved callee regs]
    // With the overflow reserve at the bottom, the caller can STR
    // outgoing args to [SP + offset] without any SUB — the callee
    // reads [SP + callee_frame + (idx-8)*8] = caller's arg slots.
    uint64 total_frame = IR_A64_OVERFLOW_RESERVE + spill_size + ir_stack_array_bytes + scratch_size + callee_save_size
    if (total_frame & 15) != 0 { total_frame = total_frame + 16 - (total_frame & 15) }
    if is_naked != 0 { total_frame = 0 }

    ir_frame_size = total_frame
    // Scratchpad sits right after the stack-array region.
    ir_a64_scratch_off = IR_A64_OVERFLOW_RESERVE + spill_size + ir_stack_array_bytes

    // 5a. For main(): set up argc/argv BEFORE prologue
    uint32 fn_name_tok = ast_data1(fn_node)
    if tok_matches(fn_name_tok, "main", 4) != 0 && freestanding == 0 && target_os != 2 {
        if target_os == 1 {
            // macOS Mach-O: _main receives argc in x0, argv in x1 as function params
            uint64 argc_off_m = static_lookup_by_name("cli_argc", 8)
            if argc_off_m != 0xFFFFFFFF {
                emit_a64_static_store(argc_off_m)  // store x0 (argc)
            }
            emit_a64_mov(0, 1)  // x0 = argv (x1)
            uint64 argv_off_m = static_lookup_by_name("cli_argv", 8)
            if argv_off_m != 0xFFFFFFFF {
                emit_a64_static_store(argv_off_m)  // store x0 (was x1 = argv)
            }
        } else {
            // Linux/Android ELF: argc/argv on stack. [SP]=argc, [SP+8]=&argv[0]
            emit_a64_ldr(0, 31, 0)
            uint64 argc_off = static_lookup_by_name("cli_argc", 8)
            if argc_off != 0xFFFFFFFF {
                emit_a64_static_store(argc_off)
            }
            emit_a64_add_imm(0, 31, 8)
            uint64 argv_off = static_lookup_by_name("cli_argv", 8)
            if argv_off != 0xFFFFFFFF {
                emit_a64_static_store(argv_off)
            }
        }
        // envp: Linux/Android = sp + 8 + (argc+1)*8; macOS = argv + (argc+1)*8.
        // The legacy codegen populates this; the IR path was silently leaving
        // cli_envp at 0, so exec_process() forwarded envp=NULL — fine on plain
        // Linux but breaks Android bionic which needs at least LD_* vars to
        // start the child process.
        uint64 envp_off_main = static_lookup_by_name("cli_envp", 8)
        if envp_off_main != 0xFFFFFFFF {
            if target_os == 1 {
                uint64 argc_off_env = static_lookup_by_name("cli_argc", 8)
                if argc_off_env != 0xFFFFFFFF { emit_a64_static_load(argc_off_env) }
                emit_a64_mov(9, 0)
                emit_a64_add_imm(9, 9, 1)
                emit_a64_mov_imm(10, 8)
                emit_a64_mul(9, 9, 10)
                uint64 argv_off_env = static_lookup_by_name("cli_argv", 8)
                if argv_off_env != 0xFFFFFFFF { emit_a64_static_load(argv_off_env) }
                emit_a64_add(0, 0, 9)
            } else {
                emit_a64_ldr(9, 31, 0)
                emit_a64_add_imm(9, 9, 1)
                emit_a64_mov_imm(10, 8)
                emit_a64_mul(9, 9, 10)
                emit_a64_add_imm(0, 31, 8)
                emit_a64_add(0, 0, 9)
            }
            emit_a64_static_store(envp_off_main)
        }
    }
    if tok_matches(fn_name_tok, "main", 4) != 0 && freestanding == 0 && target_os == 2 {
        // Windows ARM64: GetCommandLineA via IAT
        emit_a64_win_call_iat(7)
        uint64 argv_off_w = static_lookup_by_name("cli_argv", 8)
        if argv_off_w != 0xFFFFFFFF {
            emit_a64_static_store(argv_off_w)
        }
        emit_a64_mov_imm(0, 0xFFFFFFFF)
        uint64 argc_off_w = static_lookup_by_name("cli_argc", 8)
        if argc_off_w != 0xFFFFFFFF {
            emit_a64_static_store(argc_off_w)
        }
    }

    // 6. Emit prologue (skip for @naked)
    // Save only the callee-saved colours this function actually uses
    // (plus x29/x30 when non-leaf) — ir_a64_emit_callee_frame packs them
    // into STP pairs and is called with identical arguments from the
    // epilogue, so save and restore mirror by construction.
    uint64 cs_base = IR_A64_OVERFLOW_RESERVE + spill_size + ir_stack_array_bytes + scratch_size
    if is_naked == 0 {
        // SUB SP, SP, #total_frame
        emit_a64_sub_sp_imm(total_frame)
        ir_a64_emit_callee_frame(a64_used_mask, a64_dmask, cs_base, a64_save_lr, 0)
    }

    // 7. Allocate branch/return fixup tracking — see ir_block_offsets_cap
    //    note in ir.kr's x86 emitter for why this is now grow-as-needed.
    uint64 bo_need = ir_bb_count
    if bo_need < 4096 { bo_need = 4096 }
    if bo_need > ir_block_offsets_cap {
        if ir_block_offsets != 0 { dealloc(ir_block_offsets) }
        ir_block_offsets = alloc(bo_need * 8)
        ir_block_offsets_cap = bo_need
    }
    uint64 br_need = ir_bb_count * 4
    if br_need < 2048 { br_need = 2048 }
    if br_need > ir_br_fixups_cap {
        if ir_br_fixups != 0 { dealloc(ir_br_fixups) }
        ir_br_fixups = alloc(br_need * 8)
        ir_br_fixups_cap = br_need
    }
    uint64 ret_need = ir_bb_count
    if ret_need < 1024 { ret_need = 1024 }
    if ret_need > ir_ret_fixups_cap {
        if ir_ret_fixups != 0 { dealloc(ir_ret_fixups) }
        ir_ret_fixups = alloc(ret_need * 4)
        ir_ret_fixups_cap = ret_need
    }
    ir_br_fixup_count = 0
    ir_ret_fixup_count = 0

    // 8. Emit all basic blocks
    uint64 bi = 0
    while bi < ir_bb_count {
        // Record this block's code offset
        uint64 bop = ir_block_offsets + bi * 8
        unsafe { *(bop as uint64) = out_len }
        // Reset the spill-reload peephole at every BB boundary so a
        // branch target never lands mid-pattern; clear any stale
        // compare-fusion handoff for the same reason.
        ir_a64_peephole_reset()
        ir_a64_fused_cmp_op = 0

        // Emit non-terminator instructions
        uint64 ii = ir_bb_first_insn(bi)
        while ii != 0xFFFFFFFF {
            uint64 iop = ir_insn_opcode(ii)
            if iop != 40 && iop != 41 {
                ir_emit_arm64_insn(ii)
            }
            ii = ir_insn_next(ii)
        }

        // Emit block terminator
        uint64 last = ir_bb_last_insn(bi)
        if last != 0xFFFFFFFF {
            uint64 last_op = ir_insn_opcode(last)
            if last_op == 40 {
                // IR_BR: unconditional branch to target_bb
                uint64 target = ir_insn_imm(last)
                if target != bi + 1 {
                    // Record fixup [patch_offset, target_bb]
                    uint64 fp = ir_br_fixups + ir_br_fixup_count * 8
                    uint32 po = out_len
                    unsafe { *(fp as uint32) = po }
                    uint64 fp4 = fp + 4
                    uint32 tb = target
                    unsafe { *(fp4 as uint32) = tb }
                    ir_br_fixup_count = ir_br_fixup_count + 1
                    emit_a64(0x14000000)    // B #0 (placeholder)
                }
            }
            if last_op == 41 {
                // IR_BR_COND. TRUE target = imm, FALSE target = succ0.
                // Three shapes, cheapest first:
                //   - fused compare handoff: emit `cmp` here and branch
                //     directly on flags with B.<cond> — no cset, no cbnz,
                //     and when the TRUE edge is the fall-through the
                //     condition is INVERTED to target FALSE, dropping the
                //     trailing unconditional B entirely (one branch per
                //     loop iteration, like gcc).
                //   - non-fused with TRUE edge falling through: CBZ
                //     cond, false_target (inverted, again no B).
                //   - non-fused otherwise: CBNZ cond, true; B false.
                // All conditional placeholders carry their final opcode +
                // Rt/cond bits; the patcher only fills the imm19 field
                // (fixup tag bit 31).
                uint64 target_true = ir_insn_imm(last)
                uint64 target_false = ir_bb_succ0(bi)
                uint64 br_insn = 0
                if ir_a64_fused_cmp_op != 0 {
                    uint64 fa_reg = ir_a64_resolve_src(ir_a64_fused_cmp_s1, 9)
                    if ir_a64_fused_cmp_s2 == 0 {
                        ir_a64_cmp_imm(fa_reg, ir_a64_fused_cmp_imm)
                    } else {
                        uint64 fb_reg = ir_a64_resolve_src(ir_a64_fused_cmp_s2, 10)
                        emit_a64_cmp(fa_reg, fb_reg)
                    }
                    uint64 fcond = ir_a64_cmp_cond(ir_a64_fused_cmp_op)
                    ir_a64_fused_cmp_op = 0
                    // B.cond placeholder — invert if branching to FALSE.
                    if target_true == bi + 1 {
                        br_insn = 0x54000000 | (fcond ^ 1)
                    } else {
                        br_insn = 0x54000000 | fcond
                    }
                } else {
                    uint64 cond_v = ir_insn_src1(last)
                    uint64 cond_r = ir_a64_resolve_src(cond_v, 9)
                    if target_true == bi + 1 {
                        br_insn = 0xB4000000 | cond_r     // CBZ -> false
                    } else {
                        br_insn = 0xB5000000 | cond_r     // CBNZ -> true
                    }
                }
                if target_true == bi + 1 {
                    // TRUE edge falls through: single inverted branch to
                    // FALSE (or nothing if FALSE also falls through).
                    if target_false != 0xFFFFFFFF && target_false != bi + 1 {
                        uint64 fp = ir_br_fixups + ir_br_fixup_count * 8
                        uint32 po = out_len
                        unsafe { *(fp as uint32) = po }
                        uint64 fp4 = fp + 4
                        uint32 tb = target_false | 0x80000000
                        unsafe { *(fp4 as uint32) = tb }
                        ir_br_fixup_count = ir_br_fixup_count + 1
                        emit_a64(br_insn)
                    }
                } else {
                    uint64 fp = ir_br_fixups + ir_br_fixup_count * 8
                    uint32 po = out_len
                    unsafe { *(fp as uint32) = po }
                    uint64 fp4 = fp + 4
                    uint32 tb = target_true | 0x80000000
                    unsafe { *(fp4 as uint32) = tb }
                    ir_br_fixup_count = ir_br_fixup_count + 1
                    emit_a64(br_insn)
                    // B to false target if not fall-through
                    if target_false != 0xFFFFFFFF && target_false != bi + 1 {
                        uint64 fp2 = ir_br_fixups + ir_br_fixup_count * 8
                        uint32 po2 = out_len
                        unsafe { *(fp2 as uint32) = po2 }
                        uint64 fp24 = fp2 + 4
                        uint32 tb2 = target_false
                        unsafe { *(fp24 as uint32) = tb2 }
                        ir_br_fixup_count = ir_br_fixup_count + 1
                        emit_a64(0x14000000)    // B #0 (placeholder)
                    }
                }
            }
        }

        bi = bi + 1
    }

    // 9. Patch branch fixups
    uint64 fi = 0
    while fi < ir_br_fixup_count {
        uint64 fp = ir_br_fixups + fi * 8
        uint32 patch_off = 0
        unsafe { *(fp as uint32) -> patch_off }
        uint64 fp4 = fp + 4
        uint32 target_bb_raw = 0
        unsafe { *(fp4 as uint32) -> target_bb_raw }
        uint64 wraw = target_bb_raw
        uint64 is_imm19 = wraw & 0x80000000
        uint64 wtb = wraw & 0x7FFFFFFF
        // Get target block offset
        uint64 tbp = ir_block_offsets + wtb * 8
        uint64 target_off = 0
        unsafe { *(tbp as uint64) -> target_off }
        uint64 wpo = patch_off
        uint64 disp = target_off - wpo
        if is_imm19 != 0 {
            // imm19-class branch (CBNZ/CBZ/B.cond): the placeholder
            // already carries its opcode and Rt/cond bits — fill in only
            // the displacement field (bits 5-23).
            uint64 insn_addr = out_buf + wpo
            uint32 old_insn = 0
            unsafe { *(insn_addr as uint32) -> old_insn }
            uint64 wo = old_insn
            uint64 new_insn = (wo & 0xFF00001F) | (a64_check_b19(disp) << 5)
            patch_u32(wpo, new_insn)
        } else {
            // Patch B
            uint64 new_insn = 0x14000000 | a64_check_b26(disp)
            patch_u32(wpo, new_insn)
        }
        fi = fi + 1
    }

    // 10. Patch return fixups — all point to epilogue
    uint64 epilogue_off = out_len
    uint64 ri2 = 0
    while ri2 < ir_ret_fixup_count {
        uint64 rfp = ir_ret_fixups + ri2 * 4
        uint32 rpatch = 0
        unsafe { *(rfp as uint32) -> rpatch }
        uint64 wrp = rpatch
        uint64 rdisp = epilogue_off - wrp
        uint64 new_insn = 0x14000000 | a64_check_b26(rdisp)
        patch_u32(wrp, new_insn)
        ri2 = ri2 + 1
    }

    // 11. Epilogue (skip for @naked)
    if is_naked == 0 {
        // For main(): auto-insert exit syscall. Without this, returning
        // from main() jumps to an undefined LR -> segfault. Use the
        // current x0 as the exit code: IR_RET writes the return value
        // there, IR_RET_VOID writes zero — so `return N` from main
        // produces exit status N.
        if tok_matches(fn_name_tok, "main", 4) != 0 && freestanding == 0 {
            if target_os == 2 {
                emit_a64_win_call_iat(0)
            } else {
                if target_os == 1 { emit_a64_syscall_nr(1) } else { emit_a64_syscall_nr(93) }
                emit_a64_svc("main() epilogue auto-exit")
            }
        }
        // Restore callee-saved registers. Exact mirror of the prologue:
        // same helper, same arguments -> same regs, same slots (GPR
        // colours, then x29/x30, then the used d8-d15 homes).
        ir_a64_emit_callee_frame(a64_used_mask, a64_dmask, cs_base, a64_save_lr, 1)
        // ADD SP, SP, #total_frame
        emit_a64_add_sp_imm(total_frame)
        // RET
        emit_a64_ret()
    }

    // Restore IR_NUM_REGS for x86_64 functions compiled later
    IR_NUM_REGS = saved_num_regs
}
