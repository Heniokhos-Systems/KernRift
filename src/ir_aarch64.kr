        // own built-in syscalls, which is why alloc()/write() worked on
        // this target while syscall_raw() did not. x16 is excluded from
        // both arm64 colour files (it is the linker-veneer / ADRP scratch),
        // and op 85 is not in ir_a64_op_widesafe, so writing it here cannot
        // clobber an allocated value.
        uint64 nr_r = ir_a64_resolve_src(s1_v, 9)
        if target_os == 1 {
