// KernRift self-hosted compiler -- AArch64 IR backend
//
// Emits ARM64 machine code from the shared SSA IR infrastructure (ir.kr).
// Uses the graph-colouring register allocator with 10 callee-saved registers
// (x19-x28) and the emit_a64_* instruction helpers from codegen_aarch64.kr.
//
// Frame layout (growing downward):
//   [old SP]
//     x29, x30          (STP, 16 bytes)
//     x19-x28           (5 STP pairs, 80 bytes)
//     spill slots        (ir_spill_count * 8 bytes, 16-aligned)
//   [new SP]

// Scratchpad offset within frame: a permanent 32-byte area reserved in the
// prologue for mid-function temp buffers (fmt_uint digits, timespec, argv, etc).
// Avoids dynamic SP shifts that would invalidate spill slot addresses.
static uint64 ir_a64_scratch_off = 0

// ADD Xd, SP, Xm  (extended register form, needed because register 31
// in the standard ADD encoding means XZR, not SP)
fn ir_a64_add_sp_reg(uint64 rd, uint64 rm) {
    // ADD Xd, SP, Xm, UXTX #0: 0x8B206000 | (Xm << 16) | (31 << 5) | Xd
    uint64 insn = 0x8B206000 | (rm << 16) | (31 << 5) | rd
    emit_a64(insn)
}

// STP Xt1, Xt2, [SP, #off]  — store-pair of two 64-bit regs at one
// 8-byte-aligned offset. Halves prologue size (one insn per pair vs
// two STRs). Offset must be multiple of 8 in range 0..504 for the
// unsigned form we use here.
fn ir_a64_stp_sp(uint64 rt1, uint64 rt2, uint64 off) {
    uint64 imm7 = (off / 8) & 0x7F
    uint64 insn = 0xA9000000 | (imm7 << 15) | (rt2 << 10) | (31 << 5) | rt1
    emit_a64(insn)
}

// LDP Xt1, Xt2, [SP, #off]
fn ir_a64_ldp_sp(uint64 rt1, uint64 rt2, uint64 off) {
    uint64 imm7 = (off / 8) & 0x7F
    uint64 insn = 0xA9400000 | (imm7 << 15) | (rt2 << 10) | (31 << 5) | rt1
    emit_a64(insn)
}

// Save (restore==0) or restore (restore==1) the function's callee-saved
// register set at [SP + cs_base ...]. `mask` holds the allocator colours
// actually used (bit c -> x19+c); `dmask` the d-homes actually used (bit
// i -> d8+i, from ir_a64_fpr_used_mask); `save_lr` appends x29/x30 for
// non-leaf functions. Both the prologue and the epilogue call THIS
// function with identical arguments, so the two sequences are mirror
// images by construction: same registers, same slots, in the same
// colour-ascending order (restore order does not matter for SP-relative
// slots — only the reg<->slot pairing does). Registers are packed
// pairwise into STP/LDP when every pair base fits the imm7 range;
// otherwise fall back to per-register STR/LDR via ir_a64_str_sp /
// ir_a64_ldr_sp / their _d_ variants, which handle arbitrary offsets
// through a scratch register (x11 — caller-saved, dead in both the
// prologue and the epilogue). GPRs and d-registers are paired within
// their own class only (STP Xt and STP Dt are different encodings), so
// the slot order is: used colours, x29/x30, used d-homes.
fn ir_a64_emit_callee_frame(uint64 mask, uint64 dmask, uint64 cs_base, uint64 save_lr, uint64 restore) {
    uint64 n = 0
    uint64 c = 0
    while c < 10 {
        if ((mask >> c) & 1) != 0 { n = n + 1 }
        c = c + 1
    }
    if save_lr != 0 { n = n + 2 }
    uint64 dc = 0
    while dc < 8 {
        if ((dmask >> dc) & 1) != 0 { n = n + 1 }
        dc = dc + 1
    }
    if n == 0 { return }
    uint64 use_pairs = 0
    if cs_base + n * 8 <= 512 { use_pairs = 1 }
    uint64 off = cs_base
    uint64 pend = 0xFFFFFFFF
    // GPR phase: used colours ascending, then x29/x30 for non-leaf.
    c = 0
    while c < 12 {
        uint64 r = 0xFFFFFFFF
        if c < 10 {
            if ((mask >> c) & 1) != 0 { r = 19 + c }
        } else {
            // c == 10 -> x29, c == 11 -> x30 (only for non-leaf)
            if save_lr != 0 { r = 19 + c }
        }
        if r != 0xFFFFFFFF {
            if use_pairs != 0 {
                if pend == 0xFFFFFFFF {
                    pend = r
                } else {
                    if restore == 0 { ir_a64_stp_sp(pend, r, off) }
                    else { ir_a64_ldp_sp(pend, r, off) }
                    off = off + 16
                    pend = 0xFFFFFFFF
                }
            } else {
                if restore == 0 { ir_a64_str_sp(r, off) }
                else { ir_a64_ldr_sp(r, off) }
                off = off + 8
            }
        }
        c = c + 1
    }
    if pend != 0xFFFFFFFF {
        if restore == 0 { ir_a64_str_sp(pend, off) }
        else { ir_a64_ldr_sp(pend, off) }
        off = off + 8
        pend = 0xFFFFFFFF
    }
    // FP phase: used d-homes ascending, paired within the FP class.
    dc = 0
    while dc < 8 {
        if ((dmask >> dc) & 1) != 0 {
            uint64 dr = 8 + dc
            if use_pairs != 0 {
                if pend == 0xFFFFFFFF {
                    pend = dr
                } else {
                    if restore == 0 { ir_a64_stp_d_sp(pend, dr, off) }
                    else { ir_a64_ldp_d_sp(pend, dr, off) }
                    off = off + 16
                    pend = 0xFFFFFFFF
                }
            } else {
                if restore == 0 { ir_a64_str_d_sp(dr, off) }
                else { ir_a64_ldr_d_sp(dr, off) }
                off = off + 8
            }
        }
        dc = dc + 1
    }
    if pend != 0xFFFFFFFF {
        if restore == 0 { ir_a64_str_d_sp(pend, off) }
        else { ir_a64_ldr_d_sp(pend, off) }
    }
}

// ---------------------------------------------------------------------------
// Register allocator setup for ARM64
// ---------------------------------------------------------------------------

fn ir_regalloc_init_arm64() {
    // Allocate or reuse the phys_regs table (sized centrally by
    // ir_phys_regs_ensure for the largest colour file any arch uses).
    IR_NUM_REGS = 10
    ir_phys_regs_ensure()
    uint64 p0 = ir_phys_regs
    unsafe { *(p0 as uint64) = 19 }       // color 0 -> x19
    uint64 p1 = ir_phys_regs + 8
    unsafe { *(p1 as uint64) = 20 }       // color 1 -> x20
    uint64 p2 = ir_phys_regs + 16
    unsafe { *(p2 as uint64) = 21 }       // color 2 -> x21
    uint64 p3 = ir_phys_regs + 24
    unsafe { *(p3 as uint64) = 22 }       // color 3 -> x22
    uint64 p4 = ir_phys_regs + 32
    unsafe { *(p4 as uint64) = 23 }       // color 4 -> x23
    uint64 p5 = ir_phys_regs + 40
    unsafe { *(p5 as uint64) = 24 }       // color 5 -> x24
    uint64 p6 = ir_phys_regs + 48
    unsafe { *(p6 as uint64) = 25 }       // color 6 -> x25
    uint64 p7 = ir_phys_regs + 56
    unsafe { *(p7 as uint64) = 26 }       // color 7 -> x26
    uint64 p8 = ir_phys_regs + 64
    unsafe { *(p8 as uint64) = 27 }       // color 8 -> x27
    uint64 p9 = ir_phys_regs + 72
    unsafe { *(p9 as uint64) = 28 }       // color 9 -> x28
}

// --- Wide ARM64 colour file -----------------------------------------------
// Same recipe as x86's ir_regalloc_init_x86_wide and xtensa's
// ir_regalloc_init_xtensa_wide: the AAPCS caller-saved registers join the
// file AFTER the callee-saved prefix, so the prologue/epilogue (which
// only look at colours 0-9) need no change and the ceiling for values
// that must survive a non-whitelisted op is simply 10.
//
// Thirteen additions, colours 10..22: x0-x8 and x12-x15. Exclusions that
// carry the correctness:
//   x9/x10 — the universal spill-reload / second-operand scratch pair
//            (ir_a64_resolve_src); within-op everywhere.
//   x11   — IR_MOD/IR_SMOD's quotient temp and the large-frame address
//            scratch in ir_a64_ldr_sp/str_sp/_d_ variants.
//   x16/x17 — linker veneer scratch (and x16 is the ADRP target of the
//            static/str-const fixup sequences plus macOS's syscall nr).
//   x18   — platform-reserved.
// x0-x7 arrive holding incoming arguments: parameter vregs are capped to
// the callee-saved prefix (ir_a64_seed_param_ceilings) so the leading
// param copies can never clobber a later param's source. x8 is only ever
// written by capped blocks (syscalls) or by trap-then-exit paths.
static uint64 IR_A64_WIDE_NUM_REGS = 23

fn ir_a64_wide_reg_for_color(uint64 color) -> uint64 {
    if color < 10 { return 19 + color }    // 0..9  -> x19..x28 (callee-saved)
    if color < 19 { return color - 10 }    // 10..18 -> x0..x8
    return color - 7                       // 19..22 -> x12..x15
}

fn ir_regalloc_init_arm64_wide() {
    IR_NUM_REGS = IR_A64_WIDE_NUM_REGS
    ir_phys_regs_ensure()
    uint64 c = 0
    while c < IR_A64_WIDE_NUM_REGS {
        uint64 p = ir_phys_regs + c * 8
        uint64 phys = ir_a64_wide_reg_for_color(c)
        unsafe { *(p as uint64) = phys }
        c = c + 1
    }
}

// Is this opcode's ARM64 handler audited safe for the wide colour file?
// "Safe" = the emitted code touches NO physical register outside
// {x9, x10, x11, d0-d2/s0-s1} beyond allocator-assigned operands
// (trap-then-exit paths may clobber anything). Differs from the x86 list
// by EXCLUDING 77/78/79/84/86: the arm64 static-data/str-const/fn-addr
// sequences materialise through X16 *and X0* (ADRP X16; ADD X0, X16),
// so they cap their block instead. Anything not listed caps its block
// (ir_a64_seed_wide_ceilings) — a wrong default is a lost optimisation,
// never a miscompile.
fn ir_a64_op_widesafe(uint64 o) -> uint64 {
    if o == 0 { return 1 }                    // elided slot
    if o >= 1 && o <= 19 { return 1 }         // const, alu, div/mod (x11), shifts, cmps
    if o >= 20 && o <= 27 { return 1 }        // float arith/cmp/conv via d0-d2/s0-s1
    if o >= 30 && o <= 32 { return 1 }        // load, store, stack_addr
    if o >= 40 && o <= 43 { return 1 }        // br, br_cond, ret (x0 at terminator), ret_void
    if o == 61 { return 1 }                   // copy (param homes capped separately)
    if o >= 97 && o <= 104 { return 1 }       // fsqrt, ffma, fcmps, f32/f64 conv
    if o == 107 || o == 108 { return 1 }      // itof32, ftoi32
    if o == 118 { return 1 }                  // fsqrt32
    if o >= 120 && o <= 123 { return 1 }      // signed cmps
    if o == 131 { return 1 }                  // arr_check (trap path exits the process)
    if o >= 132 && o <= 139 { return 1 }      // sdiv, smod (x11), sar, add/sub_imm (x10), ror, mul_imm, lea_bis
    if o == 143 { return 1 }                  // shl_imm
    if o == 147 || o == 148 { return 1 }      // load_bis/store_bis (x9/x10/x11 + operands only)
    return 0
}

// Does this function qualify for the wide colour file? Inline asm (op 96)
// can name any physical register — disqualify, as on every other arch.
fn ir_a64_fn_wide_ok() -> uint64 {
    uint64 b = 0
    while b < ir_bb_count {
        uint64 i = ir_bb_first_insn(b)
        while i != 0xFFFFFFFF {
            if ir_insn_opcode(i) == 96 { return 0 }
            i = ir_insn_next(i)
        }
        b = b + 1
    }
    return 1
}

// Cap every vreg a non-whitelisted op could clobber to the callee-saved
// colours (0..9). Instruction-level: see ir_seed_wide_ceilings_generic
// in ir.kr — at each dirty instruction the sets live before and after it
// plus its own operands are capped; temporaries living entirely between
// dirty points keep the full 23-colour file.
fn ir_a64_seed_wide_ceilings() {
    ir_seed_wide_ceilings_generic(1, 10)
}

// Cap every vreg that receives a register-passed parameter (x0-x7) to
// the callee-saved colours: the leading param copies read the arg
// registers one at a time in ascending param order, so a param homed in
// an arg register a LATER param copy still has to read would be
// clobbered. Overflow params (imm 8..99) load from the caller's frame
// after every arg register is consumed; imm >= 100 only occurs in
// asm-block functions, which never get the wide file.
fn ir_a64_seed_param_ceilings() {
    uint64 b = 0
    while b < ir_bb_count {
        uint64 i = ir_bb_first_insn(b)
        while i != 0xFFFFFFFF {
            if ir_insn_opcode(i) == 61 {
                if ir_insn_src1(i) == 0 {
                    if ir_insn_imm(i) < 8 {
                        ir_color_ceil_set(ir_insn_dest(i), 10)
                    }
                }
            }
            i = ir_insn_next(i)
        }
        b = b + 1
    }
}

// ---------------------------------------------------------------------------
// ARM64 spill helpers
// ---------------------------------------------------------------------------

// Number of bytes reserved at the BOTTOM of every function's stack
// frame to hold overflow-call-arguments (args 9+ under AAPCS64). With
// this space pre-reserved the SP-at-BL already points at the arg slots
// (callee reads `[SP + callee_frame + (idx-8)*8]` and finds our
// values), so we never SUB SP around a call — SUB would invalidate
// every spill offset we need to read between the overflow args.
// 128 = 16 slots, more than any call in the compiler today needs.
static uint64 IR_A64_OVERFLOW_RESERVE = 128

// Compute the spill slot offset for a spilled vreg. Spill slots live
// above the overflow-arg reservation so they remain addressable at a
// stable offset across calls.
fn ir_a64_spill_offset(uint64 vreg) -> uint64 {
    // One slot per vreg (vregs are 1-based) — a colour ceiling can spill
    // ANY vreg, so the old vreg-IR_NUM_REGS-1 mapping would underflow
    // for a low-numbered capped vreg (see ir_spill_offset in ir.kr and
    // xt_spill_offset's original note).
    uint64 slot = vreg - 1
    return IR_A64_OVERFLOW_RESERVE + slot * 8
}

// ---------------------------------------------------------------------------
// f64 FP-register residency (d8-d15)
// ---------------------------------------------------------------------------
// An f64 vreg (fkind == 1) whose colour is 0..7 lives in d8+colour instead
// of x19+colour. The colour namespace is shared with the integer file: two
// vregs with the same colour never interfere, so parking float vregs in a
// parallel callee-saved FP bank is safe — an int vreg with the same colour
// uses the x-register, the float vreg the d-register, and they are never
// live at the same time... and even if a copy connects them, the copy is
// emitted as a real fmov (see IR_COPY).
//
// Invariant: EVERY read of a d-homed vreg goes through ir_a64_resolve_src
// (generic: bounce bits to the x-scratch) or ir_a64_resolve_src_d (FP ops:
// use the d-register directly), and EVERY write goes through
// ir_a64_emit_store_spill (generic: fmov home, x-scratch — the per-insn
// dst_r is forced to the "spilled" path for d-homed dests) or
// ir_a64_store_dest_d. fmov x<->d is bit-exact, so a mis-tagged vreg that
// carries integer bits through a d-register is still correct.
//
// f32 (fkind 2), bool (3) and char (4) vregs are untouched: GPR as before.

static uint64 ir_a64_uses_fpr = 0

// fmov dN, xM (bit move GPR -> FP)
fn emit_a64_fmov_dx(uint64 dn, uint64 xm) {
    emit_a64(0x9E670000 | (xm << 5) | dn)
}

// fmov xN, dM (bit move FP -> GPR)
fn emit_a64_fmov_xd(uint64 xn, uint64 dm) {
    emit_a64(0x9E660000 | (dm << 5) | xn)
}

// fmov dN, dM — self-move elided like emit_a64_mov
fn emit_a64_fmov_dd(uint64 dn, uint64 dm) {
    if dn == dm { return }
    emit_a64(0x1E604000 | (dm << 5) | dn)
}

// Per-vreg d-register assignment, built by ir_a64_fpr_alloc after the
// shared colouring. One byte per vreg: 0 = no d-home, else 8..15.
static uint64 ir_a64_fpr_map = 0
static uint64 ir_a64_fpr_map_cap = 0

// D-register home for a vreg, or 0xFFFFFFFF when it has none.
fn ir_a64_fpr_home(uint64 vreg) -> uint64 {
    if vreg == 0 { return 0xFFFFFFFF }
    if vreg >= ir_vreg_next { return 0xFFFFFFFF }
    if ir_a64_fpr_map == 0 { return 0xFFFFFFFF }
    uint64 p = ir_a64_fpr_map + vreg
    uint8 c = 0
    unsafe { *(p as uint8) -> c }
    uint64 wc = c
    if wc == 0 { return 0xFFFFFFFF }
    return wc
}

// Dedicated f64 colouring over d8-d15. Runs after ir_graph_color, reusing
// its interference graph (ir_ig_buf; coalescing already merged follower
// rows into their representatives) and union-find. Float vregs get their
// d-homes from THIS pass, independent of the shared 10-colour integer
// file — so up to 8 simultaneously-live f64 values are register-resident
// no matter how much integer pressure the function has.
//
// Reps are coloured highest-vreg-first: loop-carried values created deep
// in the function beat the early-declared constants to the 8 homes, and a
// spilled constant costs only a dependency-free ldr d at each use while a
// spilled loop variable would put a str/ldr round-trip on the critical
// path. Any order is CORRECT (greedy only constrains against
// already-coloured interfering neighbours); the order is just a weight.
//
// Sets ir_a64_uses_fpr when at least one home was handed out.
fn ir_a64_fpr_alloc() {
    uint64 vcount = ir_vreg_next
    ir_a64_uses_fpr = 0
    if ir_a64_fpr_map == 0 {
        ir_a64_fpr_map_cap = 65536
        ir_a64_fpr_map = alloc(ir_a64_fpr_map_cap)
    }
    if vcount > ir_a64_fpr_map_cap { return }
    memset(ir_a64_fpr_map, 0, vcount)
    if vcount < 2 { return }
    // Interference-graph geometry — must mirror ir_graph_color exactly.
    uint64 row_words = (vcount + 63) / 64
    uint64 row_bytes = row_words * 8
    uint64 ig = ir_ig_buf
    if ig == 0 { return }
    uint64 vi = vcount - 1
    while vi >= 1 {
        if ir_vreg_fkind_get(vi) != 1 { vi = vi - 1; continue }
        if ir_uf_find(vi) != vi { vi = vi - 1; continue }
        // Collect d-colours already taken by interfering neighbours.
        uint64 used = 0
        uint64 nw = 0
        while nw < row_words {
            uint64 np = ig + vi * row_bytes + nw * 8
            uint64 nbits = 0
            unsafe { *(np as uint64) -> nbits }
            while nbits != 0 {
                uint64 iso = nbits & (0 - nbits)
                uint64 bp = ir_popcount64(iso - 1)
                uint64 neighbor = nw * 64 + bp
                if neighbor < vcount {
                    uint64 nrep = ir_uf_find(neighbor)
                    uint64 ncp = ir_a64_fpr_map + nrep
                    uint8 nc8 = 0
                    unsafe { *(ncp as uint8) -> nc8 }
                    uint64 nc = nc8
                    if nc != 0 { used = used | (1 << (nc - 8)) }
                }
                nbits = nbits & ~(1 << bp)
            }
            nw = nw + 1
        }
        uint64 fc = 0
        while fc < 8 {
            if ((used >> fc) & 1) == 0 {
                uint64 mp = ir_a64_fpr_map + vi
                uint8 mv = 8 + fc
                unsafe { *(mp as uint8) = mv }
                ir_a64_uses_fpr = 1
                fc = 8
            } else {
                fc = fc + 1
            }
        }
        vi = vi - 1
    }
    // Propagate rep homes to float followers. A float follower whose rep
    // is an integer vreg (mixed-class coalesce) stays home-less and keeps
    // its shared-colour x-register — the connecting copy is emitted as a
    // real fmov by IR_COPY, so the classes never silently alias.
    uint64 fv = 1
    while fv < vcount {
        if ir_vreg_fkind_get(fv) == 1 {
            uint64 rep = ir_uf_find(fv)
            if rep != fv {
                uint64 rp2 = ir_a64_fpr_map + rep
                uint8 rc2 = 0
                unsafe { *(rp2 as uint8) -> rc2 }
                uint64 fp2 = ir_a64_fpr_map + fv
                unsafe { *(fp2 as uint8) = rc2 }
            }
        }
        fv = fv + 1
    }
}

// Used-d-home mask: bit i set iff some f64 vreg was homed in d8+i by
// ir_a64_fpr_alloc. The prologue/epilogue save only these — the FP
// analogue of ir_used_color_mask, so a function using two d-homes saves
// two d-registers, not eight.
fn ir_a64_fpr_used_mask() -> uint64 {
    if ir_a64_uses_fpr == 0 { return 0 }
    uint64 m = 0
    uint64 v = 1
    while v < ir_vreg_next {
        uint64 dh = ir_a64_fpr_home(v)
        if dh != 0xFFFFFFFF { m = m | (1 << (dh - 8)) }
        v = v + 1
    }
    return m
}

// LDR Dt, [SP, #off] / STR Dt, [SP, #off] — large-offset-safe like
// ir_a64_ldr_sp/str_sp. x11 is the address scratch for huge frames.
fn ir_a64_ldr_d_sp(uint64 dt, uint64 off) {
    if off <= 32760 {
        emit_a64(0xFD400000 | (((off / 8) & 0xFFF) << 10) | (31 << 5) | dt)
    } else {
        emit_a64_mov_imm(11, off)
        ir_a64_add_sp_reg(11, 11)
        emit_a64(0xFD400000 | (11 << 5) | dt)
    }
}

fn ir_a64_str_d_sp(uint64 dt, uint64 off) {
    if off <= 32760 {
        emit_a64(0xFD000000 | (((off / 8) & 0xFFF) << 10) | (31 << 5) | dt)
    } else {
        emit_a64_mov_imm(11, off)
        ir_a64_add_sp_reg(11, 11)
        emit_a64(0xFD000000 | (11 << 5) | dt)
    }
}

// STP/LDP Dt1, Dt2, [SP, #off] for the prologue/epilogue d8-d15 save.
fn ir_a64_stp_d_sp(uint64 rt1, uint64 rt2, uint64 off) {
    uint64 imm7 = (off / 8) & 0x7F
    emit_a64(0x6D000000 | (imm7 << 15) | (rt2 << 10) | (31 << 5) | rt1)
}

fn ir_a64_ldp_d_sp(uint64 rt1, uint64 rt2, uint64 off) {
    uint64 imm7 = (off / 8) & 0x7F
    emit_a64(0x6D400000 | (imm7 << 15) | (rt2 << 10) | (31 << 5) | rt1)
}

// Resolve a vreg for use as an f64 operand: its d-home if it has one,
// otherwise materialise the bits into the FP scratch (d0/d1/d2). Spilled
// f64 vregs load straight from the slot into the FP file — no GPR bounce.
fn ir_a64_resolve_src_d(uint64 vreg, uint64 dscratch) -> uint64 {
    if vreg == 0 { return dscratch }
    uint64 dh = ir_a64_fpr_home(vreg)
    if dh != 0xFFFFFFFF { return dh }
    uint64 phys = ir_get_phys_reg(vreg)
    if phys != 0xFFFFFFFF {
        emit_a64_fmov_dx(dscratch, phys)
        return dscratch
    }
    ir_a64_ldr_d_sp(dscratch, ir_a64_spill_offset(vreg))
    return dscratch
}

// Where an FP op should compute its f64 result: the dest's d-home when it
// has one (result lands directly, ir_a64_store_dest_d is then a no-op),
// else the FP scratch.
fn ir_a64_fpr_dest(uint64 vreg, uint64 dscratch) -> uint64 {
    uint64 dh = ir_a64_fpr_home(vreg)
    if dh != 0xFFFFFFFF { return dh }
    return dscratch
}

// Finish an FP op whose f64 result sits in dsrc.
fn ir_a64_store_dest_d(uint64 vreg, uint64 dsrc) {
    uint64 dh = ir_a64_fpr_home(vreg)
    if dh != 0xFFFFFFFF {
        emit_a64_fmov_dd(dh, dsrc)
        return
    }
    uint64 phys = ir_get_phys_reg(vreg)
    if phys != 0xFFFFFFFF {
        emit_a64_fmov_xd(phys, dsrc)
        return
    }
    ir_a64_str_d_sp(dsrc, ir_a64_spill_offset(vreg))
}

// Peephole tracking for spill-reload elision (same pattern as the x86
// backend uses in ir.kr). If the last bytes emitted were exactly
// `store_spill reg, vreg` and the very next emission would be
// `load_spill reg, vreg` (same reg + same vreg, no bytes in between),
// the reload is redundant — the value is still in the register.
static uint64 ir_a64_last_spill_vreg = 0xFFFFFFFF
static uint64 ir_a64_last_spill_reg = 0xFFFFFFFF
static uint64 ir_a64_last_spill_end = 0xFFFFFFFFFFFFFFFF

@export
fn ir_a64_peephole_reset() {
    ir_a64_last_spill_vreg = 0xFFFFFFFF
    ir_a64_last_spill_reg = 0xFFFFFFFF
    ir_a64_last_spill_end = 0xFFFFFFFFFFFFFFFF
}

// CMP+B.cond fusion handoff (same shape as xtensa's xt_fused_cmp_op):
// when ir_cmp_fuse_code says a compare's only consumer is the block's
// BR_COND terminator, the compare handler emits NOTHING and stashes its
// operands here; the terminator emits `cmp` + `b.<cond>` directly —
// one branch on flags instead of cset + cbnz + b.
static uint64 ir_a64_fused_cmp_op = 0
static uint64 ir_a64_fused_cmp_s1 = 0
static uint64 ir_a64_fused_cmp_s2 = 0
static uint64 ir_a64_fused_cmp_imm = 0

// Map an integer compare opcode to the AArch64 condition code that is
// TRUE exactly when the compare is true. Unsigned: EQ NE LO LS HI HS;
// signed: LT LE GT GE. Inversion (for branching on the false edge) is
// cond ^ 1 — architectural for every code except AL/NV, which never
// appear here.
fn ir_a64_cmp_cond(uint64 op) -> uint64 {
    if op == 14 { return 0 }    // EQ
    if op == 15 { return 1 }    // NE
    if op == 16 { return 3 }    // LO (unsigned <)
    if op == 17 { return 9 }    // LS (unsigned <=)
    if op == 18 { return 8 }    // HI (unsigned >)
    if op == 19 { return 2 }    // HS (unsigned >=)
    if op == 120 { return 11 }  // LT
    if op == 121 { return 13 }  // LE
    if op == 122 { return 12 }  // GT
    return 10                   // GE (123)
}

// CMP Xn, #imm12 (alias for SUBS XZR, Xn, #imm). Caller guarantees
// imm <= 4095 (the optimizer's arm64 cmp-imm gate only folds that range).
fn ir_a64_cmp_imm(uint64 rn, uint64 imm) {
    emit_a64(0xF100001F | (imm << 10) | (rn << 5))
}

// Load a spilled vreg into scratch register (x9 or x10).
// ARM64 LDR Xt,[Xn,#imm] uses a 12-bit scaled field: max offset = 4095*8 = 32760.
// For larger offsets, use a scratch register to form the address.
fn ir_a64_load_spill(uint64 scratch, uint64 vreg) {
    // d-homed f64 vreg: the value lives in a d-register, not a slot.
    uint64 dh = ir_a64_fpr_home(vreg)
    if dh != 0xFFFFFFFF {
        emit_a64_fmov_xd(scratch, dh)
        return
    }
    // Peephole: if the prior emission was `store_spill scratch, vreg`
    // and nothing's been emitted since, the value is still in scratch.
    if vreg == ir_a64_last_spill_vreg && scratch == ir_a64_last_spill_reg && out_len == ir_a64_last_spill_end {
        ir_a64_last_spill_end = 0xFFFFFFFFFFFFFFFF   // one-shot
        return
    }
    uint64 off = ir_a64_spill_offset(vreg)
    ir_a64_ldr_sp(scratch, off)
}

// Store a register to the spill slot for vreg.
fn ir_a64_emit_store_spill(uint64 reg, uint64 vreg) {
    // d-homed f64 vreg: its home is a d-register — move the bits there
    // instead of touching the stack. Skip the peephole record: no slot
    // was written.
    uint64 dh = ir_a64_fpr_home(vreg)
    if dh != 0xFFFFFFFF {
        emit_a64_fmov_dx(dh, reg)
        return
    }
    uint64 off = ir_a64_spill_offset(vreg)
    ir_a64_str_sp(reg, off)
    ir_a64_last_spill_vreg = vreg
    ir_a64_last_spill_reg = reg
    ir_a64_last_spill_end = out_len
}

// Large-offset-safe LDR/STR from SP.
// ARM64 LDR Xt,[Xn,#imm] max offset = 4095*8 = 32760 bytes.
// For larger offsets, compute address in x11 first.
fn ir_a64_ldr_sp(uint64 rt, uint64 off) {
    if off <= 32760 {
        emit_a64_ldr(rt, 31, off)
    } else {
        emit_a64_mov_imm(11, off)
        ir_a64_add_sp_reg(11, 11)
        emit_a64_ldr(rt, 11, 0)
    }
}

fn ir_a64_str_sp(uint64 rt, uint64 off) {
    if off <= 32760 {
        emit_a64_str(rt, 31, off)
    } else {
        emit_a64_mov_imm(11, off)
        ir_a64_add_sp_reg(11, 11)
        emit_a64_str(rt, 11, 0)
    }
}

// Resolve a vreg to a physical register. If spilled, load into scratch (9 or 10).
fn ir_a64_resolve_src(uint64 vreg, uint64 scratch) -> uint64 {
    if vreg == 0 { return scratch }
    uint64 dh = ir_a64_fpr_home(vreg)
    if dh != 0xFFFFFFFF {
        emit_a64_fmov_xd(scratch, dh)
        return scratch
    }
    uint64 phys = ir_get_phys_reg(vreg)
    if phys != 0xFFFFFFFF { return phys }
    ir_a64_load_spill(scratch, vreg)
    return scratch
}

// ---------------------------------------------------------------------------
// Error backstops
// ---------------------------------------------------------------------------

// Any IR op the arm64 backend does not lower yet MUST fail loud. Before
// this backstop existed, ir_emit_arm64_insn silently fell off the end of
// its dispatch chain and emitted NOTHING — the dest register/spill slot
// was never written and the program read garbage (the shared
// ir_opt_recognize_rotate pass's IR_ROR shipped miscompiled this way in
// v2.8.32). Mirrors rv_nyi_op / xt_nyi_op.
fn a64_nyi_op(uint64 op) {
    uint8[24] nbuf
    uint64 pre = "error: arm64: IR op "
    write(2, pre, str_len(pre))
    uint64 nlen = fmt_uint(nbuf, op)
    write(2, nbuf, nlen)
    uint64 post = " not yet implemented\n"
    write(2, post, str_len(post))
    exit(1)
}

// ---------------------------------------------------------------------------
// ARM64 syscall number mapping
// ---------------------------------------------------------------------------
// The IR uses x86_64 Linux abstract syscall numbers. Map to ARM64 Linux.

fn ir_a64_syscall_nr(uint64 abstract_nr) -> uint64 {
    if target_os == 1 {
        // macOS ARM64: same numbers as macOS x86_64 (with 0x2000000 prefix removed,
        // macOS ARM64 uses the raw Darwin numbers directly)
        if abstract_nr == 231 { return 1 }    // exit_group -> exit(1)
        if abstract_nr == 1 { return 4 }      // write -> 4
        if abstract_nr == 0 { return 3 }      // read -> 3
        if abstract_nr == 2 { return 5 }      // open -> 5
        if abstract_nr == 3 { return 6 }      // close -> 6
        if abstract_nr == 8 { return 199 }    // lseek -> 199
        if abstract_nr == 9 { return 197 }    // mmap -> 197
        if abstract_nr == 11 { return 73 }    // munmap -> 73
        if abstract_nr == 59 { return 59 }    // execve -> 59
        if abstract_nr == 228 { return 228 }  // clock_gettime
        if abstract_nr == 15 { return 15 }    // chmod
        if abstract_nr == 90 { return 15 }    // fchmod -> chmod
        if abstract_nr == 257 { return 5 }    // openat -> open
        return abstract_nr
    }
    // Linux (0) and Android (3): ARM64 Linux syscall numbers
    if abstract_nr == 231 { return 93 }    // exit_group -> exit (93)
    if abstract_nr == 1 { return 64 }      // write -> 64
    if abstract_nr == 0 { return 63 }      // read -> 63
    if abstract_nr == 2 { return 56 }      // open -> openat (56)
    if abstract_nr == 3 { return 57 }      // close -> 57
    if abstract_nr == 8 { return 62 }      // lseek -> 62
    if abstract_nr == 9 { return 222 }     // mmap -> 222
    if abstract_nr == 11 { return 215 }    // munmap -> 215
    if abstract_nr == 59 { return 221 }    // execve -> 221
    if abstract_nr == 228 { return 113 }   // clock_gettime -> 113
    if abstract_nr == 15 { return 53 }     // chmod -> fchmodat (53)
    if abstract_nr == 90 { return 53 }     // fchmod -> fchmodat (53)
    if abstract_nr == 257 { return 56 }    // openat -> 56
    return abstract_nr
}

// ---------------------------------------------------------------------------
// ARM64 Windows syscall emitter (IAT-based)
// ---------------------------------------------------------------------------

fn ir_emit_arm64_win_syscall(uint64 abstract_nr, uint64 dest_v, uint64 dst_r) {
    if abstract_nr == 231 {
        // exit(code): ExitProcess(x0=exit_code)
        // IR_ARG already placed exit code in x0, no shuffling needed
        emit_a64_win_call_iat(0)
        return
    }

    if abstract_nr == 1 {
        // write(fd, buf, len): IR_ARG placed fd=x0, buf=x1, len=x2
        // If fd <= 2, convert via GetStdHandle; otherwise fd is already a handle.
        // Save buf and len across GetStdHandle call
        emit_a64_mov(11, 1)               // x11 = buf (save)
        emit_a64_mov(12, 2)               // x12 = len (save)
        // Check if fd <= 2: CMP x0, #2; B.HI skip_getstdhandle
        emit_a64_mov_imm(9, 2)
        emit_a64_cmp(0, 9)
        // B.HI +8 insns: skip NEG(1)+MOVZ(1)+SUB(1)+IAT(3)+B(1) = 7 insns, land on NOP at +8
        emit_a64(0x54000108)              // B.HI +8 insns (32 bytes)
        // GetStdHandle: x0 = -(fd + 10)
        emit_a64_neg(0, 0)
        emit_a64_mov_imm(9, 10)
        emit_a64_sub(0, 0, 9)
        emit_a64_win_call_iat(1)          // GetStdHandle -> x0 = handle
        emit_a64(0x14000002)              // B +2 (skip NOP, land on common path)
        // skip_getstdhandle: fd > 2, x0 already holds the native handle
        emit_a64(0xD503201F)              // NOP (landing pad for B.HI)
        // WriteFile(handle=x0, buf=x1, len=x2, &written=x3, overlapped=x4=NULL).
        // MSDN: lpNumberOfBytesWritten may be NULL only when lpOverlapped is
        // non-NULL. We do synchronous writes, so a real scratch slot is
        // required. Allocate 16 bytes on the stack for alignment, pre-zero
        // the DWORD slot, and point x3 at it; the value isn't read back
        // because write() ignores its return count for now.
        emit_a64_sub_sp_imm(16)           // sub sp, sp, #16
        emit_a64_mov_imm(9, 0)
        emit_a64(0xF90003E9)              // str x9, [sp]   — pre-zero
        emit_a64(0x910003E3)              // add x3, sp, #0 (&written)
        emit_a64_mov_imm(4, 0)            // x4 = NULL (overlapped)
        emit_a64_mov(2, 12)               // x2 = len
        emit_a64_mov(1, 11)               // x1 = buf
        emit_a64_win_call_iat(2)          // WriteFile
        emit_a64_add_sp_imm(16)           // add sp, sp, #16
    }

    if abstract_nr == 0 {
        // read(fd, buf, len): IR_ARG placed fd=x0, buf=x1, len=x2
        // If fd <= 2, convert via GetStdHandle.
        emit_a64_mov(11, 1)               // x11 = buf (save)
        emit_a64_mov(12, 2)               // x12 = len (save)
        emit_a64_mov_imm(9, 2)
        emit_a64_cmp(0, 9)
        // B.HI +8 insns: skip NEG(1)+MOVZ(1)+SUB(1)+IAT(3)+B(1) = 7 insns, land on NOP at +8
        emit_a64(0x54000108)              // B.HI +8 insns (32 bytes)
        // GetStdHandle: x0 = -(fd + 10)
        emit_a64_neg(0, 0)
        emit_a64_mov_imm(9, 10)
        emit_a64_sub(0, 0, 9)
        emit_a64_win_call_iat(1)          // GetStdHandle -> x0 = handle
        emit_a64(0x14000002)              // B +2 (skip NOP, land on common path)
        emit_a64(0xD503201F)              // NOP (landing pad for B.HI)
        // ReadFile(handle=x0, buf=x1, len=x2, &bytesRead=x3, overlapped=x4=NULL).
        // The 4th arg MUST be a real DWORD*: ReadFile returns BOOL in x0, and
        // without an out-slot we'd hand that BOOL back as file_read's byte
        // count (which made the CI test read 1 instead of 8 on ARM64 Windows).
        // Use [sp,#0] as an aligned 8-byte scratch slot for the DWORD.
        emit_a64_sub_sp_imm(16)           // sub sp, sp, #16
        emit_a64_mov_imm(9, 0)
        emit_a64(0xF90003E9)              // str x9, [sp]   — pre-zero the slot
        emit_a64(0x910003E3)              // add x3, sp, #0 (&bytesRead)
        emit_a64_mov_imm(4, 0)            // x4 = NULL (overlapped)
        emit_a64_mov(2, 12)               // x2 = len
        emit_a64_mov(1, 11)               // x1 = buf
        emit_a64_win_call_iat(4)          // ReadFile
        emit_a64(0xB94003E0)              // ldr w0, [sp]   — bytesRead (zero-extends)
        emit_a64_add_sp_imm(16)           // add sp, sp, #16
    }

    if abstract_nr == 2 {
        // open(path, flags): IR_ARG placed path=x0, flags=x1
        // CreateFileA(path, access, share, security, disposition, flags, template)
        // Save path and flags
        emit_a64_mov(11, 0)               // x11 = path
        emit_a64_mov(12, 1)               // x12 = flags (0=read, nonzero=write)
        // Compute access: if flags==0 -> GENERIC_READ (0x80000000), else GENERIC_WRITE (0x40000000)
        emit_a64_mov_imm(1, 0x80000000)   // default: GENERIC_READ (2 insns: MOVZ+MOVK)
        emit_a64_cbz(12, 12)              // if flags==0, skip GENERIC_WRITE (2 insns = 8 bytes)
        emit_a64_mov_imm(1, 0x40000000)   // GENERIC_WRITE (2 insns: MOVZ+MOVK)
        // x2 = FILE_SHARE_READ = 1
        emit_a64_mov_imm(2, 1)
        // x3 = NULL (security)
        emit_a64_mov_imm(3, 0)
        // x4 = disposition: if flags==0 -> OPEN_EXISTING(3), else CREATE_ALWAYS(2)
        emit_a64_mov_imm(4, 3)            // default: OPEN_EXISTING (1 insn)
        emit_a64_cbz(12, 8)               // if flags==0, skip CREATE_ALWAYS (1 insn = 4 bytes)
        emit_a64_mov_imm(4, 2)            // CREATE_ALWAYS (1 insn)
        // x5 = FILE_ATTRIBUTE_NORMAL = 0x80
        emit_a64_mov_imm(5, 0x80)
        // x6 = NULL (template)
        emit_a64_mov_imm(6, 0)
        // x0 = path
        emit_a64_mov(0, 11)
        emit_a64_win_call_iat(3)          // CreateFileA
    }

    if abstract_nr == 3 {
        // close(fd): CloseHandle(x0=handle)
        // IR_ARG already placed handle in x0
        emit_a64_win_call_iat(5)          // CloseHandle
    }

    if abstract_nr == 8 {
        // lseek(fd, offset, whence): GetFileSizeEx(handle, &size)
        // Used by file_size() builtin. SEEK_SET rewind return is unused, so this is safe.
        // IR_ARG: x0=handle, x1=offset, x2=whence
        // Allocate 16 bytes on scratchpad for output
        emit_a64_add_imm(11, 31, ir_a64_scratch_off)
        // Zero the output area
        emit_a64_mov_imm(9, 0)
        emit_a64_str(9, 11, 0)
        // x1 = &output (X11)
        emit_a64_mov(1, 11)
        // x0 = handle (already in place)
        emit_a64_win_call_iat(8)          // GetFileSizeEx
        // x11 is caller-saved (x0..x18) and is clobbered by the IAT call.
        // Recompute it from SP before loading the result — otherwise the
        // ldr dereferences whatever GetFileSizeEx left in x11 and the
        // process segfaults deep inside compile() the moment anyone calls
        // file_size() on Windows ARM64.
        emit_a64_add_imm(11, 31, ir_a64_scratch_off)
        // Load size from [X11]
        emit_a64_ldr(0, 11, 0)
    }

    // Move result to dest
    if dst_r != 0xFFFFFFFF && dst_r != 0 {
        emit_a64_mov(dst_r, 0)
    }
    if dst_r == 0xFFFFFFFF {
        ir_a64_emit_store_spill(0, dest_v)
    }
}

// ---------------------------------------------------------------------------
// Per-instruction emitter
// ---------------------------------------------------------------------------

fn ir_emit_arm64_insn(uint64 ii) {
    uint64 op = ir_insn_opcode(ii)
    // Opcode 0 = NOP: LICM-elided / nop-marked slots (see ir.kr). Must be
    // skipped explicitly now that the end of the dispatch chain is a loud
    // a64_nyi_op backstop instead of a silent fallthrough.
    if op == 0 { return }
    uint64 dest_v = ir_insn_dest(ii)
    uint64 s1_v = ir_insn_src1(ii)
    uint64 s2_v = ir_insn_src2(ii)
    uint64 imm = ir_insn_imm(ii)

    // DWARF line-table recording — see ir.kr's ir_emit_x86_insn.
    uint64 ir_src_tok = ir_insn_src_tok_at(ii)
    if ir_src_tok != 0 { line_table_record(ir_src_tok) }

    uint64 dst_r = ir_get_phys_reg(dest_v)
    // A d-homed f64 dest must never be written through its colour's
    // x-register: force the generic dest writes down the
    // ir_a64_emit_store_spill path, which lands the bits in the d-home.
    // (FP ops below check the d-home themselves and write it directly.)
    if ir_a64_fpr_home(dest_v) != 0xFFFFFFFF { dst_r = 0xFFFFFFFF }

    // ----- IR_STR_CONST (79): dst = lea string data -----
    if op == 79 {
        uint64 str_offset = imm
        // emit_a64_static_lea puts address in x0
        // Record string fixup
        str_fixups_ensure()
        uint64 fentry = str_fixups + str_fixup_count * 8
        uint32 cp = out_len
        unsafe { *(fentry as uint32) = cp }
        uint64 fe4 = fentry + 4
        uint32 so = str_offset
        unsafe { *(fe4 as uint32) = so }
        str_fixup_count = str_fixup_count + 1
        // ADRP + ADD sequence (patched by static fixup resolver)
        emit_a64(0x90000010)    // ADRP X16, #0
        emit_a64(0x91000200)    // ADD X0, X16, #0
        if dst_r != 0xFFFFFFFF {
            emit_a64_mov(dst_r, 0)
        } else {
            ir_a64_emit_store_spill(0, dest_v)
        }
        return
    }

    // ----- IR_CONST (1): dst = imm64 -----
    if op == 1 {
        if dst_r != 0xFFFFFFFF {
            emit_a64_mov_imm(dst_r, imm)
        } else {
            emit_a64_mov_imm(9, imm)
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_ADD (2) -----
    if op == 2 {
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 b_reg = ir_a64_resolve_src(s2_v, 10)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64_add(d, a_reg, b_reg)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_SUB (3) -----
    if op == 3 {
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 b_reg = ir_a64_resolve_src(s2_v, 10)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64_sub(d, a_reg, b_reg)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_MUL (4) -----
    if op == 4 {
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 b_reg = ir_a64_resolve_src(s2_v, 10)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64_mul(d, a_reg, b_reg)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_DIV (5) -----
    if op == 5 {
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 b_reg = ir_a64_resolve_src(s2_v, 10)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        // Debug-mode div-by-zero trap: ARM64 UDIV silently returns 0
        // for b==0 (no CPU trap), unlike x86 DIV which #DE's. Emit an
        // explicit exit(1) guard so programs behave the same under
        // --debug on both architectures.
        if debug_mode != 0 {
            uint64 dz_cbnz = out_len
            emit_a64(0xB5000000 | (b_reg & 0x1F))   // CBNZ xB, skip — patched below
            emit_a64_mov_imm(0, 1)
            emit_a64_mov_imm(8, 93)                  // exit syscall
            emit_a64_svc("/ divide-by-zero check (--debug)")
            uint64 dz_delta = out_len - dz_cbnz
            patch_u32(dz_cbnz, 0xB5000000 | (a64_check_b19(dz_delta) << 5) | (b_reg & 0x1F))
        }
        emit_a64_udiv(d, a_reg, b_reg)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_MOD (6): dst = src1 % src2 = src1 - (src1/src2)*src2 -----
    if op == 6 {
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 b_reg = ir_a64_resolve_src(s2_v, 10)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        if debug_mode != 0 {
            uint64 dz_cbnz = out_len
            emit_a64(0xB5000000 | (b_reg & 0x1F))
            emit_a64_mov_imm(0, 1)
            emit_a64_mov_imm(8, 93)
            emit_a64_svc("% divide-by-zero check (--debug)")
            uint64 dz_delta = out_len - dz_cbnz
            patch_u32(dz_cbnz, 0xB5000000 | (a64_check_b19(dz_delta) << 5) | (b_reg & 0x1F))
        }
        // x11 = a / b
        emit_a64_udiv(11, a_reg, b_reg)
        // d = a - x11 * b (MSUB d, x11, b, a)
        emit_a64_msub(d, 11, b_reg, a_reg)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_SDIV (132): signed divide -----
    if op == 132 {
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 b_reg = ir_a64_resolve_src(s2_v, 10)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        if debug_mode != 0 {
            uint64 dz_cbnz = out_len
            emit_a64(0xB5000000 | (b_reg & 0x1F))
            emit_a64_mov_imm(0, 1)
            emit_a64_mov_imm(8, 93)
            emit_a64_svc("/ divide-by-zero check (--debug)")
            uint64 dz_delta = out_len - dz_cbnz
            patch_u32(dz_cbnz, 0xB5000000 | (a64_check_b19(dz_delta) << 5) | (b_reg & 0x1F))
        }
        emit_a64_sdiv(d, a_reg, b_reg)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_SMOD (133): signed remainder = a - (a sdiv b) * b -----
    if op == 133 {
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 b_reg = ir_a64_resolve_src(s2_v, 10)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        if debug_mode != 0 {
            uint64 dz_cbnz = out_len
            emit_a64(0xB5000000 | (b_reg & 0x1F))
            emit_a64_mov_imm(0, 1)
            emit_a64_mov_imm(8, 93)
            emit_a64_svc("% divide-by-zero check (--debug)")
            uint64 dz_delta = out_len - dz_cbnz
            patch_u32(dz_cbnz, 0xB5000000 | (a64_check_b19(dz_delta) << 5) | (b_reg & 0x1F))
        }
        emit_a64_sdiv(11, a_reg, b_reg)
        emit_a64_msub(d, 11, b_reg, a_reg)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_AND (7) -----
    if op == 7 {
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 b_reg = ir_a64_resolve_src(s2_v, 10)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64_and(d, a_reg, b_reg)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_OR (8) -----
    if op == 8 {
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 b_reg = ir_a64_resolve_src(s2_v, 10)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64_orr(d, a_reg, b_reg)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_XOR (9) -----
    if op == 9 {
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 b_reg = ir_a64_resolve_src(s2_v, 10)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64_eor(d, a_reg, b_reg)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_SHL (10) -----
    if op == 10 {
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 b_reg = ir_a64_resolve_src(s2_v, 10)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64_lsl(d, a_reg, b_reg)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_SHR (11) -----
    if op == 11 {
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 b_reg = ir_a64_resolve_src(s2_v, 10)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64_lsr(d, a_reg, b_reg)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_SAR (134): arithmetic (sign-extending) shift right -----
    if op == 134 {
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 b_reg = ir_a64_resolve_src(s2_v, 10)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64_asr(d, a_reg, b_reg)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_SHL_IMM (143): dst = src1 << imm  (imm 0..63) -----
    // Produced by the shared const-fold's pow2-MUL strength reduction.
    // One instruction, no constant materialisation, unlike the reg-count
    // IR_SHL above (which costs a mov_imm + LSLV when the count is a
    // constant).
    if op == 143 {
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64_lsl_imm(d, a_reg, imm & 63)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_LEA_BIS (139): dst = src1 + src2 * scale, scale ∈ {2,4,8} --
    // Produced by ir_opt_recognize_lea_bis (gated to arches 0/1). arm64's
    // shifted-register ADD absorbs the whole scaled-index computation:
    // `add Xd, Xbase, Xidx, LSL #log2(scale)` — one instruction where the
    // old lowering spent mov_imm + mul + add. Scale 1 maps to shift 0
    // (plain add); the matcher only feeds 2/4/8 today.
    if op == 139 {
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 b_reg = ir_a64_resolve_src(s2_v, 10)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        uint64 lb_sh = 0
        if imm == 2 { lb_sh = 1 }
        if imm == 4 { lb_sh = 2 }
        if imm == 8 { lb_sh = 3 }
        emit_a64_add_lsl(d, a_reg, b_reg, lb_sh)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_ROR (137): dst = right-rotate(src1, src2 mod imm) -----
    // imm is the rotation WIDTH (ir.kr:159); the shared
    // ir_opt_recognize_rotate pass only ever produces imm=32 today.
    // Width 32 uses the 32-bit RORV (`ror wD, wN, wM`): it reads only the
    // low 32 bits of src1, rotates by src2 mod 32, and zeroes the upper
    // half — bit-identical to x86's `ROR r32, cl` lowering, so the result
    // is w32-clean and downstream `& 0xFFFFFFFF` masks stay elided
    // (const-fold relies on that, see ir.kr:10638). The hardware count is
    // taken mod datasize, matching the documented `src2 mod imm` contract
    // without an explicit mask (unlike riscv, which must AND with 31).
    if op == 137 {
        if imm != 32 && imm != 64 {
            // Loud-fail on a width no backend defines, mirroring riscv:
            // a future producer must not silently miscompile here.
            write(2, "error: arm64: IR_ROR width must be 32 or 64\n", 44)
            exit(1)
        }
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 b_reg = ir_a64_resolve_src(s2_v, 10)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        if imm == 32 {
            emit_a64_ror_w(d, a_reg, b_reg)
        } else {
            emit_a64_ror(d, a_reg, b_reg)
        }
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_NEG (12) -----
    if op == 12 {
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64_neg(d, a_reg)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_NOT (13) -----
    if op == 13 {
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64_mvn(d, a_reg)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_ADD_IMM (135) / IR_SUB_IMM (136): dst = src1 ± imm -----
    // imm is a signed-32 value in two's complement (optimizer gate).
    // Normalize to one effective addend e (negated for SUB_IMM), then use
    // the native immediate form: `add Xd, Xn, #e` for 0..4095, `sub Xd,
    // Xn, #-e` for small negatives — one instruction instead of the old
    // mov+add pair. Anything larger materializes into x10 (x9 may hold a
    // spilled src1) and falls back to the register form; 64-bit wrap
    // makes add-of-negative exactly equal sub-of-magnitude.
    if op == 135 || op == 136 {
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        uint64 e = imm
        if op == 136 { e = 0 - imm }
        uint64 neg = 0 - e
        if e <= 4095 {
            emit_a64(0x91000000 | (e << 10) | (a_reg << 5) | d)      // ADD Xd, Xn, #e
        } else if neg <= 4095 {
            emit_a64(0xD1000000 | (neg << 10) | (a_reg << 5) | d)    // SUB Xd, Xn, #-e
        } else {
            emit_a64_mov_imm(10, e)
            emit_a64_add(d, a_reg, 10)
        }
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_CMP_EQ (14) through IR_CMP_GE (19), IR_SCMP_LT (120)
    // ----- through IR_SCMP_GE (123) -----
    // src2 == 0 means the optimizer folded a constant into imm (arm64
    // gate: 0..4095, always fits CMP's imm12). If the compare's single
    // consumer is this block's BR_COND terminator, defer it entirely —
    // the terminator emits `cmp` + `b.<cond>` (see fusion handoff above).
    if (op >= 14 && op <= 19) || (op >= 120 && op <= 123) {
        if ir_cmp_fuse_code(ii) != 0 {
            ir_a64_fused_cmp_op = op
            ir_a64_fused_cmp_s1 = s1_v
            ir_a64_fused_cmp_s2 = s2_v
            ir_a64_fused_cmp_imm = imm
            return
        }
        uint64 a_reg = ir_a64_resolve_src(s1_v, 9)
        if s2_v == 0 {
            ir_a64_cmp_imm(a_reg, imm)
        } else {
            uint64 b_reg = ir_a64_resolve_src(s2_v, 10)
            emit_a64_cmp(a_reg, b_reg)
        }
        uint64 cond = ir_a64_cmp_cond(op)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64_cset(d, cond)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_LOAD (30): dest = *(src1), width in imm -----
    if op == 30 {
        uint64 addr_reg = ir_a64_resolve_src(s1_v, 10)
        if imm == 0 && s2_v != 0 { imm = s2_v }
        // f64 dest with a d-home: load straight into the FP file.
        if imm == 8 {
            uint64 ld_dh = ir_a64_fpr_home(dest_v)
            if ld_dh != 0xFFFFFFFF {
                emit_a64(0xFD400000 | (addr_reg << 5) | ld_dh)   // ldr dH, [addr]
                return
            }
        }
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        if imm == 8 {
            emit_a64_ldr(d, addr_reg, 0)
        } else if imm == 4 {
            emit_a64_ldr32(d, addr_reg, 0)
        } else if imm == 2 {
            emit_a64_ldrh(d, addr_reg, 0)
        } else {
            emit_a64_ldrb(d, addr_reg, 0)
        }
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_STORE (31): *(src1) = src2, width in dest_v -----
    if op == 31 {
        uint64 st_width = dest_v
        // d-homed f64 value: store straight from the FP file.
        if st_width == 8 {
            uint64 st_dh = ir_a64_fpr_home(s2_v)
            if st_dh != 0xFFFFFFFF {
                uint64 st_addr = ir_a64_resolve_src(s1_v, 9)
                emit_a64(0xFD000000 | (st_addr << 5) | st_dh)    // str dH, [addr]
                return
            }
        }
        uint64 addr_reg = ir_a64_resolve_src(s1_v, 9)
        uint64 val_reg = ir_a64_resolve_src(s2_v, 10)
        uint64 width = dest_v
        if width == 8 {
            emit_a64_str(val_reg, addr_reg, 0)
        } else if width == 4 {
            emit_a64_str32(val_reg, addr_reg, 0)
        } else if width == 2 {
            emit_a64_strh(val_reg, addr_reg, 0)
        } else {
            emit_a64_strb(val_reg, addr_reg, 0)
        }
        return
    }

    // ----- IR_LOAD_BIS (147): dest = *(src1 + src2 << k), width in imm --
    // Register-offset addressing produced by ir_opt_fuse_lea_mem: the
    // scaled-index add is folded into the access itself, so the 2-cycle
    // shifted-register ADD disappears from the address dependency chain.
    // The pass guarantees width ∈ {4, 8} with shift = log2(width).
    // Encodings verified against GNU as on Cortex-A72:
    //   ldr Xt, [Xn, Xm, LSL #3] = 0xF8607800 | (Rm<<16) | (Rn<<5) | Rt
    //   ldr Wt, [Xn, Xm, LSL #2] = 0xB8607800 | (Rm<<16) | (Rn<<5) | Rt
    //   ldr Dt, [Xn, Xm, LSL #3] = 0xFC607800 | (Rm<<16) | (Rn<<5) | Dt
    if op == 147 {
        if imm != 4 && imm != 8 {
            // Loud-fail on a width/shift pair the encodings above don't
            // cover — a future producer must not silently miscompile.
            write(2, "error: arm64: IR_LOAD_BIS width must be 4 or 8\n", 47)
            exit(1)
        }
        uint64 lb_base = ir_a64_resolve_src(s1_v, 9)
        uint64 lb_idx = ir_a64_resolve_src(s2_v, 10)
        if imm == 8 {
            // f64 dest with a d-home: load straight into the FP file.
            uint64 lb_dh = ir_a64_fpr_home(dest_v)
            if lb_dh != 0xFFFFFFFF {
                emit_a64(0xFC607800 | (lb_idx << 16) | (lb_base << 5) | lb_dh)
                return
            }
        }
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        if imm == 8 {
            emit_a64(0xF8607800 | (lb_idx << 16) | (lb_base << 5) | d)
        } else {
            emit_a64(0xB8607800 | (lb_idx << 16) | (lb_base << 5) | d)
        }
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_STORE_BIS (148): *(src1 + imm(vreg) << k) = src2 ---------
    // Width in dest_v (same shape as IR_STORE); imm holds the INDEX VREG.
    // Scratch order matters: base→x9, idx→x10, value→x11 LAST, because
    // resolving a spill offset > 32760 clobbers x11 internally
    // (ir_a64_ldr_sp) — the value must be the final resolve.
    //   str Xt, [Xn, Xm, LSL #3] = 0xF8207800 | (Rm<<16) | (Rn<<5) | Rt
    //   str Wt, [Xn, Xm, LSL #2] = 0xB8207800 | (Rm<<16) | (Rn<<5) | Rt
    //   str Dt, [Xn, Xm, LSL #3] = 0xFC207800 | (Rm<<16) | (Rn<<5) | Dt
    if op == 148 {
        uint64 sb_w = dest_v
        if sb_w != 4 && sb_w != 8 {
            write(2, "error: arm64: IR_STORE_BIS width must be 4 or 8\n", 48)
            exit(1)
        }
        uint64 sb_base = ir_a64_resolve_src(s1_v, 9)
        uint64 sb_idx = ir_a64_resolve_src(imm, 10)
        if sb_w == 8 {
            // d-homed f64 value: store straight from the FP file.
            uint64 sb_dh = ir_a64_fpr_home(s2_v)
            if sb_dh != 0xFFFFFFFF {
                emit_a64(0xFC207800 | (sb_idx << 16) | (sb_base << 5) | sb_dh)
                return
            }
        }
        uint64 sb_val = ir_a64_resolve_src(s2_v, 11)
        if sb_w == 8 {
            emit_a64(0xF8207800 | (sb_idx << 16) | (sb_base << 5) | sb_val)
        } else {
            emit_a64(0xB8207800 | (sb_idx << 16) | (sb_base << 5) | sb_val)
        }
        return
    }

    // ----- IR_STACK_ADDR (32): compute address of stack slot -----
    if op == 32 {
        // imm = offset within the stack-array region (placed directly
        // above spill slots in the frame). Absolute SP offset:
        //   IR_A64_OVERFLOW_RESERVE + ir_spill_count*8 + imm
        uint64 base_off = IR_A64_OVERFLOW_RESERVE + ir_spill_count * 8 + imm
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64_add_imm(d, 31, base_off)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_COPY (61) -----
    if op == 61 {
        if s1_v != 0 {
            // f64 fast paths: keep register-to-register copies inside the
            // FP file. When src and dest coalesced onto the same d-home
            // this emits nothing (fmov_dd elides self-moves).
            uint64 cp_dh = ir_a64_fpr_home(dest_v)
            if cp_dh != 0xFFFFFFFF {
                uint64 cp_s = ir_a64_resolve_src_d(s1_v, 0)
                emit_a64_fmov_dd(cp_dh, cp_s)
                return
            }
            uint64 cp_sh = ir_a64_fpr_home(s1_v)
            if cp_sh != 0xFFFFFFFF {
                if dst_r != 0xFFFFFFFF {
                    emit_a64_fmov_xd(dst_r, cp_sh)
                } else {
                    emit_a64_fmov_xd(9, cp_sh)
                    ir_a64_emit_store_spill(9, dest_v)
                }
                return
            }
            uint64 src_reg = ir_a64_resolve_src(s1_v, 9)
            if dst_r != 0xFFFFFFFF {
                emit_a64_mov(dst_r, src_reg)
            } else {
                if src_reg != 9 { emit_a64_mov(9, src_reg) }
                ir_a64_emit_store_spill(9, dest_v)
            }
        } else {
            // Param init: imm = param index
            // AAPCS64: x0-x7 for first 8 params
            if imm < 8 {
                uint64 pr = imm
                if dst_r != 0xFFFFFFFF {
                    emit_a64_mov(dst_r, pr)
                } else {
                    emit_a64_mov(9, pr)
                    ir_a64_emit_store_spill(9, dest_v)
                }
            } else if imm >= 100 {
                // ASM output: read from physical register (imm - 100)
                uint64 phys_src = imm - 100
                if dst_r != 0xFFFFFFFF {
                    emit_a64_mov(dst_r, phys_src)
                } else {
                    emit_a64_mov(9, phys_src)
                    ir_a64_emit_store_spill(9, dest_v)
                }
            } else {
                // Overflow param (8+): load from caller stack frame
                // After prologue: [SP + frame_size] = saved regs start
                // caller stack args at [SP + frame_size + (imm-8)*8]
                uint64 overflow_off = ir_frame_size + (imm - 8) * 8
                uint64 d = dst_r
                if d == 0xFFFFFFFF { d = 9 }
                ir_a64_ldr_sp(d, overflow_off)
                if dst_r == 0xFFFFFFFF {
                    ir_a64_emit_store_spill(9, dest_v)
                }
            }
        }
        return
    }

    // ----- IR_RET (42): move result to x0 then branch to epilogue -----
    if op == 42 {
        uint64 ret_dh = ir_a64_fpr_home(s1_v)
        if ret_dh != 0xFFFFFFFF {
            emit_a64_fmov_xd(0, ret_dh)
        } else {
            uint64 ret_r = ir_a64_resolve_src(s1_v, 9)
            if ret_r != 0 { emit_a64_mov(0, ret_r) }
        }
        // B to epilogue (patched later)
        uint64 rfp = ir_ret_fixups + ir_ret_fixup_count * 4
        uint32 rpo = out_len
        unsafe { *(rfp as uint32) = rpo }
        ir_ret_fixup_count = ir_ret_fixup_count + 1
        emit_a64(0x14000000)    // B #0 (placeholder)
        return
    }

    // ----- IR_RET_VOID (43): branch to epilogue -----
    if op == 43 {
        // Default the return register to 0 so `fn main() { ... }` (void
        // main) exits with status 0 instead of whatever was last in x0
        // when the auto-inserted exit syscall fires. Function-local void
        // returns are unaffected: caller doesn't read x0.
        emit_a64_mov_imm(0, 0)
        uint64 rfp = ir_ret_fixups + ir_ret_fixup_count * 4
        uint32 rpo = out_len
        unsafe { *(rfp as uint32) = rpo }
        ir_ret_fixup_count = ir_ret_fixup_count + 1
        emit_a64(0x14000000)    // B #0 (placeholder)
        return
    }

    // ----- IR_ARG (51): move value to argument register x0-x7 -----
    if op == 51 {
        // AAPCS64: x0-x7 for first 8 arguments
        if imm < 8 {
            uint64 target = imm
            uint64 arg_dh = ir_a64_fpr_home(s1_v)
            if arg_dh != 0xFFFFFFFF {
                emit_a64_fmov_xd(target, arg_dh)
            } else {
                uint64 src_reg = ir_a64_resolve_src(s1_v, 9)
                emit_a64_mov(target, src_reg)
            }
        } else if imm >= 100 {
            // Direct register target (ASM I/O constraints)
            uint64 phys_target = imm - 100
            uint64 src_reg = ir_a64_resolve_src(s1_v, 9)
            emit_a64_mov(phys_target, src_reg)
        } else {
            // Overflow arg (AAPCS64: the 9th+ parameter). The caller's
            // frame already reserves IR_A64_OVERFLOW_RESERVE bytes at
            // the bottom, so SP at the upcoming BL will sit exactly on
            // top of those slots — no SUB/ADD needed. Just STR the
            // arg value at [SP + (imm-8)*8].
            // 24 slots, not 16: the front end advertises `too many call
            // arguments (max 32)` and AAPCS64 puts the first 8 in x0-x7,
            // so 32 - 8 = 24 stack slots is the number that makes the
            // advertised limit true. The old 16 was a leftover from when
            // IR_A64_OVERFLOW_RESERVE was a fixed 128 bytes; it is now
            // sized from a64_ovf_slots, so the reserve grows to fit.
            // An arch-specific limit is not an option here: one .kr
            // compiles to all 8 fat-binary slices at once, so a 25-arg
            // call would build the x86 slices and then abort the build on
            // the arm64 one.
            uint64 oi = imm - 8
            if oi >= 24 {
                write(2, "error: a64 overflow args overflow (max 24)\n", 43)
                exit(1)
            }
            uint64 src_reg = ir_a64_resolve_src(s1_v, 9)
            ir_a64_str_sp(src_reg, oi * 8)
        }
        return
    }

    // ----- IR_CALL (50): bl with fixup -----
    if op == 50 {
        // Overflow args (>8 args) were already written to [SP + oi*8]
        // by IR_ARG — the caller's bottom-of-frame overflow reserve
        // lines them up with the callee's arg-9 slot.
        uint64 call_patch = out_len
        emit_a64(0x94000000)    // BL #0 (placeholder)
        // Record fixup: imm holds the callee token
        fixup_table_ensure()
        uint64 fentry = fixup_table + fixup_count * 8
        uint32 fo = call_patch
        unsafe { *(fentry as uint32) = fo }
        uint64 fe4 = fentry + 4
        uint32 ct = imm
        unsafe { *(fe4 as uint32) = ct }
        fixup_count = fixup_count + 1
        ir_overflow_arg_count = 0
        // Result in x0
        if dst_r != 0xFFFFFFFF && dst_r != 0 {
            emit_a64_mov(dst_r, 0)
        }
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(0, dest_v)
        }
        return
    }

    // ----- IR_SYSCALL (52) -----
    if op == 52 {
        if target_os == 2 {
            ir_emit_arm64_win_syscall(imm, dest_v, dst_r)
            return
        }
        // ARM64 Linux/Android: open(2) → openat(56) needs arg shift
        // IR_ARG sets x0=path, x1=flags, x2=mode
        // openat needs x0=AT_FDCWD(-100), x1=path, x2=flags, x3=mode
        if imm == 2 && target_os != 1 {
            emit_a64_mov(3, 2)          // x3 = mode (was x2)
            emit_a64_mov(2, 1)          // x2 = flags (was x1)
            emit_a64_mov(1, 0)          // x1 = path (was x0)
            emit_a64_mov_imm(0, 0xFFFFFFFFFFFFFF9C)  // x0 = AT_FDCWD (-100)
        }
        // Map abstract syscall number to ARM64 number
        uint64 real_nr = ir_a64_syscall_nr(imm)
        emit_a64_syscall_nr(real_nr)
        // See ir.kr's IR_SYSCALL case: imm is the syscall number, not the
        // builtin, so the reaching builtin is read from the parallel table.
        uint64 sc_who_a = ir_insn_origin_at(ii)
        if sc_who_a == 0 { sc_who_a = "an unnamed syscall lowering" }
        emit_a64_svc(sc_who_a)
        // Result in x0
        if dst_r != 0xFFFFFFFF && dst_r != 0 {
            emit_a64_mov(dst_r, 0)
        }
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(0, dest_v)
        }
        return
    }

    // ----- IR_ALLOC (70): inline mmap / VirtualAlloc -----
    if op == 70 {
        // src1 = size vreg (if != 0), or imm = constant size
        uint64 size_reg = 0
        if s1_v != 0 {
            size_reg = ir_a64_resolve_src(s1_v, 9)
        } else {
            emit_a64_mov_imm(9, imm)
            size_reg = 9
        }
        // Save original size in x11 (scratch)
        emit_a64_mov(11, size_reg)
        if target_os == 2 {
            // Windows ARM64: VirtualAlloc(NULL, size+8, MEM_COMMIT|MEM_RESERVE, PAGE_READWRITE)
            emit_a64_mov_imm(0, 0)
            emit_a64_add_imm(1, size_reg, 8)
            emit_a64_mov_imm(2, 0x3000)
            emit_a64_mov_imm(3, 4)
            emit_a64_win_call_iat(6)
            // x0 = raw ptr. Store header: [x0] = original size (x11)
            emit_a64_str(11, 0, 0)
            // x0 = x0 + 8 (return ptr past header)
            emit_a64_add_imm(0, 0, 8)
        } else {
            // AAPCS64 mmap: x0=addr, x1=len, x2=prot, x3=flags, x4=fd, x5=offset
            // x0 = 0 (addr)
            emit_a64_mov_imm(0, 0)
            // x1 = size + 8
            emit_a64_add_imm(1, size_reg, 8)
            // x2 = PROT_READ|PROT_WRITE = 3
            emit_a64_mov_imm(2, 3)
            // x3 = MAP_PRIVATE|MAP_ANON — 0x22 on Linux, 0x1002 on macOS. The
            // old hardcoded 0x22 made every mmap on macOS ARM64 return an
            // invalid pointer, which is what SIGSEGV'd the alloc/fileio tests
            // and every self-compile on native arm64 macOS CI.
            uint64 a64_mmap_flags = 0x22
            if target_os == 1 { a64_mmap_flags = 0x1002 }
            emit_a64_mov_imm(3, a64_mmap_flags)
            // x4 = -1 (fd)
            emit_a64_mov_imm(4, 0xFFFFFFFFFFFFFFFF)
            // x5 = 0 (offset)
            emit_a64_mov_imm(5, 0)
            // syscall (mmap)
            uint64 mmap_nr = ir_a64_syscall_nr(9)
            emit_a64_syscall_nr(mmap_nr)
            emit_a64_svc("alloc")
            // x0 = raw ptr. Store header: [x0] = original size (x11)
            emit_a64_str(11, 0, 0)
            // x0 = x0 + 8 (return ptr past header)
            emit_a64_add_imm(0, 0, 8)
        }
        if dst_r != 0xFFFFFFFF && dst_r != 0 {
            emit_a64_mov(dst_r, 0)
        }
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(0, dest_v)
        }
        return
    }

    // ----- IR_DEALLOC (71): inline munmap / VirtualFree -----
    if op == 71 {
        uint64 ptr_reg = ir_a64_resolve_src(s1_v, 9)
        if target_os == 2 {
            // Windows ARM64: VirtualFree(ptr-8, 0, MEM_RELEASE=0x8000)
            emit_a64_mov_imm(10, 8)
            emit_a64_sub(0, ptr_reg, 10)
            emit_a64_mov_imm(1, 0)
            emit_a64_mov_imm(2, 0x8000)
            emit_a64_win_call_iat(13)
        } else {
            // x0 = ptr - 8 (real base)
            emit_a64_mov_imm(10, 8)
            emit_a64_sub(0, ptr_reg, 10)
            // x1 = *(x0) + 8 (total length)
            emit_a64_ldr(1, 0, 0)
            emit_a64_add_imm(1, 1, 8)
            // munmap syscall
            uint64 munmap_nr = ir_a64_syscall_nr(11)
            emit_a64_syscall_nr(munmap_nr)
            emit_a64_svc("dealloc")
        }
        return
    }

    // ----- IR_MEMCPY (72): byte copy loop -----
    if op == 72 {
        uint64 mc_dst = ir_a64_resolve_src(s1_v, 9)
        uint64 mc_src = ir_a64_resolve_src(s2_v, 10)
        // Resolve len from imm (stored as vreg index)
        uint64 mc_len_vreg = imm
        uint64 mc_len = 0
        if mc_len_vreg > 0 && mc_len_vreg < ir_vreg_next {
            mc_len = ir_a64_resolve_src(mc_len_vreg, 11)
        }
        // x0 = dst, x1 = src, x2 = len
        emit_a64_mov(0, mc_dst)
        emit_a64_mov(1, mc_src)
        emit_a64_mov(2, mc_len)
        // Save dst for return value
        emit_a64_mov(11, mc_dst)
        // Loop: CBZ x2, done; LDRB w3, [x1], #1; STRB w3, [x0], #1; SUB x2, x2, #1; B loop
        uint64 mc_loop = out_len
        // CBZ x2, done (skip 4 instructions = 16 bytes)
        emit_a64_cbz(2, 20)
        // LDRB w3, [x1], #1 (post-index byte load)
        emit_a64(0x38401423)
        // STRB w3, [x0], #1 (post-index byte store)
        emit_a64(0x38001403)
        // SUB x2, x2, #1
        emit_a64(0xD1000442)
        // B loop
        uint64 mc_back = mc_loop - out_len
        emit_a64(0x14000000 | a64_check_b26(mc_back))
        // Return original dst
        if dst_r != 0xFFFFFFFF {
            emit_a64_mov(dst_r, 11)
        } else {
            emit_a64_mov(9, 11)
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_STRLEN (73): byte scan loop -----
    if op == 73 {
        uint64 sl_str = ir_a64_resolve_src(s1_v, 9)
        // x0 = str (current ptr), x1 = str (start)
        emit_a64_mov(0, sl_str)
        emit_a64_mov(1, sl_str)
        // Loop: LDRB w2, [x0]; CBZ w2, done; ADD x0, x0, #1; B loop
        uint64 sl_loop = out_len
        emit_a64_ldrb(2, 0, 0)
        // CBZ w2, done (skip 2 insns = 8 bytes) -- use 32-bit CBZ for byte register
        emit_a64(0x34000062)    // CBZ w2, +3 insns (12 bytes)
        emit_a64_add_imm(0, 0, 1)
        uint64 sl_back = sl_loop - out_len
        emit_a64(0x14000000 | a64_check_b26(sl_back))
        // done: length = x0 - x1
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64_sub(d, 0, 1)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_FMT_UINT (74): format uint to buffer -----
    if op == 74 {
        uint64 fu_buf = ir_a64_resolve_src(s1_v, 9)
        uint64 fu_val = ir_a64_resolve_src(s2_v, 10)
        // x0 = buf, x1 = val, x2 = digit count, x3 = divisor (10)
        emit_a64_mov(0, fu_buf)
        emit_a64_mov(1, fu_val)
        emit_a64_mov_imm(2, 0)
        emit_a64_mov_imm(3, 10)
        // Use the permanent 32-byte scratchpad in the frame (no SP shift)
        // x12 = SP + ir_a64_scratch_off (digit area base)
        emit_a64_mov_imm(12, ir_a64_scratch_off)
        ir_a64_add_sp_reg(12, 12)

        // Digit extraction loop: divide by 10, store remainder + '0'
        uint64 fu_loop = out_len
        emit_a64_udiv(4, 1, 3)       // x4 = val / 10
        emit_a64_msub(5, 4, 3, 1)    // x5 = val - (val/10)*10 = remainder
        emit_a64_add_imm(5, 5, 48)   // x5 += '0'
        // Store digit byte at [x12 + x2]
        // STRB w5, [x12, x2]
        emit_a64(0x38226985)
        // x2++
        emit_a64_add_imm(2, 2, 1)
        // val = quotient
        emit_a64_mov(1, 4)
        // CBNZ x1, loop
        uint64 fu_back = fu_loop - out_len
        emit_a64(0xB5000000 | (a64_check_b19(fu_back) << 5) | 1)

        // Copy digits in reverse order to output buffer
        // x6 = digit count (save)
        emit_a64_mov(6, 2)
        // Copy loop: x2 = remaining, x0 = output ptr
        uint64 fu_copy = out_len
        // CBZ x2, done
        emit_a64_cbz(2, 20)
        // x2--
        emit_a64(0xD1000442)    // SUB x2, x2, #1
        // LDRB w5, [x12, x2]
        emit_a64(0x38626985)
        // STRB w5, [x0], #1
        emit_a64(0x38001405)
        // B copy_loop
        uint64 fu_copy_back = fu_copy - out_len
        emit_a64(0x14000000 | a64_check_b26(fu_copy_back))

        // Restore stack (removed, using static scratchpad)
        // emit_a64_add_sp_imm(32)

        // Return digit count (x6)
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64_mov(d, 6)
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_STR_EQ (75): byte-by-byte string compare -----
    if op == 75 {
        uint64 se_a = ir_a64_resolve_src(s1_v, 9)
        uint64 se_b = ir_a64_resolve_src(s2_v, 10)
        emit_a64_mov(0, se_a)
        emit_a64_mov(1, se_b)
        // Loop: LDRB w2, [x0]; LDRB w3, [x1]; CMP w2, w3; B.NE not_equal;
        //       CBZ w2, equal; ADD x0,x0,1; ADD x1,x1,1; B loop
        uint64 se_loop = out_len
        emit_a64_ldrb(2, 0, 0)
        emit_a64_ldrb(3, 1, 0)
        // CMP w2, w3 (32-bit) — SUBS WZR, w2, w3 so flags are set but w2
        // is preserved. The old encoding used Rd=w2, which destroyed w2
        // whenever the bytes matched (SUBS w2,w2,w3 = 0), making the
        // subsequent CBZ w2 *always* treat equal-byte positions as
        // end-of-string and return 1 (equal) immediately. Classic case:
        // str_eq("ab","a") returned 1 because the first match byte 'a'
        // got subtracted into 0 and CBZ fired on the synthesized zero.
        emit_a64(0x6B03005F)
        // B.NE not_equal (+5 insns). imm19 field sits at [23:5], so the
        // instruction-count goes in bits 9:5 for small offsets — 5 << 5 = 0xA0.
        // The old constants here (0x54000141, 0x34000102) had imm19 shifted by
        // 6 instead of 5, doubling every branch offset and falling off the end
        // of the comparator — that made str_eq return the first byte instead
        // of a 0/1 result.
        emit_a64(0x540000A1)    // B.NE +5
        // CBZ w2, equal (+6 insns) — need 6 to hop over the back-edge
        // branch AND the not_equal path's MOVZ+B pair.
        emit_a64(0x340000C2)    // CBZ w2, +6
        emit_a64_add_imm(0, 0, 1)
        emit_a64_add_imm(1, 1, 1)
        uint64 se_back = se_loop - out_len
        emit_a64(0x14000000 | a64_check_b26(se_back))
        // not_equal: result = 0
        uint64 d = dst_r
        if d == 0xFFFFFFFF { d = 9 }
        emit_a64_mov_imm(d, 0)
        // B done (+2 insns = 8 bytes)
        emit_a64(0x14000002)
        // equal: result = 1
        emit_a64_mov_imm(d, 1)
        // done:
        if dst_r == 0xFFFFFFFF {
            ir_a64_emit_store_spill(9, dest_v)
        }
        return
    }

    // ----- IR_MEMSET (76): byte fill loop -----
