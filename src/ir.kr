// KernRift self-hosted compiler — IR infrastructure
//
// Arena-based intermediate representation for optimisation passes. NOT SSA:
// IR_PHI has a declaration (below) and a printer but zero
// ir_emit(IR_PHI...) construction sites. This is linear three-address code
// over unbounded vregs -- named variables get one vreg reused across
// assignments, so no phi is ever needed and none is ever built.
//
// Instruction format (32 bytes per instruction):
//   [0..4)   opcode     (uint32)
//   [4..8)   dest_vreg  (uint32)
//   [8..12)  src1       (uint32)
//   [12..16) src2       (uint32)
//   [16..24) imm64      (uint64)
//   [24..28) bb_idx     (uint32) — owning basic block
//   [28..32) next       (uint32) — next instruction in block list (0xFFFFFFFF = end)
//
// Basic block format (16 bytes per block):
//   [0..4)   first_insn (uint32) — first instruction index (0xFFFFFFFF = empty)
//   [4..8)   last_insn  (uint32) — last instruction index  (0xFFFFFFFF = empty)
//   [8..12)  succ0      (uint32) — first successor block   (0xFFFFFFFF = none)
//   [12..16) succ1      (uint32) — second successor block  (0xFFFFFFFF = none)

// ---------------------------------------------------------------------------
// Opcode constants
// ---------------------------------------------------------------------------

static uint64 ir_opt_rewrites = 0

static uint64 IR_CONST = 1
static uint64 IR_ADD = 2
static uint64 IR_SUB = 3
static uint64 IR_MUL = 4
static uint64 IR_DIV = 5
static uint64 IR_MOD = 6
static uint64 IR_AND = 7
static uint64 IR_OR = 8
static uint64 IR_XOR = 9
static uint64 IR_SHL = 10
static uint64 IR_SHR = 11
static uint64 IR_NEG = 12
static uint64 IR_NOT = 13

static uint64 IR_CMP_EQ = 14
static uint64 IR_CMP_NE = 15
static uint64 IR_CMP_LT = 16
static uint64 IR_CMP_LE = 17
static uint64 IR_CMP_GT = 18
static uint64 IR_CMP_GE = 19

static uint64 IR_FADD = 20
static uint64 IR_FSUB = 21
static uint64 IR_FMUL = 22
static uint64 IR_FDIV = 23
static uint64 IR_FCMP_EQ = 24
static uint64 IR_FCMP_LT = 25
static uint64 IR_ITOF = 26
static uint64 IR_FTOI = 27

static uint64 IR_LOAD = 30
static uint64 IR_STORE = 31
static uint64 IR_STACK_ADDR = 32

static uint64 IR_BR = 40
static uint64 IR_BR_COND = 41
static uint64 IR_RET = 42
static uint64 IR_RET_VOID = 43

static uint64 IR_CALL = 50
static uint64 IR_ARG = 51
static uint64 IR_SYSCALL = 52

static uint64 IR_PHI = 60
static uint64 IR_COPY = 61

static uint64 IR_ALLOC = 70
static uint64 IR_DEALLOC = 71

static uint64 IR_MEMCPY = 72
static uint64 IR_STRLEN = 73
static uint64 IR_FMT_UINT = 74
static uint64 IR_STR_EQ = 75
static uint64 IR_MEMSET = 76
static uint64 IR_STATIC_LOAD = 77     // dest = load from static data offset (imm64)
static uint64 IR_STATIC_STORE = 78    // store src1 to static data offset (imm64)
static uint64 IR_STR_CONST = 79       // dest = lea string data (imm = str_offset)
static uint64 IR_EXTRACT_RDX = 80    // dest = rdx after a call (2-tuple second value)
static uint64 IR_EXTRACT_R8 = 81     // dest = r8 after a call (3-tuple third value)
static uint64 IR_RET2 = 82           // return (src1, src2) — first in rax, second in rdx
static uint64 IR_RET3 = 83           // return (src1, src2, imm-vreg) — rax, rdx, r8
static uint64 IR_STATIC_ADDR = 84    // dest = lea static data address (imm = offset)
static uint64 IR_SYSCALL_RAW = 85    // dest = raw syscall; src1 = nr vreg; args already in regs via IR_ARG
static uint64 IR_FN_ADDR = 86        // dest = lea function address; imm = string token of fn name
static uint64 IR_CALL_IND = 87       // dest = indirect call result; src1 = fn pointer vreg
static uint64 IR_MEMCMP = 88         // dest = (memcmp(src1, src2, imm) == 0) ? 1 : 0

static uint64 IR_ATOMIC_STORE = 90   // atomic_store(ptr, val): lock xchg [ptr], val
static uint64 IR_ATOMIC_LOAD = 91    // atomic_load(ptr): mov + mfence
static uint64 IR_ATOMIC_ADD = 92     // atomic_add(ptr, val): lock xadd [ptr], val → old value
static uint64 IR_ATOMIC_CAS = 93     // atomic_cas(ptr, expected, desired): lock cmpxchg
static uint64 IR_VSTORE = 94         // volatile store: mfence + store
static uint64 IR_VLOAD = 95          // volatile load: load + mfence
static uint64 IR_ASM_BLOCK = 96      // inline asm block passthrough

// Float builtins / conversions
static uint64 IR_FSQRT = 97         // dest = sqrt(src1) f64
static uint64 IR_FFMA = 98          // dest = src1*src2+imm_vreg f64 (a*b+c)
static uint64 IR_FCMP_NE = 99       // dest = (src1 != src2) f64
static uint64 IR_FCMP_LE = 100      // dest = (src1 <= src2) f64
static uint64 IR_FCMP_GT = 101      // dest = (src1 > src2) f64
static uint64 IR_FCMP_GE = 102      // dest = (src1 >= src2) f64
static uint64 IR_F32TOF64 = 103     // dest = cvtss2sd src1
static uint64 IR_F64TOF32 = 104     // dest = cvtsd2ss src1
static uint64 IR_F32TOF16 = 105     // dest = f32-to-f16 bit conversion
static uint64 IR_F16TOF32 = 106     // dest = f16-to-f32 bit conversion
static uint64 IR_ITOF32 = 107       // dest = cvtsi2ss src1 (int to f32 bits)
static uint64 IR_FTOI32 = 108       // dest = cvttss2si src1 (f32 bits to int)

// Atomic RMW (CAS-loop based)
static uint64 IR_ATOMIC_SUB = 109    // atomic_sub(ptr, val): negate + lock xadd
static uint64 IR_ATOMIC_AND = 110    // atomic_and(ptr, val): CAS-loop with AND
static uint64 IR_ATOMIC_OR = 111     // atomic_or(ptr, val): CAS-loop with OR
static uint64 IR_ATOMIC_XOR = 112    // atomic_xor(ptr, val): CAS-loop with XOR

// Process / OS builtins
static uint64 IR_EXEC = 113         // exec_process(path): execve with auto-argv
static uint64 IR_EXEC_ARGV = 114    // exec_process_argv(path, argv): execve
static uint64 IR_SET_EXEC = 115     // set_executable(path): chmod +x
static uint64 IR_FSQRT32 = 118      // dest = sqrtss(src1) f32
static uint64 IR_TIME_NS = 119      // dest = monotonic nanosecond counter

// Signed comparisons (dedicated opcodes, no collision with CMP_xx+100 hack)
static uint64 IR_SCMP_LT = 120      // dest = (src1 < src2) signed
static uint64 IR_SCMP_LE = 121      // dest = (src1 <= src2) signed
static uint64 IR_SCMP_GT = 122      // dest = (src1 > src2) signed
static uint64 IR_SCMP_GE = 123      // dest = (src1 >= src2) signed

// Typed print formatters: dest=len_vreg, src1=buf_vreg, src2=val_vreg
static uint64 IR_FMT_BOOL = 124     // format bool as "true"/"false" into buf
static uint64 IR_FMT_F64 = 125      // format f64 as decimal into buf
static uint64 IR_ISB = 126          // instruction-sync barrier (ARM64 ISB; x86 no-op)
static uint64 IR_DCACHE_FLUSH = 127 // D-cache clean+invalidate by VA (ARM64 DC CIVAC; x86 CLFLUSH)
static uint64 IR_ICACHE_INV = 128   // I-cache invalidate by VA (ARM64 IC IVAU; x86 no-op)
static uint64 IR_DSB = 129          // data-sync barrier (ARM64 DSB SY; x86 MFENCE)
static uint64 IR_DMB = 130          // data-memory barrier (ARM64 DMB ISH; x86 MFENCE)
static uint64 IR_ARR_CHECK = 131    // bounds check: trap if s1_v (idx) >= imm (count)
static uint64 IR_SDIV = 132         // dest = src1 / src2 (signed): cqo + idiv on x86, sdiv on a64
static uint64 IR_SMOD = 133         // dest = src1 % src2 (signed): cqo + idiv (rdx) on x86, sdiv+msub on a64
static uint64 IR_SAR = 134          // dest = src1 >> src2 (arithmetic): SAR (modrm /7) on x86, ASR on a64
// LEA-fused arithmetic: src1 vreg + signed-32 immediate. src2 is unused; imm
// holds the displacement. Emitted as `lea dst, [src1 ± imm]` (3-7 bytes) on
// x86 — replaces `mov const; mov src1; add/sub` (8-13 bytes) for the very
// common pattern of `n - 1`, `i + 4`, etc. Const-fold rewrites IR_ADD/SUB to
// these when src2 is a known constant fitting in signed 32-bit.
static uint64 IR_ADD_IMM = 135      // dest = src1 + imm (signed i32)
static uint64 IR_SUB_IMM = 136      // dest = src1 - imm (signed i32)

// 32-bit right-rotation: dest = ROR_w(src1, src2). imm = rotation width
// (32 or 64). Synthesized by ir_opt_recognize_rotate from the canonical
// `OR(AND(SHR(x,n), MASK), AND(SHL(x, W-n), MASK))` shape that 32-bit
// rotation idioms produce on a 64-bit IR. Codegen emits a single x86
// `ROR r32, cl` (or imm8) when imm == 32.
static uint64 IR_ROR = 137          // dest = ((src1 >> src2) | (src1 << (W - src2))) & ((1<<W)-1)
// IMUL r64, r/m64, imm — three-operand form. Eliminates the load-and-
// spill round-trip for the constant when src2 came from IR_CONST. Saves
// 4-9 bytes per IR_MUL site that scales by a small constant
// (matmul / sort / address-scaling are full of these). Only fires for
// imm fitting in signed 32-bit; src2 is left unused.
static uint64 IR_MUL_IMM = 138      // dest = src1 * imm (signed i32)
// Base + index*scale LEA fusion. Encodes `dst = src1 + src2 * imm`
// where imm ∈ {1, 2, 4, 8} — exactly x86's SIB scale set. Replaces the
// `imul idx, idx, scale; mov tmp, base; add tmp, idx` 7-10 byte
// sequence with a single 4-byte `lea dst, [base + idx*scale]`. Used by
// matmul / sort hot loops that pun on byte-offset address math.
static uint64 IR_LEA_BIS = 139      // dest = src1 + src2 * imm  (imm ∈ {1,2,4,8})

// RISC-V immediate-fused logical/shift ops (riscv32 only, target_arch==2).
// Same shape as IR_ADD_IMM/IR_SUB_IMM: src2 is unused (0), imm holds the
// constant. Const-fold rewrites the reg-reg form when src2 is a known
// constant that fits the RV32 I-type: sign-extended imm12 (−2048..2047)
// for and/or/xor, 5-bit shamt (0..31) for the shifts. The riscv backend
// emits a single andi/ori/xori/slli/srli/srai instead of li+R-type.
// x86/arm64 never see these opcodes (fusion is arch-gated).
static uint64 IR_AND_IMM = 140      // dest = src1 & imm (imm12)
static uint64 IR_OR_IMM = 141       // dest = src1 | imm (imm12)
static uint64 IR_XOR_IMM = 142      // dest = src1 ^ imm (imm12)
static uint64 IR_SHL_IMM = 143      // dest = src1 << imm (shamt 0..31 on rv32/xtensa, 0..63 on x86/arm64)
static uint64 IR_SHR_IMM = 144      // dest = src1 >> imm logical (shamt 0..31)
static uint64 IR_SAR_IMM = 145      // dest = src1 >> imm arithmetic (shamt 0..31)
// dest = GetModuleFileNameA(NULL, src1=buf, src2=size). Windows-only: the
// lowering only emits this when target_os == 2, so the freestanding backends
// (RISC-V, Xtensa) never have to know about it.
static uint64 IR_MODULE_PATH = 146

// arm64 register-offset addressing (target_arch == 1 only; produced by
// ir_opt_fuse_lea_mem, which folds an IR_LEA_BIS's scaled address straight
// into its consuming loads/stores). On Cortex-A72 the shifted-register ADD
// that IR_LEA_BIS lowers to costs 2 cycles and sits in the address
// dependency chain; `ldr Xt, [Xn, Xm, LSL #k]` removes that ADD entirely.
// Width is restricted to 4/8 with shift == log2(width) — the two forms the
// arm64 backend emits (encodings verified against GNU as on Cortex-A72).
// No other backend ever sees these opcodes; their nyi guards would fail
// loudly if one did.
//   IR_LOAD_BIS:  dest = *(src1 + src2 << log2(imm)); imm = width (4 or 8)
//   IR_STORE_BIS: *(src1 + imm << log2(dest)) = src2; imm = INDEX VREG,
//                 dest = width (4 or 8) — same dest-is-width shape as
//                 IR_STORE(31), so it joins 31 in every no-def list, and
//                 imm joins the imm-as-vreg lists (like IR_FFMA's third
//                 operand) for liveness/use-count/DCE/interference.
static uint64 IR_LOAD_BIS = 147
static uint64 IR_STORE_BIS = 148

// ---------------------------------------------------------------------------
// Instruction arena
// ---------------------------------------------------------------------------

static uint64 ir_insn_buf = 0       // pointer to instruction arena
static uint64 ir_insn_count = 0     // number of instructions allocated
static uint64 ir_insn_cap = 0       // max instructions

// Parallel table of source tokens per instruction, used by the -g DWARF
// emitter so each insn's emission can record a source-line mapping.
// Zero means "no source info" — the emitter skips line recording.
static uint64 ir_insn_src_tok = 0
// Current source token, set by ir_lower_stmt so every ir_emit call
// during a given statement's lowering inherits the same line.
static uint64 ir_current_src_tok = 0

// Parallel table of "reaching builtin" name pointers per instruction, in the
// same shape as ir_insn_src_tok above (index-keyed, insn layout untouched).
//
// IR_SYSCALL carries the canonical Linux syscall NUMBER in imm, and that
// number is not a builtin: nr 1 is emitted by write(), print(), println(),
// print_str(), println_str() and file_write(); nr 0 by read() and
// file_read(); nr 8 twice by file_size(). So the emitter cannot recover which
// builtin it is serving from imm alone, and a --target=none refusal would
// have to say "syscall" six different ways. The lowering records the name
// here instead (via ir_emit_syscall), and the trap emitters on all three IR
// backends read it back, so the refusal names the construct the programmer
// actually wrote. That is what makes the guard's output a worklist.
//
// Zero means "no name recorded" and every reader falls back to a generic
// label -- never a guessed one: a wrong attribution is worse than a vague one.
static uint64 ir_insn_origin = 0

@export
fn ir_set_current_src_tok(uint64 tok) { ir_current_src_tok = tok }


// ---------------------------------------------------------------------------
// Basic block arena
// ---------------------------------------------------------------------------

static uint64 ir_bb_buf = 0         // pointer to basic block arena
static uint64 ir_bb_count = 0       // number of blocks allocated
static uint64 ir_bb_cap = 0         // max blocks

// ---------------------------------------------------------------------------
// Virtual register allocator
// ---------------------------------------------------------------------------

static uint64 ir_vreg_next = 0      // next vreg number to allocate

// Float-kind per vreg: 0=int, 1=f64, 2=f32
static uint64 ir_vreg_fkind_buf = 0  // array of uint8, indexed by vreg
static uint64 ir_vreg_fkind_cap = 0

// Signed-int flag per vreg: 1 = declared as int8/16/32/64 (signed),
// 0 = unsigned/unknown. Compare lowering reads this to choose
// IR_SCMP_* instead of unsigned IR_CMP_* — without it, `int64 x < 0`
// always reads as huge-positive on x86 setb / aarch64 LO.
static uint64 ir_vreg_signed_buf = 0
static uint64 ir_vreg_signed_cap = 0

// Per-vreg use count (saturates at 255). Populated in ir_compute_use_count.
// Used by the CMP+JCC fusion peephole to prove a cmp result is single-use
// (so its materialization can be elided in favour of a direct jcc).
static uint64 ir_use_count_buf = 0
static uint64 ir_use_count_cap = 0

// Fused-cmp handoff: when a CMP in the current BB is the last non-terminator
// and is single-use by the terminator BR_COND, the emitter elides setcc/movzx/
// mov and stores the matching short-jcc opcode (0x84..0x8F) here. The block
// terminator then emits `0F <jcc> disp32` directly instead of test+jne.
// 0 = not fused. Reset at the start of each BB.
static uint64 ir_fused_jcc_code = 0

// ---------------------------------------------------------------------------
// Initialisation and reset
// ---------------------------------------------------------------------------

// Allocate arenas for instructions and basic blocks.
@export
fn ir_init() {
    if ir_insn_buf == 0 {
        ir_insn_cap = 65536
        ir_insn_buf = alloc(ir_insn_cap * 32)
        // 4 bytes per insn — enough for a u32 token index. Shares the
        // same cap as the main insn buf so indexing matches.
        ir_insn_src_tok = alloc(ir_insn_cap * 4)
        // 8 bytes per insn — a pointer to a static name literal. Same cap,
        // same indexing. ir_emit zeroes each slot as it is claimed, so a
        // stale name from a previously-compiled function can never be read
        // back (ir_init resets ir_insn_count but does not clear the arena).
        ir_insn_origin = alloc(ir_insn_cap * 8)
    }
    ir_insn_count = 0
    ir_current_src_tok = 0

    if ir_bb_buf == 0 {
        ir_bb_cap = 4096
        ir_bb_buf = alloc(ir_bb_cap * 16)
    }
    ir_bb_count = 0

    ir_vreg_next = 1

    if ir_vreg_fkind_buf == 0 {
        ir_vreg_fkind_cap = 65536
        ir_vreg_fkind_buf = alloc(ir_vreg_fkind_cap)
    }
    // Float-kind buffer is indexed by vreg number without a length guard,
    // so stale bytes from a prior function would mislabel a vreg as float.
    memset(ir_vreg_fkind_buf, 0, ir_vreg_fkind_cap)

    if ir_vreg_signed_buf == 0 {
        ir_vreg_signed_cap = 65536
        ir_vreg_signed_buf = alloc(ir_vreg_signed_cap)
    }
    memset(ir_vreg_signed_buf, 0, ir_vreg_signed_cap)

    if ir_use_count_buf == 0 {
        ir_use_count_cap = 65536
        ir_use_count_buf = alloc(ir_use_count_cap)
    }
    memset(ir_use_count_buf, 0, ir_use_count_cap)
    ir_fused_jcc_code = 0

    if ir_loop_exit_stack == 0 {
        ir_loop_exit_stack = alloc(32 * 8)
        ir_loop_header_stack = alloc(32 * 8)
        ir_loop_hdr_buf_stack = alloc(32 * 8)
        ir_loop_hdr_count_stack = alloc(32 * 8)
    }
    ir_loop_depth = 0

    if ir_loops == 0 {
        ir_loop_cap = 256
        ir_loops = alloc(ir_loop_cap * 16)
    }
    ir_loop_count = 0

    if ir_overflow_args == 0 {
        ir_overflow_args = alloc(32 * 8)
    }
    ir_overflow_arg_count = 0
}

// Reset all counters to zero so the arenas can be reused.
@export
fn ir_reset() {
    ir_insn_count = 0
    ir_bb_count = 0
    ir_vreg_next = 1
    ir_loop_depth = 0
    ir_loop_count = 0
    if ir_vreg_fkind_buf != 0 {
        memset(ir_vreg_fkind_buf, 0, ir_vreg_fkind_cap)
    }
    if ir_vreg_signed_buf != 0 {
        memset(ir_vreg_signed_buf, 0, ir_vreg_signed_cap)
    }
    if ir_use_count_buf != 0 {
        memset(ir_use_count_buf, 0, ir_use_count_cap)
    }
    ir_fused_jcc_code = 0
}

// ---------------------------------------------------------------------------
// Virtual register allocation
// ---------------------------------------------------------------------------

// Allocate the next virtual register number.
@export
fn ir_new_vreg() -> uint64 {
    uint64 v = ir_vreg_next
    ir_vreg_next = ir_vreg_next + 1
    return v
}

static uint64 FKIND_INT = 0
static uint64 FKIND_F64 = 1
static uint64 FKIND_F32 = 2
static uint64 FKIND_BOOL = 3
static uint64 FKIND_CHAR = 4

fn ir_vreg_fkind_set(uint64 vreg, uint64 fk) {
    if vreg < ir_vreg_fkind_cap {
        uint64 p = ir_vreg_fkind_buf + vreg
        uint8 b = fk
        unsafe { *(p as uint8) = b }
    }
}

fn ir_vreg_fkind_get(uint64 vreg) -> uint64 {
    if vreg < ir_vreg_fkind_cap {
        uint64 p = ir_vreg_fkind_buf + vreg
        uint64 b = 0
        unsafe { *(p as uint8) -> b }
        return b
    }
    return 0
}

// Only FKIND_F64 and FKIND_F32 name a FLOAT register class. FKIND_BOOL and
// FKIND_CHAR are ordinary integers carrying a formatting hint for print and
// f-strings, and testing `fk != 0` for "is this a float" sent both of them
// down the FADD / FMUL / FCMP path:
//
//     bool b = true   b * 2   -> 0                    (want 2)
//     char c = 'A'    c / 5   -> 4623507967449235456  (want 13)
//
// that last number being the f64 bit pattern of 13.0. Addition and
// subtraction hid this for years: two small integers read as f64 DENORMALS
// add and subtract BIT-EXACTLY, so `c + 1` was right and only *, / and unary
// minus showed damage. Both legacy backends were always correct here.
fn ir_fkind_is_float(uint64 fk) -> uint64 {
    if fk == FKIND_F64 { return 1 }
    if fk == FKIND_F32 { return 1 }
    return 0
}

// `as TYPE` clauses (parser.kr's data3 packing) and the static table both
// spell float kinds 1 = f64, 2 = f32, 3 = f16. That is a DIFFERENT namespace
// from the vreg one above, where 3 is bool — and feeding a declared kind
// straight in made `*(p as f16) -> g` and `static f16 s` come back as
// FKIND_BOOL, so both IR backends printed "true" where the value was 21520.
//
// f16 maps to FKIND_INT on purpose, not by omission: this language has no f16
// register class. An f16 IS a u64 bit pattern produced by f32_to_f16(), and
// keeping it on the integer path is exactly what both legacy backends already
// do (see the kind-41 note in codegen.kr).
fn ir_fkind_from_decl(uint64 declared) -> uint64 {
    if declared == 1 { return FKIND_F64 }
    if declared == 2 { return FKIND_F32 }
    return FKIND_INT
}

fn ir_vreg_signed_set(uint64 vreg, uint64 s) {
    if vreg < ir_vreg_signed_cap {
        uint64 p = ir_vreg_signed_buf + vreg
        uint8 b = s
        unsafe { *(p as uint8) = b }
    }
}

fn ir_vreg_signed_get(uint64 vreg) -> uint64 {
    if vreg < ir_vreg_signed_cap {
        uint64 p = ir_vreg_signed_buf + vreg
        uint64 b = 0
        unsafe { *(p as uint8) -> b }
        return b
    }
    return 0
}

// ---------------------------------------------------------------------------
// Token finder: scan the token table for an identifier matching a literal name.
// Returns token index or 0 if not found (0 is the first token, but function
// names never appear as the first token since it's a keyword).
// ---------------------------------------------------------------------------
fn ir_find_fn_tok(uint64 name, uint64 nlen) -> uint64 {
    uint64 i = 0
    while i < p_tok_count {
        if tok_matches(i, name, nlen) != 0 { return i }
        i = i + 1
    }
    return 0
}

// ---------------------------------------------------------------------------
// Instruction helpers (internal)
// ---------------------------------------------------------------------------

// Return the base pointer for instruction at index `idx` (0-based).
fn ir_insn_base(uint64 idx) -> uint64 {
    return ir_insn_buf + idx * 32
}

// ---------------------------------------------------------------------------
// Instruction field accessors
// ---------------------------------------------------------------------------

// Read the opcode (offset 0, uint32) of instruction `idx`.
@export
@export
fn ir_insn_src_tok_at(uint64 idx) -> uint64 {
    if ir_insn_src_tok == 0 { return 0 }
    uint64 slot = ir_insn_src_tok + idx * 4
    uint32 v = 0
    unsafe { *(slot as uint32) -> v }
    return v
}

// The builtin name recorded for instruction `idx`, or 0 if none was recorded.
// Read by the --target=none trap emitters on all three IR backends.
@export
fn ir_insn_origin_at(uint64 idx) -> uint64 {
    if ir_insn_origin == 0 { return 0 }
    uint64 slot = ir_insn_origin + idx * 8
    uint64 v = 0
    unsafe { *(slot as uint64) -> v }
    return v
}

fn ir_insn_opcode(uint64 idx) -> uint64 {
    uint64 p = ir_insn_base(idx)
    uint32 val = 0
    unsafe { *(p as uint32) -> val }
    return val
}

// Read the destination vreg (offset 4, uint32) of instruction `idx`.
@export
fn ir_insn_dest(uint64 idx) -> uint64 {
    uint64 p = ir_insn_base(idx) + 4
    uint32 val = 0
    unsafe { *(p as uint32) -> val }
    return val
}

// Read src1 (offset 8, uint32) of instruction `idx`.
@export
fn ir_insn_src1(uint64 idx) -> uint64 {
    uint64 p = ir_insn_base(idx) + 8
    uint32 val = 0
    unsafe { *(p as uint32) -> val }
    return val
}

// Read src2 (offset 12, uint32) of instruction `idx`.
@export
fn ir_insn_src2(uint64 idx) -> uint64 {
    uint64 p = ir_insn_base(idx) + 12
    uint32 val = 0
    unsafe { *(p as uint32) -> val }
    return val
}

// Read the 64-bit immediate (offset 16, uint64) of instruction `idx`.
@export
fn ir_insn_imm(uint64 idx) -> uint64 {
    uint64 p = ir_insn_base(idx) + 16
    uint64 val = 0
    unsafe { *(p as uint64) -> val }
    return val
}

// Read the owning basic block index (offset 24, uint32) of instruction `idx`.
@export
fn ir_insn_bb(uint64 idx) -> uint64 {
    uint64 p = ir_insn_base(idx) + 24
    uint32 val = 0
    unsafe { *(p as uint32) -> val }
    return val
}

// Read the next-instruction link (offset 28, uint32) of instruction `idx`.
@export
fn ir_insn_next(uint64 idx) -> uint64 {
    uint64 p = ir_insn_base(idx) + 28
    uint32 val = 0
    unsafe { *(p as uint32) -> val }
    return val
}

// ---------------------------------------------------------------------------
// Instruction field setters (used by optimization passes)
// ---------------------------------------------------------------------------

fn ir_insn_set_opcode(uint64 idx, uint64 op) {
    uint64 p = ir_insn_base(idx)
    uint32 v = op
    unsafe { *(p as uint32) = v }
}

fn ir_insn_set_src1(uint64 idx, uint64 val) {
    uint64 p = ir_insn_base(idx) + 8
    uint32 v = val
    unsafe { *(p as uint32) = v }
}

fn ir_insn_set_src2(uint64 idx, uint64 val) {
    uint64 p = ir_insn_base(idx) + 12
    uint32 v = val
    unsafe { *(p as uint32) = v }
}

fn ir_insn_set_imm(uint64 idx, uint64 val) {
    uint64 p = ir_insn_base(idx) + 16
    unsafe { *(p as uint64) = val }
}

// ---------------------------------------------------------------------------
// Emit an instruction
// ---------------------------------------------------------------------------

// Ensure one free 32-byte slot in the instruction arena. Doubles on demand
// via the shared grow_buf helper (codegen.kr). The parallel src-tok table
// grows in lockstep — it shares ir_insn_cap so per-insn indexing matches.
// grow_buf is mmap-backed (fresh mapping + copy + dealloc), so the old base
// is garbage after growth: callers must never cache a pointer INTO the
// instruction arena across an ir_emit call — always recompute from
// ir_insn_buf / ir_insn_base(idx) after any call that can emit.
fn ir_insn_ensure() {
    if ir_insn_count < ir_insn_cap { return }
    ir_insn_buf = grow_buf(ir_insn_buf, ir_insn_cap * 32, ir_insn_cap * 64)
    ir_insn_src_tok = grow_buf(ir_insn_src_tok, ir_insn_cap * 4, ir_insn_cap * 8)
    ir_insn_origin = grow_buf(ir_insn_origin, ir_insn_cap * 8, ir_insn_cap * 16)
    ir_insn_cap = ir_insn_cap * 2
}

// Create a new instruction, append it to the given basic block, and return
// the instruction index (0-based).
@export
fn ir_emit(uint64 opcode, uint64 dest, uint64 src1, uint64 src2, uint64 imm64, uint64 bb) -> uint64 {
    ir_insn_ensure()

    uint64 idx = ir_insn_count
    // Parallel-table the current statement's source token. Per-insn
    // granularity would be nicer but statement-level is enough for
    // file:line mapping and keeps the insn layout untouched.
    uint64 st_slot = ir_insn_src_tok + idx * 4
    uint32 st = ir_current_src_tok
    unsafe { *(st_slot as uint32) = st }
    // Claim the origin slot as "no name recorded". ir_emit_syscall overwrites
    // it immediately after; every other opcode leaves it zero. Zeroing here
    // rather than in ir_init is what keeps a stale pointer from the previous
    // function out of this one.
    uint64 og_slot = ir_insn_origin + idx * 8
    unsafe { *(og_slot as uint64) = 0 }
    ir_insn_count = ir_insn_count + 1
    uint64 base = ir_insn_base(idx)

    // opcode  [0..4)
    uint32 op32 = opcode
    unsafe { *(base as uint32) = op32 }

    // dest_vreg [4..8)
    uint64 p4 = base + 4
    uint32 d32 = dest
    unsafe { *(p4 as uint32) = d32 }

    // src1 [8..12)
    uint64 p8 = base + 8
    uint32 s1 = src1
    unsafe { *(p8 as uint32) = s1 }

    // src2 [12..16)
    uint64 p12 = base + 12
    uint32 s2 = src2
    unsafe { *(p12 as uint32) = s2 }

    // imm64 [16..24)
    uint64 p16 = base + 16
    unsafe { *(p16 as uint64) = imm64 }

    // bb_idx [24..28)
    uint64 p24 = base + 24
    uint32 bb32 = bb
    unsafe { *(p24 as uint32) = bb32 }

    // next [28..32) — end of list sentinel
    uint64 p28 = base + 28
    uint32 sentinel = 0xFFFFFFFF
    unsafe { *(p28 as uint32) = sentinel }

    // Append this instruction to the basic block's list
    ir_bb_append_insn(bb, idx)

    return idx
}

// Emit an IR_SYSCALL and record which builtin lowered to it.
//
// EVERY IR_SYSCALL must go through here rather than ir_emit directly, because
// imm (the canonical Linux syscall number) does not identify the builtin --
// see the ir_insn_origin comment above. `builtin` is a pointer to a static
// name literal; it must name what the programmer wrote (`file_write`, not
// `write`), since the --target=none refusal quotes it verbatim.
fn ir_emit_syscall(uint64 dest, uint64 nr, uint64 bb, uint64 builtin) -> uint64 {
    uint64 idx = ir_emit(IR_SYSCALL, dest, 0, 0, nr, bb)
    uint64 og_slot = ir_insn_origin + idx * 8
    unsafe { *(og_slot as uint64) = builtin }
    return idx
}

// ---------------------------------------------------------------------------
// Basic block helpers (internal)
// ---------------------------------------------------------------------------

// Return the base pointer for basic block at index `idx` (0-based).
fn ir_bb_base(uint64 idx) -> uint64 {
    return ir_bb_buf + idx * 16
}

// ---------------------------------------------------------------------------
// Basic block creation
// ---------------------------------------------------------------------------

// Create a new empty basic block and return its index (0-based).
@export
fn ir_new_bb() -> uint64 {
    if ir_bb_count >= ir_bb_cap {
        write(2, "error: IR basic block overflow\n", 31)
        exit(1)
    }

    uint64 idx = ir_bb_count
    ir_bb_count = ir_bb_count + 1
    uint64 base = ir_bb_base(idx)

    // first_insn = 0xFFFFFFFF (empty)
    uint32 sentinel = 0xFFFFFFFF
    unsafe { *(base as uint32) = sentinel }

    // last_insn = 0xFFFFFFFF (empty)
    uint64 p4 = base + 4
    unsafe { *(p4 as uint32) = sentinel }

    // succ0 = 0xFFFFFFFF (none)
    uint64 p8 = base + 8
    unsafe { *(p8 as uint32) = sentinel }

    // succ1 = 0xFFFFFFFF (none)
    uint64 p12 = base + 12
    unsafe { *(p12 as uint32) = sentinel }

    return idx
}

// ---------------------------------------------------------------------------
// Basic block field accessors
// ---------------------------------------------------------------------------

// Read first_insn (offset 0, uint32) of block `bb`.
@export
fn ir_bb_first_insn(uint64 bb) -> uint64 {
    uint64 p = ir_bb_base(bb)
    uint32 val = 0
    unsafe { *(p as uint32) -> val }
    return val
}

// Read last_insn (offset 4, uint32) of block `bb`.
@export
fn ir_bb_last_insn(uint64 bb) -> uint64 {
    uint64 p = ir_bb_base(bb) + 4
    uint32 val = 0
    unsafe { *(p as uint32) -> val }
    return val
}

// Read succ0 (offset 8, uint32) of block `bb`.
@export
fn ir_bb_succ0(uint64 bb) -> uint64 {
    uint64 p = ir_bb_base(bb) + 8
    uint32 val = 0
    unsafe { *(p as uint32) -> val }
    return val
}

// Read succ1 (offset 12, uint32) of block `bb`.
@export
fn ir_bb_succ1(uint64 bb) -> uint64 {
    uint64 p = ir_bb_base(bb) + 12
    uint32 val = 0
    unsafe { *(p as uint32) -> val }
    return val
}

// ---------------------------------------------------------------------------
// Basic block successor setter
// ---------------------------------------------------------------------------

// Set the two successors of block `bb`.
@export
fn ir_bb_set_succ(uint64 bb, uint64 succ0, uint64 succ1) {
    uint64 base = ir_bb_base(bb)

    uint64 p8 = base + 8
    uint32 s0 = succ0
    unsafe { *(p8 as uint32) = s0 }

    uint64 p12 = base + 12
    uint32 s1 = succ1
    unsafe { *(p12 as uint32) = s1 }
}

// ---------------------------------------------------------------------------
// Append instruction to basic block
// ---------------------------------------------------------------------------

// Link instruction `insn_idx` into block `bb`'s instruction list.
// Updates the block's first_insn/last_insn and the previous tail's
// next pointer.
@export
// Remove the BB's currently-last instruction from the linked list so
// it can be re-spliced elsewhere (LICM hoisting). Caller is responsible
// for re-linking the orphan; we do not zero its `next` field.
fn ir_bb_remove_last(uint64 bb) {
    uint64 base = ir_bb_base(bb)
    uint64 p_first = base
    uint64 p_last = base + 4
    uint32 first = 0
    uint32 last = 0
    unsafe { *(p_first as uint32) -> first }
    unsafe { *(p_last as uint32) -> last }
    if first == 0xFFFFFFFF { return }
    if first == last {
        // Only one insn — BB becomes empty.
        uint32 sentinel = 0xFFFFFFFF
        unsafe { *(p_first as uint32) = sentinel }
        unsafe { *(p_last as uint32) = sentinel }
        return
    }
    // Walk to the second-to-last, set its next to sentinel, update p_last.
    uint64 cur = first
    uint64 done = 0
    while done == 0 {
        uint32 nxt = 0
        uint64 cur_next_ptr = ir_insn_base(cur) + 28
        unsafe { *(cur_next_ptr as uint32) -> nxt }
        if nxt == last {
            uint32 sentinel = 0xFFFFFFFF
            unsafe { *(cur_next_ptr as uint32) = sentinel }
            uint32 cur32 = cur
            unsafe { *(p_last as uint32) = cur32 }
            done = 1
        } else {
            cur = nxt
        }
    }
}

// Splice an instruction into a BB just before its current last
// instruction (which is the BB's terminator under our IR conventions).
// Used by LICM: hoisted insns must be in the *executed* portion of the
// preheader, not after the IR_BR — otherwise liveness analysis treats
// them as dead code and the regalloc may over-coalesce their dests.
fn ir_bb_insert_before_terminator(uint64 bb, uint64 insn_idx) {
    uint64 base = ir_bb_base(bb)
    uint64 p_first = base
    uint64 p_last = base + 4

    uint32 first = 0
    uint32 last = 0
    unsafe { *(p_first as uint32) -> first }
    unsafe { *(p_last as uint32) -> last }

    if first == 0xFFFFFFFF {
        // BB is empty — fall back to plain append.
        ir_bb_append_insn(bb, insn_idx)
        return
    }

    // Make the new insn's next pointer point to the terminator.
    uint64 new_next_ptr = ir_insn_base(insn_idx) + 28
    uint32 last32 = last
    unsafe { *(new_next_ptr as uint32) = last32 }

    if first == last {
        // Only insn in BB is the terminator. New insn becomes first;
        // first → new → terminator.
        uint32 idx32 = insn_idx
        unsafe { *(p_first as uint32) = idx32 }
        return
    }

    // Walk from first to find the predecessor of the terminator.
    uint64 cur = first
    uint64 done = 0
    while done == 0 {
        uint32 nxt = 0
        uint64 cur_next_ptr = ir_insn_base(cur) + 28
        unsafe { *(cur_next_ptr as uint32) -> nxt }
        if nxt == last {
            // cur is the predecessor: rewire cur → new → terminator.
            uint32 idx32 = insn_idx
            unsafe { *(cur_next_ptr as uint32) = idx32 }
            done = 1
        } else {
            cur = nxt
        }
    }
}

fn ir_bb_append_insn(uint64 bb, uint64 insn_idx) {
    uint64 base = ir_bb_base(bb)
    uint64 p_first = base
    uint64 p_last = base + 4

    uint32 first = 0
    unsafe { *(p_first as uint32) -> first }

    if first == 0xFFFFFFFF {
        // Block is empty — this is the first instruction.
        uint32 ii = insn_idx
        unsafe { *(p_first as uint32) = ii }
        unsafe { *(p_last as uint32) = ii }
        return
    }

    // Block is non-empty — link previous last instruction's next to this one.
    uint32 last = 0
    unsafe { *(p_last as uint32) -> last }

    // Set previous last instruction's next pointer to insn_idx
    uint64 prev_next_ptr = ir_insn_base(last) + 28
    uint32 ii = insn_idx
    unsafe { *(prev_next_ptr as uint32) = ii }

    // Update block's last_insn
    unsafe { *(p_last as uint32) = ii }
}

// ---------------------------------------------------------------------------
// Variable name → vreg mapping for current function
// ---------------------------------------------------------------------------

static uint64 ir_var_map = 0       // [name_tok(4), vreg(4)] × 1024
static uint64 ir_var_map_count = 0

// Slice length vreg table: [name_tok(4), len_vreg(4)] × 32
static uint64 ir_slice_len_map = 0
static uint64 ir_slice_len_count = 0

fn ir_slice_len_set(uint64 name_tok, uint64 len_vreg) {
    if ir_slice_len_map == 0 { ir_slice_len_map = alloc(32 * 8) }
    if ir_slice_len_count >= 32 { return }
    uint64 entry = ir_slice_len_map + ir_slice_len_count * 8
    uint32 nt = name_tok
    unsafe { *(entry as uint32) = nt }
    uint64 e4 = entry + 4
    uint32 vr = len_vreg
    unsafe { *(e4 as uint32) = vr }
    ir_slice_len_count = ir_slice_len_count + 1
}

fn ir_slice_len_get(uint64 name_tok) -> uint64 {
    uint64 i = 0
    while i < ir_slice_len_count {
        uint64 entry = ir_slice_len_map + i * 8
        uint32 stored = 0
        unsafe { *(entry as uint32) -> stored }
        uint64 ws = stored
        if tok_text_eq(ws, name_tok) != 0 {
            uint64 e4 = entry + 4
            uint32 vr = 0
            unsafe { *(e4 as uint32) -> vr }
            return vr
        }
        i = i + 1
    }
    return 0xFFFFFFFF
}

// Hash index over the var map: open-addressing, 4096 slots of
// [gen u32, name_tok u32, map_idx u32]. Slots from an older generation
// count as empty, so the table is never cleared between functions.
// Truncation restores (`ir_var_map_count = snap`) can strand a slot whose
// map_idx points past the count or at a recycled entry — validity is
// re-checked against the array on every hit (slot.name_tok must equal
// the array entry's name_tok and map_idx < count).
static uint64 ir_var_hash_tbl = 0
static uint64 ir_var_gen = 0

fn ir_var_hash(uint64 name_tok) -> uint64 {
    uint64 start = tok_text_start(name_tok)
    uint64 len = tok_text_len(name_tok)
    uint64 h = 2166136261
    uint64 i = 0
    while i < len {
        uint64 p = cg_source + start + i
        uint64 c = 0
        unsafe { *(p as uint8) -> c }
        h = (h ^ c) * 16777619
        h = h & 0xFFFFFFFF
        i = i + 1
    }
    h = h ^ (h >> 15)
    return h & 4095
}

// Returns the slot address for name_tok: either the slot already holding
// this name (by text) in the current generation, or the first
// empty-for-this-generation slot along the probe chain.
fn ir_var_find_slot(uint64 name_tok) -> uint64 {
    uint64 h = ir_var_hash(name_tok)
    uint32 cur_gen = ir_var_gen
    while 1 == 1 {
        uint64 slot = ir_var_hash_tbl + h * 12
        uint32 g = 0
        unsafe { *(slot as uint32) -> g }
        if g != cur_gen { return slot }
        uint64 s4 = slot + 4
        uint32 nt = 0
        unsafe { *(s4 as uint32) -> nt }
        uint64 wnt = nt
        if tok_text_eq(wnt, name_tok) != 0 { return slot }
        h = (h + 1) & 4095
    }
    return 0
}

// Returns the valid map index for the slot, or 0xFFFFFFFF if the slot is
// empty or stale (truncated away by a snapshot restore).
fn ir_var_slot_idx(uint64 slot) -> uint64 {
    uint32 g = 0
    unsafe { *(slot as uint32) -> g }
    uint32 cur_gen = ir_var_gen
    if g != cur_gen { return 0xFFFFFFFF }
    uint64 s8 = slot + 8
    uint32 mi = 0
    unsafe { *(s8 as uint32) -> mi }
    uint64 wmi = mi
    if wmi >= ir_var_map_count { return 0xFFFFFFFF }
    uint64 s4 = slot + 4
    uint32 snt = 0
    unsafe { *(s4 as uint32) -> snt }
    uint64 entry = ir_var_map + wmi * 8
    uint32 ent = 0
    unsafe { *(entry as uint32) -> ent }
    if ent != snt { return 0xFFFFFFFF }
    return wmi
}

fn ir_var_map_init() {
    if ir_var_map == 0 { ir_var_map = alloc(1024 * 8) }
    if ir_var_hash_tbl == 0 {
        ir_var_hash_tbl = alloc(4096 * 12)
        memset(ir_var_hash_tbl, 0, 4096 * 12)
    }
    ir_var_gen = ir_var_gen + 1
    ir_var_map_count = 0
    ir_slice_len_count = 0
}

fn ir_var_set(uint64 name_tok, uint64 vreg) {
    uint64 slot = ir_var_find_slot(name_tok)
    uint64 idx = ir_var_slot_idx(slot)
    if idx != 0xFFFFFFFF {
        uint64 e4 = ir_var_map + idx * 8 + 4
        uint32 vr = vreg
        unsafe { *(e4 as uint32) = vr }
        return
    }
    // Add new entry
    if ir_var_map_count >= 1024 { return }
    uint64 entry = ir_var_map + ir_var_map_count * 8
    uint32 nt = name_tok
    unsafe { *(entry as uint32) = nt }
    uint64 e4 = entry + 4
    uint32 vr = vreg
    unsafe { *(e4 as uint32) = vr }
    // Record in the hash index (reuse the probed slot).
    uint32 cur_gen = ir_var_gen
    unsafe { *(slot as uint32) = cur_gen }
    uint64 s4 = slot + 4
    unsafe { *(s4 as uint32) = nt }
    uint64 s8 = slot + 8
    uint32 mi = ir_var_map_count
    unsafe { *(s8 as uint32) = mi }
    ir_var_map_count = ir_var_map_count + 1
}

// Snapshot the IR var map into the DWARF debug_var_table. Called
// from ir_emit_{x86,arm64}_function AFTER regalloc has decided each
// vreg's physical register (or spill slot). fn_count-1 is the index
// of the currently-emitting function since fn_register() ran just
// before us.
@export
fn ir_snapshot_debug_vars() {
    if debug_info_mode == 0 { return }
    uint64 cur_fn = 0
    if fn_count > 0 { cur_fn = fn_count - 1 }
    uint64 i = 0
    while i < ir_var_map_count {
        uint64 entry = ir_var_map + i * 8
        uint32 nt = 0
        unsafe { *(entry as uint32) -> nt }
        uint64 wnt = nt
        uint64 e4 = entry + 4
        uint32 vr = 0
        unsafe { *(e4 as uint32) -> vr }
        uint64 wvr = vr
        uint64 phys = ir_get_phys_reg(wvr)
        if phys != 0xFFFFFFFF {
            // kind 1: physical register; map KernRift's 0-9 colour IDs
            // through ir_phys_regs to the real ARM/x86 register number
            // and emit as DW_OP_reg<N> later. debug writer reads the
            // raw value and maps arch-specific.
            debug_var_record_loc(cur_fn, wnt, phys, 1)
        } else {
            // kind 0: fbreg — use arch-specific spill offset.
            uint64 off = 0
            if target_arch == 1 {
                off = ir_a64_spill_offset(wvr)
            } else {
                off = ir_spill_offset(wvr)
            }
            debug_var_record_loc(cur_fn, wnt, off, 0)
        }
        i = i + 1
    }
}

fn ir_var_get(uint64 name_tok) -> uint64 {
    uint64 slot = ir_var_find_slot(name_tok)
    uint64 idx = ir_var_slot_idx(slot)
    if idx == 0xFFFFFFFF { return 0xFFFFFFFF }
    uint64 e4 = ir_var_map + idx * 8 + 4
    uint32 vr = 0
    unsafe { *(e4 as uint32) -> vr }
    return vr
}

// Base address of the struct-typed name `name_tok`, as a vreg.
//
// A local struct variable's vreg already holds a POINTER to its storage. A
// file-scope static has no vreg at all — it IS the storage, so its address
// comes from IR_STATIC_ADDR. Every struct field-access site needs this
// distinction; before this helper they all used a bare ir_var_get, whose
// 0xFFFFFFFF miss was then used as a vreg number and silently produced
// nothing (stores vanished, loads read zero).
fn ir_struct_base_addr(uint64 name_tok) -> uint64 {
    uint64 v = ir_var_get(name_tok)
    if v != 0xFFFFFFFF { return v }
    uint64 soff = static_lookup(name_tok)
    if soff != 0xFFFFFFFF {
        uint64 dest = ir_new_vreg()
        ir_emit(IR_STATIC_ADDR, dest, 0, 0, soff, ir_current_bb)
        return dest
    }
    uint64 z = ir_new_vreg()
    ir_emit(IR_CONST, z, 0, 0, 0, ir_current_bb)
    return z
}

// Emit COPY instructions from current var map vregs to snapshot vregs,
// using a two-phase approach to avoid read-after-write hazards.
// Phase 1: snapshot all changed values into fresh vregs (reads before writes).
// Phase 2: copy from fresh vregs to target vregs.
fn ir_emit_copy_to_snapshot(uint64 snap_buf, uint64 snap_count, uint64 bb) {
    // Collect the (target = snapshot vreg, source = current vreg) pairs for
    // every variable the body actually changed. NOTE the source recorded here
    // is the live vreg itself, NOT a staging temp — see the conflict test below.
    uint64 pairs = alloc(snap_count * 16)
    uint64 pcnt = 0
    uint64 ci = 0
    while ci < snap_count {
        uint64 sp = snap_buf + ci * 8 + 4
        uint32 snap_vreg = 0
        unsafe { *(sp as uint32) -> snap_vreg }
        uint64 cp = ir_var_map + ci * 8 + 4
        uint32 cur_vreg = 0
        unsafe { *(cp as uint32) -> cur_vreg }
        uint64 wsv = snap_vreg
        uint64 wcv = cur_vreg
        if wsv != wcv && wsv != 0xFFFFFFFF {
            uint64 pp = pairs + pcnt * 16
            unsafe { *(pp as uint64) = wsv }
            uint64 pp8 = pp + 8
            unsafe { *(pp8 as uint64) = wcv }
            pcnt = pcnt + 1
        }
        ci = ci + 1
    }

    // This is a PARALLEL move: every target is written as if simultaneously.
    // Writing them one by one is only wrong when a target is also somebody
    // else's source, because the write would destroy a value still to be read.
    // That is the only case needing staging temps.
    //
    // It used to stage unconditionally — a fresh vreg per variable, so TWO
    // copies each instead of one. That is real per-iteration cost at every loop
    // back edge: on an ESP32 each loop-carried value measured ~4-5 cycles per
    // iteration, and it survived --no-coalesce, so the extra copy was reaching
    // the machine rather than being merged away. Conflicts are rare — the
    // sources are freshly computed values (`i + 1`), not other variables'
    // snapshots — so the common path is now one copy per variable, which the
    // colourer can then coalesce into nothing at all.
    uint64 conflict = 0
    uint64 qi = 0
    while qi < pcnt {
        uint64 qp = pairs + qi * 16 + 8
        uint64 qsrc = 0
        unsafe { *(qp as uint64) -> qsrc }
        uint64 qj = 0
        while qj < pcnt {
            if qj != qi {
                uint64 tp = pairs + qj * 16
                uint64 qtgt = 0
                unsafe { *(tp as uint64) -> qtgt }
                if qsrc == qtgt { conflict = 1 }
            }
            qj = qj + 1
        }
        qi = qi + 1
    }

    if conflict != 0 {
        // Staged form: read every source into a fresh vreg first, then write
        // the targets. Correct for any permutation, including cycles.
        ci = 0
        while ci < pcnt {
            uint64 pp = pairs + ci * 16 + 8
            uint64 source = 0
            unsafe { *(pp as uint64) -> source }
            uint64 fresh = ir_new_vreg()
            ir_emit(IR_COPY, fresh, source, 0, 0, bb)
            unsafe { *(pp as uint64) = fresh }
            ci = ci + 1
        }
    }

    ci = 0
    while ci < pcnt {
        uint64 pp = pairs + ci * 16
        uint64 target = 0
        unsafe { *(pp as uint64) -> target }
        uint64 pp8 = pp + 8
        uint64 source = 0
        unsafe { *(pp8 as uint64) -> source }
        ir_emit(IR_COPY, target, source, 0, 0, bb)
        ci = ci + 1
    }
    dealloc(pairs)
}

// ---------------------------------------------------------------------------
// Current basic block tracking
// ---------------------------------------------------------------------------

static uint64 ir_current_bb = 0

// Compound-assignment index/address temp. A compound store (`arr[i] OP= v`,
// `*(p as T) OP= v`) evaluates its index/address expression ONCE into this
// vreg, then lowers the value expression; the AstKind.CompoundTemp leaf that
// the parser put on the read side lowers to exactly this vreg. Expression
// lowering never reaches statement lowering (ir_lower_expr contains no
// ir_lower_stmt call), so compound stores cannot nest and one slot suffices.
static uint64 ir_compound_temp = 0xFFFFFFFF

// `for i in START..END` end bound, parked for the whole loop. The While
// lowering evaluates ForEndHoist's child ONCE into this vreg, in the
// preheader BB (before the IR_BR into the header, so liveness sees a
// definition that dominates every condition test); the AstKind.ForEndHoist
// leaf the parser left in the condition lowers to exactly this vreg.
// Saved/restored around each loop, so a nested for loop gets its own vreg and
// the outer bound is still valid when the outer condition is re-tested.
// 0xFFFFFFFF = nothing parked (lower the bound in place instead).
static uint64 ir_for_end = 0xFFFFFFFF

// Loop context stack for break/continue
static uint64 ir_loop_exit_stack = 0       // bb indices for break targets

// LICM bookkeeping: per-loop tuple (preheader_bb, header_bb,
// body_first_bb) populated during `while` lowering. The body range
// is [header_bb+1 .. ir_bb_count_at_loop_close-1] — recorded after
// the body is fully emitted in `kind == 14` lowering.
//
// 16 bytes per loop: 4 u32 fields. 256 loops max in any one function
// (way more than any sane KernRift source needs).
static uint64 ir_loops = 0
static uint64 ir_loop_count = 0
static uint64 ir_loop_cap = 0
static uint64 ir_loop_header_stack = 0     // bb indices for continue targets
static uint64 ir_loop_hdr_buf_stack = 0    // header vreg snapshot pointers
static uint64 ir_loop_hdr_count_stack = 0  // header vreg snapshot counts
static uint64 ir_loop_depth = 0

// Nested field access tracking: set by ir_lower_expr FieldAccess (kind 36)
// when the accessed field is itself a struct type.
// 0xFFFFFFFF = not a struct field, otherwise = struct index of the field type.
static uint64 ir_fa_struct_idx = 0xFFFFFFFF

// ---------------------------------------------------------------------------
// Nested field chain helper
// ---------------------------------------------------------------------------

// Evaluate a FieldAccess chain (e.g. a.b) and return the address (pointer)
// of the innermost struct field. Sets ir_fa_struct_idx to the struct index
// of the resulting field's type so the outer access can use it.
fn ir_lower_field_chain(uint64 node) -> uint64 {
    uint32 field_tok = ast_data2(node)
    uint32 child_idx = ast_child(node)
    uint64 wchild = child_idx
    uint32 ck = ast_kind(wchild)

    if ck == 36 {
        // Child is another FieldAccess — recurse
        uint64 inner_addr = ir_lower_field_chain(wchild)
        uint64 inner_si = ir_fa_struct_idx
        if inner_si != 0xFFFFFFFF {
            uint64 foff = struct_field_offset(inner_si, field_tok)
            uint64 addr_v = inner_addr
            if foff != 0 {
                uint64 off_v = ir_new_vreg()
                ir_emit(IR_CONST, off_v, 0, 0, foff, ir_current_bb)
                addr_v = ir_new_vreg()
                ir_emit(IR_ADD, addr_v, inner_addr, off_v, 0, ir_current_bb)
            }
            uint64 ftk = struct_field_type_kind_by_tok(inner_si, field_tok)
            if ftk >= 256 {
                ir_fa_struct_idx = ftk - 256
            } else {
                ir_fa_struct_idx = 0xFFFFFFFF
            }
            return addr_v
        }
        ir_fa_struct_idx = 0xFFFFFFFF
        return inner_addr
    }

    // Base case: child is an Ident
    if ck == 32 {
        uint32 obj_tok = ast_data1(wchild)
        uint64 wobj = obj_tok
        uint64 si = struct_var_lookup(wobj)
        if si != 0xFFFFFFFF {
            uint64 base_v = ir_struct_base_addr(obj_tok)
            uint64 foff = struct_field_offset(si, field_tok)
            uint64 addr_v = base_v
            if foff != 0 {
                uint64 off_v = ir_new_vreg()
                ir_emit(IR_CONST, off_v, 0, 0, foff, ir_current_bb)
                addr_v = ir_new_vreg()
                ir_emit(IR_ADD, addr_v, base_v, off_v, 0, ir_current_bb)
            }
            uint64 ftk = struct_field_type_kind_by_tok(si, field_tok)
            if ftk >= 256 {
                ir_fa_struct_idx = ftk - 256
            } else {
                ir_fa_struct_idx = 0xFFFFFFFF
            }
            return addr_v
        }
    }
    ir_fa_struct_idx = 0xFFFFFFFF
    uint64 zero = ir_new_vreg()
    ir_emit(IR_CONST, zero, 0, 0, 0, ir_current_bb)
    return zero
}

// ---------------------------------------------------------------------------
// Expression lowering
// ---------------------------------------------------------------------------

// Power-of-two test for strength reduction. Returns k+1 when v == 1<<k
// (so 8 returns 4 and 1 returns 1), or 0 when v is zero or not a power
// of two. The +1 keeps 0 free as the "no" answer since k itself can be 0.
fn ir_is_pow2(uint64 v) -> uint64 {
    if v == 0 { return 0 }
    if (v & (v - 1)) != 0 { return 0 }
    uint64 k = 0
    uint64 t = v
    while t > 1 {
        t = t >> 1
        k = k + 1
    }
    return k + 1
}

// ---------------------------------------------------------------------------
// Bare-metal (--target=none) output routing
// ---------------------------------------------------------------------------
//
// `write` is a builtin that lowers to a syscall, so under --target=none it is
// refused and a program supplies a replacement with @builtin_override. That
// mechanism already worked at 448a115: the whole builtin-matching chain is
// skipped for registered names and the call falls through to a normal
// IR_CALL.
//
// It does not, on its own, make a bare-metal program able to PRINT. `print`,
// `println`, `print_str` and `println_str` are SEPARATE BUILTINS. Each one
// emits its own IR_SYSCALL directly and none of them calls the `write`
// builtin, so an override named `write` reroutes none of them and all four
// keep refusing. That is why this task could not be stdlib-only.
//
// The four are rerouted here instead: under target_os == 4 they resolve their
// output through the same override the `write` builtin does, and emit a CALL
// to it. One provider therefore serves all five entry points and a program
// needs nothing but the import.
//
// Two consequences follow from doing it in the lowering rather than in a
// library, and both are deliberate:
//
//   * The formatting buffer stops being a heap allocation. The hosted
//     lowering allocates 4096 bytes with IR_ALLOC, which is mmap/VirtualAlloc
//     and is itself refused on bare metal -- so routing only the write would
//     have moved the refusal from 'println' to 'alloc' and told the
//     programmer to supply an allocator they do not need. The bare-metal path
//     formats each argument into a 64-byte STACK scratch (IR_STACK_ADDR) and
//     writes it out immediately, so importing a UART is genuinely sufficient
//     and a heap is optional.
//
//   * Nesting is safe by construction. The scratch is per-function and
//     reused, which would corrupt output if two prints could be live at once
//     in one frame. They cannot: the scratch is only live between formatting
//     ONE argument and writing it, and nothing is lowered in between. An
//     inner println() in an outer println()'s argument list has completely
//     finished before the outer touches the scratch again.
//
// LEGACY IS NOT COVERED, BY CONSTRUCTION. --legacy and --emit=obj have their
// own builtin dispatch in src/codegen.kr and src/codegen_aarch64.kr and never
// call ir_lower_expr. They refuse explicitly there (bm_fix_write_legacy)
// rather than falling into the generic emitter backstop.

// The 64-byte per-function scratch used to format one argument at a time.
//
// THE WORST CASE IS 40 BYTES, AND IT IS NaN ON x86_64. It was measured, not
// derived, because the derivation was wrong: an earlier version of this
// comment reasoned "IR_FMT_F64 gives up at |x| >= 1e18, so sign + 18 digits +
// '.' + 6 fraction digits = 26" from the code, and the code does not do that.
// `ucomisd` sets CF on unordered, and the guard at IR_FMT_F64's 1e18 test is
// `jae`, which is `jnc` -- so a NaN does NOT take the "big" branch its own
// comment claims it does. It falls through into the integer path, where
// cvttsd2si yields the INDEFINITE value, and prints as
//
//     -9223372036854775808.9223372036854775808        (40 bytes)
//
// Measured by compiling `print(0.0 / 0.0)` for x86_64 and counting the bytes
// on stdout. +/-Inf is "big" / "-big" on both arches; arm64 prints "big" for
// the same NaN, so the two arches diverge on this input (recorded as a finding
// in the task report, not fixed here).
//
// 40 < 64, so the scratch is not overflowable by anything the IR_FMT_* family
// can produce today: FMT_UINT at most 20 digits, the signed path at most 21,
// FMT_BOOL 5, char 1. The margin is 24 bytes, and it is stated here as a
// measured number so the next person to widen a formatter has something to
// check against rather than a derivation to re-derive incorrectly.
//
// Reserved lazily so a function that never prints pays nothing, and reserved
// ONCE so a function with fifty printlns does not grow a 3 KB frame. The
// ADDRESS is recomputed at each use with a fresh IR_STACK_ADDR rather than
// holding one vreg across basic blocks -- an lea is cheaper than reasoning
// about cross-block liveness of a frame pointer, and cannot be wrong.
static uint64 ir_bm_scratch_off = 0xFFFFFFFF

fn ir_bm_scratch_reserve() -> uint64 {
    if ir_bm_scratch_off == 0xFFFFFFFF {
        ir_bm_scratch_off = ir_stack_array_bytes
        ir_stack_array_bytes = ir_stack_array_bytes + 64
    }
    return ir_bm_scratch_off
}

fn ir_bm_scratch_addr() -> uint64 {
    uint64 off = ir_bm_scratch_reserve()
    uint64 dest = ir_new_vreg()
    ir_emit(IR_STACK_ADDR, dest, 0, 0, off, ir_current_bb)
    return dest
}

// Intern `n` bytes of compiler-owned text as a string constant in the output
// and return a vreg holding its address. Same storage the StrLit lowering
// uses; this variant takes a pointer and a length because the bytes come from
// the compiler (a separator, a newline) rather than from a source token.
fn ir_bm_str_const(uint64 s, uint64 n) -> uint64 {
    str_buf_ensure(str_len + n + 1)
    uint64 str_offset = str_len
    uint64 i = 0
    while i < n {
        uint64 sp = s + i
        uint8 cb = 0
        unsafe { *(sp as uint8) -> cb }
        uint64 dp = str_buf + str_len
        unsafe { *(dp as uint8) = cb }
        str_len = str_len + 1
        i = i + 1
    }
    uint64 zp = str_buf + str_len
    uint8 zb = 0
    unsafe { *(zp as uint8) = zb }
    str_len = str_len + 1
    uint64 dest = ir_new_vreg()
    ir_emit(IR_STR_CONST, dest, 0, 0, str_offset, ir_current_bb)
    return dest
}

// Emit `write(1, ptr, len)` as a call to the provider whose definition token
// is `wtok`. fd is always 1: a board with one UART has one output, and the
// providers in std/ ignore fd for exactly that reason.
fn ir_bm_emit_write(uint64 wtok, uint64 ptr_v, uint64 len_v) {
    uint64 fd_v = ir_new_vreg()
    ir_emit(IR_CONST, fd_v, 0, 0, 1, ir_current_bb)
    ir_emit(IR_ARG, 0, fd_v, 0, 0, ir_current_bb)
    ir_emit(IR_ARG, 0, ptr_v, 0, 1, ir_current_bb)
    ir_emit(IR_ARG, 0, len_v, 0, 2, ir_current_bb)
    uint64 wr = ir_new_vreg()
    ir_emit(IR_CALL, wr, 3, 0, wtok, ir_current_bb)
}

// Write `n` compiler-owned bytes (a separator, a newline).
fn ir_bm_emit_write_lit(uint64 wtok, uint64 s, uint64 n) {
    uint64 s_v = ir_bm_str_const(s, n)
    uint64 n_v = ir_new_vreg()
    ir_emit(IR_CONST, n_v, 0, 0, n, ir_current_bb)
    ir_bm_emit_write(wtok, s_v, n_v)
}

// The definition token of the `write` provider, or 0xFFFFFFFF if the program
// supplied none. Callers refuse on 0xFFFFFFFF; they must NOT fall back to the
// syscall lowering, which is the whole point of --target=none.
//
// Resolving by name is not enough: the lowerings below synthesise a
// three-argument call, and a synthesised call is invisible to the AST-walking
// arity check in src/analysis.kr. Validated here, at the single point every
// bare-metal print resolves through, so a provider of the wrong shape is
// refused rather than silently handed arguments it never declared. The result
// is discarded by every caller, so the return type is not constrained.
fn ir_bm_write_provider() -> uint64 {
    uint64 wtok = builtin_override_tok_of("write", 5)
    if wtok != 0xFFFFFFFF {
        bm_provider_check(wtok, "write", 3, 0,
                          "print/println/print_str/println_str under --target=none",
                          bm_write_shape())
    }
    return wtok
}

// The bare-metal body of print()/println(). Mirrors the hosted lowering's
// per-argument dispatch exactly -- same IR_FMT_* selection, same branchless
// sign handling -- and differs only in where the bytes go: into the 64-byte
// scratch and straight out through the provider, one argument at a time,
// instead of accumulating into a 4096-byte heap buffer for a single write.
//
// The visible difference is that a bare-metal print is several UART writes
// rather than one syscall. That is not a regression: a UART is a byte-at-a-
// time device, so a single buffered write would have been decomposed into the
// same byte loop inside the provider anyway.
fn ir_lower_print_bare_metal(uint64 node, uint64 is_println, uint64 wtok) {
    uint32 warg = ast_child(node)
    uint64 first = 1
    while warg != 0 {
        if first == 0 {
            ir_bm_emit_write_lit(wtok, " ", 1)
        }
        first = 0
        uint32 arg_kind = ast_kind(warg)
        if arg_kind == 31 || arg_kind == 50 {
            // String literal or FString: already a pointer to bytes.
            uint64 s_v = ir_lower_expr(warg)
            uint64 slen_v = ir_new_vreg()
            ir_emit(IR_STRLEN, slen_v, s_v, 0, 0, ir_current_bb)
            ir_bm_emit_write(wtok, s_v, slen_v)
        } else {
            uint64 val_v = ir_lower_expr(warg)
            // The scratch address is taken AFTER the argument is lowered:
            // lowering it may itself print (a nested call), and that print
            // uses the same scratch.
            uint64 slot_v = ir_bm_scratch_addr()
            uint64 len_v = ir_new_vreg()
            uint64 fk = ir_vreg_fkind_get(val_v)
            if fk == 1 {
                ir_emit(IR_FMT_F64, len_v, slot_v, val_v, 0, ir_current_bb)
            } else if fk == 2 {
                uint64 f64v = ir_new_vreg()
                ir_emit(IR_F32TOF64, f64v, val_v, 0, 0, ir_current_bb)
                ir_vreg_fkind_set(f64v, 1)
                ir_emit(IR_FMT_F64, len_v, slot_v, f64v, 0, ir_current_bb)
            } else if fk == 3 {
                ir_emit(IR_FMT_BOOL, len_v, slot_v, val_v, 0, ir_current_bb)
            } else if fk == 4 {
                ir_emit(IR_STORE, 1, slot_v, val_v, 0, ir_current_bb)
                ir_emit(IR_CONST, len_v, 0, 0, 1, ir_current_bb)
            } else if ir_vreg_signed_get(val_v) != 0 {
                // Branchless sign: write '-' unconditionally, then advance the
                // write pointer past it only when the value is negative, so
                // the digits overwrite it for a non-negative value. Same
                // sequence as the hosted lowering; see the comment there.
                uint64 pv_63 = ir_new_vreg()
                ir_emit(IR_CONST, pv_63, 0, 0, 63, ir_current_bb)
                uint64 pv_sign = ir_new_vreg()
                ir_emit(IR_SAR, pv_sign, val_v, pv_63, 0, ir_current_bb)
                uint64 pv_one = ir_new_vreg()
                ir_emit(IR_CONST, pv_one, 0, 0, 1, ir_current_bb)
                uint64 pv_adv = ir_new_vreg()
                ir_emit(IR_AND, pv_adv, pv_sign, pv_one, 0, ir_current_bb)
                uint64 pv_xor = ir_new_vreg()
                ir_emit(IR_XOR, pv_xor, val_v, pv_sign, 0, ir_current_bb)
                uint64 pv_abs = ir_new_vreg()
                ir_emit(IR_SUB, pv_abs, pv_xor, pv_sign, 0, ir_current_bb)
                uint64 pv_minus = ir_new_vreg()
                ir_emit(IR_CONST, pv_minus, 0, 0, 45, ir_current_bb)
                ir_emit(IR_STORE, 1, slot_v, pv_minus, 0, ir_current_bb)
                uint64 pv_slot2 = ir_new_vreg()
                ir_emit(IR_ADD, pv_slot2, slot_v, pv_adv, 0, ir_current_bb)
                uint64 pv_dlen = ir_new_vreg()
                ir_emit(IR_FMT_UINT, pv_dlen, pv_slot2, pv_abs, 0, ir_current_bb)
                ir_emit(IR_ADD, len_v, pv_dlen, pv_adv, 0, ir_current_bb)
            } else {
                ir_emit(IR_FMT_UINT, len_v, slot_v, val_v, 0, ir_current_bb)
            }
            ir_bm_emit_write(wtok, slot_v, len_v)
        }
        uint32 nxt = ast_next(warg)
        warg = nxt
    }
    if is_println != 0 {
        ir_bm_emit_write_lit(wtok, "\n", 1)
    }
}

fn ir_lower_expr(uint64 node) -> uint64 {
    if node == 0 { return 0xFFFFFFFF }
    uint32 kind = ast_kind(node)

    // CompoundTemp (55): the index/address the enclosing compound store has
    // already evaluated. Reusing it is what keeps `arr[i()] += v()` from
    // calling i() a second time.
    if kind == 55 {
        return ir_compound_temp
    }

    // ForEndHoist (57): the `for` loop's end bound, already evaluated once
    // into ir_for_end by the enclosing While lowering. Reusing that vreg is
    // what keeps `for i in a()..b()` from calling b() on every condition test.
    // With nothing parked (this node reached from outside a for-range While)
    // fall back to lowering the real bound rather than returning a dead vreg.
    if kind == 57 {
        if ir_for_end != 0xFFFFFFFF { return ir_for_end }
        uint32 feh_c_ir = ast_child(node)
        uint64 wfeh_c_ir = feh_c_ir
        return ir_lower_expr(wfeh_c_ir)
    }

    // PtrLoadExpr (56): `*(addr as TYPE)` in expression position — the read
    // half of `*(addr as TYPE) OP= val`. Same lowering as the kind-41
    // statement, minus the destination binding.
    if kind == 56 {
        uint32 pl_ts = ast_data1(node)
        uint64 pl_type_size = pl_ts
        uint32 pl_addr = ast_child(node)
        uint64 pl_addr_v = ir_lower_expr(pl_addr)
        uint64 pl_dest = ir_new_vreg()
        uint32 pl_d3_32 = ast_data3(node)
        uint64 pl_d3 = pl_d3_32
        uint64 pl_fk = pl_d3 & 15
        uint64 pl_vol = (pl_d3 >> 4) & 1
        if pl_vol != 0 {
            ir_emit(IR_VLOAD, pl_dest, pl_addr_v, 0, pl_type_size, ir_current_bb)
        } else {
            ir_emit(IR_LOAD, pl_dest, pl_addr_v, pl_type_size, 0, ir_current_bb)
        }
        uint64 pl_vfk = ir_fkind_from_decl(pl_fk)
        if pl_vfk != 0 { ir_vreg_fkind_set(pl_dest, pl_vfk) }
        return pl_dest
    }

    // IntLit (30)
    if kind == 30 {
        uint32 tok = ast_data1(node)
        uint64 val = parse_int_token(tok)
        uint64 dest = ir_new_vreg()
        ir_emit(IR_CONST, dest, 0, 0, val, ir_current_bb)
        uint32 d4 = ast_data4(node)
        uint64 wd4 = d4
        if wd4 == 98 { ir_vreg_fkind_set(dest, 3) }
        if wd4 == 99 { ir_vreg_fkind_set(dest, 4) }
        return dest
    }

    // FloatLit (46): parse integer+fraction[+exponent], emit ITOF + arithmetic.
    // Accepts scientific notation: `1e-3`, `5.5e-4`, `3.14E+10`, `2e5f`.
    if kind == 46 {
        uint32 lit_tok = ast_data1(node)
        uint64 wlt = lit_tok
        uint64 tstart = tok_text_start(wlt)
        uint64 tlen = tok_text_len(wlt)
        // Parse integer part and fractional part
        uint64 int_val = 0
        uint64 frac_val = 0
        uint64 frac_divisor = 1
        uint64 past_dot = 0
        uint64 is_f32 = 0
        uint64 in_exp = 0
        uint64 exp_neg = 0
        uint64 exp_val = 0
        uint64 frac_digits = 0
        uint64 fi = 0
        while fi < tlen {
            uint64 ch = tok_source_byte(wlt, fi)
            if ch == 46 { past_dot = 1; fi = fi + 1; continue }
            if ch == 102 { is_f32 = 1; fi = fi + 1; continue }
            if ch == 101 || ch == 69 {
                // 'e' / 'E' — switch to exponent parsing, consume
                // optional sign if present.
                in_exp = 1
                fi = fi + 1
                if fi < tlen {
                    uint64 sign_ch = tok_source_byte(wlt, fi)
                    if sign_ch == 45 { exp_neg = 1; fi = fi + 1 }
                    else if sign_ch == 43 { fi = fi + 1 }
                }
                continue
            }
            if ch >= 48 && ch <= 57 {
                if in_exp != 0 {
                    exp_val = exp_val * 10 + (ch - 48)
                } else if past_dot == 0 {
                    int_val = int_val * 10 + (ch - 48)
                } else {
                    // Stop accumulating after 15 frac digits: 10^15 < u64_max,
                    // and f64 has only ~15-16 sig figs so extra digits are noise.
                    // Beyond 18 digits frac_divisor * 10 would overflow u64.
                    if frac_digits < 15 {
                        frac_val = frac_val * 10 + (ch - 48)
                        frac_divisor = frac_divisor * 10
                        frac_digits = frac_digits + 1
                    }
                }
            }
            fi = fi + 1
        }
        // Convert integer part to f64
        uint64 int_c = ir_new_vreg()
        ir_emit(IR_CONST, int_c, 0, 0, int_val, ir_current_bb)
        uint64 int_f = ir_new_vreg()
        ir_emit(IR_ITOF, int_f, int_c, 0, 0, ir_current_bb)
        ir_vreg_fkind_set(int_f, 1)
        uint64 result = int_f
        if frac_val != 0 {
            // Convert frac_val to f64
            uint64 frac_c = ir_new_vreg()
            ir_emit(IR_CONST, frac_c, 0, 0, frac_val, ir_current_bb)
            uint64 frac_f = ir_new_vreg()
            ir_emit(IR_ITOF, frac_f, frac_c, 0, 0, ir_current_bb)
            ir_vreg_fkind_set(frac_f, 1)
            // Convert frac_divisor to f64
            uint64 div_c = ir_new_vreg()
            ir_emit(IR_CONST, div_c, 0, 0, frac_divisor, ir_current_bb)
            uint64 div_f = ir_new_vreg()
            ir_emit(IR_ITOF, div_f, div_c, 0, 0, ir_current_bb)
            ir_vreg_fkind_set(div_f, 1)
            // frac = frac_val / frac_divisor
            uint64 frac_r = ir_new_vreg()
            ir_emit(IR_FDIV, frac_r, frac_f, div_f, 1, ir_current_bb)
            ir_vreg_fkind_set(frac_r, 1)
            // result = int_part + frac
            result = ir_new_vreg()
            ir_emit(IR_FADD, result, int_f, frac_r, 1, ir_current_bb)
            ir_vreg_fkind_set(result, 1)
        }
        // Apply decimal exponent: multiply (or divide) by 10^exp_val.
        // Compile-time compute pow10 as a uint64 for |exp| ≤ 18 (fits
        // the u64 range) and emit a single ITOF + one FMUL/FDIV so the
        // runtime cost is constant regardless of magnitude.
        if exp_val != 0 {
            if exp_val > 18 {
                uint64 wmsg_1401 = "error: float exponent too large (max 1e18)\n"
                write(2, wmsg_1401, str_len(wmsg_1401))
                exit(1)
            }
            uint64 pow10_u = 1
            uint64 ei = 0
            while ei < exp_val {
                pow10_u = pow10_u * 10
                ei = ei + 1
            }
            uint64 pow10_c = ir_new_vreg()
            ir_emit(IR_CONST, pow10_c, 0, 0, pow10_u, ir_current_bb)
            uint64 pow10_f = ir_new_vreg()
            ir_emit(IR_ITOF, pow10_f, pow10_c, 0, 0, ir_current_bb)
            ir_vreg_fkind_set(pow10_f, 1)
            uint64 scaled = ir_new_vreg()
            if exp_neg != 0 {
                ir_emit(IR_FDIV, scaled, result, pow10_f, 1, ir_current_bb)
            } else {
                ir_emit(IR_FMUL, scaled, result, pow10_f, 1, ir_current_bb)
            }
            ir_vreg_fkind_set(scaled, 1)
            result = scaled
        }
        if is_f32 != 0 {
            // Narrow f64 to f32
            uint64 f32_v = ir_new_vreg()
            ir_emit(IR_F64TOF32, f32_v, result, 0, 0, ir_current_bb)
            ir_vreg_fkind_set(f32_v, 2)
            return f32_v
        }
        return result
    }

    // StrLit (31) — store string in str_buf, emit lea rip-relative
    if kind == 31 {
        uint32 tok = ast_data1(node)
        uint64 wtok = tok
        uint64 tstart = tok_text_start(wtok)
        uint64 tlen = tok_text_len(wtok)
        str_buf_ensure(str_len + tlen + 1)
        uint64 str_offset = str_len
        // Copy string bytes (skip quotes, process escapes). Escape table
        // lives in codegen.kr via escape_char_to_byte + hex_digit_pair_to_byte;
        // the legacy codegen and the aarch64 emitter share the same helpers.
        uint64 si = 1
        while si < tlen - 1 {
            uint64 ch = tok_source_byte(wtok, si)
            if ch == 92 {
                si = si + 1
                uint64 esc = tok_source_byte(wtok, si)
                if esc == 120 && si + 2 < tlen {
                    ch = hex_digit_pair_to_byte(tok_source_byte(wtok, si + 1),
                                                tok_source_byte(wtok, si + 2))
                    si = si + 2
                } else {
                    uint64 mapped = escape_char_to_byte(esc)
                    if mapped != 0xFFFFFFFFFFFFFFFF { ch = mapped }
                    else { ch = esc }
                }
            }
            uint64 sp = str_buf + str_len
            uint8 cb = ch
            unsafe { *(sp as uint8) = cb }
            str_len = str_len + 1
            si = si + 1
        }
        // Null-terminate
        uint64 sp = str_buf + str_len
        uint8 zero = 0
        unsafe { *(sp as uint8) = zero }
        str_len = str_len + 1
        uint64 dest = ir_new_vreg()
        ir_emit(IR_STR_CONST, dest, 0, 0, str_offset, ir_current_bb)
        return dest
    }

    // Ident (32)
    if kind == 32 {
        uint32 tok = ast_data1(node)
        uint64 vreg = ir_var_get(tok)
        if vreg != 0xFFFFFFFF { return vreg }
        // Check if it's a static variable
        uint64 wt = tok
        uint64 st_off = static_lookup(wt)
        if st_off != 0xFFFFFFFF {
            // Static arrays decay to their base address when used as
            // an rvalue (bare identifier), matching C semantics. This
            // lets callers pass arrays to helper functions as uint64
            // pointers — `vec_f64_decay_inplace(buf, n, f)` with
            // `static f64[N] buf` now Just Works. Indexing `arr[i]`
            // uses a separate AST kind (Index=37) that has always
            // emitted IR_STATIC_ADDR, so that path stays unchanged.
            uint64 sasz = static_array_size_of(wt)
            if sasz != 0 && sasz != 0xFFFFFFFF {
                uint64 addr_dest = ir_new_vreg()
                ir_emit(IR_STATIC_ADDR, addr_dest, 0, 0, st_off, ir_current_bb)
                return addr_dest
            }
            uint64 dest = ir_new_vreg()
            ir_emit(IR_STATIC_LOAD, dest, 0, 0, st_off, ir_current_bb)
            // Propagate f64/f32 type-flow from the static's declared
            // type so downstream `+`, `*` etc. lower to IR_FADD/FMUL
            // rather than integer ops.
            uint64 sfk = ir_fkind_from_decl(static_fkind_of(wt))
            if sfk != 0 { ir_vreg_fkind_set(dest, sfk) }
            return dest
        }
        // Unknown identifier — report error with source span + caret,
        // plus a "did you mean" hint from the closest in-scope name
        // (current fn's locals + statics) within edit distance 2.
        diag_loc_head(wt, 0)
        write(2, "use of undeclared identifier '", 30)
        uint64 ts = tok_text_start(wt)
        uint64 tl = tok_text_len(wt)
        write(2, cg_source + ts, tl)
        write(2, "'", 1)
        diag_sugg_reset()
        diag_sugg_scan(wt, ir_var_map, ir_var_map_count)
        diag_sugg_scan(wt, static_table, static_count)
        diag_sugg_print()
        write(2, "\n", 1)
        diag_span_of(wt)
        exit(1)
    }

    // BinOp (33)
    if kind == 33 {
        uint32 op_tok = ast_data1(node)
        uint32 lhs_node = ast_child(node)
        uint32 rhs_node = ast_data2(node)
        uint64 lhs = ir_lower_expr(lhs_node)
        uint64 rhs = ir_lower_expr(rhs_node)
        uint64 dest = ir_new_vreg()
        uint64 op_kind = tok_kind_at_raw(op_tok)
        // Check if LHS is float-typed
        uint64 lhs_fk = ir_vreg_fkind_get(lhs)
        if ir_fkind_is_float(lhs_fk) != 0 {
            // Float arithmetic: operands must share an fkind. ADDSS/SUBSS/
            // MULSS/DIVSS read only the low 32 bits of XMM, so an f64
            // literal like 1.0 (whose low 32 bits are 0x00000000) silently
            // becomes 0.0 if paired with an f32 var. Widen the narrower
            // side to f64 — exact mirror of the FCMP fix below.
            uint64 rhs_fk = ir_vreg_fkind_get(rhs)
            if lhs_fk == 2 && rhs_fk == 1 {
                uint64 lhs_w = ir_new_vreg()
                ir_emit(IR_F32TOF64, lhs_w, lhs, 0, 0, ir_current_bb)
                ir_vreg_fkind_set(lhs_w, 1)
                lhs = lhs_w
                lhs_fk = 1
            } else if lhs_fk == 1 && rhs_fk == 2 {
                uint64 rhs_w = ir_new_vreg()
                ir_emit(IR_F32TOF64, rhs_w, rhs, 0, 0, ir_current_bb)
                ir_vreg_fkind_set(rhs_w, 1)
                rhs = rhs_w
            }
            uint64 ir_op = IR_FADD
            if op_kind == 30 || op_kind == 45 { ir_op = IR_FADD }   // + +=
            if op_kind == 31 || op_kind == 46 { ir_op = IR_FSUB }   // - -=
            if op_kind == 22 || op_kind == 47 { ir_op = IR_FMUL }   // * *=
            if op_kind == 32 || op_kind == 48 { ir_op = IR_FDIV }   // / /=
            ir_emit(ir_op, dest, lhs, rhs, lhs_fk, ir_current_bb)
            ir_vreg_fkind_set(dest, lhs_fk)
            return dest
        }
        // Signed-aware DIV/MOD. Unsigned div on a negative two's-complement
        // bit pattern returns a huge positive — wrong for `int64 a = -10;
        // a / 3` which should be -3. Pick IR_SDIV/IR_SMOD if either side
        // carries the signed flag. ADD/SUB/MUL produce identical bits in
        // two's complement, so they don't need a signed variant.
        uint64 bin_lhs_signed = ir_vreg_signed_get(lhs)
        uint64 bin_rhs_signed = ir_vreg_signed_get(rhs)
        uint64 bin_use_signed = 0
        if bin_lhs_signed != 0 { bin_use_signed = 1 }
        if bin_rhs_signed != 0 { bin_use_signed = 1 }
        uint64 ir_op = IR_ADD
        if op_kind == 30 || op_kind == 45 { ir_op = IR_ADD }     // + +=
        if op_kind == 31 || op_kind == 46 { ir_op = IR_SUB }     // - -=
        if op_kind == 22 || op_kind == 47 { ir_op = IR_MUL }     // * *=
        if op_kind == 32 || op_kind == 48 {
            if bin_use_signed != 0 { ir_op = IR_SDIV } else { ir_op = IR_DIV }
        }
        if op_kind == 33 || op_kind == 49 {
            if bin_use_signed != 0 { ir_op = IR_SMOD } else { ir_op = IR_MOD }
        }
        if op_kind == 23 || op_kind == 50 { ir_op = IR_AND }     // & &=
        if op_kind == 24 || op_kind == 51 { ir_op = IR_OR }      // | |=
        if op_kind == 25 || op_kind == 52 { ir_op = IR_XOR }     // ^ ^=
        if op_kind == 43 || op_kind == 53 { ir_op = IR_SHL }     // << <<=
        if op_kind == 44 || op_kind == 54 {
            // Arithmetic vs logical right shift: signed → SAR (sign-extends),
            // unsigned → SHR (zero-fills). `int64 a = -8; a >> 1` should yield
            // -4, not 0x7FFFFFFFFFFFFFFC.
            if bin_use_signed != 0 { ir_op = IR_SAR } else { ir_op = IR_SHR }
        }
        // Strength reduction: UNSIGNED div/mod by a literal power of two
        // lowers to shr/and — hardware div is ~20-40 cycles vs 1 for a
        // shift, and for unsigned x the identities x/2^k == x>>k and
        // x%2^k == x&(2^k-1) are bit-exact over all of uint64. Signed
        // IR_SDIV/IR_SMOD are left alone (correct signed pow2 division
        // needs a bias sequence). The divisor must be an IntLit node so
        // its value is known here; the literal's IR_CONST already emitted
        // into `rhs` goes dead and DCE sweeps it.
        if ir_op == IR_DIV || ir_op == IR_MOD {
            uint64 sr_rhs_n = rhs_node
            uint32 sr_rk = ast_kind(sr_rhs_n)
            uint64 sr_wrk = sr_rk
            if sr_wrk == 30 {
                uint32 sr_tok = ast_data1(sr_rhs_n)
                uint64 sr_wtok = sr_tok
                uint64 sr_c = parse_int_token(sr_wtok)
                uint64 sr_p = ir_is_pow2(sr_c)
                if sr_p != 0 {
                    uint64 sr_k = sr_p - 1
                    if ir_op == IR_DIV {
                        if sr_k == 0 {
                            // x / 1 == x
                            ir_emit(IR_COPY, dest, lhs, 0, 0, ir_current_bb)
                        } else {
                            uint64 sr_amt = ir_new_vreg()
                            ir_emit(IR_CONST, sr_amt, 0, 0, sr_k, ir_current_bb)
                            ir_emit(IR_SHR, dest, lhs, sr_amt, 0, ir_current_bb)
                        }
                    } else {
                        if sr_k == 0 {
                            // x % 1 == 0
                            ir_emit(IR_CONST, dest, 0, 0, 0, ir_current_bb)
                        } else {
                            uint64 sr_mask = ir_new_vreg()
                            ir_emit(IR_CONST, sr_mask, 0, 0, sr_c - 1, ir_current_bb)
                            ir_emit(IR_AND, dest, lhs, sr_mask, 0, ir_current_bb)
                        }
                    }
                    return dest
                }
            }
        }
        ir_emit(ir_op, dest, lhs, rhs, 0, ir_current_bb)
        // ADD/SUB/MUL produce identical bits in two's complement, so the
        // signed flag is just metadata — propagate it so subsequent
        // compares like `(x - 1) < 0` still pick SCMP.
        if ir_vreg_signed_get(lhs) != 0 || ir_vreg_signed_get(rhs) != 0 {
            ir_vreg_signed_set(dest, 1)
        }
        return dest
    }

    // Compare (38)
    if kind == 38 {
        uint32 op_tok = ast_data1(node)
        uint32 lhs_node = ast_child(node)
        uint32 rhs_node = ast_data2(node)
        uint64 op_kind = tok_kind_at_raw(op_tok)
        // Check for struct comparison (== or !=)
        if op_kind == 35 || op_kind == 36 {
            uint64 lhs_si = 0xFFFFFFFF
            uint64 rhs_si = 0xFFFFFFFF
            uint64 wlhs_n = lhs_node
            uint64 wrhs_n = rhs_node
            if wlhs_n != 0 {
                uint32 lk = ast_kind(wlhs_n)
                if lk == 32 {
                    uint32 lt = ast_data1(wlhs_n)
                    uint64 wlt = lt
                    lhs_si = struct_var_lookup(wlt)
                }
            }
            if lhs_si != 0xFFFFFFFF && wrhs_n != 0 {
                uint32 rk = ast_kind(wrhs_n)
                if rk == 32 {
                    uint32 rt = ast_data1(wrhs_n)
                    uint64 wrt = rt
                    rhs_si = struct_var_lookup(wrt)
                }
            }
            if lhs_si != 0xFFFFFFFF && rhs_si != 0xFFFFFFFF {
                // Struct comparison: memcmp both pointers
                uint64 lhs = ir_lower_expr(lhs_node)
                uint64 rhs = ir_lower_expr(rhs_node)
                uint64 ssize = struct_total_size(lhs_si)
                uint64 eq_v = ir_new_vreg()
                ir_emit(IR_MEMCMP, eq_v, lhs, rhs, ssize, ir_current_bb)
                if op_kind == 36 {
                    // != : invert the result
                    uint64 zero_v = ir_new_vreg()
                    ir_emit(IR_CONST, zero_v, 0, 0, 0, ir_current_bb)
                    uint64 ne_v = ir_new_vreg()
                    ir_emit(IR_CMP_EQ, ne_v, eq_v, zero_v, 0, ir_current_bb)
                    return ne_v
                }
                return eq_v
            }
        }
        uint64 lhs = ir_lower_expr(lhs_node)
        uint64 rhs = ir_lower_expr(rhs_node)
        uint64 dest = ir_new_vreg()
        // Check if LHS is float-typed
        uint64 cmp_fk = ir_vreg_fkind_get(lhs)
        if ir_fkind_is_float(cmp_fk) != 0 {
            // Float compare: operands must share an fkind or ucomiss/ucomisd
            // reads the wrong bit width. `f32 a == 1.0` previously compared
            // a 32-bit f32 (0x3F800000) against the low 32 bits of an f64
            // (which are zero for 1.0), so the equality always failed.
            // Widen the narrower side to f64 — no loss, and it matches the
            // C-style promotion users expect.
            uint64 rhs_fk = ir_vreg_fkind_get(rhs)
            if cmp_fk == 2 && rhs_fk == 1 {
                uint64 lhs_w = ir_new_vreg()
                ir_emit(IR_F32TOF64, lhs_w, lhs, 0, 0, ir_current_bb)
                ir_vreg_fkind_set(lhs_w, 1)
                lhs = lhs_w
                cmp_fk = 1
            } else if cmp_fk == 1 && rhs_fk == 2 {
                uint64 rhs_w = ir_new_vreg()
                ir_emit(IR_F32TOF64, rhs_w, rhs, 0, 0, ir_current_bb)
                ir_vreg_fkind_set(rhs_w, 1)
                rhs = rhs_w
            }
            uint64 ir_op = IR_FCMP_EQ
            if op_kind == 35 { ir_op = IR_FCMP_EQ }  // ==
            if op_kind == 36 { ir_op = IR_FCMP_NE }  // !=
            if op_kind == 37 { ir_op = IR_FCMP_LT }  // <
            if op_kind == 38 { ir_op = IR_FCMP_LE }  // <=
            if op_kind == 39 { ir_op = IR_FCMP_GT }  // >
            if op_kind == 40 { ir_op = IR_FCMP_GE }  // >=
            ir_emit(ir_op, dest, lhs, rhs, cmp_fk, ir_current_bb)
            return dest
        }
        // Signed-aware ordering compares. Equality stays bitwise (signedness
        // doesn't change == / !=). For <, <=, >, >=, if either side carries
        // the signed flag, emit IR_SCMP_* — otherwise unsigned IR_CMP_*.
        uint64 lhs_signed = ir_vreg_signed_get(lhs)
        uint64 rhs_signed = ir_vreg_signed_get(rhs)
        uint64 use_signed = 0
        if lhs_signed != 0 { use_signed = 1 }
        if rhs_signed != 0 { use_signed = 1 }
        uint64 ir_op = IR_CMP_EQ
        if op_kind == 35 { ir_op = IR_CMP_EQ }  // ==
        if op_kind == 36 { ir_op = IR_CMP_NE }  // !=
        if op_kind == 37 {
            if use_signed != 0 { ir_op = IR_SCMP_LT } else { ir_op = IR_CMP_LT }
        }
        if op_kind == 38 {
            if use_signed != 0 { ir_op = IR_SCMP_LE } else { ir_op = IR_CMP_LE }
        }
        if op_kind == 39 {
            if use_signed != 0 { ir_op = IR_SCMP_GT } else { ir_op = IR_CMP_GT }
        }
        if op_kind == 40 {
            if use_signed != 0 { ir_op = IR_SCMP_GE } else { ir_op = IR_CMP_GE }
        }
        ir_emit(ir_op, dest, lhs, rhs, 0, ir_current_bb)
        return dest
    }

    // UnaryOp (34)
    if kind == 34 {
        uint32 op_tok = ast_data1(node)
        uint32 operand = ast_child(node)
        uint64 src = ir_lower_expr(operand)
        uint64 dest = ir_new_vreg()
        uint64 op_kind = tok_kind_at_raw(op_tok)
        if op_kind == 31 {
            // - (negate). For floats, lower as FSUB(0.0, src) — IR_NEG does
            // integer two's-complement which corrupts IEEE 754 bits.
            uint64 src_fk = ir_vreg_fkind_get(src)
            if ir_fkind_is_float(src_fk) != 0 {
                uint64 fzero = ir_new_vreg()
                ir_emit(IR_CONST, fzero, 0, 0, 0, ir_current_bb)
                ir_vreg_fkind_set(fzero, src_fk)
                ir_emit(IR_FSUB, dest, fzero, src, src_fk, ir_current_bb)
                ir_vreg_fkind_set(dest, src_fk)
            } else {
                ir_emit(IR_NEG, dest, src, 0, 0, ir_current_bb)
            }
        } else if op_kind == 27 {
            // ! (logical NOT) — compare src == 0
            uint64 zero = ir_new_vreg()
            ir_emit(IR_CONST, zero, 0, 0, 0, ir_current_bb)
            ir_emit(IR_CMP_EQ, dest, src, zero, 0, ir_current_bb)
        } else if op_kind == 26 {
            // ~ (bitwise NOT)
            ir_emit(IR_NOT, dest, src, 0, 0, ir_current_bb)
        } else {
            ir_emit(IR_COPY, dest, src, 0, 0, ir_current_bb)
        }
        return dest
    }

    // Call (35)
    if kind == 35 {
        uint32 callee_tok = ast_data1(node)
        uint64 wct = callee_tok
        // @builtin_override: a user fn that deliberately shadows a built-in
        // must win at every call site, so the whole builtin-matching chain
        // below is disabled for registered names and the call falls through
        // to the normal user-call (IR_CALL) path. Mirrors the extern-fn
        // shadowing gate in the legacy backends.
        uint64 skip_builtin = builtin_override_lookup(wct)
        // Check for exit() builtin
        if skip_builtin == 0 && tok_matches(wct, "exit", 4) != 0 {
            // riscv32 (target_arch 2) and xtensa (target_arch 3) are EXEMPT:
            // both ship a working bare-metal exit() that the spec preserves --
            // riscv32 stores the sifive_test magic word at 0x00100000 and then
            // ebreaks (ir_riscv.kr, op 52), xtensa issues an lx60 semihosting
            // SIMCALL (ir_xtensa.kr, op 52, and xt_simcall permits exactly the
            // name "exit" for this reason). Neither reaches a kernel, so
            // neither contradicts --target=none. x86_64 and arm64 have no such
            // lowering: there, exit() is a syscall and nothing else.
            if target_os == 4 && (target_arch == 0 || target_arch == 1) {
                uint64 bmx = "exit"
                bare_metal_builtin_refused(bmx, "end main with `loop { }` instead -- there is no parent process to return a status to")
            }
            uint32 arg = ast_child(node)
            uint64 av = ir_lower_expr(arg)
            ir_emit(IR_ARG, 0, av, 0, 0, ir_current_bb)
            uint64 dest = ir_new_vreg()
            ir_emit_syscall(dest, 231, ir_current_bb, "exit")
            return dest
        }
        // write(fd, buf, len) → syscall 1
        if skip_builtin == 0 && tok_matches(wct, "write", 5) != 0 {
            if target_os == 4 {
                uint64 bmw = "write"
                bare_metal_builtin_refused(bmw, bm_fix_write())
            }
            uint32 arg1 = ast_child(node)
            uint64 fd = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 buf = ir_lower_expr(arg2)
            uint32 arg3 = ast_next(arg2)
            uint64 len = ir_lower_expr(arg3)
            ir_emit(IR_ARG, 0, fd, 0, 0, ir_current_bb)
            ir_emit(IR_ARG, 0, buf, 0, 1, ir_current_bb)
            ir_emit(IR_ARG, 0, len, 0, 2, ir_current_bb)
            uint64 dest = ir_new_vreg()
            ir_emit_syscall(dest, 1, ir_current_bb, "write")
            return dest
        }
        // alloc(size) → IR_ALLOC
        if skip_builtin == 0 && tok_matches(wct, "alloc", 5) != 0 {
            if target_os == 4 {
                uint64 bma = "alloc"
                bare_metal_builtin_refused(bma, "supply a bare-metal allocator with @builtin_override, or use static storage instead of a heap -- alloc() is mmap/VirtualAlloc and there is no kernel to serve it")
            }
            uint32 arg1 = ast_child(node)
            uint64 size_v = ir_lower_expr(arg1)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_ALLOC, dest, size_v, 0, 0, ir_current_bb)
            return dest
        }
        // dealloc(ptr) → IR_DEALLOC
        if skip_builtin == 0 && tok_matches(wct, "dealloc", 7) != 0 {
            if target_os == 4 {
                uint64 bmd = "dealloc"
                bare_metal_builtin_refused(bmd, "supply a bare-metal allocator with @builtin_override, or use static storage instead of a heap -- dealloc() is munmap/VirtualFree and there is no kernel to serve it")
            }
            uint32 arg1 = ast_child(node)
            uint64 ptr_v = ir_lower_expr(arg1)
            ir_emit(IR_DEALLOC, 0, ptr_v, 0, 0, ir_current_bb)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_CONST, dest, 0, 0, 0, ir_current_bb)
            return dest
        }
        // store64(ptr, val) → IR_STORE
        if skip_builtin == 0 && tok_matches(wct, "store64", 7) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 ptr_v = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 val_v = ir_lower_expr(arg2)
            ir_emit(IR_STORE, 8, ptr_v, val_v, 0, ir_current_bb)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_CONST, dest, 0, 0, 0, ir_current_bb)
            return dest
        }
        // load64(ptr) → IR_LOAD
        if skip_builtin == 0 && tok_matches(wct, "load64", 6) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 ptr_v = ir_lower_expr(arg1)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_LOAD, dest, ptr_v, 0, 8, ir_current_bb)
            return dest
        }
        // store32(ptr, val) → IR_STORE width 4
        if skip_builtin == 0 && tok_matches(wct, "store32", 7) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 ptr_v = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 val_v = ir_lower_expr(arg2)
            ir_emit(IR_STORE, 4, ptr_v, val_v, 0, ir_current_bb)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_CONST, dest, 0, 0, 0, ir_current_bb)
            return dest
        }
        // load32(ptr) → IR_LOAD width 4
        if skip_builtin == 0 && tok_matches(wct, "load32", 6) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 ptr_v = ir_lower_expr(arg1)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_LOAD, dest, ptr_v, 0, 4, ir_current_bb)
            return dest
        }
        // store8(ptr, val) → IR_STORE width 1
        if skip_builtin == 0 && tok_matches(wct, "store8", 6) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 ptr_v = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 val_v = ir_lower_expr(arg2)
            ir_emit(IR_STORE, 1, ptr_v, val_v, 0, ir_current_bb)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_CONST, dest, 0, 0, 0, ir_current_bb)
            return dest
        }
        // load8(ptr) → IR_LOAD width 1
        if skip_builtin == 0 && tok_matches(wct, "load8", 5) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 ptr_v = ir_lower_expr(arg1)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_LOAD, dest, ptr_v, 0, 1, ir_current_bb)
            return dest
        }
        // store16(ptr, val) → IR_STORE width 2
        if skip_builtin == 0 && tok_matches(wct, "store16", 7) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 ptr_v = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 val_v = ir_lower_expr(arg2)
            ir_emit(IR_STORE, 2, ptr_v, val_v, 0, ir_current_bb)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_CONST, dest, 0, 0, 0, ir_current_bb)
            return dest
        }
        // load16(ptr) → IR_LOAD width 2
        if skip_builtin == 0 && tok_matches(wct, "load16", 6) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 ptr_v = ir_lower_expr(arg1)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_LOAD, dest, ptr_v, 0, 2, ir_current_bb)
            return dest
        }
