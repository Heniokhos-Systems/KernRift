            uint8 ld_rex = 0x40
            if dr >= 8 { ld_rex = ld_rex | 4 }
            if addr_reg >= 8 { ld_rex = ld_rex | 1 }
            if ld_rex != 0x40 { emit_byte(ld_rex) }
            emit_byte(0x0F)
            emit_byte(0xB6)
            uint64 ld_modrm = ((dr & 7) << 3) | (addr_reg & 7)
            if (addr_reg & 7) == 4 {
                uint8 ldm = ld_modrm
                emit_byte(ldm)
                emit_byte(0x24)
            } else if (addr_reg & 7) == 5 {
                uint8 ldm = ld_modrm | 0x40
                emit_byte(ldm)
                emit_byte(0)
            } else {
                uint8 ldm = ld_modrm
                emit_byte(ldm)
            }
        }
        if dst_r == 0xFFFFFFFF {
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 31 {
        // IR_STORE: *(src1) = src2, width in dest field (1, 4, or 8)
        uint64 addr_reg = ir_resolve_src(s1_v, 0)
        uint64 val_reg = ir_resolve_src(s2_v, 1)
        uint64 width = dest_v
        if width == 8 {
            // mov [addr_reg], val_reg: REX.W 89 modrm
            uint8 st_rex = 0x48
            if val_reg >= 8 { st_rex = st_rex | 4 }
            if addr_reg >= 8 { st_rex = st_rex | 1 }
            emit_byte(st_rex)
            emit_byte(0x89)
            uint64 st_modrm = ((val_reg & 7) << 3) | (addr_reg & 7)
            if (addr_reg & 7) == 4 {
                uint8 stm = st_modrm
                emit_byte(stm)
                emit_byte(0x24)
            } else if (addr_reg & 7) == 5 {
                uint8 stm = st_modrm | 0x40
                emit_byte(stm)
                emit_byte(0)
            } else {
                uint8 stm = st_modrm
                emit_byte(stm)
            }
        } else if width == 4 {
            // mov [addr_reg], val_reg32: no REX.W
            uint8 st_rex = 0x40
            if val_reg >= 8 { st_rex = st_rex | 4 }
            if addr_reg >= 8 { st_rex = st_rex | 1 }
            if st_rex != 0x40 { emit_byte(st_rex) }
            emit_byte(0x89)
            uint64 st_modrm = ((val_reg & 7) << 3) | (addr_reg & 7)
            if (addr_reg & 7) == 4 {
                uint8 stm = st_modrm
                emit_byte(stm)
                emit_byte(0x24)
            } else if (addr_reg & 7) == 5 {
                uint8 stm = st_modrm | 0x40
                emit_byte(stm)
                emit_byte(0)
            } else {
                uint8 stm = st_modrm
                emit_byte(stm)
            }
        } else if width == 2 {
            // 2-byte store: mov [addr_reg], val_reg16: 66 REX? 89 modrm
            emit_byte(0x66)
            uint8 st_rex = 0x40
            if val_reg >= 8 { st_rex = st_rex | 4 }
            if addr_reg >= 8 { st_rex = st_rex | 1 }
            if st_rex != 0x40 { emit_byte(st_rex) }
            emit_byte(0x89)
            uint64 st_modrm = ((val_reg & 7) << 3) | (addr_reg & 7)
            if (addr_reg & 7) == 4 {
                uint8 stm = st_modrm
                emit_byte(stm)
                emit_byte(0x24)
            } else if (addr_reg & 7) == 5 {
                uint8 stm = st_modrm | 0x40
                emit_byte(stm)
                emit_byte(0)
            } else {
                uint8 stm = st_modrm
                emit_byte(stm)
            }
