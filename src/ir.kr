    }

    if op == 43 {
        // IR_RET_VOID: zero rax (default exit code for void main) then
        // jmp to epilogue. Function-local void returns are unaffected:
        // the caller doesn't read rax.
        // @naked: no epilogue to jump to — see IR_RET above.
        if ir_x86_naked_fn != 0 { return }
        emit_byte(0x48); emit_byte(0x31); emit_byte(0xC0)   // xor rax, rax
        emit_byte(0xE9)
        uint64 rfp = ir_ret_fixups + ir_ret_fixup_count * 4
        uint32 rpo = out_len
        unsafe { *(rfp as uint32) = rpo }
        ir_ret_fixup_count = ir_ret_fixup_count + 1
        emit_u32_le(0)
        return
    }

    if op == 61 {
        // IR_COPY: if src1 != 0, it's a reg-reg copy; if src1 == 0, it's a param load
        if s1_v != 0 {
            // Float fast path: if either side has an XMM home, move
            // within the FP file (movaps / movq / movsd) instead of
            // bouncing through rax. This is also the mixed-class
            // coalesce guarantee: a copy connecting an XMM-homed f64 to
            // a GPR-resident value emits a REAL movq here, so the two
            // register classes never silently alias.
            uint64 cp_xs = ir_x86_xmm_home(s1_v)
            uint64 cp_xd = ir_x86_xmm_home(dest_v)
            if cp_xs != 0xFFFFFFFF || cp_xd != 0xFFFFFFFF {
                uint64 cpx = ir_resolve_src_x(s1_v, 0)
                ir_store_dest_x(dest_v, cpx)
                return
            }
            // Regular copy
            uint64 src_reg = ir_resolve_src(s1_v, 0)
            if dst_r != 0xFFFFFFFF {
                ir_emit_mov_r64_r64(dst_r, src_reg)
            } else {
                ir_emit_mov_r64_r64(0, src_reg)
                ir_emit_store_spill(0, dest_v)
            }
        } else {
            // Param init: imm = param index
            // SysV ABI param regs: rdi(7), rsi(6), rdx(2), rcx(1), r8(8), r9(9)
            uint64 pr = 7
            if imm == 1 { pr = 6 }
            if imm == 2 { pr = 2 }
            if imm == 3 { pr = 1 }
            if imm == 4 { pr = 8 }
            if imm == 5 { pr = 9 }
            if imm < 6 {
                if dst_r != 0xFFFFFFFF {
                    ir_emit_mov_r64_r64(dst_r, pr)
                } else {
                    ir_emit_mov_r64_r64(0, pr)
                    ir_emit_store_spill(0, dest_v)
                }
            }
            if imm >= 100 {
                // ASM output: read from physical register (imm - 100)
                uint64 phys_src = imm - 100
                if dst_r != 0xFFFFFFFF {
                    ir_emit_mov_r64_r64(dst_r, phys_src)
                } else {
                    ir_emit_mov_r64_r64(0, phys_src)
                    ir_emit_store_spill(0, dest_v)
                }
            } else if imm >= 6 {
                // Overflow parameter: load from caller's stack.
                // Stack layout: [rsp + frame_size + callee_save_bytes
                //                    + 8(ret_addr) + (imm-6)*8]
                uint64 overflow_off = ir_frame_size + ir_callee_save_bytes + 8 + (imm - 6) * 8
                uint64 tgt = 0
                if dst_r != 0xFFFFFFFF { tgt = dst_r }
                // mov tgt, [rsp + overflow_off]
                uint8 ov_rex = 0x48
                if tgt >= 8 { ov_rex = ov_rex | 4 }
                emit_byte(ov_rex)
                emit_byte(0x8B)
                if overflow_off < 128 {
                    uint8 ovm = 0x44 | ((tgt & 7) << 3)
                    emit_byte(ovm)
                    emit_byte(0x24)
                    uint8 ovo = overflow_off
                    emit_byte(ovo)
                } else {
                    uint8 ovm = 0x84 | ((tgt & 7) << 3)
                    emit_byte(ovm)
                    emit_byte(0x24)
                    emit_u32_le(overflow_off)
                }
                if dst_r == 0xFFFFFFFF {
                    ir_emit_store_spill(0, dest_v)
                }
            }
        }
        return
    }

    if op == 51 {
        // IR_ARG: move src to the correct argument register
        // SysV ABI: rdi(7), rsi(6), rdx(2), rcx(1), r8(8), r9(9)
        uint64 target = ir_x86_arg_reg(imm)
        if imm < 6 {
            if ir_x86_naked_fn != 0 {
                // @naked: the colour file is caller-saved, so an argument
                // register can be a live vreg's home and the sequential
                // moves below would shuffle-clobber. Emit the whole group
                // through the stack instead.
                ir_emit_call_arg_group(ii)
                return
            }
            uint64 src_reg = ir_resolve_src(s1_v, 0)
            ir_emit_mov_r64_r64(target, src_reg)
        }
        if imm >= 100 {
            // ASM input constraint: `in(var -> reg)`. A contiguous run of these
            // needs a shuffle-safe emission order — a naive sequential
            // `mov target, src_reg` clobbers a source register before a later
            // move reads it (e.g. `in(a -> rdi), in(b -> rsi)` where b's vreg
            // was allocated to rdi). Emit the whole group via push/pop so the
            // ordering is bulletproof regardless of what regalloc chose.
            ir_emit_asm_in_group(ii)
            return
        } else if imm >= 6 {
            // Overflow arg: save vreg to overflow buffer for IR_CALL to handle
            uint64 oi = imm - 6
            if oi < 32 {
                uint64 op_ptr = ir_overflow_args + oi * 8
                uint64 sv = s1_v
                unsafe { *(op_ptr as uint64) = sv }
                if oi >= ir_overflow_arg_count { ir_overflow_arg_count = oi + 1 }
            }
        }
        return
    }

    if op == 52 {
        // IR_SYSCALL: dispatch by target_os
        if target_os == 2 {
            ir_emit_x86_win_syscall(imm, dest_v, dst_r)
            return
        }
        // Linux (0), macOS (1), Android (3): raw syscall with OS-specific numbers
        uint64 real_nr = ir_x86_syscall_nr(imm)
        ir_emit_mov_r64_imm64(0, real_nr)
        // Name the builtin that lowered to this IR_SYSCALL, not the IR op:
        // imm alone cannot distinguish write() from file_write() from print().
        // Falls back to a generic label if nothing was recorded -- never a
        // guessed name (see ir_insn_origin, ir.kr).
        uint64 sc_who = ir_insn_origin_at(ii)
        if sc_who == 0 { sc_who = "an unnamed syscall lowering" }
        emit_x86_syscall_insn(sc_who)
        if dst_r != 0xFFFFFFFF && dst_r != 0 {
            ir_emit_mov_r64_r64(dst_r, 0)
        }
        if dst_r == 0xFFFFFFFF {
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 50 {
        // IR_CALL: call rel32 (will be resolved by fixup system)
        // src1 = arg_count (0 for old-style calls with <=6 args)
        uint64 call_arg_count = s1_v
        uint64 stack_args = 0
        if call_arg_count > 6 {
            stack_args = call_arg_count - 6
            // Resolve all overflow arg values BEFORE modifying rsp
            // Use sub rsp + mov [rsp+N] approach instead of push to avoid
            // spill offset issues (push changes rsp, making subsequent resolves wrong)
            uint64 aligned_stack = stack_args
            if (aligned_stack & 1) != 0 { aligned_stack = aligned_stack + 1 }
            uint64 stack_bytes = aligned_stack * 8
            // First, resolve all overflow args into a temp buffer (physical values)
            uint64[16] ov_vals
            uint64 oi = 0
            while oi < ir_overflow_arg_count {
                uint64 op_ptr = ir_overflow_args + oi * 8
                uint64 arg_vreg = 0
                unsafe { *(op_ptr as uint64) -> arg_vreg }
                uint64 arg_r = ir_resolve_src(arg_vreg, 0)
                ir_emit_mov_r64_r64(0, arg_r)
                // Store rax value to the temp buf position on the current (unmodified) stack
                // Actually we can't use a temp buffer easily. Use a different approach:
                // resolve to rax and push immediately. The key insight: spill offsets are
                // relative to current rsp. After each push, rsp decreases by 8, so subsequent
                // resolves need adjusted offsets. Instead, let's just resolve all to rax and
                // push in one pass, going from LAST to FIRST. But each push changes rsp...

                // Better approach: sub rsp first, then use mov [rsp+N] with adjusted offsets
                oi = oi + 1
            }
            // Simpler approach: sub rsp, then store. Adjust resolve offsets manually.
            // sub rsp, stack_bytes — imm8 form fits up to 127; switch to
            // imm32 for larger allocations so calls with >16 stack args
            // don't wrap the signed-byte immediate silently.
            if stack_bytes < 128 {
                emit_byte(0x48); emit_byte(0x83); emit_byte(0xEC)
                uint8 sb8 = stack_bytes
                emit_byte(sb8)
            } else {
                emit_byte(0x48); emit_byte(0x81); emit_byte(0xEC)
                emit_u32_le(stack_bytes)
            }
            // Now rsp has shifted down. Spill slots are now at rsp + stack_bytes + original_offset
            // We need to re-resolve each overflow arg with the shifted rsp
            oi = 0
            while oi < ir_overflow_arg_count {
                uint64 op_ptr = ir_overflow_args + oi * 8
                uint64 arg_vreg = 0
                unsafe { *(op_ptr as uint64) -> arg_vreg }
                // The vreg might be in a register (fine) or spilled.
                // If spilled, the spill is at [old_rsp + spill_off] = [new_rsp + stack_bytes + spill_off]
                // We need to adjust the spill load. Let's just check the physical reg:
                uint64 arg_r = ir_get_phys_reg(arg_vreg)
                // XMM-homed f64 arg: this is the one emitter that reads
                // spill slots directly instead of via the funnels, so it
                // needs its own home check — the slot of a homed vreg is
                // never written. Pull the bits into rax and let the
                // register path below store them to the outgoing slot.
                if arg_r == 0xFFFFFFFF {
                    uint64 arg_xh = ir_x86_xmm_home(arg_vreg)
                    if arg_xh != 0xFFFFFFFF {
                        ir_emit_movq_r_x(0, arg_xh)
                        arg_r = 0
                    }
                }
                if arg_r != 0xFFFFFFFF {
                    // Value is in a register — just mov to [rsp + oi*8]
                    uint64 soff = oi * 8
                    uint8 st_rex = 0x48
                    if arg_r >= 8 { st_rex = st_rex | 4 }
                    emit_byte(st_rex); emit_byte(0x89)
                    if soff == 0 {
                        uint8 stm = ((arg_r & 7) << 3) | 4
                        emit_byte(stm); emit_byte(0x24)
                    } else if soff < 128 {
                        uint8 stm = 0x44 | ((arg_r & 7) << 3)
                        emit_byte(stm); emit_byte(0x24)
                        uint8 so8 = soff
                        emit_byte(so8)
                    } else {
                        uint8 stm = 0x84 | ((arg_r & 7) << 3)
                        emit_byte(stm); emit_byte(0x24)
                        emit_u32_le(soff)
                    }
                } else {
                    // Value is spilled — need to load from adjusted offset
                    // Original spill at [rsp + spill_off], now at [rsp + stack_bytes + spill_off]
                    // (must mirror ir_spill_offset's one-slot-per-vreg mapping)
                    uint64 spill_off = (arg_vreg - 1) * 8
                    uint64 adj_off = stack_bytes + spill_off
                    // mov rax, [rsp + adj_off]
                    emit_byte(0x48); emit_byte(0x8B)
                    if adj_off < 128 {
                        emit_byte(0x44); emit_byte(0x24)
                        uint8 ao8 = adj_off
                        emit_byte(ao8)
                    } else {
                        emit_byte(0x84); emit_byte(0x24)
                        emit_u32_le(adj_off)
                    }
                    // mov [rsp + oi*8], rax
                    uint64 soff = oi * 8
                    emit_byte(0x48); emit_byte(0x89)
                    if soff == 0 {
                        emit_byte(0x04); emit_byte(0x24)
                    } else if soff < 128 {
                        emit_byte(0x44); emit_byte(0x24)
                        uint8 so8 = soff
                        emit_byte(so8)
                    } else {
                        emit_byte(0x84); emit_byte(0x24)
                        emit_u32_le(soff)
                    }
                }
                oi = oi + 1
            }
        }
        emit_byte(0xE8)
        uint64 call_patch = out_len
        emit_u32_le(0)
        // Record fixup: imm holds the callee token
        fixup_table_ensure()
        uint64 fentry = fixup_table + fixup_count * 8
        uint32 fo = call_patch
        unsafe { *(fentry as uint32) = fo }
        uint64 fe4 = fentry + 4
        uint32 ct = imm
        unsafe { *(fe4 as uint32) = ct }
        fixup_count = fixup_count + 1
        // Clean up overflow args from stack
        if stack_args > 0 {
            uint64 aligned_stack = stack_args
            if (aligned_stack & 1) != 0 { aligned_stack = aligned_stack + 1 }
            uint64 cleanup = aligned_stack * 8
            if cleanup < 128 {
                emit_byte(0x48); emit_byte(0x83); emit_byte(0xC4)
                uint8 cl8 = cleanup
                emit_byte(cl8)
            } else {
                emit_byte(0x48); emit_byte(0x81); emit_byte(0xC4)
                emit_u32_le(cleanup)
            }
        }
        // Reset overflow arg count
        ir_overflow_arg_count = 0
        // Result in rax. A statement-level call (`f()` as an ExprStmt) still
        // gets a dest vreg from the lowering, and capturing rax into it wrote
        // a register nobody reads — dead everywhere, and in a @naked body it
        // was the reported `mov %rax,%rbx` that corrupted the interrupted
        // function. The legacy backend never emitted it. Skip it when the
        // vreg has no readers; ir_use_count_get is conservative (returns 255
        // for anything past the counted range), so a wrong answer can only
        // keep the old instruction, never drop a live one.
        if ir_use_count_get(dest_v) != 0 {
            if dst_r != 0xFFFFFFFF && dst_r != 0 {
                ir_emit_mov_r64_r64(dst_r, 0)
            }
            if dst_r == 0xFFFFFFFF {
                ir_emit_store_spill(0, dest_v)
            }
        }
        return
    }

    if op == 85 {
        // IR_SYSCALL_RAW: src1 = nr vreg, args already in rdi/rsi/rdx/rcx/r8/r9
        // Syscall uses r10 for arg3 (not rcx), so move rcx -> r10
        // mov r10, rcx (49 89 CA)
        emit_byte(0x49); emit_byte(0x89); emit_byte(0xCA)
        // Move nr to rax
        uint64 nr_r = ir_resolve_src(s1_v, 0)
        ir_emit_mov_r64_r64(0, nr_r)
        // syscall
        emit_x86_syscall_insn("syscall_raw")
        // Result in rax
        if dst_r != 0xFFFFFFFF && dst_r != 0 {
            ir_emit_mov_r64_r64(dst_r, 0)
        }
        if dst_r == 0xFFFFFFFF {
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 86 {
        // IR_FN_ADDR: lea rax, [rip + disp32] — disp resolved by fnaddr fixup
        // Emit: 48 8D 05 disp32
        emit_byte(0x48); emit_byte(0x8D); emit_byte(0x05)
        uint64 fnaddr_patch = out_len
        emit_u32_le(0)
        // Record in fnaddr fixup table
        fnaddr_fixups_ensure()
        if fnaddr_fixup_count < fnaddr_fixup_cap {
            uint64 fentry_fa = fnaddr_fixup_table + fnaddr_fixup_count * 8
            uint32 fa_off = fnaddr_patch
            unsafe { *(fentry_fa as uint32) = fa_off }
            uint64 fe4_fa = fentry_fa + 4
            uint32 fa_tok = imm
            unsafe { *(fe4_fa as uint32) = fa_tok }
            fnaddr_fixup_count = fnaddr_fixup_count + 1
        }
        // Result in rax
        if dst_r != 0xFFFFFFFF && dst_r != 0 {
            ir_emit_mov_r64_r64(dst_r, 0)
        }
        if dst_r == 0xFFFFFFFF {
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 87 {
        // IR_CALL_IND: call through function pointer in src1.
        // imm == 1 means the callee returns f64 in xmm0; we move the
        // xmm0 bits into the dest GPR via `movq r64, xmm0`
        // (66 REX.W 0F 7E /r) so BinOp/StoreF64 downstream see the
        // right bit pattern. imm == 0 is the integer-return path.
        uint64 ptr_r = ir_resolve_src(s1_v, 0)
        ir_emit_mov_r64_r64(0, ptr_r)
        // call rax: FF D0
        emit_byte(0xFF); emit_byte(0xD0)
        // Unread result: emit no capture at all (see IR_CALL above). Checked
        // before the f64 movq, which would otherwise write dst_r for nothing.
        if ir_use_count_get(dest_v) == 0 { return }
        uint64 result_reg = 0   // rax for int return
        if imm == 1 {
            // movq dst_r (or rax if spilled), xmm0
            uint64 target = dst_r
            if target == 0xFFFFFFFF { target = 0 }
            uint8 mq_rex = 0x48
            if target >= 8 { mq_rex = mq_rex | 0x01 }
            emit_byte(0x66); emit_byte(mq_rex)
            emit_byte(0x0F); emit_byte(0x7E)
            uint8 mq_mod = 0xC0 | ((0 & 7) << 3) | (target & 7)
            emit_byte(mq_mod)
            result_reg = target
        }
        // For int return, the result is already in rax. For f64 we
        // just moved xmm0 → (dst_r or rax). Either way, if the dest
        // vreg got a physical reg and it's not the result_reg, copy.
        if dst_r != 0xFFFFFFFF && dst_r != result_reg {
            ir_emit_mov_r64_r64(dst_r, result_reg)
        }
        if dst_r == 0xFFFFFFFF {
            // result is in result_reg; spill to dest_v's slot. For
            // the f64 path we already wrote to rax (result_reg=0);
            // for int path it was always rax.
            ir_emit_store_spill(result_reg, dest_v)
        }
        return
    }

    if op == 88 {
        // IR_MEMCMP: compare imm bytes at [src1] vs [src2], result 1 if equal, 0 if not
        uint64 mc_a = ir_resolve_src(s1_v, 0)
        uint64 mc_b = ir_resolve_src(s2_v, 1)
        ir_emit_mov_r64_r64(6, mc_a)    // rsi = ptr_a
        ir_emit_mov_r64_r64(7, mc_b)    // rdi = ptr_b
        // Load byte count
        ir_emit_mov_r64_imm64(1, imm)   // rcx = count in bytes
        // Compare qword-by-qword, then remaining bytes
        // Start with result = 1 (assume equal)
        // xor eax, eax (31 C0)
        emit_byte(0x31); emit_byte(0xC0)
        // mov eax, 1 (B8 01 00 00 00)
        emit_byte(0xB8); emit_byte(0x01); emit_byte(0x00); emit_byte(0x00); emit_byte(0x00)
        // .loop: test rcx, rcx
        uint64 mc_loop = out_len
        emit_byte(0x48); emit_byte(0x85); emit_byte(0xC9)
        // jz .done
        emit_byte(0x74)
        uint64 mc_jz_off = out_len
        emit_byte(0)
        // cmp rcx, 8
        emit_byte(0x48); emit_byte(0x83); emit_byte(0xF9); emit_byte(0x08)
        // jb .byte_cmp
        emit_byte(0x72)
        uint64 mc_jb_off = out_len
        emit_byte(0)
        // qword compare: mov r10, [rsi]
        emit_byte(0x4C); emit_byte(0x8B); emit_byte(0x16)
        // cmp r10, [rdi]
        emit_byte(0x4C); emit_byte(0x3B); emit_byte(0x17)
        // jne .not_equal
        emit_byte(0x75)
        uint64 mc_jne1_off = out_len
        emit_byte(0)
        // add rsi, 8; add rdi, 8; sub rcx, 8
        emit_byte(0x48); emit_byte(0x83); emit_byte(0xC6); emit_byte(0x08)
        emit_byte(0x48); emit_byte(0x83); emit_byte(0xC7); emit_byte(0x08)
        emit_byte(0x48); emit_byte(0x83); emit_byte(0xE9); emit_byte(0x08)
        // jmp .loop
        emit_byte(0xEB)
        uint64 mc_jmp_back = mc_loop - out_len - 1
        uint8 mc_jb8 = mc_jmp_back
        emit_byte(mc_jb8)
        // .byte_cmp:
        uint64 mc_byte = out_len
        uint64 mc_byte_disp = mc_byte - mc_jb_off - 1
        uint8 mc_bd = mc_byte_disp
        uint64 mc_patch_jb = out_buf + mc_jb_off
        unsafe { *(mc_patch_jb as uint8) = mc_bd }
        // movzx r10d, byte [rsi]
        emit_byte(0x44); emit_byte(0x0F); emit_byte(0xB6); emit_byte(0x16)
        // movzx r11d, byte [rdi]  (44 0F B6 1F)
        emit_byte(0x44); emit_byte(0x0F); emit_byte(0xB6); emit_byte(0x1F)
        // cmp r10d, r11d (45 39 DA)
        emit_byte(0x45); emit_byte(0x39); emit_byte(0xDA)
        // jne .not_equal
        emit_byte(0x75)
        uint64 mc_jne2_off = out_len
        emit_byte(0)
        // inc rsi; inc rdi; dec rcx
        emit_byte(0x48); emit_byte(0xFF); emit_byte(0xC6)
        emit_byte(0x48); emit_byte(0xFF); emit_byte(0xC7)
        emit_byte(0x48); emit_byte(0xFF); emit_byte(0xC9)
        // jmp .loop
        emit_byte(0xEB)
        uint64 mc_jmp_back2 = mc_loop - out_len - 1
        uint8 mc_jb82 = mc_jmp_back2
        emit_byte(mc_jb82)
        // .not_equal: xor eax, eax (result = 0)
        uint64 mc_ne = out_len
        // Patch jne1 and jne2
        uint64 mc_ne1_disp = mc_ne - mc_jne1_off - 1
        uint8 mc_ned1 = mc_ne1_disp
        uint64 mc_p1 = out_buf + mc_jne1_off
        unsafe { *(mc_p1 as uint8) = mc_ned1 }
        uint64 mc_ne2_disp = mc_ne - mc_jne2_off - 1
        uint8 mc_ned2 = mc_ne2_disp
        uint64 mc_p2 = out_buf + mc_jne2_off
        unsafe { *(mc_p2 as uint8) = mc_ned2 }
        emit_byte(0x31); emit_byte(0xC0)
        // jmp .done (skip the equal path)
        emit_byte(0xEB); emit_byte(0x00)
        // .done:
        uint64 mc_done = out_len
        // Patch jz to .done
        uint64 mc_done_disp = mc_done - mc_jz_off - 1
        uint8 mc_dd = mc_done_disp
        uint64 mc_p3 = out_buf + mc_jz_off
        unsafe { *(mc_p3 as uint8) = mc_dd }
        if dst_r != 0xFFFFFFFF {
            ir_emit_mov_r64_r64(dst_r, 0)
        } else {
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 96 {
        // IR_ASM_BLOCK: emit inline assembly from AST node
        // src1 = AST node index
        uint64 asm_node = s1_v
        uint32 single_tok = ast_data1(asm_node)
        uint64 ws = single_tok
        if ws != 0 {
            asm_emit_x86(ws)
        }
        uint32 child_str = ast_child(asm_node)
        uint64 wcs = child_str
        while wcs != 0 {
            uint32 stk = ast_data1(wcs)
            uint64 wstk = stk
            asm_emit_x86(wstk)
            uint32 nxt = ast_next(wcs)
            wcs = nxt
        }
        return
    }

    if op == 90 {
        // IR_ATOMIC_STORE: lock xchg [ptr], val
        uint64 ptr_r = ir_resolve_src(s1_v, 0)
        uint64 val_r = ir_resolve_src(s2_v, 1)
        // lock xchg [ptr_r], val_r: F0 REX.W 87 modrm
        emit_byte(0xF0)
        uint8 as_rex = 0x48
        if val_r >= 8 { as_rex = as_rex | 4 }
        if ptr_r >= 8 { as_rex = as_rex | 1 }
        emit_byte(as_rex)
        emit_byte(0x87)
        uint8 as_modrm = ((val_r & 7) << 3) | (ptr_r & 7)
        if (ptr_r & 7) == 4 {
            emit_byte(as_modrm); emit_byte(0x24)
        } else if (ptr_r & 7) == 5 {
            uint8 asm5 = as_modrm | 0x40
