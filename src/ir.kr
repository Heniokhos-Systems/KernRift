            ir_emit(IR_ARG, 0, one_v, 0, 2, ir_current_bb)
            uint64 wr2 = ir_new_vreg()
            ir_emit_syscall(wr2, 1, ir_current_bb, "println_str")
            ir_emit(IR_DEALLOC, 0, nlbuf, 0, 0, ir_current_bb)
            uint64 zero = ir_new_vreg()
            ir_emit(IR_CONST, zero, 0, 0, 0, ir_current_bb)
            return zero
        }
        // read(fd, buf, len) → syscall 0
        if skip_builtin == 0 && tok_matches(wct, "read", 4) != 0 {
            if target_os == 4 {
                uint64 bmr = "read"
                bare_metal_builtin_refused(bmr, bm_fix_io())
            }
            uint32 arg1 = ast_child(node)
            uint64 fd = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 buf = ir_lower_expr(arg2)
            uint32 arg3 = ast_next(arg2)
            uint64 len = ir_lower_expr(arg3)
            ir_emit(IR_ARG, 0, fd, 0, 0, ir_current_bb)
            ir_emit(IR_ARG, 0, buf, 0, 1, ir_current_bb)
            ir_emit(IR_ARG, 0, len, 0, 2, ir_current_bb)
            uint64 dest = ir_new_vreg()
            ir_emit_syscall(dest, 0, ir_current_bb, "read")
            return dest
        }
        // memcpy(dst, src, len) → IR_MEMCPY
        if skip_builtin == 0 && tok_matches(wct, "memcpy", 6) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 dst_v = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 src_v = ir_lower_expr(arg2)
            uint32 arg3 = ast_next(arg2)
            uint64 len_v = ir_lower_expr(arg3)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_MEMCPY, dest, dst_v, src_v, len_v, ir_current_bb)
            return dest
        }
        // memset(dst, val, len) → IR_MEMSET
        if skip_builtin == 0 && tok_matches(wct, "memset", 6) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 dst_v = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 val_v = ir_lower_expr(arg2)
            uint32 arg3 = ast_next(arg2)
            uint64 len_v = ir_lower_expr(arg3)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_MEMSET, dest, dst_v, val_v, len_v, ir_current_bb)
            return dest
        }
        // str_len(s) → IR_STRLEN
        if skip_builtin == 0 && tok_matches(wct, "str_len", 7) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 str_v = ir_lower_expr(arg1)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_STRLEN, dest, str_v, 0, 0, ir_current_bb)
            return dest
        }
        // fmt_uint(buf, val) → IR_FMT_UINT
        if skip_builtin == 0 && tok_matches(wct, "fmt_uint", 8) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 buf_v = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 val_v = ir_lower_expr(arg2)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_FMT_UINT, dest, buf_v, val_v, 0, ir_current_bb)
            return dest
        }
        // str_eq(a, b) → IR_STR_EQ
        // Signed comparison builtins
        if skip_builtin == 0 && tok_matches(wct, "signed_lt", 9) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 a_v = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 b_v = ir_lower_expr(arg2)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_SCMP_LT, dest, a_v, b_v, 0, ir_current_bb)
            return dest
        }
        if skip_builtin == 0 && tok_matches(wct, "signed_gt", 9) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 a_v = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 b_v = ir_lower_expr(arg2)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_SCMP_GT, dest, a_v, b_v, 0, ir_current_bb)
            return dest
        }
        if skip_builtin == 0 && tok_matches(wct, "signed_le", 9) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 a_v = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 b_v = ir_lower_expr(arg2)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_SCMP_LE, dest, a_v, b_v, 0, ir_current_bb)
            return dest
        }
        if skip_builtin == 0 && tok_matches(wct, "signed_ge", 9) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 a_v = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 b_v = ir_lower_expr(arg2)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_SCMP_GE, dest, a_v, b_v, 0, ir_current_bb)
            return dest
        }

        // file_open/file_close/file_read/file_write builtins
        if skip_builtin == 0 && tok_matches(wct, "file_open", 9) != 0 {
            if target_os == 4 {
                uint64 bmfo = "file_open"
                bare_metal_builtin_refused(bmfo, bm_fix_nofs())
            }
            uint32 arg1 = ast_child(node)
            uint64 path_v = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 mode_v = ir_lower_expr(arg2)
            // mode: 0=read(O_RDONLY), 1=write(O_WRONLY|O_CREAT|O_TRUNC).
            // Flags differ per OS — 0x241 on Linux/Android, 0x601 on macOS
            // (O_CREAT=0x40 vs 0x200, O_TRUNC=0x200 vs 0x400). On Windows
            // the IR syscall-2 handler only tests zero/nonzero, so either
            // value works there. Baking a single constant here and relying
            // on the backend was the macOS file_open bug.
            uint64 write_flags = 577          // 0x241 — Linux/Android
            if target_os == 1 { write_flags = 1537 }   // 0x601 — macOS
            uint64 flags_v = ir_new_vreg()
            uint64 zero_v = ir_new_vreg()
            ir_emit(IR_CONST, zero_v, 0, 0, 0, ir_current_bb)
            uint64 cmp_v = ir_new_vreg()
            ir_emit(IR_CMP_EQ, cmp_v, mode_v, zero_v, 0, ir_current_bb)
            // flags = mode * write_flags  (mode=0 → 0, mode=1 → write_flags)
            uint64 magic_v = ir_new_vreg()
            ir_emit(IR_CONST, magic_v, 0, 0, write_flags, ir_current_bb)
            ir_emit(IR_MUL, flags_v, mode_v, magic_v, 0, ir_current_bb)
            // syscall 2 = open(path, flags, 0644)
            uint64 perm_v = ir_new_vreg()
            ir_emit(IR_CONST, perm_v, 0, 0, 420, ir_current_bb)
            ir_emit(IR_ARG, 0, path_v, 0, 0, ir_current_bb)
            ir_emit(IR_ARG, 0, flags_v, 0, 1, ir_current_bb)
            ir_emit(IR_ARG, 0, perm_v, 0, 2, ir_current_bb)
            uint64 dest = ir_new_vreg()
            ir_emit_syscall(dest, 2, ir_current_bb, "file_open")
            return dest
        }
        if skip_builtin == 0 && tok_matches(wct, "file_close", 10) != 0 {
            if target_os == 4 {
                uint64 bmfc = "file_close"
                bare_metal_builtin_refused(bmfc, bm_fix_nofs())
            }
            uint32 arg1 = ast_child(node)
            uint64 fd_v = ir_lower_expr(arg1)
            ir_emit(IR_ARG, 0, fd_v, 0, 0, ir_current_bb)
            uint64 dest = ir_new_vreg()
            ir_emit_syscall(dest, 3, ir_current_bb, "file_close")
            return dest
        }
        if skip_builtin == 0 && tok_matches(wct, "file_write", 10) != 0 {
            if target_os == 4 {
                uint64 bmfw = "file_write"
                bare_metal_builtin_refused(bmfw, bm_fix_nofs())
            }
            uint32 arg1 = ast_child(node)
            uint64 fd_v = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 buf_v = ir_lower_expr(arg2)
            uint32 arg3 = ast_next(arg2)
            uint64 len_v = ir_lower_expr(arg3)
            ir_emit(IR_ARG, 0, fd_v, 0, 0, ir_current_bb)
            ir_emit(IR_ARG, 0, buf_v, 0, 1, ir_current_bb)
            ir_emit(IR_ARG, 0, len_v, 0, 2, ir_current_bb)
            uint64 dest = ir_new_vreg()
            ir_emit_syscall(dest, 1, ir_current_bb, "file_write")
            return dest
        }
        if skip_builtin == 0 && tok_matches(wct, "file_read", 9) != 0 {
            if target_os == 4 {
                uint64 bmfr = "file_read"
                bare_metal_builtin_refused(bmfr, bm_fix_nofs())
            }
            uint32 arg1 = ast_child(node)
            uint64 fd_v = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 buf_v = ir_lower_expr(arg2)
            uint32 arg3 = ast_next(arg2)
            uint64 len_v = ir_lower_expr(arg3)
            ir_emit(IR_ARG, 0, fd_v, 0, 0, ir_current_bb)
            ir_emit(IR_ARG, 0, buf_v, 0, 1, ir_current_bb)
            ir_emit(IR_ARG, 0, len_v, 0, 2, ir_current_bb)
            uint64 dest = ir_new_vreg()
            ir_emit_syscall(dest, 0, ir_current_bb, "file_read")
            return dest
        }

        // file_size(fd) — lseek(fd, 0, SEEK_END) then lseek(fd, 0, SEEK_SET)
        if skip_builtin == 0 && tok_matches(wct, "file_size", 9) != 0 {
            if target_os == 4 {
                uint64 bmfs = "file_size"
                bare_metal_builtin_refused(bmfs, bm_fix_nofs())
            }
            uint32 arg1 = ast_child(node)
            uint64 fd_v = ir_lower_expr(arg1)
            uint64 zero_v = ir_new_vreg()
            ir_emit(IR_CONST, zero_v, 0, 0, 0, ir_current_bb)
            uint64 two_v = ir_new_vreg()
            ir_emit(IR_CONST, two_v, 0, 0, 2, ir_current_bb)
            // lseek(fd, 0, SEEK_END=2) -> size
            ir_emit(IR_ARG, 0, fd_v, 0, 0, ir_current_bb)
            ir_emit(IR_ARG, 0, zero_v, 0, 1, ir_current_bb)
            ir_emit(IR_ARG, 0, two_v, 0, 2, ir_current_bb)
            uint64 size_v = ir_new_vreg()
            ir_emit_syscall(size_v, 8, ir_current_bb, "file_size")
            // lseek(fd, 0, SEEK_SET=0) -> rewind
            ir_emit(IR_ARG, 0, fd_v, 0, 0, ir_current_bb)
            ir_emit(IR_ARG, 0, zero_v, 0, 1, ir_current_bb)
            ir_emit(IR_ARG, 0, zero_v, 0, 2, ir_current_bb)
            uint64 dummy = ir_new_vreg()
            ir_emit_syscall(dummy, 8, ir_current_bb, "file_size")
            return size_v
        }

        // print(arg, ...) / println(arg, ...) — variadic, space-separated args
        if skip_builtin == 0 && (tok_matches(wct, "println", 7) != 0 || tok_matches(wct, "print", 5) != 0) {
            uint64 is_println = tok_matches(wct, "println", 7)
            // Refusing here is the whole reason this function exists. The
            // lowering below ALLOCATES a 4096-byte formatting buffer before it
            // writes anything, so IR_ALLOC reached the trap emitter first and
            // Task 2's guard reported `from 'alloc'` for a program whose
            // source contains no alloc() at all. Naming the builtin the
            // programmer actually wrote is what makes the diagnostic
            // actionable.
            if target_os == 4 {
                uint64 pr_wtok = ir_bm_write_provider()
                if pr_wtok == 0xFFFFFFFF {
                    uint64 bmpr = "print"
                    if is_println != 0 { bmpr = "println" }
                    bare_metal_builtin_refused(bmpr, bm_fix_write())
                }
                ir_lower_print_bare_metal(node, is_println, pr_wtok)
                uint64 pr_zero = ir_new_vreg()
                ir_emit(IR_CONST, pr_zero, 0, 0, 0, ir_current_bb)
                return pr_zero
            }
            uint64 buf_v = ir_new_vreg()
            ir_emit(IR_ALLOC, buf_v, 0, 0, 4096, ir_current_bb)
            uint64 off_v = ir_new_vreg()
            ir_emit(IR_CONST, off_v, 0, 0, 0, ir_current_bb)

            uint32 warg = ast_child(node)
            uint64 first = 1
            while warg != 0 {
                if first == 0 {
                    // Write space separator between arguments
                    uint64 space_v = ir_new_vreg()
                    ir_emit(IR_CONST, space_v, 0, 0, 32, ir_current_bb)
                    uint64 sp_addr = ir_new_vreg()
                    ir_emit(IR_ADD, sp_addr, buf_v, off_v, 0, ir_current_bb)
                    ir_emit(IR_STORE, 1, sp_addr, space_v, 0, ir_current_bb)
                    uint64 one_sp = ir_new_vreg()
                    ir_emit(IR_CONST, one_sp, 0, 0, 1, ir_current_bb)
                    uint64 off_sp = ir_new_vreg()
                    ir_emit(IR_ADD, off_sp, off_v, one_sp, 0, ir_current_bb)
                    off_v = off_sp
                }
                first = 0

                uint64 slot_v = ir_new_vreg()
                ir_emit(IR_ADD, slot_v, buf_v, off_v, 0, ir_current_bb)

                uint32 arg_kind = ast_kind(warg)
                uint64 len_v = ir_new_vreg()
                if arg_kind == 31 || arg_kind == 50 {
                    // String literal or FString: lower to pointer, then STRLEN + MEMCPY
                    uint64 s_v = ir_lower_expr(warg)
                    ir_emit(IR_STRLEN, len_v, s_v, 0, 0, ir_current_bb)
                    uint64 mc_dummy = ir_new_vreg()
                    ir_emit(IR_MEMCPY, mc_dummy, slot_v, s_v, len_v, ir_current_bb)
                } else {
                    // Typed value: dispatch on float-kind
                    uint64 val_v = ir_lower_expr(warg)
                    uint64 fk = ir_vreg_fkind_get(val_v)
                    if fk == 1 {
                        // f64
                        ir_emit(IR_FMT_F64, len_v, slot_v, val_v, 0, ir_current_bb)
                    } else if fk == 2 {
                        // f32 -> promote to f64 first
                        uint64 f64v = ir_new_vreg()
                        ir_emit(IR_F32TOF64, f64v, val_v, 0, 0, ir_current_bb)
                        ir_vreg_fkind_set(f64v, 1)
                        ir_emit(IR_FMT_F64, len_v, slot_v, f64v, 0, ir_current_bb)
                    } else if fk == 3 {
                        // bool
                        ir_emit(IR_FMT_BOOL, len_v, slot_v, val_v, 0, ir_current_bb)
                    } else if fk == 4 {
                        // char -> single byte
                        ir_emit(IR_STORE, 1, slot_v, val_v, 0, ir_current_bb)
                        ir_emit(IR_CONST, len_v, 0, 0, 1, ir_current_bb)
                    } else if ir_vreg_signed_get(val_v) != 0 {
                        // Signed integer — same branchless sign handling as
                        // the FString lowering below; see the comment there.
                        // This is the variadic print path (println("n=", n)),
                        // which had the identical bug.
                        uint64 pv_63 = ir_new_vreg()
                        ir_emit(IR_CONST, pv_63, 0, 0, 63, ir_current_bb)
                        uint64 pv_sign = ir_new_vreg()
                        ir_emit(IR_SAR, pv_sign, val_v, pv_63, 0, ir_current_bb)
                        uint64 pv_one = ir_new_vreg()
                        ir_emit(IR_CONST, pv_one, 0, 0, 1, ir_current_bb)
                        uint64 pv_adv = ir_new_vreg()
                        ir_emit(IR_AND, pv_adv, pv_sign, pv_one, 0, ir_current_bb)
                        uint64 pv_xor = ir_new_vreg()
                        ir_emit(IR_XOR, pv_xor, val_v, pv_sign, 0, ir_current_bb)
                        uint64 pv_abs = ir_new_vreg()
                        ir_emit(IR_SUB, pv_abs, pv_xor, pv_sign, 0, ir_current_bb)
                        uint64 pv_minus = ir_new_vreg()
                        ir_emit(IR_CONST, pv_minus, 0, 0, 45, ir_current_bb)
                        ir_emit(IR_STORE, 1, slot_v, pv_minus, 0, ir_current_bb)
                        uint64 pv_slot2 = ir_new_vreg()
                        ir_emit(IR_ADD, pv_slot2, slot_v, pv_adv, 0, ir_current_bb)
                        uint64 pv_dlen = ir_new_vreg()
                        ir_emit(IR_FMT_UINT, pv_dlen, pv_slot2, pv_abs, 0, ir_current_bb)
                        ir_emit(IR_ADD, len_v, pv_dlen, pv_adv, 0, ir_current_bb)
                    } else {
                        // integer
                        ir_emit(IR_FMT_UINT, len_v, slot_v, val_v, 0, ir_current_bb)
                    }
                }

                uint64 off_next = ir_new_vreg()
                ir_emit(IR_ADD, off_next, off_v, len_v, 0, ir_current_bb)
                off_v = off_next

                uint32 nxt = ast_next(warg)
                warg = nxt
            }

            if is_println != 0 {
                // Append newline
                uint64 nl_v = ir_new_vreg()
                ir_emit(IR_CONST, nl_v, 0, 0, 10, ir_current_bb)
                uint64 nl_addr = ir_new_vreg()
                ir_emit(IR_ADD, nl_addr, buf_v, off_v, 0, ir_current_bb)
                ir_emit(IR_STORE, 1, nl_addr, nl_v, 0, ir_current_bb)
                uint64 one_nl = ir_new_vreg()
                ir_emit(IR_CONST, one_nl, 0, 0, 1, ir_current_bb)
                uint64 off_nl = ir_new_vreg()
                ir_emit(IR_ADD, off_nl, off_v, one_nl, 0, ir_current_bb)
                off_v = off_nl
            }

            uint64 fd_v = ir_new_vreg()
            ir_emit(IR_CONST, fd_v, 0, 0, 1, ir_current_bb)
            ir_emit(IR_ARG, 0, fd_v, 0, 0, ir_current_bb)
            ir_emit(IR_ARG, 0, buf_v, 0, 1, ir_current_bb)
            ir_emit(IR_ARG, 0, off_v, 0, 2, ir_current_bb)
            uint64 wr = ir_new_vreg()
            // print() and println() share this lowering (println just appends a
            // newline to the same buffer), so name whichever one was written.
            uint64 pr_builtin = "print"
            if is_println != 0 { pr_builtin = "println" }
            ir_emit_syscall(wr, 1, ir_current_bb, pr_builtin)
            ir_emit(IR_DEALLOC, 0, buf_v, 0, 0, ir_current_bb)
            uint64 zero = ir_new_vreg()
            ir_emit(IR_CONST, zero, 0, 0, 0, ir_current_bb)
            return zero
        }

        if skip_builtin == 0 && tok_matches(wct, "str_eq", 6) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 a_v = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 b_v = ir_lower_expr(arg2)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_STR_EQ, dest, a_v, b_v, 0, ir_current_bb)
            return dest
        }

        // syscall_raw(nr, a0, a1, a2, a3, a4, a5) → raw Linux syscall
        if skip_builtin == 0 && tok_matches(wct, "syscall_raw", 11) != 0 {
            // The one builtin whose entire purpose is to trap into a kernel,
            // so there is no @builtin_override advice to give -- the remedy is
            // inline asm, which --target=none deliberately still permits (see
            // emit_x86_syscall_insn in src/codegen.kr).
            if target_os == 4 {
                uint64 bmsr = "syscall_raw"
                bare_metal_builtin_refused(bmsr, "there is no kernel to trap into; use inline asm if the target really needs that raw instruction")
            }
            // Evaluate all 7 args
            uint64[7] sc_vregs
            uint32 sc_arg = ast_child(node)
            uint64 sc_warg = sc_arg
            uint64 sc_i = 0
            while sc_warg != 0 && sc_i < 7 {
                uint64 sv = ir_lower_expr(sc_warg)
                uint64 svp = sc_vregs + sc_i * 8
                unsafe { *(svp as uint64) = sv }
                sc_i = sc_i + 1
                uint32 sc_nxt = ast_next(sc_warg)
                sc_warg = sc_nxt
            }
            // Emit IR_ARG for data args (positions 0-5 = a0-a5)
            uint64 sci = 0
            while sci < 6 && sci + 1 < sc_i {
                uint64 svp = sc_vregs + (sci + 1) * 8
                uint64 sv = 0
                unsafe { *(svp as uint64) -> sv }
                ir_emit(IR_ARG, 0, sv, 0, sci, ir_current_bb)
                sci = sci + 1
            }
            // First arg is syscall number
            uint64 nr_vp = sc_vregs
            uint64 nr_v = 0
            unsafe { *(nr_vp as uint64) -> nr_v }
            uint64 dest = ir_new_vreg()
            ir_emit(IR_SYSCALL_RAW, dest, nr_v, 0, 0, ir_current_bb)
            return dest
        }

        // bit_get(val, pos) → (val >> pos) & 1
        if skip_builtin == 0 && tok_matches(wct, "bit_get", 7) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 val_v = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 pos_v = ir_lower_expr(arg2)
            uint64 shifted = ir_new_vreg()
            ir_emit(IR_SHR, shifted, val_v, pos_v, 0, ir_current_bb)
            uint64 one_v = ir_new_vreg()
            ir_emit(IR_CONST, one_v, 0, 0, 1, ir_current_bb)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_AND, dest, shifted, one_v, 0, ir_current_bb)
            return dest
        }

        // bit_set(val, pos) → val | (1 << pos)
        if skip_builtin == 0 && tok_matches(wct, "bit_set", 7) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 val_v = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 pos_v = ir_lower_expr(arg2)
            uint64 one_v = ir_new_vreg()
            ir_emit(IR_CONST, one_v, 0, 0, 1, ir_current_bb)
            uint64 mask_v = ir_new_vreg()
            ir_emit(IR_SHL, mask_v, one_v, pos_v, 0, ir_current_bb)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_OR, dest, val_v, mask_v, 0, ir_current_bb)
            return dest
        }

        // bit_clear(val, pos) → val & ~(1 << pos)
        if skip_builtin == 0 && tok_matches(wct, "bit_clear", 9) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 val_v = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 pos_v = ir_lower_expr(arg2)
            uint64 one_v = ir_new_vreg()
            ir_emit(IR_CONST, one_v, 0, 0, 1, ir_current_bb)
            uint64 mask_v = ir_new_vreg()
            ir_emit(IR_SHL, mask_v, one_v, pos_v, 0, ir_current_bb)
            uint64 nmask_v = ir_new_vreg()
            ir_emit(IR_NOT, nmask_v, mask_v, 0, 0, ir_current_bb)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_AND, dest, val_v, nmask_v, 0, ir_current_bb)
            return dest
        }

        // bit_toggle(val, pos) → val ^ (1 << pos)
        if skip_builtin == 0 && tok_matches(wct, "bit_toggle", 10) != 0 {
            uint32 arg1 = ast_child(node)
            uint64 val_v = ir_lower_expr(arg1)
            uint32 arg2 = ast_next(arg1)
            uint64 pos_v = ir_lower_expr(arg2)
            uint64 one_v = ir_new_vreg()
            ir_emit(IR_CONST, one_v, 0, 0, 1, ir_current_bb)
            uint64 mask_v = ir_new_vreg()
            ir_emit(IR_SHL, mask_v, one_v, pos_v, 0, ir_current_bb)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_XOR, dest, val_v, mask_v, 0, ir_current_bb)
            return dest
        }

        // fn_addr("name") → address of named function
        if skip_builtin == 0 && tok_matches(wct, "fn_addr", 7) != 0 {
            uint32 name_arg = ast_child(node)
            uint64 wna = name_arg
            uint32 str_tok = ast_data1(wna)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_FN_ADDR, dest, 0, 0, str_tok, ir_current_bb)
            return dest
        }

        // call_ptr(fn_ptr, args...)      — indirect call, int return (rax)
        // call_ptr_f64(fn_ptr, args...)   — indirect call, f64 return (xmm0)
        //
        // The SysV ABI returns floats in xmm0, ints in rax; plain
        // `call_ptr` copies rax into the dest vreg, which silently
        // loses the float bits for f64-returning callees. The
        // `_f64` variant emits `movq dst, xmm0` after the call so
        // the f64 bit pattern lands in the GPR the dest vreg
        // occupies. Use it any time the callee was declared
        // `-> f64`; otherwise prefer the plain `call_ptr`.
        uint64 is_call_ptr = 0
        uint64 is_call_ptr_f64 = 0
        if skip_builtin == 0 && tok_matches(wct, "call_ptr", 8) != 0 { is_call_ptr = 1 }
        if skip_builtin == 0 && tok_matches(wct, "call_ptr_f64", 12) != 0 { is_call_ptr_f64 = 1 }
        if is_call_ptr != 0 || is_call_ptr_f64 != 0 {
            uint32 first_arg = ast_child(node)
            uint64 wfa = first_arg
            // First arg is the function pointer
            uint64 ptr_v = ir_lower_expr(wfa)
            // Remaining args are the actual call arguments
            uint64[6] cp_arg_vregs
            uint32 call_arg = ast_next(wfa)
            uint64 wca = call_arg
            uint64 cp_count = 0
            while wca != 0 && cp_count < 6 {
                uint64 av = ir_lower_expr(wca)
                uint64 avp = cp_arg_vregs + cp_count * 8
                unsafe { *(avp as uint64) = av }
                cp_count = cp_count + 1
                uint32 anxt = ast_next(wca)
                wca = anxt
            }
            // Without this guard, a 7th call_ptr argument is silently
            // dropped -- and not merely unpassed: cp_arg_vregs only holds 6
            // slots, so the 7th argument's ir_lower_expr result is simply
            // never collected and its side effects vanish. The direct-call
            // path (below, ~line 3426) has the equivalent guard; this
            // message is worded differently so the two are distinguishable.
            if wca != 0 {
                write(2, "error: too many call_ptr arguments (max 6)\n", 43)
                exit(1)
            }
            // Emit ARGs for call arguments
            uint64 cpi = 0
            while cpi < cp_count {
                uint64 avp = cp_arg_vregs + cpi * 8
                uint64 av = 0
                unsafe { *(avp as uint64) -> av }
                ir_emit(IR_ARG, 0, av, 0, cpi, ir_current_bb)
                cpi = cpi + 1
            }
            uint64 dest = ir_new_vreg()
            // imm=1 on IR_CALL_IND tells the x86 emitter to do
            // `movq dst, xmm0` instead of `mov dst, rax` after
            // the call. Also tag the dest vreg as f64 so BinOp
            // lowering picks FMUL/FADD downstream.
            uint64 f64_ret_flag = 0
            if is_call_ptr_f64 != 0 {
                f64_ret_flag = 1
                ir_vreg_fkind_set(dest, 1)
            }
            ir_emit(IR_CALL_IND, dest, ptr_v, 0, f64_ret_flag, ir_current_bb)
            return dest
        }

        // ---------------------------------------------------------------
        // Float builtins
        // ---------------------------------------------------------------

        // int_to_f64(x): convert integer to f64, return f64 bit pattern
        if skip_builtin == 0 && tok_matches(wct, "int_to_f64", 10) != 0 {
            uint32 first_arg = ast_child(node)
            uint64 src_v = ir_lower_expr(first_arg)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_ITOF, dest, src_v, 0, 0, ir_current_bb)
            ir_vreg_fkind_set(dest, 1)
            return dest
        }

        // f64_to_int(x): convert f64 bit pattern to integer
        if skip_builtin == 0 && tok_matches(wct, "f64_to_int", 10) != 0 {
            uint32 first_arg = ast_child(node)
            uint64 src_v = ir_lower_expr(first_arg)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_FTOI, dest, src_v, 0, 0, ir_current_bb)
            ir_vreg_fkind_set(dest, 0)
            // cvttsd2si is signed truncation, so the result is logically
            // a signed int — tag it so `if f64_to_int(x) < 0` works.
            ir_vreg_signed_set(dest, 1)
            return dest
        }

        // int_to_f32(x): convert integer to f32, return f32 bit pattern
        if skip_builtin == 0 && tok_matches(wct, "int_to_f32", 10) != 0 {
            uint32 first_arg = ast_child(node)
            uint64 src_v = ir_lower_expr(first_arg)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_ITOF32, dest, src_v, 0, 0, ir_current_bb)
            ir_vreg_fkind_set(dest, 2)
            return dest
        }

        // f32_to_int(x): convert f32 bit pattern to integer
        if skip_builtin == 0 && tok_matches(wct, "f32_to_int", 10) != 0 {
            uint32 first_arg = ast_child(node)
            uint64 src_v = ir_lower_expr(first_arg)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_FTOI32, dest, src_v, 0, 0, ir_current_bb)
            ir_vreg_fkind_set(dest, 0)
            return dest
        }

        // sqrt(x) / sqrt_f64(x): f64 square root
        if skip_builtin == 0 && (tok_matches(wct, "sqrt_f64", 8) != 0 || tok_matches(wct, "sqrt", 4) != 0) {
            uint32 first_arg = ast_child(node)
            uint64 src_v = ir_lower_expr(first_arg)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_FSQRT, dest, src_v, 0, 0, ir_current_bb)
            ir_vreg_fkind_set(dest, 1)
            return dest
        }

        // fma_f64(a, b, c): a*b + c in f64
        if skip_builtin == 0 && tok_matches(wct, "fma_f64", 7) != 0 {
            uint32 arg_a = ast_child(node)
            uint64 wa_a = arg_a
            uint32 arg_b = ast_next(wa_a)
            uint64 wa_b = arg_b
            uint32 arg_c = ast_next(wa_b)
            uint64 wa_c = arg_c
            uint64 a_v = ir_lower_expr(wa_a)
            uint64 b_v = ir_lower_expr(wa_b)
            uint64 c_v = ir_lower_expr(wa_c)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_FFMA, dest, a_v, b_v, c_v, ir_current_bb)
            ir_vreg_fkind_set(dest, 1)
            return dest
        }

        // f32_to_f64(x): widen f32 to f64
        if skip_builtin == 0 && tok_matches(wct, "f32_to_f64", 10) != 0 {
            uint32 first_arg = ast_child(node)
            uint64 src_v = ir_lower_expr(first_arg)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_F32TOF64, dest, src_v, 0, 0, ir_current_bb)
            ir_vreg_fkind_set(dest, 1)
            return dest
        }

        // f64_to_f32(x): narrow f64 to f32
        if skip_builtin == 0 && tok_matches(wct, "f64_to_f32", 10) != 0 {
            uint32 first_arg = ast_child(node)
            uint64 src_v = ir_lower_expr(first_arg)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_F64TOF32, dest, src_v, 0, 0, ir_current_bb)
            ir_vreg_fkind_set(dest, 2)
            return dest
        }

        // f32_to_f16(x): convert f32 bits to f16 bits (integer result)
        if skip_builtin == 0 && tok_matches(wct, "f32_to_f16", 10) != 0 {
            uint32 first_arg = ast_child(node)
            uint64 src_v = ir_lower_expr(first_arg)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_F32TOF16, dest, src_v, 0, 0, ir_current_bb)
            ir_vreg_fkind_set(dest, 0)
            return dest
        }

        // f16_to_f32(x): convert f16 bits to f32 bits
        if skip_builtin == 0 && tok_matches(wct, "f16_to_f32", 10) != 0 {
            uint32 first_arg = ast_child(node)
            uint64 src_v = ir_lower_expr(first_arg)
            uint64 dest = ir_new_vreg()
            ir_emit(IR_F16TOF32, dest, src_v, 0, 0, ir_current_bb)
            ir_vreg_fkind_set(dest, 2)
            return dest
        }

        // get_target_os() → compile-time OS constant
        // 0 linux, 1 macos, 2 windows, 3 android, 4 NONE (bare metal).
        // This folds target_os VERBATIM, so --target=none has always reported
        // 4 correctly and needs no arm here. Recorded explicitly because the
        // two builtins either side of it did NOT: a reader checking whether
        // this file handles target_os == 4 should not have to re-derive that
        // this one is safe, and a future edit that turns this into a per-OS
        // chain like its neighbours would reintroduce the defect silently.
        // tests/run_tests.sh pins the value at 4 on all four arches and on
        // both backends for exactly that reason.
        if skip_builtin == 0 && tok_matches(wct, "get_target_os", 13) != 0 {
            uint64 dest = ir_new_vreg()
            ir_emit(IR_CONST, dest, 0, 0, target_os, ir_current_bb)
            return dest
        }

        // get_arch_id() → compile-time arch ID.
        // Matches the legacy codegen IDs. Arch+OS crosstable:
        //   x86_64:  linux=1, windows=3, macos=5, android=8, NONE=9
        //   arm64:   linux=2, windows=4, macos=6, android=7, NONE=10
        //   riscv32: NONE=11        xtensa: NONE=12
        // target_arch is 0 x86_64, 1 arm64, 2 riscv32, 3 xtensa (from main.kr).
        //
        // WHY target_os == 4 NEEDS ITS OWN ARM. arch_id was initialised to 1
        // -- Linux x86_64 -- and only OVERRIDDEN for windows/macos/android, so
        // bare metal inherited the Linux answer. No syscall is emitted, so
        // Task 2's trap-instruction guards structurally could not see it, and
        // the builtin did not fail: it answered "you are running on Linux" to
        // a program with no kernel under it. Measured at 563b0f3: on x86_64
        // `sink = get_arch_id()` compiled byte-identical to `sink = 1`, and on
        // arm64 to `sink = 2`.
        //
        // The bare-metal ids are NEW VALUES (9..12), not a reuse of 1..8. Two
        // reasons. First, 1..8 are the KrboFat slice selectors (main.kr's
        // target_mask maps bit i to arch_id i+1) and reusing one would make a
        // bare-metal image indistinguishable from a hosted slice; 9..12 are
        // outside that space and a fat binary cannot contain a bare-metal
        // slice anyway (--target=none is refused from every entrance into
        // compile_fat). Second, the whole point is that bare metal is NOT an
        // OS, so it must not borrow an OS's id.
        //
        // CONSUMER NOTE: code that dispatches on arch_id with `== 2` meaning
        // "arm64" (src/living.kr:1213 does) sees 10 on a bare-metal arm64
        // build and takes the x86_64 branch. That is correct-by-refusal here
        // -- every such site in this tree is guarded by a syscall that
        // --target=none refuses first -- but user code doing the same must
        // add the none ids. docs/LANGUAGE.md documents them.
        if skip_builtin == 0 && tok_matches(wct, "get_arch_id", 11) != 0 {
            uint64 arch_id = 1
            if target_os == 4 {
                arch_id = 9
                if target_arch == 1 { arch_id = 10 }
                if target_arch == 2 { arch_id = 11 }
                if target_arch == 3 { arch_id = 12 }
            } else if target_arch == 1 {
                arch_id = 2
                if target_os == 2 { arch_id = 4 }
                if target_os == 1 { arch_id = 6 }
                if target_os == 3 { arch_id = 7 }
            } else {
                if target_os == 2 { arch_id = 3 }
                if target_os == 1 { arch_id = 5 }
                if target_os == 3 { arch_id = 8 }
            }
            uint64 dest = ir_new_vreg()
            ir_emit(IR_CONST, dest, 0, 0, arch_id, ir_current_bb)
            return dest
        }

        // General call: evaluate all arg exprs first, then emit ARGs + CALL
        // This prevents nested calls from clobbering arg registers.
        // Capacity is 32 args (6 register + up to 26 stack); pushing higher
        // also requires bumping ir_overflow_args / IR_ARG's oi guard below.
        uint64[32] call_arg_vregs
        uint32 arg = ast_child(node)
        uint64 warg = arg
        uint64 arg_count = 0
        // Method call: `self` (argument 0) is BY REFERENCE (LANGUAGE.md §7)
        // — pass the receiver's real address, never a copy.
        uint64 callee_is_method = fn_method_lookup(callee_tok)
        while warg != 0 && arg_count < 32 {
            // Reset the struct-expression tracker so a stale value left by
            // an earlier lowering can never be mistaken for this argument.
            ir_fa_struct_idx = 0xFFFFFFFF
            uint64 av = ir_lower_expr(warg)
            // Struct arguments are BY VALUE (value semantics, see the
            // 2026-04-14 struct-by-value design spec §9.2): the caller
            // passes a pointer to a fresh COPY, never to the original
            // storage. This must hold for EVERY expression form that
            // denotes a struct lvalue — a bare struct variable (Ident), a
            // nested-struct field (FieldAccess, which lowers to the field's
            // address), and a struct array element (Index, which lowers to
            // the element's address). Copying only the Ident form leaked
            // by-reference semantics for the other two.
            uint32 ak = ast_kind(warg)
            uint64 s_si = 0xFFFFFFFF
            if ak == 32 {
                uint32 atk = ast_data1(warg)
                s_si = struct_var_lookup(atk)
            }
            if ak == 36 || ak == 37 {
                // FieldAccess / Index lowering set ir_fa_struct_idx when
                // (and only when) the expression denotes a struct value;
                // av is then the struct's address in the caller's storage.
                s_si = ir_fa_struct_idx
            }
            if callee_is_method != 0 && arg_count == 0 {
                // Receiver stays a pointer to the caller's storage.
                s_si = 0xFFFFFFFF
            }
            if s_si != 0xFFFFFFFF {
                uint64 ssize = struct_total_size(s_si)
                uint64 copy_v = ir_new_vreg()
                ir_emit(IR_ALLOC, copy_v, 0, 0, ssize, ir_current_bb)
                uint64 sz_v = ir_new_vreg()
                ir_emit(IR_CONST, sz_v, 0, 0, ssize, ir_current_bb)
                ir_emit(IR_MEMCPY, 0, copy_v, av, sz_v, ir_current_bb)
                av = copy_v
            }
            ir_fa_struct_idx = 0xFFFFFFFF
            uint64 avp = call_arg_vregs + arg_count * 8
            unsafe { *(avp as uint64) = av }
            arg_count = arg_count + 1
            uint32 anxt = ast_next(warg)
            warg = anxt
        }
        if warg != 0 {
            write(2, "error: too many call arguments (max 32)\n", 40)
            exit(1)
        }
        // Now emit ARG instructions
        uint64 ai = 0
        while ai < arg_count {
            uint64 avp = call_arg_vregs + ai * 8
            uint64 av = 0
            unsafe { *(avp as uint64) -> av }
            ir_emit(IR_ARG, 0, av, 0, ai, ir_current_bb)
            ai = ai + 1
        }
        uint64 dest = ir_new_vreg()
        ir_emit(IR_CALL, dest, arg_count, 0, callee_tok, ir_current_bb)
        // Propagate the callee's declared float return kind onto the
        // result vreg. Without this, `some_f64_fn() * local_f64` sees
        // fkind=0 on the LHS and picks IR_MUL (integer) instead of
        // IR_FMUL (mulsd), silently producing garbage. Works because
        // float bits live in GPRs throughout (see IR_FMUL codegen),
        // so fkind only gates op selection, not register class.
        uint64 ret_fk_call = fn_ret_float_lookup(callee_tok)
        if ret_fk_call != 0 { ir_vreg_fkind_set(dest, ret_fk_call) }
        // Same idea for signedness: tag the result vreg when the callee
        // returns a signed integer. Without it the BinOp lowering saw an
        // unsigned operand and picked SHR/DIV/MOD instead of SAR/SDIV/SMOD,
        // so `neg() >> 1`, `neg() / 3` and `neg() % 3` were silently wrong
        // for negative values (while `i32 c = neg(); c >> 1` was correct).
        if fn_ret_signed_lookup(callee_tok) != 0 { ir_vreg_signed_set(dest, 1) }
        // Check if callee returns a struct (small, <=16 bytes, via rax/rdx)
        uint64 ret_si = fn_ret_struct_lookup(callee_tok)
        if ret_si != 0xFFFFFFFF {
            uint64 ret_ssize = struct_total_size(ret_si)
            // Allocate buffer and store rax into first 8 bytes
            uint64 buf_v = ir_new_vreg()
            ir_emit(IR_ALLOC, buf_v, 0, 0, ret_ssize, ir_current_bb)
            // Zero-initialize
            uint64 zero_v = ir_new_vreg()
            ir_emit(IR_CONST, zero_v, 0, 0, 0, ir_current_bb)
            uint64 ret_sz_v = ir_new_vreg()
            ir_emit(IR_CONST, ret_sz_v, 0, 0, ret_ssize, ir_current_bb)
            ir_emit(IR_MEMSET, 0, buf_v, zero_v, ret_sz_v, ir_current_bb)
            // Store first 8 bytes (rax)
            ir_emit(IR_STORE, 8, buf_v, dest, 0, ir_current_bb)
            if ret_ssize > 8 {
                // Extract rdx and store second 8 bytes
                uint64 rdx_v = ir_new_vreg()
                ir_emit(IR_EXTRACT_RDX, rdx_v, 0, 0, 0, ir_current_bb)
                uint64 off8_v = ir_new_vreg()
                ir_emit(IR_CONST, off8_v, 0, 0, 8, ir_current_bb)
                uint64 addr2_v = ir_new_vreg()
                ir_emit(IR_ADD, addr2_v, buf_v, off8_v, 0, ir_current_bb)
                ir_emit(IR_STORE, 8, addr2_v, rdx_v, 0, ir_current_bb)
            }
            return buf_v
        }
        return dest
    }

    // SizeofLit (49)
    if kind == 49 {
        uint32 sz = ast_data1(node)
        uint64 val = sz
        uint64 dest = ir_new_vreg()
        ir_emit(IR_CONST, dest, 0, 0, val, ir_current_bb)
        return dest
    }

    // LogicalAnd (39): short-circuit
    // result = 0 initially; if lhs != 0, result = rhs
    if kind == 39 {
        uint32 lhs_node = ast_child(node)
        uint32 rhs_idx = ast_data2(node)
        uint64 result = ir_new_vreg()
        ir_emit(IR_CONST, result, 0, 0, 0, ir_current_bb)
        uint64 lhs = ir_lower_expr(lhs_node)
        uint64 bb_rhs = ir_new_bb()
        uint64 bb_merge = ir_new_bb()
        ir_emit(IR_BR_COND, 0, lhs, 0, bb_rhs, ir_current_bb)
        ir_bb_set_succ(ir_current_bb, bb_merge, bb_rhs)
        ir_current_bb = bb_rhs
        uint64 rhs = ir_lower_expr(rhs_idx)
        ir_emit(IR_COPY, result, rhs, 0, 0, ir_current_bb)
        ir_emit(IR_BR, 0, 0, 0, bb_merge, ir_current_bb)
        ir_bb_set_succ(ir_current_bb, bb_merge, 0xFFFFFFFF)
        ir_current_bb = bb_merge
        return result
    }

    // LogicalOr (40): short-circuit
    // result = 1 initially; if lhs == 0, result = rhs
    if kind == 40 {
        uint32 lhs_node = ast_child(node)
        uint32 rhs_idx = ast_data2(node)
        uint64 result = ir_new_vreg()
        ir_emit(IR_CONST, result, 0, 0, 1, ir_current_bb)
        uint64 lhs = ir_lower_expr(lhs_node)
        uint64 bb_rhs = ir_new_bb()
        uint64 bb_merge = ir_new_bb()
        // If lhs is nonzero, skip rhs (result stays 1)
        ir_emit(IR_BR_COND, 0, lhs, 0, bb_merge, ir_current_bb)
        ir_bb_set_succ(ir_current_bb, bb_rhs, bb_merge)
        ir_current_bb = bb_rhs
        uint64 rhs = ir_lower_expr(rhs_idx)
        ir_emit(IR_COPY, result, rhs, 0, 0, ir_current_bb)
        ir_emit(IR_BR, 0, 0, 0, bb_merge, ir_current_bb)
        ir_bb_set_succ(ir_current_bb, bb_merge, 0xFFFFFFFF)
        ir_current_bb = bb_merge
        return result
    }

    // TernaryOp (53): cond ? then : else
    // child=cond, data1=then_expr, data2=else_expr. Lowers to a branch with
    // both arms writing the result vreg, then merging — same shape as the
    // short-circuit operators above but with an explicit else block.
    if kind == 53 {
        uint32 cond_node = ast_child(node)
        uint32 then_idx = ast_data1(node)
        uint32 else_idx = ast_data2(node)
        uint64 result = ir_new_vreg()
        uint64 condv = ir_lower_expr(cond_node)
        uint64 bb_then = ir_new_bb()
        uint64 bb_else = ir_new_bb()
        uint64 bb_merge = ir_new_bb()
        ir_emit(IR_BR_COND, 0, condv, 0, bb_then, ir_current_bb)
        ir_bb_set_succ(ir_current_bb, bb_else, bb_then)
        ir_current_bb = bb_then
        uint64 thenv = ir_lower_expr(then_idx)
        // Propagate the value's type metadata to the shared result vreg, else
        // float arithmetic / signed compares on a ternary value are wrong.
        uint64 t_fk = ir_vreg_fkind_get(thenv)
        if t_fk != 0 { ir_vreg_fkind_set(result, t_fk) }
        if ir_vreg_signed_get(thenv) != 0 { ir_vreg_signed_set(result, 1) }
        ir_emit(IR_COPY, result, thenv, 0, 0, ir_current_bb)
        ir_emit(IR_BR, 0, 0, 0, bb_merge, ir_current_bb)
        ir_bb_set_succ(ir_current_bb, bb_merge, 0xFFFFFFFF)
        ir_current_bb = bb_else
        uint64 elsev = ir_lower_expr(else_idx)
        ir_emit(IR_COPY, result, elsev, 0, 0, ir_current_bb)
        ir_emit(IR_BR, 0, 0, 0, bb_merge, ir_current_bb)
        ir_bb_set_succ(ir_current_bb, bb_merge, 0xFFFFFFFF)
        ir_current_bb = bb_merge
        return result
    }

    // MatchExpr (54): match scrutinee { pat => value ... } in value position.
    // child=scrutinee, data1=first arm (MatchArm chain). Each arm's data2 is a
    // value EXPR (not a block). Lowers to the same compare-chain as the match
    // statement but every matching arm COPYs its value into a shared result
    // vreg, then branches to a merge block. Unlike the statement form, value
    // exprs don't mutate the var map, so no snapshot/restore dance is needed.
    // If no arm matches (and there is no `_`), result keeps its default of 0.
    if kind == 54 {
        uint32 me_scrut = ast_child(node)
        uint64 scrut_v = ir_lower_expr(me_scrut)
        uint64 result = ir_new_vreg()
        ir_emit(IR_CONST, result, 0, 0, 0, ir_current_bb)
        uint32 arm_idx = ast_data1(node)
        uint64 warm = arm_idx
        uint64 bb_exit = ir_new_bb()
        while warm != 0 {
            uint32 ak = ast_kind(warm)
            if ak == 20 {
                uint32 val_expr = ast_data1(warm)
                uint32 body_expr = ast_data2(warm)
                uint64 is_wild = 0
                uint32 vak = ast_kind(val_expr)
                if vak == 32 {
                    uint32 wild_tok = ast_data1(val_expr)
                    uint64 wwt = wild_tok
                    if tok_matches(wwt, "_", 1) != 0 { is_wild = 1 }
                }
                uint64 bb_body = ir_new_bb()
                uint64 bb_next = ir_new_bb()
                if is_wild == 0 {
                    uint64 pat = val_expr
                    while pat != 0 {
                        uint32 nxt_pat = ast_next(pat)
                        uint64 is_last_pat = 0
                        if nxt_pat == 0 { is_last_pat = 1 }
                        uint64 bb_on_fail = 0
                        if is_last_pat != 0 { bb_on_fail = bb_next } else { bb_on_fail = ir_new_bb() }
                        uint32 pat_kind_raw = ast_kind(pat)
                        uint64 pat_kind = pat_kind_raw
                        if pat_kind == 52 {
                            uint32 lo_idx = ast_data1(pat)
                            uint32 hi_idx = ast_data2(pat)
                            uint32 inc_flag = ast_data3(pat)
                            uint64 lo_v = ir_lower_expr(lo_idx)
                            uint64 ge_v = ir_new_vreg()
                            // Signed scrutinee/bound -> signed range compares,
                            // else negative bounds never match (critique H5).
                            uint64 ge_op = IR_CMP_GE
                            if ir_vreg_signed_get(scrut_v) != 0 || ir_vreg_signed_get(lo_v) != 0 { ge_op = IR_SCMP_GE }
                            ir_emit(ge_op, ge_v, scrut_v, lo_v, 0, ir_current_bb)
                            uint64 bb_check_hi = ir_new_bb()
                            ir_emit(IR_BR_COND, 0, ge_v, 0, bb_check_hi, ir_current_bb)
                            ir_bb_set_succ(ir_current_bb, bb_on_fail, bb_check_hi)
                            ir_current_bb = bb_check_hi
                            uint64 hi_v = ir_lower_expr(hi_idx)
                            uint64 cmp_v = ir_new_vreg()
                            uint64 cmp_op = 16
                            if inc_flag != 0 { cmp_op = 17 }
                            if ir_vreg_signed_get(scrut_v) != 0 || ir_vreg_signed_get(hi_v) != 0 {
                                if inc_flag != 0 { cmp_op = IR_SCMP_LE } else { cmp_op = IR_SCMP_LT }
                            }
                            ir_emit(cmp_op, cmp_v, scrut_v, hi_v, 0, ir_current_bb)
                            ir_emit(IR_BR_COND, 0, cmp_v, 0, bb_body, ir_current_bb)
                            ir_bb_set_succ(ir_current_bb, bb_on_fail, bb_body)
                        } else {
                            uint64 val_v = ir_lower_expr(pat)
                            uint64 cmp_v = ir_new_vreg()
                            ir_emit(IR_CMP_EQ, cmp_v, scrut_v, val_v, 0, ir_current_bb)
                            ir_emit(IR_BR_COND, 0, cmp_v, 0, bb_body, ir_current_bb)
                            ir_bb_set_succ(ir_current_bb, bb_on_fail, bb_body)
                        }
                        if is_last_pat == 0 { ir_current_bb = bb_on_fail }
                        pat = nxt_pat
                    }
                } else {
                    ir_emit(IR_BR, 0, 0, 0, bb_body, ir_current_bb)
                    ir_bb_set_succ(ir_current_bb, bb_body, 0xFFFFFFFF)
                }
                ir_current_bb = bb_body
                uint64 bodyv = ir_lower_expr(body_expr)
                // Propagate the arm value's type metadata to the result vreg.
                uint64 b_fk = ir_vreg_fkind_get(bodyv)
                if b_fk != 0 { ir_vreg_fkind_set(result, b_fk) }
                if ir_vreg_signed_get(bodyv) != 0 { ir_vreg_signed_set(result, 1) }
                ir_emit(IR_COPY, result, bodyv, 0, 0, ir_current_bb)
                ir_emit(IR_BR, 0, 0, 0, bb_exit, ir_current_bb)
                ir_bb_set_succ(ir_current_bb, bb_exit, 0xFFFFFFFF)
                ir_current_bb = bb_next
            }
            uint32 anxt = ast_next(warm)
            warm = anxt
        }
        ir_emit(IR_BR, 0, 0, 0, bb_exit, ir_current_bb)
        ir_bb_set_succ(ir_current_bb, bb_exit, 0xFFFFFFFF)
        ir_current_bb = bb_exit
        return result
    }

    // FieldAccess (36) — struct field read or enum constant lookup
    if kind == 36 {
        uint32 field_tok = ast_data2(node)
        uint32 child_idx = ast_child(node)
        uint64 wchild_fa = child_idx

        // Nested struct field read: child is another FieldAccess (e.g. a.b.c)
        if wchild_fa != 0 {
            uint32 ck_nested = ast_kind(wchild_fa)
            if ck_nested == 36 {
                // Recursively evaluate the inner chain to get the base address
                // of the inner struct field. ir_lower_field_chain returns the
                // address of the struct and sets ir_fa_struct_idx to the struct
                // index of that field's type.
                uint64 inner_addr = ir_lower_field_chain(wchild_fa)
                uint64 inner_si = ir_fa_struct_idx
                if inner_si != 0xFFFFFFFF {
                    uint64 foff = struct_field_offset(inner_si, field_tok)
                    uint64 fsz = struct_field_size(inner_si, field_tok)
                    uint64 addr_v = inner_addr
                    if foff != 0 {
                        uint64 off_v = ir_new_vreg()
                        ir_emit(IR_CONST, off_v, 0, 0, foff, ir_current_bb)
                        addr_v = ir_new_vreg()
                        ir_emit(IR_ADD, addr_v, inner_addr, off_v, 0, ir_current_bb)
                    }
                    // Check if this field is itself a struct type
                    uint64 ftk = struct_field_type_kind_by_tok(inner_si, field_tok)
                    if ftk >= 256 {
                        // Field is a nested struct — return address, set tracking
                        ir_fa_struct_idx = ftk - 256
                        return addr_v
                    }
                    uint64 dest = ir_new_vreg()
                    ir_emit(IR_LOAD, dest, addr_v, fsz, 0, ir_current_bb)
                    if ftk == 96 { ir_vreg_fkind_set(dest, 1) }
                    if ftk == 95 { ir_vreg_fkind_set(dest, 2) }
                    if ftk >= 84 && ftk <= 87 { ir_vreg_signed_set(dest, 1) }
                    ir_fa_struct_idx = 0xFFFFFFFF
                    return dest
                }
            }
            // Struct array element field read: child is Index(37)
            if ck_nested == 37 {
                uint32 ai_tok = ast_data1(wchild_fa)
                uint64 wait = ai_tok
                uint64 sia = struct_var_lookup(ai_tok)
                if sia != 0xFFFFFFFF {
                    uint64 stride = struct_total_size(sia)
                    uint64 foff_i = struct_field_offset(sia, field_tok)
                    uint64 fsz_i = struct_field_size(sia, field_tok)
                    // Evaluate index
                    uint32 idx_ch = ast_child(wchild_fa)
                    uint64 idx_v = ir_lower_expr(idx_ch)
                    // addr = base + idx * stride + foff
                    uint64 base_v = ir_struct_base_addr(ai_tok)
                    uint64 stride_v = ir_new_vreg()
                    ir_emit(IR_CONST, stride_v, 0, 0, stride, ir_current_bb)
                    uint64 scaled_v = ir_new_vreg()
                    ir_emit(IR_MUL, scaled_v, idx_v, stride_v, 0, ir_current_bb)
                    uint64 elem_v = ir_new_vreg()
                    ir_emit(IR_ADD, elem_v, base_v, scaled_v, 0, ir_current_bb)
                    uint64 addr_v = elem_v
                    if foff_i != 0 {
                        uint64 foff_v = ir_new_vreg()
                        ir_emit(IR_CONST, foff_v, 0, 0, foff_i, ir_current_bb)
                        addr_v = ir_new_vreg()
                        ir_emit(IR_ADD, addr_v, elem_v, foff_v, 0, ir_current_bb)
                    }
                    uint64 dest = ir_new_vreg()
                    ir_emit(IR_LOAD, dest, addr_v, fsz_i, 0, ir_current_bb)
                    // Check struct array field type for float kind
                    uint64 sftk_i = struct_field_type_kind_by_tok(sia, field_tok)
                    if sftk_i == 96 { ir_vreg_fkind_set(dest, 1) }
                    if sftk_i == 95 { ir_vreg_fkind_set(dest, 2) }
                    if sftk_i >= 84 && sftk_i <= 87 { ir_vreg_signed_set(dest, 1) }
                    return dest
                }
            }
        }

        uint32 obj_tok = 0
        if wchild_fa != 0 {
            uint32 ck_fa = ast_kind(wchild_fa)
            if ck_fa == 32 {
                obj_tok = ast_data1(wchild_fa)
            }
        }
        // Check for slice.len access
        if obj_tok != 0 && tok_matches(field_tok, "len", 3) != 0 {
            uint64 len_v = ir_slice_len_get(obj_tok)
            if len_v != 0xFFFFFFFF {
                return len_v
            }
        }
        // Check for device field read: Device.Field
        if obj_tok != 0 {
            uint64 wdt = obj_tok
            uint64 dev_idx = device_lookup(wdt)
            if dev_idx != 0xFFFFFFFF {
                uint64 wft_d = field_tok
                uint64 dev_off = device_field_offset_of(dev_idx, wft_d)
                if dev_off != 0xFFFFFFFF {
                    uint64 dev_sz = device_field_size_of(dev_idx, wft_d)
                    uint64 dev_addr = device_base(dev_idx) + dev_off
                    uint64 addr_v = ir_new_vreg()
                    ir_emit(IR_CONST, addr_v, 0, 0, dev_addr, ir_current_bb)
                    uint64 dest = ir_new_vreg()
                    ir_emit(IR_VLOAD, dest, addr_v, 0, dev_sz, ir_current_bb)
                    return dest
                }
            }
        }
        // Check if obj_tok is a struct variable
        uint64 wobj = obj_tok
        uint64 si = struct_var_lookup(wobj)
        if si != 0xFFFFFFFF {
            // Struct field read: base + offset, load
            uint64 base_v = ir_struct_base_addr(obj_tok)
            uint64 foff = struct_field_offset(si, field_tok)
            uint64 fsz = struct_field_size(si, field_tok)
            uint64 addr_v = base_v
            if foff != 0 {
                uint64 off_v = ir_new_vreg()
                ir_emit(IR_CONST, off_v, 0, 0, foff, ir_current_bb)
                addr_v = ir_new_vreg()
                ir_emit(IR_ADD, addr_v, base_v, off_v, 0, ir_current_bb)
            }
            // Check if this field is itself a struct type (nested struct)
            uint64 ftk = struct_field_type_kind_by_tok(si, field_tok)
            if ftk >= 256 {
                // Field is a nested struct — return address (pointer), set tracking
                ir_fa_struct_idx = ftk - 256
                return addr_v
            }
            uint64 dest = ir_new_vreg()
            ir_emit(IR_LOAD, dest, addr_v, fsz, 0, ir_current_bb)
            // Set float kind if field is f64(96) or f32(95)
            if ftk == 96 { ir_vreg_fkind_set(dest, 1) }
            if ftk == 95 { ir_vreg_fkind_set(dest, 2) }
            if ftk >= 84 && ftk <= 87 { ir_vreg_signed_set(dest, 1) }
            ir_fa_struct_idx = 0xFFFFFFFF
            return dest
        }
        // Enum constant lookup
        uint64 wfield = field_tok
        uint64 val = enum_lookup(wobj, wfield)
        uint64 dest = ir_new_vreg()
        ir_emit(IR_CONST, dest, 0, 0, val, ir_current_bb)
        return dest
    }

    // Index (37): arr[i] — array element read
    if kind == 37 {
        uint32 arr_tok = ast_data1(node)
        uint64 warrt = arr_tok
        // Get base address: check local var first, then static
        uint64 base_v = ir_var_get(arr_tok)
        if base_v == 0xFFFFFFFF {
            // Check if it's a static array
            uint64 st_off = static_lookup(warrt)
            if st_off != 0xFFFFFFFF {
                base_v = ir_new_vreg()
                ir_emit(IR_STATIC_ADDR, base_v, 0, 0, st_off, ir_current_bb)
            } else {
                base_v = ir_new_vreg()
                ir_emit(IR_CONST, base_v, 0, 0, 0, ir_current_bb)
            }
        }
        // Evaluate index expression
        uint32 idx_child = ast_child(node)
        uint64 idx_v = ir_lower_expr(idx_child)
        // Bounds check under --debug: trap if idx >= count (for arrays
        // whose size is known at compile time).
        if debug_mode != 0 {
            uint64 bchk_count = arr_count_lookup(warrt)
            if bchk_count != 0xFFFFFFFF {
                ir_emit(IR_ARR_CHECK, 0, idx_v, 0, bchk_count, ir_current_bb)
            }
        }
        // Get element size
        uint64 elem_sz = arr_elem_lookup(warrt)
        // addr = base + idx * elem_sz
        uint64 addr_v = base_v
        if elem_sz != 1 {
            uint64 esz_v = ir_new_vreg()
            ir_emit(IR_CONST, esz_v, 0, 0, elem_sz, ir_current_bb)
            uint64 scaled_v = ir_new_vreg()
            ir_emit(IR_MUL, scaled_v, idx_v, esz_v, 0, ir_current_bb)
            addr_v = ir_new_vreg()
            ir_emit(IR_ADD, addr_v, base_v, scaled_v, 0, ir_current_bb)
        } else {
            addr_v = ir_new_vreg()
            ir_emit(IR_ADD, addr_v, base_v, idx_v, 0, ir_current_bb)
        }
        // Struct array element as a VALUE expression (e.g. `f(arr[i])`).
        // An IR_LOAD of a struct-sized element is meaningless — the emitters
        // only know 1/2/4/8-byte loads, so this produced garbage that was
        // then dereferenced as a pointer (segfault). Return the element
        // ADDRESS and record the struct index in ir_fa_struct_idx — the
        // same convention nested-struct FieldAccess uses — so consumers
        // (call-arg copy-in, struct VarDecl init) treat it as a struct.
        uint64 arr_si = struct_var_lookup(warrt)
        if arr_si != 0xFFFFFFFF {
            ir_fa_struct_idx = arr_si
            return addr_v
        }
        // Load element
        uint64 dest = ir_new_vreg()
        ir_emit(IR_LOAD, dest, addr_v, 0, elem_sz, ir_current_bb)
        // Propagate f64/f32 type-flow from the declared array element
        // type so `arr[i] + x` lowers as float arithmetic.
        uint64 afk = ir_fkind_from_decl(static_fkind_of(warrt))
        if afk != 0 { ir_vreg_fkind_set(dest, afk) }
        return dest
    }

    // StructLit (48): struct literal expression
    if kind == 48 {
        uint32 sname_tok = ast_data1(node)
        uint64 wsn = sname_tok
        uint64 si = struct_lookup(wsn)
        uint64 ssize = struct_total_size(si)
        // Allocate struct on heap
        uint64 buf_v = ir_new_vreg()
        ir_emit(IR_ALLOC, buf_v, 0, 0, ssize, ir_current_bb)
        // Zero-initialize
        uint64 zero_v = ir_new_vreg()
        ir_emit(IR_CONST, zero_v, 0, 0, 0, ir_current_bb)
        uint64 ssz_v = ir_new_vreg()
        ir_emit(IR_CONST, ssz_v, 0, 0, ssize, ir_current_bb)
        ir_emit(IR_MEMSET, 0, buf_v, zero_v, ssz_v, ir_current_bb)
        // Walk field expressions and store each
        uint32 is_named = ast_data2(node)
        uint64 wnamed = is_named
        uint32 fchild = ast_child(node)
        uint64 wfchild = fchild
        uint64 fidx = 0
        while wfchild != 0 {
            uint64 fval_v = ir_lower_expr(wfchild)
            // Determine field offset and size
            uint64 foff = 0
            uint64 fsize = 8
            if wnamed != 0 {
                // Named: field name stored in tok_idx of the child expression
                uint32 fname = ast_tok(wfchild)
                uint64 wfn = fname
                foff = struct_field_offset(si, wfn)
                fsize = struct_field_size(si, wfn)
            } else {
                // Positional: use field index to get offset/size from struct table
                uint64 fbase = struct_table + si * struct_entry_size + 16 + fidx * 16
                uint64 foff_addr = fbase + 4
                uint32 fo32 = 0
                unsafe { *(foff_addr as uint32) -> fo32 }
                foff = fo32
                uint64 fs_addr = fbase + 8
                uint32 fs32 = 0
                unsafe { *(fs_addr as uint32) -> fs32 }
                fsize = fs32
            }
            // Store field value at base + offset
            uint64 field_addr_v = buf_v
            if foff != 0 {
                uint64 off_v = ir_new_vreg()
                ir_emit(IR_CONST, off_v, 0, 0, foff, ir_current_bb)
                field_addr_v = ir_new_vreg()
                ir_emit(IR_ADD, field_addr_v, buf_v, off_v, 0, ir_current_bb)
            }
            ir_emit(IR_STORE, fsize, field_addr_v, fval_v, 0, ir_current_bb)
            fidx = fidx + 1
            uint32 fnxt = ast_next(wfchild)
            wfchild = fnxt
        }
        return buf_v
    }

    // FString (50) — build the interpolated string in a 4096-byte HEAP buffer.
    // (It was never a stack buffer; the comment said so for a long time. The
    // buffer is an IR_ALLOC on hosted targets and a call to the `alloc`
    // provider under --target=none, and it has to be heap either way: the
    // f-string's value is a pointer the caller may store somewhere that
    // outlives this frame.)
    if kind == 50 {
        uint64 buf_v = ir_new_vreg()
        // --target=none: IR_ALLOC is mmap/VirtualAlloc, which the emitter
        // guard refuses. Routed to the `alloc` @builtin_override instead, the
        // same way the print family is routed to `write`.
        //
        // Unlike print's formatting buffer, this one CANNOT become a stack
        // slot: an f-string is an expression whose value is a pointer, and the
        // caller may store it somewhere that outlives the frame. Heap
        // semantics are the semantics f-strings already have, so the heap is
        // what a bare-metal f-string needs -- import "std/heap_bump.kr" and
        // call heap_bump_init.
        //
        // Refusing here rather than at the emitter is the difference between
        // "'f-string' needs an allocator on bare metal" and "SYSCALL reached
        // the emitter from 'alloc'" for a program whose source contains no
        // alloc() at all -- the same wrong-name failure that made print's own
        // refusal necessary at 563b0f3.
        if target_os == 4 {
            uint64 fs_atok = builtin_override_tok_of("alloc", 5)
            // Same synthesised-call blind spot as the write provider, and one
            // step worse: the f-string CONSUMES the result as its buffer
            // address, so a void provider hands it whatever is in the return
            // register. Both are checked.
            if fs_atok != 0xFFFFFFFF {
                bm_provider_check(fs_atok, "alloc", 1, 1,
                                  "an f-string under --target=none",
                                  bm_alloc_shape())
            }
            if fs_atok == 0xFFFFFFFF {
                uint64 bmfs = "f-string"
                bare_metal_builtin_refused(bmfs, "an f-string builds its result in a heap buffer, and the result may outlive the frame, so a stack slot will not do -- supply `@builtin_override fn alloc(uint64 n) -> uint64` (import \"std/heap_bump.kr\" and call heap_bump_init), or format with print()/println() instead, which needs no allocator")
            }
            uint64 fs_size = ir_new_vreg()
            ir_emit(IR_CONST, fs_size, 0, 0, 4096, ir_current_bb)
            ir_emit(IR_ARG, 0, fs_size, 0, 0, ir_current_bb)
            ir_emit(IR_CALL, buf_v, 1, 0, fs_atok, ir_current_bb)
        } else {
            ir_emit(IR_ALLOC, buf_v, 0, 0, 4096, ir_current_bb)
        }
        uint64 off_v = ir_new_vreg()
        ir_emit(IR_CONST, off_v, 0, 0, 0, ir_current_bb)

        uint32 fchild = ast_child(node)
        uint64 wfchild = fchild
        while wfchild != 0 {
            uint32 ck = ast_kind(wfchild)
            uint64 slot_v = ir_new_vreg()
            ir_emit(IR_ADD, slot_v, buf_v, off_v, 0, ir_current_bb)
            uint64 len_v = ir_new_vreg()

            if ck == 31 {
                // StrPart (StrLit with data2=1): raw text, no quote stripping
                uint32 fstok = ast_data1(wfchild)
                uint64 wftok = fstok
                uint64 ftstart = tok_text_start(wftok)
                uint64 ftlen = tok_text_len(wftok)
                // Check data2 to detect raw StrPart (data2=1 means no quotes)
                uint32 fraw = ast_data2(wfchild)
                uint64 wfraw = fraw
                if ftlen == 0 {
                    // Empty part: emit zero length
                    ir_emit(IR_CONST, len_v, 0, 0, 0, ir_current_bb)
                } else if wfraw != 0 {
                    // Raw StrPart: bake the segment (escapes + brace doubling
                    // processed) via the shared helper in codegen.kr, so this
                    // path agrees byte-for-byte with both legacy backends.
                    uint64 fstr_offset = str_len
                    uint64 fbaked = fstr_part_bake(wftok)
                    uint64 fstr_v = ir_new_vreg()
                    ir_emit(IR_STR_CONST, fstr_v, 0, 0, fstr_offset, ir_current_bb)
                    // Compile-time length, NOT a runtime IR_STRLEN: now that
                    // `\0` is a legal escape in a segment, strlen would stop
                    // at the embedded NUL while the legacy backends (which
                    // use the baked count) would copy the whole segment.
                    ir_emit(IR_CONST, len_v, 0, 0, fbaked, ir_current_bb)
                    uint64 fmc = ir_new_vreg()
                    ir_emit(IR_MEMCPY, fmc, slot_v, fstr_v, len_v, ir_current_bb)
                } else {
                    // Regular StrLit: lower it and strlen+memcpy
                    uint64 s_v = ir_lower_expr(wfchild)
                    ir_emit(IR_STRLEN, len_v, s_v, 0, 0, ir_current_bb)
                    uint64 fmc2 = ir_new_vreg()
                    ir_emit(IR_MEMCPY, fmc2, slot_v, s_v, len_v, ir_current_bb)
                }
            } else {
                // Interpolated expression: same dispatch as variadic print
                uint64 val_v = ir_lower_expr(wfchild)
                uint64 fk = ir_vreg_fkind_get(val_v)
                if fk == 1 {
                    ir_emit(IR_FMT_F64, len_v, slot_v, val_v, 0, ir_current_bb)
                } else if fk == 2 {
                    uint64 f64v = ir_new_vreg()
                    ir_emit(IR_F32TOF64, f64v, val_v, 0, 0, ir_current_bb)
                    ir_vreg_fkind_set(f64v, 1)
                    ir_emit(IR_FMT_F64, len_v, slot_v, f64v, 0, ir_current_bb)
                } else if fk == 3 {
                    ir_emit(IR_FMT_BOOL, len_v, slot_v, val_v, 0, ir_current_bb)
                } else if fk == 4 {
                    ir_emit(IR_STORE, 1, slot_v, val_v, 0, ir_current_bb)
                    ir_emit(IR_CONST, len_v, 0, 0, 1, ir_current_bb)
                } else if ir_vreg_signed_get(val_v) != 0 {
                    // Signed integer: IR_FMT_UINT alone printed the raw
                    // two's-complement pattern, so `i64 n = -42` rendered as
                    // 18446744073709551574. Emit the sign BRANCHLESSLY so no
                    // new opcode and no extra basic block is needed (every
                    // backend already implements SAR/AND/XOR/SUB/ADD/STORE):
                    //
                    //   sign = val >> 63        (arithmetic)  -> 0 or -1
                    //   adv  = sign & 1                       -> 0 or 1
                    //   abs  = (val ^ sign) - sign
                    //
                    // '-' is stored unconditionally at the slot; when the
                    // value is non-negative adv is 0 and the first digit
                    // simply overwrites it. Length is adv + digit count.
                    uint64 fs_63 = ir_new_vreg()
                    ir_emit(IR_CONST, fs_63, 0, 0, 63, ir_current_bb)
                    uint64 fs_sign = ir_new_vreg()
                    ir_emit(IR_SAR, fs_sign, val_v, fs_63, 0, ir_current_bb)
                    uint64 fs_one = ir_new_vreg()
                    ir_emit(IR_CONST, fs_one, 0, 0, 1, ir_current_bb)
                    uint64 fs_adv = ir_new_vreg()
                    ir_emit(IR_AND, fs_adv, fs_sign, fs_one, 0, ir_current_bb)
                    uint64 fs_xor = ir_new_vreg()
                    ir_emit(IR_XOR, fs_xor, val_v, fs_sign, 0, ir_current_bb)
                    uint64 fs_abs = ir_new_vreg()
                    ir_emit(IR_SUB, fs_abs, fs_xor, fs_sign, 0, ir_current_bb)
                    uint64 fs_minus = ir_new_vreg()
                    ir_emit(IR_CONST, fs_minus, 0, 0, 45, ir_current_bb)
                    ir_emit(IR_STORE, 1, slot_v, fs_minus, 0, ir_current_bb)
                    uint64 fs_slot2 = ir_new_vreg()
                    ir_emit(IR_ADD, fs_slot2, slot_v, fs_adv, 0, ir_current_bb)
                    uint64 fs_dlen = ir_new_vreg()
                    ir_emit(IR_FMT_UINT, fs_dlen, fs_slot2, fs_abs, 0, ir_current_bb)
                    ir_emit(IR_ADD, len_v, fs_dlen, fs_adv, 0, ir_current_bb)
                } else {
                    ir_emit(IR_FMT_UINT, len_v, slot_v, val_v, 0, ir_current_bb)
                }
            }

            uint64 new_off = ir_new_vreg()
            ir_emit(IR_ADD, new_off, off_v, len_v, 0, ir_current_bb)
            off_v = new_off

            uint32 fnxt = ast_next(wfchild)
            wfchild = fnxt
        }

        // Null-terminate the result
        uint64 fzero = ir_new_vreg()
        ir_emit(IR_CONST, fzero, 0, 0, 0, ir_current_bb)
        uint64 fend_v = ir_new_vreg()
        ir_emit(IR_ADD, fend_v, buf_v, off_v, 0, ir_current_bb)
        ir_emit(IR_STORE, 1, fend_v, fzero, 0, ir_current_bb)

        return buf_v
    }

    // Default: const 0
    uint64 dest = ir_new_vreg()
    ir_emit(IR_CONST, dest, 0, 0, 0, ir_current_bb)
    return dest
}

// ---------------------------------------------------------------------------
// Statement lowering
// ---------------------------------------------------------------------------

fn ir_lower_stmt(uint64 node) {
    if node == 0 { return }
    // Stash the statement's source token so every ir_emit that runs
    // during this stmt's lowering carries the right line for DWARF.
    uint32 stmt_tok = ast_tok(node)
    if stmt_tok == 0 { stmt_tok = ast_data1(node) }
    uint64 wst_tok = stmt_tok
    ir_current_src_tok = wst_tok
    uint32 kind = ast_kind(node)

    // VarDecl (10)
    if kind == 10 {
        uint32 name_tok = ast_data2(node)
        // Check for array declaration (data3 != 0 means array size token)
        uint32 arr_size_tok = ast_data3(node)
        uint64 was = arr_size_tok
        uint32 struct_marker = ast_data4(node)
        uint64 wsm = struct_marker
        if was != 0 && wsm == 0 {
            // Array: bind pointer to name. Small compile-time-sized arrays
            // get stack storage (IR_STACK_ADDR) — a per-call IR_ALLOC is an
            // mmap/VirtualAlloc syscall and was ~2 µs per invocation on hot
            // scratch patterns like a uint64[1] atomic-add trampoline.
            uint64 arr_size = parse_int_token(was)
            uint32 type_tok_v = ast_data1(node)
            uint64 elem_size_v = type_tok_elem_size(type_tok_v)
            uint64 total_bytes = arr_size * elem_size_v
            uint64 buf_v = ir_new_vreg()
            if arr_size > 0 && total_bytes <= 4096 {
                uint64 rel_off = ir_stack_array_bytes
                // Pad to 8-byte alignment so subsequent arrays stay aligned
                uint64 padded = total_bytes
                if (padded & 7) != 0 { padded = padded + 8 - (padded & 7) }
                ir_stack_array_bytes = ir_stack_array_bytes + padded
                ir_emit(IR_STACK_ADDR, buf_v, 0, 0, rel_off, ir_current_bb)
            } else {
                ir_emit(IR_ALLOC, buf_v, 0, 0, total_bytes, ir_current_bb)
            }
            // Zero-initialize the buffer
            uint64 zero_v = ir_new_vreg()
            ir_emit(IR_CONST, zero_v, 0, 0, 0, ir_current_bb)
            uint64 sz_v = ir_new_vreg()
            ir_emit(IR_CONST, sz_v, 0, 0, total_bytes, ir_current_bb)
            ir_emit(IR_MEMSET, 0, buf_v, zero_v, sz_v, ir_current_bb)
            ir_var_set(name_tok, buf_v)
            // Register element size so array indexing can scale correctly
            arr_elem_register(name_tok, elem_size_v)
            arr_count_set_last(arr_size)
            return
        }
        // Check for struct variable declaration
        if wsm != 0 {
            uint64 struct_idx = wsm - 1
            uint64 struct_size = struct_total_size(struct_idx)
            // Check if there's an init expression (e.g. P p = P { 10, 20 })
            uint32 struct_init = ast_child(node)
            uint64 wstruct_init = struct_init
            uint32 sarr_check = ast_data3(node)
            uint64 wsarr_check = sarr_check
            if wstruct_init != 0 && wsarr_check == 0 {
                // Evaluate init expression (returns ptr to struct data)
                uint64 src_v = ir_lower_expr(wstruct_init)
                // Allocate our own copy and memcpy
                uint64 buf_v = ir_new_vreg()
                ir_emit(IR_ALLOC, buf_v, 0, 0, struct_size, ir_current_bb)
                uint64 sz_v = ir_new_vreg()
                ir_emit(IR_CONST, sz_v, 0, 0, struct_size, ir_current_bb)
                ir_emit(IR_MEMCPY, 0, buf_v, src_v, sz_v, ir_current_bb)
                ir_var_set(name_tok, buf_v)
                struct_var_register(name_tok, struct_idx)
                return
            }
            // No init: allocate and zero-initialize
            // Check if this is a struct array (data3 = array size token)
            uint64 alloc_size = struct_size
            uint64 arr_count = 1
            if wsarr_check != 0 {
                arr_count = parse_int_token(wsarr_check)
                alloc_size = struct_size * arr_count
            }
            uint64 buf_v = ir_new_vreg()
            ir_emit(IR_ALLOC, buf_v, 0, 0, alloc_size, ir_current_bb)
            uint64 zero_v = ir_new_vreg()
            ir_emit(IR_CONST, zero_v, 0, 0, 0, ir_current_bb)
            uint64 asz_v = ir_new_vreg()
            ir_emit(IR_CONST, asz_v, 0, 0, alloc_size, ir_current_bb)
            ir_emit(IR_MEMSET, 0, buf_v, zero_v, asz_v, ir_current_bb)
            ir_var_set(name_tok, buf_v)
            struct_var_register(name_tok, struct_idx)
            // Register element size for struct array indexing
            if arr_count > 1 {
                arr_elem_register(name_tok, struct_size)
                arr_count_set_last(arr_count)
            }
            return
        }
        uint32 init = ast_child(node)
        uint64 winit = init
        // Resolved type kind (handles inferred `let`; see vardecl_resolved_kind).
        uint64 vd_type_kind = vardecl_resolved_kind(node)
        uint64 vd_fk = 0
        if vd_type_kind == 96 { vd_fk = 1 }
        if vd_type_kind == 95 { vd_fk = 2 }
        if vd_type_kind == 98 { vd_fk = 3 }
        if vd_type_kind == 99 { vd_fk = 4 }
        // int8..int64 (lexer kinds 84..87) are signed. Used by Compare
        // lowering to pick IR_SCMP_* over unsigned IR_CMP_*.
        uint64 vd_signed = 0
        if vd_type_kind == 84 { vd_signed = 1 }
        if vd_type_kind == 85 { vd_signed = 1 }
        if vd_type_kind == 86 { vd_signed = 1 }
        if vd_type_kind == 87 { vd_signed = 1 }
        if winit != 0 {
            uint64 val = ir_lower_expr(winit)
            uint64 fk_from_val = ir_vreg_fkind_get(val)
            // If declared type is f32 but init produced f64 (common for
            // `f32 x = 6.9`), emit a narrowing conversion so the stored
            // bits are an actual f32. Relabel-only would leave the variable
            // holding the upper 32 bits of the f64 bit pattern, which
            // cvtss2sd later interprets as a tiny negative value.
            if vd_fk == 2 && fk_from_val == 1 {
                uint64 f32v = ir_new_vreg()
                ir_emit(IR_F64TOF32, f32v, val, 0, 0, ir_current_bb)
                ir_vreg_fkind_set(f32v, 2)
                val = f32v
                fk_from_val = 2
            }
            // Symmetric widening for `f64 x = 1.5f` style cases.
            if vd_fk == 1 && fk_from_val == 2 {
                uint64 f64v = ir_new_vreg()
                ir_emit(IR_F32TOF64, f64v, val, 0, 0, ir_current_bb)
                ir_vreg_fkind_set(f64v, 1)
                val = f64v
                fk_from_val = 1
            }
            // Integer → f64 conversion for `f64 x = some_int_var`.
            // Restricted to the RHS being a bare Ident (AST kind 32)
            // referring to a known int-typed variable, so call
            // expressions — whose result vreg has fkind=0 even when
            // the callee returns f64 — aren't wrongly ITOF'd.
            if vd_fk == 1 && fk_from_val == 0 {
                uint32 rhs_kind = ast_kind(winit)
                if rhs_kind == 32 {
                    uint64 f64v = ir_new_vreg()
                    ir_emit(IR_ITOF, f64v, val, 0, 0, ir_current_bb)
                    ir_vreg_fkind_set(f64v, 1)
                    val = f64v
                    fk_from_val = 1
                }
            }
            // Always create a fresh vreg for the new variable so it doesn't
            // alias the source. This is critical when the init is a variable
            // reference (e.g., uint64 test = bits) — without the copy, both
            // names share a vreg and modifications to one affect the other.
            uint64 fresh_val = ir_new_vreg()
            ir_emit(IR_COPY, fresh_val, val, 0, 0, ir_current_bb)
            if vd_fk != 0 {
                ir_vreg_fkind_set(fresh_val, vd_fk)
            } else if fk_from_val != 0 {
                ir_vreg_fkind_set(fresh_val, fk_from_val)
            }
            // Carry signed flag from declared type. An EXPLICITLY UNSIGNED
            // declaration (uint8..uint64, kinds 80..83) must NOT inherit
            // signedness from its initialiser: `u32 ux = some_i32` declares an
            // unsigned variable, so `ux >> 1` has to be a logical shift and
            // `ux < y` an unsigned compare. Inheriting from the RHS made both
            // signed, which is invisible on x86_64/arm64 (a u32 sits in a
            // 64-bit slot there, so the value never reaches the sign bit) but
            // silently wrong on the 32-bit backends: 0x80000000 >> 31 gave
            // 0xFFFFFFFF instead of 1. Only fall back to the RHS when the
            // declared kind is not a recognised integer type — that path still
            // serves inferred `let` and anything vardecl_resolved_kind cannot
            // pin down.
            if vd_signed != 0 {
                ir_vreg_signed_set(fresh_val, 1)
            } else if vd_type_kind >= 80 && vd_type_kind <= 83 {
                ir_vreg_signed_set(fresh_val, 0)
            } else if ir_vreg_signed_get(val) != 0 {
                ir_vreg_signed_set(fresh_val, 1)
            }
            ir_var_set(name_tok, fresh_val)
        } else {
            uint64 zero = ir_new_vreg()
            ir_emit(IR_CONST, zero, 0, 0, 0, ir_current_bb)
            if vd_fk != 0 { ir_vreg_fkind_set(zero, vd_fk) }
            if vd_signed != 0 { ir_vreg_signed_set(zero, 1) }
            ir_var_set(name_tok, zero)
        }
        return
    }

    // Assign (11)
    if kind == 11 {
        uint32 name_tok = ast_data1(node)
        uint32 val_node = ast_child(node)
        uint64 val = ir_lower_expr(val_node)
        uint64 val_fk = ir_vreg_fkind_get(val)
        // Check if the variable exists as a local first (locals shadow statics)
        uint64 wnt = name_tok
        uint64 local_vreg = ir_var_get(wnt)
        if local_vreg != 0xFFFFFFFF {
            // Integer → f64 for `f64_var = some_int_var`. Only
            // triggers when the RHS is a bare Ident (AST kind 32)
            // so we don't misclassify call results (whose result
            // vreg has fkind=0 even for callees declared `-> f64`).
            uint64 lhs_fk = ir_vreg_fkind_get(local_vreg)
            if lhs_fk == 1 && val_fk == 0 {
                uint32 rhs_kind = ast_kind(val_node)
                if rhs_kind == 32 {
                    uint64 f64v = ir_new_vreg()
                    ir_emit(IR_ITOF, f64v, val, 0, 0, ir_current_bb)
                    ir_vreg_fkind_set(f64v, 1)
                    val = f64v
                    val_fk = 1
                }
            }
            // f64 → f32 narrow on assignment to f32 var (mirrors VarDecl).
            // Without this, `f32 t = ...; t = a - 1.0` stores f64 bits
            // into the f32 slot — later cvtss2sd reinterprets them.
            if lhs_fk == 2 && val_fk == 1 {
                uint64 f32v = ir_new_vreg()
                ir_emit(IR_F64TOF32, f32v, val, 0, 0, ir_current_bb)
                ir_vreg_fkind_set(f32v, 2)
                val = f32v
            }
            // f32 → f64 widen on assignment to f64 var.
            if lhs_fk == 1 && val_fk == 2 {
                uint64 f64v = ir_new_vreg()
                ir_emit(IR_F32TOF64, f64v, val, 0, 0, ir_current_bb)
                ir_vreg_fkind_set(f64v, 1)
                val = f64v
            }
            // When the RHS is a bare Ident (AST kind 32), `val` is the
            // *same* vreg as the source variable — Ident lowering returns
            // the existing vreg without copying. Aliasing the LHS to that
            // vreg means subsequent mutations to LHS (e.g. `t = t + 1`
            // inside a loop) will, via ir_emit_copy_to_snapshot's back-
            // edge IR_COPY, physically clobber the storage of the RHS's
            // source variable. Concretely: `t = t_lo; while t < N { t =
            // t + 1 }` rewrites t_lo to N. Mirror VarDecl's behavior:
            // emit a fresh IR_COPY so the new binding owns its own vreg.
            // Casts above (ITOF / F64TOF32 / F32TOF64) already produce a
            // fresh vreg, so only the no-cast Ident path needs this.
            uint32 rhs_kind_for_alias = ast_kind(val_node)
            if rhs_kind_for_alias == 32 && val == ir_var_get(ast_data1(val_node)) {
                uint64 fresh = ir_new_vreg()
                ir_emit(IR_COPY, fresh, val, 0, 0, ir_current_bb)
                uint64 src_fk = ir_vreg_fkind_get(val)
                if src_fk != 0 { ir_vreg_fkind_set(fresh, src_fk) }
                if ir_vreg_signed_get(val) != 0 { ir_vreg_signed_set(fresh, 1) }
                val = fresh
            }
            // The LHS local's signed flag is AUTHORITATIVE and overwrites the
            // rvalue's, in both directions. Setting it keeps `int64 x = ...;
            // x = x - 1; if x < 0` on SCMP. Clearing it is the assignment-path
            // half of the vardecl fix above: `u32 ux = 7; ux = <i32>` used to
            // let the rvalue's signed flag through, so the variable silently
            // became signed from that point on and `ux >> 1` lowered to SAR.
            // A variable's signedness is fixed by its declaration; a later
            // store cannot change it.
            ir_vreg_signed_set(val, ir_vreg_signed_get(local_vreg))
            ir_var_set(name_tok, val)
            return
        }
        // Check if this is a static variable
        uint64 st_off = static_lookup(wnt)
        if st_off != 0xFFFFFFFF {
            ir_emit(IR_STATIC_STORE, 0, val, 0, st_off, ir_current_bb)
            return
        }
        ir_var_set(name_tok, val)
        return
    }

    // Return (12)
    if kind == 12 {
        uint32 expr = ast_child(node)
        uint64 wexpr = expr
        uint32 second_expr = ast_data3(node)
        uint64 wsecond = second_expr
        uint32 third_expr = ast_data4(node)
        uint64 wthird = third_expr
        // Compute return value(s) first so the produced vregs are already
        // in hand before the defer bodies run. The regalloc may spill if
        // the defers touch the same physical regs — that's fine.
        if wthird != 0 && wsecond != 0 {
            uint64 v1 = ir_lower_expr(wexpr)
            uint64 v2 = ir_lower_expr(wsecond)
            uint64 v3 = ir_lower_expr(wthird)
            ir_defer_emit_all()
            ir_emit(IR_RET3, 0, v1, v2, v3, ir_current_bb)
        } else if wsecond != 0 {
            uint64 v1 = ir_lower_expr(wexpr)
            uint64 v2 = ir_lower_expr(wsecond)
            ir_defer_emit_all()
            ir_emit(IR_RET2, 0, v1, v2, 0, ir_current_bb)
        } else if wexpr != 0 {
            uint64 val = ir_lower_expr(wexpr)
            ir_defer_emit_all()
            ir_emit(IR_RET, 0, val, 0, 0, ir_current_bb)
        } else {
            ir_defer_emit_all()
            ir_emit(IR_RET_VOID, 0, 0, 0, 0, ir_current_bb)
        }
        return
    }

    // Defer (51): stash the body on the function-scoped defer stack.
    // Emission is deferred to the next IR_RET* instruction.
    if kind == 51 {
        uint32 body_node = ast_data1(node)
        uint64 wbody = body_node
        ir_defer_push(wbody)
        return
    }

    // ExprStmt (16)
    if kind == 16 {
        uint32 expr = ast_child(node)
        uint64 wexpr = expr
        if wexpr != 0 { ir_lower_expr(wexpr) }
        return
    }

    // If (13)
    if kind == 13 {
        uint32 cond_node = ast_child(node)
        uint64 cond = ir_lower_expr(cond_node)
        uint64 bb_then = ir_new_bb()
        uint64 bb_merge = ir_new_bb()
        uint32 else_body = ast_data2(node)
        uint64 welse = else_body
        uint64 bb_else = bb_merge
        if welse != 0 { bb_else = ir_new_bb() }
        ir_emit(IR_BR_COND, 0, cond, 0, bb_then, ir_current_bb)
        ir_bb_set_succ(ir_current_bb, bb_else, bb_then)
        // Snapshot variable map before then-body
        uint64 if_snap_count = ir_var_map_count
        uint64 if_snap = alloc(if_snap_count * 8)
        uint64 ifi = 0
        while ifi < if_snap_count {
            uint64 ifs = ir_var_map + ifi * 8
            uint64 ifd = if_snap + ifi * 8
            uint64 ifv = 0
            unsafe { *(ifs as uint64) -> ifv }
            unsafe { *(ifd as uint64) = ifv }
            ifi = ifi + 1
        }
        // Then
        ir_current_bb = bb_then
        uint32 then_body = ast_data1(node)
        uint64 wthen = then_body
        if wthen != 0 { ir_lower_block(wthen) }
        // Emit COPY for changed variables (then → merge)
        ir_emit_copy_to_snapshot(if_snap, if_snap_count, ir_current_bb)
        ir_emit(IR_BR, 0, 0, 0, bb_merge, ir_current_bb)
        ir_bb_set_succ(ir_current_bb, bb_merge, 0xFFFFFFFF)
        // Restore var map for else/merge
        ifi = 0
        while ifi < if_snap_count {
            uint64 ifs = if_snap + ifi * 8
            uint64 ifd = ir_var_map + ifi * 8
            uint64 ifv = 0
            unsafe { *(ifs as uint64) -> ifv }
            unsafe { *(ifd as uint64) = ifv }
            ifi = ifi + 1
        }
        ir_var_map_count = if_snap_count
        // Else
        if welse != 0 {
            ir_current_bb = bb_else
            uint32 else_kind = ast_kind(welse)
            if else_kind == 15 {
                ir_lower_block(welse)
            } else {
                ir_lower_stmt(welse)
            }
            // Emit COPY for changed variables (else → merge)
            ir_emit_copy_to_snapshot(if_snap, if_snap_count, ir_current_bb)
            ir_emit(IR_BR, 0, 0, 0, bb_merge, ir_current_bb)
            ir_bb_set_succ(ir_current_bb, bb_merge, 0xFFFFFFFF)
            // Restore var map for merge
            ifi = 0
            while ifi < if_snap_count {
                uint64 ifs = if_snap + ifi * 8
                uint64 ifd = ir_var_map + ifi * 8
                uint64 ifv = 0
                unsafe { *(ifs as uint64) -> ifv }
                unsafe { *(ifd as uint64) = ifv }
                ifi = ifi + 1
            }
            ir_var_map_count = if_snap_count
        }
        ir_current_bb = bb_merge
        dealloc(if_snap)
        return
    }

    // While (14)
    if kind == 14 {
        // A for-range desugar puts a ForEndHoist in the condition. Lower the
        // real end bound HERE, while ir_current_bb is still the preheader and
        // before any BB is created, so it is evaluated once on the way into
        // the loop instead of once per condition test. A user-written `while`
        // has no ForEndHoist and is untouched: its condition is re-tested in
        // full, as it must be.
        //
        // Clear first so a plain `while` nested in a for body cannot inherit
        // the enclosing loop's vreg, and save/restore so the enclosing loop
        // still has its own bound after the body.
        uint64 saved_ir_for_end = ir_for_end
        ir_for_end = 0xFFFFFFFF
        uint64 fe_node_ir = for_end_hoist_of(node)
        if fe_node_ir != 0 {
            uint32 fe_child_ir = ast_child(fe_node_ir)
            uint64 wfe_child_ir = fe_child_ir
            uint64 fe_val_ir = ir_lower_expr(wfe_child_ir)
            // COPY into a vreg of our own. Lowering a bare `n` returns the
            // vreg the VARIABLE lives in, not a snapshot of its value, and the
            // back-edge parallel-move writes the body's new value straight
            // into that vreg — so `for i in 0..n { n = 100 }` would run 100
            // times on this backend while both legacy backends, which park in
            // a private stack slot, run 3. The bound is a value, not an alias.
            uint64 fe_copy_ir = ir_new_vreg()
            ir_emit(IR_COPY, fe_copy_ir, fe_val_ir, 0, 0, ir_current_bb)
            ir_for_end = fe_copy_ir
        }

        // Snapshot the preheader BB before any new BBs are created so
        // LICM can hoist invariants right before the loop entry IR_BR.
        uint64 licm_preheader = ir_current_bb
        uint64 bb_header = ir_new_bb()
        uint64 bb_body = ir_new_bb()
        uint64 bb_exit = ir_new_bb()
        ir_emit(IR_BR, 0, 0, 0, bb_header, ir_current_bb)
        ir_bb_set_succ(ir_current_bb, bb_header, 0xFFFFFFFF)
        // Snapshot variable map before header
        uint64 snap_count = ir_var_map_count
        uint64 snap_buf = alloc(snap_count * 8)
        uint64 si = 0
        while si < snap_count {
            uint64 sp = ir_var_map + si * 8
            uint64 dp = snap_buf + si * 8
            uint64 sv = 0
            unsafe { *(sp as uint64) -> sv }
            unsafe { *(dp as uint64) = sv }
            si = si + 1
        }
        ir_current_bb = bb_header
        uint32 cond_node = ast_child(node)
        uint64 cond = ir_lower_expr(cond_node)
        ir_emit(IR_BR_COND, 0, cond, 0, bb_body, ir_current_bb)
        ir_bb_set_succ(ir_current_bb, bb_exit, bb_body)
        // Snapshot variable map after header (to know which vregs header uses)
        uint64 hdr_count = ir_var_map_count
        uint64 hdr_buf = alloc(hdr_count * 8)
        si = 0
        while si < hdr_count {
            uint64 sp = ir_var_map + si * 8
            uint64 dp = hdr_buf + si * 8
            uint64 sv = 0
            unsafe { *(sp as uint64) -> sv }
            unsafe { *(dp as uint64) = sv }
            si = si + 1
        }
        // Push loop context for break/continue
        if ir_loop_depth >= 32 {
            write(2, "error: ir_loop_stack overflow (max 32)\n", 39)
            exit(1)
        }
        uint64 lp = ir_loop_exit_stack + ir_loop_depth * 8
        unsafe { *(lp as uint64) = bb_exit }
        uint64 lh = ir_loop_header_stack + ir_loop_depth * 8
        unsafe { *(lh as uint64) = bb_header }
        uint64 lb = ir_loop_hdr_buf_stack + ir_loop_depth * 8
        unsafe { *(lb as uint64) = hdr_buf }
        uint64 lc = ir_loop_hdr_count_stack + ir_loop_depth * 8
        unsafe { *(lc as uint64) = hdr_count }
        ir_loop_depth = ir_loop_depth + 1

        ir_current_bb = bb_body
        uint32 body = ast_data1(node)
        uint64 wbody = body
        if wbody != 0 { ir_lower_block(wbody) }

        ir_loop_depth = ir_loop_depth - 1

        // After body, emit COPY for any variables that changed since header.
        ir_emit_copy_to_snapshot(hdr_buf, hdr_count, ir_current_bb)
        // Record the loop range [bb_body .. ir_bb_count-1] so LICM can
        // walk every body BB. (bb_exit was allocated upfront but is
        // logically AFTER the loop body in BB index, so it's excluded
        // by the IR_BR back-edge.)
        if ir_loop_count < ir_loop_cap {
            uint64 le = ir_loops + ir_loop_count * 16
            uint32 ph32 = licm_preheader
            uint32 hd32 = bb_header
            uint32 fb32 = bb_body
            uint32 lb32 = ir_current_bb
            unsafe { *(le as uint32) = ph32 }
            uint64 le4 = le + 4
            unsafe { *(le4 as uint32) = hd32 }
            uint64 le8 = le + 8
            unsafe { *(le8 as uint32) = fb32 }
            uint64 le12 = le + 12
            unsafe { *(le12 as uint32) = lb32 }
            ir_loop_count = ir_loop_count + 1
        }
        ir_emit(IR_BR, 0, 0, 0, bb_header, ir_current_bb)
        ir_bb_set_succ(ir_current_bb, bb_header, 0xFFFFFFFF)
        // Restore variable map to header vregs for code after the loop.
        // The header vregs are the merge points — they receive values via
        // COPY from the body and hold the correct values on loop exit.
        si = 0
        while si < hdr_count {
            uint64 hs = hdr_buf + si * 8
            uint64 hd = ir_var_map + si * 8
            uint64 hv = 0
            unsafe { *(hs as uint64) -> hv }
            unsafe { *(hd as uint64) = hv }
            si = si + 1
        }
        ir_var_map_count = hdr_count
        ir_current_bb = bb_exit
        dealloc(snap_buf)
        dealloc(hdr_buf)
        ir_for_end = saved_ir_for_end
        return
    }

    // Block (15)
    if kind == 15 {
        ir_lower_block(node)
        return
    }

    // Match (19)
    if kind == 19 {
        uint32 scrutinee = ast_child(node)
        uint64 scrut_v = ir_lower_expr(scrutinee)
        // Snapshot variable map before match
        uint64 match_snap_count = ir_var_map_count
        uint64 match_snap = alloc(match_snap_count * 8)
        uint64 mi = 0
        while mi < match_snap_count {
            uint64 ms = ir_var_map + mi * 8
            uint64 md = match_snap + mi * 8
            uint64 mv = 0
            unsafe { *(ms as uint64) -> mv }
            unsafe { *(md as uint64) = mv }
            mi = mi + 1
        }
        uint32 arm_idx = ast_data1(node)
        uint64 warm = arm_idx
        uint64 bb_exit = ir_new_bb()
        while warm != 0 {
            uint32 ak = ast_kind(warm)
            if ak == 20 {
                uint32 val_expr = ast_data1(warm)
                uint32 body_block = ast_data2(warm)
                // Restore the variable map to the pre-match snapshot BEFORE
                // lowering this arm's pattern compares — otherwise they read
                // vregs left in the map by the PREVIOUS arm's body BB, which
                // don't dominate this arm's check (critique H4). Patterns are
                // pure reads, so this single restore also covers the body.
                mi = 0
                while mi < match_snap_count {
                    uint64 ms_h = match_snap + mi * 8
                    uint64 md_h = ir_var_map + mi * 8
                    uint64 mv_h = 0
                    unsafe { *(ms_h as uint64) -> mv_h }
                    unsafe { *(md_h as uint64) = mv_h }
                    mi = mi + 1
                }
                ir_var_map_count = match_snap_count
                // Wildcard: Ident named "_" — always matches. Bypass the
                // compare / BR_COND and just lower the body in place.
                uint64 is_wild = 0
                uint32 vak = ast_kind(val_expr)
                if vak == 32 {
                    uint32 wild_tok = ast_data1(val_expr)
                    uint64 wwt = wild_tok
                    if tok_matches(wwt, "_", 1) != 0 { is_wild = 1 }
                }
                uint64 bb_body = ir_new_bb()
                uint64 bb_next = ir_new_bb()
                if is_wild == 0 {
                    // Walk the comma-separated pattern chain. For each
                    // pattern emit "if matches then body" via a BR_COND
                    // whose false side lands in a fresh BB holding the
                    // next pattern's check. If every check fails we land
                    // in bb_next (the existing "skip arm" BB).
                    uint64 pat = val_expr
                    while pat != 0 {
                        uint32 nxt_pat = ast_next(pat)
                        uint64 is_last_pat = 0
                        if nxt_pat == 0 { is_last_pat = 1 }
                        uint64 bb_on_fail = 0
                        if is_last_pat != 0 { bb_on_fail = bb_next } else { bb_on_fail = ir_new_bb() }
                        uint32 pat_kind_raw = ast_kind(pat)
                        uint64 pat_kind = pat_kind_raw
                        if pat_kind == 52 {
                            // Range pattern: lo <= scrut AND scrut {<,<=} hi
                            uint32 lo_idx = ast_data1(pat)
                            uint32 hi_idx = ast_data2(pat)
                            uint32 inc_flag = ast_data3(pat)
                            uint64 lo_v = ir_lower_expr(lo_idx)
                            uint64 ge_v = ir_new_vreg()
                            // Signed scrutinee/bound -> signed range compares,
                            // else negative bounds never match (critique H5).
                            uint64 ge_op = IR_CMP_GE
                            if ir_vreg_signed_get(scrut_v) != 0 || ir_vreg_signed_get(lo_v) != 0 { ge_op = IR_SCMP_GE }
                            ir_emit(ge_op, ge_v, scrut_v, lo_v, 0, ir_current_bb)
                            uint64 bb_check_hi = ir_new_bb()
                            ir_emit(IR_BR_COND, 0, ge_v, 0, bb_check_hi, ir_current_bb)
                            ir_bb_set_succ(ir_current_bb, bb_on_fail, bb_check_hi)
                            ir_current_bb = bb_check_hi
                            uint64 hi_v = ir_lower_expr(hi_idx)
                            uint64 cmp_v = ir_new_vreg()
                            uint64 cmp_op = 16              // IR_CMP_LT for .. exclusive
                            if inc_flag != 0 { cmp_op = 17 } // IR_CMP_LE for ..= inclusive
                            if ir_vreg_signed_get(scrut_v) != 0 || ir_vreg_signed_get(hi_v) != 0 {
                                if inc_flag != 0 { cmp_op = IR_SCMP_LE } else { cmp_op = IR_SCMP_LT }
                            }
                            ir_emit(cmp_op, cmp_v, scrut_v, hi_v, 0, ir_current_bb)
                            ir_emit(IR_BR_COND, 0, cmp_v, 0, bb_body, ir_current_bb)
                            ir_bb_set_succ(ir_current_bb, bb_on_fail, bb_body)
                        } else {
                            uint64 val_v = ir_lower_expr(pat)
                            uint64 cmp_v = ir_new_vreg()
                            ir_emit(IR_CMP_EQ, cmp_v, scrut_v, val_v, 0, ir_current_bb)
                            ir_emit(IR_BR_COND, 0, cmp_v, 0, bb_body, ir_current_bb)
                            ir_bb_set_succ(ir_current_bb, bb_on_fail, bb_body)
                        }
                        if is_last_pat == 0 { ir_current_bb = bb_on_fail }
                        pat = nxt_pat
                    }
                } else {
                    ir_emit(IR_BR, 0, 0, 0, bb_body, ir_current_bb)
                    ir_bb_set_succ(ir_current_bb, bb_body, 0xFFFFFFFF)
                }
                // (var map already restored at the top of this arm — H4)
                ir_current_bb = bb_body
                uint64 wbody = body_block
                if wbody != 0 { ir_lower_block(wbody) }
                // Emit COPY for any changed variables back to pre-match vregs
                ir_emit_copy_to_snapshot(match_snap, match_snap_count, ir_current_bb)
                ir_emit(IR_BR, 0, 0, 0, bb_exit, ir_current_bb)
                ir_bb_set_succ(ir_current_bb, bb_exit, 0xFFFFFFFF)
                ir_current_bb = bb_next
            }
            uint32 anxt = ast_next(warm)
            warm = anxt
        }
        ir_emit(IR_BR, 0, 0, 0, bb_exit, ir_current_bb)
        ir_bb_set_succ(ir_current_bb, bb_exit, 0xFFFFFFFF)
        // Restore var map to pre-match state for exit block
        mi = 0
        while mi < match_snap_count {
            uint64 ms = match_snap + mi * 8
            uint64 md = ir_var_map + mi * 8
            uint64 mv = 0
            unsafe { *(ms as uint64) -> mv }
            unsafe { *(md as uint64) = mv }
            mi = mi + 1
        }
        ir_var_map_count = match_snap_count
        ir_current_bb = bb_exit
        dealloc(match_snap)
        return
    }

    // Break (17)
    if kind == 17 {
        if ir_loop_depth > 0 {
            uint64 ld = ir_loop_depth - 1
            // Copy changed vars back to header vregs before jumping
            uint64 lbp = ir_loop_hdr_buf_stack + ld * 8
            uint64 hb = 0
            unsafe { *(lbp as uint64) -> hb }
            uint64 lcp = ir_loop_hdr_count_stack + ld * 8
            uint64 hc = 0
            unsafe { *(lcp as uint64) -> hc }
            ir_emit_copy_to_snapshot(hb, hc, ir_current_bb)
            uint64 lep = ir_loop_exit_stack + ld * 8
            uint64 exit_bb = 0
            unsafe { *(lep as uint64) -> exit_bb }
            ir_emit(IR_BR, 0, 0, 0, exit_bb, ir_current_bb)
            ir_bb_set_succ(ir_current_bb, exit_bb, 0xFFFFFFFF)
            // Create a new unreachable block for any code after break
            ir_current_bb = ir_new_bb()
        }
        return
    }

    // Continue (18)
    if kind == 18 {
        if ir_loop_depth > 0 {
            uint64 ld = ir_loop_depth - 1
            // Copy changed vars back to header vregs before jumping
            uint64 lbp = ir_loop_hdr_buf_stack + ld * 8
            uint64 hb = 0
            unsafe { *(lbp as uint64) -> hb }
            uint64 lcp = ir_loop_hdr_count_stack + ld * 8
            uint64 hc = 0
            unsafe { *(lcp as uint64) -> hc }
            ir_emit_copy_to_snapshot(hb, hc, ir_current_bb)
            uint64 lhp = ir_loop_header_stack + ld * 8
            uint64 header_bb = 0
            unsafe { *(lhp as uint64) -> header_bb }
            ir_emit(IR_BR, 0, 0, 0, header_bb, ir_current_bb)
            ir_bb_set_succ(ir_current_bb, header_bb, 0xFFFFFFFF)
            // Create a new unreachable block for any code after continue
            ir_current_bb = ir_new_bb()
        }
        return
    }

    // PtrLoad (41): unsafe { *(addr as TYPE) -> dest }
    if kind == 41 {
        uint32 ts = ast_data1(node)
        uint64 type_size = ts
        uint32 addr_expr = ast_child(node)
        uint64 addr_v = ir_lower_expr(addr_expr)
        uint64 dest_v = ir_new_vreg()
        // data3 packs two things (see parser.kr's volatile block):
        //   bits 0..3 = float kind (1=f64, 2=f32, 3=f16, 0=int)
        //   bit  4    = volatile
        // Reading the whole word as the float kind is what made every
        // `volatile { *(p as TYPE) -> v }` come out f64.
        uint32 d3_32 = ast_data3(node)
        uint64 d3 = d3_32
        uint64 fk = d3 & 15
        uint64 is_vol = (d3 >> 4) & 1
        if is_vol != 0 {
            // Volatile: same lowering as the vload8/16/32/64 builtins, so it
            // inherits their width-correct acquire semantics (mfence + sized
            // load on x86, LDARB/H/W/X on arm64). Width goes in the IMM slot
            // for IR_VLOAD, not src2 as IR_LOAD takes it.
            ir_emit(IR_VLOAD, dest_v, addr_v, 0, type_size, ir_current_bb)
        } else {
            ir_emit(IR_LOAD, dest_v, addr_v, type_size, 0, ir_current_bb)
        }
        // Propagate f64/f32 type-flow from the `as TYPE` clause. Without
        // this, `unsafe { *(p as f64) -> v }` leaves v untyped at the IR
        // level and downstream `v + x` emits integer arithmetic instead of
        // IR_FADD.
        uint64 vfk = ir_fkind_from_decl(fk)
        if vfk != 0 { ir_vreg_fkind_set(dest_v, vfk) }
        // Bind dest variable
        uint32 dest_tok = ast_data2(node)
        ir_var_set(dest_tok, dest_v)
        return
    }

    // PtrStore (42): unsafe/volatile { *(addr as TYPE) = val }
    if kind == 42 {
        uint32 ts = ast_data1(node)
        uint64 type_size = ts
        uint32 addr_expr = ast_child(node)
        uint64 addr_v = ir_lower_expr(addr_expr)
        uint32 val_node = ast_data2(node)
        // data4 = 1 marks `*(addr as TYPE) OP= val`, whose value expression
        // reads back through a CompoundTemp. The address is already in addr_v
        // — park it so the read reuses it instead of evaluating addr twice.
        uint32 ps_compound = ast_data4(node)
        uint64 wpsc = ps_compound
        uint64 val_v = 0xFFFFFFFF
        if wpsc == 1 {
            uint64 ps_saved = ir_compound_temp
            ir_compound_temp = addr_v
            val_v = ir_lower_expr(val_node)
            ir_compound_temp = ps_saved
        } else {
            val_v = ir_lower_expr(val_node)
        }
        // data3 bit 4 = volatile (see parser.kr). Stores carry no float kind,
        // so the low bits are always clear here.
        uint32 sd3_32 = ast_data3(node)
        uint64 sd3 = sd3_32
        uint64 s_vol = (sd3 >> 4) & 1
        if s_vol != 0 {
            // Same lowering as the vstore8/16/32/64 builtins: mfence + sized
            // store on x86, STLRB/H/W/X on arm64. Width goes in the DEST slot
            // for IR_VSTORE.
            ir_emit(IR_VSTORE, type_size, addr_v, val_v, 0, ir_current_bb)
        } else {
            ir_emit(IR_STORE, type_size, addr_v, val_v, 0, ir_current_bb)
        }
        return
    }

    // Indexed assignment: arr[i] = val (kind 37 with data3=1)
    if kind == 37 {
        uint32 idx_d3 = ast_data3(node)
        uint64 wd3 = idx_d3
        if wd3 == 1 {
            uint32 idx_child = ast_child(node)
            uint32 rhs_child = ast_data2(node)
            uint64 wrhs = rhs_child
            uint64 val_v = 0xFFFFFFFF
            uint64 idx_v = 0xFFFFFFFF
            // ADDRESS BEFORE VALUE (docs/LANGUAGE.md §4): the SUBSCRIPT is
            // part of the destination address, so it is lowered first — its
            // side effects happen before any of the value expression's. data4
            // = 1 marks the compound form `arr[i] OP= v`, whose value
            // expression contains a CompoundTemp standing for this index;
            // that form already had the order, it just also has to publish
            // the index through ir_compound_temp.
            uint32 is_compound = ast_data4(node)
            uint64 wcmp = is_compound
            if wcmp == 1 {
                idx_v = ir_lower_expr(idx_child)
                uint64 saved_temp = ir_compound_temp
                ir_compound_temp = idx_v
                val_v = ir_lower_expr(wrhs)
                ir_compound_temp = saved_temp
            } else {
                // Evaluate index expression
                idx_v = ir_lower_expr(idx_child)
                // Evaluate value expression
                val_v = ir_lower_expr(wrhs)
            }
            // Load array base
            uint32 arr_tok = ast_data1(node)
            uint64 warrt = arr_tok
            // Bounds check under --debug for known-size arrays.
            if debug_mode != 0 {
                uint64 bchk_count_s = arr_count_lookup(warrt)
                if bchk_count_s != 0xFFFFFFFF {
                    ir_emit(IR_ARR_CHECK, 0, idx_v, 0, bchk_count_s, ir_current_bb)
                }
            }
            uint64 base_v = ir_var_get(arr_tok)
            if base_v == 0xFFFFFFFF {
                // Check static array
                uint64 st_off = static_lookup(warrt)
                if st_off != 0xFFFFFFFF {
                    base_v = ir_new_vreg()
                    ir_emit(IR_STATIC_ADDR, base_v, 0, 0, st_off, ir_current_bb)
                } else {
                    base_v = ir_new_vreg()
                    ir_emit(IR_CONST, base_v, 0, 0, 0, ir_current_bb)
                }
            }
            // Get element size
            uint64 elem_sz = arr_elem_lookup(warrt)
            // addr = base + idx * elem_sz
            uint64 addr_v = base_v
            if elem_sz != 1 {
                uint64 esz_v = ir_new_vreg()
                ir_emit(IR_CONST, esz_v, 0, 0, elem_sz, ir_current_bb)
                uint64 scaled_v = ir_new_vreg()
                ir_emit(IR_MUL, scaled_v, idx_v, esz_v, 0, ir_current_bb)
                addr_v = ir_new_vreg()
                ir_emit(IR_ADD, addr_v, base_v, scaled_v, 0, ir_current_bb)
            } else {
                addr_v = ir_new_vreg()
                ir_emit(IR_ADD, addr_v, base_v, idx_v, 0, ir_current_bb)
            }
            // Store element with correct width
            ir_emit(IR_STORE, elem_sz, addr_v, val_v, 0, ir_current_bb)
            return
        }
    }

    // TupleDestruct (44): (T1 a, T2 b) = rhs_expr
    // data2=name1_tok, data4=name2_tok, child=rhs (Call expr)
    if kind == 44 {
        uint32 name1_tok = ast_data2(node)
        uint32 name2_tok = ast_data4(node)
        uint32 rhs = ast_child(node)
        uint64 wrhs = rhs
        if wrhs != 0 {
            uint64 call_v = ir_lower_expr(wrhs)
            // call_v holds rax (first return value)
            ir_var_set(name1_tok, call_v)
            // Extract rdx (second return value)
            uint64 rdx_v = ir_new_vreg()
            ir_emit(IR_EXTRACT_RDX, rdx_v, 0, 0, 0, ir_current_bb)
            ir_var_set(name2_tok, rdx_v)
        }
        return
    }

    // TupleDestruct3 (47): (T1 a, T2 b, T3 c) = rhs_expr
    // data2=name1_tok, data4=name2_tok, tok=name3_tok, child=rhs (Call expr)
    if kind == 47 {
        uint32 name1_tok = ast_data2(node)
        uint32 name2_tok = ast_data4(node)
        uint32 name3_tok = ast_tok(node)
        uint32 rhs = ast_child(node)
        uint64 wrhs = rhs
        if wrhs != 0 {
            uint64 call_v = ir_lower_expr(wrhs)
            // call_v holds rax (first return value)
            ir_var_set(name1_tok, call_v)
            // Extract rdx (second return value)
            uint64 rdx_v = ir_new_vreg()
            ir_emit(IR_EXTRACT_RDX, rdx_v, 0, 0, 0, ir_current_bb)
            ir_var_set(name2_tok, rdx_v)
            // Extract r8 (third return value)
            uint64 r8_v = ir_new_vreg()
            ir_emit(IR_EXTRACT_R8, r8_v, 0, 0, 0, ir_current_bb)
            ir_var_set(name3_tok, r8_v)
        }
        return
    }

    // Inline assembly (43): asm block with optional I/O constraints
    if kind == 43 {
        // For ASM blocks, we emit the instructions directly during x86 emission.
        // The IR_ASM_BLOCK carries the AST node index for the x86 emitter.
        // Handle I/O constraints:
        // - in(var -> reg): we need to ensure the var's value is available
        // - out(reg -> var): we need to capture the output
        uint32 cons_head = ast_data3(node)
        uint64 wch = cons_head

        // Collect input constraint vregs
        uint64 wci = wch
        uint64 in_count = 0
        while wci != 0 {
            uint32 ck = ast_data1(wci)
            if ck == 0 {
                // in constraint: load the variable value
                uint32 vtok = ast_data3(wci)
                uint64 var_v = ir_var_get(vtok)
                // Was: silently synthesise a zero constant, so
                // `in(nosuchvar -> rax)` compiled clean and fed the block a 0.
                // Same silent-skip family as the register-name sentinel.
                asm_require_local(vtok, var_v)
                // Store the vreg as src in the instruction imm (via IR_ARG).
                // Register-name resolution is arch-specific: riscv32 (arch 2)
                // uses rv_reg_code (a0-a7/s0-s11/x0-x31, fails loud on an
                // unknown name); x86 (arch 0) and arm64 (arch 1) keep the
                // pre-existing x86_reg_code path byte-for-byte (arm64 IR-mode
                // inheriting the x86 lookup here is a pre-existing bug, audit
                // §11 — deliberately left unchanged so the bootstrap stays
                // identical; only the arch==2 branch is new).
                uint32 rtok = ast_data2(wci)
                uint64 rcode = 0
                if target_arch == 2 {
                    rcode = rv_reg_code(rtok)
                } else {
                    rcode = x86_reg_code(rtok)
                }
                if rcode != 0xFFFF {
                    // Move var value to the target physical register
                    ir_emit(IR_ARG, 0, var_v, 0, rcode + 100, ir_current_bb)
                }
                in_count = in_count + 1
            }
            uint32 nxti = ast_next(wci)
            wci = nxti
        }

        // Emit the ASM block as a passthrough node
        uint64 wnode = node
        ir_emit(IR_ASM_BLOCK, 0, wnode, 0, 0, ir_current_bb)

        // Handle output constraints: create new vregs and bind them
        uint64 wco = wch
        while wco != 0 {
            uint32 ck2 = ast_data1(wco)
            if ck2 == 1 {
                // out constraint: capture register value into variable
                uint32 rtok2 = ast_data2(wco)
                uint32 vtok2 = ast_data3(wco)
                // ir_var_set below would happily CREATE a map entry for a name
                // that is not a declared local, so the write went nowhere.
                asm_require_local(vtok2, ir_var_get(vtok2))
                // Same arch-gated dispatch as the IN site above: riscv32 uses
                // rv_reg_code (fail-loud); arch 0/1 unchanged.
                uint64 rcode2 = 0
                if target_arch == 2 {
                    rcode2 = rv_reg_code(rtok2)
                } else {
                    rcode2 = x86_reg_code(rtok2)
                }
                if rcode2 != 0xFFFF {
                    uint64 out_v = ir_new_vreg()
                    // Use IR_COPY with a special marker: src1=0, imm=rcode+100
                    // to indicate "read from physical register rcode"
                    ir_emit(IR_COPY, out_v, 0, 0, rcode2 + 100, ir_current_bb)
                    ir_var_set(vtok2, out_v)
                }
            }
            uint32 nxto = ast_next(wco)
            wco = nxto
        }
        return
    }

    // FieldAccess (36) as statement — field assignment: p.x = val
    if kind == 36 {
        uint32 fa_d4 = ast_data4(node)
        uint64 wfad4 = fa_d4
        if wfad4 == 1 {
            // Field assignment: data1=obj_tok (via child Ident), data2=field_tok, data3=val_node
            uint32 field_tok = ast_data2(node)
            uint32 val_node = ast_data3(node)
            uint32 child_idx = ast_child(node)
            uint64 wchild_fa = child_idx

            // Nested struct field write: child is another FieldAccess (e.g. l.a.x = val)
            if wchild_fa != 0 {
                uint32 ck_nw = ast_kind(wchild_fa)
                if ck_nw == 36 {
                    uint64 inner_addr = ir_lower_field_chain(wchild_fa)
                    uint64 inner_si = ir_fa_struct_idx
                    if inner_si != 0xFFFFFFFF {
                        uint64 foff = struct_field_offset(inner_si, field_tok)
                        uint64 fsz = struct_field_size(inner_si, field_tok)
                        uint64 addr_v = inner_addr
                        if foff != 0 {
                            uint64 off_v = ir_new_vreg()
                            ir_emit(IR_CONST, off_v, 0, 0, foff, ir_current_bb)
                            addr_v = ir_new_vreg()
                            ir_emit(IR_ADD, addr_v, inner_addr, off_v, 0, ir_current_bb)
                        }
                        uint64 val_v = ir_lower_expr(val_node)
                        ir_emit(IR_STORE, fsz, addr_v, val_v, 0, ir_current_bb)
                    }
                    return
                }
                // Struct array field write: child is Index (e.g. pts[i].x = val)
                if ck_nw == 37 {
                    uint32 ai_tok = ast_data1(wchild_fa)
                    uint64 wait = ai_tok
                    uint64 sia = struct_var_lookup(ai_tok)
                    if sia != 0xFFFFFFFF {
                        uint64 stride = struct_total_size(sia)
                        uint64 foff_i = struct_field_offset(sia, field_tok)
                        uint64 fsz_i = struct_field_size(sia, field_tok)
                        // Evaluate index
                        uint32 idx_ch = ast_child(wchild_fa)
                        uint64 idx_v = ir_lower_expr(idx_ch)
                        // addr = base + idx * stride + foff
                        uint64 base_v = ir_struct_base_addr(ai_tok)
                        uint64 stride_v = ir_new_vreg()
                        ir_emit(IR_CONST, stride_v, 0, 0, stride, ir_current_bb)
                        uint64 scaled_v = ir_new_vreg()
                        ir_emit(IR_MUL, scaled_v, idx_v, stride_v, 0, ir_current_bb)
                        uint64 elem_v = ir_new_vreg()
                        ir_emit(IR_ADD, elem_v, base_v, scaled_v, 0, ir_current_bb)
                        uint64 addr_v = elem_v
                        if foff_i != 0 {
                            uint64 foff_v = ir_new_vreg()
                            ir_emit(IR_CONST, foff_v, 0, 0, foff_i, ir_current_bb)
                            addr_v = ir_new_vreg()
                            ir_emit(IR_ADD, addr_v, elem_v, foff_v, 0, ir_current_bb)
                        }
                        uint64 val_v = ir_lower_expr(val_node)
                        ir_emit(IR_STORE, fsz_i, addr_v, val_v, 0, ir_current_bb)
                    }
                    return
                }
            }

            uint32 obj_tok = 0
            if wchild_fa != 0 {
                uint32 ck_fa = ast_kind(wchild_fa)
                if ck_fa == 32 {
                    obj_tok = ast_data1(wchild_fa)
                }
            }
            // Device field write: Device.Field = val
            if obj_tok != 0 {
                uint64 wdtw = obj_tok
                uint64 dev_idx_w = device_lookup(wdtw)
                if dev_idx_w != 0xFFFFFFFF {
                    uint64 wftw_d = field_tok
                    uint64 dev_off_w = device_field_offset_of(dev_idx_w, wftw_d)
                    if dev_off_w != 0xFFFFFFFF {
                        uint64 dev_sz_w = device_field_size_of(dev_idx_w, wftw_d)
                        uint64 dev_addr_w = device_base(dev_idx_w) + dev_off_w
                        uint64 addr_v = ir_new_vreg()
                        ir_emit(IR_CONST, addr_v, 0, 0, dev_addr_w, ir_current_bb)
                        uint64 val_v = ir_lower_expr(val_node)
                        ir_emit(IR_VSTORE, dev_sz_w, addr_v, val_v, 0, ir_current_bb)
                        return
                    }
                }
            }
            uint64 wobj = obj_tok
            uint64 si = struct_var_lookup(wobj)
            if si != 0xFFFFFFFF {
                uint64 base_v = ir_struct_base_addr(obj_tok)
                uint64 foff = struct_field_offset(si, field_tok)
                uint64 fsz = struct_field_size(si, field_tok)
                uint64 addr_v = base_v
                if foff != 0 {
                    uint64 off_v = ir_new_vreg()
                    ir_emit(IR_CONST, off_v, 0, 0, foff, ir_current_bb)
                    addr_v = ir_new_vreg()
                    ir_emit(IR_ADD, addr_v, base_v, off_v, 0, ir_current_bb)
                }
                uint64 val_v = ir_lower_expr(val_node)
                ir_emit(IR_STORE, fsz, addr_v, val_v, 0, ir_current_bb)
            }
        }
        return
    }
}

// ---------------------------------------------------------------------------
// IR dump — human-readable text output
// ---------------------------------------------------------------------------

fn ir_opcode_name(uint64 op) -> uint64 {
    if op == 1 { return "const" }
    if op == 2 { return "add" }
    if op == 3 { return "sub" }
    if op == 4 { return "mul" }
    if op == 5 { return "div" }
    if op == 6 { return "mod" }
    if op == 7 { return "and" }
    if op == 8 { return "or" }
    if op == 9 { return "xor" }
    if op == 10 { return "shl" }
    if op == 11 { return "shr" }
    if op == 12 { return "neg" }
    if op == 13 { return "not" }
    if op == 14 { return "cmp_eq" }
    if op == 15 { return "cmp_ne" }
    if op == 16 { return "cmp_lt" }
    if op == 17 { return "cmp_le" }
    if op == 18 { return "cmp_gt" }
    if op == 19 { return "cmp_ge" }
    if op == 20 { return "fadd" }
    if op == 21 { return "fsub" }
    if op == 22 { return "fmul" }
    if op == 23 { return "fdiv" }
    if op == 24 { return "fcmp_eq" }
    if op == 25 { return "fcmp_lt" }
    if op == 26 { return "itof" }
    if op == 27 { return "ftoi" }
    if op == 30 { return "load" }
    if op == 31 { return "store" }
    if op == 147 { return "load_bis" }
    if op == 148 { return "store_bis" }
    if op == 32 { return "stack_addr" }
    if op == 40 { return "br" }
    if op == 41 { return "br_cond" }
    if op == 42 { return "ret" }
    if op == 43 { return "ret_void" }
    if op == 50 { return "call" }
    if op == 51 { return "arg" }
    if op == 52 { return "syscall" }
    if op == 60 { return "phi" }
    if op == 61 { return "copy" }
    if op == 70 { return "alloc" }
    if op == 71 { return "dealloc" }
    if op == 72 { return "memcpy" }
    if op == 73 { return "strlen" }
    if op == 74 { return "fmt_uint" }
    if op == 75 { return "str_eq" }
    if op == 76 { return "memset" }
    if op == 77 { return "static_load" }
    if op == 78 { return "static_store" }
    if op == 79 { return "str_const" }
    if op == 80 { return "extract_rdx" }
    if op == 81 { return "extract_r8" }
    if op == 82 { return "ret2" }
    if op == 83 { return "ret3" }
    if op == 84 { return "static_addr" }
    if op == 85 { return "syscall_raw" }
    if op == 86 { return "fn_addr" }
    if op == 87 { return "call_ind" }
    if op == 88 { return "memcmp" }
    if op == 90 { return "atomic_store" }
    if op == 91 { return "atomic_load" }
    if op == 92 { return "atomic_add" }
    if op == 93 { return "atomic_cas" }
    if op == 94 { return "vstore" }
    if op == 95 { return "vload" }
    if op == 96 { return "asm_block" }
    if op == 97 { return "fsqrt" }
    if op == 98 { return "ffma" }
    if op == 99 { return "fcmp_ne" }
    if op == 100 { return "fcmp_le" }
    if op == 101 { return "fcmp_gt" }
    if op == 102 { return "fcmp_ge" }
    if op == 103 { return "f32tof64" }
    if op == 104 { return "f64tof32" }
    if op == 105 { return "f32tof16" }
    if op == 106 { return "f16tof32" }
    if op == 107 { return "itof32" }
    if op == 108 { return "ftoi32" }
    if op == 109 { return "atomic_sub" }
    if op == 110 { return "atomic_and" }
    if op == 111 { return "atomic_or" }
    if op == 112 { return "atomic_xor" }
    if op == 113 { return "exec" }
    if op == 114 { return "exec_argv" }
    if op == 115 { return "set_exec" }
    if op == 118 { return "fsqrt32" }
    if op == 119 { return "time_ns" }
    if op == 126 { return "isb" }
    if op == 127 { return "dcache_flush" }
    if op == 128 { return "icache_invalidate" }
    if op == 129 { return "dsb" }
    if op == 130 { return "dmb" }
    if op == 131 { return "arr_check" }
    if op == 132 { return "sdiv" }
    if op == 133 { return "smod" }
    if op == 134 { return "sar" }
    if op == 120 { return "scmp_lt" }
    if op == 121 { return "scmp_le" }
    if op == 122 { return "scmp_gt" }
    if op == 123 { return "scmp_ge" }
    return "???"
}

@export
fn ir_dump() {
    uint8[24] nbuf
    uint64 bi = 0
    while bi < ir_bb_count {
        write(1, "  bb", 4)
        uint64 nlen = fmt_uint(nbuf, bi)
        write(1, nbuf, nlen)
        write(1, ":\n", 2)
        uint64 ii = ir_bb_first_insn(bi)
        while ii != 0xFFFFFFFF {
            uint64 op = ir_insn_opcode(ii)
            uint64 dest = ir_insn_dest(ii)
            uint64 s1 = ir_insn_src1(ii)
            uint64 s2 = ir_insn_src2(ii)
            uint64 imm = ir_insn_imm(ii)
            write(1, "    ", 4)
            // Print dest for value-producing ops
            if op != 40 && op != 41 && op != 43 && op != 31 && op != 51 && op != 148 {
                write(1, "v", 1)
                nlen = fmt_uint(nbuf, dest)
                write(1, nbuf, nlen)
                write(1, " = ", 3)
            }
            // Print opcode name
            uint64 oname = ir_opcode_name(op)
            write(1, oname, str_len(oname))
            // Print operands based on opcode type
            if op == 1 {
                // const: just immediate
                write(1, " ", 1)
                nlen = fmt_uint(nbuf, imm)
                write(1, nbuf, nlen)
            } else if op == 40 {
                // br: target block
                write(1, " bb", 3)
                nlen = fmt_uint(nbuf, imm)
                write(1, nbuf, nlen)
            } else if op == 41 {
                // br_cond: cond, target block
                write(1, " v", 2)
                nlen = fmt_uint(nbuf, s1)
                write(1, nbuf, nlen)
                write(1, ", bb", 4)
                nlen = fmt_uint(nbuf, imm)
                write(1, nbuf, nlen)
            } else if op == 42 {
                // ret: source
                write(1, " v", 2)
                nlen = fmt_uint(nbuf, s1)
                write(1, nbuf, nlen)
            } else if op == 43 {
                // ret_void: nothing
            } else if op == 51 {
                // arg: source, index
                write(1, " v", 2)
                nlen = fmt_uint(nbuf, s1)
                write(1, nbuf, nlen)
                write(1, " [", 2)
                nlen = fmt_uint(nbuf, imm)
                write(1, nbuf, nlen)
                write(1, "]", 1)
            } else if op == 52 {
                // syscall: number
                write(1, " #", 2)
                nlen = fmt_uint(nbuf, imm)
                write(1, nbuf, nlen)
            } else if op == 50 {
                // call: func token in imm
                write(1, " @", 2)
                nlen = fmt_uint(nbuf, imm)
                write(1, nbuf, nlen)
            } else if op == 61 {
                // copy: source (param index in imm for params)
                if s1 != 0 {
                    write(1, " v", 2)
                    nlen = fmt_uint(nbuf, s1)
                    write(1, nbuf, nlen)
                } else {
                    write(1, " param[", 7)
                    nlen = fmt_uint(nbuf, imm)
                    write(1, nbuf, nlen)
                    write(1, "]", 1)
                }
            } else if op == 72 || op == 76 {
                // memcpy/memset: src1, src2, imm(vreg)
                write(1, " v", 2)
                nlen = fmt_uint(nbuf, s1)
                write(1, nbuf, nlen)
                write(1, ", v", 3)
                nlen = fmt_uint(nbuf, s2)
                write(1, nbuf, nlen)
                write(1, ", v", 3)
                nlen = fmt_uint(nbuf, imm)
                write(1, nbuf, nlen)
            } else {
                // Binary ops: src1, src2
                write(1, " v", 2)
                nlen = fmt_uint(nbuf, s1)
                write(1, nbuf, nlen)
                write(1, ", v", 3)
                nlen = fmt_uint(nbuf, s2)
                write(1, nbuf, nlen)
            }
            write(1, "\n", 1)
            ii = ir_insn_next(ii)
        }
        bi = bi + 1
    }
}

fn ir_lower_block(uint64 block_node) {
    if block_node == 0 { return }
    uint32 child = ast_child(block_node)
    uint64 wchild = child
    while wchild != 0 {
        ir_lower_stmt(wchild)
        uint32 nxt = ast_next(wchild)
        wchild = nxt
    }
}

// ---------------------------------------------------------------------------
// Defer stack — a function-scoped LIFO of `defer { ... }` block AST pointers.
// When we see a Defer stmt we stash the block here instead of lowering it.
// At every function-exit point (return, implicit tail-return) we lower the
// recorded blocks in reverse-declaration order right before the IR_RET*
// instruction is emitted.
// ---------------------------------------------------------------------------
static uint64 ir_defer_stack = 0
static uint64 ir_defer_count = 0
static uint64 ir_defer_cap = 0

fn ir_defer_reset() {
    if ir_defer_stack == 0 {
        ir_defer_cap = 32
        ir_defer_stack = alloc(ir_defer_cap * 4)
    }
    ir_defer_count = 0
}

fn ir_defer_push(uint64 body_node) {
    if ir_defer_count >= ir_defer_cap { return }
    uint64 slot = ir_defer_stack + ir_defer_count * 4
    uint32 b32 = body_node
    unsafe { *(slot as uint32) = b32 }
    ir_defer_count = ir_defer_count + 1
}

// Emit every pending defer body in LIFO order without popping them —
// a function may have multiple return sites, and every one of them must
// see the full defer chain. ir_defer_reset clears the stack between
// functions.
fn ir_defer_emit_all() {
    if ir_defer_count == 0 { return }
    uint64 i = ir_defer_count
    while i > 0 {
        i = i - 1
        uint64 slot = ir_defer_stack + i * 4
        uint32 b32 = 0
        unsafe { *(slot as uint32) -> b32 }
        uint64 body = b32
        if body != 0 { ir_lower_block(body) }
    }
}

// ---------------------------------------------------------------------------
// Function lowering
// ---------------------------------------------------------------------------

fn ir_lower_function(uint64 fn_node) {
    ir_reset()
    ir_var_map_init()
    ir_defer_reset()
    // struct_var_table is per-function: a variable named `w` typed as
    // struct A in fn f() must NOT leak into fn g() where `w` is typed as
    // struct B. Without this reset, struct_var_lookup(w) in g() would
    // return A's struct index (registered first), so g.field accesses
    // would compute the wrong byte offset (or 0xFFFFFFFF if A lacks the
    // field, which then resolves to a garbage offset). See
    // examples/codegen_struct_var_collision.kr.
    struct_var_count = 0
    ir_stack_array_bytes = 0
    // The bare-metal print scratch is a slice of this function's stack-array
    // region, so its offset is meaningless in the next function. Not resetting
    // it would hand function N+1 an offset measured against function N's
    // frame -- a store into whatever that address lands on.
    ir_bm_scratch_off = 0xFFFFFFFF
    ir_current_bb = ir_new_bb()  // entry block

    // Register parameters
    uint32 param = ast_child(fn_node)
    uint64 wparam = param
    uint64 param_idx = 0
    while wparam != 0 {
        uint32 pk = ast_kind(wparam)
        if pk == 3 {
            uint32 pname = ast_data2(wparam)
            uint64 pvreg = ir_new_vreg()
            ir_emit(IR_COPY, pvreg, 0, 0, param_idx, ir_current_bb)
            ir_var_set(pname, pvreg)
            param_idx = param_idx + 1
            // If param type is float, set float kind
            uint32 param_type = ast_data1(wparam)
            uint64 wpt = param_type
            uint64 ptk = tok_kind_at_raw(wpt)
            if ptk == 96 { ir_vreg_fkind_set(pvreg, 1) }
            if ptk == 95 { ir_vreg_fkind_set(pvreg, 2) }
            // int8..int64 params are signed, so `a < 0` etc. pick IR_SCMP_*.
            if ptk == 84 || ptk == 85 || ptk == 86 || ptk == 87 { ir_vreg_signed_set(pvreg, 1) }
            // If param type is a struct, register it so field access works
            uint64 psi = struct_lookup(wpt)
            if psi != 0xFFFFFFFF {
                struct_var_register(pname, psi)
            }
            // Slice parameter: also register the length from next register
            uint32 pflag = ast_data4(wparam)
            uint64 wpflag = pflag
            if wpflag == 1 {
                uint64 len_vreg = ir_new_vreg()
                ir_emit(IR_COPY, len_vreg, 0, 0, param_idx, ir_current_bb)
                ir_slice_len_set(pname, len_vreg)
                param_idx = param_idx + 1
            }
        }
        uint32 pnxt = ast_next(wparam)
        wparam = pnxt
    }

    // Lower body
    uint32 body = ast_data3(fn_node)
    uint64 wbody = body
    if wbody != 0 { ir_lower_block(wbody) }

    // Ensure the function ends with a return instruction.
    // If the last block doesn't end with IR_RET/IR_RET_VOID/IR_RET2/IR_RET3,
    // run pending defers (in LIFO order) and then add an implicit
    // IR_RET_VOID so the epilogue is always reached.
    uint64 need_tail = 1
    if ir_insn_count > 0 {
        uint64 last_op = ir_insn_opcode(ir_insn_count - 1)
        if last_op == 42 || last_op == 43 || last_op == 82 || last_op == 83 {
            need_tail = 0
        }
    }
    if need_tail != 0 {
        ir_defer_emit_all()
        ir_emit(IR_RET_VOID, 0, 0, 0, 0, ir_current_bb)
    }
}

// ---------------------------------------------------------------------------
// Liveness analysis — iterative dataflow with bitset live-in/live-out
// ---------------------------------------------------------------------------

static uint64 ir_live_in = 0      // bitset per block: ir_live_in + bb * set_bytes
static uint64 ir_live_out = 0     // bitset per block
static uint64 ir_live_tmp = 0     // scratch set, reused per BB in liveness loop
static uint64 ir_live_tmp_cap = 0
static uint64 ir_live_words = 0   // uint64 words per bitset = ceil(vreg_count / 64)
static uint64 ir_live_cap = 0     // bytes allocated for each of live_in/out

fn ir_liveness_init() {
    ir_live_words = (ir_vreg_next + 63) / 64
    if ir_live_words == 0 { ir_live_words = 1 }
    uint64 set_bytes = ir_live_words * 8
    uint64 total = ir_bb_count * set_bytes

    // Oversize once to worst-case: 4096 BBs * 1024 words * 8 B = 32 MB
    // per bitset. In practice per-function peak is far smaller; this fits
    // every krc.kr function at the time of writing.
    if ir_live_cap == 0 {
        ir_live_cap = 4096 * 1024 * 8
        ir_live_in = alloc(ir_live_cap)
        ir_live_out = alloc(ir_live_cap)
    }
    if total > ir_live_cap {
        write(2, "error: liveness bitset overflow\n", 32)
        exit(1)
    }
    memset(ir_live_in, 0, total)
    memset(ir_live_out, 0, total)
}

fn ir_live_set(uint64 base, uint64 bb, uint64 vreg) {
    uint64 set_bytes = ir_live_words * 8
    uint64 word = vreg / 64
    uint64 bit = vreg & 63
    uint64 p = base + bb * set_bytes + word * 8
    uint64 val = 0
    unsafe { *(p as uint64) -> val }
    val = val | (1 << bit)
    unsafe { *(p as uint64) = val }
}

fn ir_live_clear(uint64 base, uint64 bb, uint64 vreg) {
    uint64 set_bytes = ir_live_words * 8
    uint64 word = vreg / 64
    uint64 bit = vreg & 63
    uint64 p = base + bb * set_bytes + word * 8
    uint64 val = 0
    unsafe { *(p as uint64) -> val }
    val = val & ~(1 << bit)
    unsafe { *(p as uint64) = val }
}

fn ir_live_test(uint64 base, uint64 bb, uint64 vreg) -> uint64 {
    uint64 set_bytes = ir_live_words * 8
    uint64 word = vreg / 64
    uint64 bit = vreg & 63
    uint64 p = base + bb * set_bytes + word * 8
    uint64 val = 0
    unsafe { *(p as uint64) -> val }
    return (val >> bit) & 1
}

// Check whether an instruction defines (produces) a vreg.
fn ir_insn_has_def(uint64 ii) -> uint64 {
    uint64 op = ir_insn_opcode(ii)
    if op == 0 { return 0 }    // NOP (used by LICM to elide hoisted insns)
    if op == 40 { return 0 }   // br
    if op == 41 { return 0 }   // br_cond
    if op == 43 { return 0 }   // ret_void
    if op == 31 { return 0 }   // store
    if op == 148 { return 0 }  // store_bis (dest holds the WIDTH, like store)
    if op == 51 { return 0 }   // arg (no value produced)
    if op == 71 { return 0 }   // dealloc (no value produced)
    // memset DOES produce a value (returns dst pointer); do NOT mark it as no-def
    if op == 78 { return 0 }   // static_store (no value produced)
    if op == 82 { return 0 }   // ret2 (no value produced)
    if op == 83 { return 0 }   // ret3 (no value produced)
    if op == 90 { return 0 }   // atomic_store (no value produced)
    if op == 94 { return 0 }   // vstore (no value produced)
    return 1
}

// Iterative dataflow: compute live-in and live-out for every basic block.
@export
fn ir_compute_liveness() {
    ir_liveness_init()
    ir_build_bb_lists()
    uint64 set_bytes = ir_live_words * 8
    uint64 changed = 1
    uint64 lv_iter = 0
    while changed != 0 {
        changed = 0
        lv_iter = lv_iter + 1
        uint64 bi = ir_bb_count
        while bi > 0 {
            bi = bi - 1
            // Step 1: live_out[bi] = union of live_in[succ] for each successor
            uint64 s0 = ir_bb_succ0(bi)
            uint64 s1 = ir_bb_succ1(bi)
            uint64 out_changed = 0
            uint64 wi = 0
            while wi < ir_live_words {
                uint64 out_val = 0
                if s0 != 0xFFFFFFFF {
                    uint64 p_s0 = ir_live_in + s0 * set_bytes + wi * 8
                    uint64 v0 = 0
                    unsafe { *(p_s0 as uint64) -> v0 }
                    out_val = out_val | v0
                }
                if s1 != 0xFFFFFFFF {
                    uint64 p_s1 = ir_live_in + s1 * set_bytes + wi * 8
                    uint64 v1 = 0
                    unsafe { *(p_s1 as uint64) -> v1 }
                    out_val = out_val | v1
                }
                uint64 p_out = ir_live_out + bi * set_bytes + wi * 8
                uint64 out_old = 0
                unsafe { *(p_out as uint64) -> out_old }
                if out_old != out_val {
                    unsafe { *(p_out as uint64) = out_val }
                    out_changed = 1
                }
                wi = wi + 1
            }
            // live_in = f(live_out, insns) and insns never change, so if
            // this block's live_out is identical to the previous iteration
            // its live_in is already correct — skip the transfer function.
            if lv_iter > 1 && out_changed == 0 { continue }

            // Step 2: Start with live_out, walk instructions backwards
            // Copy live_out to a temp set. tmp is a static scratch buffer
            // reused across BBs and across liveness iterations — the
            // dataflow loop visits every BB many times before converging,
            // so per-BB alloc/dealloc overhead is significant.
            if set_bytes > ir_live_tmp_cap {
                if ir_live_tmp != 0 { dealloc(ir_live_tmp) }
                ir_live_tmp = alloc(set_bytes)
                ir_live_tmp_cap = set_bytes
            }
            uint64 tmp = ir_live_tmp
            uint64 ci = 0
            uint64 out_base = ir_live_out + bi * set_bytes
            while ci < set_bytes {
                uint64 ps = out_base + ci
                uint64 pd = tmp + ci
                uint64 bv = 0
                unsafe { *(ps as uint64) -> bv }
                unsafe { *(pd as uint64) = bv }
                ci = ci + 8
            }

            // Walk instructions in reverse order within this block using
            // the flat per-BB lists prebuilt by ir_build_bb_lists() (the
            // BB linked lists never change during the dataflow iteration).
            uint64 lv_off_p = ir_bb_list_off + bi * 4
            uint32 lv_off32 = 0
            unsafe { *(lv_off_p as uint32) -> lv_off32 }
            uint64 lv_end_p = ir_bb_list_off + (bi + 1) * 4
            uint32 lv_end32 = 0
            unsafe { *(lv_end_p as uint32) -> lv_end32 }
            uint64 lv_off = lv_off32
            uint64 lv_stack_n = lv_end32 - lv_off32
            while lv_stack_n > 0 {
                lv_stack_n = lv_stack_n - 1
                uint64 sp_ent = ir_bb_list_buf + (lv_off + lv_stack_n) * 4
                uint32 cur32 = 0
                unsafe { *(sp_ent as uint32) -> cur32 }
                // Manually inlined instruction-field loads (insn record is
                // 32 bytes: op u32, dest u32, src1 u32, src2 u32, imm u64).
                uint64 ins_p = ir_insn_buf + cur32 * 32
                uint32 op32 = 0
                unsafe { *(ins_p as uint32) -> op32 }
                uint64 op = op32
                if op == 0 {
                    // LICM-elided slot — no def, no uses.
                    continue
                }

                // Remove def (inline ir_insn_has_def's no-def op set)
                if op != 40 && op != 41 && op != 43 && op != 31 && op != 51 && op != 71 && op != 78 && op != 82 && op != 83 && op != 90 && op != 94 && op != 148 {
                    uint64 dp0 = ins_p + 4
                    uint32 d32 = 0
                    unsafe { *(dp0 as uint32) -> d32 }
                    uint64 def_v = d32
                    if def_v < ir_vreg_next {
                        uint64 dw = def_v / 64
                        uint64 db = def_v & 63
                        uint64 dp = tmp + dw * 8
                        uint64 dv = 0
                        unsafe { *(dp as uint64) -> dv }
                        dv = dv & ~(1 << db)
                        unsafe { *(dp as uint64) = dv }
                    }
                }

                // Add src1 use
                uint64 s1p = ins_p + 8
                uint32 s1_32 = 0
                unsafe { *(s1p as uint32) -> s1_32 }
                uint64 use1 = s1_32
                if use1 < ir_vreg_next && op != 1 {
                    uint64 uw = use1 / 64
                    uint64 ub = use1 & 63
                    uint64 up = tmp + uw * 8
                    uint64 uv = 0
                    unsafe { *(up as uint64) -> uv }
                    uv = uv | (1 << ub)
                    unsafe { *(up as uint64) = uv }
                }

                // Add src2 use
                uint64 s2p = ins_p + 12
                uint32 s2_32 = 0
                unsafe { *(s2p as uint32) -> s2_32 }
                uint64 use2 = s2_32
                if use2 < ir_vreg_next && op != 1 && op != 12 && op != 13 && op != 30 && op != 42 && op != 61 && op != 135 && op != 136 && op != 138 && (op < 140 || op > 145) {
                    uint64 uw = use2 / 64
                    uint64 ub = use2 & 63
                    uint64 up = tmp + uw * 8
                    uint64 uv = 0
                    unsafe { *(up as uint64) -> uv }
                    uv = uv | (1 << ub)
                    unsafe { *(up as uint64) = uv }
                }

                // Add imm-as-vreg use for MEMCPY(72), MEMSET(76), RET3(83), ATOMIC_CAS(93), FFMA(98)
                if op == 72 || op == 76 || op == 83 || op == 93 || op == 98 || op == 148 {
                    uint64 imp = ins_p + 16
                    uint64 use_imm = 0
                    unsafe { *(imp as uint64) -> use_imm }
                    if use_imm < ir_vreg_next && use_imm > 0 {
                        uint64 iw = use_imm / 64
                        uint64 ib = use_imm & 63
                        uint64 ip = tmp + iw * 8
                        uint64 iv = 0
                        unsafe { *(ip as uint64) -> iv }
                        iv = iv | (1 << ib)
                        unsafe { *(ip as uint64) = iv }
                    }
                }

            }

            // Check if live_in changed (word-at-a-time)
            ci = 0
            uint64 in_base = ir_live_in + bi * set_bytes
            while ci < set_bytes {
                uint64 p_old = in_base + ci
                uint64 p_new = tmp + ci
                uint64 ov = 0
                uint64 nv = 0
                unsafe { *(p_old as uint64) -> ov }
                unsafe { *(p_new as uint64) -> nv }
                if ov != nv {
                    changed = 1
                    unsafe { *(p_old as uint64) = nv }
                }
                ci = ci + 8
            }
        }
    }
}

// Populate ir_use_count_buf with saturating (0..255) counts of how many
// times each vreg is read. Uses the same "is src a vreg?" filter as
// ir_compute_liveness so we don't spuriously count token IDs or immediate
// fields. Runs once per function before x86 emission and is consumed by
// the CMP+JCC fusion peephole.
fn ir_compute_use_count() {
    if ir_use_count_buf == 0 { return }
    uint64 uc_clear = ir_vreg_next
    if uc_clear > ir_use_count_cap { uc_clear = ir_use_count_cap }
    memset(ir_use_count_buf, 0, uc_clear)
    uint64 i = 0
    while i < ir_insn_count {
        uint64 op = ir_insn_opcode(i)
        uint64 s1 = ir_insn_src1(i)
        if s1 != 0 && s1 < ir_vreg_next && s1 < ir_use_count_cap && op != 1 {
            uint64 p = ir_use_count_buf + s1
            uint8 c = 0
            unsafe { *(p as uint8) -> c }
            if c < 255 {
                uint64 nc = c
                nc = nc + 1
                uint8 nc8 = nc
                unsafe { *(p as uint8) = nc8 }
            }
        }
        uint64 s2 = ir_insn_src2(i)
        if s2 != 0 && s2 < ir_vreg_next && s2 < ir_use_count_cap && op != 1 && op != 12 && op != 13 && op != 30 && op != 42 && op != 61 && op != 135 && op != 136 && op != 138 && (op < 140 || op > 145) {
            uint64 p = ir_use_count_buf + s2
            uint8 c = 0
            unsafe { *(p as uint8) -> c }
            if c < 255 {
                uint64 nc = c
                nc = nc + 1
                uint8 nc8 = nc
                unsafe { *(p as uint8) = nc8 }
            }
        }
        if op == 72 || op == 76 || op == 83 || op == 93 || op == 98 || op == 148 {
            uint64 s3 = ir_insn_imm(i)
            if s3 != 0 && s3 < ir_vreg_next && s3 < ir_use_count_cap {
                uint64 p = ir_use_count_buf + s3
                uint8 c = 0
                unsafe { *(p as uint8) -> c }
                if c < 255 {
                    uint64 nc = c
                    nc = nc + 1
                    uint8 nc8 = nc
                    unsafe { *(p as uint8) = nc8 }
                }
            }
        }
        i = i + 1
    }
}

fn ir_use_count_get(uint64 vreg) -> uint64 {
    if vreg >= ir_use_count_cap { return 255 }
    uint64 p = ir_use_count_buf + vreg
    uint8 c = 0
    unsafe { *(p as uint8) -> c }
    return c
}

// Returns the short-jcc opcode (0x84..0x8F) if the CMP instruction at
// `cmp_idx` should be fused into a direct conditional branch with the
// BB terminator. Returns 0 if no fusion is possible. Conditions:
//   - cmp_idx's opcode is IR_CMP_EQ..IR_CMP_GE (14..19) or
//     IR_SCMP_LT..IR_SCMP_GE (120..123)
//   - The next instruction in the BB is the terminator, opcode 41
//     (IR_BR_COND), and its src1 equals the cmp's destination
//   - The cmp result has exactly one use (i.e., this BR_COND)
fn ir_cmp_fuse_code(uint64 cmp_idx) -> uint64 {
    uint64 op = ir_insn_opcode(cmp_idx)
    if (op < 14 || op > 19) && (op < 120 || op > 123) { return 0 }
    uint64 nxt = ir_insn_next(cmp_idx)
    if nxt == 0xFFFFFFFF { return 0 }
    uint64 nop = ir_insn_opcode(nxt)
    if nop != 41 { return 0 }
    uint64 dst = ir_insn_dest(cmp_idx)
    uint64 cond_v = ir_insn_src1(nxt)
    if cond_v != dst { return 0 }
    if ir_use_count_get(dst) != 1 { return 0 }
    // Map cmp opcode → short jcc opcode (second byte after 0x0F).
    // Unsigned:  EQ(14)→0x84, NE(15)→0x85, LT(16)→0x82, LE(17)→0x86,
    //            GT(18)→0x87, GE(19)→0x83
    // Signed:    LT(120)→0x8C, LE(121)→0x8E, GT(122)→0x8F, GE(123)→0x8D
    if op == 14  { return 0x84 }
    if op == 15  { return 0x85 }
    if op == 16  { return 0x82 }
    if op == 17  { return 0x86 }
    if op == 18  { return 0x87 }
    if op == 19  { return 0x83 }
    if op == 120 { return 0x8C }
    if op == 121 { return 0x8E }
    if op == 122 { return 0x8F }
    if op == 123 { return 0x8D }
    return 0
}

// ---------------------------------------------------------------------------
// Register allocator — greedy coloring
// ---------------------------------------------------------------------------

static uint64 IR_NUM_REGS = 6

// Map color index -> physical register code
// Colors 0-5 -> rbx(3), r12(12), r13(13), r14(14), r15(15), rbp(5)
// Only callee-saved registers — safe across function calls.
static uint64 ir_phys_regs = 0

// Bitmask of callee-saved colours actually used by the current
// function — populated by the prologue, consumed by the epilogue so
// the pop sequence mirrors the push sequence.
static uint64 ir_used_callee_mask = 0

// Bytes pushed by the prologue's callee-save sequence (popcount(mask)*8).
// Caller-arg overflow loads (param index >= 6) need to skip past these
// bytes plus the return address to reach the caller's stack args.
static uint64 ir_callee_save_bytes = 0

// Is the x86_64 function currently being emitted @naked? Set once per
// function in ir_emit_x86_function, BEFORE register allocation, and read
// by the colour-file choice, the IR_ARG shuffle path and the return
// sequence. @naked is not a decoration the emitters may ignore: a naked
// body runs on someone else's register state (an ISR entered between two
// instructions of an unrelated function), so anything it writes that the
// SysV ABI says a CALL preserves is silent corruption of the interrupted
// code. Every emitter that can pick a register for itself has to consult
// this. Mirrors ir_xtensa.kr's xt_cur_is_naked.
static uint64 ir_x86_naked_fn = 0

// Colour->physical-register table, shared by every backend. Sized once for
// the LARGEST colour file any of them uses (arm64 wide: 23), so an arch
// that allocated first can never undersize the buffer for a later one
// (fat builds interleave arches through this same static).
static uint64 ir_phys_regs_cap = 0

fn ir_phys_regs_ensure() {
    if ir_phys_regs_cap >= 32 { return }
    ir_phys_regs = alloc(32 * 8)
    ir_phys_regs_cap = 32
}

fn ir_regalloc_init() {
    IR_NUM_REGS = 6
    ir_phys_regs_ensure()
    uint64 p0 = ir_phys_regs
    unsafe { *(p0 as uint64) = 3 }
    uint64 p1 = ir_phys_regs + 8
    unsafe { *(p1 as uint64) = 12 }
    uint64 p2 = ir_phys_regs + 16
    unsafe { *(p2 as uint64) = 13 }
    uint64 p3 = ir_phys_regs + 24
    unsafe { *(p3 as uint64) = 14 }
    uint64 p4 = ir_phys_regs + 32
    unsafe { *(p4 as uint64) = 15 }
    uint64 p5 = ir_phys_regs + 40
    unsafe { *(p5 as uint64) = 5 }       // rbp
}

// --- Wide x86_64 colour file ----------------------------------------------
// The 6-colour callee-saved-only file drowns hot loops in spill traffic
// (sha256's compression round: 138 of 202 instructions were sp-relative
// loads/stores). SysV gives us six more registers that are only ever
// scratch today: rsi, rdi, r8-r11. They join the file as colours 6..11,
// AFTER the callee-saved prefix, so the prologue/epilogue (which only
// look at colours 0-5) need no change and the colour ceiling for values
// that must survive a call is simply 6.
//
// rax, rcx, rdx stay OUT of the file: rax/rcx are the universal spill-
// reload scratch pair (ir_resolve_src), rcx is the variable-shift count
// (CL) and rdx is div/mod's implicit high half plus IR_FFMA's third-
// operand scratch. Excluding all three keeps every whitelisted op handler
// (see ir_x86_op_widesafe) correct without a single handler change.
//
// Safety mirrors the xtensa recipe (xt_seed_call_ceilings): any block
// containing an op that is NOT on the audited whitelist gets every vreg
// it touches or that is live through it capped to the callee-saved
// prefix, so caller-saved homes only ever hold values whose entire live
// range sits in whitelisted-only blocks — which is exactly the call-free
// inner loops that need them.
static uint64 IR_X86_WIDE_NUM_REGS = 12

fn ir_regalloc_init_x86_wide() {
    IR_NUM_REGS = IR_X86_WIDE_NUM_REGS
    ir_phys_regs_ensure()
    uint64 p0 = ir_phys_regs
    unsafe { *(p0 as uint64) = 3 }        // colour 0  -> rbx
    uint64 p1 = ir_phys_regs + 8
    unsafe { *(p1 as uint64) = 12 }       // colour 1  -> r12
    uint64 p2 = ir_phys_regs + 16
    unsafe { *(p2 as uint64) = 13 }       // colour 2  -> r13
    uint64 p3 = ir_phys_regs + 24
    unsafe { *(p3 as uint64) = 14 }       // colour 3  -> r14
    uint64 p4 = ir_phys_regs + 32
    unsafe { *(p4 as uint64) = 15 }       // colour 4  -> r15
    uint64 p5 = ir_phys_regs + 40
    unsafe { *(p5 as uint64) = 5 }        // colour 5  -> rbp
    uint64 p6 = ir_phys_regs + 48
    unsafe { *(p6 as uint64) = 6 }        // colour 6  -> rsi
    uint64 p7 = ir_phys_regs + 56
    unsafe { *(p7 as uint64) = 7 }        // colour 7  -> rdi
    uint64 p8 = ir_phys_regs + 64
    unsafe { *(p8 as uint64) = 8 }        // colour 8  -> r8
    uint64 p9 = ir_phys_regs + 72
    unsafe { *(p9 as uint64) = 9 }        // colour 9  -> r9
    uint64 p10 = ir_phys_regs + 80
    unsafe { *(p10 as uint64) = 10 }      // colour 10 -> r10
    uint64 p11 = ir_phys_regs + 88
    unsafe { *(p11 as uint64) = 11 }      // colour 11 -> r11
}

// --- @naked x86_64 colour file --------------------------------------------
// A @naked body has no prologue, so it never saves anything; whatever it
// writes, it destroys for good. The default six-colour file is
// callee-saved ONLY (rbx, r12-r15, rbp), which is exactly the set an
// interrupt stub must not touch: the interrupted function is holding live
// values there and a CALL is not allowed to change them. (Reported from a
// real kernel: an ISR stub's temporaries landed in rbx and corrupted a
// name pointer the interrupted fs_lookup was holding.)
//
// The naked file is therefore the caller-saved set, minus the three
// registers the emitters use as their own scratch: rax and rcx are
// ir_resolve_src's spill-reload pair (and CL is the variable-shift count),
// rdx is div/mod's implicit high half. That leaves rsi, rdi, r8-r11 —
// six colours, the same width as the default file, so nothing spills that
// did not spill before.
//
// Order matters. r10/r11 come first because they are the only two that are
// not also SysV argument registers, so the greedy colourer reaches for
// them first and the outgoing-argument shuffle (ir_emit_call_arg_group)
// has less work to do.
//
// What this file does NOT buy: surviving a CALL. Every register in it is
// caller-saved, so a value live across a call inside a naked body is
// destroyed — and there is no frame to spill it into either. That case is
// diagnosed, not silently miscompiled (ir_x86_naked_diagnose).
fn ir_regalloc_init_x86_naked() {
    IR_NUM_REGS = 6
    ir_phys_regs_ensure()
    uint64 n0 = ir_phys_regs
    unsafe { *(n0 as uint64) = 10 }       // colour 0 -> r10
    uint64 n1 = ir_phys_regs + 8
    unsafe { *(n1 as uint64) = 11 }       // colour 1 -> r11
    uint64 n2 = ir_phys_regs + 16
    unsafe { *(n2 as uint64) = 6 }        // colour 2 -> rsi
    uint64 n3 = ir_phys_regs + 24
    unsafe { *(n3 as uint64) = 7 }        // colour 3 -> rdi
    uint64 n4 = ir_phys_regs + 32
    unsafe { *(n4 as uint64) = 8 }        // colour 4 -> r8
    uint64 n5 = ir_phys_regs + 40
    unsafe { *(n5 as uint64) = 9 }        // colour 5 -> r9
}

// Is this opcode's x86 handler audited safe for the wide colour file?
// "Safe" means: the emitted code touches NO physical register outside
// {rax, rcx, rdx, xmm0/xmm1} beyond the operands the allocator handed it
// (trap-then-exit paths like ARR_CHECK's out-of-bounds exit may clobber
// anything — the process is gone). The audit is per-handler, against the
// code in ir_emit_x86_insn / the block-terminator emitter. Anything not
// listed — calls, syscalls, memcpy/strlen/fmt helpers, atomics, exec,
// tuple returns, Windows IAT ops — caps its whole block instead
// (ir_x86_seed_wide_ceilings), so a wrong DEFAULT here is a lost
// optimisation, never a miscompile. Direction matters: only ADD to this
// list after reading the handler.
fn ir_x86_op_widesafe(uint64 o) -> uint64 {
    if o == 0 { return 1 }                    // elided slot
    if o >= 1 && o <= 19 { return 1 }         // const, alu, div/mod (rdx excluded), shifts (CL), cmps
    if o >= 20 && o <= 27 { return 1 }        // float arith/cmp/conv via rax+xmm
    if o >= 30 && o <= 32 { return 1 }        // load, store, stack_addr
    if o >= 40 && o <= 43 { return 1 }        // br, br_cond, ret (rax), ret_void
    if o == 61 { return 1 }                   // copy (param homes capped separately)
    if o == 77 || o == 78 || o == 79 { return 1 }  // static load/store, str_const (rax + rip-rel)
    if o == 84 || o == 86 { return 1 }        // static_addr, fn_addr (rax + rip-rel)
    if o >= 97 && o <= 104 { return 1 }       // fsqrt, ffma (rdx excluded), fcmps, f32/f64 conv
    if o == 107 || o == 108 { return 1 }      // itof32, ftoi32
    if o == 118 { return 1 }                  // fsqrt32
    if o >= 120 && o <= 123 { return 1 }      // signed cmps
    if o == 131 { return 1 }                  // arr_check (trap path exits the process)
    if o >= 132 && o <= 139 { return 1 }      // sdiv/smod (rdx excl), sar, add/sub_imm, ror (CL), mul_imm, lea_bis
    if o == 143 { return 1 }                  // shl_imm
    return 0
}

// Does the current function's IR contain an IR_ASM_BLOCK (96)?
//
// Two consumers, both of which must be conservative about an asm block:
//   1. the wide colour file (an asm block can name any physical register),
//   2. the callee-save mask in the prologue/epilogue.
//
// (2) is why this must stay a whole-body scan and NOT a scan of the
// `in`/`out`/`clobbers` constraint lists. The asm TEXT is opaque
// passthrough — a raw instruction inside the body can write any register
// without appearing in any constraint list at all, and that shape occurs
// in real code (MLRift's std/vec_f64_dispatch CPUID block wrote r13 with
// no constraint naming it, and survived only because r13 happened to be
// dead at the two exercised call sites). Anything precise enough to look
// only at the constraints misses exactly that case, silently.
fn ir_fn_has_asm_block() -> uint64 {
    uint64 b = 0
    while b < ir_bb_count {
        uint64 i = ir_bb_first_insn(b)
        while i != 0xFFFFFFFF {
            if ir_insn_opcode(i) == 96 { return 1 }
            i = ir_insn_next(i)
        }
        b = b + 1
    }
    return 0
}

// Does this function qualify for the wide x86 colour file? Inline asm
// (op 96) can name any physical register, so it disqualifies outright —
// same rule as xtensa's xt_fn_wide_ok.
fn ir_x86_fn_wide_ok() -> uint64 {
    if ir_fn_has_asm_block() != 0 { return 0 }
    return 1
}

// --- Instruction-level wide-ceiling seeding -------------------------------
// Cap every vreg that a non-whitelisted ("dirty") op could clobber to the
// callee-saved colour prefix. Refinement of xt_seed_call_ceilings' block
// granularity: sha256's whole 64-round compression body is ONE block with
// two small calls in the middle, so block-level capping surrendered every
// register in exactly the code this feature exists for. Here a backward
// per-instruction liveness walk caps, at each dirty instruction, the set
// live AFTER it, the set live BEFORE it, and its own named operands —
// precisely the values a clobber could destroy. Short-lived temporaries
// whose whole life sits between two dirty points keep the full file.
//
// Safety argument for values that are NOT live at any dirty point but are
// defined in the same block: a caller-saved register only gets clobbered
// by the dirty op itself, and the lowering emits every IR_ARG of a call
// contiguously, immediately before its IR_CALL/IR_CALL_IND/IR_SYSCALL
// (argument expressions are fully evaluated first — see the arg_vregs
// buffering in the Call lowering). So no allocatable def ever executes
// while outgoing argument registers are already loaded; the only insns
// inside an ARG..CALL span are the ARGs and the call, and every operand
// of those is capped here as a dirty-insn operand. Optimizer passes only
// rewrite in place or elide (op 0) — nothing inserts between ARG and CALL.
//
// The live-set update rules MIRROR ir_graph_color's interference builder
// exactly (same src1/src2 vreg-vs-payload exclusions, same imm-as-vreg
// ops); diverging from them would under-approximate liveness and
// miscompile. Uses the flat per-BB lists built by ir_compute_liveness,
// which runs immediately before seeding.
static uint64 ir_seed_live_buf = 0
static uint64 ir_seed_live_cap = 0

// Cap every vreg present in the bitset `live` to colours < cap.
fn ir_seed_cap_live_set(uint64 live, uint64 cap) {
    uint64 w = 0
    while w < ir_live_words {
        uint64 p = live + w * 8
        uint64 bits = 0
        unsafe { *(p as uint64) -> bits }
        while bits != 0 {
            uint64 iso = bits & (0 - bits)
            uint64 bp = ir_popcount64(iso - 1)
            uint64 v = w * 64 + bp
            if v > 0 && v < ir_vreg_next { ir_color_ceil_set(v, cap) }
            bits = bits & ~(1 << bp)
        }
        w = w + 1
    }
}

// arch_a64 selects the per-arch handler whitelist; cap is the length of
// the callee-saved colour prefix (6 on x86_64, 10 on arm64).
fn ir_seed_wide_ceilings_generic(uint64 arch_a64, uint64 cap) {
    uint64 vcount = ir_vreg_next
    if vcount == 0 { return }
    uint64 set_bytes = ir_live_words * 8
    if ir_seed_live_buf == 0 {
        ir_seed_live_cap = 1024 * 8
        ir_seed_live_buf = alloc(ir_seed_live_cap)
    }
    if set_bytes > ir_seed_live_cap {
        write(2, "error: seed live buffer overflow\n", 33)
        exit(1)
    }
    uint64 tmp = ir_seed_live_buf

    uint64 b = 0
    while b < ir_bb_count {
        // Fast scan: any dirty op in this block at all?
        uint64 dirty = 0
        uint64 i = ir_bb_first_insn(b)
        while i != 0xFFFFFFFF {
            uint64 o = ir_insn_opcode(i)
            uint64 safe = 0
            if arch_a64 != 0 { safe = ir_a64_op_widesafe(o) }
            else { safe = ir_x86_op_widesafe(o) }
            if safe == 0 { dirty = 1 }
            i = ir_insn_next(i)
        }
        if dirty != 0 {
            // live = live_out[bb]
            uint64 wi = 0
            while wi < ir_live_words {
                uint64 sp = ir_live_out + b * set_bytes + wi * 8
                uint64 dp = tmp + wi * 8
                uint64 v = 0
                unsafe { *(sp as uint64) -> v }
                unsafe { *(dp as uint64) = v }
                wi = wi + 1
            }
            // Backward walk over the block's flat instruction list.
            uint64 off_p = ir_bb_list_off + b * 4
            uint32 off32 = 0
            unsafe { *(off_p as uint32) -> off32 }
            uint64 end_p = ir_bb_list_off + (b + 1) * 4
            uint32 end32 = 0
            unsafe { *(end_p as uint32) -> end32 }
            uint64 loff = off32
            uint64 n = end32 - off32
            while n > 0 {
                n = n - 1
                uint64 ent = ir_bb_list_buf + (loff + n) * 4
                uint32 ii32 = 0
                unsafe { *(ent as uint32) -> ii32 }
                uint64 ii = ii32
                uint64 op = ir_insn_opcode(ii)
                if op == 0 { continue }
                uint64 insn_safe = 0
                if arch_a64 != 0 { insn_safe = ir_a64_op_widesafe(op) }
                else { insn_safe = ir_x86_op_widesafe(op) }
                if insn_safe == 0 {
                    // Everything live AFTER the dirty op, plus its result.
                    ir_seed_cap_live_set(tmp, cap)
                    uint64 dd = ir_insn_dest(ii)
                    if dd != 0 && dd < vcount { ir_color_ceil_set(dd, cap) }
                }
                // Live-set update — mirror of ir_graph_color's builder.
                if ir_insn_has_def(ii) != 0 {
                    uint64 dv = ir_insn_dest(ii)
                    if dv > 0 && dv < vcount {
                        uint64 dw = dv / 64
                        uint64 dp2 = tmp + dw * 8
                        uint64 dval = 0
                        unsafe { *(dp2 as uint64) -> dval }
                        dval = dval & ~(1 << (dv & 63))
                        unsafe { *(dp2 as uint64) = dval }
                    }
                }
                uint64 u1 = ir_insn_src1(ii)
                if u1 > 0 && u1 < vcount && op != 1 && op != 79 {
                    uint64 up = tmp + (u1 / 64) * 8
                    uint64 uv = 0
                    unsafe { *(up as uint64) -> uv }
                    uv = uv | (1 << (u1 & 63))
                    unsafe { *(up as uint64) = uv }
                }
                uint64 u2 = ir_insn_src2(ii)
                if u2 > 0 && u2 < vcount && op != 1 && op != 12 && op != 13 && op != 30 && op != 42 && op != 61 && op != 135 && op != 136 && op != 138 && (op < 140 || op > 145) {
                    uint64 up = tmp + (u2 / 64) * 8
                    uint64 uv = 0
                    unsafe { *(up as uint64) -> uv }
                    uv = uv | (1 << (u2 & 63))
                    unsafe { *(up as uint64) = uv }
                }
                if op == 72 || op == 76 || op == 83 || op == 93 || op == 98 || op == 148 {
                    uint64 uimm = ir_insn_imm(ii)
                    if uimm > 0 && uimm < vcount {
                        uint64 up = tmp + (uimm / 64) * 8
                        uint64 uv = 0
                        unsafe { *(up as uint64) -> uv }
                        uv = uv | (1 << (uimm & 63))
                        unsafe { *(up as uint64) = uv }
                    }
                }
                if insn_safe == 0 {
                    // Everything live BEFORE the dirty op (covers all of
                    // its own source operands, including imm-as-vreg).
                    ir_seed_cap_live_set(tmp, cap)
                }
            }
        }
        b = b + 1
    }
}

fn ir_x86_seed_wide_ceilings() {
    ir_seed_wide_ceilings_generic(0, 6)
}

// Cap every vreg that receives a register-passed parameter to the
// callee-saved colours. The leading param copies read rdi/rsi/rdx/rcx/
// r8/r9 one at a time in ascending param order, so a param homed in an
// arg register that a LATER param copy still has to read would be
// clobbered. Capping the params (imm < 6) is enough — overflow params
// (imm 6..99) load from the caller's stack after every arg register has
// been consumed, and imm >= 100 only occurs in asm-block functions,
// which never get the wide file.
fn ir_x86_seed_param_ceilings() {
    uint64 b = 0
    while b < ir_bb_count {
        uint64 i = ir_bb_first_insn(b)
        while i != 0xFFFFFFFF {
            if ir_insn_opcode(i) == 61 {
                if ir_insn_src1(i) == 0 {
                    if ir_insn_imm(i) < 6 {
                        ir_color_ceil_set(ir_insn_dest(i), 6)
                    }
                }
            }
            i = ir_insn_next(i)
        }
        b = b + 1
    }
}

// Register assignment table: [color(4)] x vreg_count. 0xFFFFFFFF = spilled
static uint64 ir_reg_assign = 0
static uint64 ir_reg_assign_cap = 0

// Per-vreg colour ceiling. Entry v holds "vreg v may only take colours
// < this value"; 0 means "no restriction, use IR_NUM_REGS". Lets a backend
// carve its colour file into classes without teaching the colourer about
// registers: xtensa's leaf mode (ir_xtensa.kr) appends the CALL0 argument
// registers to the colour file, but the incoming-argument copies read a2..a7
// one at a time, so a PARAMETER whose home were a later param's source
// register would clobber it. Capping param vregs to the callee-saved prefix
// is enough, and needs no parallel-move sequencing.
//
// Only ever populated by the xtensa driver; every other arch leaves the
// buffer null and the greedy loop below behaves exactly as before.
static uint64 ir_color_ceil = 0
static uint64 ir_color_ceil_cap = 0
static uint64 ir_color_ceil_used = 0

// Clear the ceilings recorded for the previous function. Cheap: only the
// prefix an earlier function actually touched is zeroed.
fn ir_color_ceil_reset() {
    if ir_color_ceil == 0 { return }
    uint64 i = 0
    while i < ir_color_ceil_used {
        uint64 p = ir_color_ceil + i * 4
        uint32 z = 0
        unsafe { *(p as uint32) = z }
        i = i + 1
    }
    ir_color_ceil_used = 0
}

fn ir_color_ceil_set(uint64 vreg, uint64 maxc) {
    if ir_color_ceil_cap == 0 {
        ir_color_ceil_cap = 65536
        ir_color_ceil = alloc(ir_color_ceil_cap * 4)
    }
    if vreg >= ir_color_ceil_cap { return }
    uint64 p = ir_color_ceil + vreg * 4
    uint32 mc = maxc
    unsafe { *(p as uint32) = mc }
    if vreg + 1 > ir_color_ceil_used { ir_color_ceil_used = vreg + 1 }
}

// Raw ceiling as stored: 0 means "unset". ir_color_ceil_get folds unset into
// IR_NUM_REGS, which is the right answer for the colourer but useless for
// combining ceilings, hence this separate accessor.
fn ir_color_ceil_raw(uint64 vreg) -> uint64 {
    if ir_color_ceil == 0 { return 0 }
    if vreg >= ir_color_ceil_cap { return 0 }
    uint64 p = ir_color_ceil + vreg * 4
    uint32 mc = 0
    unsafe { *(p as uint32) -> mc }
    uint64 wmc = mc
    return wmc
}

// Push every vreg's ceiling onto its union-find representative, keeping the
// TIGHTEST. Copy coalescing colours representatives only and then propagates
// the rep's colour to its followers, so without this a capped vreg coalesced
// with an uncapped one would inherit a colour its own ceiling forbids — on
// xtensa that means a value a call is about to destroy quietly ends up in a
// caller-saved register. Must run after coalescing is final and before the
// greedy loop.
fn ir_color_ceil_to_reps(uint64 vcount) {
    if ir_color_ceil == 0 { return }
    uint64 v = 1
    while v < vcount {
        uint64 c = ir_color_ceil_raw(v)
        if c != 0 {
            uint64 r = ir_uf_find(v)
            if r != v {
                uint64 rc = ir_color_ceil_raw(r)
                if rc == 0 {
                    ir_color_ceil_set(r, c)
                } else if c < rc {
                    ir_color_ceil_set(r, c)
                }
            }
        }
        v = v + 1
    }
}

// Highest colour+1 that `vreg` may take. IR_NUM_REGS unless a backend
// narrowed it.
fn ir_color_ceil_get(uint64 vreg) -> uint64 {
    if ir_color_ceil == 0 { return IR_NUM_REGS }
    if vreg >= ir_color_ceil_cap { return IR_NUM_REGS }
    uint64 p = ir_color_ceil + vreg * 4
    uint32 mc = 0
    unsafe { *(p as uint32) -> mc }
    uint64 wmc = mc
    if wmc == 0 { return IR_NUM_REGS }
    if wmc > IR_NUM_REGS { return IR_NUM_REGS }
    return wmc
}
static uint64 ir_ig_buf = 0
static uint64 ir_ig_cap = 0
// Ceiling on the interference bitmatrix: 65536 vregs x 1024 words x 8 B.
// Spelled as a literal because a static initializer does NOT const-fold.
static uint64 IR_IG_MAX = 536870912
static uint64 ir_color_tmp_buf = 0
static uint64 ir_color_tmp_cap = 0
// Greedy-colouring priority order (rep vregs, hottest first) — sized to
// the ir_reg_assign vreg cap, filled per function by counting sort on
// the saturating use counts.
static uint64 ir_color_order_buf = 0

// Union-find for copy coalescing. parent[v] == v means v is its own
// representative; otherwise follow parent[v] to its rep. After
// ir_graph_color, every vreg's color is propagated from its rep.
//
// Briggs-conservative copy coalescing. A candidate `dst = src` is
// merged only if the combined interference set has fewer than
// K = IR_NUM_REGS neighbours of significant degree (>= K). That keeps
// the merged node K-colourable in isolation, so coalescing never forces
// a spill that wouldn't have happened otherwise. ir_uf_deg caches
// per-vreg neighbour counts and is updated incrementally as merges
// happen. Enabled by default; --no-coalesce disables.
static uint64 ir_uf_parent = 0
static uint64 ir_uf_cap = 0
static uint64 ir_uf_deg = 0
static uint64 ir_uf_deg_cap = 0
static uint64 ir_coalesce_enabled = 1

@export fn ir_set_coalesce(uint64 v) { ir_coalesce_enabled = v }

// Popcount of one 64-bit word, branchless.
fn ir_popcount64(uint64 x) -> uint64 {
    x = x - ((x >> 1) & 0x5555555555555555)
    x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
    x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F
    return (x * 0x0101010101010101) >> 56
}

fn ir_uf_find(uint64 v) -> uint64 {
    uint64 cur = v
    while 1 == 1 {
        uint64 pp = ir_uf_parent + cur * 4
        uint32 pw = 0
        unsafe { *(pp as uint32) -> pw }
        uint64 par = pw
        if par == cur { break }
        cur = par
    }
    // Path compression — flatten so future lookups are O(1).
    uint64 walk = v
    while walk != cur {
        uint64 pp2 = ir_uf_parent + walk * 4
        uint32 pw2 = 0
        unsafe { *(pp2 as uint32) -> pw2 }
        uint64 next = pw2
        uint32 cw = cur
        unsafe { *(pp2 as uint32) = cw }
        walk = next
    }
    return cur
}

fn ir_get_phys_reg(uint64 vreg) -> uint64 {
    if vreg == 0 { return 0xFFFFFFFF }
    if vreg >= ir_vreg_next { return 0xFFFFFFFF }
    uint64 p = ir_reg_assign + vreg * 4
    uint32 color = 0
    unsafe { *(p as uint32) -> color }
    uint64 wcolor = color
    if wcolor >= IR_NUM_REGS { return 0xFFFFFFFF }
    uint64 rp = ir_phys_regs + wcolor * 8
    uint64 phys = 0
    unsafe { *(rp as uint64) -> phys }
    return phys
}

// Used-callee-save mask. After regalloc, returns a bit set with bit i set
// iff some vreg got colour i. Lets the prologue/epilogue push only what's
// actually used — fib(40) burns ~330M calls, and trimming the prologue to
// only the colours actually live saves stack writes + reads per call.
//
// SHARED ACROSS ARCHES, so the colours a set bit names are NOT fixed x86_64
// register names: this function only knows colour NUMBERS, and each caller
// maps them through its own colour file. x86_64's narrow (callee-saved-only)
// file is 6 colours wide (0..5 = rbx/r12/r13/r14/r15/rbp; commit 66463d8
// added rbp as colour 5, so fib(40) now pushes 6 pairs where the file is
// full, not the 5 this comment used to say). This function is also called
// from src/ir_aarch64.kr (10 narrow / 23 wide colours), src/ir_riscv.kr (12
// colours) and src/ir_xtensa.kr (4 colours) — arm64's 23-wide file is the
// widest caller, so across all of them the mask reaches bit 22, not the
// 5-bit set this comment used to claim.
fn ir_used_color_mask() -> uint64 {
    uint64 mask = 0
    uint64 v = 1
    while v < ir_vreg_next {
        uint64 p = ir_reg_assign + v * 4
        uint32 color = 0
        unsafe { *(p as uint32) -> color }
        uint64 wc = color
        if wc < IR_NUM_REGS {
            mask = mask | (1 << wc)
        }
        v = v + 1
    }
    return mask
}

// Interference-based register allocator using liveness data.
// Uses the already-computed live-in/live-out bitsets to build an interference
// graph, then greedily colors vregs. Two vregs interfere if they're both
// live at any instruction point (def interferes with all live-out except itself).
fn ir_graph_color() {
    uint64 vcount = ir_vreg_next
    if vcount == 0 { return }

    // Register-assignment table — oversized to 65536 vregs once (256 KB).
    if ir_reg_assign_cap == 0 {
        ir_reg_assign_cap = 65536
        ir_reg_assign = alloc(ir_reg_assign_cap * 4)
    }
    if vcount > ir_reg_assign_cap {
        write(2, "error: vreg count exceeds ir_reg_assign capacity\n", 49)
        exit(1)
    }

    // Interference bitmatrix — vreg x vreg bits. Oversized once to
    // 65536 * 1024 words = 512 MB worst case. Per-function peak is far
    // smaller; only zero the region actually in use.
    uint64 row_words = (vcount + 63) / 64
    uint64 row_bytes = row_words * 8
    uint64 ig_needed = vcount * row_bytes
    if ig_needed > IR_IG_MAX {
        write(2, "error: interference graph overflow\n", 35)
        exit(1)
    }
    // Grow on demand rather than reserving the 512 MB worst case up front.
    // The old code allocated the ceiling on the first colored function and
    // memset only the used prefix -- free on Linux, where alloc is a lazy
    // mmap that never fails, and fatal anywhere the heap is real: ApexRift
    // refused the 512 MB, alloc returned 0, and the memset below ran from
    // address ZERO across the page tables. Real peak here is a few MB.
    //
    // Doubling keeps the number of regrows logarithmic when functions arrive
    // in increasing size order, instead of one realloc per function.
    if ig_needed > ir_ig_cap {
        if ir_ig_buf != 0 { dealloc(ir_ig_buf) }
        uint64 want = ir_ig_cap * 2
        if want < ig_needed { want = ig_needed }
        if want > IR_IG_MAX { want = IR_IG_MAX }
        ir_ig_cap = want
        ir_ig_buf = alloc(ir_ig_cap)
        if ir_ig_buf == 0 {
            write(2, "error: out of memory for interference graph\n", 44)
            exit(1)
        }
    }
    uint64 ig = ir_ig_buf
    memset(ig, 0, ig_needed)

    // Live-set scratch buffer — 1024 words * 8 B = 8 KB once.
    uint64 set_bytes = ir_live_words * 8
    if ir_color_tmp_buf == 0 {
        ir_color_tmp_cap = 1024 * 8
        ir_color_tmp_buf = alloc(ir_color_tmp_cap)
    }
    if set_bytes > ir_color_tmp_cap {
        write(2, "error: color tmp buffer overflow\n", 33)
        exit(1)
    }
    uint64 tmp = ir_color_tmp_buf

    uint64 bi = 0
    while bi < ir_bb_count {
        // Start with live_out for this block
        uint64 wi = 0
        while wi < ir_live_words {
            uint64 sp = ir_live_out + bi * set_bytes + wi * 8
            uint64 dp = tmp + wi * 8
            uint64 v = 0
            unsafe { *(sp as uint64) -> v }
            unsafe { *(dp as uint64) = v }
            wi = wi + 1
        }

        // Walk instructions in reverse order within this block using the
        // flat per-BB lists built by ir_compute_liveness (which always
        // runs immediately before regalloc; the BB lists are unchanged).
        uint64 first = ir_bb_first_insn(bi)
        if first != 0xFFFFFFFF {
            uint64 ig_off_p = ir_bb_list_off + bi * 4
            uint32 ig_off32 = 0
            unsafe { *(ig_off_p as uint32) -> ig_off32 }
            uint64 ig_end_p = ir_bb_list_off + (bi + 1) * 4
            uint32 ig_end32 = 0
            unsafe { *(ig_end_p as uint32) -> ig_end32 }
            uint64 ig_off = ig_off32
            uint64 ig_stack_n = ig_end32 - ig_off32
            while ig_stack_n > 0 {
                ig_stack_n = ig_stack_n - 1
                uint64 sp_ent = ir_bb_list_buf + (ig_off + ig_stack_n) * 4
                uint32 ii32 = 0
                unsafe { *(sp_ent as uint32) -> ii32 }
                uint64 ii = ii32

                // At this instruction, the dest vreg interferes with
                // everything currently live (except itself and copy sources)
                uint64 op = ir_insn_opcode(ii)
                if op == 0 { continue }   // LICM-elided slot
                if ir_insn_has_def(ii) != 0 {
                    uint64 dv = ir_insn_dest(ii)
                    if dv > 0 && dv < vcount {
                        // Add interference: dv <-> each live vreg
                        uint64 lw = 0
                        while lw < ir_live_words {
                            uint64 lp = tmp + lw * 8
                            uint64 lbits = 0
                            unsafe { *(lp as uint64) -> lbits }
                            // For each set bit, add interference
                            uint64 bits = lbits
                            while bits != 0 {
                                // Find lowest set bit (ctz via popcount)
                                uint64 iso_b = bits & (0 - bits)
                                uint64 bit_pos = ir_popcount64(iso_b - 1)
                                uint64 other = lw * 64 + bit_pos
                                if other != dv && other < vcount {
                                    // Set ig[dv][other] and ig[other][dv]
                                    uint64 r1 = ig + dv * row_bytes + (other / 64) * 8
                                    uint64 v1 = 0
                                    unsafe { *(r1 as uint64) -> v1 }
                                    v1 = v1 | (1 << (other & 63))
                                    unsafe { *(r1 as uint64) = v1 }
                                    uint64 r2 = ig + other * row_bytes + (dv / 64) * 8
                                    uint64 v2 = 0
                                    unsafe { *(r2 as uint64) -> v2 }
                                    v2 = v2 | (1 << (dv & 63))
                                    unsafe { *(r2 as uint64) = v2 }
                                }
                                // Clear this bit
                                bits = bits & ~(1 << bit_pos)
                            }
                            lw = lw + 1
                        }
                        // Remove dv from live set
                        uint64 dw = dv / 64
                        uint64 db = dv & 63
                        uint64 dp = tmp + dw * 8
                        uint64 dval = 0
                        unsafe { *(dp as uint64) -> dval }
                        dval = dval & ~(1 << db)
                        unsafe { *(dp as uint64) = dval }
                    }
                }

                // Add uses to live set
                uint64 u1 = ir_insn_src1(ii)
                if u1 > 0 && u1 < vcount && op != 1 && op != 79 {
                    uint64 uw = u1 / 64
                    uint64 ub = u1 & 63
                    uint64 up = tmp + uw * 8
                    uint64 uv = 0
                    unsafe { *(up as uint64) -> uv }
                    uv = uv | (1 << ub)
                    unsafe { *(up as uint64) = uv }
                }
                uint64 u2 = ir_insn_src2(ii)
                if u2 > 0 && u2 < vcount && op != 1 && op != 12 && op != 13 && op != 30 && op != 42 && op != 61 && op != 135 && op != 136 && op != 138 && (op < 140 || op > 145) {
                    uint64 uw = u2 / 64
                    uint64 ub = u2 & 63
                    uint64 up = tmp + uw * 8
                    uint64 uv = 0
                    unsafe { *(up as uint64) -> uv }
                    uv = uv | (1 << ub)
                    unsafe { *(up as uint64) = uv }
                }

                // Add imm-as-vreg use for MEMCPY(72), MEMSET(76), RET3(83), ATOMIC_CAS(93), FFMA(98)
                if op == 72 || op == 76 || op == 83 || op == 93 || op == 98 || op == 148 {
                    uint64 uimm = ir_insn_imm(ii)
                    if uimm > 0 && uimm < vcount {
                        uint64 uw = uimm / 64
                        uint64 ub = uimm & 63
                        uint64 up = tmp + uw * 8
                        uint64 uv = 0
                        unsafe { *(up as uint64) -> uv }
                        uv = uv | (1 << ub)
                        unsafe { *(up as uint64) = uv }
                    }
                }

            }
        }
        bi = bi + 1
    }

    // ----- Copy coalescing (aggressive) -----
    // For each IR_COPY (op 61) with a real src1 (i.e. reg-reg copy, not
    // a param load), if dest and src1 don't already interfere, union
    // them in ir_uf_parent so the greedy colorer assigns them the same
    // colour. The redundant `mov rN, rN` is then dropped by
    // ir_emit_mov_r64_r64's dst==src short-circuit (and the ARM64
    // equivalent). Aggressive Chaitin-style: we only check for direct
    // interference, no Briggs degree heuristic. If this ever triggers
    // extra spills, switch to conservative coalescing here.
    if ir_uf_cap < vcount {
        if ir_uf_parent != 0 { dealloc(ir_uf_parent) }
        ir_uf_cap = vcount
        if ir_uf_cap < 64 { ir_uf_cap = 64 }
        ir_uf_parent = alloc(ir_uf_cap * 4)
    }
    uint64 ufi = 0
    while ufi < vcount {
        uint64 ufp = ir_uf_parent + ufi * 4
        uint32 ufv = ufi
        unsafe { *(ufp as uint32) = ufv }
        ufi = ufi + 1
    }

    // Degree cache for Briggs: deg[v] = popcount(row[v]). Followers'
    // entries are kept in sync with their rep until they're absorbed.
    if ir_uf_deg_cap < vcount {
        if ir_uf_deg != 0 { dealloc(ir_uf_deg) }
        ir_uf_deg_cap = vcount
        if ir_uf_deg_cap < 64 { ir_uf_deg_cap = 64 }
        ir_uf_deg = alloc(ir_uf_deg_cap * 4)
    }
    uint64 dgi = 0
    while dgi < vcount {
        uint64 dsum = 0
        uint64 dw = 0
        while dw < row_words {
            uint64 dpp = ig + dgi * row_bytes + dw * 8
            uint64 dvv = 0
            unsafe { *(dpp as uint64) -> dvv }
            dsum = dsum + ir_popcount64(dvv)
            dw = dw + 1
        }
        uint64 dgp = ir_uf_deg + dgi * 4
        uint32 dg32 = dsum
        unsafe { *(dgp as uint32) = dg32 }
        dgi = dgi + 1
    }

    uint64 cii = 0
    while cii < ir_insn_count && ir_coalesce_enabled != 0 {
        uint64 cop = ir_insn_opcode(cii)
        if cop == 61 {
            uint64 cdv = ir_insn_dest(cii)
            uint64 csv = ir_insn_src1(cii)
            if cdv != 0 && csv != 0 && cdv < vcount && csv < vcount {
                uint64 crd = ir_uf_find(cdv)
                uint64 crs = ir_uf_find(csv)
                if crd != crs {
                    // Test interference: bit (crs & 63) in row[crd] word (crs/64).
                    uint64 cip = ig + crd * row_bytes + (crs / 64) * 8
                    uint64 civ = 0
                    unsafe { *(cip as uint64) -> civ }
                    uint64 inter = (civ >> (crs & 63)) & 1
                    if inter == 0 {
                        // Always make the LOWER vreg the rep so it gets
                        // coloured first in the sequential walk below.
                        // Otherwise, when greedy colours an intermediate
                        // vreg vN with crs < vN < crd as a neighbour of
                        // crs, ir_uf_find(crs) returns crd which is still
                        // 0xFFFFFFFF — the constraint is missed and vN
                        // can collide with crd's eventual colour.
                        uint64 keep = crd
                        uint64 drop = crs
                        if crs < crd { keep = crs; drop = crd }

                        // Briggs conservative gate: count neighbours of
                        // (row[keep] | row[drop]) whose current degree is
                        // >= K. If fewer than K such neighbours, the merged
                        // node is K-colourable on its own — safe to merge.
                        // Otherwise refuse: the merge would over-constrain
                        // the colourer and likely force a spill. Followers'
                        // own deg slots are stale (zeroed at drop time), so
                        // every degree lookup goes through ir_uf_find first.
                        // K for THIS merge is the tightest ceiling of the two
                        // nodes, not the global IR_NUM_REGS. A vreg capped by
                        // ir_color_ceil (xtensa gives call-crossing values and
                        // parameters only the callee-saved prefix) can take
                        // fewer colours than the file has, so judging the merge
                        // against the full file would approve one whose result
                        // cannot be coloured — and the merged node then spills.
                        // ir_color_ceil_get returns IR_NUM_REGS when unset, so
                        // this is identical to the old behaviour for every
                        // uncapped merge and on every arch that sets no ceilings.
                        uint64 keff = ir_color_ceil_get(keep)
                        uint64 deff = ir_color_ceil_get(drop)
                        if deff < keff { keff = deff }
                        uint64 hd = 0
                        uint64 bw = 0
                        while bw < row_words {
                            uint64 ba = ig + keep * row_bytes + bw * 8
                            uint64 bav = 0
                            unsafe { *(ba as uint64) -> bav }
                            uint64 bb = ig + drop * row_bytes + bw * 8
                            uint64 bbv = 0
                            unsafe { *(bb as uint64) -> bbv }
                            uint64 cb = bav | bbv
                            // Drop self-bits so keep/drop don't count themselves.
                            if (bw == keep / 64) { cb = cb & ~(1 << (keep & 63)) }
                            if (bw == drop / 64) { cb = cb & ~(1 << (drop & 63)) }
                            while cb != 0 {
                                uint64 iso_cb = cb & (0 - cb)
                                uint64 sp = ir_popcount64(iso_cb - 1)
                                uint64 nidx = bw * 64 + sp
                                if nidx < vcount {
                                    uint64 nrep = ir_uf_find(nidx)
                                    uint64 ndp = ir_uf_deg + nrep * 4
                                    uint32 ndg32 = 0
                                    unsafe { *(ndp as uint32) -> ndg32 }
                                    if ndg32 >= IR_NUM_REGS { hd = hd + 1 }
                                }
                                cb = cb & ~(1 << sp)
                            }
                            bw = bw + 1
                        }
                        if hd >= keff {
                            // George fallback: less conservative than Briggs.
                            // Try both directions: for every neighbour t of A
                            // (excluding B), t must interfere with B OR have
                            // deg[t] < K. If either direction passes, the merge
                            // is safe — neighbours of A either already saw a
                            // K-colourable constraint via B, or are low-degree
                            // and stay easy regardless of the new edge.
                            //
                            // Skip George when K is small (x86: K=6). Empirically
                            // George's extra merges cost more in spills than they
                            // save in elided MOVs once K drops below ~8 — the
                            // colourer has too little slack to absorb the new
                            // edges. ARM64 (K=10) sees ~800 B extra win from
                            // George; x86 sees ~900 B regression.
                            if keff < 8 {
                                cii = cii + 1
                                continue
                            }
                            uint64 g_a = keep; uint64 g_b = drop
                            uint64 g_pass = 0
                            uint64 g_try = 0
                            while g_try < 2 {
                                uint64 ok = 1
                                uint64 gw = 0
                                while gw < row_words {
                                    uint64 gap = ig + g_a * row_bytes + gw * 8
                                    uint64 gav = 0
                                    unsafe { *(gap as uint64) -> gav }
                                    uint64 gbp = ig + g_b * row_bytes + gw * 8
                                    uint64 gbv = 0
                                    unsafe { *(gbp as uint64) -> gbv }
                                    if gw == g_b / 64 { gav = gav & ~(1 << (g_b & 63)) }
                                    if gw == g_a / 64 { gav = gav & ~(1 << (g_a & 63)) }
                                    while gav != 0 && ok != 0 {
                                        uint64 iso_g = gav & (0 - gav)
                                        uint64 sp = ir_popcount64(iso_g - 1)
                                        uint64 nidx = gw * 64 + sp
                                        if nidx < vcount {
                                            uint64 in_b = (gbv >> sp) & 1
                                            uint64 nrep = ir_uf_find(nidx)
                                            uint64 ndp = ir_uf_deg + nrep * 4
                                            uint32 ndg = 0
                                            unsafe { *(ndp as uint32) -> ndg }
                                            if in_b == 0 && ndg >= IR_NUM_REGS { ok = 0 }
                                        }
                                        gav = gav & ~(1 << sp)
                                    }
                                    if ok == 0 { gw = row_words } else { gw = gw + 1 }
                                }
                                if ok != 0 { g_pass = 1; g_try = 2 }
                                else {
                                    // swap A and B for the second attempt
                                    g_a = drop; g_b = keep
                                    g_try = g_try + 1
                                }
                            }
                            if g_pass == 0 {
                                cii = cii + 1
                                continue
                            }
                        }

                        // Merge: row[keep] |= row[drop]; for every neighbor
                        // n in row[drop], set IG[n][keep] so foreign rows
                        // also see keep as a neighbor of every node that
                        // used to neighbor drop. Update degree cache:
                        // for each n in row[drop], decrement deg[n] iff n
                        // was already a neighbour of keep (the two edges
                        // collapse to one). New row[keep] popcount becomes
                        // deg[keep]; deg[drop] becomes 0.
                        uint64 new_keep_deg = 0
                        uint64 mw = 0
                        while mw < row_words {
                            uint64 sa = ig + drop * row_bytes + mw * 8
                            uint64 sav = 0
                            unsafe { *(sa as uint64) -> sav }
                            uint64 da = ig + keep * row_bytes + mw * 8
                            uint64 dav = 0
                            unsafe { *(da as uint64) -> dav }
                            uint64 common = sav & dav
                            if sav != 0 {
                                unsafe { *(da as uint64) = dav | sav }
                                uint64 sb = sav
                                while sb != 0 {
                                    uint64 iso_s = sb & (0 - sb)
                                    uint64 sp = ir_popcount64(iso_s - 1)
                                    uint64 nidx = mw * 64 + sp
                                    if nidx != keep && nidx < vcount {
                                        uint64 nrp = ig + nidx * row_bytes + (keep / 64) * 8
                                        uint64 nrv = 0
                                        unsafe { *(nrp as uint64) -> nrv }
                                        nrv = nrv | (1 << (keep & 63))
                                        unsafe { *(nrp as uint64) = nrv }
                                        // Common neighbour: both edges collapse.
                                        if ((common >> sp) & 1) != 0 {
                                            uint64 ndp = ir_uf_deg + nidx * 4
                                            uint32 ndg = 0
                                            unsafe { *(ndp as uint32) -> ndg }
                                            if ndg > 0 { ndg = ndg - 1 }
                                            unsafe { *(ndp as uint32) = ndg }
                                        }
                                    }
                                    sb = sb & ~(1 << sp)
                                }
                            }
                            uint64 da2 = ig + keep * row_bytes + mw * 8
                            uint64 da2v = 0
                            unsafe { *(da2 as uint64) -> da2v }
                            new_keep_deg = new_keep_deg + ir_popcount64(da2v)
                            mw = mw + 1
                        }
                        uint64 dkp = ir_uf_deg + keep * 4
                        uint32 dk32 = new_keep_deg
                        unsafe { *(dkp as uint32) = dk32 }
                        uint64 ddp = ir_uf_deg + drop * 4
                        uint32 dd32 = 0
                        unsafe { *(ddp as uint32) = dd32 }

                        // Union: parent[drop] = keep (high → low)
                        uint64 ufpp = ir_uf_parent + drop * 4
                        uint32 ufpw = keep
                        unsafe { *(ufpp as uint32) = ufpw }
                    }
                }
            }
        }
        cii = cii + 1
    }

    // Coalescing is final now, so fold every follower's colour ceiling into
    // its representative before anything is coloured.
    ir_color_ceil_to_reps(vcount)

    // Greedy coloring: for each vreg, assign the lowest color not used
    // by any interfering neighbor. Followers (uf_find(vi) != vi) are
    // skipped; their colour is propagated from their rep below.
    uint64 vi = 0
    while vi < vcount {
        uint64 rp = ir_reg_assign + vi * 4
        uint32 spill = 0xFFFFFFFF
        unsafe { *(rp as uint32) = spill }
        vi = vi + 1
    }

    // Colouring ORDER is a spill-cost heuristic. The old ascending-index
    // walk let function-lifetime vregs (created first during lowering)
    // seize every colour before the loop-carried values created deep in
    // the function got a look-in — exactly backwards for hot loops.
    // Order reps by saturating use count (ir_compute_use_count, 0..255)
    // DESCENDING instead: a value read 60 times beats one read twice.
    // Stable within a weight class (ascending index), so functions whose
    // vregs all have equal counts colour exactly as before. Any order is
    // CORRECT: interference rows are symmetric and every neighbour
    // lookup resolves through the union-find rep, so whichever endpoint
    // colours second sees the first's colour; the order is only a
    // priority. Counting sort keeps this O(vcount).
    if ir_color_order_buf == 0 {
        ir_color_order_buf = alloc(65536 * 4)
    }
    uint64[256] uc_start
    uint64 wci = 0
    while wci < 256 {
        uint64 wcp = uc_start + wci * 8
        unsafe { *(wcp as uint64) = 0 }
        wci = wci + 1
    }
    // Pass 1: histogram of rep weights.
    vi = 1
    while vi < vcount {
        if ir_uf_find(vi) == vi {
            uint64 w = ir_use_count_get(vi)
            uint64 wcp = uc_start + w * 8
            uint64 wcv = 0
            unsafe { *(wcp as uint64) -> wcv }
            unsafe { *(wcp as uint64) = wcv + 1 }
        }
        vi = vi + 1
    }
    // Descending prefix sums: weight 255 first.
    uint64 uc_pos = 0
    uint64 wdi = 256
    while wdi > 0 {
        wdi = wdi - 1
        uint64 wcp = uc_start + wdi * 8
        uint64 wcv = 0
        unsafe { *(wcp as uint64) -> wcv }
        unsafe { *(wcp as uint64) = uc_pos }
        uc_pos = uc_pos + wcv
    }
    uint64 order_n = uc_pos
    // Pass 2: place reps, ascending index within each weight class.
    vi = 1
    while vi < vcount {
        if ir_uf_find(vi) == vi {
            uint64 w = ir_use_count_get(vi)
            uint64 wcp = uc_start + w * 8
            uint64 slot = 0
            unsafe { *(wcp as uint64) -> slot }
            uint64 op2 = ir_color_order_buf + slot * 4
            uint32 vi32 = vi
            unsafe { *(op2 as uint32) = vi32 }
            unsafe { *(wcp as uint64) = slot + 1 }
        }
        vi = vi + 1
    }

    uint64 oi2 = 0
    while oi2 < order_n {
        uint64 oep = ir_color_order_buf + oi2 * 4
        uint32 ov32 = 0
        unsafe { *(oep as uint32) -> ov32 }
        vi = ov32
        oi2 = oi2 + 1
        // Collect colors used by interfering neighbors
        uint64 used_colors = 0
        uint64 nw = 0
        while nw < row_words {
            uint64 np = ig + vi * row_bytes + nw * 8
            uint64 nbits = 0
            unsafe { *(np as uint64) -> nbits }
            while nbits != 0 {
                uint64 iso_n = nbits & (0 - nbits)
                uint64 bp = ir_popcount64(iso_n - 1)
                uint64 neighbor = nw * 64 + bp
                if neighbor < vcount {
                    // Look up rep's colour — followers haven't been
                    // assigned yet but their rep may have been.
                    uint64 nrep = ir_uf_find(neighbor)
                    uint64 nrp = ir_reg_assign + nrep * 4
                    uint32 nc = 0
                    unsafe { *(nrp as uint32) -> nc }
                    uint64 wnc = nc
                    if wnc < IR_NUM_REGS {
                        used_colors = used_colors | (1 << wnc)
                    }
                }
                nbits = nbits & ~(1 << bp)
            }
            nw = nw + 1
        }

        // Find lowest available color, honouring this vreg's ceiling (see
        // ir_color_ceil). A vreg whose whole permitted range is taken stays
        // 0xFFFFFFFF and spills, exactly as if the file were that narrow.
        uint64 ceil_vi = ir_color_ceil_get(vi)
        uint64 color = 0
        while color < ceil_vi {
            if (used_colors & (1 << color)) == 0 {
                uint64 arp = ir_reg_assign + vi * 4
                uint32 cv = color
                unsafe { *(arp as uint32) = cv }
                color = ceil_vi  // break
            }
            color = color + 1
        }
    }

    // Propagate rep colours to followers so ir_get_phys_reg works
    // uniformly for every vreg.
    vi = 1
    while vi < vcount {
        uint64 rep = ir_uf_find(vi)
        if rep != vi {
            uint64 rrp = ir_reg_assign + rep * 4
            uint32 rc = 0
            unsafe { *(rrp as uint32) -> rc }
            uint64 frp = ir_reg_assign + vi * 4
            unsafe { *(frp as uint32) = rc }
        }
        vi = vi + 1
    }
}

// ---------------------------------------------------------------------------
// x86_64 machine code emission helpers
// ---------------------------------------------------------------------------

// REX prefix: W=1 always. R=1 if reg1>=8. B=1 if reg2>=8.
fn ir_x86_rex(uint64 reg1, uint64 reg2) -> uint8 {
    uint8 rex = 0x48
    if reg1 >= 8 { rex = rex | 4 }
    if reg2 >= 8 { rex = rex | 1 }
    return rex
}

fn ir_x86_modrm_rr(uint64 reg, uint64 rm) -> uint8 {
    uint64 v = 0xC0 | ((reg & 7) << 3) | (rm & 7)
    uint8 r = v
    return r
}

fn ir_emit_mov_r64_r64(uint64 dst, uint64 src) {
    if dst == src { return }
    emit_byte(ir_x86_rex(src, dst))
    emit_byte(0x89)
    emit_byte(ir_x86_modrm_rr(src, dst))
}

fn ir_emit_mov_r64_imm64(uint64 dst, uint64 imm) {
    // Encoding choices, smallest first:
    //   imm fits in uint32               → B8+r imm32          (5 or 6 bytes, zero-extends)
    //   imm fits in sign-extended int32  → REX.W C7 /0 imm32   (7 bytes, sign-extends)
    //   otherwise                        → REX.W B8+r imm64    (10 bytes, full movabsq)
    if imm <= 0xFFFFFFFF {
        if dst >= 8 { emit_byte(0x41) }              // REX.B only (no W — 32-bit op zero-extends)
        uint64 opc32 = 0xB8 | (dst & 7)
        uint8 op32 = opc32
        emit_byte(op32)
        emit_u32_le(imm)
        return
    }
    if (imm >> 31) == 0x1FFFFFFFF {
        uint8 rex = 0x48
        if dst >= 8 { rex = rex | 1 }
        emit_byte(rex)
        emit_byte(0xC7)
        uint64 modrm = 0xC0 | (dst & 7)
        uint8 m = modrm
        emit_byte(m)
        emit_u32_le(imm & 0xFFFFFFFF)
        return
    }
    uint8 rex = 0x48
    if dst >= 8 { rex = rex | 1 }
    emit_byte(rex)
    uint64 opc = 0xB8 | (dst & 7)
    uint8 opcode = opc
    emit_byte(opcode)
    emit_u64_le(imm)
}

fn ir_emit_add_r64_r64(uint64 dst, uint64 src) {
    emit_byte(ir_x86_rex(src, dst))
    emit_byte(0x01)
    emit_byte(ir_x86_modrm_rr(src, dst))
}

fn ir_emit_sub_r64_r64(uint64 dst, uint64 src) {
    emit_byte(ir_x86_rex(src, dst))
    emit_byte(0x29)
    emit_byte(ir_x86_modrm_rr(src, dst))
}

fn ir_emit_cmp_r64_r64(uint64 a, uint64 b) {
    emit_byte(ir_x86_rex(b, a))
    emit_byte(0x39)
    emit_byte(ir_x86_modrm_rr(b, a))
}

// Emit `cmp r64, imm` with the smallest applicable encoding:
//   imm == 0                        → `test r,r`     (3 bytes)
//   -128 <= signed(imm) <= 127      → `cmp r/m64, imm8`  (4 bytes)
//   otherwise (signed-32 fits)      → `cmp r/m64, imm32` (7 bytes)
// Caller must have already verified the imm fits in signed 32 bits.
fn ir_emit_cmp_r64_imm(uint64 a, uint64 imm) {
    if imm == 0 {
        // test r/m64, r64 = REX.W 85 /r — same opcode as the helper.
        ir_emit_test_r64_r64(a, a)
        return
    }
    uint8 rex = 0x48
    if a >= 8 { rex = rex | 1 }
    uint64 use_imm8 = 0
    if imm <= 127 { use_imm8 = 1 }
    if imm >= 0xFFFFFFFFFFFFFF80 { use_imm8 = 1 }
    if use_imm8 != 0 {
        // 83 /7 ib
        emit_byte(rex)
        emit_byte(0x83)
        uint64 mv = 0xC0 | (7 << 3) | (a & 7)
        uint8 modrm = mv
        emit_byte(modrm)
        uint8 d8 = imm
        emit_byte(d8)
    } else {
        // 81 /7 id
        emit_byte(rex)
        emit_byte(0x81)
        uint64 mv = 0xC0 | (7 << 3) | (a & 7)
        uint8 modrm = mv
        emit_byte(modrm)
        emit_u32_le(imm)
    }
}

fn ir_emit_test_r64_r64(uint64 a, uint64 b) {
    emit_byte(ir_x86_rex(b, a))
    emit_byte(0x85)
    emit_byte(ir_x86_modrm_rr(b, a))
}

fn ir_emit_imul_r64_r64(uint64 dst, uint64 src) {
    emit_byte(ir_x86_rex(dst, src))
    emit_byte(0x0F)
    emit_byte(0xAF)
    emit_byte(ir_x86_modrm_rr(dst, src))
}

// Emit `lea dst, [src + disp]` where disp is a signed-32-bit displacement
// stored in a uint64. Handles RSP/R12 base registers (which require a SIB
// byte) and picks disp8 vs disp32 to minimize bytes. Caller must have
// verified disp fits in signed 32-bit and is non-zero (zero disp would
// emit LEA-as-copy which is pointless — caller should rewrite to MOV).
fn ir_emit_lea_disp(uint64 dst, uint64 src, uint64 disp) {
    uint8 rex = 0x48
    if dst >= 8 { rex = rex | 4 }
    if src >= 8 { rex = rex | 1 }
    emit_byte(rex)
    emit_byte(0x8D)

    uint64 src_lo = src & 7
    uint64 dst_lo = dst & 7

    // disp8 if disp is in [-128, 127] as a signed value.
    uint64 use_disp8 = 0
    if disp <= 127 { use_disp8 = 1 }
    if disp >= 0xFFFFFFFFFFFFFF80 { use_disp8 = 1 }

    if src_lo == 4 {
        // base register encoded as RSP (rsp/r12) — ModRM r/m=100 means a
        // SIB byte follows. SIB 0x24 = scale=00, index=100 (no index),
        // base=100 (the actual base register).
        if use_disp8 != 0 {
            uint64 mv = 0x44 | (dst_lo << 3)
            uint8 modrm = mv
            emit_byte(modrm)
            emit_byte(0x24)
            uint8 d8 = disp
            emit_byte(d8)
        } else {
            uint64 mv = 0x84 | (dst_lo << 3)
            uint8 modrm = mv
            emit_byte(modrm)
            emit_byte(0x24)
            emit_u32_le(disp)
        }
        return
    }

    // base register encoded as RBP (rbp/r13) with no displacement collides
    // with the RIP-relative encoding (mod=00, r/m=101). Force a disp8 of 0
    // when disp would otherwise be elided. Our caller guarantees disp != 0,
    // so the disp8 path is always safe — no special case needed.

    if use_disp8 != 0 {
        uint64 mv = 0x40 | (dst_lo << 3) | src_lo
        uint8 modrm = mv
        emit_byte(modrm)
        uint8 d8 = disp
        emit_byte(d8)
    } else {
        uint64 mv = 0x80 | (dst_lo << 3) | src_lo
        uint8 modrm = mv
        emit_byte(modrm)
        emit_u32_le(disp)
    }
}

fn ir_emit_neg_r64(uint64 reg) {
    uint8 rex = 0x48
    if reg >= 8 { rex = rex | 1 }
    emit_byte(rex)
    emit_byte(0xF7)
    uint64 v = 0xC0 | (3 << 3) | (reg & 7)
    uint8 modrm = v
    emit_byte(modrm)
}

fn ir_emit_not_r64(uint64 reg) {
    uint8 rex = 0x48
    if reg >= 8 { rex = rex | 1 }
    emit_byte(rex)
    emit_byte(0xF7)
    uint64 v = 0xC0 | (2 << 3) | (reg & 7)
    uint8 modrm = v
    emit_byte(modrm)
}

// ---------------------------------------------------------------------------
// XMM register class — f64 homes in xmm2..xmm15 (x86_64)
// ---------------------------------------------------------------------------
// Mirror of the arm64 d8-d15 register class (ir_a64_fpr_alloc): a second
// greedy colouring over the SAME interference graph ir_graph_color built,
// restricted to f64 vregs, handing out xmm2..xmm15 homes. xmm0/xmm1 stay
// reserved as the float scratch pair every float handler already uses
// (and xmm0 is the SysV float-return register).
//
// THE x86 DIFFERENCE FROM ARM64: SysV x86-64 has NO callee-saved XMM
// registers — a call may destroy all of xmm0-xmm15. So an xmm home is
// only sound for a vreg that is never live across an instruction that
// can reach a call. ir_x86_xmm_mark_unsafe walks liveness at INSTRUCTION
// level (block level is not enough — same lesson as
// ir_seed_wide_ceilings_generic) and disqualifies every vreg live across
// a non-widesafe op: the audited whitelist ir_x86_op_widesafe guarantees
// a listed op touches nothing outside {rax, rcx, rdx, xmm0, xmm1} plus
// allocator-owned operands, so in particular it never touches
// xmm2-xmm15; everything else (calls, syscalls, helper loops, Windows
// IAT ops, asm blocks) is treated as clobbering the whole XMM file.
// The upside of all-caller-saved homes: prologue/epilogue need no
// changes at all.
//
// Enforcement is funnel-based, not per-handler: a homed vreg has its GPR
// colour forcibly cleared to "spilled" (step 5 of ir_x86_xmm_alloc), so
// every one of the ~70 op handlers reads it through ir_resolve_src /
// ir_emit_load_spill and writes it through ir_emit_store_spill — and
// those funnels redirect to the xmm home (movq) instead of the stack
// slot. The float handlers additionally use the FP funnels
// (ir_resolve_src_x / ir_xmm_dest_x / ir_store_dest_x) so f64 arithmetic
// runs xmm-to-xmm with no GPR bounce. The ONE audited emitter that reads
// spill slots directly instead of going through the funnels — the
// >6-arg overflow path in IR_CALL — has an explicit home check at the
// site. (The asm in()-group pusher also reads slots directly, but asm
// functions never get xmm homes: same gate as the wide GPR file.)
static uint64 ir_xmm_map = 0
static uint64 ir_xmm_map_cap = 0
static uint64 ir_xmm_on = 0
static uint64 ir_xmm_block_buf = 0
static uint64 ir_xmm_block_cap = 0

// XMM home for a vreg (2..15), or 0xFFFFFFFF when it has none.
fn ir_x86_xmm_home(uint64 vreg) -> uint64 {
    if ir_xmm_on == 0 { return 0xFFFFFFFF }
    if vreg == 0 { return 0xFFFFFFFF }
    if vreg >= ir_vreg_next { return 0xFFFFFFFF }
    uint64 p = ir_xmm_map + vreg
    uint8 c = 0
    unsafe { *(p as uint8) -> c }
    uint64 wc = c
    if wc == 0 { return 0xFFFFFFFF }
    return wc
}

// movq xmm, r64 (66 REX.W 0F 6E /r) — GPR bit pattern into an XMM reg.
fn ir_emit_movq_x_r(uint64 xr, uint64 gr) {
    uint8 rex = 0x48
    if xr >= 8 { rex = rex | 4 }
    if gr >= 8 { rex = rex | 1 }
    emit_byte(0x66)
    emit_byte(rex)
    emit_byte(0x0F)
    emit_byte(0x6E)
    uint64 m = 0xC0 | ((xr & 7) << 3) | (gr & 7)
    uint8 mb = m
    emit_byte(mb)
}

// movq r64, xmm (66 REX.W 0F 7E /r) — XMM low 64 bits into a GPR.
fn ir_emit_movq_r_x(uint64 gr, uint64 xr) {
    uint8 rex = 0x48
    if xr >= 8 { rex = rex | 4 }
    if gr >= 8 { rex = rex | 1 }
    emit_byte(0x66)
    emit_byte(rex)
    emit_byte(0x0F)
    emit_byte(0x7E)
    uint64 m = 0xC0 | ((xr & 7) << 3) | (gr & 7)
    uint8 mb = m
    emit_byte(mb)
}

// Generic SSE reg,reg emitter: [pfx] [REX] 0F opc modrm. pfx 0 = none.
// The optional REX (only when a register is xmm8+) must sit BETWEEN the
// mandatory prefix and 0F, which is why the prefix is passed in.
fn ir_emit_sse_rr(uint64 pfx, uint64 opc, uint64 xd, uint64 xs) {
    if pfx != 0 {
        uint8 pb = pfx
        emit_byte(pb)
    }
    uint64 rex = 0x40
    if xd >= 8 { rex = rex | 4 }
    if xs >= 8 { rex = rex | 1 }
    if rex != 0x40 {
        uint8 rb = rex
        emit_byte(rb)
    }
    emit_byte(0x0F)
    uint8 ob = opc
    emit_byte(ob)
    uint64 m = 0xC0 | ((xd & 7) << 3) | (xs & 7)
    uint8 mb = m
    emit_byte(mb)
}

// movaps xdst, xsrc — full-register XMM copy, self-move elided.
fn ir_emit_movaps_x_x(uint64 xd, uint64 xs) {
    if xd == xs { return }
    ir_emit_sse_rr(0, 0x28, xd, xs)
}

// movsd xmm, [rsp+off] — spilled f64 straight into the FP file.
fn ir_emit_movsd_x_sp(uint64 xr, uint64 off) {
    emit_byte(0xF2)
    if xr >= 8 { emit_byte(0x44) }
    emit_byte(0x0F)
    emit_byte(0x10)
    if off < 128 {
        uint64 m = 0x44 | ((xr & 7) << 3)
        uint8 mb = m
        emit_byte(mb)
        emit_byte(0x24)
        uint8 o8 = off
        emit_byte(o8)
    } else {
        uint64 m = 0x84 | ((xr & 7) << 3)
        uint8 mb = m
        emit_byte(mb)
        emit_byte(0x24)
        emit_u32_le(off)
    }
}

// movsd [rsp+off], xmm — spill an f64 without a GPR bounce.
fn ir_emit_movsd_sp_x(uint64 off, uint64 xr) {
    emit_byte(0xF2)
    if xr >= 8 { emit_byte(0x44) }
    emit_byte(0x0F)
    emit_byte(0x11)
    if off < 128 {
        uint64 m = 0x44 | ((xr & 7) << 3)
        uint8 mb = m
        emit_byte(mb)
        emit_byte(0x24)
        uint8 o8 = off
        emit_byte(o8)
    } else {
        uint64 m = 0x84 | ((xr & 7) << 3)
        uint8 mb = m
        emit_byte(mb)
        emit_byte(0x24)
        emit_u32_le(off)
    }
}

// Resolve a vreg for use as a float operand in an XMM register: its home
// when it has one, else materialise into the given scratch (0=xmm0,
// 1=xmm1). Spilled floats load slot→XMM directly. (Safe against the GPR
// spill peephole: ir_emit_store_spill always writes memory before it
// records, so the slot is never stale.)
fn ir_resolve_src_x(uint64 vreg, uint64 xscratch) -> uint64 {
    if vreg == 0 { return xscratch }
    uint64 xh = ir_x86_xmm_home(vreg)
    if xh != 0xFFFFFFFF { return xh }
    uint64 phys = ir_get_phys_reg(vreg)
    if phys != 0xFFFFFFFF {
        ir_emit_movq_x_r(xscratch, phys)
        return xscratch
    }
    ir_emit_movsd_x_sp(xscratch, ir_spill_offset(vreg))
    return xscratch
}

// Where an FP op should compute its result: the dest's home if any
// (ir_store_dest_x is then a movaps-elided no-op), else the scratch.
fn ir_xmm_dest_x(uint64 vreg, uint64 xscratch) -> uint64 {
    uint64 xh = ir_x86_xmm_home(vreg)
    if xh != 0xFFFFFFFF { return xh }
    return xscratch
}

// Finish an FP op whose result sits in xsrc.
fn ir_store_dest_x(uint64 vreg, uint64 xsrc) {
    uint64 xh = ir_x86_xmm_home(vreg)
    if xh != 0xFFFFFFFF {
        ir_emit_movaps_x_x(xh, xsrc)
        return
    }
    uint64 phys = ir_get_phys_reg(vreg)
    if phys != 0xFFFFFFFF {
        ir_emit_movq_r_x(phys, xsrc)
        return
    }
    ir_emit_movsd_sp_x(ir_spill_offset(vreg), xsrc)
}

// Disqualify from XMM homes every vreg live ACROSS an xmm-dirty
// instruction — any op NOT on the ir_x86_op_widesafe whitelist may reach
// a call, and every XMM register is caller-saved on SysV x86-64. Marks
// union-find REPRESENTATIVES in ir_xmm_block_buf.
//
// Backward instruction-level walk cloned from
// ir_seed_wide_ceilings_generic. The live-set update rules MUST mirror
// ir_graph_color's interference builder (same src1/src2 payload
// exclusions, same imm-as-vreg ops) — keep all three in sync — or
// liveness is under-approximated and a home gets handed to a value a
// call destroys.
//
// The dirty insn's own dest is exempt: its value is written AFTER the
// clobber (a call result moves out of rax after the call returns), and
// every operand read the emitted code performs happens before the call
// instruction itself (ARG moves / pointer resolves all precede it).
fn ir_x86_xmm_mark_unsafe() {
    uint64 vcount = ir_vreg_next
    uint64 set_bytes = ir_live_words * 8
    if ir_seed_live_buf == 0 {
        ir_seed_live_cap = 1024 * 8
        ir_seed_live_buf = alloc(ir_seed_live_cap)
    }
    if set_bytes > ir_seed_live_cap {
        write(2, "error: xmm live buffer overflow\n", 32)
        exit(1)
    }
    uint64 tmp = ir_seed_live_buf
    uint64 b = 0
    while b < ir_bb_count {
        // Fast scan: any dirty op in this block at all?
        uint64 dirty = 0
        uint64 i = ir_bb_first_insn(b)
        while i != 0xFFFFFFFF {
            if ir_x86_op_widesafe(ir_insn_opcode(i)) == 0 { dirty = 1 }
            i = ir_insn_next(i)
        }
        if dirty != 0 {
            // live = live_out[bb]
            uint64 wi = 0
            while wi < ir_live_words {
                uint64 sp = ir_live_out + b * set_bytes + wi * 8
                uint64 dp = tmp + wi * 8
                uint64 v = 0
                unsafe { *(sp as uint64) -> v }
                unsafe { *(dp as uint64) = v }
                wi = wi + 1
            }
            // Backward walk over the block's flat instruction list.
            uint64 off_p = ir_bb_list_off + b * 4
            uint32 off32 = 0
            unsafe { *(off_p as uint32) -> off32 }
            uint64 end_p = ir_bb_list_off + (b + 1) * 4
            uint32 end32 = 0
            unsafe { *(end_p as uint32) -> end32 }
            uint64 loff = off32
            uint64 n = end32 - off32
            while n > 0 {
                n = n - 1
                uint64 ent = ir_bb_list_buf + (loff + n) * 4
                uint32 ii32 = 0
                unsafe { *(ent as uint32) -> ii32 }
                uint64 ii = ii32
                uint64 op = ir_insn_opcode(ii)
                if op == 0 { continue }
                if ir_x86_op_widesafe(op) == 0 {
                    // Everything live AFTER the dirty op, except its
                    // own dest, loses XMM-home eligibility.
                    uint64 dd = 0
                    if ir_insn_has_def(ii) != 0 { dd = ir_insn_dest(ii) }
                    uint64 mw = 0
                    while mw < ir_live_words {
                        uint64 mp = tmp + mw * 8
                        uint64 mbits = 0
                        unsafe { *(mp as uint64) -> mbits }
                        while mbits != 0 {
                            uint64 iso = mbits & (0 - mbits)
                            uint64 bp = ir_popcount64(iso - 1)
                            uint64 mv = mw * 64 + bp
                            if mv > 0 && mv < vcount && mv != dd {
                                uint64 mrep = ir_uf_find(mv)
                                uint64 bp2 = ir_xmm_block_buf + mrep
                                uint8 mone = 1
                                unsafe { *(bp2 as uint8) = mone }
                            }
                            mbits = mbits & ~(1 << bp)
                        }
                        mw = mw + 1
                    }
                }
                // Live-set update — mirror of ir_graph_color's builder.
                if ir_insn_has_def(ii) != 0 {
                    uint64 dv = ir_insn_dest(ii)
                    if dv > 0 && dv < vcount {
                        uint64 dw = dv / 64
                        uint64 dp2 = tmp + dw * 8
                        uint64 dval = 0
                        unsafe { *(dp2 as uint64) -> dval }
                        dval = dval & ~(1 << (dv & 63))
                        unsafe { *(dp2 as uint64) = dval }
                    }
                }
                uint64 u1 = ir_insn_src1(ii)
                if u1 > 0 && u1 < vcount && op != 1 && op != 79 {
                    uint64 up = tmp + (u1 / 64) * 8
                    uint64 uv = 0
                    unsafe { *(up as uint64) -> uv }
                    uv = uv | (1 << (u1 & 63))
                    unsafe { *(up as uint64) = uv }
                }
                uint64 u2 = ir_insn_src2(ii)
                if u2 > 0 && u2 < vcount && op != 1 && op != 12 && op != 13 && op != 30 && op != 42 && op != 61 && op != 135 && op != 136 && op != 138 && (op < 140 || op > 145) {
                    uint64 up = tmp + (u2 / 64) * 8
                    uint64 uv = 0
                    unsafe { *(up as uint64) -> uv }
                    uv = uv | (1 << (u2 & 63))
                    unsafe { *(up as uint64) = uv }
                }
                if op == 72 || op == 76 || op == 83 || op == 93 || op == 98 || op == 148 {
                    uint64 uimm = ir_insn_imm(ii)
                    if uimm > 0 && uimm < vcount {
                        uint64 up = tmp + (uimm / 64) * 8
                        uint64 uv = 0
                        unsafe { *(up as uint64) -> uv }
                        uv = uv | (1 << (uimm & 63))
                        unsafe { *(up as uint64) = uv }
                    }
                }
            }
        }
        b = b + 1
    }
}

// Hand out xmm2..xmm15 homes to eligible f64 representatives, propagate
// to followers, then evict homed vregs from the GPR file so every
// existing handler funnels through the (redirecting) spill helpers.
// `enable` is 0 for @naked / inline-asm functions — the same gate as the
// wide GPR file (an asm block can name any xmm register).
//
// Runs for EVERY x86 function, even all-integer ones (then it only
// clears the map — cheap), so a stale map from the previous function
// can never leak into this one.
fn ir_x86_xmm_alloc(uint64 enable) {
    uint64 vcount = ir_vreg_next
    ir_xmm_on = 0
    if ir_xmm_map == 0 {
        ir_xmm_map_cap = 65536
        ir_xmm_map = alloc(ir_xmm_map_cap)
    }
    if vcount > ir_xmm_map_cap { return }
    memset(ir_xmm_map, 0, vcount)
    if enable == 0 { return }
    if vcount < 2 { return }
    if ir_ig_buf == 0 { return }
    if ir_xmm_block_buf == 0 {
        ir_xmm_block_cap = 65536
        ir_xmm_block_buf = alloc(ir_xmm_block_cap)
    }
    if vcount > ir_xmm_block_cap { return }
    memset(ir_xmm_block_buf, 0, vcount)
    // 1. Coalition purity: a rep whose coalition contains ANY non-f64
    //    member is barred. A mixed coalition shares one storage
    //    location; homing its float side in an xmm while the integer
    //    side keeps the shared GPR would split the value into two
    //    disagreeing homes. The connecting IR_COPY instead emits a real
    //    movq through the funnels, so the classes never silently alias.
    uint64 pv = 1
    while pv < vcount {
        if ir_vreg_fkind_get(pv) != 1 {
            uint64 pr = ir_uf_find(pv)
            uint64 pp = ir_xmm_block_buf + pr
            uint8 pone = 1
            unsafe { *(pp as uint8) = pone }
        }
        pv = pv + 1
    }
    // 2. Call-liveness bar — the x86-only step (no callee-saved XMM
    //    bank exists; see the section header).
    ir_x86_xmm_mark_unsafe()
    // 3. Greedy colouring of reps, highest-vreg-first (same weighting
    //    rationale as ir_a64_fpr_alloc: loop-carried values born deep in
    //    the function beat early-declared constants to the homes; a
    //    spilled constant reloads dependency-free while a spilled loop
    //    variable puts a round-trip on the critical path). Geometry must
    //    mirror ir_graph_color exactly.
    uint64 row_words = (vcount + 63) / 64
    uint64 row_bytes = row_words * 8
    uint64 ig = ir_ig_buf
    uint64 vi = vcount - 1
    while vi >= 1 {
        if ir_vreg_fkind_get(vi) != 1 { vi = vi - 1; continue }
        if ir_uf_find(vi) != vi { vi = vi - 1; continue }
        uint64 bq = ir_xmm_block_buf + vi
        uint8 b8 = 0
        unsafe { *(bq as uint8) -> b8 }
        uint64 blk = b8
        if blk != 0 { vi = vi - 1; continue }
        // Collect xmm colours already taken by interfering neighbours.
        uint64 used = 0
        uint64 nw = 0
        while nw < row_words {
            uint64 np = ig + vi * row_bytes + nw * 8
            uint64 nbits = 0
            unsafe { *(np as uint64) -> nbits }
            while nbits != 0 {
                uint64 iso = nbits & (0 - nbits)
                uint64 bp = ir_popcount64(iso - 1)
                uint64 neighbor = nw * 64 + bp
                if neighbor < vcount {
                    uint64 nrep = ir_uf_find(neighbor)
                    uint64 ncp = ir_xmm_map + nrep
                    uint8 nc8 = 0
                    unsafe { *(ncp as uint8) -> nc8 }
                    uint64 nc = nc8
                    if nc != 0 { used = used | (1 << (nc - 2)) }
                }
                nbits = nbits & ~(1 << bp)
            }
            nw = nw + 1
        }
        uint64 fc = 0
        while fc < 14 {
            if ((used >> fc) & 1) == 0 {
                uint64 mp = ir_xmm_map + vi
                uint8 mv = 2 + fc
                unsafe { *(mp as uint8) = mv }
                ir_xmm_on = 1
                fc = 14
            } else {
                fc = fc + 1
            }
        }
        vi = vi - 1
    }
    if ir_xmm_on == 0 { return }
    // 4. Propagate rep homes to f64 followers. (Non-f64 followers cannot
    //    exist in a homed coalition — step 1 barred mixed coalitions.)
    uint64 fv = 1
    while fv < vcount {
        if ir_vreg_fkind_get(fv) == 1 {
            uint64 rep = ir_uf_find(fv)
            if rep != fv {
                uint64 rp2 = ir_xmm_map + rep
                uint8 rc2 = 0
                unsafe { *(rp2 as uint8) -> rc2 }
                uint64 fp2 = ir_xmm_map + fv
                unsafe { *(fp2 as uint8) = rc2 }
            }
        }
        fv = fv + 1
    }
    // 5. Evict homed vregs from the GPR file: force their colour to
    //    "spilled" so every dest-write and src-read in the ~70 op
    //    handlers funnels through ir_emit_store_spill /
    //    ir_emit_load_spill / ir_resolve_src, which all redirect to the
    //    home. Without this a handler that sees dst_r != 0xFFFFFFFF
    //    writes the GPR directly and the home would go stale.
    uint64 cv = 1
    while cv < vcount {
        uint64 cp = ir_xmm_map + cv
        uint8 cc = 0
        unsafe { *(cp as uint8) -> cc }
        if cc != 0 {
            uint64 ap = ir_reg_assign + cv * 4
            uint32 spilled = 0xFFFFFFFF
            unsafe { *(ap as uint32) = spilled }
        }
        cv = cv + 1
    }
}

// ---------------------------------------------------------------------------
// Spill helpers
// ---------------------------------------------------------------------------

static uint64 ir_spill_base = 0
static uint64 ir_spill_count = 0

fn ir_spill_offset(uint64 vreg) -> uint64 {
    // One slot per vreg (vregs are 1-based). The old vreg-IR_NUM_REGS-1
    // mapping assumed a vreg numbered <= IR_NUM_REGS could never spill;
    // a colour ceiling (wide-file mode) can spill ANY vreg, and the
    // subtraction would underflow — the exact bug the xtensa wide file
    // hit first (see xt_spill_offset's note).
    uint64 slot = vreg - 1
    return ir_spill_base + slot * 8
}

// Peephole: track the most recent `store_spill reg, vreg` so an
// immediately-following `load_spill reg, same-vreg` (with no other
// bytes emitted in between) can be elided — the value is already in
// that register. Cleared by invalidating the end position whenever
// any non-tracking byte emitter runs; here we rely on out_len being
// stable between the two calls to signal "nothing else happened".
static uint64 ir_last_spill_vreg = 0xFFFFFFFF
static uint64 ir_last_spill_reg = 0xFFFFFFFF
static uint64 ir_last_spill_end = 0xFFFFFFFFFFFFFFFF

@export
fn ir_peephole_reset() {
    ir_last_spill_vreg = 0xFFFFFFFF
    ir_last_spill_reg = 0xFFFFFFFF
    ir_last_spill_end = 0xFFFFFFFFFFFFFFFF
}

fn ir_emit_load_spill(uint64 dst_reg, uint64 vreg) {
    // XMM-homed f64 vreg: the value lives in an XMM register, not a
    // slot — pull the bits from there. Checked BEFORE the peephole:
    // homed vregs never record spill stores, so the peephole state can
    // never legitimately refer to one.
    uint64 xh = ir_x86_xmm_home(vreg)
    if xh != 0xFFFFFFFF {
        ir_emit_movq_r_x(dst_reg, xh)
        return
    }
    // Peephole: if the last emission was exactly `store_spill
    // src_reg=dst_reg, src_vreg=vreg` and nothing was emitted after
    // it, the value is still in dst_reg — skip the reload entirely.
    if vreg == ir_last_spill_vreg && dst_reg == ir_last_spill_reg && out_len == ir_last_spill_end {
        ir_last_spill_end = 0xFFFFFFFFFFFFFFFF   // one-shot: don't re-apply
        return
    }
    // Same vreg, different reg — the value is in `ir_last_spill_reg`
    // already; emit a reg-reg move instead of a memory load. Saves one
    // memory cycle per spill round-trip in matmul-style hot paths
    // where intermediate vregs flow through different scratch regs.
    if vreg == ir_last_spill_vreg && out_len == ir_last_spill_end &&
       ir_last_spill_reg != 0xFFFFFFFF && ir_last_spill_reg != dst_reg {
        uint64 src_reg = ir_last_spill_reg
        // Update ir_last_spill_end inside the helper would invalidate
        // the next peephole check incorrectly — but we're emitting only
        // one mov, so updating last_spill_reg to dst_reg keeps the
        // chain "value lives in dst_reg" valid for any subsequent
        // store_spill→load_spill pair targeting the same vreg.
        ir_emit_mov_r64_r64(dst_reg, src_reg)
        ir_last_spill_reg = dst_reg
        ir_last_spill_end = out_len
        return
    }
    // mov dst_reg, [rsp + spill_offset]
    uint64 off = ir_spill_offset(vreg)
    uint8 rex = 0x48
    if dst_reg >= 8 { rex = rex | 4 }
    emit_byte(rex)
    emit_byte(0x8B)
    if off < 128 {
        uint64 v = 0x44 | ((dst_reg & 7) << 3)
        uint8 modrm = v
        emit_byte(modrm)
        emit_byte(0x24)
        uint8 o8 = off
        emit_byte(o8)
    } else {
        uint64 v = 0x84 | ((dst_reg & 7) << 3)
        uint8 modrm = v
        emit_byte(modrm)
        emit_byte(0x24)
        emit_u32_le(off)
    }
}

fn ir_emit_store_spill(uint64 src_reg, uint64 vreg) {
    // XMM-homed f64 vreg: its home is an XMM register — move the bits
    // there instead of touching the stack. Skip the peephole record:
    // no slot was written.
    uint64 xh = ir_x86_xmm_home(vreg)
    if xh != 0xFFFFFFFF {
        ir_emit_movq_x_r(xh, src_reg)
        return
    }
    // mov [rsp + spill_offset], src_reg
    uint64 off = ir_spill_offset(vreg)
    uint8 rex = 0x48
    if src_reg >= 8 { rex = rex | 4 }
    emit_byte(rex)
    emit_byte(0x89)
    if off < 128 {
        uint64 v = 0x44 | ((src_reg & 7) << 3)
        uint8 modrm = v
        emit_byte(modrm)
        emit_byte(0x24)
        uint8 o8 = off
        emit_byte(o8)
    } else {
        uint64 v = 0x84 | ((src_reg & 7) << 3)
        uint8 modrm = v
        emit_byte(modrm)
        emit_byte(0x24)
        emit_u32_le(off)
    }
    // Record for the peephole check above. Captures (src_reg, vreg)
    // and the out_len after emission. The next emit that bumps
    // out_len without matching those parameters invalidates this
    // via the position check.
    ir_last_spill_vreg = vreg
    ir_last_spill_reg = src_reg
    ir_last_spill_end = out_len
}

// ---------------------------------------------------------------------------
// Scratch register helpers: resolve vreg to physical reg or load spill
// ---------------------------------------------------------------------------

fn ir_resolve_src(uint64 vreg, uint64 scratch) -> uint64 {
    // Returns the physical register holding the value of vreg.
    // If vreg is spilled, loads it into scratch (0=rax, 1=rcx) and returns scratch.
    if vreg == 0 { return scratch }
    uint64 phys = ir_get_phys_reg(vreg)
    if phys != 0xFFFFFFFF { return phys }
    ir_emit_load_spill(scratch, vreg)
    return scratch
}

// ---------------------------------------------------------------------------
// OS-aware syscall number mapping (x86_64)
// ---------------------------------------------------------------------------

fn ir_x86_syscall_nr(uint64 abstract_nr) -> uint64 {
    if target_os == 1 {
        // macOS x86_64: prefix 0x2000000
        if abstract_nr == 231 { return 0x2000001 }  // exit → 1
        if abstract_nr == 1 { return 0x2000004 }    // write → 4
        if abstract_nr == 0 { return 0x2000003 }    // read → 3
        if abstract_nr == 2 { return 0x2000005 }    // open → 5
        if abstract_nr == 3 { return 0x2000006 }    // close → 6
        if abstract_nr == 8 { return 0x20000C7 }    // lseek → 199
        if abstract_nr == 9 { return 0x20000C5 }    // mmap → 197
        if abstract_nr == 11 { return 0x2000049 }   // munmap → 73
        if abstract_nr == 59 { return 0x200003B }   // execve → 59
        if abstract_nr == 228 { return 0x20000E4 }  // clock_gettime → 228
        if abstract_nr == 15 { return 0x200000F }   // chmod → 15
        if abstract_nr == 90 { return 0x200000F }   // fchmod(Linux 90) → chmod(macOS 15)
        if abstract_nr == 257 { return 0x2000005 }  // openat → open (macOS uses open, not openat)
        return 0x2000000 | abstract_nr               // fallback
    }
    // Linux (0) and Android (3) use the same x86_64 syscall numbers
    return abstract_nr
}

// ---------------------------------------------------------------------------
// Windows PE syscall emitter — translates abstract syscall numbers to IAT calls
// ---------------------------------------------------------------------------

fn ir_emit_x86_win_syscall(uint64 abstract_nr, uint64 dest_v, uint64 dst_r) {
    if abstract_nr == 231 {
        // exit(code): IR_ARG placed code in rdi (SysV slot 0).
        // Windows: ExitProcess(UINT uExitCode) — rcx = exit code
        ir_emit_mov_r64_r64(1, 7)   // mov rcx, rdi
        emit_win_alloc_stack(0x20)    // sub rsp, 32 (shadow space)
        emit_win_call_iat(0)          // call ExitProcess
        emit_win_free_stack(0x20)     // add rsp, 32
        return
    }

    if abstract_nr == 1 {
        // write(fd, buf, len): SysV args in rdi=fd, rsi=buf, rdx=len
        // Windows: if fd <= 2, call GetStdHandle to convert fd to a handle;
        // otherwise fd is already a native Windows HANDLE (from CreateFileA/file_open).
        // Then call WriteFile(handle, buf, len, NULL, NULL).

        // Save buf(rsi) and len(rdx) — two pushes keep stack aligned
        emit_byte(0x56)  // push rsi (buf)
        emit_byte(0x52)  // push rdx (len)

        // Check if fd <= 2 (stdin/stdout/stderr need GetStdHandle)
        // cmp rdi, 2
        emit_byte(0x48); emit_byte(0x83); emit_byte(0xFF); emit_byte(0x02)
        // ja skip_getstdhandle (fd > 2 means it's a file handle)
        emit_byte(0x77)
        // The GetStdHandle block is: mov rcx,rdi(3) + add rcx,10(4) + neg rcx(3) +
        //   sub rsp,0x20(4) + call[rip+disp32](6) + add rsp,0x20(4) + mov rdi,rax(3) = 27 bytes
        emit_byte(0x1B)  // ja +27

        // GetStdHandle path: rcx = -(fd + 10) -> -11 for stdout, -12 for stderr
        ir_emit_mov_r64_r64(1, 7)   // mov rcx, rdi (fd)
        // add rcx, 10
        emit_byte(0x48); emit_byte(0x83); emit_byte(0xC1); emit_byte(0x0A)
        // neg rcx
        emit_byte(0x48); emit_byte(0xF7); emit_byte(0xD9)
        emit_win_alloc_stack(0x20)
        emit_win_call_iat(1)          // call GetStdHandle -> rax = handle
        emit_win_free_stack(0x20)
        // Move handle to rdi so the rest of the code uses it uniformly
        ir_emit_mov_r64_r64(7, 0)    // mov rdi, rax (handle)
        // skip_getstdhandle:

        // Pop len and buf (reverse order)
        emit_byte(0x5A)  // pop rdx (len)
        emit_byte(0x5E)  // pop rsi (buf)

        // WriteFile(handle=rcx, buf=rdx, len=r8, lpBytesWritten=r9=0, lpOverlapped=[rsp+32]=0)
        // Save len from rdx into r8 BEFORE overwriting rdx
        emit_byte(0x49); emit_byte(0x89); emit_byte(0xD0)  // mov r8, rdx (len)
        ir_emit_mov_r64_r64(1, 7)    // mov rcx, rdi (handle — either GetStdHandle result or original fd)
        ir_emit_mov_r64_r64(2, 6)    // mov rdx, rsi (buf)
        // r8 already has len
        ir_emit_mov_r64_imm64(9, 0)  // r9 = NULL (lpNumberOfBytesWritten)

        // sub rsp, 48 (32 shadow + 8 for 5th arg, 16-aligned)
        emit_win_alloc_stack(0x30)
        // mov qword [rsp+32], 0 (lpOverlapped = NULL, 5th arg on stack)
        emit_byte(0x48); emit_byte(0xC7); emit_byte(0x44); emit_byte(0x24); emit_byte(0x20)
        emit_u32_le(0)
        emit_win_call_iat(2)          // call WriteFile
        emit_win_free_stack(0x30)
    }

    if abstract_nr == 0 {
        // read(fd, buf, len): SysV rdi=fd, rsi=buf, rdx=len
        // Windows: ReadFile(handle, buf, len, &bytesRead, NULL)
        // If fd <= 2, convert via GetStdHandle; otherwise fd is already a handle.
        emit_byte(0x56)  // push rsi (buf)
        emit_byte(0x52)  // push rdx (len)

        // cmp rdi, 2
        emit_byte(0x48); emit_byte(0x83); emit_byte(0xFF); emit_byte(0x02)
        // ja +27 (skip GetStdHandle)
        emit_byte(0x77); emit_byte(0x1B)
        // GetStdHandle: rcx = -(fd + 10) -> -10 for stdin
        ir_emit_mov_r64_r64(1, 7)
        emit_byte(0x48); emit_byte(0x83); emit_byte(0xC1); emit_byte(0x0A)
        emit_byte(0x48); emit_byte(0xF7); emit_byte(0xD9)
        emit_win_alloc_stack(0x20)
        emit_win_call_iat(1)          // GetStdHandle
        emit_win_free_stack(0x20)
        ir_emit_mov_r64_r64(7, 0)    // mov rdi, rax (handle)

        emit_byte(0x5A)              // pop rdx -> len
        emit_byte(0x5E)              // pop rsi -> buf
        emit_byte(0x49); emit_byte(0x89); emit_byte(0xD0)  // mov r8, rdx (len)
        ir_emit_mov_r64_r64(1, 7)    // rcx = handle
        ir_emit_mov_r64_r64(2, 6)    // rdx = buf
        emit_win_alloc_stack(0x30)
        // [rsp+0x20] = NULL (lpOverlapped, 5th arg on stack)
        emit_byte(0x48); emit_byte(0xC7); emit_byte(0x44); emit_byte(0x24); emit_byte(0x20)
        emit_u32_le(0)
        // lea r9, [rsp+0x28] (&bytesRead, in our scratch area)
        emit_byte(0x4C); emit_byte(0x8D); emit_byte(0x4C); emit_byte(0x24); emit_byte(0x28)
        emit_win_call_iat(4)          // ReadFile (IAT slot 4)
        // rax = BOOL, actual bytes read (DWORD) at [rsp+0x28]
        // Load bytes read into eax (zero-extends to rax)
        emit_byte(0x8B); emit_byte(0x44); emit_byte(0x24); emit_byte(0x28)  // mov eax, [rsp+0x28]
        emit_win_free_stack(0x30)
    }

    if abstract_nr == 2 {
        // open(path, flags): SysV rdi=path, rsi=flags
        // Windows: CreateFileA(path, access, share, NULL, disposition, flags, NULL)
        // flags: 0=read(O_RDONLY), nonzero=write(O_WRONLY/O_CREAT)
        emit_byte(0x56)  // push rsi (flags)
        ir_emit_mov_r64_r64(1, 7)    // rcx = path
        emit_byte(0x5E)              // pop rsi (flags)
        // rdx = GENERIC_READ (0x80000000) or GENERIC_WRITE (0x40000000)
        ir_emit_mov_r64_imm64(2, 0x80000000)  // default: GENERIC_READ
        // test rsi, rsi; if nonzero, use GENERIC_WRITE
        emit_byte(0x48); emit_byte(0x85); emit_byte(0xF6)  // test rsi, rsi
        // jz rel8 — skip the GENERIC_WRITE override. Patched after the
        // mov emits so this survives changes to mov r64 imm64's encoding
        // (e.g., the compact imm32 form that fits uint32 values in 5 bytes).
        emit_byte(0x74)
        uint64 co_jz_patch = out_len
        emit_byte(0)                            // rel8 placeholder
        ir_emit_mov_r64_imm64(2, 0x40000000)  // GENERIC_WRITE
        uint8 co_jz_disp = out_len - co_jz_patch - 1
        uint64 co_jz_p = out_buf + co_jz_patch
        unsafe { *(co_jz_p as uint8) = co_jz_disp }
        // r8 = FILE_SHARE_READ (1)
        ir_emit_mov_r64_imm64(8, 1)
        // r9 = NULL (security attrs)
        ir_emit_mov_r64_imm64(9, 0)
        // Stack args: [rsp+32]=disposition, [rsp+40]=FILE_ATTRIBUTE_NORMAL, [rsp+48]=NULL
        // Need 32 shadow + 3*8=24 stack args = 56, round up to 64 (0x40) for 16-byte alignment
        emit_win_alloc_stack(0x40)
        // Default OPEN_EXISTING
        emit_byte(0x48); emit_byte(0xC7); emit_byte(0x44); emit_byte(0x24); emit_byte(0x20)
        emit_u32_le(3)  // OPEN_EXISTING
        // if write mode, patch to CREATE_ALWAYS
        emit_byte(0x48); emit_byte(0x85); emit_byte(0xF6)  // test rsi, rsi
        emit_byte(0x74); emit_byte(0x09)  // jz +9 (skip 9-byte mov qword [rsp+0x20])
        emit_byte(0x48); emit_byte(0xC7); emit_byte(0x44); emit_byte(0x24); emit_byte(0x20)
        emit_u32_le(2)  // CREATE_ALWAYS
        // [rsp+40] = FILE_ATTRIBUTE_NORMAL (0x80)
        emit_byte(0x48); emit_byte(0xC7); emit_byte(0x44); emit_byte(0x24); emit_byte(0x28)
        emit_u32_le(0x80)
        // [rsp+48] = NULL (template)
        emit_byte(0x48); emit_byte(0xC7); emit_byte(0x44); emit_byte(0x24); emit_byte(0x30)
        emit_u32_le(0)
        emit_win_call_iat(3)  // CreateFileA (IAT slot 3)
        emit_win_free_stack(0x40)
        // rax = handle (or INVALID_HANDLE_VALUE on error)
    }

    if abstract_nr == 3 {
        // close(fd): SysV rdi=fd
        // Windows: CloseHandle(handle)
        ir_emit_mov_r64_r64(1, 7)    // rcx = handle
        emit_win_alloc_stack(0x20)
        emit_win_call_iat(5)          // CloseHandle (IAT slot 5)
        emit_win_free_stack(0x20)
    }

    if abstract_nr == 8 {
        // lseek(fd, offset, whence): SysV rdi=fd, rsi=offset, rdx=whence
        // Windows: GetFileSizeEx(handle, &size) — used by file_size() builtin
        // This returns the file size regardless of whence. For the SEEK_SET rewind
        // call, the return value is unused so this is safe.
        ir_emit_mov_r64_r64(1, 7)    // rcx = handle
        // sub rsp, 0x30 (shadow + space for output)
        emit_win_alloc_stack(0x30)
        // lea rdx, [rsp+32] (&size output)
        emit_byte(0x48); emit_byte(0x8D); emit_byte(0x54); emit_byte(0x24); emit_byte(0x20)
        emit_win_call_iat(8)          // GetFileSizeEx (IAT slot 8)
        // Load the size from [rsp+32]
        emit_byte(0x48); emit_byte(0x8B); emit_byte(0x44); emit_byte(0x24); emit_byte(0x20)
        emit_win_free_stack(0x30)
    }

    // Move result to dest
    if dst_r != 0xFFFFFFFF && dst_r != 0 {
        ir_emit_mov_r64_r64(dst_r, 0)
    }
    if dst_r == 0xFFFFFFFF {
        ir_emit_store_spill(0, dest_v)
    }
}

// ---------------------------------------------------------------------------
// Per-instruction emitter
// ---------------------------------------------------------------------------

// Emit a contiguous group of IR_ARG instructions with imm >= 100 starting at
// `start_ii`. These arise from `in(var -> reg)` asm-block constraints. Using
// push/pop avoids the register-shuffle problem that a naive sequential
// `mov target, src` pattern would introduce when a later move's source was
// allocated to an earlier move's target register.
//
// Layout:
//   Phase A — push every source (loading spilled sources through rax with
//             rsp-offset adjustment since rsp decreases between pushes).
//   Phase B — pop into each destination in reverse order.
//
// All subsequent IR_ARG instructions in the group are nop-marked (opcode 0)
// so the main loop's later iterations do not re-emit them.
fn ir_emit_asm_in_group(uint64 start_ii) {
    uint64 start_bb = ir_insn_bb(start_ii)
    // Fixed cap: real-world asm blocks carry handfuls of constraints.
    uint64[16] mv_dst
    uint64[16] mv_src_v
    uint64 mv_count = 0

    uint64 ci = start_ii
    while ci < ir_insn_count {
        uint64 cop = ir_insn_opcode(ci)
        if cop != 51 { break }
        uint64 cimm = ir_insn_imm(ci)
        if cimm < 100 { break }
        if ir_insn_bb(ci) != start_bb { break }
        if mv_count >= 16 {
            write(2, "error: too many asm in() constraints (max 16)\n", 46)
            exit(1)
        }
        uint64 dpv = cimm - 100
        uint64 spv = ir_insn_src1(ci)
        uint64 dp = mv_dst + mv_count * 8
        uint64 sp = mv_src_v + mv_count * 8
        unsafe { *(dp as uint64) = dpv }
        unsafe { *(sp as uint64) = spv }
        mv_count = mv_count + 1
        // Leave start_ii's opcode alone — its handler returns after this helper.
        if ci != start_ii { ir_insn_set_opcode(ci, 0) }
        ci = ci + 1
    }

    // Phase A: push sources.
    uint64 k = 0
    while k < mv_count {
        uint64 sp_k = mv_src_v + k * 8
        uint64 s_v = 0
        unsafe { *(sp_k as uint64) -> s_v }
        uint64 s_reg = ir_get_phys_reg(s_v)
        if s_reg == 0xFFFFFFFF {
            // Spilled: load from [rsp + orig_off + k*8] into rax, then push rax.
            // rsp has moved down by k*8 from the k prior pushes.
            uint64 orig_off = ir_spill_offset(s_v)
            uint64 adj_off = orig_off + k * 8
            emit_byte(0x48); emit_byte(0x8B)
            if adj_off < 128 {
                emit_byte(0x44); emit_byte(0x24)
                uint8 o8 = adj_off
                emit_byte(o8)
            } else {
                emit_byte(0x84); emit_byte(0x24)
                emit_u32_le(adj_off)
            }
            emit_byte(0x50)
        } else {
            if s_reg >= 8 {
                emit_byte(0x41)
                uint8 po = 0x50 | (s_reg & 7)
                emit_byte(po)
            } else {
                uint8 po = 0x50 | s_reg
                emit_byte(po)
            }
        }
        k = k + 1
    }

    // Phase B: pop into destinations in reverse order so pushes[k] lands in dst[k].
    uint64 k2 = mv_count
    while k2 > 0 {
        k2 = k2 - 1
        uint64 dp_k = mv_dst + k2 * 8
        uint64 d_reg = 0
        unsafe { *(dp_k as uint64) -> d_reg }
        if d_reg >= 8 {
            emit_byte(0x41)
            uint8 po = 0x58 | (d_reg & 7)
            emit_byte(po)
        } else {
            uint8 po = 0x58 | d_reg
            emit_byte(po)
        }
    }
}

// SysV register for outgoing argument index 0..5.
fn ir_x86_arg_reg(uint64 idx) -> uint64 {
    if idx == 0 { return 7 }    // rdi
    if idx == 1 { return 6 }    // rsi
    if idx == 2 { return 2 }    // rdx
    if idx == 3 { return 1 }    // rcx
    if idx == 4 { return 8 }    // r8
    return 9                    // r9
}

// Emit a contiguous group of register-passed IR_ARG instructions (imm < 6)
// starting at `start_ii`, shuffle-safely, via push/pop.
//
// Only @naked functions take this path. Everywhere else the outgoing
// argument registers can never be a vreg's home — the default file is
// callee-saved only, and the wide file caps every operand of a dirty op
// (IR_ARG is dirty) back to the callee-saved prefix — so the sequential
// `mov target, src` in the IR_ARG handler is already safe. The naked file
// is caller-saved by necessity (ir_regalloc_init_x86_naked) and four of
// its six colours ARE argument registers, so `f(a, b)` with `b` homed in
// rdi would have arg0's move destroy arg1's source. Same hazard, same
// remedy, as ir_emit_asm_in_group's `in(var -> reg)` groups.
//
// Push/pop is chosen over an ordering search because it is correct for
// every permutation including cycles, and because a naked body is a
// handful of instructions where the extra pushes cost nothing. The pushes
// and pops balance, so RSP at the CALL is exactly what it would have been.
//
// Instructions after the first in the group are nop-marked (opcode 0) so
// the caller's loop does not re-emit them. Overflow args (imm >= 6) and
// asm-input args (imm >= 100) end the group and are handled as before.
fn ir_emit_call_arg_group(uint64 start_ii) {
    uint64 start_bb = ir_insn_bb(start_ii)
    uint64[8] cg_dst
    uint64[8] cg_src_v
    uint64 cg_count = 0

    uint64 ci = start_ii
    while ci < ir_insn_count {
        uint64 cop = ir_insn_opcode(ci)
        if cop != 51 { break }
        uint64 cimm = ir_insn_imm(ci)
        if cimm >= 6 { break }
        if ir_insn_bb(ci) != start_bb { break }
        if cg_count >= 6 { break }
        uint64 dpv = ir_x86_arg_reg(cimm)
        uint64 spv = ir_insn_src1(ci)
        uint64 dp = cg_dst + cg_count * 8
        uint64 sp = cg_src_v + cg_count * 8
        unsafe { *(dp as uint64) = dpv }
        unsafe { *(sp as uint64) = spv }
        cg_count = cg_count + 1
        // start_ii's own opcode stays intact: its handler returns right
        // after this helper, and nop-marking it would confuse a later
        // re-read of the instruction stream.
        if ci != start_ii { ir_insn_set_opcode(ci, 0) }
        ci = ci + 1
    }

    // Refuse the one shape this cannot compile correctly: a call from a
    // @naked body with a 7th argument. IR_CALL resolves the overflow args
    // AFTER this group has already loaded rdi/rsi/rdx/rcx/r8/r9, and it
    // reads them from ir_get_phys_reg — which, with the caller-saved naked
    // file, can name a register the pops above just overwrote. Deferring
    // the group past the overflow block would have to happen at every
    // IR_ARG consumer (call, call_ind, syscall, syscall_raw, the Windows
    // IAT paths); a missed one is silently unloaded arguments. Refusing is
    // the honest answer, and it takes nothing away: before this change the
    // same call corrupted callee-saved registers instead.
    if ci < ir_insn_count {
        if ir_insn_opcode(ci) == 51 {
            uint64 nimm = ir_insn_imm(ci)
            if nimm >= 6 && nimm < 100 && ir_insn_bb(ci) == start_bb {
                write(2, "error: x86_64: a call from a @naked function may pass at most 6 arguments (the 7th and later go through the stack, which a naked body has no frame for). Move the call into a normal function.\n", 191)
                exit(1)
            }
        }
    }

    // Phase A: push every source, left to right.
    uint64 k = 0
    while k < cg_count {
        uint64 sp_k = cg_src_v + k * 8
        uint64 s_v = 0
        unsafe { *(sp_k as uint64) -> s_v }
        uint64 s_reg = ir_get_phys_reg(s_v)
        if s_reg == 0xFFFFFFFF {
            // Spilled: load from [rsp + orig_off + k*8] (rsp has already
            // dropped by k*8 from the preceding pushes) and push that.
            uint64 orig_off = ir_spill_offset(s_v)
            uint64 adj_off = orig_off + k * 8
            emit_byte(0x48); emit_byte(0x8B)
            if adj_off < 128 {
                emit_byte(0x44); emit_byte(0x24)
                uint8 o8 = adj_off
                emit_byte(o8)
            } else {
                emit_byte(0x84); emit_byte(0x24)
                emit_u32_le(adj_off)
            }
            emit_byte(0x50)
        } else {
            if s_reg >= 8 {
                emit_byte(0x41)
                uint8 po = 0x50 | (s_reg & 7)
                emit_byte(po)
            } else {
                uint8 po = 0x50 | s_reg
                emit_byte(po)
            }
        }
        k = k + 1
    }

    // Phase B: pop into the argument registers in reverse push order.
    uint64 k2 = cg_count
    while k2 > 0 {
        k2 = k2 - 1
        uint64 dp_k = cg_dst + k2 * 8
        uint64 d_reg = 0
        unsafe { *(dp_k as uint64) -> d_reg }
        if d_reg >= 8 {
            emit_byte(0x41)
            uint8 po = 0x58 | (d_reg & 7)
            emit_byte(po)
        } else {
            uint8 po = 0x58 | d_reg
            emit_byte(po)
        }
    }
}

// Loud failure for an opcode the x86_64 dispatch does not handle. A build
// error is always better than silently emitting nothing.
fn x86_nyi_op(uint64 op) {
    uint8[24] nbuf
    uint64 pre = "error: x86_64: IR op "
    write(2, pre, str_len(pre))
    uint64 nlen = fmt_uint(nbuf, op)
    write(2, nbuf, nlen)
    uint64 post = " not yet implemented\n"
    write(2, post, str_len(post))
    exit(1)
}

fn ir_emit_x86_insn(uint64 ii) {
    uint64 op = ir_insn_opcode(ii)
    // NOP: LICM blanks an instruction in place rather than removing it, so
    // op 0 legitimately reaches here and emits nothing. Previously this fell
    // through the whole dispatch by accident; the catch-all at the bottom
    // makes the intent explicit. (arm64 and xtensa already return early.)
    if op == 0 { return }
    uint64 dest_v = ir_insn_dest(ii)
    uint64 s1_v = ir_insn_src1(ii)
    uint64 s2_v = ir_insn_src2(ii)
    uint64 imm = ir_insn_imm(ii)

    // Record DWARF line-table entry at the start of each instruction
    // that carries a source token. The line_table_record helper itself
    // deduplicates same-line entries and no-ops when -g is off.
    uint64 ir_src_tok = ir_insn_src_tok_at(ii)
    if ir_src_tok != 0 { line_table_record(ir_src_tok) }

    // Get physical registers (0xFFFFFFFF = spilled)
    uint64 dst_r = ir_get_phys_reg(dest_v)

    if op == 79 {
        // IR_STR_CONST: dst = lea string data (imm = str_offset)
        uint64 str_offset = imm
        uint64 lea_dst = dst_r
        if lea_dst == 0xFFFFFFFF { lea_dst = 0 }
        uint8 lea_rex = 0x48
        if lea_dst >= 8 { lea_rex = lea_rex | 4 }
        emit_byte(lea_rex)
        emit_byte(0x8D)
        uint64 lea_modrm = 0x05 | ((lea_dst & 7) << 3)
        uint8 lea_m = lea_modrm
        emit_byte(lea_m)
        str_fixups_ensure()
        uint64 fentry = str_fixups + str_fixup_count * 8
        uint32 cp = out_len
        unsafe { *(fentry as uint32) = cp }
        uint64 fe4 = fentry + 4
        uint32 so = str_offset
        unsafe { *(fe4 as uint32) = so }
        str_fixup_count = str_fixup_count + 1
        emit_u32_le(0)
        if dst_r == 0xFFFFFFFF {
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 1 {
        // IR_CONST: dst = imm64
        if dst_r != 0xFFFFFFFF {
            ir_emit_mov_r64_imm64(dst_r, imm)
        } else {
            ir_emit_mov_r64_imm64(0, imm)
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 32 {
        // IR_STACK_ADDR: dst = &[rsp + spill_count*8 + imm].
        // imm is the offset within the stack-array region, which
        // sits directly above the spill slots in the prologue's frame.
        uint64 base_off = ir_spill_count * 8 + imm
        uint64 lea_dst = dst_r
        if lea_dst == 0xFFFFFFFF { lea_dst = 0 }
        uint8 lea_rex = 0x48
        if lea_dst >= 8 { lea_rex = lea_rex | 4 }
        emit_byte(lea_rex)
        emit_byte(0x8D)
        if base_off < 128 {
            uint64 mv = 0x44 | ((lea_dst & 7) << 3)
            uint8 modrm = mv
            emit_byte(modrm)
            emit_byte(0x24)
            uint8 o8 = base_off
            emit_byte(o8)
        } else {
            uint64 mv = 0x84 | ((lea_dst & 7) << 3)
            uint8 modrm = mv
            emit_byte(modrm)
            emit_byte(0x24)
            emit_u32_le(base_off)
        }
        if dst_r == 0xFFFFFFFF {
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 2 {
        // IR_ADD (commutative — swap if dst==src2)
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        uint64 b_reg = ir_resolve_src(s2_v, 1)
        if dst_r != 0xFFFFFFFF && dst_r == b_reg && a_reg != b_reg {
            uint64 tmp_r = a_reg; a_reg = b_reg; b_reg = tmp_r
        }
        if dst_r != 0xFFFFFFFF {
            ir_emit_mov_r64_r64(dst_r, a_reg)
            ir_emit_add_r64_r64(dst_r, b_reg)
        } else {
            ir_emit_mov_r64_r64(0, a_reg)
            ir_emit_add_r64_r64(0, b_reg)
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 3 {
        // IR_SUB: dst = src1 - src2
        // Handle case where dst == src2: use rax as temporary
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        uint64 b_reg = ir_resolve_src(s2_v, 1)
        if dst_r != 0xFFFFFFFF {
            if dst_r == b_reg && a_reg != b_reg {
                // dst and src2 share a register — mov would clobber src2
                ir_emit_mov_r64_r64(0, a_reg)        // rax = src1
                ir_emit_sub_r64_r64(0, b_reg)        // rax = src1 - src2
                ir_emit_mov_r64_r64(dst_r, 0)        // dst = rax
            } else {
                ir_emit_mov_r64_r64(dst_r, a_reg)
                ir_emit_sub_r64_r64(dst_r, b_reg)
            }
        } else {
            ir_emit_mov_r64_r64(0, a_reg)
            ir_emit_sub_r64_r64(0, b_reg)
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 135 || op == 136 {
        // IR_ADD_IMM / IR_SUB_IMM: dst = src1 ± imm via `lea dst, [src1+disp]`.
        // For SUB_IMM, negate the displacement so we can share the LEA path.
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        uint64 disp = imm
        if op == 136 { disp = 0 - imm }
        uint64 lea_dst = dst_r
        if lea_dst == 0xFFFFFFFF { lea_dst = 0 }
        ir_emit_lea_disp(lea_dst, a_reg, disp)
        if dst_r == 0xFFFFFFFF {
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 139 {
        // IR_LEA_BIS: dst = base + idx * scale  (scale ∈ {1,2,4,8})
        // Encoding: REX.W [+R/X/B] + 0x8D + ModRM(mod, reg=dst, r/m=100)
        //                   + SIB(scale_bits, idx, base) [+ disp8 if base=rbp/r13]
        uint64 base_reg = ir_resolve_src(s1_v, 0)
        uint64 idx_reg = ir_resolve_src(s2_v, 1)
        uint64 dst = dst_r
        if dst == 0xFFFFFFFF { dst = 0 }
        uint8 rex = 0x48
        if dst >= 8 { rex = rex | 4 }
        if idx_reg >= 8 { rex = rex | 2 }
        if base_reg >= 8 { rex = rex | 1 }
        emit_byte(rex)
        emit_byte(0x8D)
        uint64 scale_bits = 0
        if imm == 2 { scale_bits = 1 }
        if imm == 4 { scale_bits = 2 }
        if imm == 8 { scale_bits = 3 }
        uint64 base_lo = base_reg & 7
        uint64 idx_lo = idx_reg & 7
        uint64 dst_lo = dst & 7
        // RBP/R13 base requires explicit disp8=0 (mod=00 r/m=101 means
        // RIP-relative which is incompatible with SIB-base semantics).
        if base_lo == 5 {
            uint64 mv = 0x40 | (dst_lo << 3) | 4
            uint8 modrm = mv
            emit_byte(modrm)
            uint64 sv = (scale_bits << 6) | (idx_lo << 3) | base_lo
            uint8 sib = sv
            emit_byte(sib)
            emit_byte(0)
        } else {
            uint64 mv = (dst_lo << 3) | 4
            uint8 modrm = mv
            emit_byte(modrm)
            uint64 sv = (scale_bits << 6) | (idx_lo << 3) | base_lo
            uint8 sib = sv
            emit_byte(sib)
        }
        if dst_r == 0xFFFFFFFF {
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 138 {
        // IR_MUL_IMM: dst = src1 * imm via three-operand `imul`.
        // Encoding: REX.W + 6B /r ib    (imm fits in int8)   = 4 bytes
        //           REX.W + 69 /r id    (imm fits in int32)  = 7 bytes
        // Result sign-extends src1*imm into a full 64-bit register.
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        uint64 dst = dst_r
        if dst == 0xFFFFFFFF { dst = 0 }
        uint8 rex = 0x48
        if dst >= 8 { rex = rex | 4 }       // REX.R for dst (the reg field)
        if a_reg >= 8 { rex = rex | 1 }     // REX.B for src1 (r/m)
        emit_byte(rex)
        uint64 use_imm8 = 0
        if imm <= 127 { use_imm8 = 1 }
        if imm >= 0xFFFFFFFFFFFFFF80 { use_imm8 = 1 }
        if use_imm8 != 0 {
            emit_byte(0x6B)
        } else {
            emit_byte(0x69)
        }
        uint64 mv = 0xC0 | ((dst & 7) << 3) | (a_reg & 7)
        uint8 modrm = mv
        emit_byte(modrm)
        if use_imm8 != 0 {
            uint8 d8 = imm
            emit_byte(d8)
        } else {
            emit_u32_le(imm)
        }
        if dst_r == 0xFFFFFFFF {
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 143 {
        // IR_SHL_IMM: dst = src1 << imm via `shl r64, imm8`
        // (REX.W + C1 /4 ib, 4 bytes). Unlike the variable-count IR_SHL
        // above there is no CL round-trip, so no rcx special-casing.
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        uint64 dst = dst_r
        if dst == 0xFFFFFFFF { dst = 0 }
        if dst != a_reg { ir_emit_mov_r64_r64(dst, a_reg) }
        uint8 rex = 0x48
        if dst >= 8 { rex = rex | 1 }
        emit_byte(rex)
        emit_byte(0xC1)
        uint64 mv = 0xE0 | (dst & 7)
        uint8 modrm = mv
        emit_byte(modrm)
        uint8 sh8 = imm
        emit_byte(sh8)
        if dst_r == 0xFFFFFFFF {
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 137 {
        // IR_ROR: dst = right-rotate(src1, src2 mod imm). imm is the
        // rotation width (32 for `ROR r32, cl`; 64 reserved for future
        // 64-bit rotations). The 32-bit form auto-zero-extends the
        // upper 32 bits, making the result w32-clean — so a downstream
        // `& 0xFFFFFFFF` mask gets elided by const-fold.
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        uint64 b_reg = ir_resolve_src(s2_v, 1)
        // ROR's count operand is fixed to CL (rcx low byte) in the
        // variable-shift encoding. Move src2 there if needed.
        if b_reg != 1 { ir_emit_mov_r64_r64(1, b_reg) }
        uint64 dst = dst_r
        if dst == 0xFFFFFFFF { dst = 0 }
        // 32-bit MOV dst, a (no REX.W; auto-zero-extends to 64-bit).
        if dst != a_reg {
            uint64 need_rex = 0
            if a_reg >= 8 { need_rex = 1 }
            if dst >= 8 { need_rex = 1 }
            if need_rex != 0 {
                uint8 rex32 = 0x40
                if a_reg >= 8 { rex32 = rex32 | 4 }
                if dst >= 8 { rex32 = rex32 | 1 }
                emit_byte(rex32)
            }
            emit_byte(0x89)
            uint64 modrm_v = 0xC0 | ((a_reg & 7) << 3) | (dst & 7)
            uint8 modrm = modrm_v
            emit_byte(modrm)
        }
        // ROR r/m32, CL  =  D3 /1
        if dst >= 8 { emit_byte(0x41) }    // REX.B for r8d-r15d
        emit_byte(0xD3)
        uint64 ror_modrm_v = 0xC8 | (dst & 7)
        uint8 ror_modrm = ror_modrm_v
        emit_byte(ror_modrm)
        if dst_r == 0xFFFFFFFF {
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 4 {
        // IR_MUL: imul dst, src (commutative — swap if dst==src2)
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        uint64 b_reg = ir_resolve_src(s2_v, 1)
        if dst_r != 0xFFFFFFFF && dst_r == b_reg && a_reg != b_reg {
            uint64 tmp_r = a_reg; a_reg = b_reg; b_reg = tmp_r
        }
        if dst_r != 0xFFFFFFFF {
            ir_emit_mov_r64_r64(dst_r, a_reg)
            ir_emit_imul_r64_r64(dst_r, b_reg)
        } else {
            ir_emit_mov_r64_r64(0, a_reg)
            ir_emit_imul_r64_r64(0, b_reg)
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 5 {
        // IR_DIV: rax = dividend / divisor, result in rax
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        uint64 b_reg = ir_resolve_src(s2_v, 1)
        ir_emit_mov_r64_r64(0, a_reg)
        // xor rdx, rdx (zero-extend dividend)
        emit_byte(0x48)
        emit_byte(0x31)
        emit_byte(0xD2)
        // Ensure divisor is not in rax or rdx
        if b_reg == 0 || b_reg == 2 {
            ir_emit_mov_r64_r64(1, b_reg)
            b_reg = 1
        }
        // div b_reg: REX.W + F7 /6
        uint8 div_rex = 0x48
        if b_reg >= 8 { div_rex = div_rex | 1 }
        emit_byte(div_rex)
        emit_byte(0xF7)
        uint64 div_modrm = 0xF0 | (b_reg & 7)
        uint8 div_m = div_modrm
        emit_byte(div_m)
        // Result in rax -> move to dst
        if dst_r != 0xFFFFFFFF {
            ir_emit_mov_r64_r64(dst_r, 0)
        } else {
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 6 {
        // IR_MOD: rax = dividend / divisor, remainder in rdx
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        uint64 b_reg = ir_resolve_src(s2_v, 1)
        ir_emit_mov_r64_r64(0, a_reg)
        // xor rdx, rdx
        emit_byte(0x48)
        emit_byte(0x31)
        emit_byte(0xD2)
        if b_reg == 0 || b_reg == 2 {
            ir_emit_mov_r64_r64(1, b_reg)
            b_reg = 1
        }
        uint8 mod_rex = 0x48
        if b_reg >= 8 { mod_rex = mod_rex | 1 }
        emit_byte(mod_rex)
        emit_byte(0xF7)
        uint64 mod_modrm = 0xF0 | (b_reg & 7)
        uint8 mod_m = mod_modrm
        emit_byte(mod_m)
        // Remainder in rdx -> move to dst
        if dst_r != 0xFFFFFFFF {
            ir_emit_mov_r64_r64(dst_r, 2)
        } else {
            ir_emit_store_spill(2, dest_v)
        }
        return
    }

    if op == 132 {
        // IR_SDIV: signed 64-bit divide. mov rax, dividend; cqo (sign-extend
        // rax into rdx:rax); idiv b_reg (REX.W F7 /7). Quotient in rax.
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        uint64 b_reg = ir_resolve_src(s2_v, 1)
        ir_emit_mov_r64_r64(0, a_reg)
        // cqo: 48 99
        emit_byte(0x48)
        emit_byte(0x99)
        if b_reg == 0 || b_reg == 2 {
            ir_emit_mov_r64_r64(1, b_reg)
            b_reg = 1
        }
        uint8 sdiv_rex = 0x48
        if b_reg >= 8 { sdiv_rex = sdiv_rex | 1 }
        emit_byte(sdiv_rex)
        emit_byte(0xF7)
        // /7 = idiv: ModRM = 0xF8 | (reg & 7)
        uint64 sdiv_modrm = 0xF8 | (b_reg & 7)
        uint8 sdiv_m = sdiv_modrm
        emit_byte(sdiv_m)
        if dst_r != 0xFFFFFFFF {
            ir_emit_mov_r64_r64(dst_r, 0)
        } else {
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 133 {
        // IR_SMOD: signed 64-bit remainder. cqo + idiv; remainder in rdx.
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        uint64 b_reg = ir_resolve_src(s2_v, 1)
        ir_emit_mov_r64_r64(0, a_reg)
        emit_byte(0x48)
        emit_byte(0x99)
        if b_reg == 0 || b_reg == 2 {
            ir_emit_mov_r64_r64(1, b_reg)
            b_reg = 1
        }
        uint8 smod_rex = 0x48
        if b_reg >= 8 { smod_rex = smod_rex | 1 }
        emit_byte(smod_rex)
        emit_byte(0xF7)
        uint64 smod_modrm = 0xF8 | (b_reg & 7)
        uint8 smod_m = smod_modrm
        emit_byte(smod_m)
        if dst_r != 0xFFFFFFFF {
            ir_emit_mov_r64_r64(dst_r, 2)
        } else {
            ir_emit_store_spill(2, dest_v)
        }
        return
    }

    if op == 7 {
        // IR_AND (commutative — swap if dst==src2)
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        uint64 b_reg = ir_resolve_src(s2_v, 1)
        if dst_r != 0xFFFFFFFF && dst_r == b_reg && a_reg != b_reg {
            uint64 tmp_r = a_reg; a_reg = b_reg; b_reg = tmp_r
        }
        if dst_r != 0xFFFFFFFF {
            ir_emit_mov_r64_r64(dst_r, a_reg)
            // and dst, src: REX + 21 /r
            emit_byte(ir_x86_rex(b_reg, dst_r))
            emit_byte(0x21)
            emit_byte(ir_x86_modrm_rr(b_reg, dst_r))
        } else {
            ir_emit_mov_r64_r64(0, a_reg)
            emit_byte(ir_x86_rex(b_reg, 0))
            emit_byte(0x21)
            emit_byte(ir_x86_modrm_rr(b_reg, 0))
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 8 {
        // IR_OR (commutative — swap if dst==src2)
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        uint64 b_reg = ir_resolve_src(s2_v, 1)
        if dst_r != 0xFFFFFFFF && dst_r == b_reg && a_reg != b_reg {
            uint64 tmp_r = a_reg; a_reg = b_reg; b_reg = tmp_r
        }
        if dst_r != 0xFFFFFFFF {
            ir_emit_mov_r64_r64(dst_r, a_reg)
            emit_byte(ir_x86_rex(b_reg, dst_r))
            emit_byte(0x09)
            emit_byte(ir_x86_modrm_rr(b_reg, dst_r))
        } else {
            ir_emit_mov_r64_r64(0, a_reg)
            emit_byte(ir_x86_rex(b_reg, 0))
            emit_byte(0x09)
            emit_byte(ir_x86_modrm_rr(b_reg, 0))
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 9 {
        // IR_XOR (commutative — swap if dst==src2)
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        uint64 b_reg = ir_resolve_src(s2_v, 1)
        if dst_r != 0xFFFFFFFF && dst_r == b_reg && a_reg != b_reg {
            uint64 tmp_r = a_reg; a_reg = b_reg; b_reg = tmp_r
        }
        if dst_r != 0xFFFFFFFF {
            ir_emit_mov_r64_r64(dst_r, a_reg)
            emit_byte(ir_x86_rex(b_reg, dst_r))
            emit_byte(0x31)
            emit_byte(ir_x86_modrm_rr(b_reg, dst_r))
        } else {
            ir_emit_mov_r64_r64(0, a_reg)
            emit_byte(ir_x86_rex(b_reg, 0))
            emit_byte(0x31)
            emit_byte(ir_x86_modrm_rr(b_reg, 0))
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 10 {
        // IR_SHL: shl dst, cl — shift count must be in cl (rcx low byte)
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        uint64 b_reg = ir_resolve_src(s2_v, 1)
        if b_reg != 1 { ir_emit_mov_r64_r64(1, b_reg) }
        if dst_r != 0xFFFFFFFF {
            if dst_r == 1 && a_reg != 1 {
                // dst is rcx which holds shift count — use rax as temporary
                ir_emit_mov_r64_r64(0, a_reg)
                emit_byte(0x48)
                emit_byte(0xD3)
                emit_byte(0xE0)
                ir_emit_mov_r64_r64(dst_r, 0)
            } else {
                ir_emit_mov_r64_r64(dst_r, a_reg)
                uint8 shl_rex = 0x48
                if dst_r >= 8 { shl_rex = shl_rex | 1 }
                emit_byte(shl_rex)
                emit_byte(0xD3)
                uint64 shl_modrm = 0xE0 | (dst_r & 7)
                uint8 shl_m = shl_modrm
                emit_byte(shl_m)
            }
        } else {
            ir_emit_mov_r64_r64(0, a_reg)
            emit_byte(0x48)
            emit_byte(0xD3)
            emit_byte(0xE0)
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 11 {
        // IR_SHR: shr dst, cl
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        uint64 b_reg = ir_resolve_src(s2_v, 1)
        if b_reg != 1 { ir_emit_mov_r64_r64(1, b_reg) }
        if dst_r != 0xFFFFFFFF {
            if dst_r == 1 && a_reg != 1 {
                // dst is rcx which holds shift count — use rax as temporary
                ir_emit_mov_r64_r64(0, a_reg)
                emit_byte(0x48)
                emit_byte(0xD3)
                emit_byte(0xE8)
                ir_emit_mov_r64_r64(dst_r, 0)
            } else {
                ir_emit_mov_r64_r64(dst_r, a_reg)
                uint8 shr_rex = 0x48
                if dst_r >= 8 { shr_rex = shr_rex | 1 }
                emit_byte(shr_rex)
                emit_byte(0xD3)
                uint64 shr_modrm = 0xE8 | (dst_r & 7)
                uint8 shr_m = shr_modrm
                emit_byte(shr_m)
            }
        } else {
            ir_emit_mov_r64_r64(0, a_reg)
            emit_byte(0x48)
            emit_byte(0xD3)
            emit_byte(0xE8)
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 134 {
        // IR_SAR: arithmetic shift right (sign-extending). Same encoding as
        // SHR but ModRM /7 (base 0xF8) instead of /5 (base 0xE8).
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        uint64 b_reg = ir_resolve_src(s2_v, 1)
        if b_reg != 1 { ir_emit_mov_r64_r64(1, b_reg) }
        if dst_r != 0xFFFFFFFF {
            if dst_r == 1 && a_reg != 1 {
                ir_emit_mov_r64_r64(0, a_reg)
                emit_byte(0x48)
                emit_byte(0xD3)
                emit_byte(0xF8)
                ir_emit_mov_r64_r64(dst_r, 0)
            } else {
                ir_emit_mov_r64_r64(dst_r, a_reg)
                uint8 sar_rex = 0x48
                if dst_r >= 8 { sar_rex = sar_rex | 1 }
                emit_byte(sar_rex)
                emit_byte(0xD3)
                uint64 sar_modrm = 0xF8 | (dst_r & 7)
                uint8 sar_m = sar_modrm
                emit_byte(sar_m)
            }
        } else {
            ir_emit_mov_r64_r64(0, a_reg)
            emit_byte(0x48)
            emit_byte(0xD3)
            emit_byte(0xF8)
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 12 {
        // IR_NEG
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        if dst_r != 0xFFFFFFFF {
            ir_emit_mov_r64_r64(dst_r, a_reg)
            ir_emit_neg_r64(dst_r)
        } else {
            ir_emit_mov_r64_r64(0, a_reg)
            ir_emit_neg_r64(0)
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op == 13 {
        // IR_NOT
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        if dst_r != 0xFFFFFFFF {
            ir_emit_mov_r64_r64(dst_r, a_reg)
            ir_emit_not_r64(dst_r)
        } else {
            ir_emit_mov_r64_r64(0, a_reg)
            ir_emit_not_r64(0)
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    if op >= 14 && op <= 19 {
        // IR_CMP_EQ through IR_CMP_GE: cmp + setcc + movzx
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        // src2 == 0 is the sentinel for cmp-imm mode (set by const-fold
        // when src2 was a known constant fitting in signed 32-bit).
        if s2_v == 0 {
            ir_emit_cmp_r64_imm(a_reg, imm)
        } else {
            uint64 b_reg = ir_resolve_src(s2_v, 1)
            ir_emit_cmp_r64_r64(a_reg, b_reg)
        }
        // Fusion path: if this cmp feeds the BB's BR_COND terminator with a
        // single use, stash the jcc code and stop here. The terminator will
        // emit `0F <jcc> disp32` directly on the flags we just set.
        uint64 fuse = ir_cmp_fuse_code(ii)
        if fuse != 0 {
            ir_fused_jcc_code = fuse
            return
        }
        // setcc al: 0F xx C0
        emit_byte(0x0F)
        if op == 14 { emit_byte(0x94) }  // sete
        if op == 15 { emit_byte(0x95) }  // setne
        if op == 16 { emit_byte(0x92) }  // setb  (unsigned <)
        if op == 17 { emit_byte(0x96) }  // setbe (unsigned <=)
        if op == 18 { emit_byte(0x97) }  // seta  (unsigned >)
        if op == 19 { emit_byte(0x93) }  // setae (unsigned >=)
        emit_byte(0xC0)
        // movzx rax, al: 48 0F B6 C0
        emit_byte(0x48)
        emit_byte(0x0F)
        emit_byte(0xB6)
        emit_byte(0xC0)
        // Move result to dst
        if dst_r != 0xFFFFFFFF {
            ir_emit_mov_r64_r64(dst_r, 0)
        } else {
            ir_emit_store_spill(0, dest_v)
        }
        return
    }

    // Signed comparisons (IR_SCMP_LT=120 through IR_SCMP_GE=123)
    if op >= 120 && op <= 123 {
        uint64 a_reg = ir_resolve_src(s1_v, 0)
        if s2_v == 0 {
            ir_emit_cmp_r64_imm(a_reg, imm)
        } else {
            uint64 b_reg = ir_resolve_src(s2_v, 1)
            ir_emit_cmp_r64_r64(a_reg, b_reg)
        }
        uint64 fuse_s = ir_cmp_fuse_code(ii)
        if fuse_s != 0 {
            ir_fused_jcc_code = fuse_s
            return
