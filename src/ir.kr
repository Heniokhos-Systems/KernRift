            emit_byte(0x48); emit_byte(0x31); emit_byte(0xD2)
            ir_emit_mov_r64_imm64(8, 0x8000)  // r8 = MEM_RELEASE
            emit_win_alloc_stack(0x20)
            emit_win_call_iat(13)              // VirtualFree (IAT slot 13)
