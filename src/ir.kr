        uint64 mc_dst2 = ir_resolve_src(s1_v, 0)
        if dst_r != 0xFFFFFFFF {
            ir_emit_mov_r64_r64(dst_r, mc_dst2)
        } else {
            ir_emit_mov_r64_r64(0, mc_dst2)
            ir_emit_store_spill(0, dest_v)
