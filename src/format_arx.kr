// format_arx.kr — ARX container (--emit=arx, emit_mode 10).
//
// ApexRift's own executable container: its kernel parses this directly to load
// a program off its filesystem and enter it. The format is specified OUTSIDE
// this tree, in ApexRift's docs/ARX_FORMAT.md, and a working loader (arx.kr)
// already consumes it — so this file implements a contract, it does not define
// one. Fields whose meaning looks arbitrary here are pinned there.
//
// WHAT IT SHARES AND WHAT IT DOES NOT, the same distinction that made --emit=uefi
// a new mode rather than a flag on --emit=image: the PAYLOAD is the flat
// position-independent blob (img_raw, exactly as modes 8 and 9), the CONTAINER
// is shared with nothing.
//
// THE HEADER REGION IS 4096 BYTES AND ONLY 128 ARE USED. That is not slack for
// its own sake — it is the arm64 correctness constraint, and it is the same
// reason --emit=uefi reserves 4096 for a PE header that needs far less. Every
// arm64 ADRP page computation is baked during codegen from
// a64_compute_va(file_offset) = 0x400000 + file_offset, which knows nothing
// about containers. The loader places payload byte `f` at `base + (f -
// file_off)`, so the baked arithmetic survives exactly when
//
//     (file_off - mem_off) % 4096 == 0   AND   base % 4096 == 0
//
// The first half is this region's size; the second comes solely from the
// `align` field written below, which the loader honours by over-allocating and
// rounding up. BOTH halves are load-bearing: `align` is not decoration, and a
// later "simplification" that lowers it (the loader would accept 16) leaves
// x86_64 working and breaks arm64 at run time with no diagnostic.
//
// UNLIKE A PE, THIS HEADER REGION IS NOT LOADED. The segment entry starts at
// file offset 4096 and maps to image offset 0, and `image_size` covers the
// payload alone. A PE's headers are mapped; these are not.

static uint64 ARX_HDR_REGION = 4096   // see the congruence note above
static uint64 ARX_MAGIC_LE   = 0x5852417F   // bytes 7F 'A' 'R' 'X'

// --- modules (--emit=arxmod) -------------------------------------------------
//
// A MODULE IS THE SAME CONTAINER WITH TWO ADDITIONS: header flag bit 2, and a
// MODINFO table the loader reads BEFORE it enters anything. It is not a second
// format -- the payload, the segment split, the alignment rule and the checksum
// are identical, and a module that differed in any of those would need a second
// loader to be wrong in a second way.
//
// WHY THE ABI GOES IN THE CONTAINER AND NOT IN THE MODULE'S CODE. The obvious
// cheaper design is for the module's own init to check the services table's
// version and refuse. That check runs too late: the module is already loaded,
// already entered, and already privileged when it discovers it does not
// understand the kernel it is talking to. A version the LOADER can read without
// executing anything is the only kind that can refuse before that point.
//
// The name is here for the same reason: `lsmod` and `rmmod` need to name a
// module that failed to initialise, and a name that lives only in code the
// kernel declined to run is a name nobody can print.
static uint64 ARX_KIND_MODINFO = 6
static uint64 arx_is_module  = 0
static uint64 arx_mod_name   = 0     // pointer to the NUL-terminated name
static uint64 arx_mod_abi    = 0
static uint64 arx_mod_ver    = 0

// WHERE THE SEGMENT TABLE STARTS depends on how many directory entries precede
// it, and a module has two. Held in a static rather than recomputed at each
// patch site: patch_arx_headers writes six segment fields by offset, and six
// places that each add 88 or 112 by hand is six places to get it wrong once.
static uint64 arx_seg_tab = 88

@export
fn arx_set_module(uint64 name, uint64 abi, uint64 ver) {
    arx_is_module = 1
    arx_mod_name  = name
    arx_mod_abi   = abi
    arx_mod_ver   = ver
}

// Emit the header region and return its size, so the finalize arm cannot drift
// from it — the same contract emit_uefi_headers has, and for the same reason.
//
// `arch_id`   1 = x86_64, 2 = arm64 (ARX's own numbering, not this tree's).
// `entry_rel` entry offset RELATIVE TO THE IMAGE BASE, i.e. already has the
//             header region subtracted. Passing a file offset here would place
//             the entry 4096 bytes past the real one, which the loader catches
//             (its entry must land inside an executable segment's file-backed
//             bytes) but only after the artifact has shipped.
// `payload`   payload length in bytes; filesz == memsz == image_size today,
//             because a KernRift flat image has no bss.
//
// The checksum is written as ZERO here and patched afterwards by
// arx_patch_checksum: it covers the whole file, so it cannot be computed until
// the payload exists.
fn emit_arx_headers(uint64 arch_id, uint64 entry_rel, uint64 payload) -> uint64 {
    // ---- header, 64 bytes ----
    emit_u32_le(ARX_MAGIC_LE)
    emit_u16_le(1)                  // version
    emit_u16_le(64)                 // header_size: the HEADER, not the region.
                                    // The loader validates it as a range so a
                                    // later version can grow the header
                                    // detectably; it is not the region size.
    emit_u16_le(arch_id)
    emit_u16_le(1)                  // flags: bit 0 PIC. Always set — this tree
                                    // emits nothing else, and the loader
                                    // refuses a clear bit rather than guessing.
    // table_count: one SEGMENT table (which holds TWO entries -- the count is
    // tables, not segments), plus MODINFO for a module.
    if arx_is_module != 0 { emit_u32_le(2) } else { emit_u32_le(1) }
    emit_u64_le(64)                 // table_off: directory sits right after the
                                    // header, inside the reserved region
    emit_u64_le(entry_rel)
    emit_u64_le(payload)            // image_size — payload only; the region is
                                    // not loaded
    emit_u64_le(4096)               // align. Load-bearing for arm64; see above
    emit_u64_le(0)                  // checksum, patched later
    emit_u64_le(0)                  // reserved, must be 0 (the loader refuses
                                    // nonzero so the field stays usable)

    // ---- table directory: one 24-byte entry, or two for a module ----
    //
    // THE SEGMENT TABLE MOVES when a second directory entry is added, and it
    // has to: the directory is contiguous from table_off, so entry 1 occupies
    // exactly the 24 bytes the segment table used to start at. Emitting two
    // entries and leaving the segments at 88 would put the second directory
    // entry on top of segment 0.
    if arx_is_module != 0 { arx_seg_tab = 112 } else { arx_seg_tab = 88 }
    emit_u32_le(1)                  // kind = SEGMENT
    emit_u32_le(1)                  // flags = MANDATORY. The format makes this
                                    // a PRODUCER OBLIGATION, not a hint: later
                                    // stages add table kinds WITHOUT bumping
                                    // `version`, so this flag is the only thing
                                    // that stops an older loader silently
                                    // mis-loading a newer file.
    emit_u64_le(arx_seg_tab)        // off: after the header and the directory
    emit_u64_le(80)                 // size: TWO segment entries. Patched down
                                    // to 40 when the payload has no statics --
                                    // see patch_arx_headers.
    if arx_is_module != 0 {
        // MANDATORY, and that is the whole point of the flag. A loader that
        // does not know kind 6 must REFUSE this file rather than load a
        // privileged image without checking what ABI it was built against.
        emit_u32_le(ARX_KIND_MODINFO)
        emit_u32_le(1)              // MANDATORY
        emit_u64_le(192)            // off: 112 segment table + 80 bytes of it
        emit_u64_le(24 + str_len(arx_mod_name) + 1)
    }

    // ---- TWO segments: R|X code, R|W data --------------------------------
    //
    // This emitted ONE R|X segment over the whole payload for as long as the
    // format existed, and ApexRift's format doc called the per-segment flags
    // "recorded, not enforced (no MMU)". The MMU stopped being the reason: that
    // kernel enforces page permissions now, and discovered it could not enforce
    // these, because the one segment it was handed claims R|X over memory the
    // program WRITES. krc assigns cli_argc before it does anything else, so
    // honouring the flags as emitted faulted it on its first instruction.
    //
    // The split is the same one --emit=uefi makes between .text and .data, at
    // the same place and for the same reason, and main.kr now takes the page
    // boundary for both. Sizes are zero here and patched once the payload
    // exists, exactly like image_size.
    //
    // ---- segment 0: code + string literals, 40 bytes ----
    emit_u64_le(ARX_HDR_REGION)     // file_off — the congruence constraint
    emit_u64_le(0)                  // mem_off
    emit_u64_le(0)                  // filesz  — patched
    emit_u64_le(0)                  // memsz   — patched
    emit_u32_le(5)                  // flags R|X. The X bit is not cosmetic:
                                    // the loader requires the entry to land in
                                    // an executable segment and refuses
                                    // otherwise.
    emit_u32_le(0)                  // align: RESERVED, must be 0

    // ---- segment 1: static data, 40 bytes ----
    emit_u64_le(0)                  // file_off — patched
    emit_u64_le(0)                  // mem_off  — patched
    emit_u64_le(0)                  // filesz   — patched
    emit_u64_le(0)                  // memsz    — patched
    emit_u32_le(3)                  // flags R|W. NOT X: a program that can
                                    // write its data and execute it has W^X in
                                    // name only.
    emit_u32_le(0)                  // align: RESERVED, must be 0

    // ---- MODINFO contents, when this is a module ----
    //
    // 24 fixed bytes then the name, NUL-terminated. The name is stored inline
    // rather than as an offset into a string table because there is exactly one
    // string: a STRTAB (kind 3) for a single name would be a table the loader
    // has to validate for no gain.
    // THE CURSOR IS DERIVED, NOT WRITTEN DOWN. It was the literal 168 -- correct
    // for the one-table layout and 24 bytes short for a module's two, which put
    // MODINFO's contents 24 bytes past the offset its own directory entry
    // declared. The loader read three zeros and a name that was one stray byte.
    // arx_seg_tab + 80 is the same arithmetic the directory entry used, so the
    // two cannot disagree again.
    uint64 i = arx_seg_tab + 80
    if arx_is_module != 0 {
        emit_u64_le(arx_mod_abi)
        emit_u64_le(arx_mod_ver)
        emit_u64_le(0)              // reserved, must be 0
        i = i + 24
        uint64 ni = 0
        while ni < str_len(arx_mod_name) {
            uint8 nb = 0
            uint64 np = arx_mod_name + ni
            unsafe { *(np as uint8) -> nb }
            emit_byte(nb)
            ni = ni + 1
            i = i + 1
        }
        emit_byte(0)
        i = i + 1
    }

    // ---- pad the rest of the region ----
    while i < ARX_HDR_REGION { emit_byte(0); i = i + 1 }
    return ARX_HDR_REGION
}

// Patch the three fields that are not known until the payload exists, then the
// checksum. Mirrors patch_uefi_headers: this file owns every header offset, so
// main.kr never learns one.
//
// `entry_rel` is the entry offset MINUS the header region -- relative to the
// image base, because mem_off is 0. Handing it a file offset would put the
// entry 4096 bytes past the real function; the loader would catch it (the entry
// must land inside an executable segment's file-backed bytes) but only after
// the artifact shipped.
// `wants_services` is bit 1: the entry takes the kernel's services table as
// its one argument. It is patched HERE rather than emitted, because the header
// goes out before any function is emitted and the entry's arity is not known
// until it has been resolved.
//
// Producing this correctly is what lets an ARX program be built and run without
// a post-hoc patch step. ApexRift's tools patched the bit in afterwards and
// recomputed the checksum, which meant a container the compiler emitted could
// not run as emitted -- and a compiler that cannot emit a runnable copy of a
// services program cannot bootstrap one.
fn patch_arx_headers(uint64 entry_rel, uint64 payload, uint64 wants_services,
                     uint64 data_rel) {
    uint64 fl = 1                   // bit 0 PIC, always
    if wants_services != 0 { fl = fl | 2 }
    if arx_is_module != 0 { fl = fl | 4 }
    patch_u16(10, fl)               // header flags
    patch_u64(24, entry_rel)        // header entry
    patch_u64(32, payload)          // header image_size

    // Segment 0 ends where the statics begin. main.kr took a page boundary
    // there, so both segments are page-granular and a loader can give them
    // different permissions.
    patch_u64(arx_seg_tab + 16, data_rel)   // seg0 filesz
    patch_u64(arx_seg_tab + 24, data_rel)   // seg0 memsz

    // Segment 1 covers the rest. file_off keeps the (file_off - mem_off) % 4096
    // congruence the arm64 ADRP arithmetic depends on: both offsets shift by
    // the same page-aligned data_rel, so the difference is unchanged at
    // ARX_HDR_REGION.
    patch_u64(arx_seg_tab + 40 + 0, ARX_HDR_REGION + data_rel)   // seg1 file_off
    patch_u64(arx_seg_tab + 40 + 8, data_rel)                    // seg1 mem_off
    patch_u64(arx_seg_tab + 40 + 16, payload - data_rel)         // seg1 filesz
    patch_u64(arx_seg_tab + 40 + 24, payload - data_rel)         // seg1 memsz

    // A PAYLOAD WITH NO STATICS would leave a zero-length second segment. The
    // loader tolerates one, but describing memory that is not there invites a
    // reader -- human or machine -- to reason about a segment with no bytes. So
    // the table shrinks to the one real entry instead.
    if payload == data_rel { patch_u64(80, 40) }
}

// FNV-1a over the finished file with the 8 checksum bytes treated as zero, then
// stored into them. Integrity against corruption only -- trivially forged, and
// ApexRift's format doc is explicit that it is NOT a security boundary.
//
// Must run LAST: it covers every byte, so any later patch silently invalidates
// it. The loader would then refuse the file, which is the safe direction, but
// the ordering is a real constraint rather than a preference.
fn arx_patch_checksum(uint64 len) {
    uint64 h = 0xcbf29ce484222325
    uint64 i = 0
    while i < len {
        uint64 p = out_buf + i
        uint8 c = 0
        unsafe { *(p as uint8) -> c }
        uint64 b = c
        // Bytes [48, 56) are the checksum field: hashed as zero so the value
        // can live inside the region it covers.
        if i >= 48 {
            if i < 56 { b = 0 }
        }
        h = h ^ b
        h = h * 0x100000001b3
        i = i + 1
    }
    patch_u64(48, h)
}
