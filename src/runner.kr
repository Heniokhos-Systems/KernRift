// KernRift .krbo runner — extracts and executes fat binaries
// Usage: kr program.krbo [args...]
// Detects host arch, extracts the matching slice, writes to temp, executes it.

// BCJ filters are linked via cat (see Makefile/CI)

// A LOCAL COPY of main.kr's read_exact, and it has to be one. The runner is a
// SEPARATE program -- `cat src/runner.kr src/bcj.kr` (Makefile) -- and
// src/runner.kr is not in SRCS, so nothing here can see src/main.kr. The
// definition cannot be hoisted into bcj.kr either: that file IS in SRCS, so a
// definition there would collide with main.kr's in the compiler build. The two
// copies must be kept in sync by hand; `make test` catches the missing one,
// because build/kr-bin is a prerequisite of it.
//
// A LOOP, not a single call plus a comparison. read(2) is explicitly permitted
// to return less than asked for without anything being wrong, so treating one
// short return as an error would break legitimate reads. Only a read that
// returns 0 before `want` is reached is a truncation.
fn read_exact(uint64 fd, uint64 buf, uint64 want) -> uint64 {
    uint64 got = 0
    while got < want {
        uint64 n = file_read(fd, buf + got, want - got)
        if n == 0 { return got }
        // A provider claiming to have written more than there was room for is
        // lying; believing it would advance `got` past the buffer.
        if n > want - got { return got }
        got = got + n
    }
    return got
}

fn str_len_r(uint64 s) -> uint64 {
    uint64 i = 0
    uint64 p = s + i
    uint64 c = 0
    unsafe { *(p as uint8) -> c }
    while c != 0 {
        i = i + 1
        p = s + i
        unsafe { *(p as uint8) -> c }
    }
    return i
}

// Compare two null-terminated strings byte-for-byte.
fn str_eq_r(uint64 a, uint64 b) -> uint64 {
    uint64 i = 0
    uint64 done = 0
    while done == 0 {
        uint64 ap = a + i
        uint64 bp = b + i
        uint64 ac = 0
        uint64 bc = 0
        unsafe { *(ap as uint8) -> ac }
        unsafe { *(bp as uint8) -> bc }
        if ac != bc { return 0 }
        if ac == 0 { return 1 }
        i = i + 1
    }
    return 1
}

// Decompress a single LZ4 block in-place from [src, src+src_len) into
// [dst, ...). Returns the number of output bytes. Must byte-wise forward
// copy matches to handle the LZ4 RLE case where offset < match_len.
fn lz4_decompress_block_r(uint64 src, uint64 src_len, uint64 dst) -> uint64 {
    uint64 sp = 0
    uint64 dp = 0
    while sp < src_len {
        uint64 tp = src + sp
        uint64 token = 0
        unsafe { *(tp as uint8) -> token }
        sp = sp + 1

        // Literal length (token high nibble; 15 => extra bytes follow)
        uint64 lit_len = (token >> 4) & 0x0F
        if lit_len == 15 {
            uint64 done_l = 0
            while done_l == 0 {
                if sp >= src_len { done_l = 1 }
                if done_l == 0 {
                    uint64 ep = src + sp
                    uint64 eb = 0
                    unsafe { *(ep as uint8) -> eb }
                    sp = sp + 1
                    lit_len = lit_len + eb
                    if eb != 255 { done_l = 1 }
                }
            }
        }

        // Copy literal bytes
        if lit_len != 0 {
            memcpy(dst + dp, src + sp, lit_len)
        }
        sp = sp + lit_len
        dp = dp + lit_len

        // Last sequence has no match — if we've consumed the block, stop.
        if sp >= src_len { break }

        // Offset (3 bytes LE, 1..16777215) — LZ-Rift 24-bit window
        uint64 op0 = src + sp
        uint64 op1 = src + sp + 1
        uint64 op2 = src + sp + 2
        uint64 o0 = 0
        uint64 o1 = 0
        uint64 o2 = 0
        unsafe { *(op0 as uint8) -> o0 }
        unsafe { *(op1 as uint8) -> o1 }
        unsafe { *(op2 as uint8) -> o2 }
        uint64 offset = o0 | (o1 << 8) | (o2 << 16)
        sp = sp + 3

        // Match length (token low nibble + 4; 15 => extra bytes follow)
        uint64 match_code = token & 0x0F
        uint64 match_len = match_code + 4
        if match_code == 15 {
            uint64 done_m = 0
            while done_m == 0 {
                if sp >= src_len { done_m = 1 }
                if done_m == 0 {
                    uint64 ep = src + sp
                    uint64 eb = 0
                    unsafe { *(ep as uint8) -> eb }
                    sp = sp + 1
                    match_len = match_len + eb
                    if eb != 255 { done_m = 1 }
                }
            }
        }

        // Byte-by-byte copy supports the overlap / RLE case where
        // offset < match_len (e.g. offset=1 copies one byte match_len times).
        uint64 mi = 0
        while mi < match_len {
            uint64 ms = dst + dp - offset + mi
            uint64 md = dst + dp + mi
            uint64 mb = 0
            unsafe { *(ms as uint8) -> mb }
            uint8 mbb = mb
            unsafe { *(md as uint8) = mbb }
            mi = mi + 1
        }
        dp = dp + match_len
    }
    return dp
}

fn lz4_decompress_frame_r(uint64 input, uint64 input_len, uint64 output) -> uint64 {
    // Skip magic(4) + FLG(1) + BD(1) + HC(1) = 7 bytes
    uint64 pos = 7
    uint64 out_pos = 0
    while pos < input_len {
        uint64 bp = input + pos
        uint32 block_size_raw = 0
        unsafe { *(bp as uint32) -> block_size_raw }
        uint64 bs = block_size_raw
        pos = pos + 4
        if bs == 0 { break }

        uint64 data_len = bs & 0x7FFFFFFF
        if (bs & 0x80000000) != 0 {
            // Uncompressed block — memcpy as-is
            uint64 i = 0
            while i < data_len {
                uint64 sp = input + pos + i
                uint64 dp = output + out_pos + i
                uint64 b = 0
                unsafe { *(sp as uint8) -> b }
                uint8 bb = b
                unsafe { *(dp as uint8) = bb }
                i = i + 1
            }
            out_pos = out_pos + data_len
        } else {
            // Real LZ4 block
            uint64 written = lz4_decompress_block_r(input + pos, data_len, output + out_pos)
            out_pos = out_pos + written
        }
        pos = pos + data_len
    }
    return out_pos
}

fn detect_arch_r() -> uint64 {
    uint64 aid = get_arch_id()
    if aid == 2 {
        uint64 lfd = file_open("/system/bin/linker64", 0)
        if lfd < 0xFFFFFFFF {
            file_close(lfd)
            return 7
        }
    }
    return aid
}

static uint64 cli_argc = 0
static uint64 cli_argv = 0
static uint64 cli_envp = 0
static uint64 exec_errno = 0

fn win_init_args_r() {
    uint64 cmdline = cli_argv
    uint64 argv_buf = alloc(512)
    uint64 argc = 0
    uint64 pos = cmdline
    uint64 ch = 0
    unsafe { *(pos as uint8) -> ch }
    while ch != 0 {
        while ch == 32 {
            pos = pos + 1
            unsafe { *(pos as uint8) -> ch }
        }
        if ch == 0 { break }
        uint64 slot = argv_buf + argc * 8
        unsafe { *(slot as uint64) = pos }
        argc = argc + 1
        while ch != 0 && ch != 32 {
            pos = pos + 1
            unsafe { *(pos as uint8) -> ch }
        }
        if ch == 32 {
            uint8 z = 0
            unsafe { *(pos as uint8) = z }
            pos = pos + 1
            unsafe { *(pos as uint8) -> ch }
        }
    }
    cli_argc = argc
    cli_argv = argv_buf
}

// ---------------------------------------------------------------------------
// Executing the extracted image: once per run, never through a shared name.
//
// The runner used to write every image to ONE fixed path -- /tmp/.kr-exec
// (Linux, macOS), .\kr-run.exe (Windows), /data/local/tmp/kr-exec (Android)
// -- so two runs at once overwrote each other: the second one's open for
// writing failed with ETXTBSY while the first one's program ran ("kr: failed
// to create temp file"), or replaced the bytes the first was about to exec.
// Now, per host:
//   Linux, Android: the image goes into an anonymous memfd and is executed
//     with execveat(AT_EMPTY_PATH) -- no file at all. If memfd_create is not
//     there, a file is created EXCLUSIVELY (O_EXCL) under $TMPDIR (else /tmp,
//     /data/local/tmp on Android) as .kr-exec.<pid>.<n>, reopened read-only,
//     UNLINKED, and executed through that descriptor: nothing is left behind
//     even if the program is killed. Where no descriptor exec works (Linux
//     < 3.19, or qemu-user, which does not emulate execveat) the macOS route
//     below runs.
//   macOS: the same exclusive file under $TMPDIR, run as a CHILD (fork,
//     execve); the runner waits for it, removes the file, and exits with the
//     child's status -- or dies of the child's signal. HUP, INT, QUIT and TERM
//     are blocked in the runner while it waits (they stay pending and act
//     after the file is gone); the child runs with the mask it inherited.
//   Windows: there is no delete builtin and exec_process exits the runner
//     with the child's code, so the file cannot be removed. It is
//     .\kr-run-<n>.exe, the first of 64 names whose open for writing
//     succeeds -- an image that is running cannot be opened for writing, so
//     two runs at once never share one; a finished run's file is reused.
//   Android under Termux, where SELinux refuses the runner's own exec: the
//     image is written to the file the wrapper (packaging/kr.sh) names in
//     $KR_EXEC_FALLBACK -- which it made with mktemp -- and the runner exits
//     120; the wrapper runs it and removes it. Without the wrapper, the
//     macOS route is tried.
// KR_RUNNER_EXEC=file or =fork forces the descriptor-exec or the child route
// on Linux, so the suite can run the routes it cannot otherwise reach
// (runner_exec_paths_are_per_run).
// ---------------------------------------------------------------------------

fn kx_x86() -> uint64 {
    uint64 a = get_arch_id()
    if a == 1 || a == 3 || a == 5 || a == 8 { return 1 }
    return 0
}

// Syscall numbers, per OS and arch. op: 0 getpid, 1 open(at), 2 write,
// 3 close, 4 unlink(at), 5 execveat, 6 memfd_create, 7 fork, 8 wait4,
// 9 sigprocmask, 10 fchmod, 11 kill, 12 fcntl.
fn kx_nr(uint64 op) -> uint64 {
    if get_target_os() == 1 {
        uint64 m = 0
        if op == 0 { m = 20 }
        if op == 1 { m = 5 }
        if op == 2 { m = 4 }
        if op == 3 { m = 6 }
        if op == 4 { m = 10 }
        if op == 7 { m = 2 }
        if op == 8 { m = 7 }
        if op == 9 { m = 48 }
        if op == 10 { m = 124 }
        if op == 11 { m = 37 }
        if op == 12 { m = 92 }
        if kx_x86() != 0 { return 0x2000000 | m }
        return m
    }
    if kx_x86() != 0 {
        if op == 0 { return 39 }
        if op == 1 { return 257 }
        if op == 2 { return 1 }
        if op == 3 { return 3 }
        if op == 4 { return 263 }
        if op == 5 { return 322 }
        if op == 6 { return 319 }
        if op == 7 { return 57 }
        if op == 8 { return 61 }
        if op == 9 { return 14 }
        if op == 10 { return 91 }
        if op == 11 { return 62 }
        return 72
    }
    if op == 0 { return 172 }
    if op == 1 { return 56 }
    if op == 2 { return 64 }
    if op == 3 { return 57 }
    if op == 4 { return 35 }
    if op == 5 { return 281 }
    if op == 6 { return 279 }
    if op == 7 { return 220 }
    if op == 8 { return 260 }
    if op == 9 { return 135 }
    if op == 10 { return 52 }
    if op == 11 { return 129 }
    return 25
}

// A Linux syscall failed when it returned -4095..-1. On macOS a failure
// returns the errno itself (the carry flag says which, and syscall_raw does
// not report it), so the macOS callers check their results another way.
fn kx_err(uint64 r) -> uint64 {
    if r >= 0xFFFFFFFFFFFFF000 { return 1 }
    return 0
}

// The value of NAME= in the environment, or 0.
fn kx_getenv(uint64 name) -> uint64 {
    if cli_envp == 0 { return 0 }
    uint64 nl = str_len_r(name)
    uint64 i = 0
    uint64 e = load64(cli_envp)
    while e != 0 {
        uint64 j = 0
        while j < nl && load8(e + j) == load8(name + j) { j = j + 1 }
        if j == nl && load8(e + nl) == 61 { return e + nl + 1 }
        i = i + 1
        e = load64(cli_envp + i * 8)
    }
    return 0
}

// Append the bytes of s to buf at *pos (pos is a one-slot cell).
fn kx_put(uint64 buf, uint64 pos, uint64 s) {
    uint64 p = load64(pos)
    uint64 i = 0
    while load8(s + i) != 0 {
        store8(buf + p, load8(s + i))
        p = p + 1
        i = i + 1
    }
    store64(pos, p)
}

fn kx_put_dec(uint64 buf, uint64 pos, uint64 v) {
    uint64 tmp = alloc(24)
    uint64 n = 0
    if v == 0 { store8(tmp, 48)  n = 1 }
    while v != 0 {
        store8(tmp + n, 48 + v % 10)
        v = v / 10
        n = n + 1
    }
    uint64 p = load64(pos)
    while n > 0 {
        n = n - 1
        store8(buf + p, load8(tmp + n))
        p = p + 1
    }
    store64(pos, p)
}

// Open `path` for writing, exclusively and close-on-exec. Returns the
// descriptor or 0xFFFFFFFFFFFFFFFF.
fn kx_open_excl(uint64 path) -> uint64 {
    if get_target_os() == 1 {
        // O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC on Darwin.
        uint64 fd = syscall_raw(kx_nr(1), path, 0x1000A01, 0x1C0, 0, 0, 0)
        // A failure returns the errno, which looks like a small descriptor.
        // Ours was opened close-on-exec, so F_GETFD (1) says FD_CLOEXEC (1);
        // on a number that is not an open descriptor it returns EBADF (9).
        if syscall_raw(kx_nr(12), fd, 1, 0, 0, 0, 0) != 1 { return 0xFFFFFFFFFFFFFFFF }
        return fd
    }
    // openat(AT_FDCWD, path, O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC, 0700)
    uint64 fd = syscall_raw(kx_nr(1), 0xFFFFFFFFFFFFFF9C, path, 0x800C1, 0x1C0, 0, 0)
    if kx_err(fd) != 0 { return 0xFFFFFFFFFFFFFFFF }
    return fd
}

fn kx_unlink(uint64 path) {
    if get_target_os() == 1 {
        syscall_raw(kx_nr(4), path, 0, 0, 0, 0, 0)
        return
    }
    syscall_raw(kx_nr(4), 0xFFFFFFFFFFFFFF9C, path, 0, 0, 0, 0)
}

// Write all of buf to fd. Returns 1 on success.
fn kx_write_all(uint64 fd, uint64 buf, uint64 len) -> uint64 {
    uint64 done = 0
    while done < len {
        uint64 w = syscall_raw(kx_nr(2), fd, buf + done, len - done, 0, 0, 0)
        if kx_err(w) != 0 || w == 0 || w > len - done { return 0 }
        done = done + w
    }
    return 1
}

// Create the image as a new file under $TMPDIR (else the per-OS default),
// named .kr-exec.<pid>.<n>, exclusively. Returns the path (and the image is
// written, executable, closed) or 0.
fn kx_make_file(uint64 image, uint64 len) -> uint64 {
    uint64 dir = kx_getenv("TMPDIR")
    if dir != 0 {
        if load8(dir) == 0 || str_len_r(dir) > 3000 { dir = 0 }
    }
    if dir == 0 {
        dir = "/tmp"
        if get_target_os() == 3 { dir = "/data/local/tmp" }
    }
    uint64 pid = syscall_raw(kx_nr(0), 0, 0, 0, 0, 0, 0)
    uint64 path = alloc(3200)
    uint64 pos = alloc(8)
    uint64 n = 0
    while n < 100 {
        store64(pos, 0)
        kx_put(path, pos, dir)
        kx_put(path, pos, "/.kr-exec.")
        kx_put_dec(path, pos, pid)
        kx_put(path, pos, ".")
        kx_put_dec(path, pos, n)
        store8(path + load64(pos), 0)
        uint64 fd = kx_open_excl(path)
        if fd != 0xFFFFFFFFFFFFFFFF {
            uint64 ok = kx_write_all(fd, image, len)
            syscall_raw(kx_nr(10), fd, 0x1C0, 0, 0, 0, 0)
            syscall_raw(kx_nr(3), fd, 0, 0, 0, 0, 0)
            if ok == 0 {
                kx_unlink(path)
                return 0
            }
            return path
        }
        n = n + 1
    }
    return 0
}

// The macOS route (and Linux without execveat): run the file as a child,
// wait, remove it, and leave with the child's status.
fn kx_run_child(uint64 path, uint64 argv) {
    uint64 set = alloc(16)
    uint64 old = alloc(16)
    // HUP(1) INT(2) QUIT(3) TERM(15): bits sig-1.
    store64(set, 0x4007)
    store64(old, 0)
    uint64 how_block = 0
    uint64 how_setmask = 2
    if get_target_os() == 1 {
        how_block = 1
        how_setmask = 3
    }
    syscall_raw(kx_nr(9), how_block, set, old, 8, 0, 0)
    uint64 pid0 = syscall_raw(kx_nr(0), 0, 0, 0, 0, 0, 0)
    uint64 child = 0
    if get_target_os() == 1 || kx_x86() != 0 {
        child = syscall_raw(kx_nr(7), 0, 0, 0, 0, 0, 0)
    } else {
        // arm64 Linux has no fork: clone(SIGCHLD, 0, 0, 0, 0).
        child = syscall_raw(kx_nr(7), 17, 0, 0, 0, 0, 0)
    }
    uint64 in_child = 0
    if get_target_os() == 1 {
        // Darwin returns the PARENT's pid in the child; getpid tells them apart.
        if syscall_raw(kx_nr(0), 0, 0, 0, 0, 0, 0) != pid0 { in_child = 1 }
    } else {
        if child == 0 { in_child = 1 }
    }
    if in_child != 0 {
        syscall_raw(kx_nr(9), how_setmask, old, 0, 8, 0, 0)
        exec_process_argv(path, argv)
        exit(127)
    }
    if get_target_os() != 1 && kx_err(child) != 0 {
        kx_unlink(path)
        syscall_raw(kx_nr(9), how_setmask, old, 0, 8, 0, 0)
        write(2, "kr: fork failed\n", 16)
        exit(1)
    }
    uint64 st = alloc(8)
    store64(st, 0)
    uint64 got = syscall_raw(kx_nr(8), child, st, 0, 0, 0, 0)
    while got != child && (got == 0xFFFFFFFFFFFFFFFC || got == 4) {
        got = syscall_raw(kx_nr(8), child, st, 0, 0, 0, 0)
    }
    kx_unlink(path)
    uint64 status = load64(st) & 0xFFFF
    uint64 sig = status & 0x7F
    syscall_raw(kx_nr(9), how_setmask, old, 0, 8, 0, 0)
    if sig == 0 { exit((status >> 8) & 0xFF) }
    syscall_raw(kx_nr(11), syscall_raw(kx_nr(0), 0, 0, 0, 0, 0, 0), sig, 0, 0, 0, 0)
    exit(128 + sig)
}

// Run the image with argv (argv[0] is filled in here). Never returns.
fn kx_exec_image(uint64 image, uint64 len, uint64 argv) {
    uint64 mode = kx_getenv("KR_RUNNER_EXEC")
    uint64 force_file = 0
    uint64 force_fork = 0
    if mode != 0 {
        if str_eq_r(mode, "file") != 0 { force_file = 1 }
        if str_eq_r(mode, "fork") != 0 { force_fork = 1 }
    }
    if get_target_os() == 2 {
        // Windows: the first of .\kr-run-0.exe .. .\kr-run-63.exe that can be
        // opened for writing (not one a running program holds).
        uint64 wpath = alloc(32)
        uint64 wpos = alloc(8)
        uint64 k = 0
        while k < 64 {
            store64(wpos, 0)
            kx_put(wpath, wpos, ".\\kr-run-")
            kx_put_dec(wpath, wpos, k)
            kx_put(wpath, wpos, ".exe")
            store8(wpath + load64(wpos), 0)
            uint64 wfd = file_open(wpath, 1)
            if wfd < 0xFFFFFFFFFFFFF000 {
                file_write(wfd, image, len)
                file_close(wfd)
                store64(argv, wpath)
                exec_process_argv(wpath, argv)
                write(2, "kr: exec failed\n", 16)
                exit(1)
            }
            k = k + 1
        }
        write(2, "kr: failed to create temp file\n", 31)
        exit(1)
    } else {
        // Everything below is POSIX and sits in the else arm on purpose. A
        // compiler that refuses syscall_raw in a Windows build skips only the
        // not-taken arm of a literal get_target_os() test, so code after an
        // early exit would still be lowered, and refused, for Windows.
        if get_target_os() == 0 || get_target_os() == 3 {
            if force_file == 0 && force_fork == 0 {
                uint64 label = "kr"
                uint64 mfd = syscall_raw(kx_nr(6), label, 1, 0, 0, 0, 0)
                if kx_err(mfd) == 0 {
                    if kx_write_all(mfd, image, len) != 0 {
                        store64(argv, label)
                        syscall_raw(kx_nr(5), mfd, "", argv, cli_envp, 0x1000, 0)
                    }
                    syscall_raw(kx_nr(3), mfd, 0, 0, 0, 0, 0)
                }
            }
            if force_fork == 0 {
                uint64 fpath = kx_make_file(image, len)
                if fpath != 0 {
                    // O_RDONLY|O_CLOEXEC; the name goes before the exec.
                    uint64 rfd = syscall_raw(kx_nr(1), 0xFFFFFFFFFFFFFF9C, fpath, 0x80000, 0, 0, 0)
                    kx_unlink(fpath)
                    if kx_err(rfd) == 0 {
                        store64(argv, fpath)
                        syscall_raw(kx_nr(5), rfd, "", argv, cli_envp, 0x1000, 0)
                        syscall_raw(kx_nr(3), rfd, 0, 0, 0, 0, 0)
                    }
                }
            }
            if get_target_os() == 3 {
                // Termux: SELinux refuses the runner's own exec. The wrapper named
                // a file of its own for this run; fill it and let the wrapper run it.
                uint64 fb = kx_getenv("KR_EXEC_FALLBACK")
                if fb != 0 && load8(fb) != 0 {
                    uint64 tfd = file_open(fb, 1)
                    if tfd < 0xFFFFFFFFFFFFF000 {
                        file_write(tfd, image, len)
                        file_close(tfd)
                        set_executable(fb)
                        exit(120)
                    }
                }
            }
        }
        // macOS; and Linux or Android when no descriptor exec worked (a kernel
        // without execveat, or qemu-user, which does not emulate it), or with
        // KR_RUNNER_EXEC=fork.
        uint64 cpath = kx_make_file(image, len)
        if cpath == 0 {
            write(2, "kr: failed to create temp file\n", 31)
            exit(1)
        }
        store64(argv, cpath)
        kx_run_child(cpath, argv)
    }
}

@export
fn main() {
    if cli_argc == 0xFFFFFFFF {
        win_init_args_r()
    }
    // Linker-as-program shift: if someone ran this binary via
    //   /system/bin/linker64 ./kr test.krbo args...
    // then the kernel passes the linker its own argv starting at the
    // linker path, so our main() sees argv[0]="/system/bin/linker64",
    // argv[1]="./kr", argv[2]="test.krbo", ... — every slot shifted by
    // one. Termux's exec wrapper does the same shift but uses its own
    // (non-system) linker, AND duplicates the binary path so argv[0]
    // and argv[1] are both equal to the executable path. Detect that
    // by checking argv[0] == argv[1] string-equal — a normal shell
    // invocation never reproduces that.
    // Modern Android's PT_INTERP exec path does NOT shift, nor does
    // Linux or macOS. We must only compensate when argv[0] is one of
    // the known shifted forms; doing anything looser (e.g. "argv[0]
    // starts with /") misfires on every normal shell invocation
    // because Bash resolves `kr` to its absolute path via PATH,
    // making every Linux run look like Android.
    uint64 arg_offset = 8
    if cli_argc >= 2 {
        uint64 argv0_p = 0
        unsafe { *(cli_argv as uint64) -> argv0_p }
        if argv0_p != 0 {
            if str_eq_r(argv0_p, "/system/bin/linker64") != 0 {
                arg_offset = 16
            } else if str_eq_r(argv0_p, "/apex/com.android.runtime/bin/linker64") != 0 {
                arg_offset = 16
            } else {
                // Termux pattern: argv[0] == argv[1] (both = path-to-self).
                //
                // argv[0] must LOOK LIKE A PATH. Termux duplicates the
                // executable path, so both slots always contain a '/'.
                // Requiring one is a tightening, not the loosening the note
                // above warns against: that warns against "starts with /" as
                // the trigger BY ITSELF, which matches every Bash run. Here it
                // only ever removes matches, and the equality test already
                // excludes normal invocations (argv[1] is the .krbo, not the
                // program).
                //
                // Without it, any run whose single argument happens to equal
                // argv[0] silently loses an argument. On ApexRift argv[0] is a
                // bare basename, so `kr kr` -- a plausible typo, and a real
                // file name -- printed usage instead of running it.
                uint64 a0_has_slash = 0
                uint64 a0_i = 0
                while load8(argv0_p + a0_i) != 0 {
                    if load8(argv0_p + a0_i) == 47 { a0_has_slash = 1 }
                    a0_i = a0_i + 1
                }
                uint64 argv1_slot = cli_argv + 8
                uint64 argv1_p = 0
                unsafe { *(argv1_slot as uint64) -> argv1_p }
                if argv1_p != 0 {
                    if a0_has_slash != 0 {
                        if str_eq_r(argv0_p, argv1_p) != 0 {
                            arg_offset = 16
                        }
                    }
                }
            }
        }
    }

    // Effective argc (adjusted for Android linker shift)
    uint64 eff_argc = cli_argc
    if arg_offset == 16 { eff_argc = cli_argc - 1 }

    if eff_argc < 2 {
        uint64 wmsg_258 = "kr 2.10.0 (KernRift fat binary runner)\n"
        write(1, wmsg_258, str_len_r(wmsg_258))
        uint64 wmsg_259 = "usage: kr <program.krbo> [args...]\n\n"
        write(1, wmsg_259, str_len_r(wmsg_259))
        uint64 kr_desc = "Runs .krbo fat binaries (BCJ+LZ-Rift-compressed, 8 platform slices).\n"
        write(1, kr_desc, str_len(kr_desc))
        write(1, "Auto-detects host architecture and extracts the matching native binary.\n\n", 73)
        write(1, "options:\n", 9)
        uint64 wmsg_264 = "  --help       show this help\n"
        write(1, wmsg_264, str_len_r(wmsg_264))
        uint64 wmsg_265 = "  --version    show version\n"
        write(1, wmsg_265, str_len_r(wmsg_265))
        exit(0)
    }

    uint64 arg1_ptr = cli_argv + arg_offset
    uint64 krbo_path = 0
    unsafe { *(arg1_ptr as uint64) -> krbo_path }

    // Check for --version and --help flags
    uint64 fc = 0
    unsafe { *(krbo_path as uint8) -> fc }
    if fc == 45 {
        uint64 sc = 0
        uint64 kp1 = krbo_path + 1
        unsafe { *(kp1 as uint8) -> sc }
        if sc == 45 {
            // Starts with "--"
            uint64 tc = 0
            uint64 kp2 = krbo_path + 2
            unsafe { *(kp2 as uint8) -> tc }
            if tc == 118 {
                // --version
                uint64 wmsg_289 = "kr 2.10.0 (KernRift fat binary runner)\n"
                write(1, wmsg_289, str_len_r(wmsg_289))
                exit(0)
            }
            if tc == 104 {
                // --help
                uint64 wmsg_294 = "kr 2.10.0 (KernRift fat binary runner)\n"
                write(1, wmsg_294, str_len_r(wmsg_294))
                uint64 wmsg_295 = "usage: kr <program.krbo> [args...]\n\n"
                write(1, wmsg_295, str_len_r(wmsg_295))
                uint64 kr_desc = "Runs .krbo fat binaries (BCJ+LZ-Rift-compressed, 8 platform slices).\n"
        write(1, kr_desc, str_len(kr_desc))
                uint64 wmsg_296 = "Auto-detects host architecture and extracts the matching native binary.\n"
                write(1, wmsg_296, str_len_r(wmsg_296))
                exit(0)
            }
        }
    }

    uint64 fd = file_open(krbo_path, 0)
    uint64 fsize = file_size(fd)
    uint64 data = alloc(fsize)
    uint64 rgot = read_exact(fd, data, fsize)
    file_close(fd)
    if rgot != fsize {
        uint64 re = "error: short read: the file ended before the size it reported; refusing to run a truncated image\n"
        write(2, re, str_len(re))
        exit(1)
    }

    uint32 m0 = 0
    unsafe { *(data as uint32) -> m0 }
    uint64 wm0 = m0
    uint64 dp4 = data + 4
    uint32 m4 = 0
    unsafe { *(dp4 as uint32) -> m4 }
    uint64 wm4 = m4

    // Check magic
    uint64 is_fat = 0
    if wm0 == 0x4F42524B && wm4 == 0x00544146 {
        is_fat = 1
    }

    uint64 host_arch = detect_arch_r()

    if is_fat == 0 {
        // Not fat — write as-is
        // Not a fat binary: run it as it is (no arguments are forwarded).
        uint64 rargv = alloc(16)
        store64(rargv + 8, 0)
        kx_exec_image(data, fsize, rargv)
    }

    // Parse fat header
    uint64 dp12 = data + 12
    uint32 arch_count = 0
    unsafe { *(dp12 as uint32) -> arch_count }
    uint64 wac = arch_count

    uint64 slice_offset = 0
    uint64 slice_comp_size = 0
    uint64 slice_uncomp_size = 0
    uint64 slice_pair_off = 0
    uint64 slice_pair_uncomp_size = 0
    uint64 found = 0

    uint64 i = 0
    while i < wac {
        uint64 entry = data + 16 + i * 48
        uint32 arch_id = 0
        unsafe { *(entry as uint32) -> arch_id }
        uint64 wai = arch_id
        if wai == host_arch {
            uint64 eo8 = entry + 8
            uint64 eo16 = entry + 16
            uint64 eo24 = entry + 24
            uint64 eo32 = entry + 32
            uint64 eo40 = entry + 40
            unsafe { *(eo8 as uint64) -> slice_offset }
            unsafe { *(eo16 as uint64) -> slice_comp_size }
            unsafe { *(eo24 as uint64) -> slice_uncomp_size }
            unsafe { *(eo32 as uint64) -> slice_pair_off }
            unsafe { *(eo40 as uint64) -> slice_pair_uncomp_size }
            found = 1
        }
        i = i + 1
    }

    if found == 0 {
        uint64 wmsg_419 = "kr: no native binary found for this architecture\n"
        write(2, wmsg_419, str_len_r(wmsg_419))
        uint64 wmsg_420 = "The .krbo file may not contain a slice for your platform.\n"
        write(2, wmsg_420, str_len_r(wmsg_420))
        write(2, "Recompile with: krc program.kr -o program.krbo\n", 47)
        exit(1)
    }

    // Old independent-slice entries leave pair fields zero; normalize.
    if slice_pair_uncomp_size == 0 {
        slice_pair_uncomp_size = slice_uncomp_size
    }

    // Decompress the shared pair blob, then select our slice from it.
    uint64 pair_binary = alloc(slice_pair_uncomp_size + 1)
    uint64 comp_data = data + slice_offset
    uint64 decomp_size = lz4_decompress_frame_r(comp_data, slice_comp_size, pair_binary)
    uint64 binary = pair_binary + slice_pair_off

    // BCJ decode only our slice (not the whole pair blob)
    if host_arch == 1 || host_arch == 3 || host_arch == 5 || host_arch == 8 {
        filter_x86_64_bcj(binary, slice_uncomp_size, 0)
    }
    if host_arch == 2 || host_arch == 4 || host_arch == 6 || host_arch == 7 {
        filter_aarch64_bcj(binary, slice_uncomp_size, 0)
    }

    // Build argv = [argv[0], original-argv[2..], NULL] to forward to execve.
    // cli_argv[0]=kr, cli_argv[1]=program.krbo, cli_argv[2..]=user args.
    // arg_offset is 16 on Android (linker shift), 8 otherwise. argv[0] gets
    // filled in per-platform once we know the final exec identity.
    uint64 fwd_start = 0
    if arg_offset == 8 {
        fwd_start = 2
    } else {
        fwd_start = 3
    }
    uint64 n_fwd = 0
    if cli_argc > fwd_start { n_fwd = cli_argc - fwd_start }
    uint64 argv_bytes = (n_fwd + 2) * 8
    uint64 nargv = alloc(argv_bytes)
    uint64 ai = 0
    while ai < n_fwd {
        uint64 src = cli_argv + (fwd_start + ai) * 8
        uint64 v = 0
        unsafe { *(src as uint64) -> v }
        uint64 dst = nargv + (1 + ai) * 8
        store64(dst, v)
        ai = ai + 1
    }
    store64(nargv + (1 + n_fwd) * 8, 0)

    kx_exec_image(binary, slice_uncomp_size, nargv)
}
