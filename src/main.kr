// KernRift self-hosted compiler — main

// Windows command line parser: called from main() when cli_argc == 0xFFFFFFFF
// cli_argv contains the raw GetCommandLineA pointer; parse it into proper argc/argv
fn win_init_args() {
    uint64 cmdline = cli_argv
    // Growable argv buffer: starts at 64 pointer slots, doubles on demand.
    // The old fixed alloc(512) overflowed silently on the 65th argument —
    // alloc() is raw mmap and consecutive mappings pack adjacently, so the
    // write landed in a neighbouring buffer instead of faulting.
    uint64 argv_cap = 64
    uint64 argv_buf = alloc(argv_cap * 8)
    uint64 argc = 0
    uint64 pos = cmdline
    uint64 ch = 0
    unsafe { *(pos as uint8) -> ch }
    while ch != 0 {
        // Skip spaces
        while ch == 32 {
            pos = pos + 1
            unsafe { *(pos as uint8) -> ch }
        }
        if ch == 0 { break }
        // Store start of this arg
        if argc >= argv_cap {
            argv_buf = grow_buf(argv_buf, argv_cap * 8, argv_cap * 16)
            argv_cap = argv_cap * 2
        }
        uint64 slot = argv_buf + argc * 8
        unsafe { *(slot as uint64) = pos }
        argc = argc + 1
        // Advance to next space or null
        while ch != 0 && ch != 32 {
            pos = pos + 1
            unsafe { *(pos as uint8) -> ch }
        }
        // Null-terminate this arg (replace space with 0)
        if ch == 32 {
            uint8 z = 0
            unsafe { *(pos as uint8) = z }
            pos = pos + 1
            unsafe { *(pos as uint8) -> ch }
        }
    }
    cli_argc = argc
    cli_argv = argv_buf
}

// Deliberately shadows the str_len built-in: the compiler wants ONE
// definition it fully controls on every target (including ones where the
// built-in lowering differs), and call sites resolve to this body.
@builtin_override
fn str_len(uint64 s) -> uint64 {
    uint64 i = 0
    uint64 p = s + i
    uint64 c = 0
    unsafe { *(p as uint8) -> c }
    while c != 0 {
        i = i + 1
        p = s + i
        unsafe { *(p as uint8) -> c }
    }
    return i
}

fn str_starts_with(uint64 s, uint64 prefix, uint64 plen) -> uint64 {
    uint64 i = 0
    while i < plen {
        uint64 pa = s + i
        uint64 pb = prefix + i
        uint64 ca = 0
        uint64 cb = 0
        unsafe { *(pa as uint8) -> ca }
        unsafe { *(pb as uint8) -> cb }
        if ca != cb { return 0 }
        i = i + 1
    }
    return 1
}

fn str_eq_full(uint64 a, uint64 b) -> uint64 {
    uint64 la = str_len(a)
    uint64 lb = str_len(b)
    if la != lb { return 0 }
    return str_starts_with(a, b, la)
}

// Import system state
static uint64 import_buf = 0
static uint64 import_buf_len = 0
static uint64 import_buf_cap = 0
static uint64 import_seen = 0
static uint64 import_seen_count = 0
static uint64 import_seen_cap = 0
static uint64 srcmap_table = 0
static uint64 srcmap_count = 0
static uint64 srcmap_cap = 0

fn import_init() {
    import_failed = 0
    import_buf_cap = 4194304
    import_buf = alloc(import_buf_cap)
    import_buf_len = 0
    import_seen_cap = 64
    import_seen = alloc(import_seen_cap * 8)
    import_seen_count = 0
    srcmap_cap = 1024
    srcmap_table = alloc(srcmap_cap * 16)
    srcmap_count = 0
}

// import_seen holds one u64 POINTER per entry, each to an exact-size
// NUL-terminated heap copy of the path. Entries used to be fixed
// 256-byte inline slots, which silently truncated any path over 255
// chars — so a long path was recorded wrong AND two distinct paths
// sharing a 255-char prefix collided, making the second look already
// seen and silently skipping its imports. Pointer entries have no
// length cliff, keep O(1) table indexing, and stay safe across
// grow_buf: the pointers move with the table, the strings they
// reference never move.
fn import_is_seen(uint64 path) -> uint64 {
    uint64 plen = str_len(path)
    uint64 i = 0
    while i < import_seen_count {
        uint64 slot = import_seen + i * 8
        uint64 entry = 0
        unsafe { *(slot as uint64) -> entry }
        if str_starts_with(entry, path, plen) != 0 {
            uint64 elen = str_len(entry)
            if elen == plen { return 1 }
        }
        i = i + 1
    }
    return 0
}

fn import_mark_seen(uint64 path) {
    if import_seen_count >= import_seen_cap {
        import_seen = grow_buf(import_seen, import_seen_cap * 8,
                               import_seen_cap * 16)
        import_seen_cap = import_seen_cap * 2
    }
    uint64 plen = str_len(path)
    uint64 copy = alloc(plen + 1)
    memcpy(copy, path, plen)
    uint64 tp = copy + plen
    uint8 z = 0
    unsafe { *(tp as uint8) = z }
    uint64 slot = import_seen + import_seen_count * 8
    unsafe { *(slot as uint64) = copy }
    import_seen_count = import_seen_count + 1
}

fn import_append(uint64 src, uint64 len, uint64 file_path) {
    if srcmap_count >= srcmap_cap {
        srcmap_table = grow_buf(srcmap_table, srcmap_cap * 16, srcmap_cap * 32)
        srcmap_cap = srcmap_cap * 2
    }
    uint64 need = import_buf_len + len + 1
    if need > import_buf_cap {
        uint64 ncap = import_buf_cap
        while ncap < need { ncap = ncap * 2 }
        import_buf = grow_buf(import_buf, import_buf_len, ncap)
        import_buf_cap = ncap
    }
    uint64 sm_entry = srcmap_table + srcmap_count * 16
    uint64 sm_off = import_buf_len
    unsafe { *(sm_entry as uint64) = sm_off }
    uint64 sm_fp = sm_entry + 8
    unsafe { *(sm_fp as uint64) = file_path }
    srcmap_count = srcmap_count + 1
    uint64 i = 0
    while i < len {
        uint64 sp = src + i
        uint64 dp = import_buf + import_buf_len
        uint64 b = 0
        unsafe { *(sp as uint8) -> b }
        uint8 bb = b
        unsafe { *(dp as uint8) = bb }
        import_buf_len = import_buf_len + 1
        i = i + 1
    }
    // Add newline separator
    uint64 np = import_buf + import_buf_len
    uint8 nl = 10
    unsafe { *(np as uint8) = nl }
    import_buf_len = import_buf_len + 1
}

@export
fn srcmap_file(uint64 byte_offset) -> uint64 {
    uint64 file_path = 0
    uint64 i = 0
    while i < srcmap_count {
        uint64 entry = srcmap_table + i * 16
        uint64 entry_off = 0
        unsafe { *(entry as uint64) -> entry_off }
        if entry_off > byte_offset { break }
        uint64 fp_ptr = entry + 8
        unsafe { *(fp_ptr as uint64) -> file_path }
        i = i + 1
    }
    return file_path
}

@export
fn srcmap_line(uint64 byte_offset) -> uint64 {
    uint64 file_start = 0
    uint64 i = 0
    while i < srcmap_count {
        uint64 entry = srcmap_table + i * 16
        uint64 entry_off = 0
        unsafe { *(entry as uint64) -> entry_off }
        if entry_off > byte_offset { break }
        file_start = entry_off
        i = i + 1
    }
    uint64 line = 1
    uint64 p = file_start
    while p < byte_offset {
        uint64 cp = import_buf + p
        uint64 ch = 0
        unsafe { *(cp as uint8) -> ch }
        if ch == 10 { line = line + 1 }
        p = p + 1
    }
    return line
}

// Print the "file:line:col: <severity>: " prefix for a token. Shared by the
// immediate (write+exit) diagnostics so they match diag_report_all's format.
fn diag_loc_head(uint64 tok_idx, uint64 severity) {
    uint64 tok_start = tok_text_start(tok_idx)
    uint64 file_path = srcmap_file(tok_start)
    if file_path != 0 {
        write(2, file_path, str_len(file_path))
    }
    write(2, ":", 1)
    uint8[24] lbuf
    uint64 llen = fmt_uint(lbuf, srcmap_line(tok_start))
    write(2, lbuf, llen)
    write(2, ":", 1)
    uint64 clen = fmt_uint(lbuf, diag_col_of(tok_start))
    write(2, lbuf, clen)
    if severity == 1 { write(2, ": warning: ", 11) } else { write(2, ": error: ", 9) }
}

// Print the source line + caret underline for a token (after a head+message).
fn diag_span_of(uint64 tok_idx) {
    uint64 tok_start = tok_text_start(tok_idx)
    diag_print_source_line(tok_start, tok_text_len(tok_idx), srcmap_line(tok_start))
}

// Immediate fatal: "file:line:col: error: <msg>" + source span + caret, exit(1).
// For the write+exit error sites in the parser and codegen.
@export
fn diag_fatal_at(uint64 tok_idx, uint64 msg) {
    diag_loc_head(tok_idx, 0)
    write(2, msg, str_len(msg))
    write(2, "\n", 1)
    diag_span_of(tok_idx)
    exit(1)
}

@export
fn report_error_at(uint64 tok_idx, uint64 msg) {
    diag_loc_head(tok_idx, 0)
    write(2, msg, str_len(msg))
    write(2, "\n", 1)
    diag_span_of(tok_idx)
}

@export
fn report_warn_at(uint64 tok_idx, uint64 msg) {
    diag_loc_head(tok_idx, 1)
    write(2, msg, str_len(msg))
    write(2, "\n", 1)
    diag_span_of(tok_idx)
    // Keep the end-of-compile summary accurate — same counter used
    // by diag_emit so 'N error(s), M warning(s)' reflects every warning.
    diag_warn_count = diag_warn_count + 1
}

fn import_dir_of(uint64 path) -> uint64 {
    // Find last '/' in path, return length including the slash
    uint64 len = str_len(path)
    uint64 last_slash = 0
    uint64 i = 0
    while i < len {
        uint64 pp = path + i
        uint64 ch = 0
        unsafe { *(pp as uint8) -> ch }
        if ch == 47 { last_slash = i + 1 }
        i = i + 1
    }
    return last_slash
}

fn import_resolve(uint64 base_path, uint64 name, uint64 name_len) -> uint64 {
    uint64 dir_len = import_dir_of(base_path)
    uint64 result = alloc(dir_len + name_len + 1)
    uint64 i = 0
    while i < dir_len {
        uint64 sp = base_path + i
        uint64 dp = result + i
        uint64 ch = 0
        unsafe { *(sp as uint8) -> ch }
        uint8 cb = ch
        unsafe { *(dp as uint8) = cb }
        i = i + 1
    }
    uint64 j = 0
    while j < name_len {
        uint64 sp = name + j
        uint64 dp = result + dir_len + j
        uint64 ch = 0
        unsafe { *(sp as uint8) -> ch }
        uint8 cb = ch
        unsafe { *(dp as uint8) = cb }
        j = j + 1
    }
    uint64 tp = result + dir_len + name_len
    uint8 z = 0
    unsafe { *(tp as uint8) = z }
    return result
}

fn import_check_import_line(uint64 buf, uint64 size, uint64 pos) -> uint64 {
    // Check if buf[pos..] starts with: import "filename"
    // Returns 0 if not import, or the position just past the opening quote
    if pos + 8 >= size { return 0 }
    uint64 bp = buf + pos
    uint64 c0 = 0; uint64 c1 = 0; uint64 c2 = 0; uint64 c3 = 0; uint64 c4 = 0; uint64 c5 = 0
    unsafe { *(bp as uint8) -> c0 }
    uint64 bp1 = bp + 1; unsafe { *(bp1 as uint8) -> c1 }
    uint64 bp2 = bp + 2; unsafe { *(bp2 as uint8) -> c2 }
    uint64 bp3 = bp + 3; unsafe { *(bp3 as uint8) -> c3 }
    uint64 bp4 = bp + 4; unsafe { *(bp4 as uint8) -> c4 }
    uint64 bp5 = bp + 5; unsafe { *(bp5 as uint8) -> c5 }
    // "import" = 105 109 112 111 114 116
    if c0 != 105 || c1 != 109 || c2 != 112 || c3 != 111 || c4 != 114 || c5 != 116 { return 0 }
    // Skip whitespace after "import"
    uint64 p = pos + 6
    uint64 ch = 0
    uint64 pp = buf + p
    if p < size { unsafe { *(pp as uint8) -> ch } }
    while p < size && (ch == 32 || ch == 9) {
        p = p + 1
        pp = buf + p
        if p < size { unsafe { *(pp as uint8) -> ch } }
    }
    // Expect opening quote
    if ch != 34 { return 0 }
    p = p + 1
    return p
}

// Stdlib search paths for imports not found relative to source file.
// Same shape as import_seen: one u64 pointer per entry to an exact-size
// heap copy. The old layout was WORSE than import_mark_seen's: 256-byte
// inline slots with no length guard on the memcpy (a >255-char search
// path overflowed into the next slot) and no count guard on the fixed
// 2048-byte table.
static uint64 import_search_paths = 0
static uint64 import_search_count = 0
static uint64 import_search_cap = 0

fn import_read_home() -> uint64 {
    // Read HOME from /proc/self/environ (Linux-specific)
    uint64 fd = file_open("/proc/self/environ", 0)
    if fd >= 0xFFFFFFFF { return 0 }
    uint64 buf = alloc(4096)
    file_read(fd, buf, 4096)
    file_close(fd)
    // environ is null-separated: VAR=VALUE\0VAR=VALUE\0...
    uint64 pos = 0
    while pos < 4096 {
        uint64 p = buf + pos
        uint64 ch = 0
        unsafe { *(p as uint8) -> ch }
        if ch == 0 { break }
        // Check for "HOME="
        if ch == 72 {
            uint64 p1 = p + 1; uint64 c1 = 0; unsafe { *(p1 as uint8) -> c1 }
            uint64 p2 = p + 2; uint64 c2 = 0; unsafe { *(p2 as uint8) -> c2 }
            uint64 p3 = p + 3; uint64 c3 = 0; unsafe { *(p3 as uint8) -> c3 }
            uint64 p4 = p + 4; uint64 c4 = 0; unsafe { *(p4 as uint8) -> c4 }
            if c1 == 79 && c2 == 77 && c3 == 69 && c4 == 61 {
                // Found HOME=, copy value to new buffer
                uint64 home_ptr = p + 5
                uint64 home_len = str_len(home_ptr)
                uint64 home_copy = alloc(home_len + 1)
                memcpy(home_copy, home_ptr, home_len)
                uint64 htp = home_copy + home_len
                uint8 hz = 0
                unsafe { *(htp as uint8) = hz }
                return home_copy
            }
        }
        // Skip to next null
        while pos < 4096 {
            p = buf + pos
            unsafe { *(p as uint8) -> ch }
            if ch == 0 { pos = pos + 1; break }
            pos = pos + 1
        }
    }
    return 0
}

fn import_init_search_paths() {
    if import_search_paths != 0 { return }
    import_search_cap = 8
    import_search_paths = alloc(import_search_cap * 8)
    import_search_count = 0

    uint64 host_os = get_target_os()
    if host_os == 2 {
        // Windows: look relative to exe location
        // Get exe path via GetModuleFileNameA
        uint64 exe_buf = alloc(512)
        uint64 exe_len = get_module_path(exe_buf, 512)
        if exe_len > 0 {
            // Strip filename: walk backwards to last backslash
            uint64 dir_len = exe_len
            while dir_len > 0 {
                dir_len = dir_len - 1
                uint64 cp = exe_buf + dir_len
                uint64 ch = 0
                unsafe { *(cp as uint8) -> ch }
                if ch == 92 { dir_len = dir_len + 1; break }
            }
            // A search path is the PARENT of std\, not std\ itself.
            // import_resolve_stdlib concatenates base + the import path
            // verbatim, and imports are written `import "std/io.kr"` — the
            // "std" component is already in the import path. Registering
            // <exe_dir>..\std\ here produced ...\std\std/io.kr, which never
            // opens, so stdlib resolution failed on Windows for every import.
            // Verified on Windows 10.0.26200:
            //   C:\krtest\bin\..\std\std/io.kr  -> fails
            //   C:\krtest\bin\..\std/io.kr      -> opens
            // The Linux/macOS branch below already gets this right: it
            // registers .../kernrift/ while install.sh puts the modules in
            // .../kernrift/std, so base + "std/io.kr" composes correctly.
            // Try <exe_dir>..\ (install.ps1 puts std next to bin)
            uint64 up_std = alloc(dir_len + 4)
            memcpy(up_std, exe_buf, dir_len)
            uint64 suffix = "..\\"
            memcpy(up_std + dir_len, suffix, 3)
            uint8 z = 0
            uint64 tp = up_std + dir_len + 3
            unsafe { *(tp as uint8) = z }
            import_add_search_path(up_std)
            // Also try <exe_dir> itself (std\ sitting beside the exe)
            uint64 dir_std = alloc(dir_len + 1)
            memcpy(dir_std, exe_buf, dir_len)
            uint64 tp2 = dir_std + dir_len
            unsafe { *(tp2 as uint8) = z }
            import_add_search_path(dir_std)
        }
    } else {
        // Linux/macOS: system paths
        import_add_search_path("/usr/local/share/kernrift/")
        import_add_search_path("/usr/share/kernrift/")
        // Homebrew prefixes. /usr/local (Intel macOS Homebrew) is already
        // covered above; /opt/homebrew is Apple Silicon and
        // /home/linuxbrew/.linuxbrew is the Linux Homebrew default. Neither is
        // an FHS path, so `brew install` would otherwise land the stdlib where
        // krc never looks. (pacman/AUR use /usr/share, and Scoop resolves
        // relative to krc.exe on Windows -- both already covered.)
        import_add_search_path("/opt/homebrew/share/kernrift/")
        import_add_search_path("/home/linuxbrew/.linuxbrew/share/kernrift/")
        // Add user path: $HOME/.local/share/kernrift/
        uint64 home = import_read_home()
        if home != 0 {
            uint64 hlen = str_len(home)
            uint64 suffix = "/.local/share/kernrift/"
            uint64 slen = 23
            uint64 full = alloc(hlen + slen + 1)
            memcpy(full, home, hlen)
            memcpy(full + hlen, suffix, slen)
            uint8 z = 0
            uint64 tp = full + hlen + slen
            unsafe { *(tp as uint8) = z }
            import_add_search_path(full)
        }
    }
}

fn import_add_search_path(uint64 path) {
    if import_search_count >= import_search_cap {
        import_search_paths = grow_buf(import_search_paths,
                                       import_search_cap * 8,
                                       import_search_cap * 16)
        import_search_cap = import_search_cap * 2
    }
    // Defensive exact-size copy: callers may pass scratch buffers, and
    // the table must own storage that never moves or gets reused.
    uint64 plen = str_len(path)
    uint64 copy = alloc(plen + 1)
    memcpy(copy, path, plen)
    uint64 tp = copy + plen
    uint8 z = 0
    unsafe { *(tp as uint8) = z }
    uint64 slot = import_search_paths + import_search_count * 8
    unsafe { *(slot as uint64) = copy }
    import_search_count = import_search_count + 1
}

fn import_resolve_stdlib(uint64 import_path) -> uint64 {
    import_init_search_paths()
    uint64 plen = str_len(import_path)
    uint64 i = 0
    while i < import_search_count {
        uint64 base_slot = import_search_paths + i * 8
        uint64 base = 0
        unsafe { *(base_slot as uint64) -> base }
        uint64 blen = str_len(base)
        uint64 full = alloc(blen + plen + 1)
        memcpy(full, base, blen)
        memcpy(full + blen, import_path, plen)
        uint64 tp = full + blen + plen
        uint8 z = 0
        unsafe { *(tp as uint8) = z }
        uint64 fd = file_open(full, 0)
        if fd < 0xFFFFFFFF {
            file_close(fd)
            return full
        }
        i = i + 1
    }
    return 0
}

fn import_check_file(uint64 path) {
    uint64 fd = file_open(path, 0)
    if fd >= 0xFFFFFFFF {
        write(2, "error: cannot open '", 20)
        write(2, path, str_len(path))
        write(2, "': file not found\n", 18)
        exit(1)
    }
    file_close(fd)
}

fn import_process(uint64 file_path) {
    if import_is_seen(file_path) != 0 { return }
    import_mark_seen(file_path)

    uint64 fd = file_open(file_path, 0)
    // If not found, try ~/.local/share/kernrift/ as fallback
    if fd >= 0xFFFFFFFF {
        uint64 fallback = import_resolve_stdlib(file_path)
        if fallback != 0 {
            fd = file_open(fallback, 0)
        }
    }
    if fd >= 0xFFFFFFFF {
        uint64 msg = "error: cannot open import: "
        write(2, msg, 27)
        write(2, file_path, str_len(file_path))
        write(2, "\n", 1)
        // Don't exit here — let compilation continue so the parser can report
        // the downstream errors this missing module causes. But record the
        // failure: open_output_or_die refuses to emit a binary if this is
        // set. Previously neither happened, so an import failure that did not
        // break the parse produced a binary and exit 0.
        import_failed = 1
        return
    }
    uint64 size = file_size(fd)
    uint64 tmp = alloc(size + 1)
    file_read(fd, tmp, size)
    file_close(fd)

    // Scan for import lines at the beginning
    uint64 pos = 0
    while pos < size {
        // Skip whitespace/newlines and // line comments so imports can live
        // after header comments. Block comments (/* */) are not supported.
        uint64 skipped = 1
        while skipped != 0 {
            skipped = 0
            uint64 ch = 0
            uint64 pp = tmp + pos
            if pos < size { unsafe { *(pp as uint8) -> ch } }
            while pos < size && (ch == 32 || ch == 9 || ch == 13 || ch == 10) {
                pos = pos + 1
                pp = tmp + pos
                if pos < size { unsafe { *(pp as uint8) -> ch } }
                skipped = 1
            }
            // Line comment // — consume until newline
            if pos + 1 < size {
                uint64 cp0 = tmp + pos
                uint64 cp1 = tmp + pos + 1
                uint64 cc0 = 0
                uint64 cc1 = 0
                unsafe { *(cp0 as uint8) -> cc0 }
                unsafe { *(cp1 as uint8) -> cc1 }
                if cc0 == 47 && cc1 == 47 {
                    pos = pos + 2
                    uint64 lc = 0
                    uint64 lcp = tmp + pos
                    if pos < size { unsafe { *(lcp as uint8) -> lc } }
                    while pos < size && lc != 10 {
                        pos = pos + 1
                        lcp = tmp + pos
                        if pos < size { unsafe { *(lcp as uint8) -> lc } }
                    }
                    skipped = 1
                }
            }
        }
        if pos >= size { break }

        // Check if this line starts with "import"
        uint64 name_start = import_check_import_line(tmp, size, pos)
        if name_start != 0 {
            // Extract filename between quotes
            uint64 ns = name_start
            uint64 ne = ns
            uint64 qch = 0
            uint64 qp = tmp + ne
            if ne < size { unsafe { *(qp as uint8) -> qch } }
            while ne < size && qch != 34 {
                ne = ne + 1
                qp = tmp + ne
                if ne < size { unsafe { *(qp as uint8) -> qch } }
            }
            uint64 name_len = ne - ns
            uint64 name_ptr = tmp + ns
            // Resolve full path relative to source file
            uint64 full_path = import_resolve(file_path, name_ptr, name_len)
            // Check if resolved path exists
            uint64 check_fd = file_open(full_path, 0)
            if check_fd < 0xFFFFFFFF {
                file_close(check_fd)
            } else {
                // Not found locally — try stdlib search paths
                // Build a null-terminated copy of the import name
                uint64 name_copy = alloc(name_len + 1)
                memcpy(name_copy, name_ptr, name_len)
                uint64 ntp = name_copy + name_len
                uint8 nz = 0
                unsafe { *(ntp as uint8) = nz }
                uint64 stdlib_path = import_resolve_stdlib(name_copy)
                if stdlib_path != 0 { full_path = stdlib_path }
            }
            // Recurse
            import_process(full_path)
            // Skip past closing quote and rest of line
            pos = ne + 1
        }
        if name_start == 0 {
            // Not an import — stop scanning for imports (only imports at top of file)
            break
        }
    }

    // Append entire file content (including import lines — parser ignores them)
    import_append(tmp, size, file_path)
}

fn hex_nibble(uint64 v) -> uint64 {
    if v < 10 { return v + 48 }
    return v + 87
}

fn write_hex8(uint64 fd, uint64 val) {
    uint8 h = hex_nibble((val >> 4) & 0xF)
    uint8 l = hex_nibble(val & 0xF)
    uint8[2] hb
    unsafe { *(hb as uint8) = h }
    uint64 p1 = hb + 1
    unsafe { *(p1 as uint8) = l }
    write(fd, hb, 2)
}

fn write_hex32(uint64 fd, uint64 val) {
    write_hex8(fd, (val >> 24) & 0xFF)
    write_hex8(fd, (val >> 16) & 0xFF)
    write_hex8(fd, (val >> 8) & 0xFF)
    write_hex8(fd, val & 0xFF)
}

fn write_a64_xreg(uint64 fd, uint64 reg) {
    uint8[4] rb
    if reg == 31 {
        write(fd, "sp", 2)
    } else {
        write(fd, "x", 1)
        uint64 rl = fmt_uint(rb, reg)
        write(fd, rb, rl)
    }
}

fn write_a64_wreg(uint64 fd, uint64 reg) {
    uint8[4] rb
    if reg == 31 {
        write(fd, "wzr", 3)
    } else {
        write(fd, "w", 1)
        uint64 rl = fmt_uint(rb, reg)
        write(fd, rb, rl)
    }
}

fn write_a64_sysreg(uint64 fd, uint64 op0, uint64 op1, uint64 crn, uint64 crm, uint64 op2) {
    // Common system registers
    if op0 == 3 && op1 == 3 && crn == 13 && crm == 0 && op2 == 2 {
        write(fd, "tpidr_el0", 9)
    } else if op0 == 3 && op1 == 0 && crn == 4 && crm == 0 && op2 == 1 {
        write(fd, "elr_el1", 7)
    } else if op0 == 3 && op1 == 0 && crn == 4 && crm == 0 && op2 == 0 {
        write(fd, "spsr_el1", 8)
    } else if op0 == 3 && op1 == 0 && crn == 5 && crm == 2 && op2 == 0 {
        write(fd, "esr_el1", 7)
    } else if op0 == 3 && op1 == 0 && crn == 6 && crm == 0 && op2 == 0 {
        write(fd, "far_el1", 7)
    } else if op0 == 3 && op1 == 0 && crn == 1 && crm == 0 && op2 == 0 {
        write(fd, "sctlr_el1", 9)
    } else if op0 == 3 && op1 == 0 && crn == 2 && crm == 0 && op2 == 0 {
        write(fd, "ttbr0_el1", 9)
    } else if op0 == 3 && op1 == 0 && crn == 2 && crm == 0 && op2 == 1 {
        write(fd, "ttbr1_el1", 9)
    } else if op0 == 3 && op1 == 0 && crn == 12 && crm == 0 && op2 == 0 {
        write(fd, "vbar_el1", 8)
    } else if op0 == 3 && op1 == 3 && crn == 4 && crm == 2 && op2 == 0 {
        write(fd, "nzcv", 4)
    } else if op0 == 3 && op1 == 3 && crn == 4 && crm == 2 && op2 == 1 {
        write(fd, "daif", 4)
    } else if op0 == 3 && op1 == 0 && crn == 0 && crm == 0 && op2 == 0 {
        write(fd, "midr_el1", 8)
    } else if op0 == 3 && op1 == 0 && crn == 0 && crm == 0 && op2 == 5 {
        write(fd, "mpidr_el1", 9)
    } else if op0 == 3 && op1 == 3 && crn == 14 && crm == 0 && op2 == 1 {
        write(fd, "cntpct_el0", 10)
    } else {
        // Fallback: print s<op0>_<op1>_c<crn>_c<crm>_<op2>
        uint8[4] rb
        write(fd, "s", 1)
        uint64 rl = fmt_uint(rb, op0)
        write(fd, rb, rl)
        write(fd, "_", 1)
        rl = fmt_uint(rb, op1)
        write(fd, rb, rl)
        write(fd, "_c", 2)
        rl = fmt_uint(rb, crn)
        write(fd, rb, rl)
        write(fd, "_c", 2)
        rl = fmt_uint(rb, crm)
        write(fd, rb, rl)
        write(fd, "_", 1)
        rl = fmt_uint(rb, op2)
        write(fd, rb, rl)
    }
}

// x86_64 64-bit register name. Accepts 0..15; the high-bit encoded
// r8..r15 come from the REX.R/B prefix bits added upstream.
fn write_x86_reg64(uint64 fd, uint64 r) {
    uint8[4] rb
    if r == 0 { write(fd, "rax", 3) }
    else if r == 1 { write(fd, "rcx", 3) }
    else if r == 2 { write(fd, "rdx", 3) }
    else if r == 3 { write(fd, "rbx", 3) }
    else if r == 4 { write(fd, "rsp", 3) }
    else if r == 5 { write(fd, "rbp", 3) }
    else if r == 6 { write(fd, "rsi", 3) }
    else if r == 7 { write(fd, "rdi", 3) }
    else {
        write(fd, "r", 1)
        uint64 rl = fmt_uint(rb, r)
        write(fd, rb, rl)
    }
}

// Decode and print an x86_64 memory operand from a ModR/M byte.
// `bp_modrm` points to the ModR/M byte; disp/SIB bytes follow.
// `base_hi` is 1 if REX.B is set (base register is r8..r15).
// Returns the number of bytes consumed after the ModR/M (SIB + disp).
fn write_x86_mem(uint64 fd, uint64 bp_modrm, uint64 base_hi) -> uint64 {
    uint64 modrm = 0
    unsafe { *(bp_modrm as uint8) -> modrm }
    uint64 mod_f = (modrm >> 6) & 3
    uint64 rm_f  = modrm & 7
    uint64 base_r = rm_f | (base_hi << 3)
    uint64 disp_ofs = 1
    uint64 has_sib = 0
    uint64 sib_base = 0
    if mod_f != 3 && rm_f == 4 {
        uint64 bp_s = bp_modrm + 1
        uint64 sib_b = 0
        unsafe { *(bp_s as uint8) -> sib_b }
        sib_base = (sib_b & 7) | (base_hi << 3)
        base_r = sib_base
        has_sib = 1
        disp_ofs = 2
    }
    write(fd, "[", 1)
    if mod_f == 0 && rm_f == 5 {
        write(fd, "rip", 3)
    } else {
        write_x86_reg64(fd, base_r)
    }
    uint64 consumed = disp_ofs - 1
    if mod_f == 1 {
        uint64 bp_d = bp_modrm + disp_ofs
        uint64 d8v = 0
        unsafe { *(bp_d as uint8) -> d8v }
        write(fd, "+0x", 3)
        write_hex8(fd, d8v)
        consumed = consumed + 1
    } else if mod_f == 2 || (mod_f == 0 && rm_f == 5) {
        uint64 bp_d0 = bp_modrm + disp_ofs
        uint64 bp_d1 = bp_modrm + disp_ofs + 1
        uint64 bp_d2 = bp_modrm + disp_ofs + 2
        uint64 bp_d3 = bp_modrm + disp_ofs + 3
        uint64 d32_0 = 0
        uint64 d32_1 = 0
        uint64 d32_2 = 0
        uint64 d32_3 = 0
        unsafe { *(bp_d0 as uint8) -> d32_0 }
        unsafe { *(bp_d1 as uint8) -> d32_1 }
        unsafe { *(bp_d2 as uint8) -> d32_2 }
        unsafe { *(bp_d3 as uint8) -> d32_3 }
        uint64 d32 = d32_0 | (d32_1 << 8) | (d32_2 << 16) | (d32_3 << 24)
        write(fd, "+0x", 3)
        write_hex32(fd, d32)
        consumed = consumed + 4
    }
    write(fd, "]", 1)
    return consumed
}

// Length of an x86_64 ModR/M operand (SIB + displacement), not counting the
// ModR/M byte itself. Mirrors the consumed-bytes computation in write_x86_mem.
fn x86_modrm_extra(uint64 modrm) -> uint64 {
    uint64 mod_f = (modrm >> 6) & 3
    uint64 rm_f  = modrm & 7
    if mod_f == 3 { return 0 }
    uint64 extra = 0
    if rm_f == 4 { extra = extra + 1 }
    if mod_f == 1 { extra = extra + 1 }
    if mod_f == 2 { extra = extra + 4 }
    if mod_f == 0 && rm_f == 5 { extra = extra + 4 }
    return extra
}

// riscv32 (arch==2) backend is a stub until stage 3: every arch-dispatch
// site routes arch==2 here explicitly instead of silently falling through
// to the x86_64 or arm64 arm of a binary if/else. See task 0.2 audit.
fn riscv32_nyi(uint64 what) {
    uint64 pre = "error: riscv32 "
    write(2, pre, str_len(pre))
    write(2, what, str_len(what))
    uint64 post = " not yet implemented (stage 3)\n"
    write(2, post, str_len(post))
    exit(1)
}

// xtensa (arch==3) backend is a stub during Milestone 1: every arch-dispatch
// site routes arch==3 here explicitly instead of silently falling through
// to the riscv32 or x86_64/arm64 arm of a binary if/else. See task 1 audit.
fn xtensa_nyi(uint64 what) {
    uint64 pre = "error: xtensa "
    write(2, pre, str_len(pre))
    write(2, what, str_len(what))
    uint64 post = " not yet implemented\n"
    write(2, post, str_len(post))
    exit(1)
}

fn emit_asm_listing(uint64 output_path, uint64 arch, uint64 text_start, uint64 source, uint64 tokens) {
    uint64 fd = open_output_or_die(output_path)
    uint64 code_end = codegen_output_len()
    uint64 wmsg_903 = "; KernRift assembly listing\n"
    write(fd, wmsg_903, str_len(wmsg_903))
    if arch == 0 {
        write(fd, "; Architecture: x86_64\n", 23)
    } else if arch == 1 {
        write(fd, "; Architecture: ARM64\n", 22)
    } else if arch == 2 {
        write(fd, "; Architecture: RV32IMC\n", 24)
    } else {
        riscv32_nyi("asm listing")
    }
    write(fd, "\n", 1)

    // Build sorted function offset list for labeling
    uint64 fi = 0
    while fi < fn_count {
        uint64 fentry = fn_table + fi * 8
        uint32 fn_tok = 0
        unsafe { *(fentry as uint32) -> fn_tok }
        uint64 fe4 = fentry + 4
        uint32 fn_off = 0
        unsafe { *(fe4 as uint32) -> fn_off }
        uint64 woff = fn_off

        // If this function carries a @section("name") annotation, emit
        // a gas-style `.section <name>,"ax",@progbits` directive so the
        // listing round-trips cleanly through an external assembler.
        uint64 sect_info = fn_section_lookup(fn_tok)
        if sect_info != 0 {
            uint64 sect_start = (sect_info >> 32) & 0xFFFFFFFF
            uint64 sect_len = sect_info & 0xFFFFFFFF
            write(fd, "\n.section ", 10)
            write(fd, source + sect_start, sect_len)
            if arch == 0 {
                write(fd, ",\"ax\",@progbits\n", 16)
            } else if arch == 1 {
                write(fd, ",\"ax\",%progbits\n", 16)
            } else if arch == 2 {
                write(fd, ",\"ax\",@progbits\n", 16)
            } else {
                riscv32_nyi("asm listing")
            }
        }
        // Print function label
        write(fd, "\n", 1)
        uint64 tstart = tok_text_start(fn_tok)
        uint64 tlen = tok_text_len(fn_tok)
        uint64 name_ptr = source + tstart
        write(fd, name_ptr, tlen)
        write(fd, ":\n", 2)

        // Find end of this function (next function offset or code_end)
        uint64 fn_end = code_end
        uint64 fj = 0
        while fj < fn_count {
            uint64 fe2 = fn_table + fj * 8 + 4
            uint32 next_off = 0
            unsafe { *(fe2 as uint32) -> next_off }
            uint64 wnext = next_off
            if wnext > woff && wnext < fn_end {
                fn_end = wnext
            }
            fj = fj + 1
        }

        // Dump instructions
        uint64 pos = woff
        if arch == 1 {
            // ARM64: fixed 4-byte instructions
            while pos + 4 <= fn_end {
                write(fd, "  ", 2)
                write_hex32(fd, pos - text_start)
                write(fd, ": ", 2)
                uint64 bp = out_buf + pos
                uint32 insn = 0
                unsafe { *(bp as uint32) -> insn }
                uint64 wi = insn
                write_hex32(fd, wi)
                write(fd, "  ", 2)
                uint8[16] drb
                uint64 drl = 0
                uint64 rd = wi & 0x1F
                uint64 rn = (wi >> 5) & 0x1F
                uint64 rm = (wi >> 16) & 0x1F
                // Decode common ARM64 instructions
                if wi == 0xD503201F { write(fd, "nop", 3) }
                else if wi == 0xD65F03C0 { write(fd, "ret", 3) }
                else if wi == 0xD503207F { write(fd, "wfi", 3) }
                else if wi == 0xD5033FDF { write(fd, "isb", 3) }
                else if wi == 0xD5033BBF { write(fd, "dmb ish", 7) }
                else if wi == 0xD5033B9F { write(fd, "dsb ish", 7) }
                else if wi == 0xD5033F9F { write(fd, "dsb sy", 6) }
                else if wi == 0xD5033FBF { write(fd, "dmb sy", 6) }
                else if (wi & 0xFFFFFFE0) == 0xD50B7E20 {
                    write(fd, "dc civac, ", 10)
                    write_a64_xreg(fd, rd)
                }
                else if (wi & 0xFFFFFFE0) == 0xD50B7520 {
                    write(fd, "ic ivau, ", 9)
                    write_a64_xreg(fd, rd)
                }
                else if wi == 0xD69F03E0 { write(fd, "eret", 4) }
                else if wi == 0xD4000001 { write(fd, "svc #0", 6) }
                // MOVZ 64-bit
                else if (wi & 0xFF800000) == 0xD2800000 {
                    write(fd, "movz ", 5)
                    write_a64_xreg(fd, rd)
                    write(fd, ", #", 3)
                    uint64 imm16 = (wi >> 5) & 0xFFFF
                    drl = fmt_uint(drb, imm16)
                    write(fd, drb, drl)
                    uint64 hw = (wi >> 21) & 0x3
                    if hw != 0 {
                        write(fd, ", lsl #", 7)
                        drl = fmt_uint(drb, hw * 16)
                        write(fd, drb, drl)
                    }
                }
                // MOVK 64-bit
                else if (wi & 0xFF800000) == 0xF2800000 {
                    write(fd, "movk ", 5)
                    write_a64_xreg(fd, rd)
                    write(fd, ", #", 3)
                    uint64 imm16 = (wi >> 5) & 0xFFFF
                    drl = fmt_uint(drb, imm16)
                    write(fd, drb, drl)
                    uint64 hw = (wi >> 21) & 0x3
                    if hw != 0 {
                        write(fd, ", lsl #", 7)
                        drl = fmt_uint(drb, hw * 16)
                        write(fd, drb, drl)
                    }
                }
                // ADD/SUB immediate (bits 28:24 = 10001)
                else if (wi & 0x1F000000) == 0x11000000 && (wi & 0x20000000) == 0 {
                    uint64 is_64 = (wi >> 31) & 1
                    if (wi & 0x40000000) != 0 {
                        write(fd, "sub ", 4)
                    } else {
                        write(fd, "add ", 4)
                    }
                    if is_64 != 0 {
                        write_a64_xreg(fd, rd)
                        write(fd, ", ", 2)
                        write_a64_xreg(fd, rn)
                    } else {
                        write_a64_wreg(fd, rd)
                        write(fd, ", ", 2)
                        write_a64_wreg(fd, rn)
                    }
                    write(fd, ", #", 3)
                    uint64 imm12 = (wi >> 10) & 0xFFF
                    drl = fmt_uint(drb, imm12)
                    write(fd, drb, drl)
                }
                // ADD/SUB register (shifted): bits 28:24 = 01011, bit 21 = 0
                else if (wi & 0x1F200000) == 0x0B000000 {
                    uint64 is_64 = (wi >> 31) & 1
                    if (wi & 0x40000000) != 0 {
                        write(fd, "sub ", 4)
                    } else {
                        write(fd, "add ", 4)
                    }
                    if is_64 != 0 {
                        write_a64_xreg(fd, rd)
                        write(fd, ", ", 2)
                        write_a64_xreg(fd, rn)
                        write(fd, ", ", 2)
                        write_a64_xreg(fd, rm)
                    } else {
                        write_a64_wreg(fd, rd)
                        write(fd, ", ", 2)
                        write_a64_wreg(fd, rn)
                        write(fd, ", ", 2)
                        write_a64_wreg(fd, rm)
                    }
                }
                // LDR 64-bit unsigned offset
                else if (wi & 0xFFC00000) == 0xF9400000 {
                    write(fd, "ldr ", 4)
                    write_a64_xreg(fd, rd)
                    write(fd, ", [", 3)
                    write_a64_xreg(fd, rn)
                    uint64 imm12 = (wi >> 10) & 0xFFF
                    uint64 off = imm12 * 8
                    if off != 0 {
                        write(fd, ", #", 3)
                        drl = fmt_uint(drb, off)
                        write(fd, drb, drl)
                    }
                    write(fd, "]", 1)
                }
                // STR 64-bit unsigned offset
                else if (wi & 0xFFC00000) == 0xF9000000 {
                    write(fd, "str ", 4)
                    write_a64_xreg(fd, rd)
                    write(fd, ", [", 3)
                    write_a64_xreg(fd, rn)
                    uint64 imm12 = (wi >> 10) & 0xFFF
                    uint64 off = imm12 * 8
                    if off != 0 {
                        write(fd, ", #", 3)
                        drl = fmt_uint(drb, off)
                        write(fd, drb, drl)
                    }
                    write(fd, "]", 1)
                }
                // LDR 32-bit unsigned offset
                else if (wi & 0xFFC00000) == 0xB9400000 {
                    write(fd, "ldr ", 4)
                    write_a64_wreg(fd, rd)
                    write(fd, ", [", 3)
                    write_a64_xreg(fd, rn)
                    uint64 imm12 = (wi >> 10) & 0xFFF
                    uint64 off = imm12 * 4
                    if off != 0 {
                        write(fd, ", #", 3)
                        drl = fmt_uint(drb, off)
                        write(fd, drb, drl)
                    }
                    write(fd, "]", 1)
                }
                // STR 32-bit unsigned offset
                else if (wi & 0xFFC00000) == 0xB9000000 {
                    write(fd, "str ", 4)
                    write_a64_wreg(fd, rd)
                    write(fd, ", [", 3)
                    write_a64_xreg(fd, rn)
                    uint64 imm12 = (wi >> 10) & 0xFFF
                    uint64 off = imm12 * 4
                    if off != 0 {
                        write(fd, ", #", 3)
                        drl = fmt_uint(drb, off)
                        write(fd, drb, drl)
                    }
                    write(fd, "]", 1)
                }
                // LDRB unsigned offset
                else if (wi & 0xFFC00000) == 0x39400000 {
                    write(fd, "ldrb ", 5)
                    write_a64_wreg(fd, rd)
                    write(fd, ", [", 3)
                    write_a64_xreg(fd, rn)
                    uint64 imm12 = (wi >> 10) & 0xFFF
                    if imm12 != 0 {
                        write(fd, ", #", 3)
                        drl = fmt_uint(drb, imm12)
                        write(fd, drb, drl)
                    }
                    write(fd, "]", 1)
                }
                // STRB unsigned offset
                else if (wi & 0xFFC00000) == 0x39000000 {
                    write(fd, "strb ", 5)
                    write_a64_wreg(fd, rd)
                    write(fd, ", [", 3)
                    write_a64_xreg(fd, rn)
                    uint64 imm12 = (wi >> 10) & 0xFFF
                    if imm12 != 0 {
                        write(fd, ", #", 3)
                        drl = fmt_uint(drb, imm12)
                        write(fd, drb, drl)
                    }
                    write(fd, "]", 1)
                }
                // STP 64-bit: signed offset / pre-index / post-index
                else if (wi & 0xFFC00000) == 0xA9000000 || (wi & 0xFFC00000) == 0xA9800000 || (wi & 0xFFC00000) == 0xA8800000 {
                    write(fd, "stp ", 4)
                    write_a64_xreg(fd, rd)
                    write(fd, ", ", 2)
                    uint64 rt2 = (wi >> 10) & 0x1F
                    write_a64_xreg(fd, rt2)
                    write(fd, ", [", 3)
                    write_a64_xreg(fd, rn)
                    uint64 imm7 = (wi >> 15) & 0x7F
                    uint64 soff = imm7
                    if (imm7 & 0x40) != 0 { soff = soff | 0xFFFFFFFFFFFFFF80 }
                    soff = soff * 8
                    if soff != 0 {
                        write(fd, ", #", 3)
                        if (soff & 0x8000000000000000) != 0 {
                            write(fd, "-", 1)
                            soff = 0 - soff
                        }
                        drl = fmt_uint(drb, soff)
                        write(fd, drb, drl)
                    }
                    write(fd, "]", 1)
                    if (wi & 0xFFC00000) == 0xA9800000 {
                        write(fd, "!", 1)
                    }
                }
                // LDP 64-bit: signed offset / pre-index / post-index
                else if (wi & 0xFFC00000) == 0xA9400000 || (wi & 0xFFC00000) == 0xA9C00000 || (wi & 0xFFC00000) == 0xA8C00000 {
                    write(fd, "ldp ", 4)
                    write_a64_xreg(fd, rd)
                    write(fd, ", ", 2)
                    uint64 rt2 = (wi >> 10) & 0x1F
                    write_a64_xreg(fd, rt2)
                    write(fd, ", [", 3)
                    write_a64_xreg(fd, rn)
                    uint64 imm7 = (wi >> 15) & 0x7F
                    uint64 soff = imm7
                    if (imm7 & 0x40) != 0 { soff = soff | 0xFFFFFFFFFFFFFF80 }
                    soff = soff * 8
                    if soff != 0 {
                        write(fd, ", #", 3)
                        if (soff & 0x8000000000000000) != 0 {
                            write(fd, "-", 1)
                            soff = 0 - soff
                        }
                        drl = fmt_uint(drb, soff)
                        write(fd, drb, drl)
                    }
                    write(fd, "]", 1)
                    if (wi & 0xFFC00000) == 0xA9C00000 {
                        write(fd, "!", 1)
                    }
                }
                // BL: 1001 01 imm26
                else if (wi & 0xFC000000) == 0x94000000 {
                    write(fd, "bl ", 3)
                    uint64 imm26 = wi & 0x3FFFFFF
                    if (imm26 & 0x2000000) != 0 {
                        uint64 soff = (0x4000000 - imm26) * 4
                        write(fd, "<-", 2)
                        drl = fmt_uint(drb, soff)
                        write(fd, drb, drl)
                    } else {
                        uint64 soff = imm26 * 4
                        write(fd, "<+", 2)
                        drl = fmt_uint(drb, soff)
                        write(fd, drb, drl)
                    }
                    write(fd, ">", 1)
                }
                // B: 0001 01 imm26
                else if (wi & 0xFC000000) == 0x14000000 {
                    write(fd, "b ", 2)
                    uint64 imm26 = wi & 0x3FFFFFF
                    if (imm26 & 0x2000000) != 0 {
                        uint64 soff = (0x4000000 - imm26) * 4
                        write(fd, "<-", 2)
                        drl = fmt_uint(drb, soff)
                        write(fd, drb, drl)
                    } else {
                        uint64 soff = imm26 * 4
                        write(fd, "<+", 2)
                        drl = fmt_uint(drb, soff)
                        write(fd, drb, drl)
                    }
                    write(fd, ">", 1)
                }
                // B.cond: 0101 0100 imm19 0 cond
                else if (wi & 0xFF000010) == 0x54000000 {
                    write(fd, "b.", 2)
                    uint64 cond = wi & 0xF
                    if cond == 0 { write(fd, "eq", 2) }
                    else if cond == 1 { write(fd, "ne", 2) }
                    else if cond == 2 { write(fd, "cs", 2) }
                    else if cond == 3 { write(fd, "cc", 2) }
                    else if cond == 4 { write(fd, "mi", 2) }
                    else if cond == 5 { write(fd, "pl", 2) }
                    else if cond == 6 { write(fd, "vs", 2) }
                    else if cond == 7 { write(fd, "vc", 2) }
                    else if cond == 8 { write(fd, "hi", 2) }
                    else if cond == 9 { write(fd, "ls", 2) }
                    else if cond == 10 { write(fd, "ge", 2) }
                    else if cond == 11 { write(fd, "lt", 2) }
                    else if cond == 12 { write(fd, "gt", 2) }
                    else if cond == 13 { write(fd, "le", 2) }
                    else if cond == 14 { write(fd, "al", 2) }
                    else { write(fd, "nv", 2) }
                    write(fd, " ", 1)
                    uint64 imm19 = (wi >> 5) & 0x7FFFF
                    if (imm19 & 0x40000) != 0 {
                        uint64 soff = (0x80000 - imm19) * 4
                        write(fd, "<-", 2)
                        drl = fmt_uint(drb, soff)
                        write(fd, drb, drl)
                    } else {
                        uint64 soff = imm19 * 4
                        write(fd, "<+", 2)
                        drl = fmt_uint(drb, soff)
                        write(fd, drb, drl)
                    }
                    write(fd, ">", 1)
                }
                // CBNZ 64-bit
                else if (wi & 0xFF000000) == 0xB5000000 {
                    write(fd, "cbnz ", 5)
                    write_a64_xreg(fd, rd)
                    write(fd, ", ", 2)
                    uint64 imm19 = (wi >> 5) & 0x7FFFF
                    if (imm19 & 0x40000) != 0 {
                        uint64 soff = (0x80000 - imm19) * 4
                        write(fd, "<-", 2)
                        drl = fmt_uint(drb, soff)
                        write(fd, drb, drl)
                    } else {
                        uint64 soff = imm19 * 4
                        write(fd, "<+", 2)
                        drl = fmt_uint(drb, soff)
                        write(fd, drb, drl)
                    }
                    write(fd, ">", 1)
                }
                // CBZ 64-bit
                else if (wi & 0xFF000000) == 0xB4000000 {
                    write(fd, "cbz ", 4)
                    write_a64_xreg(fd, rd)
                    write(fd, ", ", 2)
                    uint64 imm19 = (wi >> 5) & 0x7FFFF
                    if (imm19 & 0x40000) != 0 {
                        uint64 soff = (0x80000 - imm19) * 4
                        write(fd, "<-", 2)
                        drl = fmt_uint(drb, soff)
                        write(fd, drb, drl)
                    } else {
                        uint64 soff = imm19 * 4
                        write(fd, "<+", 2)
                        drl = fmt_uint(drb, soff)
                        write(fd, drb, drl)
                    }
                    write(fd, ">", 1)
                }
                // CBNZ 32-bit
                else if (wi & 0xFF000000) == 0x35000000 {
                    write(fd, "cbnz ", 5)
                    write_a64_wreg(fd, rd)
                    write(fd, ", ", 2)
                    uint64 imm19 = (wi >> 5) & 0x7FFFF
                    if (imm19 & 0x40000) != 0 {
                        uint64 soff = (0x80000 - imm19) * 4
                        write(fd, "<-", 2)
                        drl = fmt_uint(drb, soff)
                        write(fd, drb, drl)
                    } else {
                        uint64 soff = imm19 * 4
                        write(fd, "<+", 2)
                        drl = fmt_uint(drb, soff)
                        write(fd, drb, drl)
                    }
                    write(fd, ">", 1)
                }
                // CBZ 32-bit
                else if (wi & 0xFF000000) == 0x34000000 {
                    write(fd, "cbz ", 4)
                    write_a64_wreg(fd, rd)
                    write(fd, ", ", 2)
                    uint64 imm19 = (wi >> 5) & 0x7FFFF
                    if (imm19 & 0x40000) != 0 {
                        uint64 soff = (0x80000 - imm19) * 4
                        write(fd, "<-", 2)
                        drl = fmt_uint(drb, soff)
                        write(fd, drb, drl)
                    } else {
                        uint64 soff = imm19 * 4
                        write(fd, "<+", 2)
                        drl = fmt_uint(drb, soff)
                        write(fd, drb, drl)
                    }
                    write(fd, ">", 1)
                }
                // MRS
                else if (wi & 0xFFF00000) == 0xD5300000 {
                    write(fd, "mrs ", 4)
                    write_a64_xreg(fd, rd)
                    write(fd, ", ", 2)
                    uint64 sop0 = ((wi >> 19) & 1) + 2
                    uint64 sop1 = (wi >> 16) & 0x7
                    uint64 scrn = (wi >> 12) & 0xF
                    uint64 scrm = (wi >> 8) & 0xF
                    uint64 sop2 = (wi >> 5) & 0x7
                    write_a64_sysreg(fd, sop0, sop1, scrn, scrm, sop2)
                }
                // MSR
                else if (wi & 0xFFF00000) == 0xD5100000 {
                    write(fd, "msr ", 4)
                    uint64 sop0 = ((wi >> 19) & 1) + 2
                    uint64 sop1 = (wi >> 16) & 0x7
                    uint64 scrn = (wi >> 12) & 0xF
                    uint64 scrm = (wi >> 8) & 0xF
                    uint64 sop2 = (wi >> 5) & 0x7
                    write_a64_sysreg(fd, sop0, sop1, scrn, scrm, sop2)
                    write(fd, ", ", 2)
                    write_a64_xreg(fd, rd)
                }
                // LDXR/LDAR
                else if (wi & 0x3FE00000) == 0x08400000 {
                    if (wi & 0x00800000) != 0 {
                        write(fd, "ldar ", 5)
                    } else {
                        write(fd, "ldxr ", 5)
                    }
                    uint64 is_64 = (wi >> 30) & 1
                    if is_64 != 0 {
                        write_a64_xreg(fd, rd)
                    } else {
                        write_a64_wreg(fd, rd)
                    }
                    write(fd, ", [", 3)
                    write_a64_xreg(fd, rn)
                    write(fd, "]", 1)
                }
                // STXR/STLR
                else if (wi & 0x3FE00000) == 0x08000000 {
                    if (wi & 0x00800000) != 0 {
                        write(fd, "stlr ", 5)
                    } else {
                        write(fd, "stxr ", 5)
                    }
                    uint64 is_64 = (wi >> 30) & 1
                    if is_64 != 0 {
                        write_a64_xreg(fd, rd)
                    } else {
                        write_a64_wreg(fd, rd)
                    }
                    write(fd, ", [", 3)
                    write_a64_xreg(fd, rn)
                    write(fd, "]", 1)
                }
                write(fd, "\n", 1)
                pos = pos + 4
            }
        } else if arch == 0 {
            // x86_64: variable length — hex dump with basic decode
            while pos < fn_end {
                write(fd, "  ", 2)
                write_hex32(fd, pos - text_start)
                write(fd, ": ", 2)
                uint64 bp = out_buf + pos
                uint64 b0 = 0
                unsafe { *(bp as uint8) -> b0 }
                // Decode some common patterns
                if b0 == 0xC3 {
                    write_hex8(fd, b0)
                    write(fd, "                 ret", 20)
                    pos = pos + 1
                } else if b0 == 0x0F {
                    uint64 bp1 = bp + 1
                    uint64 b1 = 0
                    unsafe { *(bp1 as uint8) -> b1 }
                    if b1 == 0x05 {
                        write_hex8(fd, b0)
                        write(fd, " ", 1)
                        write_hex8(fd, b1)
                        write(fd, "              syscall", 21)
                        pos = pos + 2
                    } else if b1 == 0xAE {
                        uint64 bp2 = bp + 2
                        uint64 b2 = 0
                        unsafe { *(bp2 as uint8) -> b2 }
                        if b2 == 0xF0 {
                            write_hex8(fd, b0)
                            write(fd, " ", 1)
                            write_hex8(fd, b1)
                            write(fd, " ", 1)
                            write_hex8(fd, b2)
                            uint64 wmsg_1461 = "           mfence"
                            write(fd, wmsg_1461, str_len(wmsg_1461))
                            pos = pos + 3
                        } else {
                            write_hex8(fd, b0)
                            write(fd, " ", 1)
                            write_hex8(fd, b1)
                            write(fd, " ", 1)
                            write_hex8(fd, b2)
                            pos = pos + 3
                        }
                    } else if b1 >= 0x80 && b1 <= 0x8F && pos + 6 <= fn_end {
                        // jcc rel32: 0F 80-8F + imm32
                        uint64 bp2 = bp + 2
                        uint64 i0 = 0
                        uint64 i1 = 0
                        uint64 i2 = 0
                        uint64 i3 = 0
                        unsafe { *(bp2 as uint8) -> i0 }
                        uint64 bp3 = bp + 3
                        unsafe { *(bp3 as uint8) -> i1 }
                        uint64 bp4 = bp + 4
                        unsafe { *(bp4 as uint8) -> i2 }
                        uint64 bp5 = bp + 5
                        unsafe { *(bp5 as uint8) -> i3 }
                        write_hex8(fd, b0)
                        write(fd, " ", 1)
                        write_hex8(fd, b1)
                        write(fd, " ", 1)
                        write_hex8(fd, i0)
                        write(fd, " ", 1)
                        write_hex8(fd, i1)
                        write(fd, " ", 1)
                        write_hex8(fd, i2)
                        write(fd, " ", 1)
                        write_hex8(fd, i3)
                        write(fd, "  ", 2)
                        uint64 jcc32_cc = b1 - 0x80
                        if jcc32_cc == 0 { write(fd, "jo 0x", 5) }
                        else if jcc32_cc == 1 { write(fd, "jno 0x", 6) }
                        else if jcc32_cc == 2 { write(fd, "jb 0x", 5) }
                        else if jcc32_cc == 3 { write(fd, "jnb 0x", 6) }
                        else if jcc32_cc == 4 { write(fd, "je 0x", 5) }
                        else if jcc32_cc == 5 { write(fd, "jne 0x", 6) }
                        else if jcc32_cc == 6 { write(fd, "jbe 0x", 6) }
                        else if jcc32_cc == 7 { write(fd, "ja 0x", 5) }
                        else if jcc32_cc == 8 { write(fd, "js 0x", 5) }
                        else if jcc32_cc == 9 { write(fd, "jns 0x", 6) }
                        else if jcc32_cc == 10 { write(fd, "jp 0x", 5) }
                        else if jcc32_cc == 11 { write(fd, "jnp 0x", 6) }
                        else if jcc32_cc == 12 { write(fd, "jl 0x", 5) }
                        else if jcc32_cc == 13 { write(fd, "jge 0x", 6) }
                        else if jcc32_cc == 14 { write(fd, "jle 0x", 6) }
                        else { write(fd, "jg 0x", 5) }
                        uint64 jcc32_imm = i0 | (i1 << 8) | (i2 << 16) | (i3 << 24)
                        write_hex32(fd, jcc32_imm)
                        pos = pos + 6
                    } else {
                        // Dump up to 4 bytes
                        uint64 cnt = 2
                        uint64 di = 0
                        while di < cnt {
                            uint64 dp = bp + di
                            uint64 db = 0
                            unsafe { *(dp as uint8) -> db }
                            write_hex8(fd, db)
                            write(fd, " ", 1)
                            di = di + 1
                        }
                        pos = pos + cnt
                    }
                } else if b0 == 0xF0 {
                    // LOCK prefix
                    write_hex8(fd, b0)
                    write(fd, " ", 1)
                    uint64 wmsg_1535 = "...          lock ..."
                    write(fd, wmsg_1535, str_len(wmsg_1535))
                    // Dump rest of instruction (up to 7 more bytes)
                    uint64 li = 1
                    while li < 8 && pos + li < fn_end {
                        uint64 lp = bp + li
                        uint64 lb = 0
                        unsafe { *(lp as uint8) -> lb }
                        if lb == 0x48 || lb == 0x0F || (lb >= 0x80 && lb <= 0xCF) {
                            li = li + 1
                        } else {
                            li = li + 1
                            break
                        }
                    }
                    pos = pos + li
                } else if b0 >= 0x50 && b0 <= 0x57 {
                    // push reg (0x50-0x57)
                    write_hex8(fd, b0)
                    write(fd, "                 push ", 22)
                    uint64 push_r = b0 - 0x50
                    if push_r == 0 { write(fd, "rax", 3) }
                    else if push_r == 1 { write(fd, "rcx", 3) }
                    else if push_r == 2 { write(fd, "rdx", 3) }
                    else if push_r == 3 { write(fd, "rbx", 3) }
                    else if push_r == 4 { write(fd, "rsp", 3) }
                    else if push_r == 5 { write(fd, "rbp", 3) }
                    else if push_r == 6 { write(fd, "rsi", 3) }
                    else { write(fd, "rdi", 3) }
                    pos = pos + 1
                } else if b0 >= 0x58 && b0 <= 0x5F {
                    // pop reg (0x58-0x5F)
                    write_hex8(fd, b0)
                    write(fd, "                 pop ", 21)
                    uint64 pop_r = b0 - 0x58
                    if pop_r == 0 { write(fd, "rax", 3) }
                    else if pop_r == 1 { write(fd, "rcx", 3) }
                    else if pop_r == 2 { write(fd, "rdx", 3) }
                    else if pop_r == 3 { write(fd, "rbx", 3) }
                    else if pop_r == 4 { write(fd, "rsp", 3) }
                    else if pop_r == 5 { write(fd, "rbp", 3) }
                    else if pop_r == 6 { write(fd, "rsi", 3) }
                    else { write(fd, "rdi", 3) }
                    pos = pos + 1
                } else if b0 == 0x90 {
                    // nop
                    write_hex8(fd, b0)
                    write(fd, "                 nop", 20)
                    pos = pos + 1
                } else if b0 == 0xE8 && pos + 5 <= fn_end {
                    // call rel32
                    uint64 bp1 = bp + 1
                    uint64 bp2 = bp + 2
                    uint64 bp3 = bp + 3
                    uint64 bp4 = bp + 4
                    uint64 c0 = 0
                    uint64 c1 = 0
                    uint64 c2 = 0
                    uint64 c3 = 0
                    unsafe { *(bp1 as uint8) -> c0 }
                    unsafe { *(bp2 as uint8) -> c1 }
                    unsafe { *(bp3 as uint8) -> c2 }
                    unsafe { *(bp4 as uint8) -> c3 }
                    write_hex8(fd, b0)
                    write(fd, " ", 1)
                    write_hex8(fd, c0)
                    write(fd, " ", 1)
                    write_hex8(fd, c1)
                    write(fd, " ", 1)
                    write_hex8(fd, c2)
                    write(fd, " ", 1)
                    write_hex8(fd, c3)
                    write(fd, "     call 0x", 12)
                    uint64 call_imm = c0 | (c1 << 8) | (c2 << 16) | (c3 << 24)
                    write_hex32(fd, call_imm)
                    pos = pos + 5
                } else if b0 == 0xE9 && pos + 5 <= fn_end {
                    // jmp rel32
                    uint64 bp1 = bp + 1
                    uint64 bp2 = bp + 2
                    uint64 bp3 = bp + 3
                    uint64 bp4 = bp + 4
                    uint64 j0 = 0
                    uint64 j1 = 0
                    uint64 j2 = 0
                    uint64 j3 = 0
                    unsafe { *(bp1 as uint8) -> j0 }
                    unsafe { *(bp2 as uint8) -> j1 }
                    unsafe { *(bp3 as uint8) -> j2 }
                    unsafe { *(bp4 as uint8) -> j3 }
                    write_hex8(fd, b0)
                    write(fd, " ", 1)
                    write_hex8(fd, j0)
                    write(fd, " ", 1)
                    write_hex8(fd, j1)
                    write(fd, " ", 1)
                    write_hex8(fd, j2)
                    write(fd, " ", 1)
                    write_hex8(fd, j3)
                    write(fd, "     jmp 0x", 11)
                    uint64 jmp32_imm = j0 | (j1 << 8) | (j2 << 16) | (j3 << 24)
                    write_hex32(fd, jmp32_imm)
                    pos = pos + 5
                } else if b0 == 0xEB && pos + 2 <= fn_end {
                    // jmp rel8
                    uint64 bp1 = bp + 1
                    uint64 jmp8_off = 0
                    unsafe { *(bp1 as uint8) -> jmp8_off }
                    write_hex8(fd, b0)
                    write(fd, " ", 1)
                    write_hex8(fd, jmp8_off)
                    write(fd, "              jmp 0x", 20)
                    write_hex8(fd, jmp8_off)
                    pos = pos + 2
                } else if b0 >= 0x70 && b0 <= 0x7F && pos + 2 <= fn_end {
                    // jcc rel8 (0x70-0x7F)
                    uint64 bp1 = bp + 1
                    uint64 jcc8_off = 0
                    unsafe { *(bp1 as uint8) -> jcc8_off }
                    write_hex8(fd, b0)
                    write(fd, " ", 1)
                    write_hex8(fd, jcc8_off)
                    write(fd, "              ", 14)
                    uint64 jcc8_cc = b0 - 0x70
                    if jcc8_cc == 0 { write(fd, "jo 0x", 5) }
                    else if jcc8_cc == 1 { write(fd, "jno 0x", 6) }
                    else if jcc8_cc == 2 { write(fd, "jb 0x", 5) }
                    else if jcc8_cc == 3 { write(fd, "jnb 0x", 6) }
                    else if jcc8_cc == 4 { write(fd, "je 0x", 5) }
                    else if jcc8_cc == 5 { write(fd, "jne 0x", 6) }
                    else if jcc8_cc == 6 { write(fd, "jbe 0x", 6) }
                    else if jcc8_cc == 7 { write(fd, "ja 0x", 5) }
                    else if jcc8_cc == 8 { write(fd, "js 0x", 5) }
                    else if jcc8_cc == 9 { write(fd, "jns 0x", 6) }
                    else if jcc8_cc == 10 { write(fd, "jp 0x", 5) }
                    else if jcc8_cc == 11 { write(fd, "jnp 0x", 6) }
                    else if jcc8_cc == 12 { write(fd, "jl 0x", 5) }
                    else if jcc8_cc == 13 { write(fd, "jge 0x", 6) }
                    else if jcc8_cc == 14 { write(fd, "jle 0x", 6) }
                    else { write(fd, "jg 0x", 5) }
                    write_hex8(fd, jcc8_off)
                    pos = pos + 2
                } else if b0 == 0xB8 && pos + 5 <= fn_end {
                    // mov eax, imm32
                    uint64 bp1 = bp + 1
                    uint64 bp2 = bp + 2
                    uint64 bp3 = bp + 3
                    uint64 bp4 = bp + 4
                    uint64 m0 = 0
                    uint64 m1 = 0
                    uint64 m2 = 0
                    uint64 m3 = 0
                    unsafe { *(bp1 as uint8) -> m0 }
                    unsafe { *(bp2 as uint8) -> m1 }
                    unsafe { *(bp3 as uint8) -> m2 }
                    unsafe { *(bp4 as uint8) -> m3 }
                    write_hex8(fd, b0)
                    write(fd, " ", 1)
                    write_hex8(fd, m0)
                    write(fd, " ", 1)
                    write_hex8(fd, m1)
                    write(fd, " ", 1)
                    write_hex8(fd, m2)
                    write(fd, " ", 1)
                    write_hex8(fd, m3)
                    write(fd, "     mov eax, 0x", 16)
                    uint64 mov_eax_imm = m0 | (m1 << 8) | (m2 << 16) | (m3 << 24)
                    write_hex32(fd, mov_eax_imm)
                    pos = pos + 5
                } else if (b0 == 0x4C) && pos + 3 <= fn_end {
                    // REX.WR prefix (r8-r15 in reg field) + mov r/m,r or mov r,r/m
                    uint64 bp1_c = bp + 1
                    uint64 b1_c = 0
                    unsafe { *(bp1_c as uint8) -> b1_c }
                    if (b1_c == 0x89 || b1_c == 0x8B) && pos + 3 <= fn_end {
                        uint64 bp2c = bp + 2
                        uint64 modrm_c = 0
                        unsafe { *(bp2c as uint8) -> modrm_c }
                        uint64 mod_c = (modrm_c >> 6) & 3
                        uint64 rm_c  = modrm_c & 7
                        uint64 reg_c = (modrm_c >> 3) & 7
                        uint64 extra_c = x86_modrm_extra(modrm_c)
                        uint64 tlen_c = 3 + extra_c
                        if pos + tlen_c > fn_end { tlen_c = fn_end - pos }
                        uint64 dbic = 0
                        while dbic < tlen_c {
                            uint64 dppc = bp + dbic
                            uint64 dbbc = 0
                            unsafe { *(dppc as uint8) -> dbbc }
                            write_hex8(fd, dbbc)
                            if dbic + 1 < tlen_c { write(fd, " ", 1) }
                            dbic = dbic + 1
                        }
                        write(fd, "  mov ", 6)
                        // REX.R → reg field (bit 3); REX.B would be 0x4D, unhandled here
                        // so rm stays 0..7 (rax..rdi), reg becomes r8..r15.
                        uint64 reg_hi = reg_c | 8
                        if mod_c == 3 {
                            if b1_c == 0x89 {
                                write_x86_reg64(fd, rm_c)
                                write(fd, ", ", 2)
                                write_x86_reg64(fd, reg_hi)
                            } else {
                                write_x86_reg64(fd, reg_hi)
                                write(fd, ", ", 2)
                                write_x86_reg64(fd, rm_c)
                            }
                        } else {
                            if b1_c == 0x89 {
                                write_x86_mem(fd, bp2c, 0)
                                write(fd, ", ", 2)
                                write_x86_reg64(fd, reg_hi)
                            } else {
                                write_x86_reg64(fd, reg_hi)
                                write(fd, ", ", 2)
                                write_x86_mem(fd, bp2c, 0)
                            }
                        }
                        pos = pos + tlen_c
                    } else {
                        // Unknown 4C-prefixed — dump 3 bytes raw
                        uint64 cnt_c = 3
                        if cnt_c + pos > fn_end { cnt_c = fn_end - pos }
                        uint64 dic = 0
                        while dic < cnt_c {
                            uint64 dpc = bp + dic
                            uint64 dbc = 0
                            unsafe { *(dpc as uint8) -> dbc }
                            write_hex8(fd, dbc)
                            write(fd, " ", 1)
                            dic = dic + 1
                        }
                        pos = pos + cnt_c
                    }
                } else if b0 == 0x48 && pos + 3 <= fn_end {
                    // REX.W instructions
                    uint64 bp1 = bp + 1
                    uint64 b1 = 0
                    unsafe { *(bp1 as uint8) -> b1 }
                    if b1 == 0xC7 && pos + 7 <= fn_end {
                        // REX.W mov r64, imm32: 48 C7 C0+reg imm32
                        uint64 bp2 = bp + 2
                        uint64 modrm = 0
                        unsafe { *(bp2 as uint8) -> modrm }
                        if modrm >= 0xC0 && modrm <= 0xC7 {
                            uint64 bp3 = bp + 3
                            uint64 bp4 = bp + 4
                            uint64 bp5 = bp + 5
                            uint64 bp6 = bp + 6
                            uint64 ri0 = 0
                            uint64 ri1 = 0
                            uint64 ri2 = 0
                            uint64 ri3 = 0
                            unsafe { *(bp3 as uint8) -> ri0 }
                            unsafe { *(bp4 as uint8) -> ri1 }
                            unsafe { *(bp5 as uint8) -> ri2 }
                            unsafe { *(bp6 as uint8) -> ri3 }
                            write_hex8(fd, b0)
                            write(fd, " ", 1)
                            write_hex8(fd, b1)
                            write(fd, " ", 1)
                            write_hex8(fd, modrm)
                            write(fd, " ", 1)
                            write_hex8(fd, ri0)
                            write(fd, " ", 1)
                            write_hex8(fd, ri1)
                            write(fd, " ", 1)
                            write_hex8(fd, ri2)
                            write(fd, " ", 1)
                            write_hex8(fd, ri3)
                            write(fd, " mov ", 5)
                            uint64 mov_reg = modrm - 0xC0
                            if mov_reg == 0 { write(fd, "rax", 3) }
                            else if mov_reg == 1 { write(fd, "rcx", 3) }
                            else if mov_reg == 2 { write(fd, "rdx", 3) }
                            else if mov_reg == 3 { write(fd, "rbx", 3) }
                            else if mov_reg == 4 { write(fd, "rsp", 3) }
                            else if mov_reg == 5 { write(fd, "rbp", 3) }
                            else if mov_reg == 6 { write(fd, "rsi", 3) }
                            else { write(fd, "rdi", 3) }
                            write(fd, ", 0x", 4)
                            uint64 mov_imm = ri0 | (ri1 << 8) | (ri2 << 16) | (ri3 << 24)
                            write_hex32(fd, mov_imm)
                            pos = pos + 7
                        } else {
                            // C7 with non-register modrm, dump 7 bytes raw
                            uint64 cnt = 7
                            if cnt + pos > fn_end { cnt = fn_end - pos }
                            uint64 di = 0
                            while di < cnt {
                                uint64 dp = bp + di
                                uint64 db = 0
                                unsafe { *(dp as uint8) -> db }
                                write_hex8(fd, db)
                                write(fd, " ", 1)
                                di = di + 1
                            }
                            pos = pos + cnt
                        }
                    } else if b1 == 0x81 && pos + 7 <= fn_end {
                        // REX.W op rsp, imm32: 48 81 EC/C4 imm32
                        uint64 bp2 = bp + 2
                        uint64 modrm81 = 0
                        unsafe { *(bp2 as uint8) -> modrm81 }
                        if modrm81 == 0xEC || modrm81 == 0xC4 {
                            uint64 bp3 = bp + 3
                            uint64 bp4 = bp + 4
                            uint64 bp5 = bp + 5
                            uint64 bp6 = bp + 6
                            uint64 si0 = 0
                            uint64 si1 = 0
                            uint64 si2 = 0
                            uint64 si3 = 0
                            unsafe { *(bp3 as uint8) -> si0 }
                            unsafe { *(bp4 as uint8) -> si1 }
                            unsafe { *(bp5 as uint8) -> si2 }
                            unsafe { *(bp6 as uint8) -> si3 }
                            write_hex8(fd, b0)
                            write(fd, " ", 1)
                            write_hex8(fd, b1)
                            write(fd, " ", 1)
                            write_hex8(fd, modrm81)
                            write(fd, " ", 1)
                            write_hex8(fd, si0)
                            write(fd, " ", 1)
                            write_hex8(fd, si1)
                            write(fd, " ", 1)
                            write_hex8(fd, si2)
                            write(fd, " ", 1)
                            write_hex8(fd, si3)
                            if modrm81 == 0xEC {
                                write(fd, " sub rsp, 0x", 12)
                            } else {
                                write(fd, " add rsp, 0x", 12)
                            }
                            uint64 sub_imm32 = si0 | (si1 << 8) | (si2 << 16) | (si3 << 24)
                            write_hex32(fd, sub_imm32)
                            pos = pos + 7
                        } else {
                            // 81 with other modrm, dump 7 bytes raw
                            uint64 cnt = 7
                            if cnt + pos > fn_end { cnt = fn_end - pos }
                            uint64 di = 0
                            while di < cnt {
                                uint64 dp = bp + di
                                uint64 db = 0
                                unsafe { *(dp as uint8) -> db }
                                write_hex8(fd, db)
                                write(fd, " ", 1)
                                di = di + 1
                            }
                            pos = pos + cnt
                        }
                    } else if b1 == 0x83 && pos + 4 <= fn_end {
                        // REX.W op rsp, imm8: 48 83 EC/C4 imm8
                        uint64 bp2 = bp + 2
                        uint64 modrm83 = 0
                        unsafe { *(bp2 as uint8) -> modrm83 }
                        if modrm83 == 0xEC || modrm83 == 0xC4 {
                            uint64 bp3 = bp + 3
                            uint64 si8 = 0
                            unsafe { *(bp3 as uint8) -> si8 }
                            write_hex8(fd, b0)
                            write(fd, " ", 1)
                            write_hex8(fd, b1)
                            write(fd, " ", 1)
                            write_hex8(fd, modrm83)
                            write(fd, " ", 1)
                            write_hex8(fd, si8)
                            if modrm83 == 0xEC {
                                write(fd, "        sub rsp, 0x", 19)
                            } else {
                                write(fd, "        add rsp, 0x", 19)
                            }
                            write_hex8(fd, si8)
                            pos = pos + 4
                        } else {
                            // 83 with other modrm, dump 4 bytes raw
                            uint64 cnt = 4
                            if cnt + pos > fn_end { cnt = fn_end - pos }
                            uint64 di = 0
                            while di < cnt {
                                uint64 dp = bp + di
                                uint64 db = 0
                                unsafe { *(dp as uint8) -> db }
                                write_hex8(fd, db)
                                write(fd, " ", 1)
                                di = di + 1
                            }
                            pos = pos + cnt
                        }
                    } else if b1 == 0x31 && pos + 3 <= fn_end {
                        // REX.W xor reg, reg: 48 31 XX
                        uint64 bp2 = bp + 2
                        uint64 modrm_xor = 0
                        unsafe { *(bp2 as uint8) -> modrm_xor }
                        write_hex8(fd, b0)
                        write(fd, " ", 1)
                        write_hex8(fd, b1)
                        write(fd, " ", 1)
                        write_hex8(fd, modrm_xor)
                        write(fd, "           xor ", 15)
                        // rm field = modrm & 0x07, reg field = (modrm >> 3) & 0x07
                        uint64 xor_rm = modrm_xor & 0x07
                        uint64 xor_reg = (modrm_xor >> 3) & 0x07
                        if xor_rm == 0 { write(fd, "rax", 3) }
                        else if xor_rm == 1 { write(fd, "rcx", 3) }
                        else if xor_rm == 2 { write(fd, "rdx", 3) }
                        else if xor_rm == 3 { write(fd, "rbx", 3) }
                        else if xor_rm == 4 { write(fd, "rsp", 3) }
                        else if xor_rm == 5 { write(fd, "rbp", 3) }
                        else if xor_rm == 6 { write(fd, "rsi", 3) }
                        else { write(fd, "rdi", 3) }
                        write(fd, ", ", 2)
                        if xor_reg == 0 { write(fd, "rax", 3) }
                        else if xor_reg == 1 { write(fd, "rcx", 3) }
                        else if xor_reg == 2 { write(fd, "rdx", 3) }
                        else if xor_reg == 3 { write(fd, "rbx", 3) }
                        else if xor_reg == 4 { write(fd, "rsp", 3) }
                        else if xor_reg == 5 { write(fd, "rbp", 3) }
                        else if xor_reg == 6 { write(fd, "rsi", 3) }
                        else { write(fd, "rdi", 3) }
                        pos = pos + 3
                    } else if b1 == 0x87 && pos + 3 <= fn_end {
                        // xchg reg, r/m
                        uint64 bp2x = bp + 2
                        uint64 modrm_x = 0
                        unsafe { *(bp2x as uint8) -> modrm_x }
                        uint64 extra_x = x86_modrm_extra(modrm_x)
                        uint64 tlen_x = 3 + extra_x
                        if pos + tlen_x > fn_end { tlen_x = fn_end - pos }
                        uint64 dbi_x = 0
                        while dbi_x < tlen_x {
                            uint64 dp_x = bp + dbi_x
                            uint64 db_x = 0
                            unsafe { *(dp_x as uint8) -> db_x }
                            write_hex8(fd, db_x)
                            if dbi_x + 1 < tlen_x { write(fd, " ", 1) }
                            dbi_x = dbi_x + 1
                        }
                        write(fd, "  xchg ", 7)
                        uint64 xch_reg = (modrm_x >> 3) & 7
                        write_x86_reg64(fd, xch_reg)
                        write(fd, ", ", 2)
                        if (modrm_x >> 6) == 3 {
                            write_x86_reg64(fd, modrm_x & 7)
                        } else {
                            write_x86_mem(fd, bp2x, 0)
                        }
                        pos = pos + tlen_x
                    } else if (b1 == 0x01 || b1 == 0x29) && pos + 3 <= fn_end {
                        // 0x01 = add r/m, reg ; 0x29 = sub r/m, reg
                        uint64 bp2a = bp + 2
                        uint64 modrm_a = 0
                        unsafe { *(bp2a as uint8) -> modrm_a }
                        uint64 extra_a = x86_modrm_extra(modrm_a)
                        uint64 tlen_a = 3 + extra_a
                        if pos + tlen_a > fn_end { tlen_a = fn_end - pos }
                        uint64 dbi_a = 0
                        while dbi_a < tlen_a {
                            uint64 dp_a = bp + dbi_a
                            uint64 db_a = 0
                            unsafe { *(dp_a as uint8) -> db_a }
                            write_hex8(fd, db_a)
                            if dbi_a + 1 < tlen_a { write(fd, " ", 1) }
                            dbi_a = dbi_a + 1
                        }
                        if b1 == 0x01 { write(fd, "  add ", 6) }
                        else           { write(fd, "  sub ", 6) }
                        if (modrm_a >> 6) == 3 {
                            write_x86_reg64(fd, modrm_a & 7)
                        } else {
                            write_x86_mem(fd, bp2a, 0)
                        }
                        write(fd, ", ", 2)
                        write_x86_reg64(fd, (modrm_a >> 3) & 7)
                        pos = pos + tlen_a
                    } else if b1 == 0x0F && pos + 4 <= fn_end {
                        // Two-byte opcode under REX.W
                        uint64 bp2o = bp + 2
                        uint64 b2 = 0
                        unsafe { *(bp2o as uint8) -> b2 }
                        if b2 == 0xAF && pos + 4 <= fn_end {
                            // imul reg, r/m
                            uint64 bp3o = bp + 3
                            uint64 modrm_im = 0
                            unsafe { *(bp3o as uint8) -> modrm_im }
                            uint64 extra_im = x86_modrm_extra(modrm_im)
                            uint64 tlen_im = 4 + extra_im
                            if pos + tlen_im > fn_end { tlen_im = fn_end - pos }
                            uint64 dbi2 = 0
                            while dbi2 < tlen_im {
                                uint64 dpp2 = bp + dbi2
                                uint64 dbb2 = 0
                                unsafe { *(dpp2 as uint8) -> dbb2 }
                                write_hex8(fd, dbb2)
                                if dbi2 + 1 < tlen_im { write(fd, " ", 1) }
                                dbi2 = dbi2 + 1
                            }
                            write(fd, "  imul ", 7)
                            uint64 im_reg = (modrm_im >> 3) & 7
                            write_x86_reg64(fd, im_reg)
                            write(fd, ", ", 2)
                            if (modrm_im >> 6) == 3 {
                                write_x86_reg64(fd, modrm_im & 7)
                            } else {
                                write_x86_mem(fd, bp3o, 0)
                            }
                            pos = pos + tlen_im
                        } else {
                            // Other 0F xx under REX.W — dump 4 bytes raw
                            uint64 cnt_o = 4
                            if cnt_o + pos > fn_end { cnt_o = fn_end - pos }
                            uint64 di_o = 0
                            while di_o < cnt_o {
                                uint64 dp_o = bp + di_o
                                uint64 db_o = 0
                                unsafe { *(dp_o as uint8) -> db_o }
                                write_hex8(fd, db_o)
                                write(fd, " ", 1)
                                di_o = di_o + 1
                            }
                            pos = pos + cnt_o
                        }
                    } else if (b1 == 0x89 || b1 == 0x8B) && pos + 3 <= fn_end {
                        // REX.W mov  — 0x89 = mov r/m, reg (store direction)
                        //               0x8B = mov reg, r/m (load direction)
                        // ModR/M: mod:2, reg:3, rm:3.
                        // mod==3 → reg-reg (3 bytes total)
                        // mod!=3 → memory operand; rm==4 adds SIB;
                        //          mod==1 adds disp8; mod==2 adds disp32;
                        //          mod==0 && rm==5 is RIP-relative disp32.
                        uint64 bp2 = bp + 2
                        uint64 modrm_mov = 0
                        unsafe { *(bp2 as uint8) -> modrm_mov }
                        uint64 mod_f = (modrm_mov >> 6) & 3
                        uint64 rm_f  = modrm_mov & 7
                        uint64 reg_f = (modrm_mov >> 3) & 7
                        // Compute number of bytes after ModR/M
                        uint64 extra = 0
                        if mod_f != 3 {
                            if rm_f == 4 { extra = extra + 1 }   // SIB
                            if mod_f == 1 { extra = extra + 1 }  // disp8
                            if mod_f == 2 { extra = extra + 4 }  // disp32
                            if mod_f == 0 && rm_f == 5 { extra = extra + 4 }  // rip+disp32
                        }
                        uint64 total_len = 3 + extra
                        if pos + total_len > fn_end { total_len = fn_end - pos }
                        // Dump raw bytes (space-separated)
                        uint64 dbi = 0
                        while dbi < total_len {
                            uint64 dpp = bp + dbi
                            uint64 dbb = 0
                            unsafe { *(dpp as uint8) -> dbb }
                            write_hex8(fd, dbb)
                            if dbi + 1 < total_len { write(fd, " ", 1) }
                            dbi = dbi + 1
                        }
                        write(fd, "  mov ", 6)
                        if mod_f == 3 {
                            // reg-reg: "mov <rm>, <reg>" for 0x89; "mov <reg>, <rm>" for 0x8B
                            uint64 left = rm_f
                            uint64 right = reg_f
                            if b1 == 0x8B { left = reg_f; right = rm_f }
                            if left == 0 { write(fd, "rax", 3) }
                            else if left == 1 { write(fd, "rcx", 3) }
                            else if left == 2 { write(fd, "rdx", 3) }
                            else if left == 3 { write(fd, "rbx", 3) }
                            else if left == 4 { write(fd, "rsp", 3) }
                            else if left == 5 { write(fd, "rbp", 3) }
                            else if left == 6 { write(fd, "rsi", 3) }
                            else { write(fd, "rdi", 3) }
                            write(fd, ", ", 2)
                            if right == 0 { write(fd, "rax", 3) }
                            else if right == 1 { write(fd, "rcx", 3) }
                            else if right == 2 { write(fd, "rdx", 3) }
                            else if right == 3 { write(fd, "rbx", 3) }
                            else if right == 4 { write(fd, "rsp", 3) }
                            else if right == 5 { write(fd, "rbp", 3) }
                            else if right == 6 { write(fd, "rsi", 3) }
                            else { write(fd, "rdi", 3) }
                        } else {
                            // Memory operand. Resolve base register (SIB if rm==4).
                            uint64 base_r = rm_f
                            uint64 disp_ofs = 3
                            if rm_f == 4 {
                                uint64 bp_s = bp + 3
                                uint64 sib_b = 0
                                unsafe { *(bp_s as uint8) -> sib_b }
                                base_r = sib_b & 7
                                disp_ofs = 4
                            }
                            if b1 == 0x89 {
                                // store: mov [base+disp], reg
                                write(fd, "[", 1)
                            } else {
                                // load: mov reg, [base+disp]
                                if reg_f == 0 { write(fd, "rax", 3) }
                                else if reg_f == 1 { write(fd, "rcx", 3) }
                                else if reg_f == 2 { write(fd, "rdx", 3) }
                                else if reg_f == 3 { write(fd, "rbx", 3) }
                                else if reg_f == 4 { write(fd, "rsp", 3) }
                                else if reg_f == 5 { write(fd, "rbp", 3) }
                                else if reg_f == 6 { write(fd, "rsi", 3) }
                                else { write(fd, "rdi", 3) }
                                write(fd, ", [", 3)
                            }
                            if mod_f == 0 && rm_f == 5 {
                                write(fd, "rip", 3)
                            } else if base_r == 0 { write(fd, "rax", 3) }
                            else if base_r == 1 { write(fd, "rcx", 3) }
                            else if base_r == 2 { write(fd, "rdx", 3) }
                            else if base_r == 3 { write(fd, "rbx", 3) }
                            else if base_r == 4 { write(fd, "rsp", 3) }
                            else if base_r == 5 { write(fd, "rbp", 3) }
                            else if base_r == 6 { write(fd, "rsi", 3) }
                            else { write(fd, "rdi", 3) }
                            if mod_f == 1 {
                                write(fd, "+0x", 3)
                                uint64 bp_d = bp + disp_ofs
                                uint64 d8v = 0
                                unsafe { *(bp_d as uint8) -> d8v }
                                write_hex8(fd, d8v)
                            } else if mod_f == 2 || (mod_f == 0 && rm_f == 5) {
                                write(fd, "+0x", 3)
                                uint64 bp_d0 = bp + disp_ofs
                                uint64 bp_d1 = bp + disp_ofs + 1
                                uint64 bp_d2 = bp + disp_ofs + 2
                                uint64 bp_d3 = bp + disp_ofs + 3
                                uint64 d32_0 = 0
                                uint64 d32_1 = 0
                                uint64 d32_2 = 0
                                uint64 d32_3 = 0
                                unsafe { *(bp_d0 as uint8) -> d32_0 }
                                unsafe { *(bp_d1 as uint8) -> d32_1 }
                                unsafe { *(bp_d2 as uint8) -> d32_2 }
                                unsafe { *(bp_d3 as uint8) -> d32_3 }
                                uint64 d32 = d32_0 | (d32_1 << 8) | (d32_2 << 16) | (d32_3 << 24)
                                write_hex32(fd, d32)
                            }
                            if b1 == 0x89 {
                                write(fd, "], ", 3)
                                if reg_f == 0 { write(fd, "rax", 3) }
                                else if reg_f == 1 { write(fd, "rcx", 3) }
                                else if reg_f == 2 { write(fd, "rdx", 3) }
                                else if reg_f == 3 { write(fd, "rbx", 3) }
                                else if reg_f == 4 { write(fd, "rsp", 3) }
                                else if reg_f == 5 { write(fd, "rbp", 3) }
                                else if reg_f == 6 { write(fd, "rsi", 3) }
                                else { write(fd, "rdi", 3) }
                            } else {
                                write(fd, "]", 1)
                            }
                        }
                        pos = pos + total_len
                    } else if b1 == 0x8D && pos + 3 <= fn_end {
                        // LEA reg, [mem]: 48 8D <modrm> [sib] [disp]
                        uint64 bp2 = bp + 2
                        uint64 modrm_lea = 0
                        unsafe { *(bp2 as uint8) -> modrm_lea }
                        uint64 extra_lea = x86_modrm_extra(modrm_lea)
                        uint64 total_len = 3 + extra_lea
                        if pos + total_len > fn_end { total_len = fn_end - pos }
                        uint64 dbi = 0
                        while dbi < total_len {
                            uint64 dpp = bp + dbi
                            uint64 dbb = 0
                            unsafe { *(dpp as uint8) -> dbb }
                            write_hex8(fd, dbb)
                            if dbi + 1 < total_len { write(fd, " ", 1) }
                            dbi = dbi + 1
                        }
                        write(fd, "  lea ", 6)
                        uint64 lea_reg = (modrm_lea >> 3) & 7
                        write_x86_reg64(fd, lea_reg)
                        write(fd, ", ", 2)
                        write_x86_mem(fd, bp2, 0)
                        pos = pos + total_len
                    } else {
                        // Other REX.W instructions — dump with byte count heuristic
                        uint64 cnt = 3
                        if b1 == 0x8B { cnt = 3 }
                        else if b1 >= 0x00 && b1 <= 0x3F { cnt = 3 }
                        if cnt + pos > fn_end { cnt = fn_end - pos }
                        uint64 di = 0
                        while di < cnt {
                            uint64 dp = bp + di
                            uint64 db = 0
                            unsafe { *(dp as uint8) -> db }
                            write_hex8(fd, db)
                            write(fd, " ", 1)
                            di = di + 1
                        }
                        pos = pos + cnt
                    }
                } else {
                    // Generic: dump 1 byte per line for simple format
                    uint64 cnt = 1
                    // REX prefix? Read more bytes
                    if b0 >= 0x40 && b0 <= 0x4F { cnt = 2 }
                    if b0 == 0x49 {
                        uint64 bp1 = bp + 1
                        uint64 b1 = 0
                        unsafe { *(bp1 as uint8) -> b1 }
                        if b1 == 0xC7 { cnt = 7 }
                        else if b1 == 0x89 || b1 == 0x8B { cnt = 3 }
                        else if b1 == 0x81 { cnt = 7 }
                        else if b1 == 0x83 { cnt = 4 }
                        else if b1 == 0x31 { cnt = 3 }
                        else { cnt = 3 }
                    }
                    if b0 == 0xB9 || b0 == 0xBA { cnt = 5 }
                    if cnt + pos > fn_end { cnt = fn_end - pos }
                    uint64 di = 0
                    while di < cnt {
                        uint64 dp = bp + di
                        uint64 db = 0
                        unsafe { *(dp as uint8) -> db }
                        write_hex8(fd, db)
                        write(fd, " ", 1)
                        di = di + 1
                    }
                    pos = pos + cnt
                }
                write(fd, "\n", 1)
            }
        } else if arch == 2 {
            // RV32IMC: mixed 2-/4-byte instructions — step by the length
            // rv_disasm_at reports (2 compressed, 4 full), never a fixed 4.
            while pos < fn_end {
                uint64 step = rv_disasm_at(fd, pos, text_start)
                pos = pos + step
            }
        } else {
            riscv32_nyi("asm listing")
        }
        fi = fi + 1
    }
    file_close(fd)
}

// Bare-metal entry selection, shared by every raw-emission path.
//
// Returns the AST node of the entry function: a live `_start` if one exists,
// else a live `main`, else 0. First match wins on each name; the caller owns
// the diagnostic for 0 because the wording differs per path.
//
// A NODE, NOT AN OFFSET. Callers that need a code offset must convert -- the
// fn_table entry only exists once that function has been emitted -- and the
// five call sites do three different things with the node, which is why this
// returns the node and not an offset:
//
//   * BEFORE codegen, node only (riscv32 raw, xtensa raw). riscv hoists the
//     entry to offset 0; xtensa threads it into ir_xtensa_gen for the SP
//     preamble. Neither could look up an offset here -- it does not exist yet.
//   * AFTER codegen, node -> NAME TOKEN, no lookup (the arm64 --emit=image
//     stub). It records the token in the fixup table and lets
//     resolve_fixups_a64 patch the `bl`, exactly like a call the source wrote.
//   * AFTER codegen, node -> fn_lookup -> offset (the x86_64 --emit=image
//     stub's PART 2, which patches an absolute movabs; and the finalize block,
//     which needs an offset for the `image:` report line).
//
// THE IMAGE PATH WALKS THE AST TWICE, not once: one of the two stub arms
// (arm64 at `img_raw && arch == 1`, x86_64 at `x86_stub_on`) plus the finalize
// block. Never three -- the two stub arms are mutually exclusive on arch -- and
// only once without `--stack-top=`, where no stub is emitted. The walk is a
// single pass over the top-level declaration list with no allocation, and the
// alternative (thread the node down through ~700 lines of codegen) buys less
// than it costs; noted so a future reader does not mistake it for an oversight.
//
// Factored out of two near-identical ~30-line walks (the riscv32 and xtensa
// blocks below) when --emit=image needed the same rule on x86_64/arm64.
// `main` is the fallback and not the preference: a bare-metal program is
// free to name its entry `main`, but if it also spells `_start` it means it.
//
// dce_is_live is the liveness test rather than "exists": a `_start` the
// caller pruned must not be selected, and dce_is_live answers 1 for
// everything when DCE seeded nothing (a `_start`-only program), which is
// what makes that case work without a special arm.
fn find_entry_node(uint64 root) -> uint64 {
    uint64 fen_start = 0
    uint64 fen_main = 0
    uint32 fen_child = ast_child(root)
    uint64 fen_w = fen_child
    while fen_w != 0 {
        uint32 fen_k = ast_kind(fen_w)
        if fen_k == 2 {
            uint32 fen_name = ast_data1(fen_w)
            uint64 fen_wn = fen_name
            if dce_is_live(fen_wn) != 0 {
                if tok_matches(fen_wn, "_start", 6) != 0 {
                    if fen_start == 0 {
                        fen_start = fen_w
                    }
                } else if tok_matches(fen_wn, "main", 4) != 0 {
                    if fen_main == 0 {
                        fen_main = fen_w
                    }
                }
            }
        }
        uint32 fen_nx = ast_next(fen_w)
        fen_w = fen_nx
    }
    if fen_start != 0 {
        return fen_start
    }
    return fen_main
}

// The "--emit=image found neither entry name" diagnostic, in ONE place.
//
// find_entry_node returning 0 is refused at three points on the image path --
// the arm64 stub arm, the x86_64 stub's PART 2, and the finalize block -- and
// the wording must not drift between them, because they are one cause. It was
// written out verbatim three times (Task 3 added the second, Task 4 the third
// without noting it), which is exactly the shape that drifts. Mirrors
// load_addr_die()/stack_top_die() below: one message, one place, no return.
//
// The riscv32/xtensa refusals are deliberately NOT routed here -- they name
// their own arch and their own flag (`freestanding riscv32`), which is a
// different message for a different path, not a copy of this one.
fn entry_missing_die() {
    uint64 em_msg = "error: --emit=image needs an entry function ('_start' or 'main')\n"
    write(2, em_msg, str_len(em_msg))
    em_msg = "A bare-metal image has no loader to call: name the first function to run either '_start' or 'main'\n"
    write(2, em_msg, str_len(em_msg))
    exit(1)
}

// ---------------------------------------------------------------------------
// The x86_64 entry stub (sub-project B2, D6): multiboot header + long-mode
// trampoline.
// ---------------------------------------------------------------------------
//
// WHY THIS IS NOT arm64's FIVE WORDS. On arm64 the reset vector hands over an
// AArch64 core and the stub only has to set SP and branch. x86_64 has no such
// path: KernRift emits ONLY 64-bit code, and nothing that can load a flat
// image hands over a 64-bit CPU. `-device loader` leaves the CPU in 16-bit
// REAL mode (CR0.PE = 0), `-kernel` on our ELF is refused, and multiboot --
// the one interface that will load a raw file -- enters 32-BIT PROTECTED
// mode. So the x86 stub IS the trampoline: it builds page tables, turns on
// PAE + EFER.LME + paging, loads a 64-bit GDT, far-jumps to long mode and
// calls the entry.
//
// Derived from docs/superpowers/specs/2026-08-03-x86-selfboot-trampoline.S,
// which was booted end to end (header + trampoline + an unmodified
// --emit=image payload, concatenated) before any of this was written.
//
// NOT A BLOB PLUS AN OFFSET TABLE, ON PURPOSE. Eight values here depend on
// addresses: the header's three, lgdtl's disp32, the far jump's off32, the
// movabs entry address, the gdtr's base and the 64-bit rsp. Three of those
// were missed by inspection and only found by differential build. And the
// offsets have already moved twice -- adding `cld` shifted every site above
// 32 by one byte WHILE THE TOTAL STAYED 226 (the .align 16 padding absorbed
// it), so no size check could notice. Every site below is therefore CAPTURED
// as `out_len` at the moment it is emitted and patched from that capture; no
// offset is written down anywhere, and editing the instruction stream cannot
// silently invalidate one. The symptom it would produce -- `call *%rax` into
// a stale address -- is a triple fault, not a diagnostic.
//
// PRECONDITIONS THE CALLER MUST HAVE ENFORCED (see the --load-addr/--stack-top
// validation): the page tables built below occupy physical 0x1000-0x4000, the
// identity map is one 512-entry PD of 2 MiB pages and therefore covers
// EXACTLY the first 1 GiB, and the stack must not start inside the image.
//
// The entry address is the ONE value that cannot be written here: the entry
// function has not been emitted yet (this runs before the emit loop, because
// the multiboot header has to be at file offset 0). Its site is published in
// x86stub_entry_site and patched after the loop.
static uint64 x86stub_entry_site = 0    // file offset of the movabs imm64
static uint64 x86stub_start32_off = 0   // file offset of the trampoline's cli

fn emit_x86_image_stub(uint64 ld, uint64 sp) {
    // `base` is the stub's own file offset. It is 0 today -- the multiboot
    // header must lie in the first 8192 bytes of the file and there is no
    // reason to put anything ahead of it -- but every address below is
    // computed as `ld + <file offset>` rather than assuming it.
    uint64 base = out_len

    // --- multiboot header, 32 bytes --------------------------------------
    // flags bit 16 is the AOUT KLUDGE: it tells the loader to take the load
    // addresses from these fields instead of parsing an a.out/ELF header,
    // which is the ONLY reason a raw headerless file can be booted at all.
    uint64 mb_magic = 0x1BADB002
    uint64 mb_flags = 0x00010000
    uint64 mb_sum = mb_magic + mb_flags
    // Two's complement without an underflow: -(magic+flags) mod 2^32.
    uint64 mb_ck = 0xFFFFFFFF - mb_sum + 1
    emit_u32_le(mb_magic)
    emit_u32_le(mb_flags)
    emit_u32_le(mb_ck)
    emit_u32_le(ld + base)                  // header_addr
    emit_u32_le(ld)                         // load_addr  (file offset 0)
    emit_u32_le(0)                          // load_end_addr = 0 = whole file
    emit_u32_le(0)                          // bss_end_addr
    uint64 xs_hdr_entry = out_len
    emit_u32_le(0)                          // entry_addr <- patched below

    // --- 32-bit code ------------------------------------------------------
    uint64 xs_start32 = out_len
    x86stub_start32_off = xs_start32
    emit_byte(0xFA)                         // cli
    // cld is LOAD-BEARING AND UNPROVABLE BY BOOTING. Multiboot 0.6.96 3.2
    // fixes only EFLAGS bit 17 (VM) and bit 9 (IF) and leaves DF UNDEFINED,
    // and the rep stosl below depends on it. QEMU happens to enter with
    // DF = 0, so neither a differential build nor an end-to-end boot can
    // catch its absence -- it is an environment dependency, not a
    // measurable one. Only the byte-level test holds it.
    emit_byte(0xFC)                         // cld
    emit_byte(0xBF)                         // mov $0x1000,%edi
    emit_u32_le(0x1000)
    emit_byte(0x0F)                         // mov %edi,%cr3
    emit_byte(0x22)
    emit_byte(0xDF)
    emit_byte(0x31)                         // xor %eax,%eax
    emit_byte(0xC0)
    emit_byte(0xB9)                         // mov $0xC00,%ecx   (3 pages / 4)
    emit_u32_le(0xC00)
    emit_byte(0xF3)                         // rep stosl  -> zero 0x1000-0x4000
    emit_byte(0xAB)
    emit_byte(0xBF)                         // mov $0x1000,%edi
    emit_u32_le(0x1000)
    emit_byte(0xC7)                         // movl $0x2003,(%edi)   PML4[0]
    emit_byte(0x07)
    emit_u32_le(0x2003)
    emit_byte(0xC7)                         // movl $0x3003,0x1000(%edi) PDPT[0]
    emit_byte(0x87)
    emit_u32_le(0x1000)
    emit_u32_le(0x3003)
    emit_byte(0xBF)                         // mov $0x3000,%edi      PD
    emit_u32_le(0x3000)
    emit_byte(0xB8)                         // mov $0x83,%eax  present|rw|2MiB
    emit_u32_le(0x83)
    emit_byte(0xB9)                         // mov $512,%ecx   512 * 2 MiB = 1 GiB
    emit_u32_le(512)
    uint64 xs_pd_loop = out_len             // 1:
    emit_byte(0x89)                         // mov %eax,(%edi)
    emit_byte(0x07)
    emit_byte(0x05)                         // add $0x200000,%eax
    emit_u32_le(0x200000)
    emit_byte(0x83)                         // add $8,%edi
    emit_byte(0xC7)
    emit_byte(0x08)
    emit_byte(0xE2)                         // loop 1b
    // rel8 back to the loop head, DERIVED. Wraps through uint64 because the
    // displacement is negative; the mask is what makes it a byte.
    uint64 xs_ld8 = xs_pd_loop - out_len - 1
    uint8 xs_lb = xs_ld8 & 0xFF
    emit_byte(xs_lb)
    emit_byte(0x0F)                         // mov %cr4,%eax
    emit_byte(0x20)
    emit_byte(0xE0)
    emit_byte(0x83)                         // or $(1<<5),%eax   CR4.PAE
    emit_byte(0xC8)
    emit_byte(0x20)
    emit_byte(0x0F)                         // mov %eax,%cr4
    emit_byte(0x22)
    emit_byte(0xE0)
    emit_byte(0xB9)                         // mov $0xC0000080,%ecx   IA32_EFER
    emit_u32_le(0xC0000080)
    emit_byte(0x0F)                         // rdmsr
    emit_byte(0x32)
    emit_byte(0x0D)                         // or $(1<<8),%eax   EFER.LME
    emit_u32_le(0x100)
    emit_byte(0x0F)                         // wrmsr
    emit_byte(0x30)
    emit_byte(0x0F)                         // mov %cr0,%eax
    emit_byte(0x20)
    emit_byte(0xC0)
    emit_byte(0x0D)                         // or $0x80000001,%eax  PG|PE
    emit_u32_le(0x80000001)
    emit_byte(0x0F)                         // mov %eax,%cr0
    emit_byte(0x22)
    emit_byte(0xC0)
    emit_byte(0x0F)                         // lgdtl gdtr
    emit_byte(0x01)
    emit_byte(0x15)
    uint64 xs_lgdt = out_len
    emit_u32_le(0)                          // <- patched: ld + gdtr offset
    emit_byte(0xEA)                         // ljmp $0x08, $lm
    uint64 xs_ljmp = out_len
    emit_u32_le(0)                          // <- patched: ld + lm offset
    emit_u16_le(0x0008)                     // selector = GDT[1], the 64-bit CS

    // --- 64-bit code ------------------------------------------------------
    uint64 xs_lm = out_len
    emit_byte(0x66)                         // mov $0x10,%ax   GDT[2], data
    emit_byte(0xB8)
    emit_u16_le(0x0010)
    emit_byte(0x8E)                         // mov %ax,%ds
    emit_byte(0xD8)
    emit_byte(0x8E)                         // mov %ax,%es
    emit_byte(0xC0)
    emit_byte(0x8E)                         // mov %ax,%ss
    emit_byte(0xD0)
    // mov $imm32,%rsp -- the 7-byte sign-extended form. The flag validation
    // refuses --stack-top >= 2^31 precisely so this encoding always applies;
    // at or above that boundary the value would need the 10-byte movabs and
    // every site after it would move while the file size stayed the same.
    emit_byte(0x48)
    emit_byte(0xC7)
    emit_byte(0xC4)
    emit_u32_le(sp)
    emit_byte(0x48)                         // movabs $entry,%rax
    emit_byte(0xB8)
    x86stub_entry_site = out_len
    emit_u64_le(0)                          // <- patched AFTER the emit loop
    emit_byte(0xFF)                         // call *%rax
    emit_byte(0xD0)
    uint64 xs_halt = out_len
    emit_byte(0xF4)                         // hlt
    emit_byte(0xEB)                         // jmp . -- park on a known address
    uint64 xs_jd = xs_halt - out_len - 1
    uint8 xs_jb = xs_jd & 0xFF
    emit_byte(xs_jb)

    // --- descriptor tables ------------------------------------------------
    // Pad to 16 in FILE offset, which is what the reference .S does. LGDT
    // imposes no alignment, so this is cosmetic rather than architectural --
    // and it could not be anything else, since --load-addr is a user value
    // and the file offset is the only thing this code controls.
    while (out_len & 15) != 0 { emit_byte(0) }
    uint64 xs_gdt = out_len
    emit_u64_le(0)                          // null descriptor
    emit_u64_le(0x00AF9A000000FFFF)         // 64-bit code, ring 0
    emit_u64_le(0x00CF92000000FFFF)         // data
    uint64 xs_gdtr = out_len
    uint64 xs_lim = xs_gdtr - xs_gdt - 1
    emit_u16_le(xs_lim)                     // limit = size - 1
    uint64 xs_gdtr_base = out_len
    emit_u32_le(0)                          // <- patched: ld + gdt offset
    emit_u32_le(0)                          // .long 0 (the .S's tail)

    // --- the captured sites ----------------------------------------------
    patch_u32(xs_hdr_entry, ld + xs_start32)
    patch_u32(xs_lgdt, ld + xs_gdtr)
    patch_u32(xs_ljmp, ld + xs_lm)
    patch_u32(xs_gdtr_base, ld + xs_gdt)
}

// arch: 0=x86_64, 1=arm64
// emit: 0=elfexe, 1=machoexe, 2=peexe, 3=obj (ELF relocatable), 5=asm listing, 6=ir dump
fn compile(uint64 input_path, uint64 output_path, uint64 arch, uint64 emit_mode) {
    uint64 t_start = time_ns()
    set_target_arch(arch)
    // Inform codegen of the emit mode so the alloc()/dealloc() builtins can
    // route through the kernel slab allocator (kmalloc/kfree) instead of the
    // userland mmap/munmap syscalls when targeting an LKM (emit_mode == 7).
    set_emit_mode(emit_mode)
    import_init()
    import_check_file(input_path)
    import_process(input_path)
    uint64 source = import_buf
    uint64 size = import_buf_len

    uint64 max_tok = 524288
    uint64 my_tokens = alloc(max_tok * 16)
    lexer_init(source, size, my_tokens, max_tok)
    uint64 tcount = lexer_run()

    ast_init(524288)
    codegen_init(4194304, source, my_tokens)
    parser_init(my_tokens, tcount)
    uint64 root = parse_module()

    // Semantic validation: check arg counts, missing returns, duplicate functions
    uint64 sema_errs = run_semantic_checks(root, source, my_tokens)
    // `let` type inference: resolve every inferred local's type from its RHS
    // and stash it in the AST. Runs unconditionally (the backends require a
    // concrete type for each `let`), independent of type-checking.
    resolve_inferred_types(root)
    uint64 pre_tc_errs = diag_error_count
    if check_types_enabled != 0 {
        tc_check_module(root)
    }
    // Type-checker errors are fatal (issue #101). The struct/slice/`.len`
    // false positives that previously forced this pass to be advisory-only
    // are fixed, so a tc error now aborts the build like any other.
    uint64 tc_errs = diag_error_count - pre_tc_errs
    diag_report_all()
    uint64 total_errs = sema_errs + tc_errs
    if total_errs != 0 {
        uint8[24] ebuf
        uint64 elen = fmt_uint(ebuf, total_errs)
        write(2, ebuf, elen)
        write(2, " error(s) found\n", 16)
        exit(1)
    }

    // Function inlining: substitute pure single-expression callees at
    // every call site. Runs before DCE; for translation-unit emit modes
    // (.o / .s / IR dump) we tell DCE to seed every fn so the original
    // definitions still appear in the output.
    inline_pass(root)

    // Raw flat-binary mode: arch==2 (riscv32) + --freestanding + default
    // image emission (emit_mode 0). There is no riscv ELF writer yet, and
    // the QEMU `virt -bios` loader wants a headerless image anyway, so the
    // freestanding flag doubles as the raw-binary trigger — no new --emit
    // value needed. x86/arm64 can never set this: the raw path is
    // arch==2-only by construction (bootstrap byte-identity depends on it).
    uint64 rv_raw = 0
    if arch == 2 && emit_mode == 0 && freestanding != 0 {
        rv_raw = 1
    }
    // Xtensa (Task 3): --arch=xtensa --freestanding emits a raw, headerless
    // code blob so `xtensa-lx106-elf-objdump -b binary -m xtensa` can inspect
    // the bytes before the boot-ELF writer exists (that lands in Task 8). This
    // path writes out_buf and exits right after codegen — it never reaches the
    // arch-3 fixup/ELF NYIs below. Gated on arch==3, so arch 0/1/2 are
    // untouched (bootstrap byte-identity holds).
    uint64 xt_raw = 0
    if arch == 3 && emit_mode == 0 && freestanding != 0 {
        xt_raw = 1
    }
    // The FLAT-PAYLOAD modes: --emit=image (8) and --emit=uefi (9). Gated on
    // emit_mode ALONE, not on target_os: the flag validation has already
    // refused both of them for every OS but `none` and for every arch but 0/1,
    // so {8, 9} is the exact set. Deliberately NOT written as `target_os == 4`
    // — the per-OS dispatch in this codebase is "special-case Windows/macOS,
    // ELSE fall through to POSIX", and a bare-metal condition phrased in terms
    // of the OS is the shape that inherits Linux when a case is missed.
    //
    // MODE 9 JOINED THIS GATE IN SUB-PROJECT D TASK 1, AND HAD TO. This one
    // variable gates two separate things and BOTH of them fail silently when a
    // mode is missing from it:
    //
    //   * the `_start` DCE seeding below — without it, a program with both
    //     `_start` and `main` seeds only `main`, `_start` is pruned, and
    //     find_entry_node declines to select a function that is not in the
    //     artifact;
    //   * the ENTRY-RESOLVER FORK at the finalize block — img_raw == 0 takes
    //     the find_main_offset branch, which is the hosted `@export`-and-`main`
    //     rule. Falsified by construction at BASE: `fn _start() -> uint64 {
    //     return 7 }` compiles under --emit=image (entry=0, 32 bytes) and dies
    //     "error: no 'main' function found" under --emit=pe. That second
    //     branch is exactly what a new emit mode inherits.
    //
    // What mode 9 does NOT inherit from mode 8 is any of the three flag-gated
    // blocks below (--image-header's 64 bytes, and both entry stubs): each also
    // tests image_header_set / stack_top_set, and all three of those flags are
    // refused outside emit_mode 8 by the validation at the bottom of this file.
    // UEFI needs none of them — firmware enters in long mode with a stack
    // already set up.
    uint64 img_raw = 0
    if emit_mode == 8 || emit_mode == 9 {
        img_raw = 1
    }

    // Dead code elimination: scan AST for reachable functions
    dce_init()
    if emit_mode == 3 || emit_mode == 5 || emit_mode == 6 || emit_mode == 7 {
        dce_set_keep_all(1)
    }
    // Raw riscv / xtensa / --emit=image: dce_scan only seeds `main` + @export,
    // so a freestanding entry named `_start` would be pruned before it can be
    // placed at offset 0. Seed it explicitly here (dce_scan's phase-2 closure
    // then walks its callees like any other root).
    //
    // img_raw joined this gate with B2 Task 2 and the seeding is REQUIRED, not
    // cosmetic: without it a `_start`-only image has dce_count == 0 and works
    // by accident (dce_is_live answers 1 for everything when nothing was
    // seeded), while an image with BOTH `_start` and `main` seeds only `main`
    // — `_start` is then dead, is never emitted, and find_entry_node correctly
    // declines to select a function that is not in the artifact. Measured at
    // BASE: the two-function program compiled to the same 176 bytes as the
    // main-only one. The gate stays OFF the hosted path, where `_start` is an
    // ordinary function name and libc owns the real entry.
    if rv_raw != 0 || xt_raw != 0 || img_raw != 0 {
        uint32 rvs_child = ast_child(root)
        uint64 rvs_w = rvs_child
        while rvs_w != 0 {
            uint32 rvs_k = ast_kind(rvs_w)
            if rvs_k == 2 {
                uint32 rvs_name = ast_data1(rvs_w)
                uint64 rvs_wn = rvs_name
                if tok_matches(rvs_wn, "_start", 6) != 0 {
                    dce_add(rvs_wn)
                }
            }
            uint32 rvs_nx = ast_next(rvs_w)
            rvs_w = rvs_nx
        }
    }
    dce_scan(root)

    // IR dump: lower each function to IR and print, then exit early
    if emit_mode == 6 {
        ir_init()
        uint32 child = ast_child(root)
        uint64 wchild = child
        while wchild != 0 {
            uint32 ck = ast_kind(wchild)
            if ck == 2 {
                uint32 fn_name = ast_data1(wchild)
                if dce_is_live(fn_name) != 0 {
                    uint64 ns = tok_text_start(fn_name)
                    uint64 nl = tok_text_len(fn_name)
                    write(1, "function ", 9)
                    write(1, source + ns, nl)
                    write(1, ":\n", 2)
                    ir_lower_function(wchild)
                    ir_dump()
                    write(1, "\n", 1)
                }
            }
            uint32 nxt = ast_next(wchild)
            wchild = nxt
        }
        // Print summary
        uint8[64] nb
        uint64 tl = fmt_uint(nb, tcount)
        write(1, nb, tl)
        write(1, " tokens, ", 9)
        uint64 nl2 = fmt_uint(nb, ast_count)
        write(1, nb, nl2)
        write(1, " nodes -> IR dump\n", 18)
        exit(0)
    }

    // Emit headers based on format (skip for .o — code goes at offset 0)
    uint64 header_size = 120
    if emit_mode == 0 {
        // ELF
        if arch == 0 {
            emit_elf_header()
        } else if arch == 1 {
            emit_elf_header_a64()
        } else if rv_raw != 0 {
            // riscv32 --freestanding: raw flat binary. No container
            // header at all — out_buf starts with the first instruction
            // and QEMU's `virt -bios` loader jumps to file offset 0.
            header_size = 0
        } else if arch == 2 {
            // riscv32 hosted: Elf32 executable header + program header.
            emit_elf_header_rv32()
            header_size = 84
        } else if xt_raw != 0 {
            if machine_target == 1 {
                // xtensa --freestanding --target=esp32: no container header at
                // all — the flat blob starts with the first code byte (file
                // offset == IRAM offset) and the esp-image container is
                // assembled around it at finalize (esp32 branch of the xt_raw
                // block below) via format_espimage.kr.
                header_size = 0
            } else {
                // xtensa --freestanding: Elf32 boot image. qemu-system-xtensa
                // -M lx60 -kernel loads by program header and jumps to e_entry, so
                // (unlike riscv's raw -bios blob) this needs a real ELF container.
                // Finalized (e_entry/p_filesz/p_memsz patch) in the xt_raw block
                // below, which self-contains the whole arch-3 image path.
                emit_elf_header_xtensa()
                header_size = 84
            }
        } else if arch == 3 {
            xtensa_nyi("ELF image emission")
        }
        if arch == 0 || arch == 1 {
            emit_program_header(0)
        } else if arch == 2 && rv_raw == 0 {
            emit_program_header_rv32(0)
        } else if xt_raw != 0 && machine_target == 0 {
            emit_program_header_xtensa(0)
        }
    } else if emit_mode == 1 {
        // Mach-O
        if arch == 0 {
            header_size = emit_macho_headers_x64(0)
        } else if arch == 1 {
            header_size = emit_macho_headers_a64(0)
        } else {
            riscv32_nyi("Mach-O image emission")
        }
    } else if emit_mode == 2 {
        // PE
        if arch == 0 {
            header_size = emit_pe_headers_x64(0)
        } else if arch == 1 {
            header_size = emit_pe_headers_a64(0)
        } else {
            riscv32_nyi("PE image emission")
        }
    } else if emit_mode == 3 || emit_mode == 7 {
        // ELF relocatable (.o) or LKM (.ko) — no header at start,
        // code goes at offset 0. LKM gets additional sections wrapped
        // after the .text + .data blob (.modinfo, struct module, etc).
        header_size = 0
    } else if emit_mode == 4 {
        // Android PIE ELF (ARM64 or x86_64)
        if arch == 0 {
            emit_elf_header_android_x86_64()
        } else if arch == 1 {
            emit_elf_header_android_a64()
        } else {
            riscv32_nyi("Android image emission")
        }
        header_size = 1024
    } else if emit_mode == 5 {
        // ASM listing — no header, code at offset 0
        header_size = 0
    } else if emit_mode == 8 {
        // --emit=image: raw headerless flat binary. header_size = 0 FROM THE
        // START — the rv_raw shape (:2423-2427) — never truncation of an
        // emitted ELF. a64_compute_va maps file offset -> 0x400000 + offset
        // (codegen_aarch64.kr:6228) and the ADRP page arithmetic is baked
        // from that map, so chopping a 0x78-byte header off a finished ELF
        // shifts every offset by a non-page amount and leaves every baked
        // page_off 0x78 too large — the image boots to SILENCE at any
        // page-aligned address. With header_size = 0 the map is
        // self-consistent (file offset 0 IS the load address) and the runtime
        // constraint collapses to load_addr % 4096 == 0, which the arm64 arm
        // of the flag validation already enforces; x86_64 is RIP-relative
        // throughout and needs no constraint at all.
        //
        // Being exact about what this line does TODAY: header_size is read
        // only by the emit_mode 0/1/2 finalize arms (:3107, :3140, :3243,
        // :3301, :3313), none of which emit_mode 8 reaches, so the assignment
        // is currently inert. It is here because the value is a fact about
        // this format, not a computation: the moment anything shared starts
        // consuming header_size, an image that still claimed 120 would be
        // wrong in the direction that produces a silent boot rather than a
        // diagnostic.
        //
        // IT STAYS 0 EVEN WHEN --image-header PREFIXES 64 BYTES (sub-project
        // C, Task 2), and that is not an oversight. What header_size means on
        // this path is "how far the load address is from file offset 0", and
        // an arm64 Image header is LOADED — it lives at load_addr like every
        // other byte of the file, exactly as x86_64's multiboot header does
        // (which is also emitted at offset 0 and also leaves this 0). The
        // value that would be wrong is 64: it would say the map starts 64
        // bytes in, and the ADRP page arithmetic is baked straight off
        // a64_compute_va(file_offset), which knows nothing about headers.
        //
        // An earlier revision of this comment ended "the correctness of the
        // emission rests on no header bytes having been emitted, which is why
        // the branch above this one is empty of emit_* calls". That is no
        // longer true of emit_mode 8 as a whole — the --image-header block
        // below emits 64 — and it was never what the correctness rested on.
        // It rests on file offset 0 being the load address, which a prefix
        // emitted BEFORE codegen preserves and a prefix glued on AFTERWARDS
        // destroys. This branch is still empty of emit_* calls because
        // nothing unconditional belongs here, not because nothing may.
        header_size = 0
    } else if emit_mode == 9 {
        // --emit=uefi: a PE32+ EFI application (sub-project D).
        //
        // THIS ARM RESERVES THE HEADER REGION; TASK 2 FILLS IT. What is
        // emitted here today is 4096 zero bytes, and the reason the SIZE
        // lands in Task 1 rather than with the fields is that the size is
        // not a formatting choice — it is a correctness constraint on the
        // PAYLOAD, and the payload is emitted immediately after this line.
        //
        // C1, THE PAGE-CONGRUENCE CONSTRAINT. a64_compute_va maps a file
        // offset to 0x400000 + offset (codegen_aarch64.kr) with no notion of
        // a container, and every arm64 ADRP page computation is baked from
        // that map DURING codegen. A PE loader does not map the file that
        // way: the payload lands at ImageBase + SectionRVA + (file_offset −
        // PointerToRawData). The two agree on page boundaries — which is all
        // ADRP needs, since 0x400000 is itself page-aligned — exactly when
        //
        //     (SectionRVA − PointerToRawData) % 4096 == 0
        //
        // This tree takes the strongest form of that: PointerToRawData ==
        // SectionRVA == 0x1000, delta 0, so file offset == RVA for every byte
        // in the artifact including the headers. The tempting alternative —
        // the customary 0x200 file alignment with the section at RVA 0x1000 —
        // gives a delta of 0xE00 and is the value the derivation reference
        // prescribes. MEASURED: pad 0x200 -> the image LOADS AND FAULTS; pad
        // 0x1000 -> runs; pad 0 -> runs. It exits 0, file(1) still calls the
        // result an EFI application, and every static field assertion still
        // passes, so nothing but a real boot witnesses it.
        //
        // x86_64 is immune (RIP-relative throughout) and is held to the same
        // geometry anyway: one layout, one set of patch offsets, and no arch
        // where a wrong delta is survivable enough to go unnoticed.
        //
        // EMITTED BEFORE THE FUNCTION EMIT LOOP, like the arm64 Image header
        // and the x86_64 multiboot stub, and for the same reason: that is
        // what re-bakes the page arithmetic AROUND the prefix in one step.
        // A 4096-byte region glued on afterwards would leave every baked
        // page_off one page stale while the data it points at had moved.
        //
        // header_size carries the mode 0/1/2/4 meaning here — bytes emitted
        // before text_start — and NOT the mode 8 meaning ("how far the load
        // address is from file offset 0"), because unlike a flat image this
        // format really does have a container in front of the code. Nothing
        // reads it on this path today; Task 2's PointerToRawData is the value
        // it exists to be.
        while codegen_output_len() < 4096 { emit_byte(0) }
        header_size = 4096
    }

    uint64 text_start = codegen_output_len()

    // ------------------------------------------------------------------
    // The arm64 Linux `Image` header (sub-project C, Task 2, spec D5).
    //
    // 64 bytes at file offset 0, EMITTED BEFORE THE FUNCTION EMIT LOOP, and
    // that ordering is the entire design. a64_compute_va maps a file offset
    // to 0x400000 + offset with no notion of a header
    // (codegen_aarch64.kr:6214), and every ADRP page computation is baked
    // from that map DURING codegen. Emitting the prefix first therefore moves
    // the payload and re-bakes the page arithmetic around it in one step, with
    // no VA-map change and not one line in codegen_aarch64.kr. Glue the same
    // 64 bytes on afterwards instead and every baked page_off is 64 too small
    // while the data it points at has moved: the image boots to SILENCE, which
    // is the identical failure mode the header_size = 0 note above describes
    // for a post-hoc ELF strip. The only invariant this relies on is
    // load_addr % 4096 == 0, enforced at the arm64 arm of the --load-addr
    // validation, and a 64-byte prefix cannot disturb it.
    //
    // THIS IS THE SAME SLOT x86_64's MULTIBOOT HEADER USES, deliberately: two
    // boot headers, two arches, one position in the pipeline, so neither can
    // acquire an ordering the other lacks. They are mutually exclusive by
    // arch, so nothing at offset 0 is ever written twice.
    //
    // TWO FIELDS CANNOT BE WRITTEN HERE, not one. `code0` needs the stub's
    // file offset and no function has been emitted yet; `image_size` needs the
    // final file size and nothing has been laid out yet. Both are patched
    // back below at the point their value first exists — code0 right after the
    // stub is emitted, image_size in the emit_mode 8 finalize block. BOTH
    // PLACEHOLDERS ARE ZERO ON PURPOSE, matching the multiboot header's
    // entry_addr: an unpatched code0 of 0x00000000 is `udf #0`, an undefined
    // instruction that faults on the first word of the image. The tempting
    // placeholder — 0x14000000, `b .` — would instead HANG, silently, and
    // would put a second 0x14000000 in the file, which is the stub's halt
    // word and the thing the boot gate's loop_offset_a64 uniqueness scan
    // reads a PC through in five checks. Loud beats quiet; a placeholder that
    // is also a valid instruction is the worst of both.
    //
    // WHAT THESE 64 BYTES ARE, AND ARE NOT, BACKED BY (sub-project C, Task 4).
    // Anyone changing a field below should know which ones anything reads:
    //
    //   * TWO ORACLES EXIST AND NO OTHERS — file(1)
    //     (imghdr_file_recognises_image, tests/run_tests.sh) and a real
    //     `qemu -M virt -cpu cortex-a57 -kernel` boot (leg L6 of
    //     tests/target_none/boot_gate.sh). QEMU reads magic, text_offset and
    //     image_size; file(1) reads magic and flags bits 0 and 1-2. code1,
    //     res2-res5 and the EMITTED flags VALUE are read by nothing. Bit 3 in
    //     particular has no oracle at all, measured in isolation twice: 0xA
    //     vs 0x2 and 0x8 vs 0x0 each differ in bit 3 ALONE and each give an
    //     identical file(1) line AND an identical parked PC. (0x8 vs 0xA is
    //     NOT that experiment — it also drops bits 1-2 and file(1) does
    //     notice, losing the "4K pages" clause. Task 4 wrote the sloppy
    //     version of this sentence first and its own re-measurement caught
    //     it.) The static rows assert what this block WROTE and cannot
    //     assert that anything cares.
    //   * THE LOAD-BASE EVIDENCE IS QEMU'S load_aarch64_image, NOT THE Image
    //     SPECIFICATION. It shows the header is READ. Nothing in this tree
    //     shows it is CONFORMANT, and NO REAL BOOT CHAIN HAS EVER RUN IT —
    //     no U-Boot booti, no EFI stub, no Android boot.img, no hardware.
    //     One QEMU 8.2.2 on one machine is the whole of it. Not "never in
    //     CI": the boot gate is a counted test in tests/run_tests.sh and ran
    //     green in CI at this work's branch point. It is the two header legs
    //     (L5, L6) that are newer than that run and so CI-unrun until the
    //     first push. See the CI STATUS block in boot_gate.sh's header.
    //   * A BAD MAGIC IS NOT REFUSED. QEMU silently abandons the header and
    //     loads at its own default offset, and the payload is
    //     position-independent, so the image still boots and still prints.
    //     Only file(1) and a 0x40080000-vs-0x40200000 shift in load base ever
    //     witness the magic.
    //   * text_offset = 0 PLUS flags BIT 3 IS A CHOICE NOTHING HERE VALIDATES
    //     (spec open question 3, disposed of rather than left open). Current
    //     kernel documentation describes text_offset as legacy and the
    //     2 MiB-relative placement as declared through flags bit 3, which is
    //     what this writes. MEASURED: QEMU honours text_offset VERBATIM
    //     (0x300000 -> base 0x40300000, +2 MiB bump only below 4 KiB), i.e.
    //     it does not treat the field as legacy. Which of the two a modern
    //     loader actually honours is UNVERIFIED and cannot be settled here —
    //     exactly one loader has ever been tried. Writing 0 is the value that
    //     is correct under either reading; that is why it is safe, not
    //     because the question was answered.
    //
    // GATED ON emit_mode/arch/flag, NEVER ON target_os — same reasoning as
    // both stubs below: per-OS dispatch in this codebase is "special-case
    // Windows/macOS, ELSE fall through to POSIX", so a bare-metal condition
    // phrased as an OS test is the shape that silently inherits Linux. The
    // three conditions are redundant with the flag validation (which already
    // refuses --image-header without --arch=arm64, --emit=image and
    // --stack-top=) and are spelled out anyway, so that this block reads as
    // its own statement of when a header exists rather than as a consequence
    // of a check 3000 lines away. No --image-header => no bytes => every
    // existing image pin holds unchanged.
    uint64 a64hdr_on = 0
    if img_raw != 0 && arch == 1 && image_header_set != 0 {
        a64hdr_on = 1
        emit_a64(0)                 // 0:  code0 — b <stub>, PATCHED below
        emit_a64(0)                 // 4:  code1
        emit_u64_le(0)              // 8:  text_offset — 0 = "load anywhere"
        emit_u64_le(0)              // 16: image_size — PATCHED at finalize
        emit_u64_le(10)             // 24: flags — 0xA: LE, 4 KB pages, anywhere
        emit_u64_le(0)              // 32: res2
        emit_u64_le(0)              // 40: res3
        emit_u64_le(0)              // 48: res4
        emit_u32_le(0x644d5241)     // 56: magic — "ARM\x64"
        emit_u32_le(0)              // 60: res5
    }

    // ------------------------------------------------------------------
    // The x86_64 entry stub, PART 1 OF 2: the bytes (sub-project B2, D6).
    //
    // WHY THIS ONE IS PREPENDED AND arm64's IS APPENDED. A multiboot header
    // must lie entirely within the FIRST 8192 BYTES of the file, and it is
    // the header -- not a reset vector -- that tells the loader where to
    // enter. Appending the stub the way Task 3 does on arm64 would work for
    // small images and then fail on the first program that grew past 8 KiB,
    // by the loader simply not finding a header: a silent boot, not a
    // diagnostic. So the stub goes at file offset 0 and the payload shifts
    // by its length. Everything x86 emits into an image is RIP-relative or
    // fixed up from out_len, so a uniform shift of the code region is
    // invisible to it (asserted byte-for-byte by stub_x86_entry_movabs_*).
    //
    // ONE VALUE CANNOT BE WRITTEN HERE: the entry function's address. No
    // function has been emitted yet, so fn_lookup has nothing to answer
    // with. emit_x86_image_stub publishes the movabs's file offset in
    // x86stub_entry_site and PART 2 -- after the emit loop, before fixup
    // resolution, exactly where Task 3 puts arm64's `bl` patch -- writes it.
    // Left unwritten it is a `call *%rax` to 0, i.e. a triple fault with no
    // diagnostic anywhere, which is what stub_x86_multiboot_header's
    // "movabs carries 0" clause exists to catch.
    //
    // GATED ON emit_mode/arch/flag, NEVER ON target_os -- same reasoning as
    // the arm64 stub below: the per-OS dispatch in this codebase is
    // "special-case Windows/macOS, ELSE fall through to POSIX", so a
    // bare-metal condition phrased as an OS test is the shape that silently
    // inherits Linux. No --stack-top => no stub => bytes unchanged.
    uint64 x86_stub_on = 0
    if img_raw != 0 && arch == 0 && stack_top_set != 0 {
        x86_stub_on = 1
        emit_x86_image_stub(load_addr, stack_top)
    }

    // Raw flat binary: QEMU's -bios loader begins execution at
    // 0x8000_0000 = byte offset 0 of the image, so the entry function
    // must be the FIRST thing emitted, ahead of source order. Emission
    // order is otherwise free — calls resolve through the fixup table
    // (resolve_fixups_riscv patches the auipc+jalr pairs after every
    // function is registered), so hoisting the entry cannot break call
    // resolution. Entry = a live `_start` if one exists, else `main`.
    // Chosen over a `jal x0, entry` trampoline: zero extra bytes, no
    // new fixup kind, and no ±1 MiB jal range limit to worry about.
    uint64 rv_entry_node = 0
    if rv_raw != 0 {
        rv_entry_node = find_entry_node(root)
        if rv_entry_node == 0 {
            uint64 rve_msg = "error: freestanding riscv32 needs an entry function ('_start' or 'main')\n"
            write(2, rve_msg, str_len(rve_msg))
            exit(1)
        }
        uint32 rve_ename = ast_data1(rv_entry_node)
        uint64 rve_wen = rve_ename
        // Boot preamble FIRST: QEMU virt -bios enters at offset 0 with
        // sp = 0, so set sp = 0x8020_0000 (see rv_emit_raw_sp_preamble)
        // before the entry function's prologue touches the stack. The
        // entry is then registered at offset 8 and execution falls
        // through into it. Raw-mode/arch==2-only by construction —
        // x86/arm64 never reach this block.
        rv_emit_raw_sp_preamble()
        fn_register(rve_wen, out_len)
        line_table_record_fn_entry(rve_wen)
        ir_init()
        ir_riscv_gen(rv_entry_node)
    }

    // Xtensa freestanding: select the entry function (a live `_start` if one
    // exists, else `main`) and pass it to ir_xtensa_gen so it emits the SP-init
    // preamble as that function's first code (Task 8 Step 3). Held in a local and
    // threaded as a parameter — like riscv's rv_entry_node — rather than a
    // cross-file global in ir_xtensa.kr, so the reference resolves under both the
    // concatenated and import builds. Unlike riscv, the entry is NOT hoisted to
    // offset 0 — e_entry is patched to its code_start (past the pool) in the
    // xt_raw finalize block, so emission order stays free (calls resolve through
    // the fixup table). Arch-3 + raw-only by construction: xt_entry_node stays 0
    // on every other path.
    uint64 xt_entry_node = 0
    if xt_raw != 0 {
        xt_entry_node = find_entry_node(root)
        if xt_entry_node == 0 {
            uint64 xte_msg = "error: freestanding xtensa needs an entry function ('_start' or 'main')\n"
            write(2, xte_msg, str_len(xte_msg))
            exit(1)
        }
        // Assign the __xt_pcbase name token BEFORE the emit loop so every
        // `call0 __xt_pcbase` fixup recorded during PIC emission carries the
        // right token. The helper body itself is emitted conditionally in the
        // finalize block below (only when a PIC site exists).
        xt_setup_pcbase_tok()
    }

    // Generate code for each function (skip dead functions via DCE)
    uint32 child = ast_child(root)
    uint64 wchild = child
    while wchild != 0 {
        uint32 ck = ast_kind(wchild)
        if ck == 2 {
            uint32 fn_name = ast_data1(wchild)
            if dce_is_live(fn_name) != 0 {
                if emit_ir_mode != 0 && arch == 0 && emit_mode != 3 && emit_mode != 7 {
                    // IR codegen (skip for --emit=obj and --emit=lkm; both
                    // need legacy codegen for extern relocations)
                    fn_register(fn_name, out_len)
                    // Record a DWARF line-table entry at the function's
                    // entry address so GDB can correlate `break <name>`
                    // with the first source line.
                    line_table_record_fn_entry(fn_name)
                    ir_init()
                    ir_emit_x86_function(wchild)
                } else if emit_ir_mode != 0 && arch == 1 && emit_mode != 3 && emit_mode != 7 {
                    // IR codegen ARM64 (default; --legacy + --emit=obj/lkm bypass)
                    fn_register(fn_name, out_len)
                    line_table_record_fn_entry(fn_name)
                    ir_init()
                    ir_emit_arm64_function(wchild)
                } else if arch == 2 {
                    // RISC-V RV32IMC — IR-only backend, no legacy codegen
                    // path exists, so this branch is unconditional on
                    // emit_ir_mode (mirrors where arch==1 calls
                    // ir_emit_arm64_function above).
                    // Extern declarations (data4 bit 3) have no body — skip
                    // codegen so no local stub/symbol is emitted; the call
                    // site records an R_RISCV_CALL_PLT relocation instead
                    // (mirror of gen_function/gen_function_a64's extern
                    // early-return, codegen.kr:10028 / codegen_aarch64.kr:5408).
                    uint32 rv_ann_flags = ast_data4(wchild)
                    uint64 rv_is_extern = rv_ann_flags & 8
                    // Raw mode already emitted the entry function at
                    // offset 0 above — don't register/emit it twice.
                    if rv_is_extern == 0 && wchild != rv_entry_node {
                        fn_register(fn_name, out_len)
                        line_table_record_fn_entry(fn_name)
                        ir_init()
                        ir_riscv_gen(wchild)
                    }
                } else if arch == 0 {
                    // Legacy x86: gen_function registers internally.
                    // Record the entry-address line first so DWARF sees it.
                    line_table_record_fn_entry(fn_name)
                    gen_function(wchild)
                } else if arch == 3 {
                    // Xtensa LX6 — IR-only backend. Unlike the riscv arch-2
                    // branch, do NOT pre-register the function here:
                    // ir_xtensa_gen registers it itself at code_start (past
                    // its literal pool), so the recorded entry is the code,
                    // not the pool. Extern declarations have no body — skip.
                    uint32 xt_ann_flags = ast_data4(wchild)
                    uint64 xt_is_extern = xt_ann_flags & 8
                    if xt_is_extern == 0 {
                        ir_init()
                        ir_xtensa_gen(wchild, xt_entry_node)
                    }
                } else {
                    // Legacy ARM64: gen_function_a64 registers internally.
                    line_table_record_fn_entry(fn_name)
                    gen_function_a64(wchild)
                }
            }
        }
        uint32 nxt = ast_next(wchild)
        wchild = nxt
    }

    // ------------------------------------------------------------------
    // The arm64 entry stub (sub-project B2, D2). Opt-in via --stack-top=.
    //
    //     movz x0, #sp[31:16], lsl 16
    //     movk x0, #sp[15:0]
    //     mov  sp, x0
    //     bl   <entry>
    //     b    .                        <- the halt
    //
    // WHY: at reset SP is garbage, so the entry function's own prologue
    // faults on its first stack store and the image boots to silence. Until
    // now a hand-written external stub (tests/target_none/boot/make_stub.py)
    // supplied the stack; with this block the image is self-sufficient.
    //
    // WHERE THIS SITS IS LOAD-BEARING, IN BOTH DIRECTIONS.
    //
    //   * AFTER the emit loop, so no function moves. The stub is appended to
    //     the code region, which means the entry function keeps the exact
    //     offset it has with the flag absent. (Emitting at offset 0 would
    //     work too — the `bl` removes any adjacency requirement — but it
    //     would shift every function and every derived-from-the-report gate
    //     control with them.)
    //   * BEFORE `resolve_fixups_a64()` (the "Resolve call fixups" block
    //     below), because that is what patches the `bl`. Emitted after it,
    //     the placeholder `BL #0` survives — and `BL #0` is not a crash or a
    //     diagnostic, it is a well-formed BRANCH TO ITSELF. The image would
    //     compile, disassemble and report perfectly and hang on the stub's
    //     fourth word. Nothing downstream would notice.
    //
    // The stub is FULLY PC-RELATIVE and materialises no address: `bl` and
    // `b` are both PC-relative, x30 is set by the hardware, and the only
    // immediate is the stack top the user passed. --load-addr is echoed in
    // the report and never embedded (image_load_addr_not_embedded_arm64).
    //
    // THIS STUB DESTROYS x0, AND UNDER --image-header THAT LOSES THE DEVICE
    // TREE (sub-project C, Task 4 — recorded, deliberately NOT fixed here).
    // The arm64 Linux boot protocol requires a loader to enter the image with
    // x0 = the physical address of the FDT. The movz/movk pair below writes
    // the stack top into x0 as its FIRST instruction, before anything can
    // save it, so a real loader's FDT pointer is gone before one line of
    // KernRift runs and nothing in the language can recover it. This is a
    // LIVE gap, not a hypothetical, and it was MEASURED rather than inferred:
    // patch code0 to branch straight to the stub's halt (skipping these three
    // instructions) and a plain `qemu -M virt -cpu cortex-a57 -kernel` boot
    // parks with x0 = 0x44000000, whose first guest word is 0xd00dfeed — the
    // FDT magic. The SAME image unpatched parks with x0 = 0 and sp = the
    // stack top. So the pointer is handed over on every boot in the gate and
    // thrown away by the first instruction. It is also why
    // B2's already-documented "the first parameter is the stack top" quirk is
    // worse than a curiosity here — x0 is not free to use, it is spoken for
    // by the protocol the header opts into. Fixing it means picking another
    // scratch register (x9-x15 are all free at entry) and defining how a
    // program asks for the FDT; both are out of scope for C.
    //
    // GATED ON emit_mode/arch/flag, NEVER ON target_os. The per-OS dispatch
    // here is "special-case Windows/macOS, ELSE fall through to POSIX", so a
    // bare-metal condition written as an OS test is the shape that silently
    // inherits Linux. img_raw is emit_mode 8 or 9 (--emit=image / --emit=uefi,
    // see its declaration); this block additionally requires stack_top_set,
    // which is refused outside --emit=image, so only mode 8 can reach it.
    //
    // THE CLAUSE THAT USED TO SIT HERE — "img_raw is emit_mode == 8 and has no
    // fall-through" — WAS FALSE IN BOTH HALVES. The set was widened by
    // sub-project D; and the emit_mode chains DO fall through, in three
    // separate places (the header dispatch, this file's finalize dispatch, and
    // img_raw itself), each of which produces an artifact at exit 0 with no
    // diagnostic. That was the whole hazard D Task 1 was written against, so
    // the sentence is corrected here rather than left standing next to the
    // change that falsified it.
    //
    // stack_top_set is the D4 opt-in (absent => no stub => bytes unchanged);
    // arch == 1 is arm64. x86_64 has its own, differently-shaped stub — the
    // multiboot header + long-mode trampoline emitted at PART 1 above, which
    // is PREPENDED rather than appended, hence two blocks and not one.
    // "A stub was emitted, and it starts at img_stub_off." Two variables and
    // not one sentinel value ON PURPOSE: the finalize block that consumes this
    // also holds `entry_off`, whose OWN 0xFFFFFFFF means "fn_lookup found no
    // such function", and `entry_off = img_stub_off` would then sit four lines
    // from an `entry_off == 0xFFFFFFFF` test meaning something else entirely.
    // img_stub_set is the same idiom as stack_top_set/load_addr_set: presence
    // is a separate fact from value, and 0xFFFFFFFF is already spoken for by
    // fn_lookup and find_main_offset. img_stub_off is meaningless while
    // img_stub_set is 0.
    uint64 img_stub_off = 0
    uint64 img_stub_set = 0
    if img_raw != 0 && arch == 1 && stack_top_set != 0 {
        uint64 stb_node = find_entry_node(root)
        if stb_node == 0 {
            // Same condition the finalize block below refuses on, reached
            // earlier because the stub needs the entry's name token now.
            // Shared with that block through entry_missing_die() so the two
            // arms cannot drift into two diagnostics for one cause.
            entry_missing_die()
        }
        // fn_register stores a function's OWN declaration token, and
        // fn_lookup compares token TEXT, so a fixup recorded against
        // ast_data1(entry_node) resolves exactly like a call the source
        // wrote. (Sub-project A's "a synthesised call cannot resolve"
        // finding is about names the source never spelled; the entry's name
        // is in the source by definition.)
        uint32 stb_tok = ast_data1(stb_node)
        img_stub_off = out_len
        img_stub_set = 1

        // Every subexpression is parenthesised on purpose: in this dialect
        // `&`, `|` and `^` bind TIGHTER than `+` and `<<`, so `a | b << 5`
        // means `(a | b) << 5`.
        uint64 stb_hi = (stack_top >> 16) & 0xFFFF
        uint64 stb_lo = stack_top & 0xFFFF
        uint64 stb_w0 = 0xD2A00000 | (stb_hi << 5)      // movz x0, #hi, lsl 16
        uint64 stb_w1 = 0xF2800000 | (stb_lo << 5)      // movk x0, #lo
        emit_a64(stb_w0)
        emit_a64(stb_w1)
        emit_a64(0x9100001F)                            // mov sp, x0

        // bl <entry>. Placeholder + fixup, the idiom every backend
        // open-codes (there is no record_fixup helper): fixup_table_ensure()
        // then an inline [u32 patch_off][u32 name_tok] write. Mirrors
        // ir_aarch64.kr's IR_CALL.
        uint64 stb_patch = out_len
        emit_a64(0x94000000)                            // BL #0 (placeholder)
        fixup_table_ensure()
        uint64 stb_fe = fixup_table + fixup_count * 8
        uint32 stb_po = stb_patch
        unsafe { *(stb_fe as uint32) = stb_po }
        uint64 stb_fe4 = stb_fe + 4
        unsafe { *(stb_fe4 as uint32) = stb_tok }
        fixup_count = fixup_count + 1

        // The halt: b . — the word after the call, so the PC parks on a
        // known address when the entry returns (D5). Deliberately not `wfi`
        // or a syscall: --target=none has no OS to exit to, and the trap
        // emitters refuse there anyway.
        emit_a64(0x14000000)
    }

    // ------------------------------------------------------------------
    // The Image header's `code0`, PART 2 OF 2 (sub-project C, Task 2).
    //
    // HERE, AND NOT WHERE THE 64 BYTES WERE EMITTED, for the reason the x86
    // trampoline's PART 2 gives twelve lines further down: the value does not
    // exist until the thing it points at has been laid out. img_stub_off is
    // the stub's file offset and is set three lines above this comment, by
    // the block that just emitted it — which is also why this sits here and
    // not with the finalize block: a reader looking for "where does code0 get
    // its target" finds it adjacent to the only assignment that produces one.
    //
    // A MISSED PATCH IS `udf #0` AT OFFSET 0 — a fault on the image's first
    // instruction, not a hang (see the emission block's note on why the
    // placeholder is 0 and not `b .`).
    //
    // TIED TO img_stub_set, NOT TO a64hdr_on ALONE, even though the flag
    // validation makes --image-header imply --stack-top= and therefore imply
    // a stub. If that implication ever loosens, the failure this ordering
    // produces is a header branching to file offset 0 — itself, an infinite
    // loop at the first word — so the dependency is stated rather than
    // inherited.
    if a64hdr_on != 0 && img_stub_set != 0 {
        // `b` takes a SIGNED imm26 of WORDS, ±128 MiB from the branch. The
        // branch is at offset 0 and the stub is at img_stub_off, so the
        // displacement is img_stub_off / 4 and is always positive. It is
        // bounds-checked rather than masked: `& 0x3FFFFFF` on an out-of-range
        // offset does not fail, it BRANCHES SOMEWHERE ELSE IN THE IMAGE, and
        // an image that large is exactly the one nobody would disassemble.
        //
        // WHAT THIS BOUNDS IS THE STUB'S OFFSET, NOT THE FILE. An earlier
        // revision of this comment claimed "the stub is appended after all
        // code and data, so this bounds the whole artifact". That is FALSE
        // for the layout actually emitted: STATIC DATA FOLLOWS THE STUB.
        // Measured twice —
        //   * one-static program: header 0-63, entry fn 64-107, stub 108-127,
        //     static 128-135;
        //   * 64 KiB-static program: stub at 124 in a 65680-byte file, i.e.
        //     65536 bytes of statics sitting entirely past it.
        // So a file may legitimately extend far past img_stub_off, and an
        // image LARGER than 128 MiB is not by itself a refusal. The branch
        // only has to reach the stub, which is exactly what is tested here.
        //
        // UNTESTED, AND SAID PLAINLY. Because statics do not move the stub,
        // firing this needs ~128 MiB of CODE — not a large array, which is
        // the cheap way to grow an image and does nothing here. Nothing in
        // the suite comes near that, so this refusal has only ever been
        // observed NOT firing. It is kept because the alternative failure is
        // a silent wrong branch and a named diagnostic that never fires costs
        // nothing — but it is not evidence of anything, and no row should be
        // read as covering it.
        if img_stub_off > 134217724 {
            uint64 ih_far = "error: --image-header cannot reach the entry stub: the header's first word is a `b` with a signed 26-bit word displacement (+/-128 MiB) and this image places the stub past that. The image is too large to be prefixed with an arm64 Image header\n"
            write(2, ih_far, str_len(ih_far))
            exit(1)
        }
        // Every subexpression parenthesised on purpose: in this dialect `&`,
        // `|` and `^` bind TIGHTER than `+` and `<<`.
        uint64 ih_imm = (img_stub_off >> 2) & 0x3FFFFFF
        patch_u32(0, 0x14000000 | ih_imm)
    }

    // ------------------------------------------------------------------
    // The x86_64 entry stub, PART 2 OF 2: the entry address.
    //
    // HERE, AND NOT WHERE THE BYTES WERE EMITTED, IS THE WHOLE POINT. The
    // trampoline's `movabs $entry,%rax; call *%rax` needs an absolute
    // address that does not exist until every function has been laid out,
    // so the byte emission at text_start left the immediate zero and
    // published its offset. This is the same slot in the pipeline where the
    // arm64 stub's `bl` is resolved (after the emit loop, before the
    // "Resolve call fixups" block) and it fails the same way if skipped:
    // `call *%rax` with rax = 0 is not a fault the compiler can report, it
    // is a triple fault in the guest, and the image compiles, disassembles
    // and reports perfectly on the way there.
    //
    // Not routed through the fixup table like arm64's `bl`: that table
    // resolves PC-RELATIVE call displacements, and this is an absolute
    // 64-bit address. patch_u64 against the captured site is the direct
    // equivalent, and it is the only site in the stub that outlives the
    // emitter.
    if x86_stub_on != 0 {
        uint64 xsb_node = find_entry_node(root)
        if xsb_node == 0 {
            // Shared with the arm64 arm above and the finalize block below,
            // so one cause cannot grow three diagnostics.
            entry_missing_die()
        }
        uint32 xsb_tok = ast_data1(xsb_node)
        uint64 xsb_wtok = xsb_tok
        uint64 xsb_off = fn_lookup(xsb_wtok)
        if xsb_off == 0xFFFFFFFF {
            // find_entry_node only returns functions dce_is_live accepted and
            // the emit loop emits exactly those, so this is an internal
            // inconsistency, not a user error. The finalize block runs the
            // same check; reaching it here first means the CALL would have
            // been wrong even if the report were right.
            uint64 xsx_msg = "error: internal: entry function was selected but never registered in the code image\n"
            write(2, xsx_msg, str_len(xsx_msg))
            exit(1)
        }
        patch_u64(x86stub_entry_site, load_addr + xsb_off)
        // The reported entry is the TRAMPOLINE's first instruction (D2) --
        // the address a loader must jump to, and the same value the
        // multiboot header carries in entry_addr. The entry FUNCTION reached
        // any other way would run with a garbage stack, in 32-bit mode, on a
        // CPU with paging off.
        img_stub_off = x86stub_start32_off
        img_stub_set = 1
    }

    // Xtensa raw mode (Task 3): the whole post-codegen pipeline below
    // (call/string/static fixups, ELF headers, BSS truncation) is still
    // xtensa_nyi. Leaf functions need none of it — write the raw code blob and
    // exit here so objdump can disassemble it. This early-out is arch-3-only,
    // so it cannot perturb arch 0/1/2 output.
    if xt_raw != 0 {
        // H2: emit + register the shared __xt_pcbase helper (a single ret.n)
        // ONCE, here at the FUNCTION BOUNDARY — after ALL functions are laid out,
        // never mid-body from a PIC handler (which would splice bytes into the
        // current function). Gated on xt_addr_fixup_count so a program with NO
        // PIC sites (no string/static/fn-address material — e.g. hello/stress/
        // call.kr) is byte-identical to before: the helper body is emitted
        // exactly once, and only if some PIC site exists. Registered BEFORE
        // resolve_fixups_xtensa so the
        // `call0 __xt_pcbase` sites recorded during emission resolve through the
        // normal fn_lookup path. e_entry patches to the ENTRY fn's own code_start
        // below, so __xt_pcbase's position is immaterial. Anchor offsets + pool
        // words were finalized during each function's own relaxation, so this
        // late emission cannot perturb them.
        if xt_addr_fixup_count > 0 {
            xt_emit_pcbase_fn()
        }
        // Patch call0 targets now — every function is laid out and
        // fn_register recorded each entry offset. This raw early-out returns
        // before the arch-3 fixup branch further down (the string/static/ELF
        // pipeline there is still NYI for xtensa), so resolution must happen
        // here or call0 placeholders would ship unpatched. Same shared
        // fixup_table the riscv/x86/arm64 resolvers consume.
        resolve_fixups_xtensa()

        // Finalize the Elf32 boot image (header emitted at offset 0 above).
        // e_entry = load base 0xd0000000 (cached DRAM window — see
        // codegen_xtensa.kr) + the entry fn's code_start (past its literal pool
        // — RISK #3). fn_lookup on the entry token so a `_start` entry resolves
        // too; the pre-scan proved the entry exists.
        uint32 xt_ename = ast_data1(xt_entry_node)
        uint64 xt_wen = xt_ename
        uint64 xt_entry_code = fn_lookup(xt_wen)
        if xt_entry_code == 0xFFFFFFFF {
            write(2, "error: xtensa: entry function has no code offset\n", 49)
            exit(1)
        }

        // ===== ESP32 (--target=esp32): two-segment esp-image finalize =====
        // The flat blob layout matches the lx60 path except there is no ELF
        // header, so FILE OFFSET == IRAM OFFSET: code (pools + bodies +
        // __xt_pcbase) occupies [0, esp_code_end) and loads at 0x40080400.
        // Byte-addressable data (strings + statics + bss) is laid out AFTER
        // the code in the file but loads as a SEPARATE segment at DRAM
        // 0x3FFB0000 — ESP32 IRAM supports only aligned 32-bit accesses;
        // a single l8ui against a string left in IRAM raises LoadStoreError =
        // silently dead board. Only code and the 4-byte-aligned literal-pool
        // words (read by l32r) stay in IRAM. The pure-file-offset call0/l32r
        // patch math above stays valid because both load bases are == 0 mod 4
        // (the (PC+4)&~3 rounding is identical on file offsets and VAs).
        if machine_target == 1 {
            uint64 esp_code_end = codegen_output_len()
            // DRAM segment file base. Pad to 8 so every in-segment offset has
            // the same alignment at its DRAM VA as in the file (0x3FFB0000 is
            // 8-aligned): the static blob below re-aligns to 8 and
            // STATIC_LOAD/STORE's l32i/s32i trap on unaligned bases.
            while (codegen_output_len() & 7) != 0 { emit_byte(0) }
            uint64 esp_data_file = codegen_output_len()
            emit_string_data()
            while (codegen_output_len() & 7) != 0 { emit_byte(0) }
            uint64 esp_static_file = codegen_output_len()
            emit_static_data()
            uint64 esp_total = codegen_output_len()

            // PIC deltas cross segments here: delta = target VA - anchor VA
            // (anchors run at IRAM base + code offset; data lives at DRAM base
            // + segment offset). The resolver also owns the per-datum
            // guard: any string/static whose VA computes into the IRAM range
            // is a hard compile error, never an emitted image.
            resolve_addr_fixups_xtensa_esp32(esp_data_file, esp_data_file, esp_static_file)

            // Real BSS: drop the data area's trailing zero bytes from the
            // image unconditionally (esp-image carries file data only — no
            // per-segment memsz>filesz — so the entry preamble's zero loop
            // recreates them; no 4 KiB gate here, flash bytes are pure cost).
            // Round the boundary UP to 4: s32i traps on an unaligned base,
            // and rounding up keeps every initialized byte in the image.
            // esp_total is 8-aligned (data base padded to 8 + 8-byte static
            // slots), so the loop's `bltu lo,hi` hits hi exactly.
            uint64 esp_tail = codegen_last_nonzero_end()
            esp_tail = (esp_tail + 3) & ~3
            if esp_tail < esp_data_file { esp_tail = esp_data_file }
            uint64 esp_data_len = esp_tail - esp_data_file
            uint64 esp_data_memsz = esp_total - esp_data_file

            // Segment-layout guard (hard errors, ir_xtensa.kr): code +
            // entry inside IRAM [0x40080400, 0x400A0000), data + bss inside
            // the DRAM window [0x3FFB0000, 0x3FFE0000).
            xt_esp32_check_layout(esp_code_end, esp_data_memsz, xt_entry_code)

            // Patch the entry preamble's .bss zero-loop bounds with DRAM
            // addresses: [base+data_len, base+memsz) — the zeros dropped from
            // the image. (The lx60 path patches 0xd0000000+p_filesz/p_memsz
            // here; the esp32 data segment has its own base.)
            if xt_bss_lo_pool_off != 0 {
                patch_u32(xt_bss_lo_pool_off, XT_ESP32_DRAM_BASE + esp_data_len)
                patch_u32(xt_bss_hi_pool_off, XT_ESP32_DRAM_BASE + esp_data_memsz)
            }

            // Assemble the container (format_espimage.kr): segments ascending
            // by load address (DRAM data first, IRAM code second — esptool's
            // order, our byte-comparability oracle), SKIPPING a zero-length
            // data segment entirely (esptool omits empty sections; an
            // [addr][0] record would break comparability with elf2image).
            uint64 esp_seg_count = 2
            if esp_data_len == 0 { esp_seg_count = 1 }
            esp_image_begin(XT_ESP32_IRAM_BASE + xt_entry_code, esp_seg_count)
            if esp_data_len != 0 {
                esp_image_segment(XT_ESP32_DRAM_BASE, out_buf + esp_data_file, esp_data_len)
            }
            esp_image_segment(XT_ESP32_IRAM_BASE, out_buf, esp_code_end)
            esp_image_finish()

            // Write the container buffer (NOT out_buf — the blob was raw
            // material for the segments). A flash image is data, not a host
            // executable: no set_executable.
            uint64 esp_fd = open_output_or_die(output_path)
            write(esp_fd, esp_image_buf, esp_image_len)
            file_close(esp_fd)
            uint8[64] esnb
            uint64 estl = fmt_uint(esnb, esp_image_len)
            write(1, esnb, estl)
            write(1, " bytes -> ", 10)
            write(1, output_path, str_len(output_path))
            write(1, "\n", 1)
            exit(0)
        }

        patch_u32(24, 0xd0000000 + xt_entry_code)      // Elf32_Ehdr e_entry

        // Data blobs after all code. Strings first (byte-accessed, so no align
        // needed). Then the static blob: STATIC_LOAD/STORE use `l32i/s32i base,0`
        // and LX6 traps on an unaligned l32i base, so [M-2] align out_len to 8
        // (matching the arm64 static rule below) BEFORE emit_static_data so
        // data_start — and thus every 8-byte static slot — is word-aligned.
        // Record both bases and patch each PIC site's delta pool word: STR_CONST
        // sites against str_start (table_sel 0), STATIC_* sites against data_start
        // (table_sel 1). (BSS truncation is handled by codegen_last_nonzero_end
        // for p_filesz below — trailing zero-init static bytes drop from the file.)
        uint64 xt_str_start = codegen_output_len()
        emit_string_data()
        while (codegen_output_len() & 7) != 0 { emit_byte(0) }
        uint64 xt_data_start = codegen_output_len()
        emit_static_data()
        resolve_addr_fixups_xtensa(xt_str_start, xt_data_start)

        uint64 xt_total = codegen_output_len()
        // [M-4] Real BSS: drop the trailing zero fill from uninitialised static
        // arrays out of the FILE when the gap is worth a page, exactly like the
        // riscv path (main.kr BSS gate): p_filesz = last-nonzero-end, p_memsz =
        // full image, and physically truncate the output. p_memsz > p_filesz is
        // the layout the entry preamble's zero-loop / a real loader relies on.
        // Below the 4 KiB threshold the zeros stay in-file (p_filesz == p_memsz,
        // no gap) — matches the riscv >= 4096 gate byte-for-byte.
        uint64 xt_filesz = xt_total
        uint64 xt_tail = codegen_last_nonzero_end()
        // Round the file/BSS boundary UP to 4 bytes. The preamble's zero loop
        // starts its s32i stores at 0xd0000000 + p_filesz, and LX6 s32i TRAPS on
        // an unaligned base — so p_filesz MUST be word-aligned or the very first
        // store faults at boot. Rounding UP (never down) keeps every initialized
        // byte in the file: the up-to-3 bytes below the boundary are the last
        // live word's own trailing zeros. (The riscv/x86 paths need no alignment
        // — their ELF loader zero-fills [p_filesz,p_memsz); Xtensa freestanding
        // has no loader, so the preamble owns the gap and inherits the s32i
        // alignment rule.) xt_total is already 8-aligned, so hi-lo stays a
        // multiple of 4 and the loop's `bltu a8,a9` hits a9 exactly.
        xt_tail = (xt_tail + 3) & ~3
        uint64 xt_bss = xt_total - xt_tail
        if xt_bss >= 4096 {
            codegen_truncate(xt_tail)
            xt_filesz = xt_tail
        }
        patch_u32(68, xt_filesz)                         // Elf32_Phdr p_filesz
        patch_u32(72, xt_total)                          // Elf32_Phdr p_memsz
        // [M-4] Patch the two pool words the entry preamble's .bss-zeroing loop
        // loads: lo = 0xd0000000 + p_filesz (loop start), hi = 0xd0000000 +
        // p_memsz (loop end). Load base is 0xd0000000 (DRAM window). Both offsets
        // are code-region (< xt_tail), so codegen_truncate never touches them.
        // Guard on the entry fn having reserved them (always true under
        // --freestanding, where xt_entry_node selects an entry fn); a hosted xtensa
        // build with no entry preamble leaves them 0 and skips the patch.
        if xt_bss_lo_pool_off != 0 {
            patch_u32(xt_bss_lo_pool_off, 0xd0000000 + xt_filesz)
            patch_u32(xt_bss_hi_pool_off, 0xd0000000 + xt_total)
        }

        codegen_write_output(output_path)
        set_executable(output_path)
        uint8[64] xnb
        uint64 xtl = fmt_uint(xnb, codegen_output_len())
        write(1, xnb, xtl)
        write(1, " bytes -> ", 10)
        write(1, output_path, str_len(output_path))
        write(1, "\n", 1)
        exit(0)
    }


    // Resolve call fixups
    if arch == 0 {
        resolve_fixups()
        resolve_fnaddr_fixups()
    } else if arch == 1 {
        resolve_fixups_a64()
        resolve_fnaddr_fixups_a64()
    } else if arch == 2 {
        // riscv32: patch the auipc+jalr call pairs (ir_riscv.kr), then the
        // fn_addr() auipc+addi pairs (resolve_fnaddr_fixups_riscv). Both
        // resolve CODE offsets and must run here — after every function is
        // laid out — NOT down with the string/static resolvers below, which
        // wait on the data-area base offsets these two never need.
        resolve_fixups_riscv()
        resolve_fnaddr_fixups_riscv()
    } else if arch == 3 {
        // xtensa: patch the call0 sites (ir_xtensa.kr). fn_addr() pool
        // address-literals are a later task, so no resolve_fnaddr here yet.
        resolve_fixups_xtensa()
    }

    // Emit string data BEFORE static data so trailing zero bytes from
    // uninitialised static arrays end up at the tail of the file — the
    // BSS optimisation below can then truncate them. (Ordering affects
    // only byte layout; resolve_*_fixups is called with its start
    // offset so either order works.)
    // Align to 8 bytes on arm64 first so the 64-bit LDR (imm12 scaled
    // by 8) can encode any slot offset exactly — without padding, a
    // static at a non-8-aligned offset silently rounds down and reads
    // trailing code bytes instead of its own value.
    if arch == 1 {
        while (codegen_output_len() & 7) != 0 { emit_byte(0) }
    } else if arch == 2 {
        // riscv32: 4-byte alignment (RV32 word loads / instruction
        // alignment) — deliberately NOT the arm64 8-byte rule above.
        while (codegen_output_len() & 3) != 0 { emit_byte(0) }
    } else if arch == 3 {
        // xtensa: 4-byte alignment (instruction-fetch alignment).
        while (codegen_output_len() & 3) != 0 { emit_byte(0) }
    }
    uint64 str_start = codegen_output_len()
    emit_string_data()
    if arch == 0 {
        resolve_string_fixups(str_start)
    } else if arch == 1 {
        resolve_string_fixups_a64(str_start)
    } else if arch == 2 {
        // riscv32: patch each IR_STR_CONST pcrel auipc+addi pair to point
        // at str_start + str_offset (ir_riscv.kr). Sites were already
        // remapped through C-compression, and the string blob now exists.
        resolve_string_fixups_riscv(str_start)
    } else if arch == 3 {
        xtensa_nyi("fixup resolution")
    }
    // Align the static-data section base to 8 bytes on both arches.
    // Without this, static uint64[N] arrays whose logical offset within
    // the section is 0 land on whatever bit-level offset the preceding
    // strings/code happened to end on — and a mis-aligned `uint64*`
    // breaks the Linux futex uaddr check (EINVAL) and AMD split-lock
    // detection on newer kernels.
    while (codegen_output_len() & 7) != 0 { emit_byte(0) }
    while (codegen_output_len() & 7) != 0 { emit_byte(0) }
    uint64 data_start = codegen_output_len()
    emit_static_data()
    // For LKM output (emit_mode 7), DON'T bake static-var displacements
    // here — static vars live in a separate .data section that loads at
    // an independent kernel address, so the refs need R_X86_64_PC32
    // relocations (emitted by emit_elf_lkm) instead. The kernel module
    // loader also rejects PC32 relocations whose target field is
    // nonzero ("Invalid relocation target, existing value is nonzero"),
    // so the disp32 placeholders must stay 0. String-literal fixups are
    // still resolved (they're intra-.text and position-independent).
    if emit_mode != 7 {
        if arch == 0 {
            resolve_static_fixups(data_start)
        } else if arch == 1 {
            resolve_static_fixups_a64(data_start)
        } else if arch == 2 {
            // riscv32: patch each IR_STATIC_ADDR/LOAD/STORE pcrel
            // auipc+addi pair to point at data_start + data_offset
            // (ir_riscv.kr). Sites were already remapped through
            // C-compression, and the static-data segment now exists.
            resolve_static_fixups_riscv(data_start)
        } else if arch == 3 {
            xtensa_nyi("fixup resolution")
        }
    }

    uint64 text_size = codegen_output_len() - text_start

    // For .o relocatable, pick format from target_os:
    //   0 linux  → ELF
    //   1 macOS  → Mach-O
    //   2 win    → COFF (PE object)
    //   3 android → ELF
    //   4 none (bare metal) → ELF. Said "freebsd" until --target=none took
    //     the value; there is no freebsd target and never was. ELF is right
    //     for bare metal too -- a freestanding .o is an ELF relocatable and
    //     a64_compute_va's Linux fall-through hands out the same 0x400000
    //     base the freestanding ELF emitter uses.
    if emit_mode == 3 {
        uint64 total_code = codegen_output_len()
        if arch == 2 {
            // riscv is Linux-ELF only — bypass the target_os Mach-O/COFF split.
            emit_elf_relocatable_rv32(total_code, 0)
        } else if arch == 3 {
            xtensa_nyi("relocatable (.o) emission")
        } else if target_os == 1 {
            emit_macho_relocatable(total_code, 0, arch)
        } else if target_os == 2 {
            emit_coff_relocatable(total_code, 0, arch)
        } else {
            emit_elf_relocatable(total_code, 0, arch)
        }
        codegen_write_output(output_path)

        uint8[64] nb
        uint64 tl = fmt_uint(nb, tcount)
        write(1, nb, tl)
        uint64 msg = " tokens, "
        write(1, msg, 9)
        uint64 al = fmt_uint(nb, ast_count)
        write(1, nb, al)
        msg = " nodes, "
        write(1, msg, 8)
        uint64 cl = fmt_uint(nb, text_size)
        write(1, nb, cl)
        msg = " bytes -> "
        write(1, msg, 10)
        uint64 olen = str_len(output_path)
        write(1, output_path, olen)
        msg = " (relocatable)\n"
        write(1, msg, 15)
        return
    }

    if emit_mode == 7 {
        // LKM: relocatable ELF + .modinfo + struct module + init/exit
        // symbol aliases. Only x86_64 + linux is supported today; other
        // arch/target combinations are caught earlier in flag parsing.
        //
        // Split the blob at data_start: [code + string literals] go in
        // .text (mapped RO+X by the kernel), [static variables] go in
        // .data (RW). Without this split, static vars land in .text and
        // any WRITE to them faults ("supervisor write, permissions
        // violation"). String-literal refs stay intra-.text and need no
        // relocation; static-var refs cross .text→.data and DO — see
        // emit_elf_lkm's static-fixup relocation pass.
        if arch == 2 {
            riscv32_nyi("LKM (.ko) emission")
        } else if arch == 3 {
            xtensa_nyi("LKM (.ko) emission")
        }
        uint64 lkm_total = codegen_output_len()
        uint64 lkm_text_len = data_start
        uint64 lkm_data_len = lkm_total - data_start
        emit_elf_lkm(lkm_text_len, lkm_data_len, arch)
        codegen_write_output(output_path)

        uint8[64] nb
        uint64 tl = fmt_uint(nb, tcount)
        write(1, nb, tl)
        uint64 msg = " tokens, "
        write(1, msg, 9)
        uint64 al = fmt_uint(nb, ast_count)
        write(1, nb, al)
        msg = " nodes, "
        write(1, msg, 8)
        uint64 cl = fmt_uint(nb, text_size)
        write(1, nb, cl)
        msg = " bytes -> "
        write(1, msg, 10)
        uint64 olen = str_len(output_path)
        write(1, output_path, olen)
        msg = " (lkm)\n"
        write(1, msg, 7)
        return
    }

    // For ASM listing, output text disassembly
    if emit_mode == 5 {
        emit_asm_listing(output_path, arch, text_start, source, 0)

        uint8[64] nb
        uint64 tl = fmt_uint(nb, tcount)
        write(1, nb, tl)
        uint64 msg = " tokens, "
        write(1, msg, 9)
        uint64 al = fmt_uint(nb, ast_count)
        write(1, nb, al)
        msg = " nodes, "
        write(1, msg, 8)
        uint64 cl = fmt_uint(nb, text_size)
        write(1, nb, cl)
        msg = " bytes -> "
        write(1, msg, 10)
        uint64 olen = str_len(output_path)
        write(1, output_path, olen)
        msg = " (asm listing)\n"
        write(1, msg, 15)
        return
    }

    // Patch headers.
    // Raw riscv flat binary: there IS no header — patch_u32 on offsets
    // 24/96/... would stomp the instruction bytes at the start of the
    // image. The entry is at offset 0 by construction (emitted first),
    // its existence was validated before codegen, and the whole buffer
    // is written verbatim below. Skip the entire patch block. Also skip
    // find_main_offset: a raw image whose entry is `_start` legitimately
    // has no `main`.
    //
    // --emit=image resolves its entry the bare-metal way instead: a live
    // `_start`, else `main` — the same rule riscv32 and xtensa raw emission
    // have used since sub-project A, now shared through find_entry_node.
    // find_main_offset is left exactly as it is (@export, hosted path):
    // widening a hosted exported function to satisfy a bare-metal requirement
    // is how the else-POSIX inheritance defects in this codebase were made.
    //
    // THE CONVERSION IS THE POINT OF THIS ARM. find_entry_node hands back an
    // AST NODE; the `image:` report line — the only place a flat image records
    // its entry, since there is no e_entry — needs a CODE OFFSET. Widening the
    // refusal below so `_start`-only programs stop being rejected, WITHOUT
    // this fn_lookup, leaves entry_off at the 0xFFFFFFFF sentinel and every
    // such image reports entry=4294967295 while exiting 0 and writing a
    // perfectly good artifact. fn_lookup (not find_main_offset) is what turns
    // the node's name token into the offset codegen registered for it, and it
    // runs HERE, after the emit loop, because the fn_table entry does not
    // exist before that.
    uint64 entry_off = 0
    if img_raw != 0 {
        uint64 img_entry_node = find_entry_node(root)
        if img_entry_node == 0 {
            entry_missing_die()
        }
        uint32 ime_tok = ast_data1(img_entry_node)
        uint64 ime_wtok = ime_tok
        entry_off = fn_lookup(ime_wtok)
        if entry_off == 0xFFFFFFFF {
            // find_entry_node only returns functions dce_is_live accepted, and
            // the emit loop emits exactly those, so reaching this is an
            // internal inconsistency between the two — not a user error. Say
            // so rather than emitting an image whose entry points nowhere.
            uint64 imx_msg = "error: internal: entry function was selected but never registered in the code image\n"
            write(2, imx_msg, str_len(imx_msg))
            exit(1)
        }
        // With a stub emitted, THE STUB is what `entry` reports, and the entry
        // function reached through it would fault on a garbage SP.
        //
        // WHETHER THAT IS ALSO THE ADDRESS TO START AT DEPENDS ON THE HEADER,
        // and the unconditional claim that used to stand here is false under
        // --image-header. Without a header, yes: a loader or reset vector must
        // be parked on load_addr + entry, because nothing else in the file
        // points at the stub. WITH --image-header, the start address is the
        // LOAD ADDRESS, file offset 0 — the header's code0 branches to this
        // stub, which is exactly what makes the artifact bootable from its
        // first byte — measured, in boot_gate.sh leg L5, which enters the
        // artifact at file offset 0 and reaches the stub. A header-aware loader
        // (qemu -kernel, leg L6) will start at offset 0 whatever this line
        // reports, so tooling built on the old wording talks past it. Same
        // statement in docs/LANGUAGE.md under `--emit=image`, and again at the
        // finalize block below. The fn_lookup
        // above still runs and still refuses on an inconsistency — the stub
        // recorded a `bl` fixup (arm64) or a patched movabs (x86_64) against
        // that same token, so a miss here means the image's own call would
        // not have resolved either.
        // BOTH stub paths set img_stub_set: arm64's block above records the
        // appended stub's offset, and the x86_64 PART 2 block records the
        // trampoline's `cli`. It stays 0 only with --stack-top absent, i.e. no
        // stub on either arch, where entry_off stays exactly what it was.
        // Tested against its OWN flag and not against 0xFFFFFFFF -- the
        // sentinel four lines up belongs to fn_lookup and means something else.
        if img_stub_set != 0 {
            entry_off = img_stub_off
        }
    } else if rv_raw == 0 {
        entry_off = find_main_offset()
        if entry_off == 0xFFFFFFFF {
            write(2, "error: no 'main' function found\n", 32)
            uint64 wmsg_3090 = "Every KernRift program needs: fn main() { ... }\n"
            write(2, wmsg_3090, str_len(wmsg_3090))
            exit(1)
        }
    }
    if emit_mode == 0 && rv_raw == 0 && (arch == 0 || arch == 1) {
        // ELF entry point
        uint64 entry_va = 0x400000 + entry_off
        patch_u32(24, entry_va & 0xFFFFFFFF)
        patch_u32(28, (entry_va >> 32) & 0xFFFFFFFF)
        uint64 total_size = header_size + text_size
        // BSS optimisation: trailing zeros from uninitialised static
        // arrays don't need to live in the file. Scan for the last
        // non-zero byte; if the gap is worth it, truncate the output
        // and keep p_memsz at the full size so the ELF loader zero-
        // fills the rest at load time. Skip when DWARF is enabled —
        // debug sections get emitted after this patch and reject
        // truncation of the main load segment.
        uint64 p_filesz = total_size
        if debug_info_mode == 0 {
            uint64 tail_start = codegen_last_nonzero_end()
            uint64 bss_bytes = total_size - tail_start
            // 4 KB page threshold — anything smaller isn't worth the
            // extra segment bookkeeping.
            if bss_bytes >= 4096 {
                codegen_truncate(tail_start)
                p_filesz = tail_start
            }
        }
        patch_u32(96, p_filesz & 0xFFFFFFFF)
        patch_u32(100, (p_filesz >> 32) & 0xFFFFFFFF)
        patch_u32(104, total_size & 0xFFFFFFFF)
        patch_u32(108, (total_size >> 32) & 0xFFFFFFFF)
        // Emit DWARF debug sections if -g active
        if debug_info_mode != 0 {
            emit_elf_debug_footer(text_start, input_path)
        }
    } else if emit_mode == 0 && rv_raw == 0 && arch == 2 {
        // RV32 hosted: Elf32 entry + BSS patch. Distinct offsets from the
        // Elf64 path above — e_entry is a single u32 at 24 (offset 28 is
        // e_phoff in Elf32); p_filesz/p_memsz live at 68/72.
        uint64 entry_va_rv = 0x10000 + entry_off
        patch_u32(24, entry_va_rv)
        uint64 total_size_rv = header_size + text_size
        uint64 p_filesz_rv = total_size_rv
        if debug_info_mode == 0 {
            uint64 tail_start_rv = codegen_last_nonzero_end()
            uint64 bss_bytes_rv = total_size_rv - tail_start_rv
            if bss_bytes_rv >= 4096 {
                codegen_truncate(tail_start_rv)
                p_filesz_rv = tail_start_rv
            }
        }
        patch_u32(68, p_filesz_rv)     // Elf32_Phdr p_filesz
        patch_u32(72, total_size_rv)   // Elf32_Phdr p_memsz
    } else if emit_mode == 8 {
        // --emit=image finalize. NOTHING is truncated: memsz == filesz by
        // decision.
        //
        // ONE THING IS PATCHED HERE, AND ONLY UNDER --image-header: the Image
        // header's image_size, at offset 16, by the PART 2 OF 2 block below.
        // Without the flag this arm writes no byte at all and the artifact
        // reaches codegen_write_output exactly as codegen left it. An earlier
        // revision of this line read "NOTHING is patched — there is no header
        // —", which sub-project C falsified IN THIS VERY BLOCK. Same
        // stale-premise/surviving-conclusion shape as Task 1's I1 and as the
        // "with no header emitted" premise under THE CODE OFFSET IS THE FILE
        // OFFSET later in this same arm: third occurrence in one sub-project,
        // which is why the correction is spelled out instead of just applied.
        //
        // NOTHING ZEROES A BSS TAIL ON BARE METAL, AND NOTHING IS PLANNED TO.
        // Sub-project B2 emitted the entry stub (arm64: set SP, `bl` the
        // entry, halt; x86_64: multiboot header + long-mode trampoline) and
        // that stub deliberately does NOT zero anything — B2 spec D3 records
        // the decision, and the reason is right here: the image already
        // carries its statics as real zero BYTES, so a zeroing loop would
        // re-zero bytes that are already zero on disk. This is what makes the
        // no-truncation rule permanent rather than provisional. QEMU
        // zero-fills RAM, so a truncated image would pass the boot gate while
        // reading garbage statics on real silicon — and no B-series artifact
        // has ever run on real silicon to catch it.
        //
        // The full file IS the zeroed BSS. codegen_truncate is
        // reached only from the emit_mode == 0 arms above, so this needs no
        // guard — measured: the 64 KiB-static program emits 65600 bytes here
        // where the ELF path emits 180 and lets p_memsz carry the rest.
        //
        // The report line is a REQUIRED output, not a convenience: a flat
        // image has no e_entry, so the entry's file offset is recorded in no
        // other place, and the boot harness needs it to branch to load + entry.
        // entry_off comes from the img_raw arm above — find_entry_node's node
        // resolved through fn_lookup, NOT find_main_offset — so it is a live
        // `_start` when the program has one and `main` otherwise.
        //
        // THE CODE OFFSET IS THE FILE OFFSET, and that survives --image-header
        // rather than depending on nothing being prefixed. An earlier revision
        // of this line justified it as "with no header emitted", which stopped
        // being true the moment Task 2 landed while the conclusion it
        // supported stayed correct — the stale-premise/surviving-conclusion
        // shape this sub-project has already been bitten by once (Task 1, I1).
        // The durable reason is that fn_lookup returns an offset into the SAME
        // out_buf the header was emitted into, and the header is emitted
        // BEFORE codegen, so every registered offset already counts those 64
        // bytes. A prefix therefore cannot desynchronise the report; a prefix
        // added after codegen would, which is one more reason it is not.
        //
        // With --image-header a loader does not need this number at all — it
        // enters at file offset 0 and code0 branches to the stub. The report
        // stays REQUIRED regardless, because the boot gate enters at
        // load + entry directly and B1-style headerless images have no other
        // record of where to start.
        //
        // Values are decimal throughout — fmt_uint exists, write_hex32 caps
        // at 32 bits and load_addr is 64-bit; one radix beats two. Size is
        // codegen_output_len() at THIS point rather than text_size: they are
        // equal here, but text_size is the variable the hosted report line
        // prints and on the ELF path that is the PRE-truncation size (a
        // 1001-byte file reported as "66424 bytes"), so deriving the number
        // from the buffer is what "inspect the artifact" means.
        //
        // load_addr is echoed, never embedded. Two different aligned
        // addresses must produce one byte-identical artifact.
        uint64 img_size = codegen_output_len()
        // ------------------------------------------------------------------
        // The Image header's `image_size`, PART 2 OF 2 (sub-project C, Task 2).
        //
        // THE SECOND PATCH-BACK, and the one that is easy to miss because the
        // field looks like a constant. It is not: it is the FINAL FILE SIZE,
        // which does not exist until every function, every string and every
        // static has been laid out — i.e. not until this line. img_size is
        // read from the buffer here rather than accumulated, for the reason
        // the report's own note above gives.
        //
        // THE HEADER'S OWN 64 BYTES ARE INCLUDED, because they are part of
        // the file and a loader reserving image_size bytes must cover them.
        // Nothing observable enforces that: QEMU never honours text_offset = 0
        // (it substitutes 2 MiB) and never reads this field for placement, so
        // image_size = 1 and image_size = 64 BOTH boot. It is a protocol
        // obligation to real loaders resting entirely on the static assertion
        // in imghdr_image_size_is_file_size, and taking it from
        // codegen_output_len() — the same number the report prints and the
        // boot gate cross-checks against the artifact's on-disk size — is what
        // makes that assertion cheap to keep true.
        //
        // AHEAD OF THE REFUSALS AND THE REPORT BELOW: patching the buffer
        // cannot change its length, so an image that is about to be refused
        // is neither written nor perturbed by having been patched. Placed
        // after them instead, a future early-exit added between here and the
        // report would ship a zero image_size — "reserve nothing" — from a
        // build that exited 0.
        if a64hdr_on != 0 {
            patch_u64(16, img_size)
        }
        // The two checks that need the FILE SIZE, so they cannot live with
        // the rest of the --load-addr/--stack-top validation (B2 Task 4,
        // review I3). They run HERE, ahead of the report, for two reasons:
        // the report announces an artifact, and codegen_write_output has not
        // run yet -- so a refusal leaves nothing on disk and says nothing
        // that was not true.
        //
        // THEY ARE NOT THE SAME KIND OF RULE. This comment used to call both
        // of them "trampoline preconditions", which is true of one and false
        // of the other, and the false half was gated `arch == 0` to match the
        // name:
        //
        //   * THE 1 GiB FIT is a property of the x86_64 trampoline's identity
        //     map (one 512-entry page directory of 2 MiB pages). arm64's stub
        //     enables no paging and maps nothing, so this stays arch == 0.
        //   * STACK-VS-IMAGE IS ARCHITECTURE-INDEPENDENT. A stack top inside
        //     the image means the first push overwrites the program's own
        //     bytes, on any machine, with or without paging. Shipped gated on
        //     arch == 0 anyway: `--arch=arm64 --load-addr=0x40400000
        //     --stack-top=0x40400010` exited 0 and wrote a 56-byte image
        //     whose first push lands at 0x40400008, inside its own code,
        //     while x86_64 refused the identical shape. Ungated here.
        //
        // Both stay gated on the stub actually being emitted, like the
        // address-only half: a B1-style blob loaded by somebody else's loader
        // gets its SP from that loader and is subject to neither.
        if stack_top_set != 0 {
            uint64 img_end = load_addr + img_size
            if arch == 0 && img_end > 1073741824 {
                uint64 ie_1g = "error: the image does not fit under the x86_64 self-boot trampoline's identity map: the map is a single 512-entry page directory of 2 MiB pages and covers exactly the first 1 GiB, and this image ends past it. Lower --load-addr, or drop --stack-top and boot it with a loader of your own\n"
                write(2, ie_1g, str_len(ie_1g))
                exit(1)
            }
            // The stack grows DOWN from --stack-top, so the FIRST push writes
            // the eight bytes [stack_top-8, stack_top) and that band is what
            // this compares against the image. A stack top AT the load address
            // is therefore fine (the push lands below the image) and one eight
            // bytes past the image's end is not. How far down the stack will
            // go afterwards is not knowable here -- a stack far above the
            // image still collides eventually and is not refused -- so this
            // catches exactly the configurations that are corrupt from the
            // very first push.
            //
            // Fires on BOTH arches (see above). No boot-gate leg can reach it:
            // the gate's arm64 images load at 0x40400000 and run ~1 KiB, and
            // its stack top is 0x40800000 -- 4 MiB clear of img_end.
            if stack_top > load_addr && stack_top < img_end + 8 {
                uint64 st_in = "error: --stack-top= starts inside the image: the stack grows down from it and the first push would overwrite the program's own bytes. Put the stack below --load-addr, or above the end of the image\n"
                write(2, st_in, str_len(st_in))
                exit(1)
            }
        }
        uint8[64] ib
        uint64 im = "image: arch="
        write(1, im, str_len(im))
        uint64 an = arch_flag_name(arch)
        write(1, an, str_len(an))
        im = " entry="
        write(1, im, str_len(im))
        uint64 il = fmt_uint(ib, entry_off)
        write(1, ib, il)
        im = " filesz="
        write(1, im, str_len(im))
        il = fmt_uint(ib, img_size)
        write(1, ib, il)
        im = " memsz="
        write(1, im, str_len(im))
        il = fmt_uint(ib, img_size)
        write(1, ib, il)
        im = " load="
        write(1, im, str_len(im))
        il = fmt_uint(ib, load_addr)
        write(1, ib, il)
        im = "\n"
        write(1, im, str_len(im))
    } else if emit_mode == 9 {
        // --emit=uefi finalize (sub-project D).
        //
        // THIS ARM EXISTS BECAUSE THE CHAIN HAS NO TERMINAL `else`. A mode
        // that reaches the end of it unnamed gets no entry patch and no size
        // patch, and then falls straight into codegen_write_output twelve
        // lines below — exit 0, no diagnostic, a file on disk. That is the
        // single most likely way this sub-project ships a broken artifact, so
        // the arm is written before it has anything to patch rather than
        // added alongside the fields that need it.
        //
        // NOTHING IS PATCHED HERE YET, and that is a Task 1 statement with an
        // expiry date, not a property of the format: Task 2 patches
        // AddressOfEntryPoint (= uf_entry, since file offset == RVA under the
        // delta-0 geometry the header arm reserves), SizeOfImage and
        // SizeOfHeaders into the 4096-byte region that arm emitted.
        //
        // NOTHING IS TRUNCATED, for the same reason --emit=image truncates
        // nothing: the statics are carried as real zero bytes and there is no
        // startup code to re-zero them. A PE's SizeOfImage-vs-raw-size pair
        // could express a BSS tail, and deliberately will not — firmware
        // zero-fills nothing.
        //
        // entry comes from the img_raw arm above (find_entry_node resolved
        // through fn_lookup), so it is a live `_start` when the program has
        // one and `main` otherwise. img_stub_set is always 0 on this path —
        // both stubs are gated on --stack-top=, which is refused outside
        // --emit=image — so entry is the entry FUNCTION's offset, with no
        // trampoline in between. UEFI enters in long mode with a stack the
        // firmware set up; there is nothing for a stub to do.
        uint64 uf_size = codegen_output_len()
        uint8[64] uf_b
        uint64 uf_m = "uefi: arch="
        write(1, uf_m, str_len(uf_m))
        uint64 uf_a = arch_flag_name(arch)
        write(1, uf_a, str_len(uf_a))
        uf_m = " entry="
        write(1, uf_m, str_len(uf_m))
        uint64 uf_l = fmt_uint(uf_b, entry_off)
        write(1, uf_b, uf_l)
        uf_m = " filesz="
        write(1, uf_m, str_len(uf_m))
        uf_l = fmt_uint(uf_b, uf_size)
        write(1, uf_b, uf_l)
        uf_m = " memsz="
        write(1, uf_m, str_len(uf_m))
        uf_l = fmt_uint(uf_b, uf_size)
        write(1, uf_b, uf_l)
        uf_m = " hdr="
        write(1, uf_m, str_len(uf_m))
        uf_l = fmt_uint(uf_b, header_size)
        write(1, uf_b, uf_l)
        uf_m = "\n"
        write(1, uf_m, str_len(uf_m))
    } else if emit_mode == 1 {
        // Mach-O
        uint64 page_size = 4096
        if arch == 1 { page_size = 16384 }
        // arch==2 unreachable here (Mach-O header site already refused);
        // keep it explicit so a future guard removal can't misroute.
        if arch == 2 { riscv32_nyi("Mach-O image emission") }
        uint64 total_file = codegen_output_len()
        uint64 total_aligned = (total_file + page_size - 1) & ~(page_size - 1)
        while codegen_output_len() < total_aligned { emit_byte(0) }
        patch_u32(136, total_aligned & 0xFFFFFFFF)
        patch_u32(140, (total_aligned >> 32) & 0xFFFFFFFF)
        patch_u32(152, total_aligned & 0xFFFFFFFF)
        patch_u32(156, (total_aligned >> 32) & 0xFFFFFFFF)
        uint64 main_off_macho = find_main_offset()
        if arch == 0 {
            // x86_64: LC_UNIXTHREAD — absolute VA
            uint64 entry_va = 0x100000000 + main_off_macho
            patch_u32(320, entry_va & 0xFFFFFFFF)
            patch_u32(324, (entry_va >> 32) & 0xFFFFFFFF)
        } else if arch == 1 {
            // ARM64 LC_MAIN entryoff = file offset of main
            patch_u32(608, main_off_macho & 0xFFFFFFFF)
            patch_u32(612, (main_off_macho >> 32) & 0xFFFFFFFF)
        } else {
            riscv32_nyi("Mach-O image emission")
        }
        // ARM64 Mach-O: patch __text section + separate __DATA segment for W^X
        // (arch==2 cannot reach this block — refused above.)
        if arch == 1 {
            // __text section size at offset 216
            uint64 m_textsz = total_aligned - 16384
            patch_u32(216, m_textsz & 0xFFFFFFFF)
            patch_u32(220, (m_textsz >> 32) & 0xFFFFFFFF)
            while (codegen_output_len() & 7) != 0 { emit_byte(0) }
            uint64 m_dfoff = codegen_output_len()
            emit_static_data()
            uint64 m_draw = codegen_output_len() - m_dfoff
            uint64 m_dal = (m_draw + 16383) & ~16383
            if m_dal == 0 { m_dal = 16384 }
            while codegen_output_len() < m_dfoff + m_dal { emit_byte(0) }
            resolve_static_fixups_a64(m_dfoff)
            uint64 m_dva = 0x100000000 + total_aligned
            patch_u32(280, m_dva & 0xFFFFFFFF)
            patch_u32(284, (m_dva >> 32) & 0xFFFFFFFF)
            patch_u32(288, m_dal & 0xFFFFFFFF)
            patch_u32(292, (m_dal >> 32) & 0xFFFFFFFF)
            patch_u32(296, total_aligned & 0xFFFFFFFF)
            patch_u32(300, (total_aligned >> 32) & 0xFFFFFFFF)
            patch_u32(304, m_dal & 0xFFFFFFFF)
            patch_u32(308, (m_dal >> 32) & 0xFFFFFFFF)
            // __LINKEDIT: call helper to emit chained fixups + symtab + strtab
            uint64 m_lva = m_dva + m_dal
            uint64 m_lfoff = m_dfoff + m_dal
            emit_macho_linkedit_a64(m_lfoff, main_off_macho)
            uint64 m_lraw = codegen_output_len() - m_lfoff
            uint64 m_lsz = (m_lraw + 16383) & ~16383
            if m_lsz == 0 { m_lsz = 16384 }
            while codegen_output_len() < m_lfoff + m_lsz { emit_byte(0) }
            patch_u32(352, m_lva & 0xFFFFFFFF)
            patch_u32(356, (m_lva >> 32) & 0xFFFFFFFF)
            patch_u32(360, m_lsz & 0xFFFFFFFF)
            patch_u32(364, (m_lsz >> 32) & 0xFFFFFFFF)
            patch_u32(368, m_lfoff & 0xFFFFFFFF)
            patch_u32(372, (m_lfoff >> 32) & 0xFFFFFFFF)
            patch_u32(376, m_lraw & 0xFFFFFFFF)
            patch_u32(380, (m_lraw >> 32) & 0xFFFFFFFF)
        }
    } else if emit_mode == 2 {
        // PE: patch entry point to main function
        uint64 main_off = find_main_offset()
        uint64 pe_entry = 0x1000 + main_off - text_start
        patch_u32(0x68, pe_entry)

        uint64 text_aligned = 0
        uint64 text_va_size = 0
        uint64 idata_rva = 0

        if arch == 1 {
            // ARM64 PE: separate .data section for statics (W^X enforcement)
            // .text = code + strings only (RX)
            // .data = statics (RW)
            // .idata = imports (RW)
            uint64 code_end = data_start  // data_start from earlier = end of code
            uint64 code_with_strings = codegen_output_len() - text_start
            // Rewind: remove statics from output (they were emitted into .text)
            // We can't rewind, but we can just note where code+strings end vs statics begin
            // Actually, statics are already in the buffer. We'll re-emit them into .data.
            // For the .text section, include code + statics + strings (the whole text_size)
            // but mark it as RX. Then emit .data with a copy of statics.
            text_aligned = (text_size + 0x1FF) & ~0x1FF
            while codegen_output_len() < header_size + text_aligned { emit_byte(0) }
            // Emit .data section: re-emit statics
            while (codegen_output_len() & 7) != 0 { emit_byte(0) }
            uint64 data_file_off = codegen_output_len()
            emit_static_data()
            uint64 data_raw_size = codegen_output_len() - data_file_off
            uint64 data_aligned = (data_raw_size + 0x1FF) & ~0x1FF
            if data_aligned == 0 { data_aligned = 0x200 }
            while codegen_output_len() < data_file_off + data_aligned { emit_byte(0) }
            // Re-resolve static fixups to point into .data
            text_va_size = (text_size + 0xFFF) & ~0xFFF
            uint64 data_rva = 0x1000 + text_va_size
            uint64 data_va_size = (data_raw_size + 0xFFF) & ~0xFFF
            if data_va_size == 0 { data_va_size = 0x1000 }
            // Static fixups: re-resolve for .data section
            // For PE ADRP: the resolve function uses a64_compute_va which adds 0x140000E00.
            // We need target_va = 0x140000000 + data_rva + offset.
            // Pass data_rva - 0xE00 so that a64_compute_va(base + offset) = correct VA.
            // BUT for ADRP mode, code_va is also computed via a64_compute_va — which IS correct
            // for code in .text. So we need data_start such that:
            // a64_compute_va(data_start + offset) = 0x140000000 + data_rva + offset
            // 0x140000E00 + data_start + offset = 0x140000000 + data_rva + offset
            // data_start = data_rva - 0xE00
            uint64 data_va_base = data_rva - 0xE00
            resolve_static_fixups_a64(data_va_base)
            // Emit .idata
            idata_rva = 0x1000 + text_va_size + data_va_size
            uint64 iat_rva_val = emit_pe_idata(idata_rva)
            pe_iat_rva = iat_rva_val
            // Patch .text header at 0x148
            uint64 t_hdr = 0x148
            patch_u32(t_hdr + 8, text_size)        // VirtualSize
            patch_u32(t_hdr + 16, text_aligned)     // RawSize
            // Patch .data header at 0x170
            uint64 d_hdr = 0x170
            patch_u32(d_hdr + 8, data_raw_size)     // VirtualSize
            patch_u32(d_hdr + 12, data_rva)          // VirtualAddress
            patch_u32(d_hdr + 16, data_aligned)      // RawSize
            patch_u32(d_hdr + 20, data_file_off)     // PointerToRawData
            // Patch .idata header at 0x198
            uint64 i_hdr = 0x198
            uint64 idata_file_off = data_file_off + data_aligned
            patch_u32(i_hdr + 8, pe_idata_size())    // VirtualSize
            patch_u32(i_hdr + 12, idata_rva)          // VirtualAddress
            patch_u32(i_hdr + 16, pe_idata_size())    // RawSize
            patch_u32(i_hdr + 20, idata_file_off)     // PointerToRawData
            // Patch import directory RVA
            patch_u32(0xD0, idata_rva)
            // Patch SizeOfCode
            patch_u32(0x5C, text_aligned)
            // Patch ImageSize
            uint64 image_size = 0x1000 + text_va_size + data_va_size + 0x1000
            patch_u32(0x90, image_size)
            // Resolve ARM64 IAT fixups
            resolve_a64_win_iat_fixups(text_start, iat_rva_val)
        } else if arch == 0 {
            // x86_64 PE: statics in .text (RWX) — x86_64 allows this
            text_aligned = (text_size + 0x1FF) & ~0x1FF
            while codegen_output_len() < header_size + text_aligned { emit_byte(0) }
            text_va_size = (text_size + 0xFFF) & ~0xFFF
            idata_rva = 0x1000 + text_va_size
            uint64 iat_rva_val = emit_pe_idata(idata_rva)
            pe_iat_rva = iat_rva_val
            // Patch .text header at 0x148
            uint64 text_hdr = 0x148
            patch_u32(text_hdr + 8, text_size)
            patch_u32(text_hdr + 16, text_aligned)
            // Patch .idata header at 0x170
            uint64 idata_hdr = 0x170
            patch_u32(idata_hdr + 12, idata_rva)
            uint64 idata_file_off = header_size + text_aligned
            patch_u32(idata_hdr + 20, idata_file_off)
            // Import directory RVA
            patch_u32(0xD0, idata_rva)
            // SizeOfCode
            patch_u32(0x5C, text_aligned)
            // ImageSize
            uint64 image_size = 0x1000 + text_va_size + 0x1000
            patch_u32(0x90, image_size)
            // Resolve x86_64 IAT fixups
            resolve_win_iat_fixups(text_start, iat_rva_val)
        } else {
            // arch==2 unreachable (PE header site already refused).
            riscv32_nyi("PE image emission")
        }
    } else if emit_mode == 4 {
        // Android PIE ELF: separate RX code + RW data segments
        uint64 android_entry = entry_off
        patch_u32(24, android_entry & 0xFFFFFFFF)
        patch_u32(28, (android_entry >> 32) & 0xFFFFFFFF)
        // PT_LOAD RX: code + strings only (up to current output)
        uint64 rx_size = codegen_output_len()
        patch_u32(208, rx_size & 0xFFFFFFFF)
        patch_u32(212, (rx_size >> 32) & 0xFFFFFFFF)
        patch_u32(216, rx_size & 0xFFFFFFFF)
        patch_u32(220, (rx_size >> 32) & 0xFFFFFFFF)
        // Pad to 64KB page boundary for PT_LOAD RW
        uint64 rx_aligned = (rx_size + 0xFFFF) & ~0xFFFF
        while codegen_output_len() < rx_aligned { emit_byte(0) }
        // Emit data segment (statics)
        while (codegen_output_len() & 7) != 0 { emit_byte(0) }
        uint64 a_dfoff = codegen_output_len()
        emit_static_data()
        uint64 a_draw = codegen_output_len() - a_dfoff
        uint64 a_dal = (a_draw + 0xFFFF) & ~0xFFFF
        if a_dal == 0 { a_dal = 0x10000 }
        while codegen_output_len() < a_dfoff + a_dal { emit_byte(0) }
        // Re-resolve static fixups to point into RW segment.
        // x86_64: RIP-relative disp from (code_off + 4) to (a_dfoff + data_off).
        // arm64: a64_compute_va returns file_offset for target_os==3, so
        // passing a_dfoff directly gives the right VA for the RW data copy.
        if arch == 0 {
            resolve_static_fixups(a_dfoff)
        } else if arch == 1 {
            resolve_static_fixups_a64(a_dfoff)
        } else {
            // arch==2 unreachable (Android header site already refused).
            riscv32_nyi("Android image emission")
        }
        // Patch PT_LOAD RW @288: p_offset, p_vaddr, p_paddr, p_filesz, p_memsz
        patch_u32(296, a_dfoff & 0xFFFFFFFF)
        patch_u32(300, (a_dfoff >> 32) & 0xFFFFFFFF)
        // vaddr = rx_aligned (page-aligned, contiguous after RX in VA space)
        patch_u32(304, rx_aligned & 0xFFFFFFFF)
        patch_u32(308, (rx_aligned >> 32) & 0xFFFFFFFF)
        // paddr = same as vaddr
        patch_u32(312, rx_aligned & 0xFFFFFFFF)
        patch_u32(316, (rx_aligned >> 32) & 0xFFFFFFFF)
        patch_u32(320, a_draw & 0xFFFFFFFF)
        patch_u32(324, (a_draw >> 32) & 0xFFFFFFFF)
        // p_memsz uses the page-aligned size (a_dal), not the raw data size.
        // Android's bionic linker refuses to map a LOAD segment whose p_memsz
        // is 0 — the resulting process SIGBUSes the moment it touches the
        // corresponding VA. Pinning p_memsz to at least one page keeps the
        // linker happy even for programs with no declared statics.
        patch_u32(328, a_dal & 0xFFFFFFFF)
        patch_u32(332, (a_dal >> 32) & 0xFFFFFFFF)
    }

    codegen_write_output(output_path)
    // Mark the output executable so `./out` works immediately.
    // No-op on Windows; safe on Linux/macOS/Android.
    set_executable(output_path)

    uint64 t_end = time_ns()
    uint64 elapsed_ns = t_end - t_start

    uint8[64] nb
    uint64 tl = fmt_uint(nb, tcount)
    write(1, nb, tl)
    uint64 msg = " tokens, "
    write(1, msg, 9)
    uint64 al = fmt_uint(nb, ast_count)
    write(1, nb, al)
    msg = " nodes, "
    write(1, msg, 8)
    uint64 cl = fmt_uint(nb, text_size)
    write(1, nb, cl)
    msg = " bytes -> "
    write(1, msg, 10)
    uint64 olen = str_len(output_path)
    write(1, output_path, olen)
    if t_start != 0 {
        // Format as "x.xx ms" — hundredths-of-ms precision from ns.
        // ms_whole = ns / 1_000_000; hundredths = (ns / 10_000) % 100
        uint64 ms_whole = elapsed_ns / 1000000
        uint64 ms_hund  = (elapsed_ns / 10000) % 100
        msg = "  ("
        write(1, msg, 3)
        uint64 w_len = fmt_uint(nb, ms_whole)
        write(1, nb, w_len)
        msg = "."
        write(1, msg, 1)
        // Two-digit hundredths with leading zero
        uint8[2] hb
        uint8 d0 = 48 + (ms_hund / 10)
        uint8 d1 = 48 + (ms_hund % 10)
        unsafe { *(hb as uint8) = d0 }
        uint64 hb1 = hb + 1
        unsafe { *(hb1 as uint8) = d1 }
        write(1, hb, 2)
        msg = " ms)\n"
        write(1, msg, 5)
    } else {
        msg = "\n"
        write(1, msg, 1)
    }
}

// Produce KrboFat: compile for both x86_64 and ARM64, LZ4-compress, wrap in fat binary
// Restore source and token buffers from snapshot before a re-parse in compile_fat.
// The for-loop parser (and others) destructively mutate both; this rolls them back.
fn restore_src_and_tokens(uint64 source, uint64 size, uint64 src_snap, uint64 tokens, uint64 tok_bytes, uint64 tok_snap) {
    memcpy(source, src_snap, size)
    memcpy(tokens, tok_snap, tok_bytes)
}

// --targets=<list> bitmask. 0 = unset (default: all 8, paired layout).
// Bit i (0..7) maps to KrboFat arch_id i+1:
//   0 linux-x64, 1 linux-arm64, 2 win-x64, 3 win-arm64,
//   4 macos-x64, 5 macos-arm64, 6 android-arm64, 7 android-x64.
static uint64 target_mask = 0

// Compare a fixed-length string `s` of length `len` against a nul-terminated
// literal `lit`. Return 1 iff they match exactly (including length).
fn targets_name_eq(uint64 s, uint64 len, uint64 lit) -> uint64 {
    uint64 llen = str_len(lit)
    if len != llen { return 0 }
    return str_starts_with(s, lit, len)
}

// Return the target bit (0..7) for a platform name slice, or 0xFF if
// unrecognised. Accepts several common aliases.
fn parse_target_name(uint64 s, uint64 len) -> uint64 {
    if targets_name_eq(s, len, "linux-x64") != 0 { return 0 }
    if targets_name_eq(s, len, "linux-x86_64") != 0 { return 0 }
    if targets_name_eq(s, len, "linux-arm64") != 0 { return 1 }
    if targets_name_eq(s, len, "linux-aarch64") != 0 { return 1 }
    if targets_name_eq(s, len, "win-x64") != 0 { return 2 }
    if targets_name_eq(s, len, "windows-x64") != 0 { return 2 }
    if targets_name_eq(s, len, "win-arm64") != 0 { return 3 }
    if targets_name_eq(s, len, "windows-arm64") != 0 { return 3 }
    if targets_name_eq(s, len, "mac-x64") != 0 { return 4 }
    if targets_name_eq(s, len, "macos-x64") != 0 { return 4 }
    if targets_name_eq(s, len, "mac-arm64") != 0 { return 5 }
    if targets_name_eq(s, len, "macos-arm64") != 0 { return 5 }
    if targets_name_eq(s, len, "android-arm64") != 0 { return 6 }
    if targets_name_eq(s, len, "android-x64") != 0 { return 7 }
    if targets_name_eq(s, len, "android-x86_64") != 0 { return 7 }
    return 0xFF
}

// Parse "a,b,c" or "all" into target_mask. Unknown names produce a warning
// on stderr; recognised ones each flip one bit. "all" sets all 8 bits.
fn parse_targets_arg(uint64 list) {
    uint64 mask = 0
    uint64 i = 0
    uint64 c = 0
    uint64 p0 = list + i
    unsafe { *(p0 as uint8) -> c }
    while c != 0 {
        uint64 start = i
        while c != 0 && c != 44 {
            i = i + 1
            uint64 pn = list + i
            unsafe { *(pn as uint8) -> c }
        }
        uint64 tok_start = list + start
        uint64 tok_len = i - start
        if tok_len > 0 {
            if targets_name_eq(tok_start, tok_len, "all") != 0 {
                mask = mask | 0xFF
            } else if targets_name_eq(tok_start, tok_len, "none") != 0 {
                // --target=none is a bare-metal, no-OS image: the fat-binary
                // runner extracts one of the 8 hosted slices and execs it
                // under a live OS, and a bare-metal image has neither an OS
                // to exec it nor a slice ID of its own. This must be a hard
                // error, not the generic "unknown --targets name" warning
                // below (which lets the build proceed with mask 0 and
                // silently falls through to building all 8 hosted slices).
                uint64 tn_msg = "error: --targets=...,none: 'none' cannot appear in a fat binary; use --arch=<arch> --target=none for a single bare-metal binary instead\n"
                write(2, tn_msg, str_len(tn_msg))
                exit(1)
            } else {
                uint64 bit = parse_target_name(tok_start, tok_len)
                if bit != 0xFF {
                    mask = mask | (1 << bit)
                } else {
                    write(2, "warning: unknown --targets name: ", 33)
                    write(2, tok_start, tok_len)
                    write(2, "\n", 1)
                }
            }
        }
        if c == 44 {
            i = i + 1
            uint64 pc = list + i
            unsafe { *(pc as uint8) -> c }
        }
    }
    target_mask = mask
}

fn slot_load_u64(uint64 p) -> uint64 {
    uint64 v = 0
    unsafe { *(p as uint64) -> v }
    return v
}

fn emit_raw_bytes(uint64 buf, uint64 len) {
    uint64 i = 0
    while i < len {
        uint64 p = buf + i
        uint64 bv = 0
        unsafe { *(p as uint8) -> bv }
        uint8 bb = bv
        emit_byte(bb)
        i = i + 1
    }
}

fn compress_pair_best(
    uint64 a_buf, uint64 a_len, uint64 b_buf, uint64 b_len,
    uint64 out_comp_ptr, uint64 out_comp_len_ptr,
    uint64 out_a_off_ptr, uint64 out_b_off_ptr,
    uint64 out_pair_len_ptr
) {
    uint64 pair_len = a_len + b_len
    uint64 cap = lz4_compress_bound(pair_len)

    uint64 pair_ab = alloc(pair_len)
    memcpy(pair_ab, a_buf, a_len)
    memcpy(pair_ab + a_len, b_buf, b_len)
    uint64 comp_ab = alloc(cap)
    uint64 len_ab = lz4_compress_frame(pair_ab, pair_len, comp_ab)

    uint64 pair_ba = alloc(pair_len)
    memcpy(pair_ba, b_buf, b_len)
    memcpy(pair_ba + b_len, a_buf, a_len)
    uint64 comp_ba = alloc(cap)
    uint64 len_ba = lz4_compress_frame(pair_ba, pair_len, comp_ba)

    dealloc(pair_ab)
    dealloc(pair_ba)

    if len_ab <= len_ba {
        unsafe { *(out_comp_ptr as uint64) = comp_ab }
        unsafe { *(out_comp_len_ptr as uint64) = len_ab }
        unsafe { *(out_a_off_ptr as uint64) = 0 }
        unsafe { *(out_b_off_ptr as uint64) = a_len }
        dealloc(comp_ba)
    } else {
        unsafe { *(out_comp_ptr as uint64) = comp_ba }
        unsafe { *(out_comp_len_ptr as uint64) = len_ba }
        unsafe { *(out_a_off_ptr as uint64) = b_len }
        unsafe { *(out_b_off_ptr as uint64) = 0 }
        dealloc(comp_ab)
    }

    unsafe { *(out_pair_len_ptr as uint64) = pair_len }
}

fn compile_fat(uint64 input_path, uint64 output_path) {
    uint64 t_start_fat = time_ns()
    import_init()
    import_check_file(input_path)
    import_process(input_path)
    uint64 source = import_buf
    uint64 size = import_buf_len

    uint64 max_tok = 524288
    uint64 my_tokens = alloc(max_tok * 16)
    lexer_init(source, size, my_tokens, max_tok)
    uint64 tcount = lexer_run()

    // Save token count for reuse
    uint64 saved_tcount = tcount

    // Snapshot source and tokens before the first parse.
    // The parser MUTATES source and tokens (the for-loop parser in
    // particular rewrites byte positions and token kinds). compile_fat
    // re-parses once per platform slice, so we need to restore the
    // pristine state between passes.
    uint64 src_snapshot = alloc(size)
    uint64 cpi = 0
    while cpi < size {
        uint64 sp_src = source + cpi
        uint64 dp_src = src_snapshot + cpi
        uint64 bv_src = 0
        unsafe { *(sp_src as uint8) -> bv_src }
        uint8 bb_src = bv_src
        unsafe { *(dp_src as uint8) = bb_src }
        cpi = cpi + 1
    }
    uint64 tok_bytes = saved_tcount * 16
    uint64 tok_snapshot = alloc(tok_bytes)
    uint64 cti = 0
    while cti < tok_bytes {
        uint64 sp_tk = my_tokens + cti
        uint64 dp_tk = tok_snapshot + cti
        uint64 bv_tk = 0
        unsafe { *(sp_tk as uint8) -> bv_tk }
        uint8 bb_tk = bv_tk
        unsafe { *(dp_tk as uint8) = bb_tk }
        cti = cti + 1
    }

    // === Compile x86_64 ELF (Linux) ===
    target_os = 0
    set_target_arch(0)
    ast_init(524288)
    codegen_init(4194304, source, my_tokens)
    parser_init(my_tokens, saved_tcount)
    uint64 root = parse_module()

    // Semantic validation: check arg counts, missing returns, duplicate functions
    uint64 sema_errs = run_semantic_checks(root, source, my_tokens)
    // `let` type inference: resolve every inferred local's type from its RHS
    // and stash it in the AST. Runs unconditionally (the backends require a
    // concrete type for each `let`), independent of type-checking.
    resolve_inferred_types(root)
    uint64 pre_tc_errs = diag_error_count
    if check_types_enabled != 0 {
        tc_check_module(root)
    }
    // Type-checker errors are fatal (issue #101) — see the matching comment
    // in the primary compile path above.
    uint64 tc_errs = diag_error_count - pre_tc_errs
    diag_report_all()
    uint64 total_errs = sema_errs + tc_errs
    if total_errs != 0 {
        uint8[24] ebuf2
        uint64 elen2 = fmt_uint(ebuf2, total_errs)
        write(2, ebuf2, elen2)
        write(2, " error(s) found\n", 16)
        exit(1)
    }

    // Function inlining: must run before DCE so inlined-out helpers
    // become unreachable and get pruned.
    inline_pass(root)

    // Dead code elimination
    dce_init()
    dce_scan(root)

    // Generate x86_64 ELF into temp buffer.
    // The per-slice buffer is allocated AFTER codegen (same pattern as the
    // arm64 / pe / macho / android slices below) because the 1 MB upfront
    // allocation the code used to make silently overflowed once the slice
    // grew past that size — harmlessly on Linux (the overflow lands in
    // mapped heap pages) but as a SIGSEGV on Windows, where VirtualAlloc
    // leaves guard pages between reservations.
    uint64 x86_len = 0

    emit_elf_header()
    emit_program_header(0)
    uint64 text_start = codegen_output_len()

    uint32 child = ast_child(root)
    uint64 wchild = child
    while wchild != 0 {
        uint32 ck = ast_kind(wchild)
        if ck == 2 {
            uint32 fn_name = ast_data1(wchild)
            // IR is the default for every slice. `--legacy` (emit_ir_mode==0)
            // opts a release build back onto the direct-walking codegen if a
            // downstream issue is ever traced to the IR path; the old codegen
            // is kept intact for that reason.
            if dce_is_live(fn_name) != 0 {
                if emit_ir_mode != 0 {
                    fn_register(fn_name, out_len)
                    ir_init()
                    ir_emit_x86_function(wchild)
                } else {
                    gen_function(wchild)
                }
            }
        }
        uint32 nxt = ast_next(wchild)
        wchild = nxt
    }
    resolve_fixups()
    resolve_fnaddr_fixups()
    while (codegen_output_len() & 7) != 0 { emit_byte(0) }
    uint64 data_start = codegen_output_len()
    emit_static_data()
    resolve_static_fixups(data_start)
    uint64 str_start = codegen_output_len()
    emit_string_data()
    resolve_string_fixups(str_start)
    uint64 text_size = codegen_output_len() - text_start
    uint64 entry_off = find_main_offset()
    if entry_off == 0xFFFFFFFF {
        write(2, "error: no 'main' function found\n", 32)
        uint64 wmsg_3710 = "Every KernRift program needs: fn main() { ... }\n"
        write(2, wmsg_3710, str_len(wmsg_3710))
        exit(1)
    }
    uint64 entry_va = 0x400000 + entry_off
    patch_u32(24, entry_va & 0xFFFFFFFF)
    patch_u32(28, (entry_va >> 32) & 0xFFFFFFFF)
    uint64 total_size_x86 = 120 + text_size
    patch_u32(96, total_size_x86 & 0xFFFFFFFF)
    patch_u32(100, (total_size_x86 >> 32) & 0xFFFFFFFF)
    patch_u32(104, total_size_x86 & 0xFFFFFFFF)
    patch_u32(108, (total_size_x86 >> 32) & 0xFFFFFFFF)

    // Copy x86_64 output to temp buffer
    x86_len = codegen_output_len()
    uint64 x86_buf = alloc(x86_len)
    uint64 xi = 0
    while xi < x86_len {
        uint64 sp = out_buf + xi
        uint64 dp = x86_buf + xi
        uint64 bv = 0
        unsafe { *(sp as uint8) -> bv }
        uint8 bb = bv
        unsafe { *(dp as uint8) = bb }
        xi = xi + 1
    }

    // === Compile ARM64 ===
    set_target_arch(1)
    // Reset codegen for ARM64 pass
    out_len = 0
    fn_count = 0
    fixup_count = 0
    static_fixup_count = 0
    str_fixup_count = 0
    str_len = 0
    extern_fn_count = 0
    extern_call_count = 0
    fnaddr_fixup_count = 0
    static_count = 0
    static_data_size = 0
    struct_count = 0
    struct_var_count = 0
    enum_count = 0
    type_alias_count = 0
    arr_elem_count = 0
    // fn_ret_float_count is deliberately NOT reset here. The float-return
    // table is seeded once at parse time (parser.kr, parse_fn_decl) — same
    // as fn_ret_signed, which this reset never touched either. Clearing it
    // per slice left every slice after the first with an empty table, and
    // only the x86 IR emitter re-registered as it went; the arm64 emitter
    // never did, so `f32_fn() * x` lowered to an integer MUL there.
    // fn_ret_float_register is idempotent, so nothing accumulates.
    fn_ret_struct_count = 0
    line_table_count = 0
    last_recorded_line = 0
    debug_file_count = 0
    diag_count = 0
    diag_error_count = 0
    diag_warn_count = 0
    slice_len_count = 0
    device_count = 0
    device_field_count = 0
    var_type_count = 0
    win_iat_fixup_count = 0
    a64_win_iat_fixup_count = 0

    // Re-parse (need fresh AST; restore source+tokens to pristine state first)
    restore_src_and_tokens(source, size, src_snapshot, my_tokens, tok_bytes, tok_snapshot)
    ast_init(524288)
    parser_init(my_tokens, saved_tcount)
    uint64 root2 = parse_module()
    resolve_inferred_types(root2)

    // Re-run DCE for fresh AST
    inline_pass(root2)
    dce_init()
    dce_scan(root2)

    emit_elf_header_a64()
    emit_program_header_a64(0)
    uint64 text_start_a64 = codegen_output_len()

    uint32 child2 = ast_child(root2)
    uint64 wchild2 = child2
    while wchild2 != 0 {
        uint32 ck2 = ast_kind(wchild2)
        if ck2 == 2 {
            uint32 fn_name2 = ast_data1(wchild2)
            if dce_is_live(fn_name2) != 0 {
                // ARM64 slices go through IR by default (R1 is fixed — the
                // IR ARM64 backend handles compile_fat itself correctly). The
                // legacy path is retained behind `--legacy` as an explicit
                // opt-out, not a silent fallback.
                if emit_ir_mode != 0 {
                    fn_register(fn_name2, out_len)
                    ir_init()
                    ir_emit_arm64_function(wchild2)
                } else {
                    gen_function_a64(wchild2)
                }
            }
        }
        uint32 nxt2 = ast_next(wchild2)
        wchild2 = nxt2
    }
    resolve_fixups_a64()
    resolve_fnaddr_fixups_a64()
    while (codegen_output_len() & 7) != 0 { emit_byte(0) }
    uint64 data_start_a64 = codegen_output_len()
    emit_static_data()
    resolve_static_fixups_a64(data_start_a64)
    uint64 str_start_a64 = codegen_output_len()
    emit_string_data()
    resolve_string_fixups_a64(str_start_a64)
    uint64 text_size_a64 = codegen_output_len() - text_start_a64
    uint64 entry_off_a64 = find_main_offset()
    uint64 entry_va_a64 = 0x400000 + entry_off_a64
    patch_u32(24, entry_va_a64 & 0xFFFFFFFF)
    patch_u32(28, (entry_va_a64 >> 32) & 0xFFFFFFFF)
    uint64 total_a64 = 120 + text_size_a64
    patch_u32(96, total_a64 & 0xFFFFFFFF)
    patch_u32(100, (total_a64 >> 32) & 0xFFFFFFFF)
    patch_u32(104, total_a64 & 0xFFFFFFFF)
    patch_u32(108, (total_a64 >> 32) & 0xFFFFFFFF)

    uint64 a64_len = codegen_output_len()
    uint64 a64_buf = alloc(a64_len)
    uint64 ai = 0
    while ai < a64_len {
        uint64 sp = out_buf + ai
        uint64 dp = a64_buf + ai
        uint64 bv = 0
        unsafe { *(sp as uint8) -> bv }
        uint8 bb = bv
        unsafe { *(dp as uint8) = bb }
        ai = ai + 1
    }

    // === Compile x86_64 PE (Windows) ===
    set_target_arch(0)
    target_os = 2
    out_len = 0
    fn_count = 0
    fixup_count = 0
    static_fixup_count = 0
    str_fixup_count = 0
    str_len = 0
    extern_fn_count = 0
    extern_call_count = 0
    win_iat_fixup_count = 0
    fnaddr_fixup_count = 0
    static_count = 0
    static_data_size = 0
    struct_count = 0
    struct_var_count = 0
    enum_count = 0
    type_alias_count = 0
    arr_elem_count = 0
