                if aid == 1 { buf = x86_buf; len = x86_len }
                if aid == 2 { buf = a64_buf; len = a64_len }
                if aid == 3 { buf = pe_x86_buf; len = pe_x86_len }
                if aid == 4 { buf = pe_a64_buf; len = pe_a64_len }
                if aid == 5 { buf = macho_x86_buf; len = macho_x86_len }
                if aid == 6 { buf = macho_a64_buf; len = macho_a64_len }
                if aid == 7 { buf = android_buf; len = android_len }
                if aid == 8 { buf = androidx_buf; len = androidx_len }
                uint64 cap = lz4_compress_bound(len)
                uint64 cbuf = alloc(cap)
                uint64 clen = lz4_compress_frame(buf, len, cbuf)
                uint64 cp = comp_bufs + bit * 8
                uint64 lp = comp_lens + bit * 8
                uint64 ulp = uncomp_lens + bit * 8
                unsafe { *(cp as uint64) = cbuf }
                unsafe { *(lp as uint64) = clen }
                unsafe { *(ulp as uint64) = len }
                sel_count = sel_count + 1
            }
            aid = aid + 1
        }

        out_len = 0
        emit_krbofat_v2_header(sel_count)
        uint64 c_data_offset = 16 + sel_count * 48
        uint64 c_pad = (16 - (c_data_offset & 15)) & 15
        c_data_offset = c_data_offset + c_pad

        uint64 cur_off = c_data_offset
        uint64 aid2 = 1
        while aid2 <= 8 {
            uint64 bit2 = aid2 - 1
            if ((target_mask >> bit2) & 1) != 0 {
                uint64 lp2 = comp_lens + bit2 * 8
                uint64 ulp2 = uncomp_lens + bit2 * 8
                uint64 clen2 = 0
                uint64 ulen2 = 0
                unsafe { *(lp2 as uint64) -> clen2 }
                unsafe { *(ulp2 as uint64) -> ulen2 }
                emit_krbofat_v2_entry_hdr(aid2, 1, cur_off, clen2, ulen2)
                emit_krbofat_v2_entry_rt(0, ulen2)
                cur_off = cur_off + clen2
            }
            aid2 = aid2 + 1
        }

        uint64 cpi = 0
        while cpi < c_pad { emit_byte(0); cpi = cpi + 1 }

        uint64 aid3 = 1
        while aid3 <= 8 {
            uint64 bit3 = aid3 - 1
            if ((target_mask >> bit3) & 1) != 0 {
                uint64 cp3 = comp_bufs + bit3 * 8
                uint64 lp3 = comp_lens + bit3 * 8
                uint64 cbuf3 = 0
                uint64 clen3 = 0
                unsafe { *(cp3 as uint64) -> cbuf3 }
                unsafe { *(lp3 as uint64) -> clen3 }
                emit_raw_bytes(cbuf3, clen3)
            }
            aid3 = aid3 + 1
        }

        codegen_write_output(output_path)

        uint8[64] nb3
        uint64 msg3 = "custom fat binary: "
        write(1, msg3, 19)
        uint64 nl3 = fmt_uint(nb3, sel_count)
        write(1, nb3, nl3)
        msg3 = " slice"
        write(1, msg3, 6)
        if sel_count != 1 {
            msg3 = "s"
            write(1, msg3, 1)
        }
        msg3 = " -> "
        write(1, msg3, 4)
        uint64 olen3 = str_len(output_path)
        write(1, output_path, olen3)
        msg3 = "\n"
        write(1, msg3, 1)

        // The runner hint, but CONDITIONAL here. A custom subset may exclude
        // the host, and then `kr` fails with "no native binary found for this
        // architecture" -- so an unconditional hint would send the user to a
        // command that cannot work. target_mask bit i is arch id i+1.
        if ((target_mask >> (get_arch_id() - 1)) & 1) != 0 {
            msg3 = "  run it with: kr "
            write(1, msg3, 18)
            write(1, output_path, olen3)
            msg3 = "\n"
            write(1, msg3, 1)
        }
        return
    }

    // === LZ4 compress 4 arch-paired blobs ===
    // Best layout from experimental benchmarks (FAT_COMPRESSION_EXPERIMENTS.md):
    //   x86_64: Linux + macOS,     Windows + Android
    //   arm64:  Linux + Android,   Windows + macOS
    uint64[1] x64_lm_comp_slot
    uint64[1] x64_lm_comp_len_slot
    uint64[1] x64_lm_linux_off_slot
    uint64[1] x64_lm_mac_off_slot
    uint64[1] x64_lm_pair_len_slot
    compress_pair_best(
        x86_buf, x86_len, macho_x86_buf, macho_x86_len,
        x64_lm_comp_slot, x64_lm_comp_len_slot,
        x64_lm_linux_off_slot, x64_lm_mac_off_slot,
        x64_lm_pair_len_slot
    )
    uint64 x64_lm_comp = slot_load_u64(x64_lm_comp_slot)
    uint64 x64_lm_comp_len = slot_load_u64(x64_lm_comp_len_slot)
    uint64 x64_lm_linux_off = slot_load_u64(x64_lm_linux_off_slot)
    uint64 x64_lm_mac_off = slot_load_u64(x64_lm_mac_off_slot)
    uint64 x64_lm_pair_len = slot_load_u64(x64_lm_pair_len_slot)

    uint64[1] x64_wa_comp_slot
    uint64[1] x64_wa_comp_len_slot
    uint64[1] x64_wa_win_off_slot
    uint64[1] x64_wa_android_off_slot
    uint64[1] x64_wa_pair_len_slot
    compress_pair_best(
        pe_x86_buf, pe_x86_len, androidx_buf, androidx_len,
        x64_wa_comp_slot, x64_wa_comp_len_slot,
        x64_wa_win_off_slot, x64_wa_android_off_slot,
        x64_wa_pair_len_slot
    )
    uint64 x64_wa_comp = slot_load_u64(x64_wa_comp_slot)
    uint64 x64_wa_comp_len = slot_load_u64(x64_wa_comp_len_slot)
    uint64 x64_wa_win_off = slot_load_u64(x64_wa_win_off_slot)
    uint64 x64_wa_android_off = slot_load_u64(x64_wa_android_off_slot)
    uint64 x64_wa_pair_len = slot_load_u64(x64_wa_pair_len_slot)

    uint64[1] arm_la_comp_slot
    uint64[1] arm_la_comp_len_slot
    uint64[1] arm_la_linux_off_slot
    uint64[1] arm_la_android_off_slot
    uint64[1] arm_la_pair_len_slot
    compress_pair_best(
        a64_buf, a64_len, android_buf, android_len,
        arm_la_comp_slot, arm_la_comp_len_slot,
        arm_la_linux_off_slot, arm_la_android_off_slot,
        arm_la_pair_len_slot
    )
    uint64 arm_la_comp = slot_load_u64(arm_la_comp_slot)
    uint64 arm_la_comp_len = slot_load_u64(arm_la_comp_len_slot)
    uint64 arm_la_linux_off = slot_load_u64(arm_la_linux_off_slot)
    uint64 arm_la_android_off = slot_load_u64(arm_la_android_off_slot)
    uint64 arm_la_pair_len = slot_load_u64(arm_la_pair_len_slot)

    uint64[1] arm_wm_comp_slot
    uint64[1] arm_wm_comp_len_slot
    uint64[1] arm_wm_win_off_slot
    uint64[1] arm_wm_mac_off_slot
    uint64[1] arm_wm_pair_len_slot
    compress_pair_best(
        pe_a64_buf, pe_a64_len, macho_a64_buf, macho_a64_len,
        arm_wm_comp_slot, arm_wm_comp_len_slot,
        arm_wm_win_off_slot, arm_wm_mac_off_slot,
        arm_wm_pair_len_slot
    )
    uint64 arm_wm_comp = slot_load_u64(arm_wm_comp_slot)
    uint64 arm_wm_comp_len = slot_load_u64(arm_wm_comp_len_slot)
    uint64 arm_wm_win_off = slot_load_u64(arm_wm_win_off_slot)
    uint64 arm_wm_mac_off = slot_load_u64(arm_wm_mac_off_slot)
    uint64 arm_wm_pair_len = slot_load_u64(arm_wm_pair_len_slot)

    // === Emit KrboFat v2 ===
    out_len = 0
    emit_krbofat_v2_header(8)
    uint64 data_offset = 16 + 8 * 48
    uint64 pad = (16 - (data_offset & 15)) & 15
    data_offset = data_offset + pad
    uint64 blob1_data_off = data_offset
    uint64 blob2_data_off = blob1_data_off + x64_lm_comp_len
    uint64 blob3_data_off = blob2_data_off + x64_wa_comp_len
    uint64 blob4_data_off = blob3_data_off + arm_la_comp_len

    // Entry fields: arch_id, compression, blob_offset, blob_comp_size,
    // slice_uncomp_size, slice_offset_in_pair, pair_uncomp_size.
    emit_krbofat_v2_entry_hdr(1, 1, blob1_data_off, x64_lm_comp_len, x86_len)
    emit_krbofat_v2_entry_rt(x64_lm_linux_off, x64_lm_pair_len)
    emit_krbofat_v2_entry_hdr(2, 1, blob3_data_off, arm_la_comp_len, a64_len)
    emit_krbofat_v2_entry_rt(arm_la_linux_off, arm_la_pair_len)
    emit_krbofat_v2_entry_hdr(3, 1, blob2_data_off, x64_wa_comp_len, pe_x86_len)
    emit_krbofat_v2_entry_rt(x64_wa_win_off, x64_wa_pair_len)
    emit_krbofat_v2_entry_hdr(4, 1, blob4_data_off, arm_wm_comp_len, pe_a64_len)
    emit_krbofat_v2_entry_rt(arm_wm_win_off, arm_wm_pair_len)
    emit_krbofat_v2_entry_hdr(5, 1, blob1_data_off, x64_lm_comp_len, macho_x86_len)
    emit_krbofat_v2_entry_rt(x64_lm_mac_off, x64_lm_pair_len)
    emit_krbofat_v2_entry_hdr(6, 1, blob4_data_off, arm_wm_comp_len, macho_a64_len)
    emit_krbofat_v2_entry_rt(arm_wm_mac_off, arm_wm_pair_len)
    emit_krbofat_v2_entry_hdr(7, 1, blob3_data_off, arm_la_comp_len, android_len)
    emit_krbofat_v2_entry_rt(arm_la_android_off, arm_la_pair_len)
    emit_krbofat_v2_entry_hdr(8, 1, blob2_data_off, x64_wa_comp_len, androidx_len)
    emit_krbofat_v2_entry_rt(x64_wa_android_off, x64_wa_pair_len)

    uint64 pi = 0
    while pi < pad { emit_byte(0); pi = pi + 1 }

    emit_raw_bytes(x64_lm_comp, x64_lm_comp_len)
    emit_raw_bytes(x64_wa_comp, x64_wa_comp_len)
    emit_raw_bytes(arm_la_comp, arm_la_comp_len)
    emit_raw_bytes(arm_wm_comp, arm_wm_comp_len)

    codegen_write_output(output_path)

    uint8[64] nb
    uint64 msg = "fat binary: x86_64("
    write(1, msg, 19)
    uint64 nl = fmt_uint(nb, x86_len)
    write(1, nb, nl)
    msg = ") + arm64("
    write(1, msg, 10)
    nl = fmt_uint(nb, a64_len)
    write(1, nb, nl)
    msg = ") + win-x64("
    write(1, msg, 12)
    nl = fmt_uint(nb, pe_x86_len)
    write(1, nb, nl)
    msg = ") + win-arm("
    write(1, msg, 12)
    nl = fmt_uint(nb, pe_a64_len)
    write(1, nb, nl)
    msg = ") + mac-x64("
    write(1, msg, 12)
    nl = fmt_uint(nb, macho_x86_len)
    write(1, nb, nl)
    msg = ") + mac-arm("
    write(1, msg, 12)
    nl = fmt_uint(nb, macho_a64_len)
    write(1, nb, nl)
    msg = ") + android-arm64("
    write(1, msg, 18)
    nl = fmt_uint(nb, android_len)
    write(1, nb, nl)
    msg = ") + android-x64("
    write(1, msg, 16)
    nl = fmt_uint(nb, androidx_len)
    write(1, nb, nl)
    msg = ") -> "
    write(1, msg, 5)
    uint64 olen = str_len(output_path)
    write(1, output_path, olen)
    // Same "(X.XX ms)" timer as single-file compile(). Gated on t_start_fat
    // having landed as non-zero — older target_os paths that stub time_ns()
    // to 0 just fall back to the plain newline.
    uint64 t_end_fat = time_ns()
    if t_start_fat != 0 {
        uint64 elapsed_fat = t_end_fat - t_start_fat
        uint64 ms_whole_f = elapsed_fat / 1000000
        uint64 ms_hund_f  = (elapsed_fat / 10000) % 100
        msg = "  ("
        write(1, msg, 3)
        uint64 w_len_f = fmt_uint(nb, ms_whole_f)
        write(1, nb, w_len_f)
        msg = "."
        write(1, msg, 1)
        uint8[2] hb_f
        uint8 d0_f = 48 + (ms_hund_f / 10)
        uint8 d1_f = 48 + (ms_hund_f % 10)
        unsafe { *(hb_f as uint8) = d0_f }
        uint64 hb_f1 = hb_f + 1
        unsafe { *(hb_f1 as uint8) = d1_f }
        write(1, hb_f, 2)
        msg = " ms)\n"
        write(1, msg, 5)
    } else {
        msg = "\n"
        write(1, msg, 1)
    }

    // Bare `krc` emits a fat binary BY DEFAULT, and a shell will not execute
    // one. So the default first experience is a file that does not run, with
    // nothing on screen saying what does. `kr` is that thing, it exists
    // (src/runner.kr), and it was previously undiscoverable from this output.
    //
    // Appended rather than folded into the line above so the slice enumeration
    // and byte counts stay byte-identical for anything reading them.
    uint64 hint = "  run it with: kr "
    write(1, hint, 18)
    write(1, output_path, olen)
    msg = "\n"
    write(1, msg, 1)
}

// Statics set by _start trampoline
static uint64 cli_argc = 0
static uint64 cli_argv = 0

// Type-checker gate. Default ON; --no-check-types disables for
// emergency builds. Phase 1 rules emit errors; Phase 2 rules (added
// later) emit warnings until their violation counts are triaged.
static uint64 check_types_enabled = 1

// Living compiler CLI options
static uint64 lc_ci_mode = 0
static uint64 lc_min_fitness = 0
static uint64 lc_fix_mode = 0
static uint64 lc_undo_mode = 0
static uint64 lc_dry_run = 0
static uint64 lc_list_proposals = 0
static uint64 lc_promote_name = 0
static uint64 lc_deprecate_name = 0
static uint64 lc_reject_name = 0
static uint64 freestanding = 0

// --emit=image state. load_addr is VALIDATION AND REPORTING ONLY — it is
// never embedded in the artifact (x86_64 is fully RIP-relative; arm64 is
// position-independent modulo 4 KiB, both verified by boots at shifted
// addresses). Statics rather than locals so compile() can read them, the
// same forward-reference shape freestanding uses at :2340.
static uint64 load_addr = 0
static uint64 load_addr_set = 0

// --stack-top= state (sub-project B2, D4): the flag's PRESENCE is the opt-in
// for entry-stub emission -- the arm64 stub block and emit_x86_image_stub's
// multiboot header + long-mode trampoline both read stack_top_set as their
// gate, and so does the stack-vs-image refusal in the --emit=image finalize.
// Statics rather than locals for the same forward-reference reason as
// load_addr above (compile() can read them).
// Deliberately NO default: an unset stack means "no stub", never "guess
// one" -- a silently defaulted stack boots on the author's board and faults
// silently on someone else's.
static uint64 stack_top = 0
static uint64 stack_top_set = 0

// --image-header state (sub-project C). Requires --emit=image, --arch=arm64
// and --stack-top= together, validated where --stack-top='s own checks live.
// Set, it makes the emit_mode 8 path prefix the artifact with the 64-byte
// arm64 Linux `Image` header (Task 2 -- the emission block, and the two
// patch-backs it needs, are the three `a64hdr_on` sites). Unset, no byte the
// compiler writes changes: every --emit=image pin in the suite builds without
// this flag and is unaffected by it.
static uint64 image_header_set = 0

// --reset-vector state (sub-project E). A bare boolean, like --image-header --
// no value to parse. Requires --emit=image, --arch=x86_64, --target=none and
// --stack-top= (all validated where the flag is parsed below); refuses
// --load-addr= (measured meaningless for this form -- spec E S8 Q2: the
// x86_64 --emit=image payload is byte-identical at --load-addr=0x100000 and
// 0x20000000, because the reset-vector form's payload always lands at the
// fixed physical address 0x100000, never at a user-chosen one).
//
// stack_top_set is READ but its GATE MEANING IS NOT REUSED: under B1/B2,
// stack_top_set != 0 means "emit B2's multiboot stub". Under --reset-vector
// it means something different -- "rsp for the reset-vector stage's own
// trampoline, which Task 2 emits" -- so every site that gates stub emission
// on stack_top_set alone must also exclude reset_vector_set (Task 1 Step 5).
// Task 1 emits no stage bytes; it only makes the flag exist, refuses the six
// wrong invocations, and stops B2's stub from firing when this is set. The
// stack VALUE Task 2 needs is exactly stack_top, already parsed above --
// nothing new to store for it.
static uint64 reset_vector_set = 0

// ---------------------------------------------------------------------------
// --emit=fatimage state.
// ---------------------------------------------------------------------------
//
// A fat image is ONE FILE WITH SEVERAL BOOT PATHS, so every piece of state
// below is PER SLICE. That is the whole reason these cannot reuse load_addr /
// stack_top above: those are one value each, and the x86_64 slice and the
// arm64 slice have different ones by construction -- they are loaded by
// different firmware, at different addresses, on different machines.
//
// TWO ARCHITECTURES, ENUMERATED, NOT AN ARRAY INDEXED BY arch. The container
// has exactly two boot paths this compiler has ever booted (x86_64 multiboot
// and arm64 raw `Image`), the --arch= validation refuses anything else, and an
// array would invite a third arch to be added here without adding its boot
// path -- which is a fat image that silently carries a slice nothing enters.
// Adding riscv32 later means adding its rows here AND its entry indirection in
// the composer, and the shape of this state is what makes that obvious.
//
// THE DEFAULTS ARE REAL VALUES, NOT ZERO SENTINELS, and this is the one place
// in the bare-metal flag surface where a default address is allowed. The rule
// stack_top states above -- "an unset stack means 'no stub', never 'guess
// one'" -- is about a value the compiler cannot know: --emit=image builds a
// blob for SOMEBODY ELSE'S loader, on a board the compiler has never seen. A
// fat image is the opposite case: it names its own loaders (multiboot, the
// arm64 boot protocol, UEFI), each of which fixes where the file lands, so the
// addresses ARE knowable and a defaulted one is a derivation rather than a
// guess. Both are still overridable, and the report prints what was used.
//
//   x86_64 load base 0x00400000 (4194304). The classic multiboot kernel
//     address: above the 1 MiB hole, and the self-boot trampoline's own rules
//     bracket it hard -- it must be >= 0x4000 (below that the trampoline
//     zeroes its page-table region over the image) and the image must end
//     below 0x40000000 (the trampoline's identity map is one page directory of
//     2 MiB pages, exactly 1 GiB). 4 MiB leaves the whole 0x4000..0x400000
//     band free for the stack and clears the hole.
//   x86_64 stack top 0x003F0000 (4128768). 64 KiB BELOW the load base, so the
//     stack grows down AWAY from the image and can never reach it -- the
//     stack-vs-image refusal in the --emit=image finalize is what would
//     otherwise fire. It also clears the trampoline's page tables at
//     0x1000-0x4000 by ~4 MiB, and is under both the 2^31 encoding bound and
//     the 1 GiB map ceiling.
//   arm64 load base 0x40000000 (1073741824). RAM base on QEMU `virt`, and the
//     conventional DRAM base for the arm64 boot protocol. 4096-aligned, which
//     arm64 requires (ADRP page arithmetic is baked at compile time).
//   arm64 stack top 0x40800000 (1082130432). 8 MiB into RAM: far above any
//     slice this container has ever carried, 16-byte aligned (aarch64 faults
//     on the first unaligned SP access) and below 2^32 (the stub materialises
//     SP with a movz/movk pair covering bits 31:0 only).
//
// The load bases are BASES OF THE WHOLE FILE, not of a slice. Each slice's own
// --load-addr is base + its file offset, computed by the composer -- which is
// the only place those offsets exist, since they depend on how long the
// preceding slices turned out to be.
static uint64 fat_arch_mask = 0
static uint64 fat_arch_list_set = 0
static uint64 fat_slice_x86 = 0
static uint64 fat_slice_a64 = 0
static uint64 fat_slice_seen = 0
static uint64 fat_load_x86 = 4194304
static uint64 fat_load_x86_set = 0
static uint64 fat_load_a64 = 1073741824
static uint64 fat_load_a64_set = 0
static uint64 fat_stack_x86 = 4128768
static uint64 fat_stack_x86_set = 0
static uint64 fat_stack_a64 = 1082130432
static uint64 fat_stack_a64_set = 0

// Which architecture gets the UEFI/PE boot path. 0 = x86_64, 1 = arm64,
// 254 = none (no PE in the file). 255 = the user did not say, so the composer
// derives it and PRINTS what it derived.
//
// EXACTLY ONE, AND THAT IS A PROPERTY OF PE RATHER THAN A SHORTCUT: the COFF
// header carries a single Machine value and firmware checks it, so one PE
// cannot serve two processors. The flag therefore takes ONE arch, and asking
// it for two is refused with that sentence rather than silently honouring the
// last one.
static uint64 fat_uefi_arch = 255
static uint64 fat_uefi_set = 0

// Slice-capture channel between compile() and the composer. compile() is
// re-entrant (it calls set_target_arch/import_init/lexer_init/ast_init/
// codegen_init/parser_init itself), so the composer just calls it once per
// slice -- but compile() WRITES A FILE, and under --emit=fatimage the file it
// would write is the fat image's own path, once per pass. fat_capture turns
// that write into a copy into these three globals instead. See the hook at the
// bottom of compile() for why the buffer is copied rather than borrowed.
static uint64 fat_capture = 0
static uint64 fat_cap_buf = 0
static uint64 fat_cap_len = 0
static uint64 fat_cap_entry = 0

// Machine target (--target=esp32): 0 = none, 1 = ESP32 (Xtensa LX6 esp-image
// at ESP32 load addresses). Orthogonal to target_os — --target= is overloaded:
// OS names set target_os, machine names set this. Only meaningful with
// --arch=xtensa --freestanding (validated after arg parsing, so flag order
// doesn't matter).
static uint64 machine_target = 0

fn parse_uint_arg(uint64 s) -> uint64 {
    uint64 val = 0
    uint64 i = 0
    uint64 p = s + i
    uint64 c = 0
    unsafe { *(p as uint8) -> c }
    while c >= 48 && c <= 57 {
        val = val * 10 + (c - 48)
        i = i + 1
        p = s + i
        unsafe { *(p as uint8) -> c }
    }
    return val
}

// Legal --arch x --target(OS) pairs, ENUMERATED.
//
//   arch: 0 x86_64, 1 arm64, 2 riscv32, 3 xtensa
//   os:   0 linux,  1 macos, 2 windows, 3 android, 4 none
//
// Deliberately an allow-list with a `return 0` fall-through, NOT a blacklist
// of the pairs that are broken today. A blacklist passes every test the day
// it is written and then silently admits whichever arch or OS is added next
// — which is the same "else, assume POSIX" shape that put a Linux exit
// syscall inside a bare-metal image and that this whole sub-project exists to
// remove. Adding an arch here without adding its row is a hard error at the
// first build, not a nonsense artifact.
//
// Before this existed there was no arch/OS validation at all: `--arch=riscv32
// --target=windows` exited 0 and wrote a 296-byte RISC-V *ELF* — a PE was
// requested, an ELF was produced, and neither the requested OS nor the
// requested container appeared anywhere in the output.
fn arch_os_pair_supported(uint64 arch, uint64 os) -> uint64 {
    if arch == 0 {
        // x86_64 — all four hosted OSes (it is one of the two fat-binary
        // slice arches, so every hosted OS must build) plus bare metal.
        if os == 0 { return 1 }
        if os == 1 { return 1 }
        if os == 2 { return 1 }
        if os == 3 { return 1 }
        if os == 4 { return 1 }
        return 0
    }
    if arch == 1 {
        // arm64 — the other fat-binary slice arch; same five.
        if os == 0 { return 1 }
        if os == 1 { return 1 }
        if os == 2 { return 1 }
        if os == 3 { return 1 }
        if os == 4 { return 1 }
        return 0
    }
    if arch == 2 {
        // riscv32 — hosted RV32 Linux ELF, and bare metal. There is no
        // macOS, Windows or Android on RV32 for this compiler to target: no
        // Mach-O/PE writer accepts an RV32 machine type, and the Android
        // path is arm64/x86_64 only.
        if os == 0 { return 1 }
        if os == 4 { return 1 }
        return 0
    }
    if arch == 3 {
        // xtensa — bare metal, and os == 0 because 0 is the DEFAULT value of
        // target_os: every existing `--arch=xtensa --freestanding` and
        // `--target=esp32` invocation carries it without ever naming an OS,
        // so rejecting the pair here would reject all of them. It does not
        // mean hosted Xtensa Linux works — that still fails downstream with
        // "xtensa ELF image emission not yet implemented", which is the
        // accurate diagnostic for it.
        if os == 0 { return 1 }
        if os == 4 { return 1 }
        return 0
    }
    return 0
}

// One message, one place. Every --load-addr= parse failure exits through here
// rather than repeating the literal at each rejection site: the suite greps
// this text, and three copies is three chances for one of them to drift.
fn load_addr_die() {
    uint64 la_bad = "error: --load-addr= wants a decimal or 0x-prefixed hex address\n"
    write(2, la_bad, str_len(la_bad))
    exit(1)
}

// --load-addr= value: plain decimal or 0x/0X-prefixed hex. Anything else —
// empty, stray characters, bare "0x", more than 16 digits — refuses loudly:
// this value feeds the arm64 alignment check, and a malformed input that
// silently parsed as 0 would PASS that check while meaning nothing.
fn parse_load_addr(uint64 s) -> uint64 {
    uint64 p = s
    uint64 base = 10
    uint64 c0 = 0
    unsafe { *(p as uint8) -> c0 }
    if c0 == 48 {
        uint64 p1 = p + 1
        uint64 c1 = 0
        unsafe { *(p1 as uint8) -> c1 }
        if c1 == 120 || c1 == 88 {
            base = 16
            p = p + 2
        }
    }
    uint64 v = 0
    uint64 ndigits = 0
    loop {
        uint64 c = 0
        unsafe { *(p as uint8) -> c }
        if c == 0 { break }
        uint64 d = 99
        if c >= 48 && c <= 57 { d = c - 48 }
        if base == 16 && c >= 97 && c <= 102 { d = c - 87 }
        if base == 16 && c >= 65 && c <= 70 { d = c - 55 }
        if d == 99 { load_addr_die() }
        v = v * base + d
        ndigits = ndigits + 1
        // Overflow guard: 16 hex digits is a full uint64, and anything longer
        // has already wrapped silently by the time we could notice.
        if ndigits > 16 { load_addr_die() }
        p = p + 1
    }
    // Catches both "--load-addr=" (empty) and "--load-addr=0x" (prefix only).
    if ndigits == 0 { load_addr_die() }
    return v
}

// One message, one place, mirroring load_addr_die() above. Every
// --stack-top= parse failure exits through here rather than repeating the
// literal at each site.
fn stack_top_die() {
    uint64 st_bad = "error: --stack-top= wants a decimal or 0x-prefixed hex address\n"
    write(2, st_bad, str_len(st_bad))
    exit(1)
}

// --stack-top= value: same grammar as --load-addr= (parse_load_addr above)
// -- plain decimal or 0x/0X-prefixed hex. Duplicated rather than shared:
// the two flags have independent die() paths naming independent flags, and
// a shared parser would need a function-pointer callback to keep that, for
// no real savings over these ~30 lines.
fn parse_stack_top(uint64 s) -> uint64 {
    uint64 p = s
    uint64 base = 10
    uint64 c0 = 0
    unsafe { *(p as uint8) -> c0 }
    if c0 == 48 {
        uint64 p1 = p + 1
        uint64 c1 = 0
        unsafe { *(p1 as uint8) -> c1 }
        if c1 == 120 || c1 == 88 {
            base = 16
            p = p + 2
        }
    }
    uint64 v = 0
    uint64 ndigits = 0
    loop {
        uint64 c = 0
        unsafe { *(p as uint8) -> c }
        if c == 0 { break }
        uint64 d = 99
        if c >= 48 && c <= 57 { d = c - 48 }
        if base == 16 && c >= 97 && c <= 102 { d = c - 87 }
        if base == 16 && c >= 65 && c <= 70 { d = c - 55 }
        if d == 99 { stack_top_die() }
        v = v * base + d
        ndigits = ndigits + 1
        // Overflow guard: 16 hex digits is a full uint64, and anything
        // longer has already wrapped silently by the time we could notice.
        if ndigits > 16 { stack_top_die() }
        p = p + 1
    }
    // Catches both "--stack-top=" (empty) and "--stack-top=0x" (prefix only).
    if ndigits == 0 { stack_top_die() }
    return v
}

// Spellings for the pair diagnostic. These are the --arch= / --target= values
// a user actually types, so the message can be copy-edited back into a
// working command line.
fn arch_flag_name(uint64 arch) -> uint64 {
    if arch == 1 { return "arm64" }
    if arch == 2 { return "riscv32" }
    if arch == 3 { return "xtensa" }
    return "x86_64"
}

fn target_os_flag_name(uint64 os) -> uint64 {
    if os == 1 { return "macos" }
    if os == 2 { return "windows" }
    if os == 3 { return "android" }
    if os == 4 { return "none" }
    return "linux"
}

// ===========================================================================
// --emit=fatimage: ONE boot image with several boot paths.
// ===========================================================================
//
// NOT POLYGLOT MACHINE CODE. That would be a stunt and it is not what the
// problem needs. The observation that makes this tractable is:
//
//     OF THE FORMATS INVOLVED, ONLY arm64's `Image` EXECUTES FROM OFFSET 0,
//     AND EVEN THERE BYTE 0 IS A BRANCH.
//
//   * arm64 `Image`  -- the loader places the file and jumps to its first
//                       byte. `code0` is a branch, so it can reach anywhere
//                       in the file.
//   * x86 multiboot  -- the loader never looks at byte 0. It SCANS the first
//                       8 KiB for a magic and then honours `entry_addr`.
//   * PE / UEFI      -- firmware reads "MZ" at byte 0 and follows `e_lfanew`
//                       at byte 60 to the real header.
//
// So this is several ENTRY INDIRECTIONS into several complete, independently
// compiled slices. Each architecture carries the other's bytes as dead
// weight, which is precisely what a fat binary is.
//
//     offset 0x0000   DOS stub / arm64 Image header -- THE SAME 64 BYTES
//                       code0 = 0x91005A4D: its low half is "MZ" for PE, and
//                               it decodes as `add x13, x18, #0x16` on arm64
//                       code1 = b <arm64 slice entry>
//                       image_size at 16, flags at 24, "ARM\x64" at 56
//                       e_lfanew at 60 -> the PE header, where krc put it
//     offset 0x0040   PE headers, byte-for-byte from --emit=uefi
//     offset 0x0400   a standalone multiboot header, inside the 8 KiB scan
//     offset 0x1000   UEFI .text, untouched (PointerToRawData is 0x1000)
//     offset ...      the x86_64 multiboot slice   (4096-aligned)
//     offset ...      the arm64 raw slice          (4096-aligned)
//
// THE OFFSET-0 COLLISION, AND THE CONSTANT THAT DISSOLVES IT. PE demands "MZ"
// at byte 0; arm64 EXECUTES byte 0. Linux resolved this years ago and the
// resolution is 0x91005A4D: one 32-bit word whose first two bytes spell MZ and
// whose AArch64 meaning is an add into a scratch register. Decoded rather than
// copied: sf=1, family 0b100010 (ADD immediate), shift=00, imm12=0x016, Rn=18,
// Rd=13, i.e. `add x13, x18, #0x16` -- and x13 is scratch here because the
// arm64 boot protocol hands over only x0 (the DTB pointer). arm64 executes it
// and falls through to the branch at byte 4; a PE loader reads two characters
// and jumps to e_lfanew.
//
// WHY THE UEFI SLICE IS THE BASE FILE. krc emits e_lfanew = 0x40 and one
// section at PointerToRawData = 0x1000, so building the composite ON TOP of
// that output leaves every PE file offset already correct and needs no
// section-table rewriting. Only the DOS stub is overwritten, and a PE loader
// reads nothing there but e_lfanew -- which is restored byte-for-byte.
//
// WHY THE HEADERS DO NOT COLLIDE. The arm64 header owns bytes 0-63 and the
// composer ASSERTS that no 4-byte-aligned word anywhere before 0x400 equals
// the multiboot magic (the "first magic found is ours" check below), so the
// x86 scan cannot false-positive on it. The arm64 loader reads only those 64
// bytes plus whatever code0 branches to, so nothing the x86 slice contains can
// disturb it. Blind to each other by construction, not by luck.
//
// UEFI IS ONE ARCHITECTURE, AND THAT IS PE's PROPERTY, NOT A SHORTCUT. The
// COFF header carries exactly one Machine value and firmware checks it, so one
// PE cannot serve both processors. The default composition is therefore THREE
// boot paths, not four: x86_64 multiboot, x86_64 UEFI, arm64 raw Image. An
// arm64 UEFI boot would need a second PE and there is nowhere for its Machine
// value to live.
//
// WHAT THE BOOT GATE CANNOT PROVE, said plainly rather than implied away.
// QEMU reads the whole file regardless of `image_size` and regardless of the
// multiboot `load_addr` patch, so booting cannot witness either field; they
// are written because they are what the formats specify and what U-Boot and
// the arm64 boot protocol do honour. The fields booting DOES witness are
// code0/code1 (replace the branch with a NOP and the arm64 path dies while
// x86_64 is untouched) and the multiboot `entry_addr`.

// Index of the first `b` in a NUL-terminated string, or 0xFFFFFFFF. The three
// flag values this feature parses are all "<name><separator><rest>" and the
// separator is what tells the per-arch form apart from the plain one -- a
// comma in --arch=, a colon in --slice= / --load-addr= / --stack-top=.
//
// FIRST occurrence, deliberately, and it matters for exactly one case:
// `--slice=arm64:C:\build\slice.img` on Windows. Splitting on the last colon
// would take the drive letter for the architecture name.
fn fatimg_find_byte(uint64 s, uint64 b) -> uint64 {
    uint64 i = 0
    uint64 c = 1
    while c != 0 {
        uint64 p = s + i
        unsafe { *(p as uint8) -> c }
        if c == b { return i }
        i = i + 1
    }
    return 0xFFFFFFFF
}

// Architecture id from a name slice of known length (no NUL to stop at, since
// these names are embedded in a longer argument).
//
// THE SAME SPELLINGS THE SINGLE-ARCH --arch= ACCEPTS, and that is not
// cosmetic: a user who has typed `--arch=amd64` for years and then writes
// `--arch=amd64,arm64` must not be told amd64 is unknown. riscv32 and xtensa
// are RECOGNISED here rather than falling into the unknown-name arm, so their
// refusals can say why a fat image has no path for them instead of implying a
// typo.
fn fatimg_arch_from_name(uint64 s, uint64 len) -> uint64 {
    if targets_name_eq(s, len, "x86_64") != 0 { return 0 }
    if targets_name_eq(s, len, "x86-64") != 0 { return 0 }
    if targets_name_eq(s, len, "amd64") != 0 { return 0 }
    if targets_name_eq(s, len, "x64") != 0 { return 0 }
    if targets_name_eq(s, len, "arm64") != 0 { return 1 }
    if targets_name_eq(s, len, "aarch64") != 0 { return 1 }
    if targets_name_eq(s, len, "riscv32") != 0 { return 2 }
    if targets_name_eq(s, len, "xtensa") != 0 { return 3 }
    return 0xFF
}

// The two "this architecture has no fat-image boot path" refusals, in ONE
// place: --arch=, --slice= and --fat-uefi= all reach them and the wording must
// not drift between the three. Each message carries a substring UNIQUE to its
// arch, for the reason the --emit=uefi rows document -- a shared
// "x86_64/arm64 only" half would let a defect that routed one arch to the
// other's arm still pass a grep.
fn fatimg_refuse_arch(uint64 a, uint64 flag) {
    if a == 2 {
        write(2, "error: ", 7)
        write(2, flag, str_len(flag))
        uint64 mr = " does not accept riscv32: a fat image is a composition of BOOT PATHS, and this container has two -- the x86_64 multiboot header and the arm64 Image header. There is no riscv32 boot path in it, and a slice nothing enters is dead weight with no way to reach it. Use --arch=riscv32 --freestanding for a standalone raw boot image\n"
        write(2, mr, str_len(mr))
        exit(1)
    }
    if a == 3 {
        write(2, "error: ", 7)
        write(2, flag, str_len(flag))
        uint64 mx = " does not accept xtensa: a fat image is a composition of BOOT PATHS, and this container has two -- the x86_64 multiboot header and the arm64 Image header. The chip's loader reads neither. Use --arch=xtensa --freestanding (lx60 boot ELF) or --target=esp32 (esp-image) for a standalone image\n"
        write(2, mx, str_len(mx))
        exit(1)
    }
}

// --arch=<a>,<b> -- the LIST form, reached only when a comma is present, so
// every single-arch invocation this compiler has ever accepted takes the
// existing chain untouched and is byte-identical by construction.
fn parse_fat_arch_list(uint64 list) {
    uint64 mask = 0
    uint64 i = 0
    uint64 c = 0
    uint64 p0 = list
    unsafe { *(p0 as uint8) -> c }
    while c != 0 {
        uint64 start = i
        while c != 0 && c != 44 {
            i = i + 1
            uint64 pn = list + i
            unsafe { *(pn as uint8) -> c }
        }
        uint64 tok = list + start
        uint64 tlen = i - start
        if tlen == 0 {
            uint64 me = "error: --arch= has an empty element in its list: write the architectures separated by single commas, as --arch=x86_64,arm64\n"
            write(2, me, str_len(me))
            exit(1)
        }
        uint64 a = fatimg_arch_from_name(tok, tlen)
        if a == 0xFF {
            uint64 mu = "error: --arch= list contains an unknown architecture '"
            write(2, mu, str_len(mu))
            write(2, tok, tlen)
            mu = "' (use x86_64|arm64)\n"
            write(2, mu, str_len(mu))
            exit(1)
        }
        fatimg_refuse_arch(a, "the --arch= list")
        uint64 bit = 1 << a
        if (mask & bit) != 0 {
            uint64 md = "error: --arch= names '"
            write(2, md, str_len(md))
            write(2, tok, tlen)
            md = "' twice: a fat image carries one slice per architecture, so a repeated name is either a typo for the other architecture or a request the container cannot express\n"
            write(2, md, str_len(md))
            exit(1)
        }
        mask = mask | bit
        if c == 44 {
            i = i + 1
            uint64 pc = list + i
            unsafe { *(pc as uint8) -> c }
        }
    }
    fat_arch_mask = mask
    fat_arch_list_set = 1
}

// --slice=<arch>:<file>
//
// WHY THIS EXISTS AT ALL, given that --emit=fatimage can compile the same
// source once per architecture. The real consumer of this feature has a
// DIFFERENT PROGRAM per architecture -- ApexRift's kernel is x86-only and its
// arm64 slice is a separate source entirely -- so pure multi-pass cannot
// express its actual case. Mixing the two is the normal shape: compile the
// architecture the source is written for, adopt a prebuilt image for the
// other.
fn parse_fat_slice_arg(uint64 v) {
    uint64 ci = fatimg_find_byte(v, 58)
    if ci == 0xFFFFFFFF || ci == 0 {
        uint64 mf = "error: --slice= wants <arch>:<file>, for example --slice=arm64:build/arm64.img: the architecture has to be named because the fat image places each slice at its own file offset and enters it through that architecture's own boot header\n"
        write(2, mf, str_len(mf))
        exit(1)
    }
    uint64 a = fatimg_arch_from_name(v, ci)
    if a == 0xFF {
        uint64 mu = "error: --slice= names an unknown architecture '"
        write(2, mu, str_len(mu))
        write(2, v, ci)
        mu = "' (use x86_64|arm64)\n"
        write(2, mu, str_len(mu))
        exit(1)
    }
    fatimg_refuse_arch(a, "--slice=")
    uint64 path = v + ci + 1
    uint64 c0 = 0
    unsafe { *(path as uint8) -> c0 }
    if c0 == 0 {
        uint64 mp = "error: --slice= has an empty file path after the architecture name\n"
        write(2, mp, str_len(mp))
        exit(1)
    }
    if a == 0 {
        if fat_slice_x86 != 0 {
            uint64 md = "error: --slice=x86_64: was given twice: a fat image has one x86_64 slice, so the second path would silently replace the first\n"
            write(2, md, str_len(md))
            exit(1)
        }
        fat_slice_x86 = path
    } else {
        if fat_slice_a64 != 0 {
            uint64 md2 = "error: --slice=arm64: was given twice: a fat image has one arm64 slice, so the second path would silently replace the first\n"
            write(2, md2, str_len(md2))
            exit(1)
        }
        fat_slice_a64 = path
    }
    fat_slice_seen = 1
}

// --load-addr=<arch>:<addr> (kind 0) and --stack-top=<arch>:<addr> (kind 1).
// Reached only when the value carries a colon, so the plain single-image forms
// of both flags are untouched.
fn parse_fat_addr_arg(uint64 v, uint64 ci, uint64 kind) {
    uint64 a = fatimg_arch_from_name(v, ci)
    if a == 0xFF {
        uint64 mu = "error: the per-architecture form of --load-addr=/--stack-top= names an unknown architecture '"
        write(2, mu, str_len(mu))
        write(2, v, ci)
        mu = "' (use x86_64|arm64)\n"
        write(2, mu, str_len(mu))
        exit(1)
    }
    fatimg_refuse_arch(a, "the per-architecture form of --load-addr=/--stack-top=")
    if kind == 0 {
        uint64 lv = parse_load_addr(v + ci + 1)
        if a == 0 {
            fat_load_x86 = lv
            fat_load_x86_set = 1
        } else {
            fat_load_a64 = lv
            fat_load_a64_set = 1
        }
    } else {
        uint64 sv = parse_stack_top(v + ci + 1)
        if a == 0 {
            fat_stack_x86 = sv
            fat_stack_x86_set = 1
        } else {
            fat_stack_a64 = sv
            fat_stack_a64_set = 1
        }
    }
}

// --fat-uefi=<arch>|none
fn parse_fat_uefi_arg(uint64 v) {
    uint64 comma = fatimg_find_byte(v, 44)
    if comma != 0xFFFFFFFF {
        uint64 mc = "error: --fat-uefi= takes ONE architecture, never a list: a PE's COFF header carries exactly one Machine value and firmware checks it, so a single file cannot be a UEFI application for two processors. A fat image is therefore PE for at most one architecture -- pick the one whose firmware you intend to boot under, and reach the other through its own boot path (the x86_64 multiboot header or the arm64 Image header), or pass --fat-uefi=none to leave the PE out altogether\n"
        write(2, mc, str_len(mc))
        exit(1)
    }
    uint64 len = str_len(v)
    if targets_name_eq(v, len, "none") != 0 {
        fat_uefi_arch = 254
        fat_uefi_set = 1
    } else {
        uint64 a = fatimg_arch_from_name(v, len)
        if a == 0xFF {
            uint64 mu = "error: --fat-uefi= wants x86_64, arm64 or none, not '"
            write(2, mu, str_len(mu))
            write(2, v, len)
            mu = "'\n"
            write(2, mu, str_len(mu))
            exit(1)
        }
        fatimg_refuse_arch(a, "--fat-uefi=")
        fat_uefi_arch = a
        fat_uefi_set = 1
    }
}

// Little-endian stores/loads, byte at a time. Deliberately not a `*(p as
// uint32)` store: the composer writes into a freshly allocated composite at
// offsets it computed itself, and a byte loop is endian-explicit and has no
// alignment question to get wrong on a host this compiler also targets.
fn fatimg_put_u32(uint64 buf, uint64 off, uint64 v) {
    uint64 i = 0
    while i < 4 {
        uint64 p = buf + off + i
        uint64 bv = (v >> (i * 8)) & 0xFF
        uint8 bb = bv
        unsafe { *(p as uint8) = bb }
        i = i + 1
    }
}

fn fatimg_put_u64(uint64 buf, uint64 off, uint64 v) {
    uint64 i = 0
    while i < 8 {
        uint64 p = buf + off + i
        uint64 bv = (v >> (i * 8)) & 0xFF
        uint8 bb = bv
        unsafe { *(p as uint8) = bb }
        i = i + 1
    }
}

fn fatimg_get_u8(uint64 buf, uint64 off) -> uint64 {
    uint64 p = buf + off
    uint64 v = 0
    unsafe { *(p as uint8) -> v }
    return v
}

fn fatimg_get_u32(uint64 buf, uint64 off) -> uint64 {
    uint64 v = 0
    uint64 i = 0
    while i < 4 {
        uint64 b = fatimg_get_u8(buf, off + i)
        v = v | (b << (i * 8))
        i = i + 1
    }
    return v
}

fn fatimg_align_up(uint64 v, uint64 a) -> uint64 {
    uint64 r = v & (a - 1)
    if r == 0 { return v }
    return v + a - r
}

// Print "<label> <decimal>" -- the report below is decimal throughout, for the
// reason the `image:` report line states: fmt_uint exists, write_hex32 caps at
// 32 bits, load addresses are 64-bit, and one radix beats two.
fn fatimg_print_num(uint64 label, uint64 v) {
    uint8[64] nb
    write(1, label, str_len(label))
    uint64 n = fmt_uint(nb, v)
    write(1, nb, n)
}

// Same, to stderr, for the refusals that need to name a number.
fn fatimg_err_num(uint64 label, uint64 v) {
    uint8[64] nb
    write(2, label, str_len(label))
    uint64 n = fmt_uint(nb, v)
    write(2, nb, n)
}

fn fatimg_die(uint64 msg) {
    write(2, msg, str_len(msg))
    exit(1)
}

// The multiboot scan, done exactly the way a multiboot LOADER does it: every
// 4-byte-aligned offset in the first 8192 bytes, first hit wins. Returning the
// first hit rather than "the one we expect" is what makes the composer's
// "the first magic in the file is OURS" assertion meaningful -- a check that
// looked only at 0x400 could not see a magic that shadowed it.
fn fatimg_find_multiboot(uint64 buf, uint64 len) -> uint64 {
    uint64 lim = len
    if lim > 8192 { lim = 8192 }
    uint64 off = 0
    while off + 4 <= lim {
        if fatimg_get_u32(buf, off) == 0x1BADB002 {
            return off
        }
        off = off + 4
    }
    return 0xFFFFFFFF
}

// Encode `b #delta`, delta in BYTES relative to the branch word itself.
//
// Only forward branches occur here (the branch lives in the first 8 bytes and
// every slice is after it), so no sign handling is needed and none is written:
// a negative delta would arrive as a huge unsigned value and be refused by the
// range check, which is the correct outcome rather than a silently wrapped
// encoding. B's range is +-128 MiB; the positive half is 2^27 bytes.
fn fatimg_a64_b(uint64 delta) -> uint64 {
    if (delta & 3) != 0 {
        uint64 m4 = "error: internal: the arm64 slice's entry is not 4-byte aligned, so the Image header's branch cannot reach it: every AArch64 instruction is a 4-byte word and B encodes its target as a word count, so a target at an odd byte offset is not expressible. This is a composer bug rather than anything the command line can cause -- both the slice offset and the entry offset inside it are 4096-aligned and word-aligned respectively\n"
        fatimg_die(m4)
    }
    if delta >= 134217728 {
        uint64 mr = "error: the arm64 slice sits more than 128 MiB into the fat image, which is past the range of the Image header's branch: AArch64's B encodes a signed 26-bit word displacement, so code0/code1 can only reach +-128 MiB. Shrink the x86_64 slice that precedes it, or build the arm64 half separately and boot it on its own\n"
        fatimg_die(mr)
    }
    return 0x14000000 | ((delta >> 2) & 0x03FFFFFF)
}

// Length of the last file fatimg_read_slice() read. A global rather than an
// out-parameter because there is no address-of operator for a local here, and
// threading a scratch slot through the call would be more machinery than the
// two call sites are worth.
static uint64 fatimg_read_len = 0

fn fatimg_read_slice(uint64 path) -> uint64 {
    uint64 fd = file_open(path, 0)
    if fd >= 0xFFFFFFFF {
        uint64 mo = "error: --slice=: cannot open '"
        write(2, mo, str_len(mo))
        write(2, path, str_len(path))
        mo = "': a --slice= file must already exist -- it is a prebuilt raw image the fat image adopts instead of compiling that architecture from the source on the command line\n"
        write(2, mo, str_len(mo))
        exit(1)
    }
    uint64 sz = file_size(fd)
    if sz == 0 {
        file_close(fd)
        uint64 mz = "error: --slice=: '"
        write(2, mz, str_len(mz))
        write(2, path, str_len(path))
        mz = "' is empty: a zero-byte slice would be composed into the image as a boot path that enters nothing\n"
        write(2, mz, str_len(mz))
        exit(1)
    }
    uint64 buf = alloc(sz)
    uint64 sgot = read_exact(fd, buf, sz)
    file_close(fd)
    if sgot != sz {
        uint64 ss = "error: --slice=: short read on '"
        write(2, ss, str_len(ss))
        write(2, path, str_len(path))
        ss = "': the file ended before the size it reported, so the slice is truncated and would be composed into the image as a boot path that enters half a program\n"
        write(2, ss, str_len(ss))
        exit(1)
    }
    fatimg_read_len = sz
    return buf
}

// Where the entry stub sits INSIDE an x86_64 slice, derived from the slice's
// own multiboot header rather than from the build that produced it.
//
// WHY DERIVED AND NOT REMEMBERED. A slice can arrive two ways -- compiled here
// (in which case compile() reported its entry) or handed over with --slice=
// (in which case nothing here saw the build at all). One derivation that works
// for both is better than two paths that agree today: the compiled case then
// CROSS-CHECKS the derivation against the reported number, which is a test of
// the derivation the --slice= case cannot perform on itself.
//
// The arithmetic: krc writes header_addr = load + <header's own file offset>
// and entry_addr = load + <stub's file offset>, so
//     stub_offset = entry_addr - header_addr + header_offset_in_slice
// with the load address cancelling out entirely. That is the whole reason this
// works on a slice built for a completely different load address.
// The load address the x86_64 slice was BUILT for, read out of its own
// multiboot header by the function below. Kept because the x86_64 slice is the
// one thing in this container that is NOT position-independent -- see the
// refusal in the composer.
static uint64 fatimg_x86_slice_load = 0

fn fatimg_x86_entry_offset(uint64 buf, uint64 len, uint64 what) -> uint64 {
    uint64 inner = fatimg_find_multiboot(buf, len)
    if inner == 0xFFFFFFFF {
        uint64 mn = "error: the x86_64 slice ("
        write(2, mn, str_len(mn))
        write(2, what, str_len(what))
        mn = ") carries no multiboot header in its first 8 KiB, so there is nothing to read its entry point out of. A slice for the multiboot boot path must be built with --emit=image --stack-top=, which is the flag that emits the multiboot header and the long-mode trampoline behind it\n"
        write(2, mn, str_len(mn))
        exit(1)
    }
    uint64 hdr_addr = fatimg_get_u32(buf, inner + 12)
    uint64 ent_addr = fatimg_get_u32(buf, inner + 28)
    // krc's stub writes load_addr = the --load-addr the slice was built for,
    // i.e. the address of the slice's own first byte. Published for the
    // composer's placement check.
    fatimg_x86_slice_load = fatimg_get_u32(buf, inner + 16)
    if ent_addr < hdr_addr {
        uint64 mb = "error: the x86_64 slice ("
        write(2, mb, str_len(mb))
        write(2, what, str_len(what))
        mb = ") has a multiboot entry_addr below its own header_addr, so its entry does not lie inside it. Either the header was never patched (entry_addr 0 is what an unpatched krc image carries) or the file is not the image it claims to be\n"
        write(2, mb, str_len(mb))
        exit(1)
    }
    uint64 off = ent_addr - hdr_addr + inner
    if off >= len {
        uint64 mp = "error: the x86_64 slice ("
        write(2, mp, str_len(mp))
        write(2, what, str_len(what))
        mp = ") puts its multiboot entry past its own last byte, so composing it would produce a boot path that jumps outside the file\n"
        write(2, mp, str_len(mp))
        exit(1)
    }
    return off
}

// The same question for arm64, answered out of the 64-byte Linux `Image`
// header the slice must carry.
//
// WHY --image-header IS REQUIRED OF AN arm64 SLICE. A headerless arm64 image
// records its entry NOWHERE -- the `image:` report line is the only place it
// ever existed, and that line is gone by the time a --slice= file is handed
// over. The Image header's code0 branch IS that record, written into the file,
// so requiring the header is requiring the slice to be self-describing. The
// x86_64 side gets this for free: its multiboot header is already a record of
// the same fact, which is why the two rules look different and are the same
// rule.
fn fatimg_a64_entry_offset(uint64 buf, uint64 len, uint64 what) -> uint64 {
    if len < 64 {
        uint64 ms = "error: the arm64 slice ("
        write(2, ms, str_len(ms))
        write(2, what, str_len(what))
        ms = ") is shorter than the 64-byte arm64 Image header it must begin with\n"
        write(2, ms, str_len(ms))
        exit(1)
    }
    if fatimg_get_u32(buf, 56) != 0x644D5241 {
        uint64 mm = "error: the arm64 slice ("
        write(2, mm, str_len(mm))
        write(2, what, str_len(what))
        mm = ") does not begin with an arm64 Image header (magic 0x644d5241 at offset 56). A fat image reads the slice's entry point out of that header's code0 branch, because nothing else in a raw arm64 image records where to start -- build the slice with --emit=image --image-header --stack-top=\n"
        write(2, mm, str_len(mm))
        exit(1)
    }
    uint64 code0 = fatimg_get_u32(buf, 0)
    if (code0 >> 26) != 5 {
        uint64 mb = "error: the arm64 slice ("
        write(2, mb, str_len(mb))
        write(2, what, str_len(what))
        mb = ") has an Image header whose code0 is not an unconditional branch, so its entry point cannot be read out of it. krc writes `b <entry stub>` there only when --stack-top= asked for a stub; a header on a stub-less image points at nothing\n"
        write(2, mb, str_len(mb))
        exit(1)
    }
    uint64 off = (code0 & 0x03FFFFFF) * 4
    if off >= len {
        uint64 mp = "error: the arm64 slice ("
        write(2, mp, str_len(mp))
        write(2, what, str_len(what))
        mp = ") has an Image header branching past its own last byte, so composing it would produce a boot path that jumps outside the file\n"
        write(2, mp, str_len(mp))
        exit(1)
    }
    return off
}

// Set the four --emit=image / --emit=uefi globals compile() reads, from ONE
// place, before every pass. Every pass sets all four, even the three it wants
// off, so that no pass can inherit the previous pass's flags.
//
// THE RESETS ARE INERT TODAY AND ARE KEPT ANYWAY, and the difference matters
// enough to say which: MEASURED by removing them (this feature's mutation M14)
// -- the composed image is BYTE-IDENTICAL. It has to be, given the current
// order: all four globals are refused at flag-validation time under
// --emit=fatimage, so they are 0 when the composer starts, and the passes run
// UEFI -> x86_64 -> arm64, which happens to be increasing in what it turns on.
// Nothing inherits anything wrong because nothing precedes it that set
// anything wrong.
//
// WHAT THEY GUARD IS THE ORDER, NOT THIS BUILD. stack_top_set turns on the
// x86_64 multiboot stub and image_header_set turns on the arm64 Image header,
// and both gates are `img_raw && arch && flag` where emit_mode 9 (UEFI) is
// img_raw -- so a UEFI pass that ran AFTER the arm64 pass, with arch arm64
// (which --fat-uefi=arm64 selects), would emit 64 bytes of boot header into a
// PE section. That is a reordering away, not a defect here, and an explicit
// reset is cheaper than the comment explaining why the order is load-bearing.
fn fatimg_set_pass_flags(uint64 ld, uint64 ld_set, uint64 sp, uint64 sp_set, uint64 hdr) {
    load_addr = ld
    load_addr_set = ld_set
    stack_top = sp
    stack_top_set = sp_set
    image_header_set = hdr
    reset_vector_set = 0
}

fn compile_fatimage(uint64 input_path, uint64 output_path) {
    // ---- pass 1: the UEFI slice, which is also the base file -------------
    //
    // FIRST, because its length fixes where every other slice lands and
    // therefore what --load-addr each of them is compiled for. The dependency
    // runs one way only: the PE knows nothing about the slices appended after
    // it (its SizeOfImage and section table cover only its own bytes), while
    // each raw slice must be told an address that depends on the PE's length.
    uint64 base_buf = 0
    uint64 base_len = 0
    uint64 e_lfanew = 0
    uint64 uefi_len = 0
    if fat_uefi_arch < 2 {
        fat_capture = 1
        fatimg_set_pass_flags(0, 0, 0, 0, 0)
        compile(input_path, output_path, fat_uefi_arch, 9)
        base_buf = fat_cap_buf
        base_len = fat_cap_len
        uefi_len = fat_cap_len
        if fatimg_get_u8(base_buf, 0) != 77 || fatimg_get_u8(base_buf, 1) != 90 {
            uint64 mz = "error: internal: the --emit=uefi slice does not begin with 'MZ', so the fat image's shared first 64 bytes cannot be both a DOS stub and an arm64 Image header\n"
            fatimg_die(mz)
        }
        e_lfanew = fatimg_get_u32(base_buf, 60)
        if e_lfanew + 4 > base_len {
            fatimg_err_num("error: internal: the --emit=uefi slice's e_lfanew points at file offset ", e_lfanew)
            uint64 me = ", which is past its own last byte\n"
            fatimg_die(me)
        }
        if fatimg_get_u8(base_buf, e_lfanew) != 80 || fatimg_get_u8(base_buf, e_lfanew + 1) != 69 {
            uint64 mp = "error: internal: the --emit=uefi slice has no PE signature where its own e_lfanew points, so the composite would carry a DOS stub leading nowhere\n"
            fatimg_die(mp)
        }
        // THE OVERLAP CHECK, and the reason e_lfanew is read before the arm64
        // header is written rather than after. The arm64 header owns bytes
        // 0-63 and e_lfanew itself lives in its reserved word at 60, so the PE
        // signature must begin at 64 or later or the two headers are fighting
        // for the same bytes. krc emits 0x40 exactly; this asserts it rather
        // than assuming it, because the number is the PE writer's choice and
        // nothing else in this file would notice it moving.
        if e_lfanew < 64 {
            fatimg_err_num("error: the --emit=uefi slice puts its PE header at file offset ", e_lfanew)
            uint64 ml = ", which overlaps the 64-byte arm64 Image header the fat image writes over the DOS stub. The PE signature must begin at 64 or later. Pass --fat-uefi=none to drop the UEFI boot path, or drop arm64 from --arch= so the first 64 bytes are the DOS stub alone\n"
            fatimg_die(ml)
        }
        if base_len < 4096 {
            fatimg_err_num("error: the --emit=uefi slice is only ", base_len)
            uint64 ms = " bytes, so it has no section data at file offset 4096 and the fat image's layout assumption -- PE headers below 4096, everything else above -- does not hold for it\n"
            fatimg_die(ms)
        }
    } else {
        // NO PE. The prologue is synthesised instead of adopted: 4096 zero
        // bytes holding the arm64 Image header at 0 and the multiboot header
        // at 0x400, i.e. exactly the shape the PE base already has. Padded to
        // 4096 for the same reason every slice is -- arm64's ADRP page
        // arithmetic is baked at compile time and only survives a
        // page-congruent placement.
        base_len = 4096
        base_buf = alloc(base_len)
        uint64 zi = 0
        while zi < base_len {
            uint64 zp = base_buf + zi
            uint8 zb = 0
            unsafe { *(zp as uint8) = zb }
            zi = zi + 1
        }
    }

    // ---- pass 2: the x86_64 multiboot slice ------------------------------
    uint64 mb_off = fatimg_align_up(base_len, 4096)
    uint64 x86_load = fat_load_x86 + mb_off
    uint64 x86_buf = 0
    uint64 x86_len = 0
    uint64 x86_entry = 0
    uint64 x86_what = "compiled from the source on the command line"
    if fat_slice_x86 != 0 {
        x86_buf = fatimg_read_slice(fat_slice_x86)
        x86_len = fatimg_read_len
        x86_what = fat_slice_x86
        x86_entry = fatimg_x86_entry_offset(x86_buf, x86_len, x86_what)
    } else {
        // The trampoline's own two bounds, re-checked on the COMPUTED address.
        // The user set a base; the composer added an offset to it; the sum is
        // what the flag validation would have checked had it been able to see
        // it, and it runs before the compile rather than after so a refusal
        // costs nothing.
        if x86_load < 16384 {
            fatimg_err_num("error: the x86_64 slice would be loaded at ", x86_load)
            uint64 m1 = " (--load-addr=x86_64:<base> plus the slice's offset in the file), and the x86_64 self-boot trampoline builds its identity-map page tables at physical 0x1000-0x4000 and zeroes that whole range -- an image loaded there is overwritten by its own boot code before it runs. Raise --load-addr=x86_64: to at least 0x4000\n"
            fatimg_die(m1)
        }
        if x86_load >= 1073741824 {
            fatimg_err_num("error: the x86_64 slice would be loaded at ", x86_load)
            uint64 m2 = " (--load-addr=x86_64:<base> plus the slice's offset in the file), and the x86_64 self-boot trampoline's identity map is a single 512-entry page directory of 2 MiB pages covering exactly the first 1 GiB -- an image at or above that address is unmapped the instant paging is enabled. Lower --load-addr=x86_64:\n"
            fatimg_die(m2)
        }
        fat_capture = 1
        fatimg_set_pass_flags(x86_load, 1, fat_stack_x86, 1, 0)
        compile(input_path, output_path, 0, 8)
        x86_buf = fat_cap_buf
        x86_len = fat_cap_len
        x86_entry = fatimg_x86_entry_offset(x86_buf, x86_len, x86_what)
        // THE CROSS-CHECK the --slice= case cannot make on itself. Two
        // independent answers to "where does this slice start executing" --
        // one from compile()'s fn_lookup, one decoded out of the bytes it
        // emitted -- and if they ever disagree the derivation is reading the
        // wrong field of the wrong header and every --slice= build is silently
        // wrong too.
        if x86_entry != fat_cap_entry {
            fatimg_err_num("error: internal: the x86_64 slice's multiboot header says its entry is at offset ", x86_entry)
            fatimg_err_num(" but the compiler reported ", fat_cap_entry)
            uint64 mx = ". These are two readings of the same fact and they must agree; the derivation from the multiboot header is what a --slice= file is composed with, so a disagreement here means every --slice= x86_64 build is placing the entry wrongly as well\n"
            fatimg_die(mx)
        }
    }

    // THE x86_64 SLICE IS NOT POSITION-INDEPENDENT, and this is the one place
    // that fact bites. Everything else in this container relocates: x86_64 code
    // is RIP-relative, arm64 code is PIC modulo 4 KiB and every slice lands on
    // a page boundary, and --load-addr is documented as validated-and-reported,
    // never embedded. ONE IMMEDIATE BREAKS THAT: the x86_64 self-boot
    // trampoline ends in `movabs $entry,%rax; call *%rax`, and that imm64 is
    // patched with load_addr + <the entry's file offset> -- an absolute
    // address, baked at build time, because a 32-bit trampoline cannot form a
    // RIP-relative reference to a 64-bit target.
    //
    // MEASURED, not reasoned: an x86_64 slice built with --load-addr=0x20000000
    // and composed at 0x402000 produced a fat image whose arm64 path booted
    // normally and whose x86_64 path went silent -- exit 0, a valid-looking
    // artifact, and a `call` into unmapped memory. That is precisely the shape
    // this whole flag surface refuses everywhere else.
    //
    // A COMPILED SLICE ALWAYS PASSES: the composer chose the address and passed
    // it to compile(). The check is still run for it, because it costs nothing
    // and because it is the assertion that the derivation above reads the field
    // it thinks it does.
    //
    // The remedy is a rebuild, and the message carries the exact number, so the
    // chicken-and-egg (the offset depends on how long the UEFI slice turned out
    // to be) is resolved by running the command once and reading it off.
    if fatimg_x86_slice_load != x86_load {
        fatimg_err_num("error: the x86_64 slice was built for load address ", fatimg_x86_slice_load)
        fatimg_err_num(" but the fat image places it at ", x86_load)
        uint64 mpl = ". Unlike everything else in this container the x86_64 slice is not position-independent: its self-boot trampoline ends in `movabs $entry,%rax; call *%rax` and that address is baked in at build time, so a slice composed anywhere else calls into memory nothing mapped -- silently, at exit 0. Rebuild the slice with --load-addr= set to the second number above (it is the file's x86_64 load base plus the slice's offset in the file, both of which this line has just told you)\n"
        fatimg_die(mpl)
    }

    // ---- pass 3: the arm64 raw slice -------------------------------------
    uint64 arm_off = fatimg_align_up(mb_off + x86_len, 4096)
    uint64 a64_load = fat_load_a64 + arm_off
    uint64 a64_buf = 0
    uint64 a64_len = 0
    uint64 a64_entry = 0
    uint64 a64_what = "compiled from the source on the command line"
    if fat_slice_a64 != 0 {
        a64_buf = fatimg_read_slice(fat_slice_a64)
        a64_len = fatimg_read_len
        a64_what = fat_slice_a64
        a64_entry = fatimg_a64_entry_offset(a64_buf, a64_len, a64_what)
    } else {
        if (a64_load & 4095) != 0 {
            fatimg_err_num("error: the arm64 slice would be loaded at ", a64_load)
            uint64 ma = ", which is not 4096-aligned: ADRP page arithmetic is baked at compile time and only survives a page-aligned shift. Every slice offset inside a fat image is 4096-aligned, so this can only come from a --load-addr=arm64:<base> that is not\n"
            fatimg_die(ma)
        }
        fat_capture = 1
        // --image-header IS ON for this pass, and it is not decoration. The
        // composer reads the slice's entry point back out of the header's
        // code0 branch, using the SAME code path a --slice= file goes through,
        // so the two cases cannot drift apart -- and the cross-check below
        // then proves that path against compile()'s own answer. The 64 bytes
        // also make the slice independently bootable, which is what makes
        // `--slice=arm64:<that file>` a thing a user can actually do next.
        //
        // The header's image_size covers the SLICE, not the fat image. Both
        // numbers are right about their own file: a loader handed the slice
        // alone reserves the slice, and a loader handed the fat image reads
        // the header at offset 0, whose image_size the composer sets to the
        // whole composite below.
        fatimg_set_pass_flags(a64_load, 1, fat_stack_a64, 1, 1)
        compile(input_path, output_path, 1, 8)
        a64_buf = fat_cap_buf
        a64_len = fat_cap_len
        a64_entry = fatimg_a64_entry_offset(a64_buf, a64_len, a64_what)
        if a64_entry != fat_cap_entry {
            fatimg_err_num("error: internal: the arm64 slice's Image header branches to offset ", a64_entry)
            fatimg_err_num(" but the compiler reported its entry at ", fat_cap_entry)
            uint64 mx2 = ". These are two readings of the same fact and they must agree; the decode from code0 is what a --slice= file is composed with, so a disagreement here means every --slice= arm64 build is placing the entry wrongly as well\n"
            fatimg_die(mx2)
        }
    }
    fat_capture = 0

    // ---- compose ----------------------------------------------------------
    uint64 total = arm_off + a64_len
    uint64 img = alloc(total)
    uint64 zi2 = 0
    while zi2 < total {
        uint64 zp2 = img + zi2
        uint8 zb2 = 0
        unsafe { *(zp2 as uint8) = zb2 }
        zi2 = zi2 + 1
    }
    memcpy(img, base_buf, base_len)
    memcpy(img + mb_off, x86_buf, x86_len)
    memcpy(img + arm_off, a64_buf, a64_len)

    // WHERE THE STANDALONE MULTIBOOT HEADER GOES, ONCE. Every use below reads
    // this variable, and that is not tidiness: the first draft wrote 1024 into
    // the bounds check, into the diagnostic that reports the offending offset,
    // and into each of the eight field stores separately. A mutation that moved
    // the header (run during this feature's own mutation testing) then refused
    // correctly and NAMED THE WRONG OFFSET, because the check and the message
    // were two literals that no longer agreed.
    //
    // 4-byte aligned and inside the 8 KiB multiboot scan window; past the PE
    // headers krc emits (which end well before 0x200) and below the UEFI
    // section data at 4096.
    uint64 mb_hdr_off = 1024
    // The 32 bytes the header is about to occupy must be padding, not something
    // the PE cares about. Checked as "already zero" rather than reasoned about
    // from the PE layout: the section table's end is a function of the PE
    // writer's choices, and a future one that grew past mb_hdr_off would
    // otherwise be silently overwritten here.
    uint64 pi = 0
    while pi < 32 {
        if fatimg_get_u8(img, mb_hdr_off + pi) != 0 {
            fatimg_err_num("error: the fat image's multiboot header would overwrite a non-zero byte at file offset ", mb_hdr_off + pi)
            uint64 mo2 = ", which is inside the PE headers rather than the padding after them. The multiboot header must lie at a 4-byte-aligned offset inside the first 8 KiB and below the UEFI section data at 4096; there is no room for it in this PE\n"
            fatimg_die(mo2)
        }
        pi = pi + 1
    }
    // Asserted rather than left to the reader: the header is 32 bytes and the
    // UEFI section data starts at 4096, so a future relocation of either would
    // collide silently -- the multiboot loader would read a header that
    // overlaps live code and honour whatever the overlap happened to spell.
    if mb_hdr_off + 32 > 4096 {
        uint64 mc = "error: internal: the fat image's multiboot header collides with the UEFI section data at file offset 4096\n"
        fatimg_die(mc)
    }
    if (mb_hdr_off & 3) != 0 {
        uint64 ma4 = "error: internal: the fat image's multiboot header is not 4-byte aligned, and a multiboot loader only scans 4-byte-aligned offsets -- it would never find it\n"
        fatimg_die(ma4)
    }

    // The standalone multiboot header. The one INSIDE the x86_64 slice sits
    // far past the 8 KiB scan window in any realistic image, so the scan would
    // never reach it; this is the copy the loader actually finds.
    //
    // THE ONE FIELD THAT IS NOT THE SLICE's. header_addr and entry_addr are
    // the slice's own values shifted to where the slice actually landed, but
    // load_addr is the BASE OF THE WHOLE FILE, so the loader pulls in every
    // byte including the arm64 half. Multiboot computes the file offset of
    // load_addr as (header's offset in file) - (header_addr - load_addr),
    // which with these three values comes to exactly zero.
    uint64 mb_flags = 0x00010000
    uint64 mb_ck = 0xFFFFFFFF - (0x1BADB002 + mb_flags) + 1
    fatimg_put_u32(img, mb_hdr_off, 0x1BADB002)
    fatimg_put_u32(img, mb_hdr_off + 4, mb_flags)
    fatimg_put_u32(img, mb_hdr_off + 8, mb_ck & 0xFFFFFFFF)
    fatimg_put_u32(img, mb_hdr_off + 12, fat_load_x86 + mb_hdr_off)
    fatimg_put_u32(img, mb_hdr_off + 16, fat_load_x86)
    fatimg_put_u32(img, mb_hdr_off + 20, 0)
    fatimg_put_u32(img, mb_hdr_off + 24, 0)
    fatimg_put_u32(img, mb_hdr_off + 28, fat_load_x86 + mb_off + x86_entry)

    // The shared 64 bytes. Only the DOS stub is touched, and e_lfanew is put
    // back byte-for-byte -- a PE loader reads nothing else here.
    //
    // TWO SHAPES, because without a PE there is no "MZ" to preserve and
    // pretending otherwise would put a two-character lie at byte 0 of a file
    // no firmware will ever read. With a PE the branch has to move to code1,
    // since code0 is spoken for; without one it sits at code0 and code1 is
    // zero (`udf #0`, which faults loudly rather than hanging if anything ever
    // reaches it -- the same choice the --image-header block makes for its own
    // unpatched placeholders).
    if fat_uefi_arch < 2 {
        fatimg_put_u32(img, 0, 0x91005A4D)
        fatimg_put_u32(img, 4, fatimg_a64_b(arm_off + a64_entry - 4))
    } else {
        fatimg_put_u32(img, 0, fatimg_a64_b(arm_off + a64_entry))
        fatimg_put_u32(img, 4, 0)
    }
    fatimg_put_u64(img, 8, 0)              // text_offset: load anywhere
    fatimg_put_u64(img, 16, total)         // image_size: the WHOLE composite
    fatimg_put_u64(img, 24, 10)            // flags: LE, 4 KiB pages, anywhere
    fatimg_put_u64(img, 32, 0)
    fatimg_put_u64(img, 40, 0)
    fatimg_put_u64(img, 48, 0)
    fatimg_put_u32(img, 56, 0x644D5241)    // magic "ARM\x64"
    fatimg_put_u32(img, 60, e_lfanew)      // restored, or 0 with no PE

    // THE LAST INVARIANT, AND THE ONE THAT COULD NOT BE CHECKED EARLIER: a
    // multiboot loader takes the FIRST magic it finds, so the header written
    // above is only the one that gets used if nothing before it in the file
    // happens to spell 0x1BADB002 on a 4-byte boundary. The arm64 header, the
    // DOS stub and the PE headers all sit in front of it. Run on the FINISHED
    // bytes, after everything is in place, because that is the only state a
    // loader ever sees.
    uint64 first = fatimg_find_multiboot(img, total)
    if first != mb_hdr_off {
        fatimg_err_num("error: the first multiboot magic in the composed image is at file offset ", first)
        fatimg_err_num(" but the fat image's own header is at ", mb_hdr_off)
        uint64 mf = ". A multiboot loader takes the first magic it finds on a 4-byte boundary within the first 8 KiB, so it would enter through a header this compiler did not write -- something ahead of offset 1024 (the arm64 Image header, the DOS stub or the PE headers) spells 0x1badb002\n"
        fatimg_die(mf)
    }

    // ---- write ------------------------------------------------------------
    uint64 fd = open_output_or_die(output_path)
    file_write(fd, img, total)
    file_close(fd)

    // ---- report -----------------------------------------------------------
    //
    // A REQUIRED OUTPUT, not a convenience, for the reason the `image:` line
    // gives: a fat image has no single entry point, and the file offsets of
    // its slices are recorded in no other place. The per-slice `image:` and
    // `uefi:` lines printed above are each pass's own record; these are the
    // composite's.
    uint64 rm = "fatimage: "
    write(1, rm, str_len(rm))
    write(1, output_path, str_len(output_path))
    fatimg_print_num(" bytes=", total)
    write(1, "\n", 1)

    rm = "  x86_64 uefi     : "
    write(1, rm, str_len(rm))
    if fat_uefi_arch == 0 {
        fatimg_print_num("pe_at=", e_lfanew)
        fatimg_print_num(" text_at=", 4096)
        fatimg_print_num(" bytes=", uefi_len)
    } else {
        rm = "none"
        write(1, rm, str_len(rm))
    }
    write(1, "\n", 1)
    if fat_uefi_arch == 1 {
        rm = "  arm64 uefi      : "
        write(1, rm, str_len(rm))
        fatimg_print_num("pe_at=", e_lfanew)
        fatimg_print_num(" text_at=", 4096)
        fatimg_print_num(" bytes=", uefi_len)
        write(1, "\n", 1)
    }

    rm = "  x86_64 multiboot: "
    write(1, rm, str_len(rm))
    fatimg_print_num("file=", mb_off)
    fatimg_print_num(" bytes=", x86_len)
    fatimg_print_num(" hdr=", mb_hdr_off)
    fatimg_print_num(" entry=", fat_load_x86 + mb_off + x86_entry)
    fatimg_print_num(" load=", fat_load_x86)
    rm = "  ("
    write(1, rm, str_len(rm))
    write(1, x86_what, str_len(x86_what))
    rm = ")\n"
    write(1, rm, str_len(rm))

    rm = "  arm64 image     : "
    write(1, rm, str_len(rm))
    fatimg_print_num("file=", arm_off)
    fatimg_print_num(" bytes=", a64_len)
    fatimg_print_num(" entry=", arm_off + a64_entry)
    fatimg_print_num(" load=", fat_load_a64)
    rm = "  ("
    write(1, rm, str_len(rm))
    write(1, a64_what, str_len(a64_what))
    rm = ")\n"
    write(1, rm, str_len(rm))
}

@export
fn main() {
    // Windows: parse raw GetCommandLineA result into argc/argv
    if cli_argc == 0xFFFFFFFF {
        win_init_args()
    }

    uint64 input_path = 0
    uint64 output_path = "a.krbo"
    uint64 mode = 0
    uint64 arch = 0
    uint64 emit_mode = 0
    uint64 arch_set = 0
    uint64 emit_set = 0
    // "the LAST --emit= on the line spelled `uefi`", which is a different fact
    // from `emit_mode == 9` and is why it needs its own variable. --target=
    // android does not merely set target_os: it ASSIGNS emit_mode = 4 from
    // inside the argument loop, so `--emit=uefi --target=android` leaves
    // emit_mode 4 with nothing anywhere recording that a UEFI application was
    // asked for. Measured before this existed: that line emitted an Android
    // PIE ELF at exit 0. --emit=image survives the same clobber only by
    // accident (it also requires --load-addr=, whose own "only meaningful
    // with --emit=image" check then fires); a new mode has no such backstop.
    //
    // RESET, NOT JUST SET, by every later --emit= and by -c — otherwise the
    // post-loop check below would also fire on `--emit=uefi --emit=elfexe`,
    // which is ordinary last-wins and must keep working (pinned by
    // uefi_emit_last_wins_away).
    uint64 uefi_set = 0
    // Tracks what the last --target= flag resolved to, so a second, different
    // --target= is a conflict rather than last-wins (e.g. --target=esp32
    // already implies bare metal on Xtensa; composing it with an OS name or
    // with --target=none must not silently pick whichever parsed last).
    // 0 = not given yet; 1 linux, 2 macos, 3 windows, 4 android, 5 esp32,
    // 6 none.
    uint64 target_arg_seen = 0
    uint64 target_arg_kind = 0
    uint64 target_arg_str = 0

    if cli_argc > 1 {
        uint64 i = 1
        while i < cli_argc {
            uint64 arg_ptr = cli_argv + i * 8
            uint64 arg = 0
            unsafe { *(arg_ptr as uint64) -> arg }
            if str_starts_with(arg, "-o", 2) != 0 {
                uint64 arg_len = str_len(arg)
                if arg_len == 2 {
                    i = i + 1
                    uint64 next_ptr = cli_argv + i * 8
                    unsafe { *(next_ptr as uint64) -> output_path }
                } else {
                    output_path = arg + 2
                }
            } else if str_starts_with(arg, "--arch=", 7) != 0 {
                arch_set = 1
                uint64 arch_str = arg + 7
                // THE LIST FORM, and it is entered ONLY on a comma. Every
                // single-arch spelling this compiler has ever accepted goes
                // down the untouched chain below, so no existing invocation
                // changes a byte -- byte-identity by construction rather than
                // by testing, the same argument --emit=image's new mode number
                // makes for itself.
                //
                // `arch` is left at 0 rather than at "the first element": a
                // fat image has no single architecture, the composer reads
                // fat_arch_mask and never `arch`, and the only other consumer
                // that runs on this path is arch_os_pair_supported, for which
                // 0 is as true as 1. Setting it to the first element would
                // invite a reader to think it means something.
                if fatimg_find_byte(arch_str, 44) != 0xFFFFFFFF {
                    parse_fat_arch_list(arch_str)
                    arch = 0
                } else if str_eq_full(arch_str, "arm64") != 0 {
                    arch = 1
                } else if str_eq_full(arch_str, "aarch64") != 0 {
                    arch = 1
                } else if str_eq_full(arch_str, "riscv32") != 0 {
                    arch = 2
                } else if str_eq_full(arch_str, "riscv64") != 0 {
                    write(2, "error: --arch=riscv64: RV64 is not supported yet. This compiler targets RV32; use --arch=riscv32.\n", 98)
                    exit(1)
                } else if str_eq_full(arch_str, "xtensa") != 0 {
                    arch = 3
                } else if str_eq_full(arch_str, "x86_64") != 0 {
                    arch = 0
                } else if str_eq_full(arch_str, "x86-64") != 0 {
                    arch = 0
                } else if str_eq_full(arch_str, "amd64") != 0 {
                    arch = 0
                } else if str_eq_full(arch_str, "x64") != 0 {
                    arch = 0
                } else {
                    write(2, "error: unknown --arch (use x86_64|arm64|riscv32|xtensa)\n", 56)
                    exit(1)
                }
            } else if str_starts_with(arg, "--emit=", 7) != 0 {
                emit_set = 1
                // Cleared here and re-set only by the `uefi` arm below, so it
                // always describes the LAST --emit= and never a superseded one.
                uefi_set = 0
                uint64 emit_str = arg + 7
                // Recorded for entry_missing_die, which used to name a flag the
                // caller may never have passed. Set before the alias chain so
                // every spelling reports itself rather than its canonical form.
                cg_emit_flag = emit_str
                if str_eq_full(emit_str, "elfexe") != 0 {
                    emit_mode = 0
                } else if str_eq_full(emit_str, "elf") != 0
                       || str_eq_full(emit_str, "elf-arm64") != 0
                       || str_eq_full(emit_str, "elf-x86_64") != 0 {
                    // "elf" / "elf-arm64" / "elf-x86_64" spellings for ELF
                    emit_mode = 0
                } else if str_eq_full(emit_str, "linux") != 0
                       || str_eq_full(emit_str, "linux-x86_64") != 0
                       || str_eq_full(emit_str, "linux-arm64") != 0
                       || str_eq_full(emit_str, "linux-x86-64") != 0 {
                    // "linux", "linux-x86_64", "linux-arm64", "linux-x86-64" all alias to ELF
                    emit_mode = 0
                } else if str_eq_full(emit_str, "macho") != 0 {
                    emit_mode = 1
                } else if str_eq_full(emit_str, "mac") != 0
                       || str_eq_full(emit_str, "macos") != 0
                       || str_eq_full(emit_str, "mac-x64") != 0
                       || str_eq_full(emit_str, "mac-arm64") != 0 {
                    // "mac", "macos", "mac-x64", "mac-arm64" alias to Mach-O
                    emit_mode = 1
                } else if str_eq_full(emit_str, "darwin") != 0 {
                    emit_mode = 1
                } else if str_eq_full(emit_str, "windows") != 0
                       || str_eq_full(emit_str, "windows-x64") != 0
                       || str_eq_full(emit_str, "windows-arm64") != 0 {
                    // "windows", "windows-x64", "windows-arm64" alias to PE
                    emit_mode = 2
                } else if str_eq_full(emit_str, "win") != 0
                       || str_eq_full(emit_str, "win-x64") != 0
                       || str_eq_full(emit_str, "win-arm64") != 0 {
                    // "win", "win-x64", "win-arm64" alias to PE
                    emit_mode = 2
                } else if str_eq_full(emit_str, "pe") != 0 {
                    emit_mode = 2
                } else if str_eq_full(emit_str, "obj") != 0 {
                    emit_mode = 3
                } else if str_eq_full(emit_str, "android") != 0 {
                    emit_mode = 4
                } else if str_eq_full(emit_str, "asm") != 0 {
                    emit_mode = 5
                } else if str_eq_full(emit_str, "ir") != 0 {
                    emit_mode = 6
                } else if str_eq_full(emit_str, "lkm") != 0 {
                    // Linux loadable kernel module — relocatable ELF (.ko)
                    // with .modinfo, struct module, init_module /
                    // cleanup_module symbols. Phase A.1.
                    emit_mode = 7
                } else if str_eq_full(emit_str, "image") != 0 {
                    // Raw flat binary for bare metal — no container, and
                    // nothing precedes the code except the 64-byte arm64
                    // Image header --image-header opts into. emit_mode 8
                    // is a NEW value on purpose: the raw-path triggers for
                    // riscv32/xtensa key on emit_mode == 0 + freestanding
                    // (the rv_raw / xt_raw gates in compile()), so a new value
                    // is untouched by every existing invocation and
                    // byte-identity holds by construction. The line number
                    // that used to be here, `:2340`, was wrong when it was
                    // written and wronger after D moved the gates; named
                    // variables do not rot.
                    emit_mode = 8
                } else if str_eq_full(emit_str, "uefi") != 0 {
                    // UEFI application: a PE32+ image that firmware loads and
                    // enters directly (sub-project D). A NEW emit_mode value
                    // rather than a modifier on 2 (--emit=pe) or 8
                    // (--emit=image), because it shares the CONTAINER with
                    // neither: --emit=pe hardcodes a kernel32 import table and
                    // a Windows subsystem, and --emit=image has no container
                    // at all. What it does share with 8 is the PAYLOAD, which
                    // is why both are in img_raw.
                    emit_mode = 9
                    uefi_set = 1
                } else if str_eq_full(emit_str, "fatimage") != 0 {
                    // ONE boot image with several boot paths (see
                    // compile_fatimage above for the layout and the reasoning).
                    // A NEW emit_mode for the reason 9 and 10 are new ones: it
                    // shares its PAYLOADS with 8 and 9 -- it literally calls
                    // compile() with those two modes, once per slice -- and its
                    // CONTAINER with nothing, because the container is the
                    // composition itself. A new value is also untouched by
                    // every existing invocation.
                    //
                    // NOT A MODIFIER ON --emit=image. Mode 8 emits ONE artifact
                    // for ONE architecture from ONE codegen pass; this drives
                    // several passes and writes a file none of them produced.
                    // The finalize chain in compile() has no arm for 11 and
                    // must not grow one: this mode never reaches compile() as
                    // itself, only as the 8s and 9s it dispatches.
                    emit_mode = 11
                } else if str_eq_full(emit_str, "arx") != 0 {
                    // ARX: ApexRift's own executable container, which its
                    // kernel parses directly (docs/ARX_FORMAT.md in that tree).
                    // A NEW emit_mode for the same reason 9 is one: it shares
                    // the PAYLOAD with 8 and 9 -- flat, position-independent,
                    // img_raw -- and its CONTAINER with nothing. A new value is
                    // also untouched by every existing invocation, so
                    // byte-identity for the other modes holds by construction
                    // rather than by testing.
                    //
                    // Unlike 8 this is a HOSTED artifact: no entry stub, no
                    // multiboot header, no --stack-top=. That falls out of the
                    // existing rules rather than needing new ones -- the stubs
                    // gate on stack_top_set, and --stack-top= is already
                    // refused outside --emit=image with a message that says
                    // hosted containers manage the stack through their loader.
                    emit_mode = 10
                } else {
                    write(2, "error: unknown emit format '", 28)
                    uint64 esl = str_len(emit_str)
                    write(2, emit_str, esl)
                    write(2, "'\n", 2)
                    // EVERY spelling the arms above accept, in the order they
                    // appear there. It used to be a SAMPLE presented as a
                    // list: 16 of the then-27 names, silently omitting
                    // elf-arm64, macos, win-x64 and nine more, so a user
                    // whose spelling was rejected for a typo was told their
                    // corrected spelling was invalid too. Pinned BOTH WAYS by
                    // emit_valid_list_is_complete in the suite -- every arm
                    // must appear here and every name here must be an arm --
                    // because this is exactly the enumeration a new emit mode
                    // falsifies, and --emit=uefi did falsify it.
                    uint64 evl = "valid: elfexe, elf, elf-arm64, elf-x86_64, linux, linux-x86_64, linux-arm64, linux-x86-64, macho, mac, macos, mac-x64, mac-arm64, darwin, windows, windows-x64, windows-arm64, win, win-x64, win-arm64, pe, obj, android, asm, ir, lkm, image, uefi, fatimage, arx\n"
                    write(2, evl, str_len(evl))
                    exit(1)
                }
            } else if str_starts_with(arg, "--load-addr=", 12) != 0 {
                // An explicit arm, and it must precede the final
                // `else { input_path = arg }` fallthrough: before this,
                // --load-addr=0x400000 was swallowed as an INPUT FILENAME and
                // the build died with "cannot open '--load-addr=0x400000'".
                // A COLON SELECTS THE PER-ARCHITECTURE FORM. A fat image has
                // one load address per slice, so a bare --load-addr= under
                // --emit=fatimage would have to pick one and silently apply it
                // to both; the colon form makes the user say which. The
                // discriminator is the colon rather than the emit mode because
                // flags are order-independent here -- --emit= may not have been
                // seen yet when this arm runs.
                uint64 la_v = arg + 12
                uint64 la_ci = fatimg_find_byte(la_v, 58)
                if la_ci != 0xFFFFFFFF {
                    parse_fat_addr_arg(la_v, la_ci, 0)
                } else {
                    load_addr = parse_load_addr(la_v)
                    load_addr_set = 1
                }
            } else if str_starts_with(arg, "--stack-top=", 12) != 0 {
                // Same V7 hazard load_addr's arm comments on: without an
                // explicit arm here, --stack-top=... falls through to the
                // final `else { input_path = arg }` and dies with
                // "cannot open '--stack-top=...': file not found" instead
                // of naming itself.
                // Same colon discriminator as --load-addr= above, and for the
                // same reason: each slice's stub sets its own SP.
                uint64 st_v = arg + 12
                uint64 st_ci = fatimg_find_byte(st_v, 58)
                if st_ci != 0xFFFFFFFF {
                    parse_fat_addr_arg(st_v, st_ci, 1)
                } else {
                    stack_top = parse_stack_top(st_v)
                    stack_top_set = 1
                }
            } else if str_starts_with(arg, "--slice=", 8) != 0 {
                // An explicit arm, for the V7 reason --load-addr='s arm gives:
                // without one, --slice=arm64:x.img falls through to the final
                // `else { input_path = arg }` and the build dies with "cannot
                // open '--slice=arm64:x.img'" instead of the flag naming
                // itself. Validated against --emit=fatimage after the loop.
                parse_fat_slice_arg(arg + 8)
            } else if str_starts_with(arg, "--fat-uefi=", 11) != 0 {
                parse_fat_uefi_arg(arg + 11)
            } else if str_eq_full(arg, "--fat-uefi") != 0 {
                // str_starts_with above matches the `=` form only, so without
                // this arm a bare --fat-uefi falls through to the input-path
                // else and is read as a filename. This flag REQUIRES a value
                // (unlike --image-header, which takes none), so the bare form
                // is rejected rather than defaulted -- defaulting it would make
                // "--fat-uefi" and "no --fat-uefi at all" mean the same thing
                // while looking like a request.
                uint64 fu_bare = "error: --fat-uefi requires a value: write --fat-uefi=x86_64, --fat-uefi=arm64 or --fat-uefi=none. A PE carries one COFF Machine value, so the fat image has to be told which architecture's firmware it is for\n"
                write(2, fu_bare, str_len(fu_bare))
                exit(1)
            } else if str_eq_full(arg, "--image-header") != 0 {
                // No value to parse -- an explicit arm is still needed for
                // the same V7 reason --load-addr=/--stack-top= have one:
                // without it, --image-header falls through to the final
                // `else { input_path = arg }` and dies with "cannot open
                // '--image-header': file not found" instead of naming
                // itself. Validated below; the 64 bytes it turns on are
                // emitted from the `a64hdr_on` block on the emit_mode 8 path.
                image_header_set = 1
            } else if str_starts_with(arg, "--image-header=", 15) != 0 {
                // str_eq_full above only matches the bare spelling, so
                // without this arm `--image-header=1` fell through to the
                // final `else { input_path = arg }` and was silently
                // ignored (exit 0, 56-byte artifact with no header instead
                // of the 120-byte header-prefixed one). This flag takes no
                // value, unlike --load-addr=/--stack-top=, so unlike those
                // the fix is to reject the `=` form outright rather than
                // parse it.
                write(2, "error: --image-header takes no value\n", 37)
                exit(1)
            } else if str_eq_full(arg, "--reset-vector") != 0 {
                // No value to parse -- same V7 reason --image-header's arm
                // comments above give: without an explicit arm here,
                // --reset-vector falls through to the final
                // `else { input_path = arg }` and dies with "cannot open
                // '--reset-vector': file not found" instead of naming
                // itself. Validated below, alongside --emit=image's other
                // flags; the stage bytes it opts into are emitted by
                // emit_x86_reset_vector_stage on the emit_mode 8 path.
                reset_vector_set = 1
            } else if str_starts_with(arg, "--reset-vector=", 15) != 0 {
                // str_eq_full above matches the bare spelling only, so
                // without this arm `--reset-vector=1` fell through to the
                // final `else { input_path = arg }` -- measured: exit 0 and
                // a 256-byte MULTIBOOT artifact, because the flag was never
                // set and --stack-top alone selects B2's stub, instead of
                // the 65536-byte reset-vector image the user asked for.
                // This flag takes no value, so the fix is to reject the
                // `=` form outright rather than parse it.
                write(2, "error: --reset-vector takes no value\n", 37)
                exit(1)
            } else if str_eq_full(arg, "-c") != 0 {
                emit_set = 1
                uefi_set = 0
                emit_mode = 3
            } else if str_starts_with(arg, "-c=", 3) != 0 {
                // str_eq_full above matches bare "-c" only, so without this
                // arm `-c=1` fell through to the final
                // `else { input_path = arg }` -- measured: exit 0 and a
                // 176-byte executable instead of a .o. This flag takes no
                // value, so reject the `=` form outright.
                write(2, "error: -c takes no value\n", 25)
                exit(1)
            } else if str_starts_with(arg, "--targets=", 10) != 0 {
                parse_targets_arg(arg + 10)
            } else if str_starts_with(arg, "--target=", 9) != 0 {
                uint64 tgt_str = arg + 9
                uint64 tgt_kind = 0
                if str_eq_full(tgt_str, "macos") != 0 {
                    tgt_kind = 2
                } else if str_eq_full(tgt_str, "darwin") != 0 {
                    tgt_kind = 2
                } else if str_eq_full(tgt_str, "windows") != 0 {
                    tgt_kind = 3
                } else if str_eq_full(tgt_str, "win") != 0 {
                    tgt_kind = 3
                } else if str_eq_full(tgt_str, "linux") != 0 {
                    tgt_kind = 1
                } else if str_eq_full(tgt_str, "android") != 0 {
                    tgt_kind = 4
                } else if str_eq_full(tgt_str, "esp32") != 0 {
                    // Machine target, not an OS: ESP32 (Xtensa LX6) esp-image.
                    // Requires --arch=xtensa --freestanding — validated after
                    // the arg loop so flag order doesn't matter.
                    //
                    // EXACT match, deliberately NOT str_starts_with: the OS
                    // names above can afford a prefix match, but "esp32s3" and
                    // "esp32c3" are DIFFERENT CHIPS with different memory maps
                    // (and C3 is RISC-V, not Xtensa). A prefix match would let
                    // --target=esp32s3 silently masquerade as an ESP32 and emit
                    // an image with wrong-for-that-chip load addresses — i.e. a
                    // board that does not boot, diagnosed over ~2-minute flash
                    // cycles with no JTAG. Unknown targets hit the loud error
                    // below rather than being silently ignored.
                    tgt_kind = 5
                } else if str_eq_full(tgt_str, "none") != 0 {
                    // Bare metal: no operating system. Forces freestanding
                    // (main's prologue/epilogue only emit OS startup/exit code
                    // when freestanding == 0 -- the three `freestanding == 0`
                    // guards on `main` in ir.kr; the line numbers that used to
                    // be quoted here, :13084 and :13405, pointed at a blank
                    // line and an unrelated store) so
                    // --target=none alone is enough — the user does not also
                    // have to pass --freestanding. Lowering for target_os == 4
                    // beyond this flag surface is later work; this only
                    // records the value and refuses combinations that are
                    // nonsense today (fat-binary slice, esp32, lkm/android
                    // emit modes).
                    tgt_kind = 6
                } else {
                    // Unknown --target=: fail loud. Previously this fell off the
                    // if-chain and was SILENTLY IGNORED, so a typo (or a
                    // near-miss like "esp32s3") produced a default-target binary
                    // with no warning at all. Mirrors the existing behaviour for
                    // an unknown --arch, and matches the project rule of loud
                    // failure over silently emitting the wrong thing.
                    uint64 tgt_err = "error: unknown --target= value (expected: linux, macos/darwin, windows/win, android, esp32, none)\n"
                    write(2, tgt_err, str_len(tgt_err))
                    exit(1)
                }

                // A second, different --target= is a conflict, not last-wins.
                // Verified broken before this check existed: --target=esp32
                // composed silently with a preceding OS name (or --target=
                // none), each order building byte-identical to plain esp32
                // with the other flag's value swallowed with no warning.
                if target_arg_seen != 0 && target_arg_kind != tgt_kind {
                    uint64 tc_msg1 = "error: conflicting --target= values: '"
                    write(2, tc_msg1, str_len(tc_msg1))
                    write(2, target_arg_str, str_len(target_arg_str))
                    uint64 tc_msg2 = "' and '"
                    write(2, tc_msg2, str_len(tc_msg2))
                    write(2, tgt_str, str_len(tgt_str))
                    uint64 tc_msg3 = "' - pass --target= once\n"
                    write(2, tc_msg3, str_len(tc_msg3))
                    exit(1)
                }
                target_arg_seen = 1
                target_arg_kind = tgt_kind
                target_arg_str = tgt_str

                if tgt_kind == 1 {
                    target_os = 0
                } else if tgt_kind == 2 {
                    target_os = 1
                } else if tgt_kind == 3 {
                    target_os = 2
                } else if tgt_kind == 4 {
                    target_os = 3
                    emit_mode = 4
                } else if tgt_kind == 5 {
                    machine_target = 1
                } else if tgt_kind == 6 {
                    target_os = 4
                    freestanding = 1
                }
            } else if str_starts_with(arg, "-h=", 3) != 0 {
                // -h is matched with str_eq_full below (bare spelling
                // only), so without this arm `-h=1` fell through to the
                // final `else { input_path = arg }` and was silently
                // treated as an input filename instead of printing help.
                // --help itself keeps its str_starts_with arm below and so
                // still accepts (and ignores) `--help=anything` -- that is
                // the same shape every other `str_starts_with`-matched flag
                // has, and is explicitly out of scope here (see the
                // --image-header/--reset-vector/-c arms above). -h takes no
                // value, so reject the `=` form outright.
                write(2, "error: -h takes no value\n", 25)
                exit(1)
            } else if str_starts_with(arg, "--help", 6) != 0 || str_eq_full(arg, "-h") != 0 {
                write(1, "usage: krc [options] <file.kr> [-o output]\n", 43)
                write(1, "       krc <command> <file.kr> [options]\n\n", 42)
                write(1, "default: emit a .krbo fat binary covering all 8 supported targets\n", 66)
                write(1, "(linux/macos/windows/android x x86_64/arm64). The kr runner extracts\n", 69)
                write(1, "and execs the matching slice at startup.\n\n", 42)

                write(1, "output:\n", 8)
                write(1, "  --arch=x86_64|arm64|riscv32|xtensa   single-arch binary (no fat-binary wrap)\n", 79)
                uint64 tgt_help = "  --target=linux|macos|windows|android|esp32|none   single-target binary\n"
                write(1, tgt_help, str_len(tgt_help))
                // 'none' adds values to the get_target_os()/get_arch_id() ABI
                // rather than reusing an OS's, so --help states them: a user
                // who writes `if get_arch_id() == 2` for arm64 gets 10 on a
                // bare-metal arm64 build and must handle it.
                uint64 tn_help = "                              'none' = bare metal, no OS: get_target_os()=4, get_arch_id()=9-12\n"
                write(1, tn_help, str_len(tn_help))
                write(1, "  --targets=<list>          custom fat binary subset\n", 53)
                write(1, "                              e.g. linux-x64,macos-arm64,win-x64\n", 65)
                write(1, "  --emit=elfexe|macho|pe|android        single-target executable\n", 65)
                write(1, "  --emit=obj                relocatable .o (.obj on Windows)\n", 61)
                write(1, "  --emit=lkm                Linux loadable kernel module (.ko)\n", 63)
                write(1, "  --emit=asm                annotated assembly listing\n", 55)
                // NOT SSA. IR_PHI has a declaration and a printer but zero
                // ir_emit(IR_PHI...) construction sites -- the IR is linear
                // three-address code over unbounded vregs (named variables
                // reuse one vreg across assignments, so no phi is ever
                // needed). This line used to say "dump SSA IR per function",
                // which was simply false; --emit=ir dumps this linear IR,
                // pre-DCE.
                write(1, "  --emit=ir                 dump IR per function\n", 49)
                // THE `--load-addr=` CLAUSE IS QUALIFIED BECAUSE --reset-vector
                // FALSIFIED IT (sub-project E, Task 4). This line read "needs
                // --target=none, explicit --arch, --load-addr=" while
                // --reset-vector REFUSES --load-addr=, and it named only one of
                // the two sub-forms. Neither the help<->docs gate nor anything
                // else could see that: those rows compare flag TOKENS, and both
                // tokens are in both texts.
                uint64 h_img = "  --emit=image             raw flat binary, no container (bare metal; needs --target=none and an explicit --arch; --load-addr= too, EXCEPT under --reset-vector, which refuses it). Sub-forms: --image-header prefixes an arm64 boot header, --reset-vector selects the x86_64 QEMU -bios form\n"
                write(1, h_img, str_len(h_img))
                // A dedicated line, not a clause inside another flag's
                // description: `hd_flags`'s regex stops at `=`, so it reads
                // `--emit` out of `--emit=uefi` and the docs-consistency rows
                // are already satisfied by a token that predates this mode.
                // An --emit= VALUE is structurally invisible to them, which is
                // why this line and its docs section each carry their own row
                // (uefi_help_has_own_line, uefi_docs_section_intact).
                uint64 h_uefi = "  --emit=uefi              UEFI application: a PE32+ image firmware loads and enters directly (bare metal; needs --target=none and an explicit --arch=x86_64|arm64; takes no --load-addr/--stack-top -- firmware places the image where it likes and enters with a stack already set up; unsigned, so Secure Boot refuses it)\n"
                write(1, h_uefi, str_len(h_uefi))
                // A dedicated line, for the reason --emit=uefi's own note
                // gives: hd_flags's regex stops at `=`, so it reads `--emit`
                // out of `--emit=fatimage` and the docs-consistency rows are
                // already satisfied by a token that predates this mode. An
                // --emit= VALUE is structurally invisible to them, so this line
                // and its docs section each carry their own suite row.
                uint64 h_fat = "  --emit=fatimage          ONE boot image with several boot paths: x86_64 multiboot, x86_64 (or arm64) UEFI, and arm64 raw Image, all in one file (bare metal; needs --target=none and --arch=x86_64,arm64). The same source is compiled once per architecture unless --slice= supplies one. Byte 0 is shared between the PE 'MZ' and the arm64 Image header's code0 -- the constant 0x91005A4D is 'MZ' to firmware and `add x13, x18, #0x16` to a CPU\n"
                write(1, h_fat, str_len(h_fat))
                uint64 h_sl = "  --slice=<arch>:<file>    use a prebuilt raw image for one architecture of a fat image instead of compiling it (needs --emit=fatimage; the file must record its own entry point, i.e. be built with --emit=image --stack-top= on x86_64 and additionally --image-header on arm64). An x86_64 slice must ALSO have been built for the address it lands at -- its trampoline's `movabs $entry,%rax` is absolute -- and the build refuses one that was not, naming the address to rebuild at; arm64 slices relocate freely\n"
                write(1, h_sl, str_len(h_sl))
                uint64 h_fu = "  --fat-uefi=<arch>|none   which architecture of a fat image gets the PE/UEFI boot path; exactly one can, because a PE's COFF header carries one Machine value (default: x86_64, or arm64 if x86_64 came from --slice=, or none if both did; the build prints which)\n"
                write(1, h_fu, str_len(h_fu))
                uint64 h_pa = "  --load-addr=<arch>:<addr>, --stack-top=<arch>:<addr>\n                            per-slice forms of the two flags above, for --emit=fatimage only -- the load address is where the WHOLE FILE lands for that architecture, and each slice's own address is that base plus its offset in the file. Defaults: x86_64 load 0x400000 / stack 0x3f0000 (the classic multiboot address, with the stack below the image and clear of the trampoline's page tables at 0x1000-0x4000); arm64 load 0x40000000 / stack 0x40800000 (QEMU virt RAM base, stack 8 MiB in)\n"
                write(1, h_pa, str_len(h_pa))
                uint64 h_arx = "  --emit=arx               ARX container: a program ApexRift loads from its own filesystem and enters (bare metal, HOSTED; needs --target=none and --arch=x86_64|arm64; takes no --load-addr/--stack-top -- the loader chooses the address at run time and supplies the stack; arm64 containers declare align 4096 because the loader must place them page-congruently for ADRP)\n"
                write(1, h_arx, str_len(h_arx))
                uint64 h_la = "  --load-addr=<addr>       where the image will be loaded; validated (arm64: 4096-aligned) and reported, never embedded\n"
                write(1, h_la, str_len(h_la))
                // EVERY x86_64 NUMBER ON THIS LINE IS THE MULTIBOOT STUB's, AND
                // --reset-vector REPLACES ALL OF THEM (sub-project E, Task 4):
                // its page-table band is 0x1000-0x7000, its ceiling is the 4 GiB
                // map, and it refuses --load-addr= outright, so the
                // stack-inside-the-image rule has no load address to be computed
                // from and is not applied. Stated as a pointer rather than a
                // second set of numbers: help_docs_stacktop_* probes THESE
                // numbers against the compiler, and a line carrying two rule
                // sets could satisfy those greps with the wrong one.
                uint64 h_st = "  --stack-top=<addr>       emit a self-booting entry stub that sets SP here (x86_64 also gets a multiboot header + long-mode trampoline); validated per-arch (arm64: 16-byte aligned, <2^32; x86_64: <=0x40000000, its first push must clear the page tables at 0x1000-0x4000 so the stack top is <=0x1000 or >=0x4008, and --load-addr must then be in [0x4000,0x40000000)); on both arches the stack must not start inside the image; no default. Under --reset-vector NONE of the x86_64 rules here apply -- that form has its own, wider ones; see LANGUAGE.md\n"
                write(1, h_st, str_len(h_st))
                uint64 h_ih = "  --image-header            prefix the 64-byte arm64 Linux Image header (magic 0x644d5241) so a loader can boot the artifact from its first byte; requires --emit=image, --arch=arm64 and --stack-top=\n"
                write(1, h_ih, str_len(h_ih))
                uint64 h_rv = "  --reset-vector            x86_64 QEMU -bios reset-vector form: fixed 64 KiB, entered directly with no loader; requires --arch=x86_64, --target=none and --stack-top=, refuses --load-addr=; the stack must also lie within the guest's INSTALLED RAM, which cannot be checked here -- see LANGUAGE.md\n"
                write(1, h_rv, str_len(h_rv))
                write(1, "  -c                        shorthand for --emit=obj\n", 53)
                write(1, "  -o <path>                 output path\n\n", 41)

                write(1, "code generation:\n", 17)
                write(1, "  --ir                      force IR backend (default)\n", 55)
                write(1, "  --legacy                  legacy direct codegen path\n", 55)
                write(1, "  --coalesce                Briggs/George copy coalescing (default on)\n", 71)
                write(1, "  --no-coalesce             disable copy coalescing\n", 52)
                write(1, "  --check-types             type checker (default on)\n", 54)
                uint64 wmsg_w = "  -w                        suppress warnings (errors unaffected)\n"
                write(1, wmsg_w, 66)
                uint64 wmsg_5200 = "  --no-check-types          disable type checker\n"
                write(1, wmsg_5200, str_len(wmsg_5200))
                write(1, "  --O0                      disable IR optimizations (CF/DCE/CSE/LICM)\n", 71)
                write(1, "  --freestanding            no startup code, no libc\n", 53)
                write(1, "  --debug                   runtime safety checks (bounds, null)\n", 65)
                write(1, "  -g                        emit DWARF debug info\n\n", 51)

                write(1, "commands (living compiler):\n", 28)
                write(1, "  check <file.kr>           safety analysis\n", 44)
                write(1, "  lc <file.kr>              propose / classify changes\n", 55)
                write(1, "  fmt <file.kr>             auto-format source\n", 47)
                write(1, "  --list-proposals          list pending proposals\n", 51)
                write(1, "  --promote <name>          accept a proposal\n", 46)
                write(1, "  --deprecate <name>        deprecate an accepted proposal\n", 59)
                write(1, "  --reject <name>           reject a proposal\n", 46)
                write(1, "  --min-fitness <N>         min fitness for --promote\n", 54)
                write(1, "  --ci                      machine-readable check output\n", 58)
                write(1, "  --fix                     apply auto-fixes from check\n", 56)
                uint64 wmsg_undo = "  lc undo <file>           restore <file> from the backup --fix wrote\n"
                write(1, wmsg_undo, 70)
                write(1, "  --dry-run                 show changes without writing\n\n", 58)

                write(1, "info:\n", 6)
                write(1, "  --version                 show version\n", 41)
                write(1, "  --help, -h                show this help\n", 43)
                exit(0)
            } else if str_starts_with(arg, "--version", 9) != 0 {
                uint64 msg = "krc 2.10.0 (KernRift self-hosted compiler)\n"
                write(1, msg, str_len(msg))
                exit(0)
            } else if str_starts_with(arg, "--freestanding", 14) != 0 {
                freestanding = 1
            } else if str_starts_with(arg, "--legacy", 8) != 0 {
                emit_ir_mode = 0
            } else if str_starts_with(arg, "--ir", 4) != 0 {
                emit_ir_mode = 2
            } else if str_starts_with(arg, "--O0", 4) != 0 {
                ir_opt_level = 0
            } else if str_starts_with(arg, "--no-coalesce", 13) != 0 {
                ir_set_coalesce(0)
            } else if str_starts_with(arg, "--coalesce", 10) != 0 {
                ir_set_coalesce(1)
            } else if str_eq_full(arg, "-w") != 0 {
                // Suppress warnings. Matched EXACTLY: "-w" is short enough
                // that a prefix match would also swallow "-wsomething" and
                // silently accept a typo.
                diag_set_no_warnings(1)
            } else if str_starts_with(arg, "--no-check-types", 16) != 0 {
                check_types_enabled = 0
            } else if str_starts_with(arg, "--check-types", 13) != 0 {
                check_types_enabled = 1
            } else if str_starts_with(arg, "--debug", 7) != 0 {
                debug_mode = 1
            } else if str_starts_with(arg, "-g", 2) != 0 {
                debug_info_mode = 1
            } else if str_starts_with(arg, "--ci", 4) != 0 {
                lc_ci_mode = 1
            } else if str_starts_with(arg, "--fix", 5) != 0 {
                lc_fix_mode = 1
            } else if str_starts_with(arg, "--dry-run", 9) != 0 {
                lc_dry_run = 1
            } else if str_starts_with(arg, "--list-proposals", 16) != 0 {
                lc_list_proposals = 1
                mode = 2
            } else if str_starts_with(arg, "--promote=", 10) != 0 {
                lc_promote_name = arg + 10
                mode = 2
            } else if str_starts_with(arg, "--promote", 9) != 0 {
                i = i + 1
                uint64 pnext_ptr = cli_argv + i * 8
                uint64 pnext_arg = 0
                unsafe { *(pnext_ptr as uint64) -> pnext_arg }
                lc_promote_name = pnext_arg
                mode = 2
            } else if str_starts_with(arg, "--deprecate=", 12) != 0 {
                lc_deprecate_name = arg + 12
                mode = 2
            } else if str_starts_with(arg, "--deprecate", 11) != 0 {
                i = i + 1
                uint64 dnext_ptr = cli_argv + i * 8
                uint64 dnext_arg = 0
                unsafe { *(dnext_ptr as uint64) -> dnext_arg }
                lc_deprecate_name = dnext_arg
                mode = 2
            } else if str_starts_with(arg, "--reject=", 9) != 0 {
                lc_reject_name = arg + 9
                mode = 2
            } else if str_starts_with(arg, "--reject", 8) != 0 {
                i = i + 1
                uint64 rnext_ptr = cli_argv + i * 8
                uint64 rnext_arg = 0
                unsafe { *(rnext_ptr as uint64) -> rnext_arg }
                lc_reject_name = rnext_arg
                mode = 2
            } else if str_starts_with(arg, "--min-fitness=", 14) != 0 {
                lc_min_fitness = parse_uint_arg(arg + 14)
            } else if str_starts_with(arg, "--min-fitness", 13) != 0 {
                // --min-fitness N (next arg)
                i = i + 1
                uint64 next_ptr = cli_argv + i * 8
                uint64 next_arg = 0
                unsafe { *(next_ptr as uint64) -> next_arg }
                lc_min_fitness = parse_uint_arg(next_arg)
            } else if str_starts_with(arg, "check", 5) != 0 && str_len(arg) == 5 {
                mode = 1
            } else if str_eq_full(arg, "undo") != 0 {
                lc_undo_mode = 1
            } else if str_starts_with(arg, "lc", 2) != 0 && str_len(arg) == 2 {
                mode = 2
            } else if str_starts_with(arg, "fmt", 3) != 0 && str_len(arg) == 3 {
                mode = 3
            } else {
                // Subcommands require an EXACT match (above); anything else —
                // including a filename like `checksum.kr` or `lcd_driver.kr`
                // that merely shares a prefix — is the input path, not a mode.
                input_path = arg
            }
            i = i + 1
        }
    }



    // Auto-set target_os from emit_mode if not explicitly set
    if emit_mode == 1 && target_os == 0 { target_os = 1 }
    if emit_mode == 2 && target_os == 0 { target_os = 2 }
    if emit_mode == 4 && target_os == 0 { target_os = 3 }
    // emit_mode=4 (android): default to arm64 unless --arch was explicitly set
    if emit_mode == 4 && arch_set == 0 { arch = 1 }

    // --emit=uefi survived the argument loop, or it did not. THE ONLY THING
    // THAT CAN TAKE IT AWAY IS --target=android, which assigns emit_mode = 4
    // in the middle of the loop; a later --emit= clears uefi_set on its way
    // past, so ordinary last-wins never reaches here.
    //
    // FIRST, AHEAD OF EVERY OTHER REFUSAL IN THIS FILE, because by this point
    // emit_mode says 4 and target_os says 3 — the request is invisible to
    // every check keyed on either. Without this the line emits an Android PIE
    // ELF at exit 0 with no diagnostic, which is the exact shape sub-project A
    // spent a Critical on. The opposite order (`--target=android --emit=uefi`)
    // is NOT this defect: there --emit=uefi legitimately wins the chain and is
    // refused by the --target=none rule below, which is a different door and
    // says so.
    if uefi_set != 0 && emit_mode != 9 {
        uint64 uf_ov = "error: --emit=uefi was overridden by --target=android: --target=android does not only select an OS, it also forces --emit=android, so the UEFI application you asked for would have been emitted as an Android PIE ELF. Drop --target=android (--emit=uefi requires --target=none), or drop --emit=uefi\n"
        write(2, uf_ov, str_len(uf_ov))
        exit(1)
    }

    // WAS: a refusal of --debug on every command line that reaches legacy
    // arm64 codegen, because codegen_aarch64.kr had no array-bounds-check
    // machinery at all -- `uint64[4] a; a[99]` under --debug aborted (rc=1)
    // on x86_64 legacy, x86_64 IR and arm64 IR, and on legacy arm64 read
    // whatever was past the array and exited 0. --debug is a safety promise,
    // so the flag was refused rather than shipped unmet with no diagnostic.
    //
    // REMOVED because the checks now exist. codegen_aarch64.kr emits them at
    // the same two subscript sites legacy x86_64 does -- the rvalue read in
    // gen_expr_a64 and the indexed assignment in gen_stmt_a64 -- from the
    // same arr_count_lookup, with the same unsigned comparison and the same
    // silent exit(1). arr_count_lookup now has 6 call sites: codegen.kr's
    // two (legacy x86_64), ir.kr's two (IR, both arches), and
    // codegen_aarch64.kr's two.
    //
    // NOTHING REPLACES THE REFUSAL, AND NOTHING NEEDS TO. The refusal had to
    // be DERIVED from the codegen dispatch rather than enumerated from flag
    // spellings -- its first version refused `--legacy --arch=arm64 --debug`
    // and missed `--arch=arm64 --emit=obj --debug`, which reaches the same
    // codegen with --legacy nowhere on the line, because a relocatable
    // object always uses legacy codegen so extern relocations resolve; the
    // fat path's four arm64 slices were a third family again. That whole
    // problem is gone rather than solved: the check now lives in the
    // codegen, so every route that reaches gen_expr_a64/gen_stmt_a64 --
    // --legacy, --emit=obj, --emit=lkm, --emit=android, a fat build's arm64
    // slices, and any route added later -- carries it by construction. A
    // front-end predicate could go stale against the dispatch it mirrors;
    // this cannot.
    //
    // The collateral the refusal cost is also returned: codegen_aarch64.kr's
    // overflow, null-pointer and divide-by-zero guards always worked, and
    // the refusal made them unreachable on these command lines too (the
    // checks are all-or-nothing per backend). All five now work on legacy
    // arm64.
    //
    // Still refused, for an unrelated reason: --debug with --target=none, a
    // few hundred lines below -- a failed check has nowhere to go on bare
    // metal, and that refusal is what keeps the new trap's SVC from ever
    // reaching emit_a64_svc_word's bare-metal backstop.

    // --target=none is a bare-metal image: no kernel to load a loadable
    // kernel module into, no Android runtime to host an APK payload. Refuse
    // both explicitly rather than emitting a container that nothing on that
    // target can ever load.
    //
    // Every refusal in this block NAMES BOTH FLAGS. A message that says only
    // "--target=none" leaves the user to guess which of the other flags on
    // the line to drop, and these combinations are reached by flags that are
    // individually correct.
    if target_os == 4 {
        if emit_mode == 7 {
            uint64 lkm_msg = "error: --emit=lkm conflicts with --target=none: a loadable kernel module has no kernel to load into\n"
            write(2, lkm_msg, str_len(lkm_msg))
            exit(1)
        }
        if emit_mode == 4 {
            uint64 and_msg = "error: --emit=android conflicts with --target=none: android is an OS target, not a bare-metal one\n"
            write(2, and_msg, str_len(and_msg))
            exit(1)
        }
        // Mach-O and PE are OS CONTAINERS, not just byte layouts: a Mach-O
        // image is loaded by dyld through LC_MAIN and its segments are mapped
        // by the macOS kernel; the PE this compiler emits is loaded by the
        // Windows loader, which binds its imports. Before this, `--emit=macho
        // --target=none` exited 0 and wrote a real 8192-byte Mach-O
        // (2048-byte PE) full of bare-metal codegen — a file no macOS and no
        // bare-metal machine can load. Keyed on the resolved emit_mode, not on
        // the spelling, so the aliases (darwin/mac/mac-arm64,
        // win/win-x64/windows-arm64) are covered by the same two checks.
        //
        // THE PE HALF KEPT ITS CHECK AND LOST ITS REASONING (sub-project D,
        // Task 1). It used to say a PE "is an OS container (the Windows
        // loader, an import table, a subsystem field) and nothing on bare
        // metal loads one", and that last clause is simply false: UEFI
        // firmware loads a PE32+ on bare metal on every boot, and the
        // subsystem field is precisely how it tells an EFI application from a
        // Windows one. The REFUSAL is still right, for a narrower and
        // verifiable reason: what --emit=pe emits is a WINDOWS PE. It carries
        // an unconditional kernel32 .idata (verified present in the emitted
        // bytes), and its entry instruction is `call *0xf6e(%rip)` into an IAT
        // slot that only the Windows loader ever fills, so on bare metal it
        // jumps through a null pointer on its first instruction. --emit=uefi
        // is the mode that does not do that, so the message names it.
        if emit_mode == 1 {
            uint64 mo_msg = "error: --emit=macho conflicts with --target=none: a Mach-O image is an OS container (dyld, LC_MAIN, segments mapped by the macOS kernel) and nothing on bare metal loads one; use the default ELF, or --emit=obj for a relocatable object to link yourself\n"
            write(2, mo_msg, str_len(mo_msg))
            exit(1)
        }
        if emit_mode == 2 {
            uint64 pe_msg = "error: --emit=pe conflicts with --target=none: --emit=pe emits a WINDOWS PE -- it imports kernel32 and its entry instruction calls through an import-table slot that only the Windows loader fills, so on bare metal it jumps through a null pointer before your code runs. Firmware does load PE32+ images, so if that is what you want use --emit=uefi; otherwise use the default ELF, or --emit=obj for a relocatable object to link yourself\n"
            write(2, pe_msg, str_len(pe_msg))
            exit(1)
        }
        // --debug inlines a per-OS `exit(1)` trap into every function that
        // indexes an array (IR_ARR_CHECK), dereferences a pointer (the
        // load/store null checks) or does checked arithmetic. Measured: 3
        // syscalls in a --debug bare-metal build against 1 without. The Task
        // 2 emitter guards did catch it, so it never shipped silently — but
        // they reported "SYSCALL reached the emitter from 'array bounds check
        // (--debug)'", which names something that is not a builtin, blames
        // the emitter for a decision made by a flag, and offers no remedy.
        // Worse, it only fired for programs that HAPPEN to use an array or a
        // pointer: an array-free bare-metal program compiled clean under
        // --debug, so the restriction surfaced on whichever function the user
        // wrote next. Refuse here, once, for every program and every arch.
        //
        // This is a refusal and not a lowering because there is nowhere for a
        // failed check to GO on bare metal: no kernel to exit to, no stderr,
        // no debugger. It becomes implementable when a bare-metal panic path
        // exists — a user-supplied @builtin_override panic handler, or a halt
        // the checks can branch to.
        //
        // SUB-PROJECT B2 DID NOT SUPPLY THAT PATH, though it is the obvious
        // place to look now. The emitted entry stub ends in a halt (arm64
        // `b .`, x86_64 `hlt; jmp .`), but it is the RETURN site of the entry
        // function, nothing routes a failed check to it, and it exists only
        // when --stack-top= is passed. A --debug build with no --stack-top
        // would still have nowhere to go, so the refusal stays unconditional.
        if debug_mode != 0 {
            uint64 dbg_msg = "error: --debug conflicts with --target=none: the runtime safety checks inline a per-OS exit(1) trap into every function that indexes an array or dereferences a pointer, and bare metal has no kernel to trap into. Drop --debug until a bare-metal panic path exists.\n"
            write(2, dbg_msg, str_len(dbg_msg))
            exit(1)
        }
        // The legacy backend (src/codegen.kr, src/codegen_aarch64.kr — ~220
        // target_os sites between them) has its own builtin dispatch and does
        // not go through ir_lower_expr at all, so the @builtin_override
        // routing that makes print/println/print_str/println_str work on bare
        // metal is absent there BY CONSTRUCTION. Those four refuse on the
        // legacy path rather than misbehaving, so this is not a correctness
        // hole — it is that `--legacy --target=none` silently selects the
        // strictly less capable of two backends for no gain. Refuse the
        // request instead.
        //
        // Refused even with --emit=obj, where --legacy is redundant (obj
        // always uses the legacy codegen): --legacy is an explicit request
        // for a backend, and under --target=none that request is refused
        // whatever else is on the line. --emit=obj on its own remains
        // ALLOWED — see the note there — so every bare-metal assertion about
        // the legacy codegen still has a live path to run through.
        if emit_ir_mode == 0 {
            uint64 lg_msg = "error: --legacy conflicts with --target=none: the legacy backend has no @builtin_override routing, so print/println/print_str/println_str cannot be provided on bare metal there. Drop --legacy (the IR backend is the default and supports them); --emit=obj still uses the legacy codegen and is still allowed.\n"
            write(2, lg_msg, str_len(lg_msg))
            exit(1)
        }
        // --emit=obj, --emit=asm, --emit=ir and the default --emit=elfexe are
        // all ALLOWED under --target=none, and that is a decision rather than
        // an omission:
        //   obj    — a relocatable object is the normal bare-metal
        //            deliverable (linked with the user's own script at the
        //            user's own load address) and is the only relocatable
        //            output this compiler produces. It is also the surviving
        //            path into the legacy codegen, which is what keeps the
        //            legacy backend's bare-metal guards reachable and tested.
        //   asm/ir — text describing the build. Nothing loads them, and
        //            --emit=ir under --target=none is already the oracle the
        //            provider-routing tests read.
        //   elfexe — the default, and the format --target=none emits.
    }

    // AHEAD OF EVERY MODE-SPECIFIC BLOCK BELOW, and that placement is the whole
    // reason these rows work. Measured: with them after the `emit_mode == 8`
    // block, `--emit=image --load-addr=x86_64:0x400000` was refused with
    // "--emit=image requires --load-addr=<addr>" -- true, unhelpful, and about
    // the wrong flag: the user DID pass --load-addr=, in a form that mode does
    // not have, and the message named neither that form nor the mode it belongs
    // to. A flag that names a mode it was not given must be answered by the flag
    // it is, before any other mode gets to complain about what is missing.
    // The three flags that exist only for --emit=fatimage. Same shape and same
    // placement as the --load-addr=/--stack-top=/--image-header rows just
    // below: a flag that names a mode it was not given is a refusal, never a
    // silent no-op. Measured shape this closes: before these rows,
    // `--arch=x86_64,arm64 --emit=image prog.kr` parsed the list, set
    // fat_arch_mask, and then built a SINGLE x86_64 image at exit 0 -- the
    // arm64 half of the request vanished with no diagnostic.
    if fat_arch_list_set != 0 && emit_mode != 11 {
        uint64 fl_im = "error: a comma-separated --arch= list is only meaningful with --emit=fatimage: every other emit mode produces one artifact for one architecture, so the second name in the list would be silently discarded. Pass --emit=fatimage, or name a single architecture\n"
        write(2, fl_im, str_len(fl_im))
        exit(1)
    }
    if fat_slice_seen != 0 && emit_mode != 11 {
        uint64 fs_im = "error: --slice= is only meaningful with --emit=fatimage: it substitutes a prebuilt image for one architecture of a multi-architecture composition, and no other emit mode composes anything for it to substitute into\n"
        write(2, fs_im, str_len(fs_im))
        exit(1)
    }
    if fat_uefi_set != 0 && emit_mode != 11 {
        uint64 fu_im = "error: --fat-uefi= is only meaningful with --emit=fatimage: it chooses which architecture of a fat image gets the PE/UEFI boot path. A single-architecture UEFI application is --emit=uefi, which needs no such choice\n"
        write(2, fu_im, str_len(fu_im))
        exit(1)
    }
    if emit_mode != 11 {
        if fat_load_x86_set != 0 || fat_load_a64_set != 0 {
            uint64 fla_im = "error: the per-architecture form --load-addr=<arch>:<addr> is only meaningful with --emit=fatimage: a single image has one load address, so write --load-addr=<addr> with no architecture prefix\n"
            write(2, fla_im, str_len(fla_im))
            exit(1)
        }
        if fat_stack_x86_set != 0 || fat_stack_a64_set != 0 {
            uint64 fsa_im = "error: the per-architecture form --stack-top=<arch>:<addr> is only meaningful with --emit=fatimage: a single image has one entry stub, so write --stack-top=<addr> with no architecture prefix\n"
            write(2, fsa_im, str_len(fsa_im))
            exit(1)
        }
    }
    // --emit=image (emit_mode 8): sub-project B1's flat-image surface.
    // Every refusal names both flags, matching the block above. These run
    // AFTER the target=none block so --legacy/--debug/-container refusals
    // keep their existing messages when both apply, and BEFORE the fat-binary
    // guard so --targets= cannot route an image build into compile_fat.
    if emit_mode == 8 {
        if target_os != 4 {
            uint64 im_tn = "error: --emit=image requires --target=none: without it the resolved target OS is a hosted one (the default is linux) and the flat blob would contain that OS's syscalls with no kernel behind them\n"
            write(2, im_tn, str_len(im_tn))
            exit(1)
        }
        // No --arch at all: refuse. --emit= sets emit_set, which skips the
        // fat path AND its "pass --arch" refusal, so the arch would
        // silently default to x86_64 — and the arm64 alignment validation
        // below would silently not run (the exact "no --arch at all"
        // entrance that was sub-project A's Task-1 Critical).
        if arch_set == 0 {
            uint64 im_ar = "error: --emit=image requires an explicit --arch=x86_64 or --arch=arm64: --load-addr validation is per-arch (arm64 demands 4096-alignment, x86_64 does not), so a silently defaulted arch would validate against the wrong rule\n"
            write(2, im_ar, str_len(im_ar))
            exit(1)
        }
        if arch == 2 {
            uint64 im_rv = "error: --emit=image is x86_64/arm64 only: --arch=riscv32 --freestanding already emits a raw boot image (entry hoisted to offset 0, sp preamble) and --emit=image would be a second spelling of it with different entry semantics\n"
            write(2, im_rv, str_len(im_rv))
            exit(1)
        }
        if arch == 3 {
            uint64 im_xt = "error: --emit=image is x86_64/arm64 only: xtensa raw emission is --arch=xtensa --freestanding (lx60 boot ELF) or --target=esp32 (esp-image), each with its own entry semantics\n"
            write(2, im_xt, str_len(im_xt))
            exit(1)
        }
        // --reset-vector (sub-project E, Task 1): three refusals of its own,
        // checked here -- ahead of --load-addr='s "requires" refusal just
        // below -- because a legal --reset-vector build never passes
        // --load-addr=, and that refusal would otherwise misfire on it
        // (guarded out explicitly two blocks down, not relied on to not
        // reach this far).
        if reset_vector_set != 0 {
            // arm64 resets directly into AArch64 state, not through this
            // form's real/protected/long-mode stage; riscv32 and xtensa
            // already have their own raw boot paths via --freestanding.
            // arch_set == 0 was refused above, so arch here is a real,
            // user-chosen value.
            if arch != 0 {
                uint64 rv_ar = "error: --reset-vector requires --arch=x86_64: the reset-vector form resets into 16-bit real mode and builds its own transition through 32-bit protected and 64-bit long mode; arm64 resets directly into AArch64 state, and riscv32/xtensa already have their own raw boot paths via --freestanding\n"
                write(2, rv_ar, str_len(rv_ar))
                exit(1)
            }
            // Measured meaningless (design spec S8 Q2): a plain --emit=image
            // x86_64 payload is byte-identical at --load-addr=0x100000 and
            // --load-addr=0x20000000. --reset-vector's payload always lands
            // at the fixed physical address 0x100000 -- the stage copies it
            // there itself -- so there is no address for this flag to choose.
            if load_addr_set != 0 {
                uint64 rv_la = "error: --reset-vector conflicts with --load-addr=: the reset-vector stage always copies the payload to the fixed physical address 0x100000, never to a chosen one -- measured byte-identical at --load-addr=0x100000 and --load-addr=0x20000000 for a plain --emit=image build. Drop --load-addr=\n"
                write(2, rv_la, str_len(rv_la))
                exit(1)
            }
            // No default, ever: src/main.kr's own stack_top declaration
            // states the project's rule verbatim -- "an unset stack means
            // 'no stub', never 'guess one' -- a silently defaulted stack
            // boots on the author's board and faults silently on someone
            // else's." The reset-vector stage sets rsp from this value
            // (Task 2); with the flag absent there is nothing to set it
            // from and no safe default to invent.
            if stack_top_set == 0 {
                uint64 rv_st = "error: --reset-vector requires --stack-top=: the reset-vector stage sets rsp from this value before calling the entry function, and there is no default -- an unset stack means 'no value', never 'guess one'\n"
                write(2, rv_st, str_len(rv_st))
                exit(1)
            }
        }
        // reset_vector_set == 0: a legal --reset-vector build never sets
        // --load-addr= (refused above), so without this guard the "requires
        // --load-addr=" and "--load-addr=0" refusals below would misfire on
        // every such build. See the reset-vector block just above for the
        // flag's own load-addr refusal.
        if load_addr_set == 0 && reset_vector_set == 0 {
            uint64 im_la = "error: --emit=image requires --load-addr=<addr>: nothing in a flat image records where it will run -- not even --image-header's Image header, whose text_offset is an offset from the loader's own base and never an absolute address; the value is validated (arm64) and reported, never embedded in the bytes\n"
            write(2, im_la, str_len(im_la))
            exit(1)
        }
        if load_addr == 0 && reset_vector_set == 0 {
            // Zero parses cleanly and is 4096-aligned, but every consumer
            // of the report (and B2's stub) reads 0 as "unset".
            uint64 im_z = "error: --load-addr=0 is refused: a zero load address is indistinguishable from an unset one in every report and boot stub that consumes it\n"
            write(2, im_z, str_len(im_z))
            exit(1)
        }
        if arch == 1 && (load_addr & 4095) != 0 {
            uint64 im_al = "error: --load-addr= must be 4096-aligned on arm64: ADRP page arithmetic is baked at compile time and only survives a page-aligned shift. This constraint is arm64-only -- x86_64 images are RIP-relative and boot at any address\n"
            write(2, im_al, str_len(im_al))
            exit(1)
        }
        if debug_info_mode != 0 {
            uint64 im_g = "error: -g conflicts with --emit=image: the DWARF footer and its section headers would land INSIDE the flat blob at addresses derived from the ELF layout the image does not have. Drop -g, or drop --emit=image to keep the ELF that -g understands\n"
            write(2, im_g, str_len(im_g))
            exit(1)
        }
        // --stack-top= validation (sub-project B2, D4). Only runs when the
        // flag is actually present -- unlike --load-addr=, --stack-top= has
        // no "image requires it" refusal here: the flag's ABSENCE is a
        // legal, meaningful choice (no stub is emitted and the image is a
        // blob for somebody else's loader, which is what sub-project B1
        // shipped), so "unset" must not become an error.
        if stack_top_set != 0 {
            if stack_top == 0 {
                // Zero parses cleanly and passes every alignment/range
                // check below on both arches, but is indistinguishable
                // from "unset" in every report and in both stubs that
                // consume it -- mirrors --load-addr=0's refusal just above.
                uint64 st_z = "error: --stack-top=0 is refused: a zero stack pointer faults on the first push, and is indistinguishable from unset in every report and boot stub that consumes it\n"
                write(2, st_z, str_len(st_z))
                exit(1)
            }
            // Validation is ARCH-ASYMMETRIC (spec D4) and each half is
            // stated separately in its own diagnostic -- a shared message
            // would be wrong on whichever arch it doesn't apply to.
            if arch == 1 {
                // aarch64 faults on the very first SP-relative stack access
                // if SP is not 16-byte aligned -- the same constraint
                // make_stub.py already refuses on. x86_64 has no such rule.
                if (stack_top & 15) != 0 {
                    uint64 st_al = "error: --stack-top= must be 16-byte aligned on arm64: aarch64 faults on the first SP-relative stack access if SP is not 16-byte aligned. This constraint is arm64-only -- x86_64 accepts any alignment\n"
                    write(2, st_al, str_len(st_al))
                    exit(1)
                }
                // The movz/movk pair the stub patches into the entry
                // code covers bits 31:0 only, so anything >= 2^32 cannot be
                // materialized into SP by that pair. x86_64 has its own,
                // different range rule below instead.
                if stack_top >= 4294967296 {
                    uint64 st_rg = "error: --stack-top= must be below 2^32 on arm64: the movz/movk pair the stub patches into the entry code covers bits 31:0 only. This constraint is arm64-only -- x86_64 stacks are bounded by their own range rule instead\n"
                    write(2, st_rg, str_len(st_rg))
                    exit(1)
                }
            }
            // && reset_vector_set == 0 (sub-project E, Task 1): this arm's
            // bounds are B2's self-boot trampoline's, and they part into TWO
            // KINDS under --reset-vector, not one. Review r1 caught a first
            // draft of this comment claiming all of them were B2-specific and
            // therefore simply inapplicable -- true of the page-table band
            // and the two --load-addr preconditions (--reset-vector emits
            // neither the trampoline nor a page-table region at those
            // addresses; Task 1 Step 5 excludes emit_x86_image_stub itself
            // under this flag, design spec S3(c); and --load-addr is always 0
            // here, the flag being refused rather than merely unset, so left
            // ungated the "must be at least 0x4000" row would misfire on
            // every valid --reset-vector build by reading load_addr == 0 as
            // "inside the zeroed page tables" this function never builds
            // here). FALSE of the "stack must fit inside the identity map"
            // bound: --reset-vector maps memory too (PDPT[0..3], the full
            // 4 GiB, not B2's single GiB), so that bound RE-DERIVES to a
            // DIFFERENT NUMBER rather than to nothing, and dropping it here
            // without replacing it left --stack-top with no ceiling at all
            // -- measured: 0x100000000 and even 0xFFFFFFFFFFFFFFF0 both
            // exited 0. The re-derived 4 GiB bound is the sibling block's
            // OWN check below, not merely a documented gap; the page-table
            // and --load-addr bounds have no such replacement because they
            // are the ones that are genuinely inapplicable.
            if arch == 0 && reset_vector_set == 0 {
                // x86_64 needs its own range rule -- it has no --load-addr
                // constraint beyond != 0 today, so this is new ground.
                // Bound 1: the FIRST PUSH must not land in the boot stub's
                // identity-map page tables, which live at physical
                // 0x1000-0x4000 (PDE 511 of the page directory is the last
                // eight bytes of that range, and it maps the GiB's top 2 MiB).
                //
                // THE BAND IS THE PUSH'S BAND, NOT THE POINTER'S. The stack
                // grows down, so the trampoline's `call *%rax` writes the eight
                // bytes [stack_top-8, stack_top) -- the same +8 convention the
                // stack-vs-image check at finalize uses. Testing the pointer
                // instead of the push, which is what shipped from Task 1 to
                // here, is off by eight at BOTH edges:
                //
                //   * 0x1000 was REFUSED, though its push at [0xFF8, 0x1000)
                //     lands entirely below the tables and harms nothing.
                //   * 0x4000 was ACCEPTED, though its push at [0x3FF8, 0x4000)
                //     overwrites a live PDE with a return address. Latent
                //     corruption of the map the guest is about to run under.
                //
                // [stack_top-8, stack_top) overlaps [0x1000, 0x4000) exactly
                // when stack_top > 0x1000 and stack_top < 0x4008, so those are
                // the bounds. Both are strict: 0x1000 and 0x4008 are the
                // nearest accepted values on either side.
                if stack_top > 4096 && stack_top < 16392 {
                    uint64 st_pt = "error: --stack-top='s first push would land inside 0x1000-0x4000 on x86_64: the boot stub's identity-map page tables live there, the stack grows down, and the first push writes the eight bytes below the stack top. The stack top must be at most 0x1000 or at least 0x4008. This constraint is x86_64-only -- arm64 has no page tables in the flat image\n"
                    write(2, st_pt, str_len(st_pt))
                    exit(1)
                }
                // Bound 2: must be < 2^31. At or above that boundary the
                // assembler widens `mov $imm,%rsp` from the 7-byte sign-
                // extended form to a 10-byte movabs -- moving every later
                // patch site while the file stays 226 bytes (measured).
                if stack_top >= 2147483648 {
                    uint64 st_hi = "error: --stack-top= must be below 0x80000000 on x86_64: at or above 2^31 the assembler widens `mov $imm,%rsp` from a 7-byte sign-extended form to a 10-byte movabs, moving every later patch site while the file size stays fixed. This constraint is x86_64-only -- arm64 is bounded by the movz/movk pair instead\n"
                    write(2, st_hi, str_len(st_hi))
                    exit(1)
                }
                // Bound 3 (B2 Task 4, review I3): the trampoline's identity
                // map is ONE 512-entry page directory of 2 MiB pages, so it
                // covers exactly the first 1 GiB and nothing above it is
                // addressable once paging comes on. A stack top above that
                // faults on the first push, with no handler and no IDT --
                // i.e. a triple fault, not a diagnostic.
                //
                // ORDER MATTERS: this sits AFTER bound 2 deliberately. It is
                // the stricter rule, so putting it first would make bound 2
                // unreachable and change the message a 0x80000000 stack top
                // gets. Both refuse; they refuse for different reasons and
                // each says its own.
                //
                // The bound is inclusive: rsp = 0x40000000 is legal because
                // the stack grows DOWN and the first push lands at
                // 0x3FFFFFF8, inside the map.
                if stack_top > 1073741824 {
                    uint64 st_1g = "error: --stack-top= must be at most 0x40000000 on x86_64: the self-boot trampoline's identity map is a single 512-entry page directory of 2 MiB pages, so it covers exactly the first 1 GiB; a stack above that is unmapped the moment paging is enabled and the first push triple-faults\n"
                    write(2, st_1g, str_len(st_1g))
                    exit(1)
                }
                // --load-addr's own trampoline preconditions. These are
                // gated on --stack-top being present, i.e. on the stub
                // actually being emitted: without it the image is a blob for
                // somebody else's loader (which is what sub-project B1
                // shipped and what the boot gate's x86 legs still use), and
                // refusing an address on the strength of a trampoline that
                // was never emitted would be pure over-reach.
                //
                // Measured at B2 Task 4's BASE: both of the addresses below
                // compiled clean and booted SILENT.
                if load_addr < 16384 {
                    uint64 la_pt = "error: --load-addr= must be at least 0x4000 when --stack-top= asks for the x86_64 self-boot trampoline: the trampoline builds its identity-map page tables at physical 0x1000-0x4000 and zeroes that whole range, so an image loaded there is overwritten by its own boot code before it runs\n"
                    write(2, la_pt, str_len(la_pt))
                    exit(1)
                }
                if load_addr >= 1073741824 {
                    uint64 la_1g = "error: --load-addr= must be below 0x40000000 when --stack-top= asks for the x86_64 self-boot trampoline: the trampoline's identity map is a single 512-entry page directory of 2 MiB pages and covers exactly the first 1 GiB, so an image at or above that address is unmapped the instant paging is enabled\n"
                    write(2, la_1g, str_len(la_1g))
                    exit(1)
                }
            }
            // --reset-vector's OWN x86_64 range rule (sub-project E, Task 1),
            // re-derived rather than inheriting the B2 bounds just above --
            // this geometry is different (design spec S4/S5), not a
            // relaxation of B2's: the reset-vector stage builds its OWN
            // identity page tables at physical 0x1000-0x7000 (PDPT[0..3] and
            // four page directories, mapping the full 4 GiB -- more table
            // space than B2's single PD, which is why the band is wider than
            // B2's 0x1000-0x4000), and the payload lands at a SECOND fixed
            // region, 0x100000..+PAYLEN, that B2's geometry has no equivalent
            // of at all.
            //
            // Same +8 convention as B2's page-table check and the
            // stack-vs-image check above: the stage's first push writes
            // [stack_top-8, stack_top), so that band -- not the bare pointer
            // -- is what must clear 0x1000-0x7000. It overlaps exactly when
            // stack_top > 0x1000 and stack_top < 0x7008.
            //
            // THE PAYLOAD HALF OF THIS RULE (0x100000..+PAYLEN) IS NOT HERE,
            // AND IS NOT MISSING EITHER -- it lives in the --reset-vector
            // finalize arm, in the block immediately after the 64 KiB fit
            // check. It cannot be here: PAYLEN is the copied payload's
            // length, and that is only known after codegen has produced it,
            // at finalize -- this function runs at flag-parse time, before a
            // single byte of the program has been compiled.
            //
            // THE WORDING THAT USED TO STAND HERE SAID IT WAS "Task 2's",
            // AND STAYED THERE AFTER TASK 2 SHIPPED WITHOUT IT. Task 2
            // implemented the fit half only; the overlap half existed
            // nowhere for three commits while this comment and one in the
            // finalize arm both asserted it had merely been deferred. A
            // whole-branch review caught it by BOOTING --stack-top=0x100008:
            // exit 0, a valid-looking 65536-byte image, `RPL` on the wire,
            // then a silent wedge. Both comments are corrected rather than
            // deleted, because "deferred to X" ageing into a false claim the
            // moment X ships is the shape worth leaving a marker for.
            if arch == 0 && reset_vector_set != 0 {
                if stack_top > 4096 && stack_top < 28680 {
                    uint64 rv_pt = "error: --stack-top='s first push would land inside 0x1000-0x7000 under --reset-vector: the reset-vector stage builds its own identity page tables there (PDPT[0..3] and four page directories, mapping the full 4 GiB -- more table space than the self-boot trampoline's 0x1000-0x4000), and the stack grows down so the first push writes the eight bytes below the stack top. The stack top must be at most 0x1000 or at least 0x7008. This constraint is --reset-vector-only\n"
                    write(2, rv_pt, str_len(rv_pt))
                    exit(1)
                }
                // Review r1, Important 1: excluding B2's whole range arm above
                // (the `&& reset_vector_set == 0` guard on it) also excluded
                // its Bound 3, "the stack must fit inside the identity map" --
                // and that bound is NOT B2-specific the way bounds 1 and the
                // --load-addr pair are. It re-derives here to a DIFFERENT
                // NUMBER, not to nothing: the reset-vector stage's map is
                // PDPT[0..3], the full 4 GiB, where B2's is a single GiB.
                // Left unchecked, --stack-top=0x100000000 (4 GiB) and even
                // --stack-top=0xFFFFFFFFFFFFFFF0 both exited 0 -- no ceiling
                // at all, not merely the wrong one.
                //
                // `>=`, NOT B2's `>`: B2 accepts rsp == its map size exactly,
                // because Task-2-verified math places the first push entirely
                // inside the map at that value. The reset-vector stage that
                // math is ABOUT has not been built yet -- Task 1 emits no
                // stage bytes -- so asserting the identical inclusive edge
                // here would be a claim about geometry nobody has measured.
                // Refusing AT the boundary too is the conservative bound this
                // task can actually stand behind; Task 2, once the stage
                // existed to measure against, could have loosened it to `>`
                // if the math worked out the same way B2's does.
                //
                // TASK 2 LANDED AND THE BOUND WAS NOT LOOSENED, DELIBERATELY.
                // The emitted stage does map exactly PDPT[0..3] x 4 GiB, so
                // 0x100000000's first push at 0xFFFFFFF8 is provably inside
                // it and `>` would be sound. It stays `>=` because a stack
                // top of exactly 4 GiB has no use that 0xFFFFFFF8 does not
                // serve, and because the boot gate has never booted one.
                // The message no longer says "pending Task 2" -- Task 2 is
                // done, and a user-facing string may not carry a forward
                // reference to work that has already shipped (E, Task 4).
                if stack_top >= 4294967296 {
                    uint64 rv_4g = "error: --stack-top= must be below 0x100000000 (4 GiB) under --reset-vector: the reset-vector stage's identity map is PDPT[0..3], four page directories covering the full 4 GiB, so a stack top above that is unmapped the moment paging is enabled and the first push triple-faults. A stack top of exactly 0x100000000 is refused CONSERVATIVELY rather than because it faults -- its first push lands at 0xFFFFFFF8, inside the map. This constraint is --reset-vector-only -- the self-boot trampoline's own ceiling is a different number, 0x40000000, for its narrower single-GiB map\n"
                    write(2, rv_4g, str_len(rv_4g))
                    exit(1)
                }
            }
        }
        // --image-header (sub-project C). Requires --arch=arm64 (the
        // header being prefixed IS arm64's Linux Image format; x86_64
        // --emit=image already gets its own header -- the multiboot one
        // --stack-top= adds above -- so --image-header on x86_64 has
        // nothing of its own to attach) and --stack-top= (a header on a
        // stub-less image validates under file(1) and is accepted by a
        // loader, but the image has no entry stub to jump to and faults
        // instantly, which would make the header a false claim about the
        // bytes it precedes). Checked after the arch==2/arch==3 refusals
        // above, so arch here is only ever 0 (x86_64) or 1 (arm64).
        if image_header_set != 0 {
            if arch == 0 {
                uint64 ih_a64 = "error: --image-header requires --arch=arm64: the header is arm64's Linux Image format (magic 0x644d5241); x86_64 --emit=image already has its own front-of-file forms (the multiboot header --stack-top= adds, and the stage --reset-vector adds), so --image-header on x86_64 has nothing to attach to\n"
                write(2, ih_a64, str_len(ih_a64))
                exit(1)
            }
            if stack_top_set == 0 {
                uint64 ih_st = "error: --image-header requires --stack-top=: a header on a stub-less image validates under file(1) and is accepted by a loader, but the image has no entry stub to jump to and faults instantly. Pass --stack-top= so the header's claim matches the bytes\n"
                write(2, ih_st, str_len(ih_st))
                exit(1)
            }
        }
    }
    // --emit=uefi (emit_mode 9): sub-project D's UEFI-application surface.
    // Deliberately a SEPARATE block from mode 8's above rather than a widened
    // `emit_mode == 8 || emit_mode == 9` on each row: the two modes agree on
    // three rules and disagree on the rest (mode 9 takes no --load-addr, no
    // --stack-top and no --image-header, and its arch refusals are about a PE
    // Machine value rather than about a raw path each arch already owns), so
    // a shared block would need a per-mode message on nearly every line.
    //
    // EVERY ROW HERE IS A DEFAULT A NEW EMIT MODE INHERITS, not a rule
    // invented for this format. There is no arch_set == 0 refusal, no
    // target_os refusal and no -g refusal anywhere that a mode gets for free;
    // each of the three below was measured silently absent before it was
    // written.
    if emit_mode == 9 {
        // THE else-POSIX DOOR, arriving through the --emit= entrance. The
        // auto-set block above keys on emit_mode 1/2/4 only, so mode 9 leaves
        // target_os at its 0 = linux default and every "special-case Windows/
        // macOS, ELSE fall through to POSIX" dispatch in the tree answers
        // "Linux" for it. CONSTRUCTED, NOT ASSUMED: with this one check
        // disabled in a scratch build, `--arch=x86_64 --emit=uefi` (no
        // --target= on the line) on a program calling print() compiled CLEAN
        // -- exit 0, a 4312-byte artifact, and four x86_64 `syscall`
        // instructions in its payload. Firmware provides no syscalls at all,
        // so that artifact faults on its first write with nothing to report it.
        if target_os != 4 {
            uint64 uf_tn = "error: --emit=uefi requires --target=none: without it the resolved target OS is a hosted one (the default is linux) and the application would carry that OS's syscalls, which UEFI firmware does not provide\n"
            write(2, uf_tn, str_len(uf_tn))
            exit(1)
        }
        // No --arch at all: refuse. --emit= sets emit_set, which skips the fat
        // path AND its "pass --arch" refusal, so the arch would silently
        // default to x86_64 -- and a PE carries the CPU in its Machine field,
        // so a defaulted arch is a header that names a processor nobody asked
        // for, on an artifact whose whole purpose is to be handed to firmware.
        if arch_set == 0 {
            uint64 uf_ar = "error: --emit=uefi requires an explicit --arch=x86_64 or --arch=arm64: a PE header names the CPU in its Machine field, so a silently defaulted arch would produce an application declaring a processor you did not ask for\n"
            write(2, uf_ar, str_len(uf_ar))
            exit(1)
        }
        // riscv32 / xtensa. Each message carries a substring UNIQUE to it --
        // "x86_64/arm64 only" would appear in both, and a defect that routed
        // xtensa to the riscv32 arm would then pass a test grepping the shared
        // half (the trap the --emit=image rows already document).
        if arch == 2 {
            uint64 uf_rv = "error: --emit=uefi is x86_64/arm64 only: there is no PE Machine value for riscv32 in this compiler, and no UEFI firmware target for it here either. Use --arch=riscv32 --freestanding for a raw boot image instead\n"
            write(2, uf_rv, str_len(uf_rv))
            exit(1)
        }
        if arch == 3 {
            uint64 uf_xt = "error: --emit=uefi is x86_64/arm64 only: there is no PE Machine value for xtensa, and the chip has no UEFI firmware. Use --arch=xtensa --freestanding (lx60 boot ELF) or --target=esp32 (esp-image) instead\n"
            write(2, uf_xt, str_len(uf_xt))
            exit(1)
        }
        // -g. Its existing refusal is nested inside `if emit_mode == 8`, so a
        // new mode inherits ACCEPTANCE -- and acceptance here is invisible:
        // measured at BASE, `--emit=pe -g` produces a file BYTE-IDENTICAL to
        // `--emit=pe` (2048 bytes both), i.e. the flag is silently discarded
        // rather than doing something wrong. Refused rather than discarded,
        // for the same reason mode 8 refuses it: the DWARF footer and its
        // section headers are laid out from an ELF geometry this container
        // does not have.
        if debug_info_mode != 0 {
            uint64 uf_g = "error: -g conflicts with --emit=uefi: the DWARF footer and its section headers are laid out from the ELF geometry a PE32+ EFI application does not have, and would land inside the image at addresses nothing maps. Drop -g, or drop --emit=uefi to keep the ELF that -g understands\n"
            write(2, uf_g, str_len(uf_g))
            exit(1)
        }
    }
    // --emit=arx. Its own block for the same reason mode 9 has one: EVERY ROW
    // HERE IS A DEFAULT A NEW MODE INHERITS, never a rule invented for this
    // format. What it does NOT need is a --stack-top=/--load-addr=/
    // --image-header/--reset-vector refusal -- the generic rows below already
    // refuse all four for every emit_mode != 8, and duplicating them here would
    // change which message fires rather than adding protection.
    if emit_mode == 10 {
        // Same else-POSIX door mode 9 documents: the auto-set block keys on
        // emit_mode 1/2/4, so mode 10 would leave target_os at its linux
        // default and the payload would carry Linux syscalls. ApexRift provides
        // none -- it is the OS -- so such an artifact faults on its first call
        // with nothing to report it.
        if target_os != 4 {
            uint64 ax_tn = "error: --emit=arx requires --target=none: without it the resolved target OS is a hosted one (the default is linux) and the program would carry that OS's syscalls, which ApexRift does not provide -- it is the OS the container is loaded by\n"
            write(2, ax_tn, str_len(ax_tn))
            exit(1)
        }
        // No --arch: refuse rather than default. The ARX header names the CPU
        // in its own arch field, and the loader refuses a mismatch, so a
        // silently defaulted arch produces a container that is rejected at load
        // time for a choice the user never made.
        if arch_set == 0 {
            uint64 ax_ar = "error: --emit=arx requires an explicit --arch=x86_64 or --arch=arm64: the ARX header records the CPU and the loader refuses a container built for another one, so a silently defaulted arch yields a program rejected at load time for a choice you did not make\n"
            write(2, ax_ar, str_len(ax_ar))
            exit(1)
        }
        // arm64 IS ENABLED. The row that used to refuse it said what would lift
        // it -- "the page-congruence invariant ... would ship with static byte
        // assertions and NO RUNTIME WITNESS ... Enabling it later is deleting
        // this row plus that witness" -- and the witness now exists:
        // ApexRift's arm64_witness.kr, run by its test-arm64.sh under
        // qemu-system-aarch64 -M virt.
        //
        // What it observes, rather than asserts: an ARX container with arch = 2
        // is loaded by the real arx_load_image(), placed at a 4096-aligned base
        // the arena picked at run time, and entered. Its payload does not return
        // a constant -- it reads the answer out of a global through an ADRP+ADD
        // pair, so a base that is not page-congruent gives the wrong answer.
        // Measured both ways: with the loader's round-up the payload returns
        // 0x5EED; with the round-up deleted it returns 0, silently and without
        // faulting, which is precisely the failure mode this was worried about.
        //
        // The loader also refuses arch = 2 with align < 4096 (ApexRift error
        // 176) so a container that could not survive placement cannot be built
        // into one that is accepted.
        //
        // riscv32 / xtensa. Unique substrings per message, as the rows above
        // document: a shared "x86_64 only" half would let a defect that routed
        // one arch to the other's arm still pass a grep.
        if arch == 2 {
            uint64 ax_rv = "error: --emit=arx has no riscv32 form: ApexRift runs on x86_64 and there is no riscv32 loader for this container. Use --arch=riscv32 --freestanding for a raw boot image instead\n"
            write(2, ax_rv, str_len(ax_rv))
            exit(1)
        }
        if arch == 3 {
            uint64 ax_xt = "error: --emit=arx has no xtensa form: ApexRift runs on x86_64 and the chip has no loader for this container. Use --arch=xtensa --freestanding or --target=esp32 instead\n"
            write(2, ax_xt, str_len(ax_xt))
            exit(1)
        }
        // -g, refused rather than silently discarded, for the reason mode 8 and
        // mode 9 both refuse it: the DWARF footer is laid out from an ELF
        // geometry this container does not have.
        if debug_info_mode != 0 {
            uint64 ax_g = "error: -g conflicts with --emit=arx: the DWARF footer and its section headers are laid out from an ELF geometry this container does not have, and would land inside the loaded image at offsets nothing maps. Drop -g, or drop --emit=arx to keep the ELF that -g understands\n"
            write(2, ax_g, str_len(ax_g))
            exit(1)
        }
    }
    // --emit=fatimage (emit_mode 11). Its own block, for the reason modes 9
    // and 10 have one: EVERY ROW HERE IS A DEFAULT A NEW EMIT MODE INHERITS,
    // never a rule invented for this format. The target_os, arch and -g rows
    // are the three every previous mode had to write for itself after
    // measuring their absence, and this mode would inherit ACCEPTANCE of all
    // three.
    //
    // FIRST ROW FIRST: the target_os check must precede everything, because the
    // t6 --emit= enumeration in the suite runs every spelling with
    // `--arch=arm64 --debug` and asserts the refusal does not name --debug. The
    // --target=none block above refuses --debug, so if this mode's own
    // --target=none row did not fire first, a --debug refusal would be the
    // message a user got for a missing --target=.
    if emit_mode == 11 {
        // The else-POSIX door, arriving through --emit=. The auto-set block
        // above keys on emit_mode 1/2/4, so mode 11 leaves target_os at its
        // linux default and every "special-case Windows/macOS, ELSE fall
        // through to POSIX" dispatch in the tree answers "Linux" for it -- and
        // every slice in the image would then carry Linux syscalls with no
        // kernel behind them. Same door --emit=uefi measured 4312 bytes and
        // four `syscall` instructions coming through.
        if target_os != 4 {
            uint64 fi_tn = "error: --emit=fatimage requires --target=none: without it the resolved target OS is a hosted one (the default is linux) and every slice in the image would carry that OS's syscalls -- there is no kernel behind any of the boot paths a fat image has, because a fat image IS what boots\n"
            write(2, fi_tn, str_len(fi_tn))
            exit(1)
        }
        // A fat image with one architecture is not a fat image. Refused rather
        // than quietly built, because the artifact would be a perfectly valid
        // single-arch image wearing a name that promises more -- and the whole
        // point of the mode is that the same file boots on more than one
        // machine.
        if fat_arch_list_set == 0 {
            uint64 fi_al = "error: --emit=fatimage requires a comma-separated --arch= list: write --arch=x86_64,arm64. A fat image is ONE FILE WITH SEVERAL BOOT PATHS, so it has no single architecture to default to, and a single --arch= would produce an ordinary image under a name that promises more than one machine can boot it\n"
            write(2, fi_al, str_len(fi_al))
            exit(1)
        }
        // EXACTLY x86_64 AND arm64, and this is an allow-list with no
        // fall-through for the reason arch_os_pair_supported is one. The
        // container has precisely two entry indirections -- the multiboot scan
        // and the Image header's branch -- and both have been booted. A rule
        // phrased as "at least two of the four architectures" would admit a
        // pair this compiler has never composed and cannot enter.
        if fat_arch_mask != 3 {
            uint64 fi_ab = "error: --emit=fatimage composes exactly x86_64 and arm64: --arch=x86_64,arm64 (in either order). This container has two entry indirections and no more -- the x86_64 multiboot header, which a loader finds by scanning the first 8 KiB, and the arm64 Image header at offset 0, whose first word is a branch. A one-architecture list is an ordinary --emit=image build; there is no third boot path to add an architecture to\n"
            write(2, fi_ab, str_len(fi_ab))
            exit(1)
        }
        // -g, refused rather than silently discarded, for the reason modes 8,
        // 9 and 10 all refuse it: the DWARF footer and its section headers are
        // laid out from an ELF geometry none of the slices have. Worse here
        // than in any single-image mode -- the footer would land inside a
        // composite, at offsets belonging to whichever slice happened to
        // follow.
        if debug_info_mode != 0 {
            uint64 fi_g = "error: -g conflicts with --emit=fatimage: the DWARF footer and its section headers are laid out from the ELF geometry none of a fat image's slices have, and would land inside the composite at offsets belonging to whichever slice follows. Drop -g, or drop --emit=fatimage to keep the ELF that -g understands\n"
            write(2, fi_g, str_len(fi_g))
            exit(1)
        }
        // The four single-image front-of-file flags, each refused with a
        // message about THIS mode. Ahead of the generic "only meaningful with
        // --emit=image" rows below, which would otherwise fire and tell a
        // fatimage user to use a mode they deliberately did not ask for.
        if load_addr_set != 0 {
            uint64 fi_la = "error: --load-addr= is ambiguous under --emit=fatimage: the image has one load address per slice, and they are different addresses on different machines. Use the per-architecture form -- --load-addr=x86_64:0x400000 or --load-addr=arm64:0x40000000 -- which sets where the WHOLE FILE lands for that architecture; each slice's own address is that base plus its offset in the file, which only the composer knows\n"
            write(2, fi_la, str_len(fi_la))
            exit(1)
        }
        if stack_top_set != 0 {
            uint64 fi_st = "error: --stack-top= is ambiguous under --emit=fatimage: each slice emits its own entry stub and sets its own SP, in a different machine's memory map. Use the per-architecture form -- --stack-top=x86_64:0x3f0000 or --stack-top=arm64:0x40800000\n"
            write(2, fi_st, str_len(fi_st))
            exit(1)
        }
        if image_header_set != 0 {
            uint64 fi_ih = "error: --image-header is redundant under --emit=fatimage and is refused rather than ignored: the fat image ALWAYS writes an arm64 Image header, at file offset 0, sharing those 64 bytes with the PE DOS stub -- that shared header is the arm64 boot path. Accepting the flag would suggest there is a form of this mode without one\n"
            write(2, fi_ih, str_len(fi_ih))
            exit(1)
        }
        if reset_vector_set != 0 {
            uint64 fi_rv = "error: --reset-vector conflicts with --emit=fatimage: the reset-vector form owns file offset 0 exactly -- `-bios` maps the file's last byte at 0xFFFFFFFF and every self-reference in its stage assumes that -- and offset 0 of a fat image is already the arm64 Image header shared with the PE DOS stub. Two file-offset-0 constructs cannot share a file. Build the reset-vector image on its own with --emit=image\n"
            write(2, fi_rv, str_len(fi_rv))
            exit(1)
        }
        // A PE HAS TO BE COMPILED, so it cannot come from a --slice=. A raw
        // image handed over on the command line has no COFF header, no section
        // table and no Machine value, and there is no honest way to wrap one
        // after the fact -- the PE's own offsets are what the fat layout is
        // built on top of.
        if fat_uefi_set != 0 && fat_uefi_arch == 0 && fat_slice_x86 != 0 {
            uint64 fu_sx = "error: --fat-uefi=x86_64 conflicts with --slice=x86_64:: the UEFI boot path is a PE32+ application the compiler builds from the source on the command line, and a --slice= file is a finished raw image with no COFF header to give it. Drop --slice=x86_64: so x86_64 is compiled here, or pass --fat-uefi=arm64 or --fat-uefi=none\n"
            write(2, fu_sx, str_len(fu_sx))
            exit(1)
        }
        if fat_uefi_set != 0 && fat_uefi_arch == 1 && fat_slice_a64 != 0 {
            uint64 fu_sa = "error: --fat-uefi=arm64 conflicts with --slice=arm64:: the UEFI boot path is a PE32+ application the compiler builds from the source on the command line, and a --slice= file is a finished raw image with no COFF header to give it. Drop --slice=arm64: so arm64 is compiled here, or pass --fat-uefi=x86_64 or --fat-uefi=none\n"
            write(2, fu_sa, str_len(fu_sa))
            exit(1)
        }
        // THE DEFAULT, DERIVED AND THEN PRINTED. x86_64 first because that is
        // where UEFI firmware is actually met in practice and because the
        // reference composition this mode reproduces is PE-for-x86_64. If that
        // architecture came from --slice= there is nothing to compile into a
        // PE, so arm64 is tried, and if both were supplied the image simply has
        // no UEFI path. That last case is a real configuration (both halves
        // prebuilt) rather than an error, so it resolves to `none` -- and the
        // report line says `uefi: none` out loud, because a boot path silently
        // not being there is exactly the kind of absence a user discovers from
        // firmware instead of from the build.
        if fat_uefi_set == 0 {
            if fat_slice_x86 == 0 {
                fat_uefi_arch = 0
            } else if fat_slice_a64 == 0 {
                fat_uefi_arch = 1
            } else {
                fat_uefi_arch = 254
            }
        }
        // Per-slice address validation. These are the --emit=image rules,
        // re-applied here because they live in THIS function for mode 8 and the
        // composer's internal compile() calls enter below it -- they would
        // simply not run. The two that DO run for the internal passes are the
        // ones inside compile()'s finalize (the 1 GiB image fit and
        // stack-vs-image), because those need the emitted size.
        //
        // The load bases get their range checked in the composer instead, on
        // base + offset: the offset is what the flag validation cannot see.
        if fat_load_x86 == 0 {
            uint64 fl_z = "error: --load-addr=x86_64:0 is refused: a zero load address is indistinguishable from an unset one in every report and boot stub that consumes it\n"
            write(2, fl_z, str_len(fl_z))
            exit(1)
        }
        if fat_load_a64 == 0 {
            uint64 fa_z = "error: --load-addr=arm64:0 is refused: a zero load address is indistinguishable from an unset one in every report and boot stub that consumes it\n"
            write(2, fa_z, str_len(fa_z))
            exit(1)
        }
        if (fat_load_a64 & 4095) != 0 {
            uint64 fa_al = "error: --load-addr=arm64: must be 4096-aligned: ADRP page arithmetic is baked at compile time and only survives a page-aligned shift. Every slice offset inside a fat image is already 4096-aligned, so the base has to be too. This constraint is arm64-only -- the x86_64 slice is RIP-relative and boots at any address\n"
            write(2, fa_al, str_len(fa_al))
            exit(1)
        }
        if fat_stack_x86 == 0 || fat_stack_a64 == 0 {
            uint64 fs_z = "error: a fat image's --stack-top=<arch>:0 is refused: a zero stack pointer faults on the first push, and is indistinguishable from unset in every report and boot stub that consumes it\n"
            write(2, fs_z, str_len(fs_z))
            exit(1)
        }
        if (fat_stack_a64 & 15) != 0 {
            uint64 fs_al = "error: --stack-top=arm64: must be 16-byte aligned: aarch64 faults on the first SP-relative stack access if SP is not 16-byte aligned. This constraint is arm64-only -- the x86_64 slice accepts any alignment\n"
            write(2, fs_al, str_len(fs_al))
            exit(1)
        }
        if fat_stack_a64 >= 4294967296 {
            uint64 fs_rg = "error: --stack-top=arm64: must be below 2^32: the movz/movk pair the arm64 entry stub patches into the entry code covers bits 31:0 only. This constraint is arm64-only -- the x86_64 slice is bounded by its trampoline's identity map instead\n"
            write(2, fs_rg, str_len(fs_rg))
            exit(1)
        }
        if fat_stack_x86 > 4096 && fat_stack_x86 < 16392 {
            uint64 fs_pt = "error: --stack-top=x86_64:'s first push would land inside 0x1000-0x4000: the multiboot slice's trampoline builds its identity-map page tables there, the stack grows down, and the first push writes the eight bytes below the stack top. The stack top must be at most 0x1000 or at least 0x4008. This constraint is x86_64-only -- the arm64 slice's stub has no page tables\n"
            write(2, fs_pt, str_len(fs_pt))
            exit(1)
        }
        if fat_stack_x86 >= 2147483648 {
            uint64 fs_hi = "error: --stack-top=x86_64: must be below 0x80000000: at or above 2^31 the assembler widens `mov $imm,%rsp` from a 7-byte sign-extended form to a 10-byte movabs, moving every later patch site while the file size stays fixed. This constraint is x86_64-only -- the arm64 slice is bounded by its movz/movk pair instead\n"
            write(2, fs_hi, str_len(fs_hi))
            exit(1)
        }
        if fat_stack_x86 > 1073741824 {
            uint64 fs_1g = "error: --stack-top=x86_64: must be at most 0x40000000: the multiboot slice's trampoline maps a single 512-entry page directory of 2 MiB pages, exactly the first 1 GiB, and a stack above that is unmapped the moment paging is enabled -- the first push triple-faults\n"
            write(2, fs_1g, str_len(fs_1g))
            exit(1)
        }
    }
    // Checked BEFORE --stack-top='s own "only meaningful" row just below:
    // every --reset-vector test row also carries --stack-top=, so ordering
    // this one first is what makes reset_vector_requires_emit_image (not
    // stacktop_requires_image's shared substring) the row that actually
    // proves this flag's own gate fired.
    if reset_vector_set != 0 && emit_mode != 8 {
        uint64 rv_im = "error: --reset-vector is only meaningful with --emit=image: it selects the reset-vector form of the flat image, and only --emit=image produces a flat image for it to select\n"
        write(2, rv_im, str_len(rv_im))
        exit(1)
    }
    if load_addr_set != 0 && emit_mode != 8 {
        uint64 la_im = "error: --load-addr= is only meaningful with --emit=image: hosted containers carry their load address in their own headers\n"
        write(2, la_im, str_len(la_im))
        exit(1)
    }
    if stack_top_set != 0 && emit_mode != 8 {
        uint64 st_im = "error: --stack-top= is only meaningful with --emit=image: hosted containers manage the stack pointer through their own loader, not a flag\n"
        write(2, st_im, str_len(st_im))
        exit(1)
    }
    if image_header_set != 0 && emit_mode != 8 {
        uint64 ih_im = "error: --image-header is only meaningful with --emit=image: it prefixes a flat image with an arm64 boot header, and only --emit=image produces a flat image to prefix\n"
        write(2, ih_im, str_len(ih_im))
        exit(1)
    }

    // arch x OS validation. This runs AFTER the emit_mode -> target_os
    // auto-set above, on the RESOLVED pair, so `--arch=riscv32 --emit=pe`
    // (which asks for Windows without ever typing --target=) is caught by the
    // same check as `--arch=riscv32 --target=windows`. Names both flags with
    // the spellings a user types, so the message can be edited back into a
    // working command line.
    if arch_os_pair_supported(arch, target_os) == 0 {
        uint64 xo_a = arch_flag_name(arch)
        uint64 xo_o = target_os_flag_name(target_os)
        uint64 xo1 = "error: --arch="
        write(2, xo1, str_len(xo1))
        write(2, xo_a, str_len(xo_a))
        uint64 xo2 = " --target="
        write(2, xo2, str_len(xo2))
        write(2, xo_o, str_len(xo_o))
        uint64 xo3 = " is not a supported target pair: x86_64 and arm64 build for linux, macos, windows, android or none; riscv32 and xtensa build for linux or none. (--emit=macho and --emit=pe select macos and windows even when --target= is absent.)\n"
        write(2, xo3, str_len(xo3))
        exit(1)
    }

    // --target=esp32 is only meaningful on the xtensa freestanding ELF path
    // (arch 3, emit_mode 0). Any other combination is a hard error — loud-fail
    // over silently emitting a qemu-lx60-shaped image that cannot boot on the
    // chip: loud-fail rather than silently emit the wrong thing.
    if machine_target == 1 {
        if arch != 3 || freestanding == 0 || emit_mode != 0 {
            uint64 esp_tgt_msg = "error: --target=esp32 requires --arch=xtensa --freestanding\n"
            write(2, esp_tgt_msg, str_len(esp_tgt_msg))
            exit(1)
        }
        // ESP32 initial SP: top of the DRAM window, 16-byte aligned,
        // instead of the qemu-lx60 stack top. Assigned BEFORE codegen so the
        // entry preamble's pre-scan interns the right pool literal.
        XT_STACK_TOP = XT_ESP32_STACK_TOP
        // Gate the entry-stub additions (Task 4: WDT disable + PS pin + park
        // self-branch) in ir_xtensa.kr — it precedes main.kr in the concat
        // build so it cannot read machine_target itself.
        xt_esp32_target = 1
    }

    // Derive output name from input if not specified with -o
    if str_eq_full(output_path, "a.krbo") != 0 && input_path != 0 {
        uint64 ilen = str_len(input_path)
        // Strip .kr extension if present, then add appropriate extension
        uint64 base_len = ilen
        if ilen > 3 {
            uint64 dp = input_path + ilen - 3
            uint64 d0 = 0; uint64 d1 = 0; uint64 d2 = 0
            unsafe { *(dp as uint8) -> d0 }
            uint64 dp1 = dp + 1; unsafe { *(dp1 as uint8) -> d1 }
            uint64 dp2 = dp + 2; unsafe { *(dp2 as uint8) -> d2 }
            if d0 == 46 && d1 == 107 && d2 == 114 { base_len = ilen - 3 }
        }
        if emit_mode == 3 {
            // Object file: input.kr → input.o
            uint64 out = alloc(base_len + 3)
            memcpy(out, input_path, base_len)
            uint64 ep = out + base_len
            uint8 e0 = 46; uint8 e1 = 111
            unsafe { *(ep as uint8) = e0 }
            uint64 ep1 = ep + 1; unsafe { *(ep1 as uint8) = e1 }
            uint64 ep2 = ep + 2; uint8 z = 0
            unsafe { *(ep2 as uint8) = z }
            output_path = out
        } else if emit_mode == 2 {
            // PE: input.kr → input.exe
            uint64 out = alloc(base_len + 5)
            memcpy(out, input_path, base_len)
            uint64 ep = out + base_len
            uint8 e0 = 46; uint8 e1 = 101; uint8 e2 = 120; uint8 e3 = 101
            unsafe { *(ep as uint8) = e0 }
            uint64 ep1 = ep + 1; unsafe { *(ep1 as uint8) = e1 }
            uint64 ep2 = ep + 2; unsafe { *(ep2 as uint8) = e2 }
            uint64 ep3 = ep + 3; unsafe { *(ep3 as uint8) = e3 }
            uint64 ep4 = ep + 4; uint8 z = 0
            unsafe { *(ep4 as uint8) = z }
            output_path = out
        } else if arch_set != 0 || emit_set != 0 {
            // Single arch: input.kr → input (no extension, native binary)
            uint64 out = alloc(base_len + 1)
            memcpy(out, input_path, base_len)
            uint64 tp = out + base_len
            uint8 z = 0
            unsafe { *(tp as uint8) = z }
            output_path = out
        } else {
            // Fat binary: input.kr → input.krbo
            uint64 out = alloc(base_len + 6)
            memcpy(out, input_path, base_len)
            uint64 ep = out + base_len
            uint8 e0 = 46; uint8 e1 = 107; uint8 e2 = 114; uint8 e3 = 98; uint8 e4 = 111
            unsafe { *(ep as uint8) = e0 }
            uint64 ep1 = ep + 1; unsafe { *(ep1 as uint8) = e1 }
            uint64 ep2 = ep + 2; unsafe { *(ep2 as uint8) = e2 }
            uint64 ep3 = ep + 3; unsafe { *(ep3 as uint8) = e3 }
            uint64 ep4 = ep + 4; unsafe { *(ep4 as uint8) = e4 }
            uint64 ep5 = ep + 5; uint8 z = 0
            unsafe { *(ep5 as uint8) = z }
            output_path = out
        }
    }

    // --list-proposals doesn't need an input file
    if lc_list_proposals != 0 && input_path == 0 {
        init_proposals()
        load_proposal_overrides()
        list_proposals()
        exit(0)
    }

    // --promote / --deprecate / --reject: governance commands, no input file
    if lc_promote_name != 0 && input_path == 0 {
        init_proposals()
        load_proposal_overrides()
        promote_proposal(lc_promote_name)
        exit(0)
    }
    if lc_deprecate_name != 0 && input_path == 0 {
        init_proposals()
        load_proposal_overrides()
        deprecate_proposal(lc_deprecate_name)
        exit(0)
    }
    if lc_reject_name != 0 && input_path == 0 {
        init_proposals()
        load_proposal_overrides()
        reject_proposal(lc_reject_name)
        exit(0)
    }

    if input_path == 0 {
        if cli_argc > 0 {
            write(2, "krc: no input file\n\n", 20)
            write(2, "usage: krc [options] <file.kr> [-o output]\n", 43)
            write(2, "run 'krc --help' for the full list of options and commands.\n", 60)
            exit(0)
        }
        input_path = "test_input.kr"
    }

    if mode == 1 {
        import_init()
    import_check_file(input_path)
        import_process(input_path)
        uint64 source = import_buf
        uint64 size = import_buf_len
        uint64 max_tok = 524288
        uint64 my_tokens = alloc(max_tok * 16)
        lexer_init(source, size, my_tokens, max_tok)
        uint64 tcount = lexer_run()
        ast_init(524288)
        codegen_init(1048576, source, my_tokens)
        parser_init(my_tokens, tcount)
        uint64 root = parse_module()
        // run_analysis runs the annotation/effect/lock passes. These are
        // currently inert: annotations are not parsed yet, so ann_register
        // and lock_add_edge have no callers and the tables stay empty (M13).
        // The genuinely-working checks — missing return, arg count, unused/
        // unreachable code, undeclared identifiers — live in
        // run_semantic_checks, the same pass a normal compile runs. Without
        // it, `krc check` reported "OK" for every file. Run both and report
        // the detailed diagnostics.
        uint64 errors = run_analysis(root)
        uint64 sema_errs = run_semantic_checks(root, source, my_tokens)
        // Mirror the compile path: resolve inferred `let` types, then run the
        // (now-fatal) type checker, so `krc check` — and the VS Code LSP that
        // shells out to it — surface the same struct-field / return-type /
        // call-arg type errors a real build would, not just the sema checks.
        resolve_inferred_types(root)
        uint64 pre_tc = diag_error_count
        if check_types_enabled != 0 {
            tc_check_module(root)
        }
        uint64 tc_errs = diag_error_count - pre_tc
        diag_report_all()
        errors = errors + sema_errs + tc_errs
        if errors > 0 {
            uint8[32] nb
            write(2, "\nkrc: ", 6)
            uint64 nl = fmt_uint(nb, errors)
            write(2, nb, nl)
            write(2, " error(s) found in ", 19)
            write(2, input_path, str_len(input_path))
            write(2, "\n", 1)
            exit(1)
        }
        write(1, "krc check: ", 11)
        write(1, input_path, str_len(input_path))
        write(1, " - OK\n", 6)
        exit(0)
    }

    if mode == 2 {
        // --list-proposals: print the governance-layer proposal registry
        if lc_list_proposals != 0 {
            init_proposals()
            load_proposal_overrides()
            list_proposals()
            exit(0)
        }
        // `krc lc undo <file>` -- put back what the last --fix overwrote.
        if lc_undo_mode != 0 {
            run_lc_undo(input_path)
            exit(0)
        }
        // --fix mode: run the migration engine on the input file
        if lc_fix_mode != 0 {
            run_migration(input_path, lc_dry_run)
            exit(0)
        }
        import_init()
    import_check_file(input_path)
        import_process(input_path)
        uint64 source = import_buf
        uint64 size = import_buf_len
        uint64 max_tok = 524288
        uint64 my_tokens = alloc(max_tok * 16)
        lexer_init(source, size, my_tokens, max_tok)
        uint64 tcount = lexer_run()
        ast_init(524288)
        codegen_init(1048576, source, my_tokens)
        parser_init(my_tokens, tcount)
        uint64 root = parse_module()
        // Run analysis first to populate lock graph
        analysis_init()
        uint64 tel = collect_telemetry(root)
        uint64 patterns = detect_patterns(root, tel)
        uint64 cycles = check_lock_cycles()
        uint64 fitness = compute_fitness(tel, patterns, cycles)
        init_proposals()
        load_proposal_overrides()
        detect_proposals(tel)
        if lc_min_fitness > 0 {
            print_living_report_filtered(tel, patterns, fitness, lc_min_fitness)
        } else {
            print_living_report(tel, patterns, fitness)
        }
        print_firing_proposals()
        if lc_ci_mode != 0 {
            uint64 gate_threshold = lc_min_fitness
            if gate_threshold == 0 { gate_threshold = 50 }
            if lc_check_ci_gate(gate_threshold) != 0 {
                exit(1)
            }
        }
        exit(0)
    }

    if mode == 3 {
        fmt_file(input_path)
        exit(0)
    }

    // Default: produce fat binary unless --arch or --emit specified.
    // On Windows / macOS: default to the host's native format so that
    // `krc hello.kr` just works without flags. The user can still
    // explicitly request a fat binary with `krc hello.kr -o hello.krbo`
    // via --emit=... if they want cross-platform output.
    // --targets=<list> always forces fat-binary emission (custom slice set).
    // Fat binaries carry only x86_64/arm64 slices — combining --targets
    // with --arch=riscv32 would silently drop the requested arch, so
    // refuse instead of misrouting into compile_fat.
    if arch == 2 && target_mask != 0 {
        uint64 tmsg = "error: fat binaries (--targets) have no riscv32 slice; use --arch=riscv32 without --targets\n"
        write(2, tmsg, str_len(tmsg))
        exit(1)
    }
    if arch == 3 && target_mask != 0 {
        uint64 xtmsg = "error: fat binaries (--targets) have no xtensa slice; use --arch=xtensa without --targets\n"
        write(2, xtmsg, str_len(xtmsg))
        exit(1)
    }
    if target_mask != 0 || (arch_set == 0 && emit_set == 0 && cli_argc > 0) {
        // --target=none must never reach compile_fat, from ANY entrance
        // (no --arch given at all, or an explicit --targets=<list> that
        // does not happen to spell "none" as one of its elements — the
        // :3495 refusal above only catches the latter spelling). Checked
        // here, at the single point that actually decides fat-vs-single,
        // rather than per-entrance: freestanding is a static global, and
        // compile_fat compiles all 8 hosted slices in one process without
        // resetting it between them, so a bare-metal build's freestanding=1
        // would strip startup/exit from every hosted slice — a fat binary
        // that builds cleanly (exit 0, no diagnostic) and crashes at
        // runtime on every architecture.
        if target_os == 4 {
            uint64 tnf_msg = "error: --target=none cannot build a fat binary: pass --arch=<arch> for a single bare-metal binary (a fat binary bundles 8 hosted OS slices and there is no OS here to run any of them)\n"
            write(2, tnf_msg, str_len(tnf_msg))
            exit(1)
        }
        compile_fat(input_path, output_path)
    } else if emit_mode == 11 {
        // --emit=fatimage never reaches compile() as itself. It drives
        // compile() once per slice, with emit_mode 8 and 9, and composes what
        // those passes produced -- so the finalize chain inside compile() has
        // no arm for 11 and must never grow one. This is the fork that keeps
        // that true; without it mode 11 would fall into compile() unnamed,
        // reach the end of a chain that has no terminal `else`, get no entry
        // patch and no size patch, and write a file at exit 0. That is the
        // failure the --emit=uefi finalize arm was written before it had
        // anything to patch in order to prevent.
        compile_fatimage(input_path, output_path)
    } else {
        compile(input_path, output_path, arch, emit_mode)
    }
    exit(0)
}
