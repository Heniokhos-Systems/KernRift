    resolve_static_fixups(ax_dfoff)
    patch_u32(296, ax_dfoff & 0xFFFFFFFF)
    patch_u32(300, (ax_dfoff >> 32) & 0xFFFFFFFF)
    patch_u32(304, androidx_rx_aligned & 0xFFFFFFFF)
    patch_u32(308, (androidx_rx_aligned >> 32) & 0xFFFFFFFF)
    patch_u32(312, androidx_rx_aligned & 0xFFFFFFFF)
    patch_u32(316, (androidx_rx_aligned >> 32) & 0xFFFFFFFF)
    patch_u32(320, ax_draw & 0xFFFFFFFF)
    patch_u32(324, (ax_draw >> 32) & 0xFFFFFFFF)
    // p_memsz = page-aligned size: bionic SIGBUSes on p_memsz=0.
    patch_u32(328, ax_dal & 0xFFFFFFFF)
    patch_u32(332, (ax_dal >> 32) & 0xFFFFFFFF)

    uint64 androidx_len = codegen_output_len()
    uint64 androidx_buf = alloc(androidx_len)
    uint64 axi = 0
    while axi < androidx_len {
        uint64 sp = out_buf + axi
        uint64 dp = androidx_buf + axi
        uint64 bv = 0
        unsafe { *(sp as uint8) -> bv }
        uint8 bb = bv
        unsafe { *(dp as uint8) = bb }
        axi = axi + 1
    set_target_arch(1)
    }

    // === Compile ARM64 Android PIE ELF ===
    target_os = 3
    out_len = 0
    fn_count = 0
    fixup_count = 0
    static_fixup_count = 0
    str_fixup_count = 0
    str_len = 0
    extern_fn_count = 0
    extern_call_count = 0
    fnaddr_fixup_count = 0
    static_count = 0
    static_data_size = 0
    struct_count = 0
    struct_var_count = 0
    enum_count = 0
    type_alias_count = 0
    arr_elem_count = 0
    // fn_ret_float_count is deliberately NOT reset here. The float-return
    // table is seeded once at parse time (parser.kr, parse_fn_decl) — same
    // as fn_ret_signed, which this reset never touched either. Clearing it
    // per slice left every slice after the first with an empty table, and
    // only the x86 IR emitter re-registered as it went; the arm64 emitter
    // never did, so `f32_fn() * x` lowered to an integer MUL there.
    // fn_ret_float_register is idempotent, so nothing accumulates.
    fn_ret_struct_count = 0
    line_table_count = 0
    last_recorded_line = 0
    debug_file_count = 0
    diag_count = 0
    diag_error_count = 0
    diag_warn_count = 0
    slice_len_count = 0
    device_count = 0
    device_field_count = 0
    var_type_count = 0
    win_iat_fixup_count = 0
    a64_win_iat_fixup_count = 0

    restore_src_and_tokens(source, size, src_snapshot, my_tokens, tok_bytes, tok_snapshot)
    ast_init(524288)
    parser_init(my_tokens, saved_tcount)
    uint64 root7 = parse_module()
    resolve_inferred_types(root7)
    inline_pass(root7)
    dce_init()
    dce_scan(root7)

    emit_elf_header_android_a64()
    uint64 text_start7 = codegen_output_len()

    uint32 child7 = ast_child(root7)
    uint64 wchild7 = child7
    while wchild7 != 0 {
        uint32 ck7 = ast_kind(wchild7)
        if ck7 == 2 {
            uint32 fn_name7 = ast_data1(wchild7)
            if dce_is_live(fn_name7) != 0 {
                if emit_ir_mode != 0 {
                    fn_register(fn_name7, out_len)
                    ir_init()
                    ir_emit_arm64_function(wchild7)
                } else {
                    gen_function_a64(wchild7)
                }
            }
        }
        uint32 nxt7 = ast_next(wchild7)
        wchild7 = nxt7
    }
    resolve_fixups_a64()
    resolve_fnaddr_fixups_a64()
    // Align to 8 bytes on arm64 (matches direct compile() path) so static
    // data LDR (imm12 scaled by 8) can encode any slot offset exactly.
    while (codegen_output_len() & 7) != 0 { emit_byte(0) }
    while (codegen_output_len() & 7) != 0 { emit_byte(0) }
    uint64 data_start7 = codegen_output_len()
    emit_static_data()
    resolve_static_fixups_a64(data_start7)
    uint64 str_start7 = codegen_output_len()
    emit_string_data()
    resolve_string_fixups_a64(str_start7)

    // Android PIE ELF: separate RX code + RW data segments
    uint64 android_entry = find_main_offset()
    patch_u32(24, android_entry & 0xFFFFFFFF)
    patch_u32(28, (android_entry >> 32) & 0xFFFFFFFF)
    // PT_LOAD RX: code + strings only
    uint64 android_rx = codegen_output_len()
    patch_u32(208, android_rx & 0xFFFFFFFF)
    patch_u32(212, (android_rx >> 32) & 0xFFFFFFFF)
    patch_u32(216, android_rx & 0xFFFFFFFF)
    patch_u32(220, (android_rx >> 32) & 0xFFFFFFFF)
    // Pad to 64KB page boundary for PT_LOAD RW
    uint64 android_rx_aligned = (android_rx + 0xFFFF) & ~0xFFFF
    while codegen_output_len() < android_rx_aligned { emit_byte(0) }
    // Emit data segment (statics)
    while (codegen_output_len() & 7) != 0 { emit_byte(0) }
    uint64 a7_dfoff = codegen_output_len()
    emit_static_data()
    uint64 a7_draw = codegen_output_len() - a7_dfoff
    uint64 a7_dal = (a7_draw + 0xFFFF) & ~0xFFFF
    if a7_dal == 0 { a7_dal = 0x10000 }
    while codegen_output_len() < a7_dfoff + a7_dal { emit_byte(0) }
    // Re-resolve static fixups to point into RW segment
    resolve_static_fixups_a64(a7_dfoff)
    // Patch PT_LOAD RW @288
    patch_u32(296, a7_dfoff & 0xFFFFFFFF)
    patch_u32(300, (a7_dfoff >> 32) & 0xFFFFFFFF)
    patch_u32(304, android_rx_aligned & 0xFFFFFFFF)
    patch_u32(308, (android_rx_aligned >> 32) & 0xFFFFFFFF)
    patch_u32(312, android_rx_aligned & 0xFFFFFFFF)
    patch_u32(316, (android_rx_aligned >> 32) & 0xFFFFFFFF)
    patch_u32(320, a7_draw & 0xFFFFFFFF)
    patch_u32(324, (a7_draw >> 32) & 0xFFFFFFFF)
    // p_memsz = page-aligned size: bionic SIGBUSes on p_memsz=0.
    patch_u32(328, a7_dal & 0xFFFFFFFF)
    patch_u32(332, (a7_dal >> 32) & 0xFFFFFFFF)

    uint64 android_len = codegen_output_len()
    uint64 android_buf = alloc(android_len)
    uint64 adi = 0
    while adi < android_len {
        uint64 sp = out_buf + adi
        uint64 dp = android_buf + adi
        uint64 bv = 0
        unsafe { *(sp as uint8) -> bv }
        uint8 bb = bv
        unsafe { *(dp as uint8) = bb }
        adi = adi + 1
    }

    // Reset target_os for fat binary emission
    target_os = 0

    // === BCJ filter before compression ===
    // x86_64 slices: filter E8/E9 CALL/JMP
    filter_x86_64_bcj(x86_buf, x86_len, 1)
    filter_x86_64_bcj(pe_x86_buf, pe_x86_len, 1)
    filter_x86_64_bcj(macho_x86_buf, macho_x86_len, 1)
    filter_x86_64_bcj(androidx_buf, androidx_len, 1)
    // arm64 slices: filter B/BL instructions
    filter_aarch64_bcj(a64_buf, a64_len, 1)
    filter_aarch64_bcj(pe_a64_buf, pe_a64_len, 1)
    filter_aarch64_bcj(macho_a64_buf, macho_a64_len, 1)
    filter_aarch64_bcj(android_buf, android_len, 1)

    // === Custom target subset: emit only the selected slices, each
    // compressed as a standalone (non-paired) LZ4 blob. The runner treats
    // an entry with pair_off == 0 and pair_uncomp_size == slice_uncomp_size
    // as a single-slice blob. Full-set selection (all 8) drops into the
    // default paired-compression path below for tighter compression.
    if target_mask != 0 && target_mask != 0xFF {
        uint64 comp_bufs = alloc(8 * 8)
        uint64 comp_lens = alloc(8 * 8)
        uint64 uncomp_lens = alloc(8 * 8)
        uint64 zi = 0
        while zi < 8 {
            uint64 zp = comp_bufs + zi * 8
            uint64 zl = comp_lens + zi * 8
            uint64 zu = uncomp_lens + zi * 8
            unsafe { *(zp as uint64) = 0 }
            unsafe { *(zl as uint64) = 0 }
            unsafe { *(zu as uint64) = 0 }
            zi = zi + 1
        }

        uint64 sel_count = 0
        uint64 aid = 1
        while aid <= 8 {
            uint64 bit = aid - 1
            if ((target_mask >> bit) & 1) != 0 {
                uint64 buf = 0
                uint64 len = 0
                if aid == 1 { buf = x86_buf; len = x86_len }
                if aid == 2 { buf = a64_buf; len = a64_len }
                if aid == 3 { buf = pe_x86_buf; len = pe_x86_len }
                if aid == 4 { buf = pe_a64_buf; len = pe_a64_len }
                if aid == 5 { buf = macho_x86_buf; len = macho_x86_len }
                if aid == 6 { buf = macho_a64_buf; len = macho_a64_len }
                if aid == 7 { buf = android_buf; len = android_len }
                if aid == 8 { buf = androidx_buf; len = androidx_len }
                uint64 cap = lz4_compress_bound(len)
                uint64 cbuf = alloc(cap)
                uint64 clen = lz4_compress_frame(buf, len, cbuf)
                uint64 cp = comp_bufs + bit * 8
                uint64 lp = comp_lens + bit * 8
                uint64 ulp = uncomp_lens + bit * 8
                unsafe { *(cp as uint64) = cbuf }
                unsafe { *(lp as uint64) = clen }
                unsafe { *(ulp as uint64) = len }
                sel_count = sel_count + 1
            }
            aid = aid + 1
        }

        out_len = 0
        emit_krbofat_v2_header(sel_count)
        uint64 c_data_offset = 16 + sel_count * 48
        uint64 c_pad = (16 - (c_data_offset & 15)) & 15
        c_data_offset = c_data_offset + c_pad

        uint64 cur_off = c_data_offset
        uint64 aid2 = 1
        while aid2 <= 8 {
            uint64 bit2 = aid2 - 1
            if ((target_mask >> bit2) & 1) != 0 {
                uint64 lp2 = comp_lens + bit2 * 8
                uint64 ulp2 = uncomp_lens + bit2 * 8
                uint64 clen2 = 0
                uint64 ulen2 = 0
                unsafe { *(lp2 as uint64) -> clen2 }
                unsafe { *(ulp2 as uint64) -> ulen2 }
                emit_krbofat_v2_entry_hdr(aid2, 1, cur_off, clen2, ulen2)
                emit_krbofat_v2_entry_rt(0, ulen2)
                cur_off = cur_off + clen2
            }
            aid2 = aid2 + 1
        }

        uint64 cpi = 0
        while cpi < c_pad { emit_byte(0); cpi = cpi + 1 }

        uint64 aid3 = 1
        while aid3 <= 8 {
            uint64 bit3 = aid3 - 1
            if ((target_mask >> bit3) & 1) != 0 {
                uint64 cp3 = comp_bufs + bit3 * 8
                uint64 lp3 = comp_lens + bit3 * 8
                uint64 cbuf3 = 0
                uint64 clen3 = 0
                unsafe { *(cp3 as uint64) -> cbuf3 }
                unsafe { *(lp3 as uint64) -> clen3 }
                emit_raw_bytes(cbuf3, clen3)
            }
            aid3 = aid3 + 1
        }

        codegen_write_output(output_path)

        uint8[64] nb3
        uint64 msg3 = "custom fat binary: "
        write(1, msg3, 19)
        uint64 nl3 = fmt_uint(nb3, sel_count)
        write(1, nb3, nl3)
        msg3 = " slice"
        write(1, msg3, 6)
        if sel_count != 1 {
            msg3 = "s"
            write(1, msg3, 1)
        }
        msg3 = " -> "
        write(1, msg3, 4)
        uint64 olen3 = str_len(output_path)
        write(1, output_path, olen3)
        msg3 = "\n"
        write(1, msg3, 1)
        return
    }

    // === LZ4 compress 4 arch-paired blobs ===
    // Best layout from experimental benchmarks (FAT_COMPRESSION_EXPERIMENTS.md):
    //   x86_64: Linux + macOS,     Windows + Android
    //   arm64:  Linux + Android,   Windows + macOS
    uint64[1] x64_lm_comp_slot
    uint64[1] x64_lm_comp_len_slot
    uint64[1] x64_lm_linux_off_slot
    uint64[1] x64_lm_mac_off_slot
    uint64[1] x64_lm_pair_len_slot
    compress_pair_best(
        x86_buf, x86_len, macho_x86_buf, macho_x86_len,
        x64_lm_comp_slot, x64_lm_comp_len_slot,
        x64_lm_linux_off_slot, x64_lm_mac_off_slot,
        x64_lm_pair_len_slot
    )
    uint64 x64_lm_comp = slot_load_u64(x64_lm_comp_slot)
    uint64 x64_lm_comp_len = slot_load_u64(x64_lm_comp_len_slot)
    uint64 x64_lm_linux_off = slot_load_u64(x64_lm_linux_off_slot)
    uint64 x64_lm_mac_off = slot_load_u64(x64_lm_mac_off_slot)
    uint64 x64_lm_pair_len = slot_load_u64(x64_lm_pair_len_slot)

    uint64[1] x64_wa_comp_slot
    uint64[1] x64_wa_comp_len_slot
    uint64[1] x64_wa_win_off_slot
    uint64[1] x64_wa_android_off_slot
    uint64[1] x64_wa_pair_len_slot
    compress_pair_best(
        pe_x86_buf, pe_x86_len, androidx_buf, androidx_len,
        x64_wa_comp_slot, x64_wa_comp_len_slot,
        x64_wa_win_off_slot, x64_wa_android_off_slot,
        x64_wa_pair_len_slot
    )
    uint64 x64_wa_comp = slot_load_u64(x64_wa_comp_slot)
    uint64 x64_wa_comp_len = slot_load_u64(x64_wa_comp_len_slot)
    uint64 x64_wa_win_off = slot_load_u64(x64_wa_win_off_slot)
    uint64 x64_wa_android_off = slot_load_u64(x64_wa_android_off_slot)
    uint64 x64_wa_pair_len = slot_load_u64(x64_wa_pair_len_slot)

    uint64[1] arm_la_comp_slot
    uint64[1] arm_la_comp_len_slot
    uint64[1] arm_la_linux_off_slot
    uint64[1] arm_la_android_off_slot
    uint64[1] arm_la_pair_len_slot
    compress_pair_best(
        a64_buf, a64_len, android_buf, android_len,
        arm_la_comp_slot, arm_la_comp_len_slot,
        arm_la_linux_off_slot, arm_la_android_off_slot,
        arm_la_pair_len_slot
    )
    uint64 arm_la_comp = slot_load_u64(arm_la_comp_slot)
    uint64 arm_la_comp_len = slot_load_u64(arm_la_comp_len_slot)
    uint64 arm_la_linux_off = slot_load_u64(arm_la_linux_off_slot)
    uint64 arm_la_android_off = slot_load_u64(arm_la_android_off_slot)
    uint64 arm_la_pair_len = slot_load_u64(arm_la_pair_len_slot)

    uint64[1] arm_wm_comp_slot
    uint64[1] arm_wm_comp_len_slot
    uint64[1] arm_wm_win_off_slot
    uint64[1] arm_wm_mac_off_slot
    uint64[1] arm_wm_pair_len_slot
    compress_pair_best(
        pe_a64_buf, pe_a64_len, macho_a64_buf, macho_a64_len,
        arm_wm_comp_slot, arm_wm_comp_len_slot,
        arm_wm_win_off_slot, arm_wm_mac_off_slot,
        arm_wm_pair_len_slot
    )
    uint64 arm_wm_comp = slot_load_u64(arm_wm_comp_slot)
    uint64 arm_wm_comp_len = slot_load_u64(arm_wm_comp_len_slot)
    uint64 arm_wm_win_off = slot_load_u64(arm_wm_win_off_slot)
    uint64 arm_wm_mac_off = slot_load_u64(arm_wm_mac_off_slot)
    uint64 arm_wm_pair_len = slot_load_u64(arm_wm_pair_len_slot)

    // === Emit KrboFat v2 ===
    out_len = 0
    emit_krbofat_v2_header(8)
    uint64 data_offset = 16 + 8 * 48
    uint64 pad = (16 - (data_offset & 15)) & 15
    data_offset = data_offset + pad
    uint64 blob1_data_off = data_offset
    uint64 blob2_data_off = blob1_data_off + x64_lm_comp_len
    uint64 blob3_data_off = blob2_data_off + x64_wa_comp_len
    uint64 blob4_data_off = blob3_data_off + arm_la_comp_len

    // Entry fields: arch_id, compression, blob_offset, blob_comp_size,
    // slice_uncomp_size, slice_offset_in_pair, pair_uncomp_size.
    emit_krbofat_v2_entry_hdr(1, 1, blob1_data_off, x64_lm_comp_len, x86_len)
    emit_krbofat_v2_entry_rt(x64_lm_linux_off, x64_lm_pair_len)
    emit_krbofat_v2_entry_hdr(2, 1, blob3_data_off, arm_la_comp_len, a64_len)
    emit_krbofat_v2_entry_rt(arm_la_linux_off, arm_la_pair_len)
    emit_krbofat_v2_entry_hdr(3, 1, blob2_data_off, x64_wa_comp_len, pe_x86_len)
    emit_krbofat_v2_entry_rt(x64_wa_win_off, x64_wa_pair_len)
    emit_krbofat_v2_entry_hdr(4, 1, blob4_data_off, arm_wm_comp_len, pe_a64_len)
    emit_krbofat_v2_entry_rt(arm_wm_win_off, arm_wm_pair_len)
    emit_krbofat_v2_entry_hdr(5, 1, blob1_data_off, x64_lm_comp_len, macho_x86_len)
    emit_krbofat_v2_entry_rt(x64_lm_mac_off, x64_lm_pair_len)
    emit_krbofat_v2_entry_hdr(6, 1, blob4_data_off, arm_wm_comp_len, macho_a64_len)
    emit_krbofat_v2_entry_rt(arm_wm_mac_off, arm_wm_pair_len)
    emit_krbofat_v2_entry_hdr(7, 1, blob3_data_off, arm_la_comp_len, android_len)
    emit_krbofat_v2_entry_rt(arm_la_android_off, arm_la_pair_len)
    emit_krbofat_v2_entry_hdr(8, 1, blob2_data_off, x64_wa_comp_len, androidx_len)
    emit_krbofat_v2_entry_rt(x64_wa_android_off, x64_wa_pair_len)

    uint64 pi = 0
    while pi < pad { emit_byte(0); pi = pi + 1 }

    emit_raw_bytes(x64_lm_comp, x64_lm_comp_len)
    emit_raw_bytes(x64_wa_comp, x64_wa_comp_len)
    emit_raw_bytes(arm_la_comp, arm_la_comp_len)
    emit_raw_bytes(arm_wm_comp, arm_wm_comp_len)

    codegen_write_output(output_path)

    uint8[64] nb
    uint64 msg = "fat binary: x86_64("
    write(1, msg, 19)
    uint64 nl = fmt_uint(nb, x86_len)
    write(1, nb, nl)
    msg = ") + arm64("
    write(1, msg, 10)
    nl = fmt_uint(nb, a64_len)
    write(1, nb, nl)
    msg = ") + win-x64("
    write(1, msg, 12)
    nl = fmt_uint(nb, pe_x86_len)
    write(1, nb, nl)
    msg = ") + win-arm("
    write(1, msg, 12)
    nl = fmt_uint(nb, pe_a64_len)
    write(1, nb, nl)
    msg = ") + mac-x64("
    write(1, msg, 12)
    nl = fmt_uint(nb, macho_x86_len)
    write(1, nb, nl)
    msg = ") + mac-arm("
    write(1, msg, 12)
    nl = fmt_uint(nb, macho_a64_len)
    write(1, nb, nl)
    msg = ") + android-arm64("
    write(1, msg, 18)
    nl = fmt_uint(nb, android_len)
    write(1, nb, nl)
    msg = ") + android-x64("
    write(1, msg, 16)
    nl = fmt_uint(nb, androidx_len)
    write(1, nb, nl)
    msg = ") -> "
    write(1, msg, 5)
    uint64 olen = str_len(output_path)
    write(1, output_path, olen)
    // Same "(X.XX ms)" timer as single-file compile(). Gated on t_start_fat
    // having landed as non-zero — older target_os paths that stub time_ns()
    // to 0 just fall back to the plain newline.
    uint64 t_end_fat = time_ns()
    if t_start_fat != 0 {
        uint64 elapsed_fat = t_end_fat - t_start_fat
        uint64 ms_whole_f = elapsed_fat / 1000000
        uint64 ms_hund_f  = (elapsed_fat / 10000) % 100
        msg = "  ("
        write(1, msg, 3)
        uint64 w_len_f = fmt_uint(nb, ms_whole_f)
        write(1, nb, w_len_f)
        msg = "."
        write(1, msg, 1)
        uint8[2] hb_f
        uint8 d0_f = 48 + (ms_hund_f / 10)
        uint8 d1_f = 48 + (ms_hund_f % 10)
        unsafe { *(hb_f as uint8) = d0_f }
        uint64 hb_f1 = hb_f + 1
        unsafe { *(hb_f1 as uint8) = d1_f }
        write(1, hb_f, 2)
        msg = " ms)\n"
        write(1, msg, 5)
    } else {
        msg = "\n"
        write(1, msg, 1)
    }
}

// Statics set by _start trampoline
static uint64 cli_argc = 0
static uint64 cli_argv = 0

// Type-checker gate. Default ON; --no-check-types disables for
// emergency builds. Phase 1 rules emit errors; Phase 2 rules (added
// later) emit warnings until their violation counts are triaged.
static uint64 check_types_enabled = 1

// Living compiler CLI options
static uint64 lc_ci_mode = 0
static uint64 lc_min_fitness = 0
static uint64 lc_fix_mode = 0
static uint64 lc_dry_run = 0
static uint64 lc_list_proposals = 0
static uint64 lc_promote_name = 0
static uint64 lc_deprecate_name = 0
static uint64 lc_reject_name = 0
static uint64 freestanding = 0

// --emit=image state. load_addr is VALIDATION AND REPORTING ONLY — it is
// never embedded in the artifact (x86_64 is fully RIP-relative; arm64 is
// position-independent modulo 4 KiB, both verified by boots at shifted
// addresses). Statics rather than locals so compile() can read them, the
// same forward-reference shape freestanding uses at :2340.
static uint64 load_addr = 0
static uint64 load_addr_set = 0

// --stack-top= state (sub-project B2, D4): the flag's PRESENCE is the opt-in
// for entry-stub emission -- the arm64 stub block and emit_x86_image_stub's
// multiboot header + long-mode trampoline both read stack_top_set as their
// gate, and so does the stack-vs-image refusal in the --emit=image finalize.
// Statics rather than locals for the same forward-reference reason as
// load_addr above (compile() can read them).
// Deliberately NO default: an unset stack means "no stub", never "guess
// one" -- a silently defaulted stack boots on the author's board and faults
// silently on someone else's.
static uint64 stack_top = 0
static uint64 stack_top_set = 0

// --image-header state (sub-project C). Requires --emit=image, --arch=arm64
// and --stack-top= together, validated where --stack-top='s own checks live.
// Set, it makes the emit_mode 8 path prefix the artifact with the 64-byte
// arm64 Linux `Image` header (Task 2 -- the emission block, and the two
// patch-backs it needs, are the three `a64hdr_on` sites). Unset, no byte the
// compiler writes changes: every --emit=image pin in the suite builds without
// this flag and is unaffected by it.
static uint64 image_header_set = 0

// Machine target (--target=esp32): 0 = none, 1 = ESP32 (Xtensa LX6 esp-image
// at ESP32 load addresses). Orthogonal to target_os — --target= is overloaded:
// OS names set target_os, machine names set this. Only meaningful with
// --arch=xtensa --freestanding (validated after arg parsing, so flag order
// doesn't matter).
static uint64 machine_target = 0

fn parse_uint_arg(uint64 s) -> uint64 {
    uint64 val = 0
    uint64 i = 0
    uint64 p = s + i
    uint64 c = 0
    unsafe { *(p as uint8) -> c }
    while c >= 48 && c <= 57 {
        val = val * 10 + (c - 48)
        i = i + 1
        p = s + i
        unsafe { *(p as uint8) -> c }
    }
    return val
}

// Legal --arch x --target(OS) pairs, ENUMERATED.
//
//   arch: 0 x86_64, 1 arm64, 2 riscv32, 3 xtensa
//   os:   0 linux,  1 macos, 2 windows, 3 android, 4 none
//
// Deliberately an allow-list with a `return 0` fall-through, NOT a blacklist
// of the pairs that are broken today. A blacklist passes every test the day
// it is written and then silently admits whichever arch or OS is added next
// — which is the same "else, assume POSIX" shape that put a Linux exit
// syscall inside a bare-metal image and that this whole sub-project exists to
// remove. Adding an arch here without adding its row is a hard error at the
// first build, not a nonsense artifact.
//
// Before this existed there was no arch/OS validation at all: `--arch=riscv32
// --target=windows` exited 0 and wrote a 296-byte RISC-V *ELF* — a PE was
// requested, an ELF was produced, and neither the requested OS nor the
// requested container appeared anywhere in the output.
fn arch_os_pair_supported(uint64 arch, uint64 os) -> uint64 {
    if arch == 0 {
        // x86_64 — all four hosted OSes (it is one of the two fat-binary
        // slice arches, so every hosted OS must build) plus bare metal.
        if os == 0 { return 1 }
        if os == 1 { return 1 }
        if os == 2 { return 1 }
        if os == 3 { return 1 }
        if os == 4 { return 1 }
        return 0
    }
    if arch == 1 {
        // arm64 — the other fat-binary slice arch; same five.
        if os == 0 { return 1 }
        if os == 1 { return 1 }
        if os == 2 { return 1 }
        if os == 3 { return 1 }
        if os == 4 { return 1 }
        return 0
    }
    if arch == 2 {
        // riscv32 — hosted RV32 Linux ELF, and bare metal. There is no
        // macOS, Windows or Android on RV32 for this compiler to target: no
        // Mach-O/PE writer accepts an RV32 machine type, and the Android
        // path is arm64/x86_64 only.
        if os == 0 { return 1 }
        if os == 4 { return 1 }
        return 0
    }
    if arch == 3 {
        // xtensa — bare metal, and os == 0 because 0 is the DEFAULT value of
        // target_os: every existing `--arch=xtensa --freestanding` and
        // `--target=esp32` invocation carries it without ever naming an OS,
        // so rejecting the pair here would reject all of them. It does not
        // mean hosted Xtensa Linux works — that still fails downstream with
        // "xtensa ELF image emission not yet implemented", which is the
        // accurate diagnostic for it.
        if os == 0 { return 1 }
        if os == 4 { return 1 }
        return 0
    }
    return 0
}

// One message, one place. Every --load-addr= parse failure exits through here
// rather than repeating the literal at each rejection site: the suite greps
// this text, and three copies is three chances for one of them to drift.
fn load_addr_die() {
    uint64 la_bad = "error: --load-addr= wants a decimal or 0x-prefixed hex address\n"
    write(2, la_bad, str_len(la_bad))
    exit(1)
}

// --load-addr= value: plain decimal or 0x/0X-prefixed hex. Anything else —
// empty, stray characters, bare "0x", more than 16 digits — refuses loudly:
// this value feeds the arm64 alignment check, and a malformed input that
// silently parsed as 0 would PASS that check while meaning nothing.
fn parse_load_addr(uint64 s) -> uint64 {
    uint64 p = s
    uint64 base = 10
    uint64 c0 = 0
    unsafe { *(p as uint8) -> c0 }
    if c0 == 48 {
        uint64 p1 = p + 1
        uint64 c1 = 0
        unsafe { *(p1 as uint8) -> c1 }
        if c1 == 120 || c1 == 88 {
            base = 16
            p = p + 2
        }
    }
    uint64 v = 0
    uint64 ndigits = 0
    loop {
        uint64 c = 0
        unsafe { *(p as uint8) -> c }
        if c == 0 { break }
        uint64 d = 99
        if c >= 48 && c <= 57 { d = c - 48 }
        if base == 16 && c >= 97 && c <= 102 { d = c - 87 }
        if base == 16 && c >= 65 && c <= 70 { d = c - 55 }
        if d == 99 { load_addr_die() }
        v = v * base + d
        ndigits = ndigits + 1
        // Overflow guard: 16 hex digits is a full uint64, and anything longer
        // has already wrapped silently by the time we could notice.
        if ndigits > 16 { load_addr_die() }
        p = p + 1
    }
    // Catches both "--load-addr=" (empty) and "--load-addr=0x" (prefix only).
    if ndigits == 0 { load_addr_die() }
    return v
}

// One message, one place, mirroring load_addr_die() above. Every
// --stack-top= parse failure exits through here rather than repeating the
// literal at each site.
fn stack_top_die() {
    uint64 st_bad = "error: --stack-top= wants a decimal or 0x-prefixed hex address\n"
    write(2, st_bad, str_len(st_bad))
    exit(1)
}

// --stack-top= value: same grammar as --load-addr= (parse_load_addr above)
// -- plain decimal or 0x/0X-prefixed hex. Duplicated rather than shared:
// the two flags have independent die() paths naming independent flags, and
// a shared parser would need a function-pointer callback to keep that, for
// no real savings over these ~30 lines.
fn parse_stack_top(uint64 s) -> uint64 {
    uint64 p = s
    uint64 base = 10
    uint64 c0 = 0
    unsafe { *(p as uint8) -> c0 }
    if c0 == 48 {
        uint64 p1 = p + 1
        uint64 c1 = 0
        unsafe { *(p1 as uint8) -> c1 }
        if c1 == 120 || c1 == 88 {
            base = 16
            p = p + 2
        }
    }
    uint64 v = 0
    uint64 ndigits = 0
    loop {
        uint64 c = 0
        unsafe { *(p as uint8) -> c }
        if c == 0 { break }
        uint64 d = 99
        if c >= 48 && c <= 57 { d = c - 48 }
        if base == 16 && c >= 97 && c <= 102 { d = c - 87 }
        if base == 16 && c >= 65 && c <= 70 { d = c - 55 }
        if d == 99 { stack_top_die() }
        v = v * base + d
        ndigits = ndigits + 1
        // Overflow guard: 16 hex digits is a full uint64, and anything
        // longer has already wrapped silently by the time we could notice.
        if ndigits > 16 { stack_top_die() }
        p = p + 1
    }
    // Catches both "--stack-top=" (empty) and "--stack-top=0x" (prefix only).
    if ndigits == 0 { stack_top_die() }
    return v
}

// Spellings for the pair diagnostic. These are the --arch= / --target= values
// a user actually types, so the message can be copy-edited back into a
// working command line.
fn arch_flag_name(uint64 arch) -> uint64 {
    if arch == 1 { return "arm64" }
    if arch == 2 { return "riscv32" }
    if arch == 3 { return "xtensa" }
    return "x86_64"
}

fn target_os_flag_name(uint64 os) -> uint64 {
    if os == 1 { return "macos" }
    if os == 2 { return "windows" }
    if os == 3 { return "android" }
    if os == 4 { return "none" }
    return "linux"
}

@export
fn main() {
    // Windows: parse raw GetCommandLineA result into argc/argv
    if cli_argc == 0xFFFFFFFF {
        win_init_args()
    }

    uint64 input_path = 0
    uint64 output_path = "a.krbo"
    uint64 mode = 0
    uint64 arch = 0
    uint64 emit_mode = 0
    uint64 arch_set = 0
    uint64 emit_set = 0
    // "the LAST --emit= on the line spelled `uefi`", which is a different fact
    // from `emit_mode == 9` and is why it needs its own variable. --target=
    // android does not merely set target_os: it ASSIGNS emit_mode = 4 from
    // inside the argument loop, so `--emit=uefi --target=android` leaves
    // emit_mode 4 with nothing anywhere recording that a UEFI application was
    // asked for. Measured before this existed: that line emitted an Android
    // PIE ELF at exit 0. --emit=image survives the same clobber only by
    // accident (it also requires --load-addr=, whose own "only meaningful
    // with --emit=image" check then fires); a new mode has no such backstop.
    //
    // RESET, NOT JUST SET, by every later --emit= and by -c — otherwise the
    // post-loop check below would also fire on `--emit=uefi --emit=elfexe`,
    // which is ordinary last-wins and must keep working (pinned by
    // uefi_emit_last_wins_away).
    uint64 uefi_set = 0
    // Tracks what the last --target= flag resolved to, so a second, different
    // --target= is a conflict rather than last-wins (e.g. --target=esp32
    // already implies bare metal on Xtensa; composing it with an OS name or
    // with --target=none must not silently pick whichever parsed last).
    // 0 = not given yet; 1 linux, 2 macos, 3 windows, 4 android, 5 esp32,
    // 6 none.
    uint64 target_arg_seen = 0
    uint64 target_arg_kind = 0
    uint64 target_arg_str = 0

    if cli_argc > 1 {
        uint64 i = 1
        while i < cli_argc {
            uint64 arg_ptr = cli_argv + i * 8
            uint64 arg = 0
            unsafe { *(arg_ptr as uint64) -> arg }
            if str_starts_with(arg, "-o", 2) != 0 {
                uint64 arg_len = str_len(arg)
                if arg_len == 2 {
                    i = i + 1
                    uint64 next_ptr = cli_argv + i * 8
                    unsafe { *(next_ptr as uint64) -> output_path }
                } else {
                    output_path = arg + 2
                }
            } else if str_starts_with(arg, "--arch=", 7) != 0 {
                arch_set = 1
                uint64 arch_str = arg + 7
                if str_eq_full(arch_str, "arm64") != 0 {
                    arch = 1
                } else if str_eq_full(arch_str, "aarch64") != 0 {
                    arch = 1
                } else if str_eq_full(arch_str, "riscv32") != 0 {
                    arch = 2
                } else if str_eq_full(arch_str, "riscv64") != 0 {
                    write(2, "error: --arch=riscv64: RV64 is not supported yet. This compiler targets RV32; use --arch=riscv32.\n", 98)
                    exit(1)
                } else if str_eq_full(arch_str, "xtensa") != 0 {
                    arch = 3
                } else if str_eq_full(arch_str, "x86_64") != 0 {
                    arch = 0
                } else if str_eq_full(arch_str, "x86-64") != 0 {
                    arch = 0
                } else if str_eq_full(arch_str, "amd64") != 0 {
                    arch = 0
                } else if str_eq_full(arch_str, "x64") != 0 {
                    arch = 0
                } else {
                    write(2, "error: unknown --arch (use x86_64|arm64|riscv32|xtensa)\n", 56)
                    exit(1)
                }
            } else if str_starts_with(arg, "--emit=", 7) != 0 {
                emit_set = 1
                // Cleared here and re-set only by the `uefi` arm below, so it
                // always describes the LAST --emit= and never a superseded one.
                uefi_set = 0
                uint64 emit_str = arg + 7
                if str_eq_full(emit_str, "elfexe") != 0 {
                    emit_mode = 0
                } else if str_eq_full(emit_str, "elf") != 0
                       || str_eq_full(emit_str, "elf-arm64") != 0
                       || str_eq_full(emit_str, "elf-x86_64") != 0 {
                    // "elf" / "elf-arm64" / "elf-x86_64" spellings for ELF
                    emit_mode = 0
                } else if str_eq_full(emit_str, "linux") != 0
                       || str_eq_full(emit_str, "linux-x86_64") != 0
                       || str_eq_full(emit_str, "linux-arm64") != 0
                       || str_eq_full(emit_str, "linux-x86-64") != 0 {
                    // "linux", "linux-x86_64", "linux-arm64", "linux-x86-64" all alias to ELF
                    emit_mode = 0
                } else if str_eq_full(emit_str, "macho") != 0 {
                    emit_mode = 1
                } else if str_eq_full(emit_str, "mac") != 0
                       || str_eq_full(emit_str, "macos") != 0
                       || str_eq_full(emit_str, "mac-x64") != 0
                       || str_eq_full(emit_str, "mac-arm64") != 0 {
                    // "mac", "macos", "mac-x64", "mac-arm64" alias to Mach-O
                    emit_mode = 1
                } else if str_eq_full(emit_str, "darwin") != 0 {
                    emit_mode = 1
                } else if str_eq_full(emit_str, "windows") != 0
                       || str_eq_full(emit_str, "windows-x64") != 0
                       || str_eq_full(emit_str, "windows-arm64") != 0 {
                    // "windows", "windows-x64", "windows-arm64" alias to PE
                    emit_mode = 2
                } else if str_eq_full(emit_str, "win") != 0
                       || str_eq_full(emit_str, "win-x64") != 0
                       || str_eq_full(emit_str, "win-arm64") != 0 {
                    // "win", "win-x64", "win-arm64" alias to PE
                    emit_mode = 2
                } else if str_eq_full(emit_str, "pe") != 0 {
                    emit_mode = 2
                } else if str_eq_full(emit_str, "obj") != 0 {
                    emit_mode = 3
                } else if str_eq_full(emit_str, "android") != 0 {
                    emit_mode = 4
                } else if str_eq_full(emit_str, "asm") != 0 {
                    emit_mode = 5
                } else if str_eq_full(emit_str, "ir") != 0 {
                    emit_mode = 6
                } else if str_eq_full(emit_str, "lkm") != 0 {
                    // Linux loadable kernel module — relocatable ELF (.ko)
                    // with .modinfo, struct module, init_module /
                    // cleanup_module symbols. Phase A.1.
                    emit_mode = 7
                } else if str_eq_full(emit_str, "image") != 0 {
                    // Raw flat binary for bare metal — no container, and
                    // nothing precedes the code except the 64-byte arm64
                    // Image header --image-header opts into. emit_mode 8
                    // is a NEW value on purpose: the raw-path triggers for
                    // riscv32/xtensa key on emit_mode == 0 + freestanding
                    // (:2340), so a new value is untouched by every existing
                    // invocation and byte-identity holds by construction.
                    emit_mode = 8
                } else if str_eq_full(emit_str, "uefi") != 0 {
                    // UEFI application: a PE32+ image that firmware loads and
                    // enters directly (sub-project D). A NEW emit_mode value
                    // rather than a modifier on 2 (--emit=pe) or 8
                    // (--emit=image), because it shares the CONTAINER with
                    // neither: --emit=pe hardcodes a kernel32 import table and
                    // a Windows subsystem, and --emit=image has no container
                    // at all. What it does share with 8 is the PAYLOAD, which
                    // is why both are in img_raw.
                    emit_mode = 9
                    uefi_set = 1
                } else {
                    write(2, "error: unknown emit format '", 28)
                    uint64 esl = str_len(emit_str)
                    write(2, emit_str, esl)
                    write(2, "'\n", 2)
                    uint64 evl = "valid: elfexe, elf, linux, macho, mac, darwin, pe, windows, win, obj, android, asm, ir, lkm, image, uefi\n"
                    write(2, evl, str_len(evl))
                    exit(1)
                }
            } else if str_starts_with(arg, "--load-addr=", 12) != 0 {
                // An explicit arm, and it must precede the final
                // `else { input_path = arg }` fallthrough: before this,
                // --load-addr=0x400000 was swallowed as an INPUT FILENAME and
                // the build died with "cannot open '--load-addr=0x400000'".
                load_addr = parse_load_addr(arg + 12)
                load_addr_set = 1
            } else if str_starts_with(arg, "--stack-top=", 12) != 0 {
                // Same V7 hazard load_addr's arm comments on: without an
                // explicit arm here, --stack-top=... falls through to the
                // final `else { input_path = arg }` and dies with
                // "cannot open '--stack-top=...': file not found" instead
                // of naming itself.
                stack_top = parse_stack_top(arg + 12)
                stack_top_set = 1
            } else if str_eq_full(arg, "--image-header") != 0 {
                // No value to parse -- an explicit arm is still needed for
                // the same V7 reason --load-addr=/--stack-top= have one:
                // without it, --image-header falls through to the final
                // `else { input_path = arg }` and dies with "cannot open
                // '--image-header': file not found" instead of naming
                // itself. Validated below; the 64 bytes it turns on are
                // emitted from the `a64hdr_on` block on the emit_mode 8 path.
                image_header_set = 1
            } else if str_eq_full(arg, "-c") != 0 {
                emit_set = 1
                uefi_set = 0
                emit_mode = 3
            } else if str_starts_with(arg, "--targets=", 10) != 0 {
                parse_targets_arg(arg + 10)
            } else if str_starts_with(arg, "--target=", 9) != 0 {
                uint64 tgt_str = arg + 9
                uint64 tgt_kind = 0
                if str_eq_full(tgt_str, "macos") != 0 {
                    tgt_kind = 2
                } else if str_eq_full(tgt_str, "darwin") != 0 {
                    tgt_kind = 2
                } else if str_eq_full(tgt_str, "windows") != 0 {
                    tgt_kind = 3
                } else if str_eq_full(tgt_str, "win") != 0 {
                    tgt_kind = 3
                } else if str_eq_full(tgt_str, "linux") != 0 {
                    tgt_kind = 1
                } else if str_eq_full(tgt_str, "android") != 0 {
                    tgt_kind = 4
                } else if str_eq_full(tgt_str, "esp32") != 0 {
                    // Machine target, not an OS: ESP32 (Xtensa LX6) esp-image.
                    // Requires --arch=xtensa --freestanding — validated after
                    // the arg loop so flag order doesn't matter.
                    //
                    // EXACT match, deliberately NOT str_starts_with: the OS
                    // names above can afford a prefix match, but "esp32s3" and
                    // "esp32c3" are DIFFERENT CHIPS with different memory maps
                    // (and C3 is RISC-V, not Xtensa). A prefix match would let
                    // --target=esp32s3 silently masquerade as an ESP32 and emit
                    // an image with wrong-for-that-chip load addresses — i.e. a
                    // board that does not boot, diagnosed over ~2-minute flash
                    // cycles with no JTAG. Unknown targets hit the loud error
                    // below rather than being silently ignored.
                    tgt_kind = 5
                } else if str_eq_full(tgt_str, "none") != 0 {
                    // Bare metal: no operating system. Forces freestanding
                    // (main's prologue/epilogue only emit OS startup/exit code
                    // when freestanding == 0, ir.kr:13084 and :13405) so
                    // --target=none alone is enough — the user does not also
                    // have to pass --freestanding. Lowering for target_os == 4
                    // beyond this flag surface is later work; this only
                    // records the value and refuses combinations that are
                    // nonsense today (fat-binary slice, esp32, lkm/android
                    // emit modes).
                    tgt_kind = 6
                } else {
                    // Unknown --target=: fail loud. Previously this fell off the
                    // if-chain and was SILENTLY IGNORED, so a typo (or a
                    // near-miss like "esp32s3") produced a default-target binary
                    // with no warning at all. Mirrors the existing behaviour for
                    // an unknown --arch, and matches the project rule of loud
                    // failure over silently emitting the wrong thing.
                    uint64 tgt_err = "error: unknown --target= value (expected: linux, macos/darwin, windows/win, android, esp32, none)\n"
                    write(2, tgt_err, str_len(tgt_err))
                    exit(1)
                }

                // A second, different --target= is a conflict, not last-wins.
                // Verified broken before this check existed: --target=esp32
                // composed silently with a preceding OS name (or --target=
                // none), each order building byte-identical to plain esp32
                // with the other flag's value swallowed with no warning.
                if target_arg_seen != 0 && target_arg_kind != tgt_kind {
                    uint64 tc_msg1 = "error: conflicting --target= values: '"
                    write(2, tc_msg1, str_len(tc_msg1))
                    write(2, target_arg_str, str_len(target_arg_str))
                    uint64 tc_msg2 = "' and '"
                    write(2, tc_msg2, str_len(tc_msg2))
                    write(2, tgt_str, str_len(tgt_str))
                    uint64 tc_msg3 = "' - pass --target= once\n"
                    write(2, tc_msg3, str_len(tc_msg3))
                    exit(1)
                }
                target_arg_seen = 1
                target_arg_kind = tgt_kind
                target_arg_str = tgt_str

                if tgt_kind == 1 {
                    target_os = 0
                } else if tgt_kind == 2 {
                    target_os = 1
                } else if tgt_kind == 3 {
                    target_os = 2
                } else if tgt_kind == 4 {
                    target_os = 3
                    emit_mode = 4
                } else if tgt_kind == 5 {
                    machine_target = 1
                } else if tgt_kind == 6 {
                    target_os = 4
                    freestanding = 1
                }
            } else if str_starts_with(arg, "--help", 6) != 0 || str_eq_full(arg, "-h") != 0 {
                write(1, "usage: krc [options] <file.kr> [-o output]\n", 43)
                write(1, "       krc <command> <file.kr> [options]\n\n", 42)
                write(1, "default: emit a .krbo fat binary covering all 8 supported targets\n", 66)
                write(1, "(linux/macos/windows/android x x86_64/arm64). The kr runner extracts\n", 69)
                write(1, "and execs the matching slice at startup.\n\n", 42)

                write(1, "output:\n", 8)
                write(1, "  --arch=x86_64|arm64|riscv32|xtensa   single-arch binary (no fat-binary wrap)\n", 79)
                uint64 tgt_help = "  --target=linux|macos|windows|android|esp32|none   single-target binary\n"
                write(1, tgt_help, str_len(tgt_help))
                // 'none' adds values to the get_target_os()/get_arch_id() ABI
                // rather than reusing an OS's, so --help states them: a user
                // who writes `if get_arch_id() == 2` for arm64 gets 10 on a
                // bare-metal arm64 build and must handle it.
                uint64 tn_help = "                              'none' = bare metal, no OS: get_target_os()=4, get_arch_id()=9-12\n"
                write(1, tn_help, str_len(tn_help))
                write(1, "  --targets=<list>          custom fat binary subset\n", 53)
                write(1, "                              e.g. linux-x64,macos-arm64,win-x64\n", 65)
                write(1, "  --emit=elfexe|macho|pe|android        single-target executable\n", 65)
                write(1, "  --emit=obj                relocatable .o (.obj on Windows)\n", 61)
                write(1, "  --emit=lkm                Linux loadable kernel module (.ko)\n", 63)
                write(1, "  --emit=asm                annotated assembly listing\n", 55)
                write(1, "  --emit=ir                 dump SSA IR per function\n", 53)
                uint64 h_img = "  --emit=image             raw flat binary, no container (bare metal; needs --target=none, explicit --arch, --load-addr=; --image-header prefixes an arm64 boot header)\n"
                write(1, h_img, str_len(h_img))
                // A dedicated line, not a clause inside another flag's
                // description: `hd_flags`'s regex stops at `=`, so it reads
                // `--emit` out of `--emit=uefi` and the docs-consistency rows
                // are already satisfied by a token that predates this mode.
                // An --emit= VALUE is structurally invisible to them, which is
                // why this line and its docs section each carry their own row
                // (uefi_help_has_own_line, uefi_docs_section_intact).
                uint64 h_uefi = "  --emit=uefi              UEFI application: a PE32+ image firmware loads and enters directly (bare metal; needs --target=none and an explicit --arch=x86_64|arm64; takes no --load-addr/--stack-top -- firmware relocates the image and enters with a stack already set up)\n"
                write(1, h_uefi, str_len(h_uefi))
                uint64 h_la = "  --load-addr=<addr>       where the image will be loaded; validated (arm64: 4096-aligned) and reported, never embedded\n"
                write(1, h_la, str_len(h_la))
                uint64 h_st = "  --stack-top=<addr>       emit a self-booting entry stub that sets SP here (x86_64 also gets a multiboot header + long-mode trampoline); validated per-arch (arm64: 16-byte aligned, <2^32; x86_64: <=0x40000000, its first push must clear the page tables at 0x1000-0x4000 so the stack top is <=0x1000 or >=0x4008, and --load-addr must then be in [0x4000,0x40000000)); on both arches the stack must not start inside the image; no default\n"
                write(1, h_st, str_len(h_st))
                uint64 h_ih = "  --image-header            prefix the 64-byte arm64 Linux Image header (magic 0x644d5241) so a loader can boot the artifact from its first byte; requires --emit=image, --arch=arm64 and --stack-top=\n"
                write(1, h_ih, str_len(h_ih))
                write(1, "  -c                        shorthand for --emit=obj\n", 53)
                write(1, "  -o <path>                 output path\n\n", 41)

                write(1, "code generation:\n", 17)
                write(1, "  --ir                      force IR backend (default)\n", 55)
                write(1, "  --legacy                  legacy direct codegen path\n", 55)
                write(1, "  --coalesce                Briggs/George copy coalescing (default on)\n", 71)
                write(1, "  --no-coalesce             disable copy coalescing\n", 52)
                write(1, "  --check-types             type checker (default on)\n", 54)
                uint64 wmsg_5200 = "  --no-check-types          disable type checker\n"
                write(1, wmsg_5200, str_len(wmsg_5200))
                write(1, "  --O0                      disable IR optimizations (CF/DCE/CSE/LICM)\n", 71)
                write(1, "  --freestanding            no startup code, no libc\n", 53)
                write(1, "  --debug                   runtime safety checks (bounds, null)\n", 65)
                write(1, "  -g                        emit DWARF debug info\n\n", 51)

                write(1, "commands (living compiler):\n", 28)
                write(1, "  check <file.kr>           safety analysis\n", 44)
                write(1, "  lc <file.kr>              propose / classify changes\n", 55)
                write(1, "  fmt <file.kr>             auto-format source\n", 47)
                write(1, "  --list-proposals          list pending proposals\n", 51)
                write(1, "  --promote <name>          accept a proposal\n", 46)
                write(1, "  --deprecate <name>        deprecate an accepted proposal\n", 59)
                write(1, "  --reject <name>           reject a proposal\n", 46)
                write(1, "  --min-fitness <N>         min fitness for --promote\n", 54)
                write(1, "  --ci                      machine-readable check output\n", 58)
                write(1, "  --fix                     apply auto-fixes from check\n", 56)
                write(1, "  --dry-run                 show changes without writing\n\n", 58)

                write(1, "info:\n", 6)
                write(1, "  --version                 show version\n", 41)
                write(1, "  --help, -h                show this help\n", 43)
                exit(0)
            } else if str_starts_with(arg, "--version", 9) != 0 {
                uint64 msg = "krc 2.8.34 (KernRift self-hosted compiler)\n"
                write(1, msg, str_len(msg))
                exit(0)
            } else if str_starts_with(arg, "--freestanding", 14) != 0 {
                freestanding = 1
            } else if str_starts_with(arg, "--legacy", 8) != 0 {
                emit_ir_mode = 0
            } else if str_starts_with(arg, "--ir", 4) != 0 {
                emit_ir_mode = 2
            } else if str_starts_with(arg, "--O0", 4) != 0 {
                ir_opt_level = 0
            } else if str_starts_with(arg, "--no-coalesce", 13) != 0 {
                ir_set_coalesce(0)
            } else if str_starts_with(arg, "--coalesce", 10) != 0 {
                ir_set_coalesce(1)
            } else if str_starts_with(arg, "--no-check-types", 16) != 0 {
                check_types_enabled = 0
            } else if str_starts_with(arg, "--check-types", 13) != 0 {
                check_types_enabled = 1
            } else if str_starts_with(arg, "--debug", 7) != 0 {
                debug_mode = 1
            } else if str_starts_with(arg, "-g", 2) != 0 {
                debug_info_mode = 1
            } else if str_starts_with(arg, "--ci", 4) != 0 {
                lc_ci_mode = 1
            } else if str_starts_with(arg, "--fix", 5) != 0 {
                lc_fix_mode = 1
            } else if str_starts_with(arg, "--dry-run", 9) != 0 {
                lc_dry_run = 1
            } else if str_starts_with(arg, "--list-proposals", 16) != 0 {
                lc_list_proposals = 1
                mode = 2
            } else if str_starts_with(arg, "--promote=", 10) != 0 {
                lc_promote_name = arg + 10
                mode = 2
            } else if str_starts_with(arg, "--promote", 9) != 0 {
                i = i + 1
                uint64 pnext_ptr = cli_argv + i * 8
                uint64 pnext_arg = 0
                unsafe { *(pnext_ptr as uint64) -> pnext_arg }
                lc_promote_name = pnext_arg
                mode = 2
            } else if str_starts_with(arg, "--deprecate=", 12) != 0 {
                lc_deprecate_name = arg + 12
                mode = 2
            } else if str_starts_with(arg, "--deprecate", 11) != 0 {
                i = i + 1
                uint64 dnext_ptr = cli_argv + i * 8
                uint64 dnext_arg = 0
                unsafe { *(dnext_ptr as uint64) -> dnext_arg }
                lc_deprecate_name = dnext_arg
                mode = 2
            } else if str_starts_with(arg, "--reject=", 9) != 0 {
                lc_reject_name = arg + 9
                mode = 2
            } else if str_starts_with(arg, "--reject", 8) != 0 {
                i = i + 1
                uint64 rnext_ptr = cli_argv + i * 8
                uint64 rnext_arg = 0
                unsafe { *(rnext_ptr as uint64) -> rnext_arg }
                lc_reject_name = rnext_arg
                mode = 2
            } else if str_starts_with(arg, "--min-fitness=", 14) != 0 {
                lc_min_fitness = parse_uint_arg(arg + 14)
            } else if str_starts_with(arg, "--min-fitness", 13) != 0 {
                // --min-fitness N (next arg)
                i = i + 1
                uint64 next_ptr = cli_argv + i * 8
                uint64 next_arg = 0
                unsafe { *(next_ptr as uint64) -> next_arg }
                lc_min_fitness = parse_uint_arg(next_arg)
            } else if str_starts_with(arg, "check", 5) != 0 && str_len(arg) == 5 {
                mode = 1
            } else if str_starts_with(arg, "lc", 2) != 0 && str_len(arg) == 2 {
                mode = 2
            } else if str_starts_with(arg, "fmt", 3) != 0 && str_len(arg) == 3 {
                mode = 3
            } else {
                // Subcommands require an EXACT match (above); anything else —
                // including a filename like `checksum.kr` or `lcd_driver.kr`
                // that merely shares a prefix — is the input path, not a mode.
                input_path = arg
            }
            i = i + 1
        }
    }



    // Auto-set target_os from emit_mode if not explicitly set
    if emit_mode == 1 && target_os == 0 { target_os = 1 }
    if emit_mode == 2 && target_os == 0 { target_os = 2 }
    if emit_mode == 4 && target_os == 0 { target_os = 3 }
    // emit_mode=4 (android): default to arm64 unless --arch was explicitly set
    if emit_mode == 4 && arch_set == 0 { arch = 1 }

    // --emit=uefi survived the argument loop, or it did not. THE ONLY THING
    // THAT CAN TAKE IT AWAY IS --target=android, which assigns emit_mode = 4
    // in the middle of the loop; a later --emit= clears uefi_set on its way
    // past, so ordinary last-wins never reaches here.
    //
    // FIRST, AHEAD OF EVERY OTHER REFUSAL IN THIS FILE, because by this point
    // emit_mode says 4 and target_os says 3 — the request is invisible to
    // every check keyed on either. Without this the line emits an Android PIE
    // ELF at exit 0 with no diagnostic, which is the exact shape sub-project A
    // spent a Critical on. The opposite order (`--target=android --emit=uefi`)
    // is NOT this defect: there --emit=uefi legitimately wins the chain and is
    // refused by the --target=none rule below, which is a different door and
    // says so.
    if uefi_set != 0 && emit_mode != 9 {
        uint64 uf_ov = "error: --emit=uefi was overridden by --target=android: --target=android does not only select an OS, it also forces --emit=android, so the UEFI application you asked for would have been emitted as an Android PIE ELF. Drop --target=android (--emit=uefi requires --target=none), or drop --emit=uefi\n"
        write(2, uf_ov, str_len(uf_ov))
        exit(1)
    }

    // --target=none is a bare-metal image: no kernel to load a loadable
    // kernel module into, no Android runtime to host an APK payload. Refuse
    // both explicitly rather than emitting a container that nothing on that
    // target can ever load.
    //
    // Every refusal in this block NAMES BOTH FLAGS. A message that says only
    // "--target=none" leaves the user to guess which of the other flags on
    // the line to drop, and these combinations are reached by flags that are
    // individually correct.
    if target_os == 4 {
        if emit_mode == 7 {
            uint64 lkm_msg = "error: --emit=lkm conflicts with --target=none: a loadable kernel module has no kernel to load into\n"
            write(2, lkm_msg, str_len(lkm_msg))
            exit(1)
        }
        if emit_mode == 4 {
            uint64 and_msg = "error: --emit=android conflicts with --target=none: android is an OS target, not a bare-metal one\n"
            write(2, and_msg, str_len(and_msg))
            exit(1)
        }
        // Mach-O and PE are OS CONTAINERS, not just byte layouts: a Mach-O
        // image is loaded by dyld through LC_MAIN and its segments are mapped
        // by the macOS kernel; the PE this compiler emits is loaded by the
        // Windows loader, which binds its imports. Before this, `--emit=macho
        // --target=none` exited 0 and wrote a real 8192-byte Mach-O
        // (2048-byte PE) full of bare-metal codegen — a file no macOS and no
        // bare-metal machine can load. Keyed on the resolved emit_mode, not on
        // the spelling, so the aliases (darwin/mac/mac-arm64,
        // win/win-x64/windows-arm64) are covered by the same two checks.
        //
        // THE PE HALF KEPT ITS CHECK AND LOST ITS REASONING (sub-project D,
        // Task 1). It used to say a PE "is an OS container (the Windows
        // loader, an import table, a subsystem field) and nothing on bare
        // metal loads one", and that last clause is simply false: UEFI
        // firmware loads a PE32+ on bare metal on every boot, and the
        // subsystem field is precisely how it tells an EFI application from a
        // Windows one. The REFUSAL is still right, for a narrower and
        // verifiable reason: what --emit=pe emits is a WINDOWS PE. It carries
        // an unconditional kernel32 .idata (verified present in the emitted
        // bytes), and its entry instruction is `call *0xf6e(%rip)` into an IAT
        // slot that only the Windows loader ever fills, so on bare metal it
        // jumps through a null pointer on its first instruction. --emit=uefi
        // is the mode that does not do that, so the message names it.
        if emit_mode == 1 {
            uint64 mo_msg = "error: --emit=macho conflicts with --target=none: a Mach-O image is an OS container (dyld, LC_MAIN, segments mapped by the macOS kernel) and nothing on bare metal loads one; use the default ELF, or --emit=obj for a relocatable object to link yourself\n"
            write(2, mo_msg, str_len(mo_msg))
            exit(1)
        }
        if emit_mode == 2 {
            uint64 pe_msg = "error: --emit=pe conflicts with --target=none: --emit=pe emits a WINDOWS PE -- it imports kernel32 and its entry instruction calls through an import-table slot that only the Windows loader fills, so on bare metal it jumps through a null pointer before your code runs. Firmware does load PE32+ images, so if that is what you want use --emit=uefi; otherwise use the default ELF, or --emit=obj for a relocatable object to link yourself\n"
            write(2, pe_msg, str_len(pe_msg))
            exit(1)
        }
        // --debug inlines a per-OS `exit(1)` trap into every function that
        // indexes an array (IR_ARR_CHECK), dereferences a pointer (the
        // load/store null checks) or does checked arithmetic. Measured: 3
        // syscalls in a --debug bare-metal build against 1 without. The Task
        // 2 emitter guards did catch it, so it never shipped silently — but
        // they reported "SYSCALL reached the emitter from 'array bounds check
        // (--debug)'", which names something that is not a builtin, blames
        // the emitter for a decision made by a flag, and offers no remedy.
        // Worse, it only fired for programs that HAPPEN to use an array or a
        // pointer: an array-free bare-metal program compiled clean under
        // --debug, so the restriction surfaced on whichever function the user
        // wrote next. Refuse here, once, for every program and every arch.
        //
        // This is a refusal and not a lowering because there is nowhere for a
        // failed check to GO on bare metal: no kernel to exit to, no stderr,
        // no debugger. It becomes implementable when a bare-metal panic path
        // exists — a user-supplied @builtin_override panic handler, or a halt
        // the checks can branch to.
        //
        // SUB-PROJECT B2 DID NOT SUPPLY THAT PATH, though it is the obvious
        // place to look now. The emitted entry stub ends in a halt (arm64
        // `b .`, x86_64 `hlt; jmp .`), but it is the RETURN site of the entry
        // function, nothing routes a failed check to it, and it exists only
        // when --stack-top= is passed. A --debug build with no --stack-top
        // would still have nowhere to go, so the refusal stays unconditional.
        if debug_mode != 0 {
            uint64 dbg_msg = "error: --debug conflicts with --target=none: the runtime safety checks inline a per-OS exit(1) trap into every function that indexes an array or dereferences a pointer, and bare metal has no kernel to trap into. Drop --debug until a bare-metal panic path exists.\n"
            write(2, dbg_msg, str_len(dbg_msg))
            exit(1)
        }
        // The legacy backend (src/codegen.kr, src/codegen_aarch64.kr — ~220
        // target_os sites between them) has its own builtin dispatch and does
        // not go through ir_lower_expr at all, so the @builtin_override
        // routing that makes print/println/print_str/println_str work on bare
        // metal is absent there BY CONSTRUCTION. Those four refuse on the
        // legacy path rather than misbehaving, so this is not a correctness
        // hole — it is that `--legacy --target=none` silently selects the
        // strictly less capable of two backends for no gain. Refuse the
        // request instead.
        //
        // Refused even with --emit=obj, where --legacy is redundant (obj
        // always uses the legacy codegen): --legacy is an explicit request
        // for a backend, and under --target=none that request is refused
        // whatever else is on the line. --emit=obj on its own remains
        // ALLOWED — see the note there — so every bare-metal assertion about
        // the legacy codegen still has a live path to run through.
        if emit_ir_mode == 0 {
            uint64 lg_msg = "error: --legacy conflicts with --target=none: the legacy backend has no @builtin_override routing, so print/println/print_str/println_str cannot be provided on bare metal there. Drop --legacy (the IR backend is the default and supports them); --emit=obj still uses the legacy codegen and is still allowed.\n"
            write(2, lg_msg, str_len(lg_msg))
            exit(1)
        }
        // --emit=obj, --emit=asm, --emit=ir and the default --emit=elfexe are
        // all ALLOWED under --target=none, and that is a decision rather than
        // an omission:
        //   obj    — a relocatable object is the normal bare-metal
        //            deliverable (linked with the user's own script at the
        //            user's own load address) and is the only relocatable
        //            output this compiler produces. It is also the surviving
        //            path into the legacy codegen, which is what keeps the
        //            legacy backend's bare-metal guards reachable and tested.
        //   asm/ir — text describing the build. Nothing loads them, and
        //            --emit=ir under --target=none is already the oracle the
        //            provider-routing tests read.
        //   elfexe — the default, and the format --target=none emits.
    }

    // --emit=image (emit_mode 8): sub-project B1's flat-image surface.
    // Every refusal names both flags, matching the block above. These run
    // AFTER the target=none block so --legacy/--debug/-container refusals
    // keep their existing messages when both apply, and BEFORE the fat-binary
    // guard so --targets= cannot route an image build into compile_fat.
    if emit_mode == 8 {
        if target_os != 4 {
            uint64 im_tn = "error: --emit=image requires --target=none: without it the resolved target OS is a hosted one (the default is linux) and the flat blob would contain that OS's syscalls with no kernel behind them\n"
            write(2, im_tn, str_len(im_tn))
            exit(1)
        }
        // No --arch at all: refuse. --emit= sets emit_set, which skips the
        // fat path AND its "pass --arch" refusal, so the arch would
        // silently default to x86_64 — and the arm64 alignment validation
        // below would silently not run (the exact "no --arch at all"
        // entrance that was sub-project A's Task-1 Critical).
        if arch_set == 0 {
            uint64 im_ar = "error: --emit=image requires an explicit --arch=x86_64 or --arch=arm64: --load-addr validation is per-arch (arm64 demands 4096-alignment, x86_64 does not), so a silently defaulted arch would validate against the wrong rule\n"
            write(2, im_ar, str_len(im_ar))
            exit(1)
        }
        if arch == 2 {
            uint64 im_rv = "error: --emit=image is x86_64/arm64 only: --arch=riscv32 --freestanding already emits a raw boot image (entry hoisted to offset 0, sp preamble) and --emit=image would be a second spelling of it with different entry semantics\n"
            write(2, im_rv, str_len(im_rv))
            exit(1)
        }
        if arch == 3 {
            uint64 im_xt = "error: --emit=image is x86_64/arm64 only: xtensa raw emission is --arch=xtensa --freestanding (lx60 boot ELF) or --target=esp32 (esp-image), each with its own entry semantics\n"
            write(2, im_xt, str_len(im_xt))
            exit(1)
        }
        if load_addr_set == 0 {
            uint64 im_la = "error: --emit=image requires --load-addr=<addr>: nothing in a flat image records where it will run -- not even --image-header's Image header, whose text_offset is an offset from the loader's own base and never an absolute address; the value is validated (arm64) and reported, never embedded in the bytes\n"
            write(2, im_la, str_len(im_la))
            exit(1)
        }
        if load_addr == 0 {
            // Zero parses cleanly and is 4096-aligned, but every consumer
            // of the report (and B2's stub) reads 0 as "unset".
            uint64 im_z = "error: --load-addr=0 is refused: a zero load address is indistinguishable from an unset one in every report and boot stub that consumes it\n"
            write(2, im_z, str_len(im_z))
            exit(1)
        }
        if arch == 1 && (load_addr & 4095) != 0 {
            uint64 im_al = "error: --load-addr= must be 4096-aligned on arm64: ADRP page arithmetic is baked at compile time and only survives a page-aligned shift. This constraint is arm64-only -- x86_64 images are RIP-relative and boot at any address\n"
            write(2, im_al, str_len(im_al))
            exit(1)
        }
        if debug_info_mode != 0 {
            uint64 im_g = "error: -g conflicts with --emit=image: the DWARF footer and its section headers would land INSIDE the flat blob at addresses derived from the ELF layout the image does not have. Drop -g, or drop --emit=image to keep the ELF that -g understands\n"
            write(2, im_g, str_len(im_g))
            exit(1)
        }
        // --stack-top= validation (sub-project B2, D4). Only runs when the
        // flag is actually present -- unlike --load-addr=, --stack-top= has
        // no "image requires it" refusal here: the flag's ABSENCE is a
        // legal, meaningful choice (no stub is emitted and the image is a
        // blob for somebody else's loader, which is what sub-project B1
        // shipped), so "unset" must not become an error.
        if stack_top_set != 0 {
            if stack_top == 0 {
                // Zero parses cleanly and passes every alignment/range
                // check below on both arches, but is indistinguishable
                // from "unset" in every report and in both stubs that
                // consume it -- mirrors --load-addr=0's refusal just above.
                uint64 st_z = "error: --stack-top=0 is refused: a zero stack pointer faults on the first push, and is indistinguishable from unset in every report and boot stub that consumes it\n"
                write(2, st_z, str_len(st_z))
                exit(1)
            }
            // Validation is ARCH-ASYMMETRIC (spec D4) and each half is
            // stated separately in its own diagnostic -- a shared message
            // would be wrong on whichever arch it doesn't apply to.
            if arch == 1 {
                // aarch64 faults on the very first SP-relative stack access
                // if SP is not 16-byte aligned -- the same constraint
                // make_stub.py already refuses on. x86_64 has no such rule.
                if (stack_top & 15) != 0 {
                    uint64 st_al = "error: --stack-top= must be 16-byte aligned on arm64: aarch64 faults on the first SP-relative stack access if SP is not 16-byte aligned. This constraint is arm64-only -- x86_64 accepts any alignment\n"
                    write(2, st_al, str_len(st_al))
                    exit(1)
                }
                // The movz/movk pair the stub patches into the entry
                // code covers bits 31:0 only, so anything >= 2^32 cannot be
                // materialized into SP by that pair. x86_64 has its own,
                // different range rule below instead.
                if stack_top >= 4294967296 {
                    uint64 st_rg = "error: --stack-top= must be below 2^32 on arm64: the movz/movk pair the stub patches into the entry code covers bits 31:0 only. This constraint is arm64-only -- x86_64 stacks are bounded by their own range rule instead\n"
                    write(2, st_rg, str_len(st_rg))
                    exit(1)
                }
            }
            if arch == 0 {
                // x86_64 needs its own range rule -- it has no --load-addr
                // constraint beyond != 0 today, so this is new ground.
                // Bound 1: the FIRST PUSH must not land in the boot stub's
                // identity-map page tables, which live at physical
                // 0x1000-0x4000 (PDE 511 of the page directory is the last
                // eight bytes of that range, and it maps the GiB's top 2 MiB).
                //
                // THE BAND IS THE PUSH'S BAND, NOT THE POINTER'S. The stack
                // grows down, so the trampoline's `call *%rax` writes the eight
                // bytes [stack_top-8, stack_top) -- the same +8 convention the
                // stack-vs-image check at finalize uses. Testing the pointer
                // instead of the push, which is what shipped from Task 1 to
                // here, is off by eight at BOTH edges:
                //
                //   * 0x1000 was REFUSED, though its push at [0xFF8, 0x1000)
                //     lands entirely below the tables and harms nothing.
                //   * 0x4000 was ACCEPTED, though its push at [0x3FF8, 0x4000)
                //     overwrites a live PDE with a return address. Latent
                //     corruption of the map the guest is about to run under.
                //
                // [stack_top-8, stack_top) overlaps [0x1000, 0x4000) exactly
                // when stack_top > 0x1000 and stack_top < 0x4008, so those are
                // the bounds. Both are strict: 0x1000 and 0x4008 are the
                // nearest accepted values on either side.
                if stack_top > 4096 && stack_top < 16392 {
                    uint64 st_pt = "error: --stack-top='s first push would land inside 0x1000-0x4000 on x86_64: the boot stub's identity-map page tables live there, the stack grows down, and the first push writes the eight bytes below the stack top. The stack top must be at most 0x1000 or at least 0x4008. This constraint is x86_64-only -- arm64 has no page tables in the flat image\n"
                    write(2, st_pt, str_len(st_pt))
                    exit(1)
                }
                // Bound 2: must be < 2^31. At or above that boundary the
                // assembler widens `mov $imm,%rsp` from the 7-byte sign-
                // extended form to a 10-byte movabs -- moving every later
                // patch site while the file stays 226 bytes (measured).
                if stack_top >= 2147483648 {
                    uint64 st_hi = "error: --stack-top= must be below 0x80000000 on x86_64: at or above 2^31 the assembler widens `mov $imm,%rsp` from a 7-byte sign-extended form to a 10-byte movabs, moving every later patch site while the file size stays fixed. This constraint is x86_64-only -- arm64 is bounded by the movz/movk pair instead\n"
                    write(2, st_hi, str_len(st_hi))
                    exit(1)
                }
                // Bound 3 (B2 Task 4, review I3): the trampoline's identity
                // map is ONE 512-entry page directory of 2 MiB pages, so it
                // covers exactly the first 1 GiB and nothing above it is
                // addressable once paging comes on. A stack top above that
                // faults on the first push, with no handler and no IDT --
                // i.e. a triple fault, not a diagnostic.
                //
                // ORDER MATTERS: this sits AFTER bound 2 deliberately. It is
                // the stricter rule, so putting it first would make bound 2
                // unreachable and change the message a 0x80000000 stack top
                // gets. Both refuse; they refuse for different reasons and
                // each says its own.
                //
                // The bound is inclusive: rsp = 0x40000000 is legal because
                // the stack grows DOWN and the first push lands at
                // 0x3FFFFFF8, inside the map.
                if stack_top > 1073741824 {
                    uint64 st_1g = "error: --stack-top= must be at most 0x40000000 on x86_64: the self-boot trampoline's identity map is a single 512-entry page directory of 2 MiB pages, so it covers exactly the first 1 GiB; a stack above that is unmapped the moment paging is enabled and the first push triple-faults\n"
                    write(2, st_1g, str_len(st_1g))
                    exit(1)
                }
                // --load-addr's own trampoline preconditions. These are
                // gated on --stack-top being present, i.e. on the stub
                // actually being emitted: without it the image is a blob for
                // somebody else's loader (which is what sub-project B1
                // shipped and what the boot gate's x86 legs still use), and
                // refusing an address on the strength of a trampoline that
                // was never emitted would be pure over-reach.
                //
                // Measured at B2 Task 4's BASE: both of the addresses below
                // compiled clean and booted SILENT.
                if load_addr < 16384 {
                    uint64 la_pt = "error: --load-addr= must be at least 0x4000 when --stack-top= asks for the x86_64 self-boot trampoline: the trampoline builds its identity-map page tables at physical 0x1000-0x4000 and zeroes that whole range, so an image loaded there is overwritten by its own boot code before it runs\n"
                    write(2, la_pt, str_len(la_pt))
                    exit(1)
                }
                if load_addr >= 1073741824 {
                    uint64 la_1g = "error: --load-addr= must be below 0x40000000 when --stack-top= asks for the x86_64 self-boot trampoline: the trampoline's identity map is a single 512-entry page directory of 2 MiB pages and covers exactly the first 1 GiB, so an image at or above that address is unmapped the instant paging is enabled\n"
                    write(2, la_1g, str_len(la_1g))
                    exit(1)
                }
            }
        }
        // --image-header (sub-project C). Requires --arch=arm64 (the
        // header being prefixed IS arm64's Linux Image format; x86_64
        // --emit=image already gets its own header -- the multiboot one
        // --stack-top= adds above -- so --image-header on x86_64 has
        // nothing of its own to attach) and --stack-top= (a header on a
        // stub-less image validates under file(1) and is accepted by a
        // loader, but the image has no entry stub to jump to and faults
        // instantly, which would make the header a false claim about the
        // bytes it precedes). Checked after the arch==2/arch==3 refusals
        // above, so arch here is only ever 0 (x86_64) or 1 (arm64).
        if image_header_set != 0 {
            if arch == 0 {
                uint64 ih_a64 = "error: --image-header requires --arch=arm64: the header is arm64's Linux Image format (magic 0x644d5241); x86_64 --emit=image already carries its own header (the multiboot one --stack-top= adds), so --image-header on x86_64 has nothing to attach to\n"
                write(2, ih_a64, str_len(ih_a64))
                exit(1)
            }
            if stack_top_set == 0 {
                uint64 ih_st = "error: --image-header requires --stack-top=: a header on a stub-less image validates under file(1) and is accepted by a loader, but the image has no entry stub to jump to and faults instantly. Pass --stack-top= so the header's claim matches the bytes\n"
                write(2, ih_st, str_len(ih_st))
                exit(1)
            }
        }
    }
    // --emit=uefi (emit_mode 9): sub-project D's UEFI-application surface.
    // Deliberately a SEPARATE block from mode 8's above rather than a widened
    // `emit_mode == 8 || emit_mode == 9` on each row: the two modes agree on
    // three rules and disagree on the rest (mode 9 takes no --load-addr, no
    // --stack-top and no --image-header, and its arch refusals are about a PE
    // Machine value rather than about a raw path each arch already owns), so
    // a shared block would need a per-mode message on nearly every line.
    //
    // EVERY ROW HERE IS A DEFAULT A NEW EMIT MODE INHERITS, not a rule
    // invented for this format. There is no arch_set == 0 refusal, no
    // target_os refusal and no -g refusal anywhere that a mode gets for free;
    // each of the three below was measured silently absent before it was
    // written.
    if emit_mode == 9 {
        // THE else-POSIX DOOR, arriving through the --emit= entrance. The
        // auto-set block above keys on emit_mode 1/2/4 only, so mode 9 leaves
        // target_os at its 0 = linux default and every "special-case Windows/
        // macOS, ELSE fall through to POSIX" dispatch in the tree answers
        // "Linux" for it. CONSTRUCTED, NOT ASSUMED: with this one check
        // disabled in a scratch build, `--arch=x86_64 --emit=uefi` (no
        // --target= on the line) on a program calling print() compiled CLEAN
        // -- exit 0, a 4312-byte artifact, and four x86_64 `syscall`
        // instructions in its payload. Firmware provides no syscalls at all,
        // so that artifact faults on its first write with nothing to report it.
        if target_os != 4 {
            uint64 uf_tn = "error: --emit=uefi requires --target=none: without it the resolved target OS is a hosted one (the default is linux) and the application would carry that OS's syscalls, which UEFI firmware does not provide\n"
            write(2, uf_tn, str_len(uf_tn))
            exit(1)
        }
        // No --arch at all: refuse. --emit= sets emit_set, which skips the fat
        // path AND its "pass --arch" refusal, so the arch would silently
        // default to x86_64 -- and a PE carries the CPU in its Machine field,
        // so a defaulted arch is a header that names a processor nobody asked
        // for, on an artifact whose whole purpose is to be handed to firmware.
        if arch_set == 0 {
            uint64 uf_ar = "error: --emit=uefi requires an explicit --arch=x86_64 or --arch=arm64: a PE header names the CPU in its Machine field, so a silently defaulted arch would produce an application declaring a processor you did not ask for\n"
            write(2, uf_ar, str_len(uf_ar))
            exit(1)
        }
        // riscv32 / xtensa. Each message carries a substring UNIQUE to it --
        // "x86_64/arm64 only" would appear in both, and a defect that routed
        // xtensa to the riscv32 arm would then pass a test grepping the shared
        // half (the trap the --emit=image rows already document).
        if arch == 2 {
            uint64 uf_rv = "error: --emit=uefi is x86_64/arm64 only: there is no PE Machine value for riscv32 in this compiler, and no UEFI firmware target for it here either. Use --arch=riscv32 --freestanding for a raw boot image instead\n"
            write(2, uf_rv, str_len(uf_rv))
            exit(1)
        }
        if arch == 3 {
            uint64 uf_xt = "error: --emit=uefi is x86_64/arm64 only: there is no PE Machine value for xtensa, and the chip has no UEFI firmware. Use --arch=xtensa --freestanding (lx60 boot ELF) or --target=esp32 (esp-image) instead\n"
            write(2, uf_xt, str_len(uf_xt))
            exit(1)
        }
        // -g. Its existing refusal is nested inside `if emit_mode == 8`, so a
        // new mode inherits ACCEPTANCE -- and acceptance here is invisible:
        // measured at BASE, `--emit=pe -g` produces a file BYTE-IDENTICAL to
        // `--emit=pe` (2048 bytes both), i.e. the flag is silently discarded
        // rather than doing something wrong. Refused rather than discarded,
        // for the same reason mode 8 refuses it: the DWARF footer and its
        // section headers are laid out from an ELF geometry this container
        // does not have.
        if debug_info_mode != 0 {
            uint64 uf_g = "error: -g conflicts with --emit=uefi: the DWARF footer and its section headers are laid out from the ELF geometry a PE32+ EFI application does not have, and would land inside the image at addresses nothing maps. Drop -g, or drop --emit=uefi to keep the ELF that -g understands\n"
            write(2, uf_g, str_len(uf_g))
            exit(1)
        }
    }
    if load_addr_set != 0 && emit_mode != 8 {
        uint64 la_im = "error: --load-addr= is only meaningful with --emit=image: hosted containers carry their load address in their own headers\n"
        write(2, la_im, str_len(la_im))
        exit(1)
    }
    if stack_top_set != 0 && emit_mode != 8 {
        uint64 st_im = "error: --stack-top= is only meaningful with --emit=image: hosted containers manage the stack pointer through their own loader, not a flag\n"
        write(2, st_im, str_len(st_im))
        exit(1)
    }
    if image_header_set != 0 && emit_mode != 8 {
        uint64 ih_im = "error: --image-header is only meaningful with --emit=image: it prefixes a flat image with an arm64 boot header, and only --emit=image produces a flat image to prefix\n"
        write(2, ih_im, str_len(ih_im))
        exit(1)
    }

    // arch x OS validation. This runs AFTER the emit_mode -> target_os
    // auto-set above, on the RESOLVED pair, so `--arch=riscv32 --emit=pe`
    // (which asks for Windows without ever typing --target=) is caught by the
    // same check as `--arch=riscv32 --target=windows`. Names both flags with
    // the spellings a user types, so the message can be edited back into a
    // working command line.
    if arch_os_pair_supported(arch, target_os) == 0 {
        uint64 xo_a = arch_flag_name(arch)
        uint64 xo_o = target_os_flag_name(target_os)
        uint64 xo1 = "error: --arch="
        write(2, xo1, str_len(xo1))
        write(2, xo_a, str_len(xo_a))
        uint64 xo2 = " --target="
        write(2, xo2, str_len(xo2))
        write(2, xo_o, str_len(xo_o))
        uint64 xo3 = " is not a supported target pair: x86_64 and arm64 build for linux, macos, windows, android or none; riscv32 and xtensa build for linux or none. (--emit=macho and --emit=pe select macos and windows even when --target= is absent.)\n"
        write(2, xo3, str_len(xo3))
        exit(1)
    }

    // --target=esp32 is only meaningful on the xtensa freestanding ELF path
    // (arch 3, emit_mode 0). Any other combination is a hard error — loud-fail
    // over silently emitting a qemu-lx60-shaped image that cannot boot on the
    // chip: loud-fail rather than silently emit the wrong thing.
    if machine_target == 1 {
        if arch != 3 || freestanding == 0 || emit_mode != 0 {
            uint64 esp_tgt_msg = "error: --target=esp32 requires --arch=xtensa --freestanding\n"
            write(2, esp_tgt_msg, str_len(esp_tgt_msg))
            exit(1)
        }
        // ESP32 initial SP: top of the DRAM window, 16-byte aligned,
        // instead of the qemu-lx60 stack top. Assigned BEFORE codegen so the
        // entry preamble's pre-scan interns the right pool literal.
        XT_STACK_TOP = XT_ESP32_STACK_TOP
        // Gate the entry-stub additions (Task 4: WDT disable + PS pin + park
        // self-branch) in ir_xtensa.kr — it precedes main.kr in the concat
        // build so it cannot read machine_target itself.
        xt_esp32_target = 1
    }

    // Derive output name from input if not specified with -o
    if str_eq_full(output_path, "a.krbo") != 0 && input_path != 0 {
        uint64 ilen = str_len(input_path)
        // Strip .kr extension if present, then add appropriate extension
        uint64 base_len = ilen
        if ilen > 3 {
            uint64 dp = input_path + ilen - 3
            uint64 d0 = 0; uint64 d1 = 0; uint64 d2 = 0
            unsafe { *(dp as uint8) -> d0 }
            uint64 dp1 = dp + 1; unsafe { *(dp1 as uint8) -> d1 }
            uint64 dp2 = dp + 2; unsafe { *(dp2 as uint8) -> d2 }
            if d0 == 46 && d1 == 107 && d2 == 114 { base_len = ilen - 3 }
        }
        if emit_mode == 3 {
            // Object file: input.kr → input.o
            uint64 out = alloc(base_len + 3)
            memcpy(out, input_path, base_len)
            uint64 ep = out + base_len
            uint8 e0 = 46; uint8 e1 = 111
            unsafe { *(ep as uint8) = e0 }
            uint64 ep1 = ep + 1; unsafe { *(ep1 as uint8) = e1 }
            uint64 ep2 = ep + 2; uint8 z = 0
            unsafe { *(ep2 as uint8) = z }
            output_path = out
        } else if emit_mode == 2 {
            // PE: input.kr → input.exe
            uint64 out = alloc(base_len + 5)
            memcpy(out, input_path, base_len)
            uint64 ep = out + base_len
            uint8 e0 = 46; uint8 e1 = 101; uint8 e2 = 120; uint8 e3 = 101
            unsafe { *(ep as uint8) = e0 }
            uint64 ep1 = ep + 1; unsafe { *(ep1 as uint8) = e1 }
            uint64 ep2 = ep + 2; unsafe { *(ep2 as uint8) = e2 }
            uint64 ep3 = ep + 3; unsafe { *(ep3 as uint8) = e3 }
            uint64 ep4 = ep + 4; uint8 z = 0
            unsafe { *(ep4 as uint8) = z }
            output_path = out
        } else if arch_set != 0 || emit_set != 0 {
            // Single arch: input.kr → input (no extension, native binary)
            uint64 out = alloc(base_len + 1)
            memcpy(out, input_path, base_len)
            uint64 tp = out + base_len
            uint8 z = 0
            unsafe { *(tp as uint8) = z }
            output_path = out
        } else {
            // Fat binary: input.kr → input.krbo
            uint64 out = alloc(base_len + 6)
            memcpy(out, input_path, base_len)
            uint64 ep = out + base_len
            uint8 e0 = 46; uint8 e1 = 107; uint8 e2 = 114; uint8 e3 = 98; uint8 e4 = 111
            unsafe { *(ep as uint8) = e0 }
            uint64 ep1 = ep + 1; unsafe { *(ep1 as uint8) = e1 }
            uint64 ep2 = ep + 2; unsafe { *(ep2 as uint8) = e2 }
            uint64 ep3 = ep + 3; unsafe { *(ep3 as uint8) = e3 }
            uint64 ep4 = ep + 4; unsafe { *(ep4 as uint8) = e4 }
            uint64 ep5 = ep + 5; uint8 z = 0
            unsafe { *(ep5 as uint8) = z }
            output_path = out
        }
    }

    // --list-proposals doesn't need an input file
    if lc_list_proposals != 0 && input_path == 0 {
        init_proposals()
        load_proposal_overrides()
        list_proposals()
        exit(0)
    }

    // --promote / --deprecate / --reject: governance commands, no input file
    if lc_promote_name != 0 && input_path == 0 {
        init_proposals()
        load_proposal_overrides()
        promote_proposal(lc_promote_name)
        exit(0)
    }
    if lc_deprecate_name != 0 && input_path == 0 {
        init_proposals()
        load_proposal_overrides()
        deprecate_proposal(lc_deprecate_name)
        exit(0)
    }
    if lc_reject_name != 0 && input_path == 0 {
        init_proposals()
        load_proposal_overrides()
        reject_proposal(lc_reject_name)
        exit(0)
    }

    if input_path == 0 {
        if cli_argc > 0 {
            write(2, "krc: no input file\n\n", 20)
            write(2, "usage: krc [options] <file.kr> [-o output]\n", 43)
            write(2, "run 'krc --help' for the full list of options and commands.\n", 60)
            exit(0)
        }
        input_path = "test_input.kr"
    }

    if mode == 1 {
        import_init()
    import_check_file(input_path)
        import_process(input_path)
        uint64 source = import_buf
        uint64 size = import_buf_len
        uint64 max_tok = 524288
        uint64 my_tokens = alloc(max_tok * 16)
        lexer_init(source, size, my_tokens, max_tok)
        uint64 tcount = lexer_run()
        ast_init(524288)
        codegen_init(1048576, source, my_tokens)
        parser_init(my_tokens, tcount)
        uint64 root = parse_module()
        // run_analysis runs the annotation/effect/lock passes. These are
        // currently inert: annotations are not parsed yet, so ann_register
        // and lock_add_edge have no callers and the tables stay empty (M13).
        // The genuinely-working checks — missing return, arg count, unused/
        // unreachable code, undeclared identifiers — live in
        // run_semantic_checks, the same pass a normal compile runs. Without
        // it, `krc check` reported "OK" for every file. Run both and report
        // the detailed diagnostics.
        uint64 errors = run_analysis(root)
        uint64 sema_errs = run_semantic_checks(root, source, my_tokens)
        // Mirror the compile path: resolve inferred `let` types, then run the
        // (now-fatal) type checker, so `krc check` — and the VS Code LSP that
        // shells out to it — surface the same struct-field / return-type /
        // call-arg type errors a real build would, not just the sema checks.
        resolve_inferred_types(root)
        uint64 pre_tc = diag_error_count
        if check_types_enabled != 0 {
            tc_check_module(root)
        }
        uint64 tc_errs = diag_error_count - pre_tc
        diag_report_all()
        errors = errors + sema_errs + tc_errs
        if errors > 0 {
            uint8[32] nb
            write(2, "\nkrc: ", 6)
            uint64 nl = fmt_uint(nb, errors)
            write(2, nb, nl)
            write(2, " error(s) found in ", 19)
            write(2, input_path, str_len(input_path))
            write(2, "\n", 1)
            exit(1)
        }
        write(1, "krc check: ", 11)
        write(1, input_path, str_len(input_path))
        write(1, " - OK\n", 6)
        exit(0)
    }

    if mode == 2 {
        // --list-proposals: print the governance-layer proposal registry
        if lc_list_proposals != 0 {
            init_proposals()
            load_proposal_overrides()
            list_proposals()
            exit(0)
        }
        // --fix mode: run the migration engine on the input file
        if lc_fix_mode != 0 {
            run_migration(input_path, lc_dry_run)
            exit(0)
        }
        import_init()
    import_check_file(input_path)
        import_process(input_path)
        uint64 source = import_buf
        uint64 size = import_buf_len
        uint64 max_tok = 524288
        uint64 my_tokens = alloc(max_tok * 16)
        lexer_init(source, size, my_tokens, max_tok)
        uint64 tcount = lexer_run()
        ast_init(524288)
        codegen_init(1048576, source, my_tokens)
        parser_init(my_tokens, tcount)
        uint64 root = parse_module()
        // Run analysis first to populate lock graph
        analysis_init()
        uint64 tel = collect_telemetry(root)
        uint64 patterns = detect_patterns(root, tel)
        uint64 cycles = check_lock_cycles()
        uint64 fitness = compute_fitness(tel, patterns, cycles)
        init_proposals()
        load_proposal_overrides()
        detect_proposals(tel)
        if lc_min_fitness > 0 {
            print_living_report_filtered(tel, patterns, fitness, lc_min_fitness)
        } else {
            print_living_report(tel, patterns, fitness)
        }
        print_firing_proposals()
        if lc_ci_mode != 0 {
            uint64 gate_threshold = lc_min_fitness
            if gate_threshold == 0 { gate_threshold = 50 }
            if lc_check_ci_gate(gate_threshold) != 0 {
                exit(1)
            }
        }
        exit(0)
    }

    if mode == 3 {
        fmt_file(input_path)
        exit(0)
    }

    // Default: produce fat binary unless --arch or --emit specified.
    // On Windows / macOS: default to the host's native format so that
    // `krc hello.kr` just works without flags. The user can still
    // explicitly request a fat binary with `krc hello.kr -o hello.krbo`
    // via --emit=... if they want cross-platform output.
    // --targets=<list> always forces fat-binary emission (custom slice set).
    // Fat binaries carry only x86_64/arm64 slices — combining --targets
    // with --arch=riscv32 would silently drop the requested arch, so
    // refuse instead of misrouting into compile_fat.
    if arch == 2 && target_mask != 0 {
        uint64 tmsg = "error: fat binaries (--targets) have no riscv32 slice; use --arch=riscv32 without --targets\n"
        write(2, tmsg, str_len(tmsg))
        exit(1)
    }
    if arch == 3 && target_mask != 0 {
        uint64 xtmsg = "error: fat binaries (--targets) have no xtensa slice; use --arch=xtensa without --targets\n"
        write(2, xtmsg, str_len(xtmsg))
        exit(1)
    }
    if target_mask != 0 || (arch_set == 0 && emit_set == 0 && cli_argc > 0) {
        // --target=none must never reach compile_fat, from ANY entrance
        // (no --arch given at all, or an explicit --targets=<list> that
        // does not happen to spell "none" as one of its elements — the
        // :3495 refusal above only catches the latter spelling). Checked
        // here, at the single point that actually decides fat-vs-single,
        // rather than per-entrance: freestanding is a static global, and
        // compile_fat compiles all 8 hosted slices in one process without
        // resetting it between them, so a bare-metal build's freestanding=1
        // would strip startup/exit from every hosted slice — a fat binary
        // that builds cleanly (exit 0, no diagnostic) and crashes at
        // runtime on every architecture.
        if target_os == 4 {
            uint64 tnf_msg = "error: --target=none cannot build a fat binary: pass --arch=<arch> for a single bare-metal binary (a fat binary bundles 8 hosted OS slices and there is no OS here to run any of them)\n"
            write(2, tnf_msg, str_len(tnf_msg))
            exit(1)
        }
        compile_fat(input_path, output_path)
    } else {
        compile(input_path, output_path, arch, emit_mode)
    }
    exit(0)
}
