// KernRift self-hosted compiler — Lexer (Tokenizer)
//
// Converts source text (uint8 bytes) into a flat token array.
// Each token is 16 bytes:
//   [0..4)   kind  (uint32, see TokenKind enum)
//   [4..8)   start (uint32, byte offset in source)
//   [8..12)  len   (uint32, byte length of token text)
//   [12..16) line  (uint32, 1-based line number)

// ---------------------------------------------------------------------------
// Token kinds
// ---------------------------------------------------------------------------

enum TokenKind {
    Eof = 0
    Ident = 1
    IntLit = 2
    StrLit = 3
    CharLit = 4
    FloatLit = 5

    // Punctuation
    LParen = 10
    RParen = 11
    LBrace = 12
    RBrace = 13
    LBracket = 14
    RBracket = 15
    Comma = 16
    Dot = 17
    Semicolon = 18
    Colon = 19
    Arrow = 20
    At = 21
    Star = 22
    Ampersand = 23
    Pipe = 24
    Caret = 25
    Tilde = 26
    Bang = 27
    Question = 28

    // Operators
    Plus = 30
    Minus = 31
    Slash = 32
    Percent = 33
    Eq = 34
    EqEq = 35
    BangEq = 36
    Lt = 37
    LtEq = 38
    Gt = 39
    GtEq = 40
    AmpAmp = 41
    PipePipe = 42
    LtLt = 43
    GtGt = 44
    PlusEq = 45
    MinusEq = 46
    StarEq = 47
    SlashEq = 48
    PercentEq = 49
    AmpEq = 50
    PipeEq = 51
    CaretEq = 52
    LtLtEq = 53
    GtGtEq = 54

    // Keywords
    KwFn = 60
    KwReturn = 61
    KwIf = 62
    KwElse = 63
    KwWhile = 64
    KwFor = 65
    KwIn = 66
    KwBreak = 67
    KwContinue = 68
    KwLoop = 69
    KwDefer = 79
    KwConst = 70
    KwStatic = 71
    KwStruct = 72
    KwEnum = 73
    KwExtern = 74
    KwImport = 75
    KwUnsafe = 76
    KwTrue = 77
    KwFalse = 78

    // Type keywords
    KwUint8 = 80
    KwUint16 = 81
    KwUint32 = 82
    KwUint64 = 83
    KwInt8 = 84
    KwInt16 = 85
    KwInt32 = 86
    KwInt64 = 87

    // Extended keywords
    KwMatch = 88
    KwType = 89
    FatArrow = 29    // =>
    KwAsm = 90
    KwVolatile = 91
    KwDevice = 92
    KwAt = 93

    // Float type keywords
    KwFloat16 = 94
    KwFloat32 = 95
    KwFloat64 = 96
    KwSizeof = 97
    KwBool = 98
    KwChar = 99

    // F-string tokens
    FStrBegin = 100
    StrPart = 101
    FStrEnd = 102

    // `let` — type-inferred local declaration (`let x = expr`)
    KwLet = 103

    // Error
    Error = 255
}

// ---------------------------------------------------------------------------
// Lexer state (static globals)
// ---------------------------------------------------------------------------

static uint64 src_ptr = 0       // pointer to source bytes
static uint64 src_len = 0       // source length
static uint64 pos = 0           // current byte position
static uint64 line = 1          // current line number

static uint64 tok_buf = 0       // pointer to token output buffer
static uint64 tok_count = 0     // number of tokens emitted
static uint64 tok_capacity = 0  // max tokens in buffer

// Language profile (versioned surface layer from the Living Compiler blueprint)
// 0 = stable  — default; production-safe features only
// 1 = experimental — allows features under active development
static uint64 lang_profile = 0

// ---------------------------------------------------------------------------
// Lexer API
// ---------------------------------------------------------------------------

@export
fn lexer_init(uint64 source, uint64 length, uint64 tokens, uint64 capacity) {
    src_ptr = source
    src_len = length
    pos = 0
    line = 1
    tok_buf = tokens
    tok_count = 0
    tok_capacity = capacity
    lang_profile = 0
}

// `#lang <profile>` -- an optional directive on the FIRST line of a file.
// Recognized forms:
//   #lang stable
//   #lang experimental
// An unknown profile name is ignored (forward-compat with future profiles).
//
// THE LEXER AND THE IMPORT SCANNER BOTH CALL lang_directive_end, so they agree
// on what the line is. They did not: the lexer skipped `#lang` only at byte 0
// of the whole buffer, while import_process() stopped its leading-import scan
// at the `#`. So `#lang stable` followed by `import "nonexistent.kr"` compiled
// clean -- the import was never read -- and a `#lang` line at the top of any
// imported file did the same to that file's imports. Now the directive is
// accepted as the first line of EVERY file (at its first byte, after the
// optional BOM check below), skipped by both readers, and only the file named
// on the command line sets the profile.
//
// Returns the offset just past a directive line (its CR, LF or CRLF included)
// that starts at buf[off], or `off` itself when none does. "#lang" is matched as
// a 5-byte prefix and the rest of the line is the profile name.
fn lang_directive_end(uint64 buf, uint64 size, uint64 off) -> uint64 {
    if off + 6 > size { return off }
    uint64 p0 = buf + off
    uint64 c0 = 0
    unsafe { *(p0 as uint8) -> c0 }
    if c0 != 35 { return off }  // '#'
    uint64 p1 = buf + off + 1
    uint64 c1 = 0
    unsafe { *(p1 as uint8) -> c1 }
    uint64 p2 = buf + off + 2
    uint64 c2 = 0
    unsafe { *(p2 as uint8) -> c2 }
    uint64 p3 = buf + off + 3
    uint64 c3 = 0
    unsafe { *(p3 as uint8) -> c3 }
    uint64 p4 = buf + off + 4
    uint64 c4 = 0
    unsafe { *(p4 as uint8) -> c4 }
    if c1 != 108 { return off }  // 'l'
    if c2 != 97 { return off }   // 'a'
    if c3 != 110 { return off }  // 'n'
    if c4 != 103 { return off }  // 'g'
    uint64 dp = off + 5
    while dp < size {
        uint64 pe = buf + dp
        uint64 ce = 0
        unsafe { *(pe as uint8) -> ce }
        if ce == 10 || ce == 13 { break }
        dp = dp + 1
    }
    if dp < size {
        uint64 pt = buf + dp
        uint64 ct = 0
        unsafe { *(pt as uint8) -> ct }
        dp = dp + 1
        if ct == 13 && dp < size {
            uint64 pt2 = buf + dp
            uint64 ct2 = 0
            unsafe { *(pt2 as uint8) -> ct2 }
            if ct2 == 10 { dp = dp + 1 }
        }
    }
    return dp
}

// 1 if buf[off..] starts with a UTF-8 byte-order mark (EF BB BF).
//
// A BOM IS REFUSED, NOT SKIPPED, in the lexer and the import scanner alike. It
// used to reach the import scanner as three bytes that are not `import`, which
// ended the leading run, so a BOM-prefixed file had its imports dropped and was
// then told "`import` must precede every declaration" about a line that was
// first in the file. Refusing it with its own message keeps every reader of a
// file on the same bytes; the fix for the user is one editor setting.
fn utf8_bom_at(uint64 buf, uint64 size, uint64 off) -> uint64 {
    if off + 3 > size { return 0 }
    uint64 b0p = buf + off
    uint64 b0 = 0
    unsafe { *(b0p as uint8) -> b0 }
    uint64 b1p = buf + off + 1
    uint64 b1 = 0
    unsafe { *(b1p as uint8) -> b1 }
    uint64 b2p = buf + off + 2
    uint64 b2 = 0
    unsafe { *(b2p as uint8) -> b2 }
    if b0 == 239 && b1 == 187 && b2 == 191 { return 1 }
    return 0
}

// Called with pos at the first byte of a file. Refuses a BOM, then skips a
// `#lang` line; set_profile says whether this file's directive sets the
// profile (only the top-level file's does).
fn lexer_file_start(uint64 set_profile) {
    if utf8_bom_at(src_ptr, src_len, pos) != 0 {
        lex_report(pos, line, "this file starts with a UTF-8 byte-order mark (bytes EF BB BF), which is not accepted; save it as UTF-8 without a BOM", 0, 0, 0)
        pos = pos + 3
        return
    }
    uint64 end = lang_directive_end(src_ptr, src_len, pos)
    if end == pos { return }
    if set_profile != 0 {
        // The profile name: after "#lang" and its blanks, up to the line end,
        // trailing blanks trimmed.
        uint64 ns = pos + 5
        while ns < end && (peek_at(ns - pos) == 32 || peek_at(ns - pos) == 9) {
            ns = ns + 1
        }
        uint64 ne = ns
        while ne < end && peek_at(ne - pos) != 10 && peek_at(ne - pos) != 13 {
            ne = ne + 1
        }
        while ne > ns && (peek_at(ne - 1 - pos) == 32 || peek_at(ne - 1 - pos) == 9) {
            ne = ne - 1
        }
        uint64 nl = ne - ns
        uint64 n0 = peek_at(ns - pos)
        if nl == 6 && n0 == 115 { lang_profile = 0 }   // 'stable' (starts with 's')
        if nl == 12 && n0 == 101 { lang_profile = 1 }  // 'experimental'
    }
    // advance() counts the LF; a bare-CR line end is counted here.
    uint64 last = peek_at(end - 1 - pos)
    while pos < end { advance() }
    if last == 13 { line = line + 1 }
}

@export
fn get_lang_profile() -> uint64 {
    return lang_profile
}

// Lexical errors (an unterminated literal, a malformed number) are reported as
// they are found and counted here; lexer_run refuses the compile once the whole
// buffer has been scanned, so every one of them is reported, not just the first.
static uint64 lex_err_count = 0

// ONE FILE AT A TIME, even though the buffer holds every imported file.
//
// import_process() concatenates each module into import_buf and records where
// each one starts in srcmap_table. Lexed as one run, an unterminated string or
// character literal at the end of an imported file did not stop at that file:
// it ran on into the NEXT file, swallowed the importer's code up to the next
// quote, and the error -- if one came at all -- was reported against the
// importer, at a line that had nothing wrong with it.
//
// So when the buffer being lexed is import_buf, src_len is clamped to the end
// of the current file for the whole time that file is lexed. No scanner can
// read past it (peek/peek_at/advance all stop at src_len), and a literal still
// open at the clamp is reported as unterminated at its own file:line:col. Line
// numbers keep counting across files exactly as before, so the token stream of
// a well-formed program is byte-for-byte what it was. Any other buffer (the
// living compiler lexing a single file, a re-lex of kernel source) is a single
// file already and is lexed whole.
@export
fn lexer_run() -> uint64 {
    lex_err_count = 0
    uint64 full_len = src_len
    if src_ptr == import_buf && srcmap_count > 0 {
        uint64 si = 0
        while si < srcmap_count {
            uint64 seg_end = full_len
            if si + 1 < srcmap_count {
                uint64 nxt = srcmap_table + (si + 1) * 16
                unsafe { *(nxt as uint64) -> seg_end }
            }
            if seg_end > full_len { seg_end = full_len }
            src_len = seg_end
            // Each file's own first line may be `#lang`; the LAST file is the
            // one named on the command line (import_process appends a file
            // after everything it imports), so it alone sets the profile.
            uint64 top_file = 0
            if si + 1 == srcmap_count { top_file = 1 }
            lexer_file_start(top_file)
            while pos < src_len {
                skip_whitespace_and_comments()
                if pos < src_len {
                    lex_one_token()
                }
            }
            si = si + 1
        }
        src_len = full_len
    }
    if pos == 0 { lexer_file_start(1) }
    while pos < src_len {
        skip_whitespace_and_comments()
        // Check again after skipping (avoid break-in-if)
        if pos < src_len {
            lex_one_token()
        }
    }
    // Emit EOF token
    emit_token(TokenKind.Eof, pos, 0, line)
    if lex_err_count > 0 {
        uint8[24] nb
        // lex_report prints the first 20; say how many it held back rather
        // than stopping in silence.
        if lex_err_count > 20 {
            write(2, "(", 1)
            uint64 nh = fmt_uint(nb, lex_err_count - 20)
            write(2, nb, nh)
            write(2, " more errors not shown)\n", 24)
        }
        uint64 nl = fmt_uint(nb, lex_err_count)
        write(2, nb, nl)
        write(2, " lex error(s)\n", 14)
        fatal_exit()
    }
    return tok_count
}

// "file:line:col: error: <msg_a>[<quoted text><msg_b>]". The location is the
// byte `start` (the opening quote of an unterminated literal, the first digit
// of a malformed number). In import_buf the file and line come from the
// source map, so an error in an imported file names THAT file; elsewhere the
// buffer is a single file and only line:col is known.
fn lex_report(uint64 start, uint64 tok_line, uint64 msg_a, uint64 txt, uint64 txt_len, uint64 msg_b) {
    lex_err_count = lex_err_count + 1
    if lex_err_count > 20 { return }
    uint64 l = tok_line
    if src_ptr == import_buf && srcmap_count > 0 {
        uint64 fp = srcmap_file(start)
        if fp != 0 {
            write(2, fp, str_len(fp))
            write(2, ":", 1)
        }
        l = srcmap_line(start)
    }
    uint64 ls = start
    while ls > 0 {
        uint64 pb = src_ptr + ls - 1
        uint64 cb = 0
        unsafe { *(pb as uint8) -> cb }
        if cb == 10 { break }
        ls = ls - 1
    }
    uint8[24] nb
    uint64 n1 = fmt_uint(nb, l)
    write(2, nb, n1)
    write(2, ":", 1)
    uint64 n2 = fmt_uint(nb, start - ls + 1)
    write(2, nb, n2)
    write(2, ": error: ", 9)
    write(2, msg_a, str_len(msg_a))
    if txt_len != 0 {
        write(2, "'", 1)
        write(2, txt, txt_len)
        write(2, "'", 1)
        write(2, msg_b, str_len(msg_b))
    }
    write(2, "\n", 1)
}

// A number must END where its digits end. Called with pos just past a complete
// literal (digits, separators, fraction, exponent, `f` suffix). If what follows
// is a letter, a digit or a quote, the two were glued together -- `5x`,
// `0b1012`, `1_f"x"`, `10.5fx` -- and the old reading (a number followed by an
// identifier, or by an f-string) was never what anyone wrote. The whole run is
// consumed and reported as one malformed literal; returns 1 if it was.
fn lex_number_glued(uint64 start, uint64 tok_line) -> uint64 {
    if pos >= src_len { return 0 }
    uint64 nc = peek()
    if is_alnum(nc) == 0 && nc != 34 && nc != 39 { return 0 }
    while pos < src_len && is_alnum(peek()) != 0 {
        advance()
    }
    lex_report(start, tok_line, "malformed number literal ", src_ptr + start, pos - start,
               ": a number must not be followed directly by a letter, a stray digit or a quote")
    emit_token(TokenKind.Error, start, pos - start, tok_line)
    return 1
}

fn is_hex_digit(uint64 c) -> uint64 {
    if c >= 48 && c <= 57 { return 1 }
    if c >= 97 && c <= 102 { return 1 }
    if c >= 65 && c <= 70 { return 1 }
    return 0
}

// One escape inside a string, character or f-string literal; pos is at the
// backslash. Consumes the backslash and the byte after it -- exactly what the
// three scanners always did, so where a literal ENDS never changes -- and
// refuses an escape that is not in the grammar's char_escape set.
//
// The decoders behind the lexer (the string lowering in three backends,
// fstr_part_bake, parse_int_token for characters) never checked: `\x` took the
// next two bytes whatever they were, so "\x4]" was one byte made from '4' and
// ']' (the bracket vanished), and a `\x` with fewer than two bytes left before
// the closing quote fell through to the generic path and printed "x4". An
// unknown letter (`\q`, `\u{41}`) silently became the letter. Each is now a
// lexical error at the backslash.
//
// Valid: \n \t \r \0 \\ \' \" \a \b \f \v \e, and \x followed by exactly two
// hex digits. In an f-string \{ and \} are also accepted (each is its brace,
// as fstr_part_bake documents). Only a VALID \x consumes its two digits; after
// an invalid one the scan resumes at the byte after the `x`, so a closing
// quote straight after `\x4` still closes the literal.
fn lex_escape(uint64 is_fstr) {
    uint64 bs = pos
    uint64 bs_line = line
    advance()                                   // the backslash
    if pos >= src_len { return }                // unterminated: the caller reports it
    uint64 e = peek()
    if e == 120 {
        advance()                               // 'x'
        if is_hex_digit(peek()) != 0 && pos + 1 < src_len && is_hex_digit(peek_at(1)) != 0 {
            advance()
            advance()
            return
        }
        uint64 shown = 2
        if is_hex_digit(peek()) != 0 { shown = 3 }
        lex_report(bs, bs_line, "invalid escape ", src_ptr + bs, shown,
                   ": \\x must be followed by exactly two hex digits (0-9, a-f, A-F), as in \\x41")
        return
    }
    uint64 ok = 0
    if e == 110 || e == 116 || e == 114 || e == 48 || e == 92 || e == 39 || e == 34 { ok = 1 }
    if e == 97 || e == 98 || e == 102 || e == 118 || e == 101 { ok = 1 }
    if is_fstr != 0 && (e == 123 || e == 125) { ok = 1 }
    if ok == 0 {
        uint64 shown2 = 2
        if e == 10 || e == 13 { shown2 = 1 }
        lex_report(bs, bs_line, "invalid escape ", src_ptr + bs, shown2,
                   ": the escapes are \\n \\t \\r \\0 \\\\ \\' \\\" \\a \\b \\f \\v \\e and \\xHH (two hex digits)")
    }
    advance()                                   // the escaped byte
}

@export
fn lexer_token_count() -> uint64 {
    return tok_count
}

// ---------------------------------------------------------------------------
// Internal helpers
// ---------------------------------------------------------------------------

fn peek() -> uint64 {
    if pos >= src_len { return 0 }
    uint64 ptr_addr = src_ptr + pos
    uint64 result = 0
    unsafe { *(ptr_addr as uint8) -> result }
    return result & 0xFF
}

fn advance() -> uint64 {
    uint64 ch = peek()
    if ch == 10 { line = line + 1 }
    pos = pos + 1
    return ch
}

fn peek_at(uint64 offset) -> uint64 {
    uint64 idx = pos + offset
    if idx >= src_len { return 0 }
    uint64 ptr_addr = src_ptr + idx
    uint64 result = 0
    unsafe { *(ptr_addr as uint8) -> result }
    return result & 0xFF
}

fn emit_token(uint64 kind, uint64 start, uint64 len, uint64 tok_line) {
    if tok_count >= tok_capacity {
        // Fatal, never silent: a dropped token (incl. the final Eof) would
        // truncate the program and "successfully" compile a different one —
        // catastrophic for a compiler that must self-compile bit-identically.
        write(2, "error: too many tokens (lexer buffer full)\n", 43)
        fatal_exit()
    }
    uint64 base = tok_count * 16
    uint64 buf = tok_buf
    // Write kind (4 bytes LE)
    uint64 a0 = buf + base
    unsafe { *(a0 as uint32) = kind }
    // Write start (4 bytes LE)
    uint64 a1 = buf + base + 4
    uint32 s32 = start
    unsafe { *(a1 as uint32) = s32 }
    // Write len (4 bytes LE)
    uint64 a2 = buf + base + 8
    uint32 l32 = len
    unsafe { *(a2 as uint32) = l32 }
    // Write line (4 bytes LE)
    uint64 a3 = buf + base + 12
    unsafe { *(a3 as uint32) = tok_line }
    tok_count = tok_count + 1
}

fn skip_whitespace_and_comments() {
    uint64 done = 0
    while pos < src_len && done == 0 {
        uint64 ch = peek()
        uint64 handled = 0
        // Whitespace: space, tab, CR, LF
        if ch == 32 || ch == 9 || ch == 13 || ch == 10 {
            advance()
            handled = 1
        }
        // Line comment: //
        if handled == 0 && ch == 47 && peek_at(1) == 47 {
            // Skip to end of line
            while pos < src_len && peek() != 10 {
                advance()
            }
            if pos < src_len { advance() }
            handled = 1
        }
        if handled == 0 {
            done = 1
        }
    }
}

fn is_alpha(uint64 ch) -> uint64 {
    if ch >= 65 && ch <= 90 { return 1 }
    if ch >= 97 && ch <= 122 { return 1 }
    if ch == 95 { return 1 }
    return 0
}

fn is_digit(uint64 ch) -> uint64 {
    if ch >= 48 && ch <= 57 { return 1 }
    return 0
}

fn is_alnum(uint64 ch) -> uint64 {
    if is_alpha(ch) != 0 { return 1 }
    if is_digit(ch) != 0 { return 1 }
    return 0
}

// Check if source[start..start+len] equals a keyword string
fn match_keyword(uint64 start, uint64 len, uint64 kw_ptr, uint64 kw_len) -> uint64 {
    if len != kw_len { return 0 }
    uint64 i = 0
    while i < len {
        uint64 sa = src_ptr + start + i
        uint64 sc = 0
        unsafe { *(sa as uint8) -> sc }
        uint64 ka = kw_ptr + i
        uint64 kc = 0
        unsafe { *(ka as uint8) -> kc }
        if sc != kc { return 0 }
        i = i + 1
    }
    return 1
}

fn classify_keyword(uint64 start, uint64 len) -> uint32 {
    // Check each keyword
    if match_keyword(start, len, "fn", 2) != 0 { return TokenKind.KwFn }
    if match_keyword(start, len, "return", 6) != 0 { return TokenKind.KwReturn }
    if match_keyword(start, len, "if", 2) != 0 { return TokenKind.KwIf }
    if match_keyword(start, len, "else", 4) != 0 { return TokenKind.KwElse }
    if match_keyword(start, len, "while", 5) != 0 { return TokenKind.KwWhile }
    if match_keyword(start, len, "for", 3) != 0 { return TokenKind.KwFor }
    if match_keyword(start, len, "in", 2) != 0 { return TokenKind.KwIn }
    if match_keyword(start, len, "break", 5) != 0 { return TokenKind.KwBreak }
    if match_keyword(start, len, "continue", 8) != 0 { return TokenKind.KwContinue }
    if match_keyword(start, len, "loop", 4) != 0 { return TokenKind.KwLoop }
    if match_keyword(start, len, "defer", 5) != 0 { return TokenKind.KwDefer }
    if match_keyword(start, len, "const", 5) != 0 { return TokenKind.KwConst }
    if match_keyword(start, len, "static", 6) != 0 { return TokenKind.KwStatic }
    if match_keyword(start, len, "struct", 6) != 0 { return TokenKind.KwStruct }
    if match_keyword(start, len, "enum", 4) != 0 { return TokenKind.KwEnum }
    if match_keyword(start, len, "extern", 6) != 0 { return TokenKind.KwExtern }
    if match_keyword(start, len, "import", 6) != 0 { return TokenKind.KwImport }
    if match_keyword(start, len, "unsafe", 6) != 0 { return TokenKind.KwUnsafe }
    if match_keyword(start, len, "true", 4) != 0 { return TokenKind.KwTrue }
    if match_keyword(start, len, "false", 5) != 0 { return TokenKind.KwFalse }
    if match_keyword(start, len, "match", 5) != 0 { return TokenKind.KwMatch }
    if match_keyword(start, len, "let", 3) != 0 { return TokenKind.KwLet }
    if match_keyword(start, len, "type", 4) != 0 { return TokenKind.KwType }
    // Type keywords (long forms)
    if match_keyword(start, len, "uint8", 5) != 0 { return TokenKind.KwUint8 }
    if match_keyword(start, len, "uint16", 6) != 0 { return TokenKind.KwUint16 }
    if match_keyword(start, len, "uint32", 6) != 0 { return TokenKind.KwUint32 }
    if match_keyword(start, len, "uint64", 6) != 0 { return TokenKind.KwUint64 }
    if match_keyword(start, len, "int8", 4) != 0 { return TokenKind.KwInt8 }
    if match_keyword(start, len, "int16", 5) != 0 { return TokenKind.KwInt16 }
    if match_keyword(start, len, "int32", 5) != 0 { return TokenKind.KwInt32 }
    if match_keyword(start, len, "int64", 5) != 0 { return TokenKind.KwInt64 }
    // Type keywords (short aliases)
    // Note: `byte` and `addr` are NOT keywords — they're common variable
    // names in real code, and making them reserved breaks existing programs.
    if match_keyword(start, len, "u8", 2) != 0 { return TokenKind.KwUint8 }
    if match_keyword(start, len, "u16", 3) != 0 { return TokenKind.KwUint16 }
    if match_keyword(start, len, "u32", 3) != 0 { return TokenKind.KwUint32 }
    if match_keyword(start, len, "u64", 3) != 0 { return TokenKind.KwUint64 }
    if match_keyword(start, len, "i8", 2) != 0 { return TokenKind.KwInt8 }
    if match_keyword(start, len, "i16", 3) != 0 { return TokenKind.KwInt16 }
    if match_keyword(start, len, "i32", 3) != 0 { return TokenKind.KwInt32 }
    if match_keyword(start, len, "i64", 3) != 0 { return TokenKind.KwInt64 }
    if match_keyword(start, len, "asm", 3) != 0 { return TokenKind.KwAsm }
    if match_keyword(start, len, "volatile", 8) != 0 { return TokenKind.KwVolatile }
    if match_keyword(start, len, "device", 6) != 0 { return TokenKind.KwDevice }
    if match_keyword(start, len, "at", 2) != 0 { return TokenKind.KwAt }
    if match_keyword(start, len, "f16", 3) != 0 { return TokenKind.KwFloat16 }
    if match_keyword(start, len, "f32", 3) != 0 { return TokenKind.KwFloat32 }
    if match_keyword(start, len, "f64", 3) != 0 { return TokenKind.KwFloat64 }
    // `float` aliases `f32` (single-precision, matches C/C++/Java convention).
    // `double` aliases `f64` so the C-style pair stays consistent.
    if match_keyword(start, len, "float", 5) != 0 { return TokenKind.KwFloat32 }
    if match_keyword(start, len, "double", 6) != 0 { return TokenKind.KwFloat64 }
    if match_keyword(start, len, "sizeof", 6) != 0 { return TokenKind.KwSizeof }
    if match_keyword(start, len, "bool", 4) != 0 { return TokenKind.KwBool }
    if match_keyword(start, len, "char", 4) != 0 { return TokenKind.KwChar }
    return TokenKind.Ident
}

fn lex_one_token() {
    uint64 ch = peek()
    uint64 start = pos
    uint32 tok_line = line

    // F-string: f"..." — prefix ASCII 'f' (102) followed by '"' (34)
    if ch == 102 {
        uint64 fstr_next = peek_at(1)
        if fstr_next == 34 {
            advance()  // consume 'f'
            advance()  // consume '"'
            emit_token(TokenKind.FStrBegin, start, 2, tok_line)

            uint64 part_start = pos
            uint64 fstr_running = 1
            while pos < src_len && fstr_running != 0 {
                uint64 fch = peek()
                if fch == 92 {
                    // Backslash escapes the NEXT byte, exactly as in the
                    // plain string-literal scanner below. Only the delimiter
                    // question is settled here — the escape is decoded later,
                    // when the segment is baked by fstr_part_bake. Without
                    // this, f"say \"hi\"" ended at the first escaped quote
                    // and the rest of the line was parsed as code.
                    lex_escape(1)
                } else if fch == 34 {
                    fstr_running = 0
                } else if fch == 123 {
                    // '{' — check for literal '{{'
                    uint64 fch2 = peek_at(1)
                    if fch2 == 123 {
                        advance()
                        advance()
                    } else {
                        // Flush accumulated StrPart before '{'
                        if pos > part_start {
                            uint64 plen = pos - part_start
                            emit_token(TokenKind.StrPart, part_start, plen, tok_line)
                        }
                        advance()  // consume '{'
                        // Lex inner expression tokens until matching '}' at depth 1
                        // (nested braces not supported in v1 f-string expressions)
                        uint64 depth = 1
                        while pos < src_len && depth > 0 {
                            skip_whitespace_and_comments()
                            if pos < src_len {
                                uint64 ic = peek()
                                if ic == 125 {
                                    advance()  // consume '}'
                                    depth = depth - 1
                                } else if ic == 123 {
                                    depth = depth + 1
                                    lex_one_token()
                                } else {
                                    lex_one_token()
                                }
                            } else {
                                depth = 0
                            }
                        }
                        part_start = pos
                    }
                } else if fch == 125 {
                    // '}' — literal '}}' means one '}'
                    uint64 fch2b = peek_at(1)
                    if fch2b == 125 {
                        advance()
                        advance()
                    } else {
                        advance()
                    }
                } else {
                    advance()
                }
            }
            // Flush trailing StrPart
            if pos > part_start {
                uint64 plen2 = pos - part_start
                emit_token(TokenKind.StrPart, part_start, plen2, tok_line)
            }
            if pos < src_len {
                advance()  // consume closing '"'
            } else {
                lex_report(start, tok_line, "unterminated f-string literal (no closing '\"' before the end of the file)", 0, 0, 0)
            }
            emit_token(TokenKind.FStrEnd, pos, 0, tok_line)
            return
        }
    }

    // Identifier or keyword
    if is_alpha(ch) != 0 {
        while pos < src_len && is_alnum(peek()) != 0 {
            advance()
        }
        uint64 len = pos - start
        uint32 kind = classify_keyword(start, len)
        emit_token(kind, start, len, tok_line)
        return
    }

    // Integer literal (decimal, 0x/0X hex, or 0b/0B binary)
    //
    // A PREFIX WITH NO DIGITS IS AN ERROR TOKEN, and that is the half of this
    // worth reading. `0x` alone used to lex as the IntLit "0x", and
    // parse_int_token's decimal fallback then scanned its TEXT: '0' then 'x',
    // ASCII 120, as the digit 120 - 48 = 72. `static u64 X = 0x` compiled and
    // stored 72. The same shape gave `0b1010` the value 0, because the decimal
    // scan stopped at 'b' and left `b1010` behind as an identifier.
    //
    // 0b IS NEW rather than repaired: nothing lexed it before, so no source can
    // depend on the old reading. 0X is repaired -- 0x worked and its capital
    // has always been an accident of which letter the check named.
    if is_digit(ch) != 0 {
        uint64 pfx = peek_at(1)
        if ch == 48 && (pfx == 120 || pfx == 88) {
            // 0x hex literal
            advance()
            advance()
            // Consume hex digits (avoid break-in-if: use condition in while)
            uint64 hex_n = 0
            uint64 hex_ok = 1
            while pos < src_len && hex_ok != 0 {
                uint64 c = peek()
                if is_digit(c) != 0 || (c >= 97 && c <= 102) || (c >= 65 && c <= 70) {
                    advance()
                    hex_n = hex_n + 1
                } else if c == 95 {
                    // A separator does not count towards hex_n: `0x_` has to
                    // stay an error, and it is hex_n that says so.
                    advance()
                } else {
                    hex_ok = 0
                }
            }
            if hex_n == 0 {
                lex_report(start, tok_line, "malformed number literal ", src_ptr + start, pos - start,
                           ": a base prefix needs at least one digit")
                emit_token(TokenKind.Error, start, pos - start, tok_line)
                return
            }
        } else if ch == 48 && (pfx == 98 || pfx == 66) {
            // 0b binary literal
            advance()
            advance()
            uint64 bin_n = 0
            uint64 bin_ok = 1
            while pos < src_len && bin_ok != 0 {
                uint64 cb = peek()
                if cb == 48 || cb == 49 {
                    advance()
                    bin_n = bin_n + 1
                } else if cb == 95 {
                    advance()
                } else {
                    bin_ok = 0
                }
            }
            if bin_n == 0 {
                lex_report(start, tok_line, "malformed number literal ", src_ptr + start, pos - start,
                           ": a base prefix needs at least one digit")
                emit_token(TokenKind.Error, start, pos - start, tok_line)
                return
            }
            // A decimal digit straight after the binary ones is a typo, not two
            // tokens: `0b1012` would otherwise lex as 0b101 followed by 2, and
            // the stray 2 is not always where it would be noticed. The same
            // holds for a letter or a quote (`0b1f"x"` used to lex as 0b1
            // followed by an f-string), so lex_number_glued covers all three.
            if lex_number_glued(start, tok_line) != 0 { return }
            emit_token(TokenKind.IntLit, start, pos - start, tok_line)
            return
        } else {
            // SEPARATORS RUN THROUGH FLOATS TOO, which costs a skip in each
            // of the four scanners that read float TEXT -- the parser's static
            // initialiser, the IR, and both codegens. Each is one branch beside
            // the one already there for the `f` suffix, and each has to sit
            // BEFORE the digit branches: in the fraction every digit also bumps
            // frac_digits, which sets the divisor, so a separator counted as a
            // digit divides by an extra ten and 1_0.5 would read as 10.05.
            uint64 dec_ok = 1
            while pos < src_len && dec_ok != 0 {
                uint64 cd = peek()
                if is_digit(cd) != 0 {
                    advance()
                } else if cd == 95 {
                    advance()
                } else {
                    dec_ok = 0
                }
            }
            // Float literal: `digits . digits [exp] [f]` OR `digits exp [f]`.
            // Scientific-notation exponent (e|E)(+|-)?digits enables the
            // ML-style constant surface (1e-3, 5.5e-4, 3.14E+10) without
            // forcing users to spell every small number as 0.001.
            uint64 is_float = 0
            if pos < src_len && peek() == 46 {
                uint64 after_dot = peek_at(1)
                if after_dot >= 48 && after_dot <= 57 {
                    advance()
                    uint64 fr_ok = 1
                    while pos < src_len && fr_ok != 0 {
                        uint64 cf = peek()
                        if is_digit(cf) != 0 || cf == 95 { advance() } else { fr_ok = 0 }
                    }
                    is_float = 1
                }
            }
            if pos < src_len && (peek() == 101 || peek() == 69) {
                // Only consume `e`/`E` if a digit (optionally preceded by
                // + or -) actually follows. A bare `e` is left alone, and
                // lex_number_glued then reports `42exit` as one malformed
                // literal rather than silently splitting it.
                uint64 exp_probe = 1
                uint64 c1 = peek_at(exp_probe)
                if c1 == 43 || c1 == 45 {
                    exp_probe = exp_probe + 1
                    c1 = peek_at(exp_probe)
                }
                if c1 >= 48 && c1 <= 57 {
                    advance()
                    if peek() == 43 || peek() == 45 { advance() }
                    uint64 ex_ok = 1
                    while pos < src_len && ex_ok != 0 {
                        uint64 ce = peek()
                        if is_digit(ce) != 0 || ce == 95 { advance() } else { ex_ok = 0 }
                    }
                    is_float = 1
                }
            }
            if is_float != 0 {
                if pos < src_len && peek() == 102 { advance() }
                if lex_number_glued(start, tok_line) != 0 { return }
                emit_token(TokenKind.FloatLit, start, pos - start, tok_line)
                return
            }
        }
        // Integer (decimal or hex): nothing may be glued to its end -- `5x`,
        // `1_f"x"` and `0x1Fg` are one malformed literal each, not a number
        // followed by something else.
        if lex_number_glued(start, tok_line) != 0 { return }
        emit_token(TokenKind.IntLit, start, pos - start, tok_line)
        return
    }

    // String literal. A literal still open at the end of the file (src_len is
    // the end of the CURRENT file while import_buf is lexed -- see lexer_run)
    // is an error at its opening quote, not a token that quietly ends there.
    if ch == 34 {
        advance()
        while pos < src_len && peek() != 34 {
            if peek() == 92 { lex_escape(0) } else { advance() }
        }
        if pos < src_len {
            advance()
        } else {
            lex_report(start, tok_line, "unterminated string literal (no closing '\"' before the end of the file)", 0, 0, 0)
        }
        emit_token(TokenKind.StrLit, start, pos - start, tok_line)
        return
    }

    // Char literal. Scan up to the closing ' so that escapes longer than two
    // bytes ('\\xAB', '\\n', …) all fit inside one CharLit token. parse_int_token
    // validates the content.
    if ch == 39 {
        advance()
        while pos < src_len && peek() != 39 {
            if peek() == 92 { lex_escape(0) } else { advance() }
        }
        if pos < src_len {
            advance()
        } else {
            lex_report(start, tok_line, "unterminated character literal (no closing \"'\" before the end of the file)", 0, 0, 0)
        }
        emit_token(TokenKind.CharLit, start, pos - start, tok_line)
        return
    }

    // Two-char operators (check before single-char)
    uint64 next = peek_at(1)
    advance()

    if ch == 61 && next == 61 { advance(); emit_token(TokenKind.EqEq, start, 2, tok_line); return }
    if ch == 61 && next == 62 { advance(); emit_token(TokenKind.FatArrow, start, 2, tok_line); return }
    if ch == 33 && next == 61 { advance(); emit_token(TokenKind.BangEq, start, 2, tok_line); return }
    if ch == 60 && next == 61 { advance(); emit_token(TokenKind.LtEq, start, 2, tok_line); return }
    if ch == 62 && next == 61 { advance(); emit_token(TokenKind.GtEq, start, 2, tok_line); return }
    if ch == 38 && next == 38 { advance(); emit_token(TokenKind.AmpAmp, start, 2, tok_line); return }
    if ch == 124 && next == 124 { advance(); emit_token(TokenKind.PipePipe, start, 2, tok_line); return }
    // Three-char shift-assign, checked BEFORE the two-char `<<` / `>>` below:
    // matching `<<` first would leave a bare `=` and the parser would report
    // "unexpected '=' in expression". peek() is `next` (pos already advanced
    // past ch), so peek_at(1) is the third character.
    if ch == 60 && next == 60 && peek_at(1) == 61 { advance(); advance(); emit_token(TokenKind.LtLtEq, start, 3, tok_line); return }
    if ch == 62 && next == 62 && peek_at(1) == 61 { advance(); advance(); emit_token(TokenKind.GtGtEq, start, 3, tok_line); return }
    if ch == 60 && next == 60 { advance(); emit_token(TokenKind.LtLt, start, 2, tok_line); return }
    if ch == 62 && next == 62 { advance(); emit_token(TokenKind.GtGt, start, 2, tok_line); return }
    if ch == 45 && next == 62 { advance(); emit_token(TokenKind.Arrow, start, 2, tok_line); return }
    if ch == 43 && next == 61 { advance(); emit_token(TokenKind.PlusEq, start, 2, tok_line); return }
    if ch == 45 && next == 61 { advance(); emit_token(TokenKind.MinusEq, start, 2, tok_line); return }
    if ch == 42 && next == 61 { advance(); emit_token(TokenKind.StarEq, start, 2, tok_line); return }
    if ch == 47 && next == 61 { advance(); emit_token(TokenKind.SlashEq, start, 2, tok_line); return }
    if ch == 37 && next == 61 { advance(); emit_token(TokenKind.PercentEq, start, 2, tok_line); return }
    if ch == 38 && next == 61 { advance(); emit_token(TokenKind.AmpEq, start, 2, tok_line); return }
    if ch == 124 && next == 61 { advance(); emit_token(TokenKind.PipeEq, start, 2, tok_line); return }
    if ch == 94 && next == 61 { advance(); emit_token(TokenKind.CaretEq, start, 2, tok_line); return }

    // Single-char tokens
    if ch == 40 { emit_token(TokenKind.LParen, start, 1, tok_line); return }
    if ch == 41 { emit_token(TokenKind.RParen, start, 1, tok_line); return }
    if ch == 123 { emit_token(TokenKind.LBrace, start, 1, tok_line); return }
    if ch == 125 { emit_token(TokenKind.RBrace, start, 1, tok_line); return }
    if ch == 91 { emit_token(TokenKind.LBracket, start, 1, tok_line); return }
    if ch == 93 { emit_token(TokenKind.RBracket, start, 1, tok_line); return }
    if ch == 44 { emit_token(TokenKind.Comma, start, 1, tok_line); return }
    if ch == 46 { emit_token(TokenKind.Dot, start, 1, tok_line); return }
    if ch == 59 { emit_token(TokenKind.Semicolon, start, 1, tok_line); return }
    if ch == 58 { emit_token(TokenKind.Colon, start, 1, tok_line); return }
    if ch == 64 { emit_token(TokenKind.At, start, 1, tok_line); return }
    if ch == 42 { emit_token(TokenKind.Star, start, 1, tok_line); return }
    if ch == 43 { emit_token(TokenKind.Plus, start, 1, tok_line); return }
    if ch == 45 { emit_token(TokenKind.Minus, start, 1, tok_line); return }
    if ch == 47 { emit_token(TokenKind.Slash, start, 1, tok_line); return }
    if ch == 37 { emit_token(TokenKind.Percent, start, 1, tok_line); return }
    if ch == 61 { emit_token(TokenKind.Eq, start, 1, tok_line); return }
    if ch == 60 { emit_token(TokenKind.Lt, start, 1, tok_line); return }
    if ch == 62 { emit_token(TokenKind.Gt, start, 1, tok_line); return }
    if ch == 38 { emit_token(TokenKind.Ampersand, start, 1, tok_line); return }
    if ch == 124 { emit_token(TokenKind.Pipe, start, 1, tok_line); return }
    if ch == 94 { emit_token(TokenKind.Caret, start, 1, tok_line); return }
    if ch == 126 { emit_token(TokenKind.Tilde, start, 1, tok_line); return }
    if ch == 33 { emit_token(TokenKind.Bang, start, 1, tok_line); return }
    if ch == 63 { emit_token(TokenKind.Question, start, 1, tok_line); return }

    // Unknown character
    emit_token(TokenKind.Error, start, 1, tok_line)
}
