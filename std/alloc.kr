// KernRift Standard Library — Allocators
// Arena: bump allocator backed by mmap slab with optional guard page

import "fmt.kr"

// ---------------------------------------------------------------------------
// Guard-page platform layer
//
// The guard pages below used to be installed with a bare
// `syscall_raw(10, addr, 4096, ...)`. Both halves of that were host
// assumptions dressed up as constants:
//
//   1. Syscall 10 is mprotect on Linux **x86_64 only**. aarch64 Linux uses
//      the asm-generic table, where 10 is fgetxattr and mprotect is 226; the
//      BSD table macOS uses puts it at 74 (with the 0x2000000 class prefix on
//      Intel). So on Linux ARM64 the "guard page" call was really
//      fgetxattr(guard_addr, 4096, NULL, 0) -> -EFAULT. Every arena/pool/heap
//      constructor took the failure branch and exit(1)'d.
//   2. The page size is not 4096 everywhere. Linux ARM64 is routinely built
//      with 16 KiB or 64 KiB pages, and mprotect rejects a merely
//      4096-aligned addr there with EINVAL.
//
// The table below settles (1), and measuring settles (2). But a table is
// exactly the kind of artefact that produced the bug in the first place, so
// nothing here trusts it: alloc_probe() confirms at runtime that the number it
// was handed behaves like mprotect before any guard is installed on it, and
// the platforms this file cannot verify degrade to "no guard" rather than to a
// wrong guard or a dead allocator.

// mprotect syscall number for this target, or 0 when there is no raw-syscall
// mprotect reachable from here. get_arch_id() is a compile-time constant:
//   x86_64: linux=1, windows=3, macos=5, android=8
//   arm64:  linux=2, windows=4, macos=6, android=7
//
// The macOS entries follow the convention this repo's own codegen already
// uses for macOS — codegen.kr emits 0x2000001/0x2000004/0x20000C5 for
// exit/write/mmap on Intel (BSD number | SYSCALL_CLASS_UNIX << 24), and
// codegen_aarch64.kr emits the bare 4/197 for the same calls on Apple
// silicon — applied to BSD mprotect, which is 74. That is corroboration from
// numbers macOS CI actually executes, not verification: no macOS machine ran
// these two values. alloc_probe() is what makes being wrong survivable.
fn alloc_mprotect_nr() -> u64 {
    u64 id = get_arch_id()
    if id == 1 { return 10 }            // Linux x86_64
    if id == 8 { return 10 }            // Android x86_64 (Linux table)
    if id == 2 { return 226 }           // Linux arm64 (asm-generic table)
    if id == 7 { return 226 }           // Android arm64
    if id == 5 { return 0x200004A }     // macOS x86_64: BSD 74 | class prefix
    if id == 6 { return 74 }            // macOS arm64: bare BSD number
    return 0                            // Windows: guards go through
                                        // VirtualProtect, not syscalls
}

// Measured page size; 0 until alloc_probe() has run. Writable on purpose so a
// test can pre-seed a page size this host does not have and drive the rest of
// the arithmetic for it.
static u64 alloc_page_size_cache = 0
// 0 = not probed yet, 1 = guards usable, 2 = guards unavailable here.
static u64 alloc_guard_state = 0

// Runs once per process. Costs one scratch mapping and at most four syscalls,
// which is not worth repeating on every arena_new.
fn alloc_probe() {
    if alloc_guard_state != 0 { return }
    u64 nr = alloc_mprotect_nr()
    if nr == 0 {
        // Nothing to ask, and nothing wrong: this target has no raw-syscall
        // mprotect at all (Windows would need VirtualProtect through the
        // IAT). Guards are unavailable, which is a property of the platform
        // rather than a failure to report, so the allocators run unguarded
        // and say so in their header. Slack stays at the minimum, since no
        // guard will be placed in it.
        alloc_guard_state = 2
        if alloc_page_size_cache == 0 { alloc_page_size_cache = 4096 }
        return
    }
    // mprotect demands a page-aligned addr and returns EINVAL for anything
    // else, which makes it its own page-size oracle AND its own identity
    // check. Take a scratch mapping, step up to an address aligned to 65536
    // (a multiple of every page size in use, so it is page-aligned whatever
    // the answer turns out to be), and offer progressively coarser candidate
    // offsets. The smallest one accepted is the page size.
    u64 scratch = alloc(262144)
    u64 a = (scratch + 65535) & 0xFFFFFFFFFFFF0000
    u64 ps = 0
    if syscall_raw(nr, a + 4096, 4096, 0, 0, 0, 0) == 0 {
        ps = 4096
    } else {
        if syscall_raw(nr, a + 16384, 16384, 0, 0, 0, 0) == 0 {
            ps = 16384
        } else {
            if syscall_raw(nr, a + 65536, 65536, 0, 0, 0, 0) == 0 { ps = 65536 }
        }
    }
    // Accepting some alignment is not enough on its own — plenty of syscalls
    // return 0 for arguments that happen to be valid for them. A real
    // mprotect must also REJECT an address that is aligned to nothing. A
    // number that accepts both is not mprotect (or is not behaving like it),
    // so decline to build guards on it rather than build fake ones.
    u64 usable = 0
    if ps != 0 {
        usable = 1
        if syscall_raw(nr, a + ps + 17, ps, 0, 0, 0, 0) == 0 { usable = 0 }
    }
    dealloc(scratch)
    if usable == 0 {
        alloc_guard_state = 2
        if alloc_page_size_cache == 0 { alloc_page_size_cache = 4096 }
        return
    }
    alloc_guard_state = 1
    if alloc_page_size_cache == 0 { alloc_page_size_cache = ps }
}

fn alloc_page_size() -> u64 {
    alloc_probe()
    // Never 0: slab sizing multiplies by this, and a 0 would silently
    // remove the rounding slack the guard is placed in.
    if alloc_page_size_cache == 0 { return 4096 }
    return alloc_page_size_cache
}

// 1 when this target can install guard pages at all, 0 when it cannot. The
// distinction matters: "this platform has no guard mechanism" is not the same
// event as "the guard mechanism exists and failed", and only the second is a
// reason to abort.
fn alloc_guard_supported() -> u64 {
    alloc_probe()
    if alloc_guard_state == 1 { return 1 }
    return 0
}

// Protect one page starting at the first page boundary at or after `raw_end`,
// the first byte past the slab's usable region. Rounding UP is what keeps the
// guard from ever covering a legitimate in-capacity address. Returns the guard
// address, or 0 on failure. Callers must only reach this when
// alloc_guard_supported() is 1, and must treat 0 as fatal there, because at
// that point the mechanism is known to work and a guard that silently isn't
// there reads as protection.
fn alloc_install_guard(u64 raw_end) -> u64 {
    if alloc_guard_supported() == 0 { return 0 }
    u64 nr = alloc_mprotect_nr()
    u64 ps = alloc_page_size()
    u64 mask = 0 - ps
    u64 guard_addr = (raw_end + ps - 1) & mask
    u64 mp_ret = syscall_raw(nr, guard_addr, ps, 0, 0, 0, 0)
    if mp_ret != 0 { return 0 }
    return guard_addr
}

fn arena_new(u64 capacity) -> u64 {
    // Allocate slab: 40 (header) + capacity + two pages of slack.
    // The guard page must start on a page boundary (mprotect requires an
    // aligned addr), but base+40+capacity is only page-aligned when
    // capacity happens to leave the right residue — true for almost no
    // requested capacity. So we reserve a full extra page of rounding
    // slack on top of the actual guard page and round the guard's start UP
    // to the next page boundary: this guarantees the protected region
    // always lands fully inside the slab, and never starts before
    // base+40+capacity (which would incorrectly trap legitimate
    // in-capacity writes). The page size is measured, not assumed — see
    // alloc_page_size() above.
    u64 page = alloc_page_size()
    u64 total = capacity + 40 + page + page
    u64 base = alloc(total)
    // base points to user region of alloc (after alloc's own 8-byte header)
    // Store arena header
    store64(base, capacity)       // [0]  capacity
    store64(base + 8, 0)          // [8]  used = 0
    store64(base + 16, 0)         // [16] alloc_count = 0
    store64(base + 24, 0)         // [24] alloc_total = 0

    // Set up guard page: mprotect one page as PROT_NONE, starting at the
    // first page boundary at or after the end of the usable capacity.
    // Where the mechanism exists, a guard that silently isn't there is
    // worse than no guard at all, since it reads as protection — so fail
    // loud. Where it does not exist there is nothing to fail at: [32]
    // carries 0, which is the header saying "unguarded" rather than the
    // allocator pretending.
    u64 guard = 0
    if alloc_guard_supported() != 0 {
        if alloc_install_guard(base + 40 + capacity) == 0 {
            write(2, "arena: mprotect guard page failed\n", 34)
            exit(1)
        }
        guard = 1
    }
    store64(base + 32, guard)     // [32] guard

    return base
}

fn arena_alloc(u64 arena, u64 size) -> u64 {
    // 8-byte align size
    u64 aligned = (size + 7) & ~7
    u64 capacity = load64(arena)
    u64 used = load64(arena + 8)
    if used + aligned > capacity {
        write(2, "arena: out of memory\n", 21)
        exit(1)
    }
    u64 ptr = arena + 40 + used
    store64(arena + 8, used + aligned)       // update used
    u64 count = load64(arena + 16)
    store64(arena + 16, count + 1)           // update alloc_count
    u64 total = load64(arena + 24)
    store64(arena + 24, total + size)        // update alloc_total (original size)
    return ptr
}

fn arena_reset(u64 arena) {
    store64(arena + 8, 0)   // used = 0
    // Don't reset alloc_count/alloc_total — they're cumulative stats
}

fn arena_destroy(u64 arena) {
    u64 used = load64(arena + 8)
    if used > 0 {
        u64 count = load64(arena + 16)
        write(2, "arena: ", 7)
        u64 s1 = fmt_dec(used)
        write(2, s1, str_len(s1))
        write(2, " bytes still live at destroy (", 30)
        u64 s2 = fmt_dec(count)
        write(2, s2, str_len(s2))
        write(2, " allocations)\n", 14)
    }
    dealloc(arena)
}

fn arena_stats(u64 arena) -> u64 {
    u64 total = load64(arena + 24)
    u64 live = load64(arena + 8)
    return (total, live)
}

// Pool: fixed-size slot allocator with free list, double-free detection, poison

fn pool_new(u64 obj_size, u64 count) -> u64 {
    // Round obj_size to 8-byte alignment, minimum 16 (need 8 for next-ptr + 8 for canary)
    u64 aligned = (obj_size + 7) & 0xFFFFFFFFFFFFFFF8
    if aligned < 16 { aligned = 16 }
    u64 data_size = aligned * count
    // See arena_new for why this needs two pages of slack rather than one:
    // base+56+data_size is not page-aligned in general, and mprotect
    // requires an aligned addr, so we round the guard start UP and need
    // room for both the rounding slop and the guard page itself.
    u64 page = alloc_page_size()
    u64 total = 56 + data_size + page + page
    u64 base = alloc(total)
    // Header
    store64(base, aligned)            // obj_size
    store64(base + 8, count)          // capacity
    store64(base + 24, 0)             // used_count
    store64(base + 32, 0)             // alloc_count
    store64(base + 40, 0)             // free_count

    // Guard page: round up to the next page boundary at/after the data.
    // See arena_new for why an absent mechanism is recorded rather than
    // treated as a failure.
    u64 guard = 0
    if alloc_guard_supported() != 0 {
        if alloc_install_guard(base + 56 + data_size) == 0 {
            write(2, "pool: mprotect guard page failed\n", 33)
            exit(1)
        }
        guard = 1
    }
    store64(base + 48, guard)         // guard

    // Initialize free list: chain all slots
    u64 slot_base = base + 56
    u64 i = 0
    while i < count {
        u64 slot = slot_base + i * aligned
        if i + 1 < count {
            u64 next_slot = slot_base + (i + 1) * aligned
            store64(slot, next_slot)        // next pointer
        } else {
            store64(slot, 0)                // last slot: next = NULL
        }
        store64(slot + 8, 0)               // canary = 0 (clean)
        i = i + 1
    }
    // free_head must be NULL for an empty pool (count == 0) — otherwise
    // slot_base (which points past the header into the guard/slack
    // region, not to any real slot) would be handed out by pool_alloc as
    // a phantom slot.
    if count > 0 {
        store64(base + 16, slot_base)     // free_head = first slot
    } else {
        store64(base + 16, 0)             // free_head = NULL, pool is empty
    }

    return base
}

fn pool_alloc(u64 pool) -> u64 {
    u64 head = load64(pool + 16)
    if head == 0 {
        write(2, "pool: out of slots\n", 19)
        exit(1)
    }
    // Pop from free list
    u64 next = load64(head)
    store64(pool + 16, next)           // free_head = next

    // Clear poison/canary (zero the slot)
    u64 obj_size = load64(pool)
    u64 j = 0
    while j < obj_size {
        store8(head + j, 0)
        j = j + 1
    }

    // Update stats
    u64 used = load64(pool + 24)
    store64(pool + 24, used + 1)
    u64 ac = load64(pool + 32)
    store64(pool + 32, ac + 1)

    return head
}

fn pool_free(u64 pool, u64 ptr) {
    // Double-free detection: check canary at [ptr+8]
    u64 canary = load64(ptr + 8)
    if canary == 0xDEADBEEFDEADBEEF {
        write(2, "pool: double-free detected\n", 27)
        exit(1)
    }

    // Poison the slot (except first 8 bytes used for free-list next pointer)
    u64 obj_size = load64(pool)
    u64 j = 8
    while j < obj_size {
        store8(ptr + j, 0xEF)   // Fill with 0xEF pattern (part of 0xDEADBEEF)
        j = j + 1
    }
    // Write poison canary at [ptr+8]
    store64(ptr + 8, 0xDEADBEEFDEADBEEF)

    // Push to free list head
    u64 old_head = load64(pool + 16)
    store64(ptr, old_head)
    store64(pool + 16, ptr)

    // Update stats
    u64 used = load64(pool + 24)
    store64(pool + 24, used - 1)
    u64 fc = load64(pool + 40)
    store64(pool + 40, fc + 1)
}

fn pool_destroy(u64 pool) {
    u64 used = load64(pool + 24)
    if used > 0 {
        u64 obj_size = load64(pool)
        u64 leaked = used * obj_size
        write(2, "pool: ", 6)
        u64 s1 = fmt_dec(used)
        write(2, s1, str_len(s1))
        write(2, " slots leaked (", 15)
        u64 s2 = fmt_dec(leaked)
        write(2, s2, str_len(s2))
        write(2, " bytes)\n", 8)
    }
    dealloc(pool)
}

fn pool_stats(u64 pool) -> u64 {
    u64 total = load64(pool + 8)    // capacity
    u64 used = load64(pool + 24)    // used_count
    return (total, used)
}

// Heap: general-purpose variable-size allocator with free list, coalescing, leak detection

fn heap_new(u64 capacity) -> u64 {
    // capacity must cover at least one block header (40 bytes), or
    // `capacity - 40` below underflows on u64 and produces a phantom
    // free block of ~2^64 bytes that heap_alloc will happily hand out
    // pointers from — far outside the actual mmap'd slab.
    if capacity < 40 {
        write(2, "heap_new: capacity must be at least 40 bytes\n", 45)
        exit(1)
    }
    // See arena_new for why this needs two pages of slack rather than one
    // (page-alignment rounding room for the guard page).
    u64 page = alloc_page_size()
    u64 total = 56 + capacity + page + page
    u64 base = alloc(total)
    // Heap header
    store64(base, capacity)
    store64(base + 16, 0)   // alloc_count
    store64(base + 24, 0)   // free_count
    store64(base + 32, 0)   // alloc_total
    store64(base + 40, 0)   // free_total

    // Guard page: round up to the next page boundary at/after capacity.
    // See arena_new for why an absent mechanism is recorded rather than
    // treated as a failure.
    u64 guard = 0
    if alloc_guard_supported() != 0 {
        if alloc_install_guard(base + 56 + capacity) == 0 {
            write(2, "heap: mprotect guard page failed\n", 33)
            exit(1)
        }
        guard = 1
    }
    store64(base + 48, guard)   // guard

    // Initialize one big free block covering the entire capacity
    u64 block = base + 56
    u64 block_size = capacity - 40  // usable size = capacity minus block header
    store64(block, block_size)      // size
    store64(block + 8, 0)           // flags = free
    store64(block + 16, 0)          // prev_free = NULL
    store64(block + 24, 0)          // next_free = NULL
    store64(block + 32, 0)          // canary = 0 (unset for free)

    store64(base + 8, block)        // free_head = this block
    return base
}

fn heap_alloc(u64 heap, u64 size) -> u64 {
    // 8-byte align requested size
    u64 aligned = (size + 7) & 0xFFFFFFFFFFFFFFF8
    if aligned < 8 { aligned = 8 }

    // First-fit: walk free list
    u64 block = load64(heap + 8)    // free_head
    u64 found = 0
    while block != 0 && found == 0 {
        u64 bsize = load64(block)
        if bsize >= aligned {
            found = block
        } else {
            block = load64(block + 24)  // next_free
        }
    }

    if found == 0 {
        write(2, "heap: out of memory\n", 20)
        exit(1)
    }

    u64 bsize = load64(found)

    // Split if large enough (remaining > 80 = 40 header + 40 min usable)
    if bsize >= aligned + 80 {
        u64 new_block = found + 40 + aligned
        u64 new_size = bsize - aligned - 40
        store64(new_block, new_size)        // size
        store64(new_block + 8, 0)           // flags = free
        store64(new_block + 32, 0)          // canary

        // Link new_block into free list in place of found
        u64 prev = load64(found + 16)
        u64 next = load64(found + 24)
        store64(new_block + 16, prev)
        store64(new_block + 24, next)
        if prev != 0 { store64(prev + 24, new_block) }
        if next != 0 { store64(next + 16, new_block) }
        if load64(heap + 8) == found { store64(heap + 8, new_block) }

        store64(found, aligned)             // shrink found to exact size
    } else {
        // Don't split — remove found from free list entirely
        u64 prev = load64(found + 16)
        u64 next = load64(found + 24)
        if prev != 0 { store64(prev + 24, next) }
        if next != 0 { store64(next + 16, prev) }
        if load64(heap + 8) == found { store64(heap + 8, next) }
    }

    // Mark allocated
    store64(found + 8, 1)                   // flags = allocated
    store64(found + 16, 0)                  // clear prev_free
    store64(found + 24, 0)                  // clear next_free
    store64(found + 32, 0xCAFEBABECAFEBABE) // canary = allocated

    // Update stats
    u64 ac = load64(heap + 16)
    store64(heap + 16, ac + 1)
    u64 atot = load64(heap + 32)
    store64(heap + 32, atot + size)         // original size, not aligned

    return found + 40
}

fn heap_free(u64 heap, u64 ptr) {
    u64 block = ptr - 40

    // Double-free detection
    u64 canary = load64(block + 32)
    if canary == 0xDEADBEEFDEADBEEF {
        write(2, "heap: double-free detected\n", 27)
        exit(1)
    }

    u64 bsize = load64(block)

    // Forward coalescing: check next adjacent block
    u64 next_block = block + 40 + bsize
    // Check if next_block is within the heap slab
    u64 capacity = load64(heap)
    u64 slab_end = heap + 56 + capacity
    if next_block + 40 <= slab_end {
        u64 next_flags = load64(next_block + 8)
        if next_flags == 0 {
            // Next block is free — merge
            u64 next_size = load64(next_block)
            store64(block, bsize + 40 + next_size)  // grow block

            // Remove next_block from free list
            u64 np = load64(next_block + 16)
            u64 nn = load64(next_block + 24)
            if np != 0 { store64(np + 24, nn) }
            if nn != 0 { store64(nn + 16, np) }
            if load64(heap + 8) == next_block { store64(heap + 8, nn) }

            bsize = load64(block)  // updated size after merge
        }
    }

    // Backward coalescing: check for a free block that physically ends
    // exactly where this block begins. The block header has no prev-size
    // / boundary-tag field, so unlike the forward case above we cannot
    // jump straight to the preceding block — instead scan the free list
    // (already the allocator's only index of free blocks; first-fit
    // allocation above walks it the same O(n) way) for one whose end
    // address matches this block's start.
    u64 prev_match = 0
    u64 scan = load64(heap + 8)   // free_head
    while scan != 0 {
        u64 scan_size = load64(scan)
        if scan + 40 + scan_size == block {
            prev_match = scan
            scan = 0
        } else {
            scan = load64(scan + 24)   // next_free
        }
    }

    if prev_match != 0 {
        // Absorb this block into its physical predecessor. prev_match is
        // already in the free list at the right position, so it does not
        // need to be reinserted — only its size grows to cover the
        // freed block (header included).
        u64 prev_size = load64(prev_match)
        store64(prev_match, prev_size + 40 + bsize)

        u64 fc2 = load64(heap + 24)
        store64(heap + 24, fc2 + 1)
        u64 ft2 = load64(heap + 40)
        store64(heap + 40, ft2 + bsize)
        return
    }

    // Mark free
    store64(block + 8, 0)                       // flags = free
    store64(block + 32, 0xDEADBEEFDEADBEEF)    // canary = freed

    // Poison first 8 bytes of user data
    store64(ptr, 0xDEADBEEFDEADBEEF)

    // Insert at head of free list
    u64 old_head = load64(heap + 8)
    store64(block + 16, 0)                      // prev = NULL
    store64(block + 24, old_head)               // next = old head
    if old_head != 0 { store64(old_head + 16, block) }
    store64(heap + 8, block)                    // free_head = block

    // Update stats
    u64 fc = load64(heap + 24)
    store64(heap + 24, fc + 1)
    u64 ft = load64(heap + 40)
    // Use original size from the block (bsize is aligned, but we stored aligned)
    // For simplicity, track aligned bytes freed
    store64(heap + 40, ft + bsize)
}

fn heap_destroy(u64 heap) {
    // Linear walk all blocks to find leaks
    u64 capacity = load64(heap)
    u64 pos = heap + 56
    u64 end = heap + 56 + capacity
    u64 leak_count = 0
    u64 leak_bytes = 0
    while pos + 40 <= end {
        u64 bsize = load64(pos)
        u64 flags = load64(pos + 8)
        if flags == 1 {
            leak_count = leak_count + 1
            leak_bytes = leak_bytes + bsize
        }
        pos = pos + 40 + bsize
    }
    if leak_count > 0 {
        write(2, "heap: ", 6)
        u64 s1 = fmt_dec(leak_count)
        write(2, s1, str_len(s1))
        write(2, " blocks leaked (", 16)
        u64 s2 = fmt_dec(leak_bytes)
        write(2, s2, str_len(s2))
        write(2, " bytes)\n", 8)
    }
    dealloc(heap)
}

fn heap_stats(u64 heap) -> u64 {
    u64 atot = load64(heap + 32)    // alloc_total
    u64 ftot = load64(heap + 40)    // free_total
    u64 live = atot - ftot
    return (atot, ftot, live)
}
