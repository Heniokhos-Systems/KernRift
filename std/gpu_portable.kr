// std/gpu_portable.kr — OS-agnostic GPU register access for KernRift.
//
// Pure volatile MMIO (vload32/vstore32, each a barriered access) + PCIe ECAM
// config-space access. ZERO syscalls, freestanding-ready: on your own OS you
// identity-map (or page-table map) the physical MMIO regions and pass the
// resulting pointers in. Ported 1:1 from MLRift std/gpu_portable.mlr.
//
// PCIe config via ECAM (MMCONFIG): device (bus,dev,pfn) config space at
//   ecam_base + (bus<<20 | dev<<15 | pfn<<12) + reg_off
// ECAM base comes from the ACPI MCFG table (this box: 0xe0000000).
//
// NOTE: KernRift binds & | ^ TIGHTER than << >> + - , so every mixed
// shift/mask expression below is fully parenthesized.

// SMN-indirect ports on the GPU register BAR (BAR5), BIF BX0 BASE_IDX=0.
static u64 SMN_INDEX2 = 0x38     // regBIF_BX0_PCIE_INDEX2 (dword 0x0e)
static u64 SMN_DATA2  = 0x3c     // regBIF_BX0_PCIE_DATA2  (dword 0x0f)
static u64 SMN_SHIFT  = 2        // SMN byte addr = reg << 2 (ABL1 convention)

// PCI config register offsets.
static u64 PCI_CFG_VENDOR_DEVICE = 0x00
static u64 PCI_CFG_BAR5          = 0x24

// ---- pure volatile 32-bit MMIO (base = pointer to a phys MMIO region) ----
fn mmio_r32(u64 base, u64 off) -> u64 {
    u32 v = vload32(base + off)
    u64 r = v
    return r
}
fn mmio_w32(u64 base, u64 off, u64 val) {
    u32 v = val
    vstore32(base + off, v)
}

// ---- ECAM PCIe config-space access (pure MMIO) ----
fn ecam_dev_off(u64 bus, u64 dev, u64 pfn) -> u64 {
    return ((bus << 20) | (dev << 15)) | (pfn << 12)
}
fn ecam_cfg_r32(u64 ecam, u64 bus, u64 dev, u64 pfn, u64 off) -> u64 {
    return mmio_r32(ecam + ecam_dev_off(bus, dev, pfn), off)
}
fn pci_bar_base(u64 ecam, u64 bus, u64 dev, u64 pfn, u64 bar_off) -> u64 {
    u64 lo = ecam_cfg_r32(ecam, bus, dev, pfn, bar_off)
    return lo & 0xfffffff0
}

// ---- PCI enumeration: find the GPU + read its BARs (OS-agnostic) ----
// A device's config base = ecam + (bus<<20 | dev<<15 | pfn<<12). Scan helpers
// take a *bus window* pointer = ecam + (bus<<20).
static u64 PCI_VENDOR_AMD    = 0x1002
static u64 PCI_CFG_CLASS_REV = 0x08
static u64 PCI_CLASS_DISPLAY = 0x03
static u64 PCI_CFG_BAR0      = 0x10

// ACPI MCFG: ECAM base of the first segment (base_address u64 at table+0x2c).
fn mcfg_ecam_base(u64 mcfg) -> u64 {
    u64 lo = mmio_r32(mcfg, 0x2c)
    u64 hi = mmio_r32(mcfg, 0x30)
    return lo | (hi << 32)
}

fn pci_dev_off(u64 dev, u64 pfn) -> u64 {
    return (dev << 15) | (pfn << 12)
}
fn pci_vendor(u64 cfg) -> u64 { return mmio_r32(cfg, PCI_CFG_VENDOR_DEVICE) & 0xffff }
fn pci_device(u64 cfg) -> u64 { return (mmio_r32(cfg, PCI_CFG_VENDOR_DEVICE) >> 16) & 0xffff }
fn pci_baseclass(u64 cfg) -> u64 { return (mmio_r32(cfg, PCI_CFG_CLASS_REV) >> 24) & 0xff }

// Scan one bus (bus_base = ecam + bus<<20) for an AMD display device.
// Returns (dev<<3 | pfn) or 0xffff.
fn pci_scan_bus_for_gpu(u64 bus_base, u64 want_vendor) -> u64 {
    u64 dev = 0
    while dev < 32 {
        u64 pfn = 0
        while pfn < 8 {
            u64 cfg = bus_base + pci_dev_off(dev, pfn)
            u64 vd = mmio_r32(cfg, PCI_CFG_VENDOR_DEVICE)
            if (vd & 0xffff) != 0xffff {
                if (vd & 0xffff) == want_vendor {
                    if pci_baseclass(cfg) == PCI_CLASS_DISPLAY { return (dev << 3) | pfn }
                }
            }
            pfn = pfn + 1
        }
        dev = dev + 1
    }
    return 0xffff
}

// Read a BAR: 32-bit mem, 64-bit mem (type [2:1]==0b10 -> hi at off+4), or I/O.
fn pci_bar(u64 cfg, u64 bar_off) -> u64 {
    u64 lo = mmio_r32(cfg, bar_off)
    if (lo & 0x1) != 0 { return lo & 0xfffffffc }
    u64 base = lo & 0xfffffff0
    if (lo & 0x6) == 0x4 {
        u64 hi = mmio_r32(cfg, bar_off + 4)
        base = base | (hi << 32)
    }
    return base
}

// ---- direct SOC15 register access in BAR5: byte off = (base_dw + reg_dw)*4.
//      Valid for low-base IPs (GC/MMHUB/OSS/HDP/NBIF); high bases (0x024xxxx,
//      0x00Dxxxx/0x00Exxxx) are SMN-routed -> use smn_r32/w32 instead. ----
fn gpu_reg_off(u64 base_dw, u64 reg_dw) -> u64 {
    return (base_dw + reg_dw) * 4
}
fn gpu_reg_r32(u64 bar5, u64 base_dw, u64 reg_dw) -> u64 {
    return mmio_r32(bar5, gpu_reg_off(base_dw, reg_dw))
}
fn gpu_reg_w32(u64 bar5, u64 base_dw, u64 reg_dw, u64 val) {
    mmio_w32(bar5, gpu_reg_off(base_dw, reg_dw), val)
}

// ---- SMN-indirect register access on BAR5 (bar5 = pointer to BAR5 phys) ----
fn smn_r32(u64 bar5, u64 reg) -> u64 {
    mmio_w32(bar5, SMN_INDEX2, reg << SMN_SHIFT)
    return mmio_r32(bar5, SMN_DATA2)
}
fn smn_w32(u64 bar5, u64 reg, u64 val) {
    mmio_w32(bar5, SMN_INDEX2, reg << SMN_SHIFT)
    mmio_w32(bar5, SMN_DATA2, val)
}
