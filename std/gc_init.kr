// std/gc_init.kr — CAPSTONE: full gfx11 GPU bring-up orchestrator for a
// from-scratch OS. Wires the whole chain in order:
//   discover/map (caller) -> IMU -> GFXOFF-off -> RLC -> CP(PFP/ME/MEC) ->
//   MES -> compute-queue map -> doorbell -> PM4 dispatch.
//
// The caller supplies: bar5 (BAR5 reg aperture ptr), db2 (BAR2 doorbell ptr),
// mp1 (SMU base = NAVI32_MP1), a VRAM staging region (CPU-mapped host ptr +
// its GPU address, via a bump allocator ctx), and the firmware images
// (read from your OS's filesystem/embedded blobs).
//
// PREP: this drives real hardware writes/polls — run only on a GPU the OS
// OWNS (not amdgpu-bound). Firmware parses + register/packet encodings are all
// validated offline (see per-module demos); on-hardware sequencing + the
// flagged TODO bits (CP multi-pipe activate, MQD tuning, secure-boot) are the
// integration frontier.
import "gpu_portable.kr"
import "gpu_navi32.kr"
import "gpu_activate.kr"
import "gpu_imu_load.kr"
import "gpu_rlc_load.kr"
import "gpu_cp_load.kr"
import "gpu_mes_load.kr"
import "gpu_pm4.kr"
import "gpu_queue.kr"
import "gpu_mes_queue.kr"
import "gmc.kr"

// ---- VRAM bump allocator. ctx = [host_base(0), gpu_base(8), cursor(16)] ----
fn gc_valloc_init(u64 ctx, u64 host_base, u64 gpu_base) {
    store64(ctx + 0, host_base)
    store64(ctx + 8, gpu_base)
    store64(ctx + 16, 0)
}
fn gc_valloc(u64 ctx, u64 size, u64 align) -> u64 {
    u64 cur = load64(ctx + 16)
    cur = (cur + (align - 1)) & ((align - 1) ^ 0xffffffffffffffff)
    store64(ctx + 16, cur + size)
    return cur                          // returns offset from base
}
fn gc_vhost(u64 ctx, u64 off) -> u64 { return load64(ctx + 0) + off }
fn gc_vgpu(u64 ctx, u64 off)  -> u64 { return load64(ctx + 8) + off }

// stage a firmware segment into a fresh VRAM buffer; return its GPU address.
fn gc_stage(u64 ctx, u64 src, u64 n) -> u64 {
    u64 off = gc_valloc(ctx, n, 0x1000)
    mes_copy(gc_vhost(ctx, off), src, n)     // mes_copy is a generic dword copy
    return gc_vgpu(ctx, off)
}

// Full bring-up. Returns 0 on success, or a stage code on failure.
fn gc_init(u64 bar5, u64 db2, u64 mp1, u64 ctx,
           u64 imu_fw, u64 rlc_fw, u64 pfp_fw, u64 me_fw, u64 mec_fw, u64 mes_fw) -> u64 {
    // 1. IMU: stream ucode via RAM ports (no VRAM), start, wait for GC
    imu_load_microcode(bar5, imu_fw)
    if imu_start(bar5) != 0 { return 1 }

    // 2. defeat GFXOFF so GC/CP/MES stay powered
    if gpu_gfxoff_disable(bar5, mp1) != 1 { return 2 }

    // 2b. GMC: MMHUB 2-level GART + GFXHUB identity (std/gmc.kr, port of
    //     the live-validated MLRift std/gmc.mlr). Ordering: amdgpu runs
    //     gmc_v11_0 hw_init in the GMC ip block, BEFORE the gfx block
    //     that starts RLC/CP/MES (soc21.c ip-block list: common -> gmc ->
    //     ... -> gfx), so the hubs translate before any GC client fetches
    //     ucode. It must still come AFTER stage 2: GCVM/GCMC writes are
    //     GC-domain and are silently dropped under GFXOFF (SP3 Task0b).
    //     pt_sysmem=0: the ctx staging region is VRAM (VRAM-resident
    //     PD/PT, no SYSTEM/SNOOPED PTE bits — amdgpu's normal config).
    //     GMC failure returns a distinct 100+rc stage code (101..125).
    u64 gmc_out_off = gc_valloc(ctx, 0x10, 0x100)
    u64 gmc_out = gc_vhost(ctx, gmc_out_off)
    u64 grc = gmc_init(bar5, ctx, 0, gmc_out)
    if grc != 0 { return 100 + grc }
    u64 gmc_pt_base = load64(gmc_out + 0)   // ADD_QUEUE page_table_base_addr
    u64 gmc_vm_cntl = load64(gmc_out + 8)   // ADD_QUEUE vm_context_cntl (0x3FFFC3)

    // 3. RLC: stream ucode via GPM port, enable
    rlc_load_microcode(bar5, rlc_fw)
    rlc_start(bar5)

    // 4. CP PFP/ME (graphics RS64): stage ucode+data, load caches, set the
    //    per-pipe entry point, then unhalt + wait for CP_STAT idle.
    u64 pfp_ic = gc_stage(ctx, pfp_fw + cp_ucode_off(pfp_fw), cp_ucode_size(pfp_fw))
    u64 pfp_dc = gc_stage(ctx, pfp_fw + cp_data_off(pfp_fw),  cp_data_size(pfp_fw))
    u64 me_ic  = gc_stage(ctx, me_fw  + cp_ucode_off(me_fw),  cp_ucode_size(me_fw))
    u64 me_dc  = gc_stage(ctx, me_fw  + cp_data_off(me_fw),   cp_data_size(me_fw))
    cp_gfx_load(bar5, pfp_ic, me_ic, pfp_dc, me_dc)
    cp_gfx_set_entry(bar5, cp_start(pfp_fw), cp_start(me_fw))
    if cp_gfx_activate(bar5) != 0 { return 4 }
    // 4b. MEC (compute RS64): stage, load all 4 pipes under grbm_select, activate.
    u64 mec_ic = gc_stage(ctx, mec_fw + cp_ucode_off(mec_fw), cp_ucode_size(mec_fw))
    u64 mec_md = gc_stage(ctx, mec_fw + cp_data_off(mec_fw),  cp_data_size(mec_fw))
    cp_mec_load(bar5, mec_ic, mec_md, cp_start(mec_fw))
    cp_mec_enable(bar5, 1)

    // 5. MES: stage ucode+data, direct load
    u64 mes_ic = gc_stage(ctx, mes_fw + mes_ucode_off(mes_fw), mes_ucode_size(mes_fw))
    u64 mes_md = gc_stage(ctx, mes_fw + mes_data_off(mes_fw),  mes_data_size(mes_fw))
    mes_load_direct(bar5, mes_ic, mes_md, mes_uc_start(mes_fw))

    // 6. compute queue via MES (SKIP the dead KIQ MAP_QUEUES path):
    //    program the MES scheduler-ring HQD directly, then SET_HW_RESOURCES ->
    //    poll -> ADD_QUEUE -> poll. On gfx11 the doorbell-routing mux is owned
    //    by MES, so this is the only live queue-map path.

    // 6a. compute queue resources (the queue ADD_QUEUE maps). Its MQD is the
    //     v11 compute MQD (gpu_queue.kr mqd_init); ADD_QUEUE.mqd_addr -> it.
    //     Its doorbell (CQ_DB) is its OWN dword index, separate from the MES ring.
    u64 cq_ring_off = gc_valloc(ctx, 0x1000, 0x100)   // 1024-dword ring (log2=10)
    u64 cq_mqd_off  = gc_valloc(ctx, 0x800, 0x1000)
    u64 cq_rptr_off = gc_valloc(ctx, 0x8, 0x100)
    u64 cq_wptr_off = gc_valloc(ctx, 0x8, 0x100)
    u64 cq_mqd_host = gc_vhost(ctx, cq_mqd_off)
    u64 z = 0
    while z < 0x800 { store32(cq_mqd_host + z, 0); z = z + 4 }
    u64 CQ_DB = 0x10                                   // compute queue doorbell idx
    mqd_init(cq_mqd_host, gc_vgpu(ctx, cq_mqd_off), gc_vgpu(ctx, cq_ring_off), 10,
             CQ_DB, gc_vgpu(ctx, cq_rptr_off), gc_vgpu(ctx, cq_wptr_off))

    // 6b. MES scheduler ring + its HQD (this is what consumes our packets).
    u64 sr_ring_off = gc_valloc(ctx, 0x1000, 0x100)   // 1024-dword MES ring (log2=10)
    u64 sr_mqd_off  = gc_valloc(ctx, 0x800, 0x1000)
    u64 sr_eop_off  = gc_valloc(ctx, 0x800, 0x100)    // MES_EOP_SIZE = 2048
    u64 sr_rptr_off = gc_valloc(ctx, 0x8, 0x100)
    u64 sr_wptr_off = gc_valloc(ctx, 0x8, 0x100)
    u64 sr_mqd_host = gc_vhost(ctx, sr_mqd_off)
    u64 SR_DB = 0x08                                   // MES ring doorbell idx (even; 64-bit)
    mes_sched_mqd_init(sr_mqd_host, gc_vgpu(ctx, sr_mqd_off), gc_vgpu(ctx, sr_ring_off),
                       gc_vgpu(ctx, sr_eop_off), 10, SR_DB,
                       gc_vgpu(ctx, sr_rptr_off), gc_vgpu(ctx, sr_wptr_off))
    mes_sched_hqd_program(bar5, sr_mqd_host, 0)        // pipe 0 = AMDGPU_MES_SCHED_PIPE

    // 6c. MES scheduler context + fence buffers (bump-allocated in VRAM).
    u64 sch_ctx_off  = gc_valloc(ctx, 0x1000, 0x1000)  // g_sch_ctx_gpu_mc_ptr
    u64 qfence_off   = gc_valloc(ctx, 0x1000, 0x1000)  // query_status_fence_gpu_mc_ptr
    u64 shr_stat_off = gc_valloc(ctx, 0x8, 0x100)      // SET_HW_RESOURCES completion fence
    u64 aq_stat_off  = gc_valloc(ctx, 0x8, 0x100)      // ADD_QUEUE completion fence
    u64 frame_off    = gc_valloc(ctx, 0x100, 0x100)    // 256-byte packet scratch
    u64 frame_host   = gc_vhost(ctx, frame_off)
    store64(gc_vhost(ctx, shr_stat_off), 0)            // clear poll targets
    store64(gc_vhost(ctx, aq_stat_off), 0)

    // 6d. SET_HW_RESOURCES: tell MES its HW once. Real gc_11_0_3 values
    //     (amdgpu_mes.c:126-159, gfx_v11_0.c:7273):
    //       vmid_mask_mmhub = 0xFF00 (literal),
    //       vmid_mask_gfxhub = 0xFFFF & ~((1<<first_kfd_vmid=8)-1) = 0xFF00,
    //       gds_size = 0x1000,
    //       compute_hqd_mask = ((1<<num_queue_per_pipe=8)-1) & ~0 = 0xFF
    //         (num_reserved_hqd=0 for a MES-managed driver; filled pipes 0..3).
    //     IP bases: only SOC15 seg0 (GC0/MMHUB/OSS) filled; amdgpu fills 5
    //     segments -> segs 1..4 are the Navi32 IP-discovery continuation
    //     (FRONTIER: needs live IP discovery or the published per-ASIC table).
    //     Fence addr = GPU MC of shr_stat; poll its host mirror.
    mes_build_set_hw_resources(frame_host, 0xFF00, 0xFF00, 0x1000,
        0xFF,
        gc_vgpu(ctx, sch_ctx_off), gc_vgpu(ctx, qfence_off),
        NAVI32_GC0, NAVI32_MMHUB, NAVI32_OSS,
        gc_vgpu(ctx, shr_stat_off), 1)
    u64 sw = mes_submit_sched(gc_vhost(ctx, sr_ring_off), gc_vgpu(ctx, sr_ring_off),
                              0, 1024, db2, SR_DB, frame_host)
    if mes_poll_fence(gc_vhost(ctx, shr_stat_off), 1) != 1 { return 6 }

    // 6e. ADD_QUEUE: map the compute queue through MES.
    //   page_table_base_addr = gmc_pt_base — the PD0 GPU address | PTE flags,
    //     the exact value stage 2b programmed into MMHUB
    //     CONTEXT0_PAGE_TABLE_BASE (gmc_init out+0).
    //   vm_context_cntl = gmc_vm_cntl = GMC_CTX0_CNTL_GART (0x3FFFC3) — the
    //     live-validated depth-1 context CNTL (amdgpu add_hw_queue packs
    //     hub->vm_cntx_cntl here; ours matches the 2-level GART it pairs with).
    // FRONTIER (on-hardware): amdgpu mes_v11_0 subtracts adev->gmc.vram_start
    // (FB_LOCATION base) from page_table_base_addr before packing; we never
    // program FB_LOCATION, so verify regMMMC_VM_FB_LOCATION_BASE on the live
    // card before trusting the raw value. Also: the GART window covers only
    // GMC_GART_MC_VA_BASE+0x2000 — the MQD/ring/wptr addresses passed below
    // are raw MC addresses reached via the GFXHUB identity aperture, not GART
    // VAs; whether MES requires them inside the queue VM is a live question.
    u64 proc_ctx_off = gc_valloc(ctx, 0x1000, 0x1000)
    u64 gang_ctx_off = gc_valloc(ctx, 0x1000, 0x1000)
    mes_build_add_queue(frame_host, 1, gmc_pt_base,
        gc_vgpu(ctx, proc_ctx_off), gc_vgpu(ctx, gang_ctx_off),
        CQ_DB, gc_vgpu(ctx, cq_mqd_off), gc_vgpu(ctx, cq_wptr_off),
        MES_QUEUE_TYPE_COMPUTE, gmc_vm_cntl, 0,
        gc_vgpu(ctx, aq_stat_off), 1)
    sw = mes_submit_sched(gc_vhost(ctx, sr_ring_off), gc_vgpu(ctx, sr_ring_off),
                          sw, 1024, db2, SR_DB, frame_host)
    if mes_poll_fence(gc_vhost(ctx, aq_stat_off), 1) != 1 { return 7 }
    return 0
}
