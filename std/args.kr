// KernRift Standard Library -- Command-line arguments
//
// sys_argc() / sys_arg(i): thin readers of the cli_argc / cli_argv statics the
// `main` prologue fills. On Linux/Android/macOS they come from the loader; on
// Windows the prologue parses GetCommandLineA() itself with the UCRT's rules
// (spec C7), so the same program sees the same argv on every OS and this file
// needs no parser and no OS split.
//
// cli_argc / cli_argv are @shared: the prologue finds them by NAME, so a
// program that reads them directly and also imports this file is meant to
// share one variable -- but it must say so. A program that declares
// `static uint64 cli_argc` without @shared and imports this file gets the
// duplicate-static error (and its text says to add @shared). sys.kr
// deliberately does NOT import this file, so importing sys.kr alone never
// introduces these names.

@shared static u64 cli_argc
@shared static u64 cli_argv

// Number of arguments, argv[0] included.
fn sys_argc() -> u64 {
    return cli_argc
}

// argv[i] as a pointer to a NUL-terminated string, or 0 when i >= argc.
fn sys_arg(u64 i) -> u64 {
    if i >= cli_argc { return 0 }
    return load64(cli_argv + i * 8)
}
