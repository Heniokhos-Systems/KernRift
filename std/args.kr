// KernRift Standard Library -- Command-line arguments
//
// sys_argc() / sys_arg(i): thin readers of the cli_argc / cli_argv statics the
// `main` prologue fills. On Linux/Android/macOS they come from the loader; on
// Windows the prologue parses GetCommandLineA() itself with the UCRT's rules
// (spec C7), so the same program sees the same argv on every OS and this file
// needs no parser and no OS split.
//
// cli_envp is declared too (spec C8), and that has a behavioural consequence:
// exec_process / exec_process_argv pass `cli_envp` to the child when the
// program defines it, else NULL. A program that imports this file therefore
// hands its REAL environment to its children (the C behaviour) instead of an
// empty one. On Windows cli_envp stays 0 (spec C7: the prologue leaves it).
//
// cli_argc / cli_argv / cli_envp are @shared: the prologue finds them by NAME, so a
// program that reads them directly and also imports this file is meant to
// share one variable -- but it must say so. A program that declares
// `static uint64 cli_argc` without @shared and imports this file gets the
// duplicate-static error (and its text says to add @shared). sys.kr
// deliberately does NOT import this file, so importing sys.kr alone never
// introduces these names.
//
// sys_getenv (arsh Stage 1b, spec S2) lives HERE, not in sys.kr, because this
// file owns cli_envp: declaring it in sys.kr would make every sys.kr-only
// program start handing its environment to children (exec_process passes
// cli_envp whenever the program defines it). For its Windows arm this file
// imports win32.kr -- only _kr_-prefixed names, no new public ones.

import "win32.kr"

@shared static u64 cli_argc
@shared static u64 cli_argv
@shared static u64 cli_envp

// A `--legacy` Windows build and a Windows `@naked fn main` leave cli_argc at the
// 0xFFFFFFFF sentinel with cli_argv pointing at the raw command line, not at a
// pointer array. Both readers treat that as "no arguments" rather than walk it.

// Number of arguments, argv[0] included.
fn sys_argc() -> u64 {
    if cli_argc == 0xFFFFFFFF { return 0 }
    return cli_argc
}

// argv[i] as a pointer to a NUL-terminated string, or 0 when i >= argc.
fn sys_arg(u64 i) -> u64 {
    if cli_argc == 0xFFFFFFFF { return 0 }
    if i >= cli_argc { return 0 }
    return load64(cli_argv + i * 8)
}

// The value of environment variable `name` into `out` (NUL-terminated):
// its length (excluding the NUL), -ENOENT (-2) if unset, -ERANGE (-34) if it
// does not fit `cap` (a value of length cap-1 fits). THE NAME MATCHES WHOLE:
// "HOME" never matches HOMEBREW_PREFIX=... -- the entry must be "HOME=".
// Linux/Android/macOS walk cli_envp (pure memory). Windows asks
// GetEnvironmentVariableA, which returns the length when it fits, the size
// it NEEDS (NUL included) when it does not -- so r >= cap is -ERANGE and
// r == cap cannot occur -- and 0 with ERROR_ENVVAR_NOT_FOUND when unset. A
// Windows variable cannot be empty (setting it empty deletes it); callers
// keep their own empty check anyway. nSize is a DWORD: a cap past it is
// passed as 0xFFFFFFFF (never truncated onto a small size).
fn sys_getenv(u64 name, u64 out, u64 cap) -> int64 {
    if get_target_os() == 2 {
        u64 c = cap
        if c > 0xFFFFFFFF { c = 0xFFFFFFFF }
        u64 r = _kr_w32_GetEnvironmentVariableA(name, out, c) & 0xFFFFFFFF
        if r == 0 { return 0 - _kr_w32_file_errno(_kr_w32_GetLastError() & 0xFFFFFFFF) }
        if r >= cap { return 0 - 34 }
        return r
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        if cli_envp == 0 { return 0 - 2 }
        u64 nl = 0
        while load8(name + nl) != 0 { nl = nl + 1 }
        u64 i = 0
        while load64(cli_envp + i * 8) != 0 {
            u64 e = load64(cli_envp + i * 8)
            u64 k = 0
            u64 same = 1
            while k < nl {
                if load8(e + k) != load8(name + k) { same = 0  k = nl } else { k = k + 1 }
            }
            if same == 1 {
                if load8(e + nl) == 61 {
                    u64 v = e + nl + 1
                    u64 vl = 0
                    while load8(v + vl) != 0 { vl = vl + 1 }
                    if vl >= cap { return 0 - 34 }
                    u64 j = 0
                    while j < vl { store8(out + j, load8(v + j))  j = j + 1 }
                    store8(out + vl, 0)
                    return vl
                }
            }
            i = i + 1
        }
        return 0 - 2
    }
}
