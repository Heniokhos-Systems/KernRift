// KernRift Standard Library -- Portable system layer
//
// sys_*: sockets, readiness wait, entropy, stdio, exit, time. One API, three
// OS families (spec C2/C3):
//   - Unix (Linux, Android, macOS): raw syscalls, numbers per (arch, os);
//   - Windows: the `_kr_w32_` externs of win32.kr (Winsock 2.2, started on the
//     first socket call; WSAGetLastError mapped to the same Linux errno values;
//     setsockopt takes Linux option numbers and is translated -- see
//     _kr_sys_w32_setsockopt for the supported set);
//   - ApexRift none (os 4): no sockets or entropy yet -- -ENOSYS.
//
// Contract: socket/fd results are >= 0 or -errno; byte counts; 0 is EOF.
// Every OS split below is the CANONICAL LITERAL CHAIN
//     if get_target_os() == 2 { windows } else if get_target_os() == 4 { none } else { unix }
// -- the compiler prunes the arms that cannot run on the target, so a Windows
// build never sees a syscall_raw and a Linux build never sees a Win32 extern.
// get_arch_id() is used only inside the Unix arm, to pick the numbers.
//
// macOS (arch 5/6) returns -ENOSYS for sockets, readiness wait and entropy:
// it is unproven in v1 and has no ppoll/getrandom, and Linux numbers must never
// be inherited there. Arch ids 9..12 (bare metal) get -ENOSYS the same way.
//
// FILES AND THE ENVIRONMENT (arsh Stage 1b, spec S1/S2). sys_mkdir,
// sys_rename, sys_chmod, sys_file_mode, sys_last_errno here; sys_getenv lives
// in args.kr, the owner of cli_envp. arm64 Linux has only the *at forms
// (mkdirat, renameat, fchmodat, newfstatat, all with AT_FDCWD = -100), and its
// struct stat puts st_mode at +16 where x86_64's puts it at +24. Windows:
// CreateDirectoryA / MoveFileExA, failures mapped from GetLastError() by
// _kr_w32_file_errno; sys_chmod is a no-op 0 (no ACL work) and sys_file_mode
// is -ENOSYS (there is no mode -- callers decide what that means).
//
// sys_last_errno(r): the POSITIVE errno of the failing FILE BUILTIN whose
// result was r. Linux/Android/macOS compute it from r (the builtin already
// returned -errno). Windows' file_open returns INVALID_HANDLE_VALUE for EVERY
// failure, so the cause is only in GetLastError(), and the value lasts only
// until the next call that sets it: CALL sys_last_errno IMMEDIATELY after the
// failing builtin, with nothing in between that could reach Win32 (an alloc
// can reach VirtualAlloc). The emitted file_open makes no Win32 call after
// CreateFileA, so the value survives to that point.
//
// sys_rename replaces an existing target. POSIX rename(2) is atomic within a
// filesystem; on NTFS a same-volume MoveFileExA(REPLACE_EXISTING) means
// "there is never a moment with no valid target", not POSIX atomicity.
// MOVEFILE_WRITE_THROUGH only matters across volumes and is harmless here.
//
// DATAGRAMS (arsh discovery, spec S3). sys_sendto / sys_recvfrom carry the
// peer address; sys_sendto passes MSG_NOSIGNAL on Linux and clamps len to
// 0x7FFFFFFF on Windows as sys_send does. A zero-length recvfrom is not
// supported (Linux discards a datagram, Windows reports WSAEMSGSIZE).
// WINDOWS UDP TRAP: after a sendto that drew an ICMP port-unreachable, the
// NEXT recvfrom on that socket fails WSAECONNRESET (-ECONNRESET, -104). A
// datagram caller treats it as "nothing yet" and keeps waiting.
//
// THE TIMED CONNECT (spec S4). sys_connect_timeout(sock, sa, len, ms):
// non-blocking on, connect, wait for writable-or-exception up to `ms`, read
// the connect's own result (SO_ERROR), and restore blocking mode ON EVERY PATH
// -- left non-blocking, every later sys_recv says -EAGAIN at once on both OSes.
// A restore failure is the result even after a successful connect. On
// -ETIMEDOUT (or any failure) the socket is DEAD -- Winsock will not retry a
// connect on the same handle -- so the caller closes it and opens a new one.
// The deadline has the Windows timer's granularity (~15.6 ms); a REFUSED
// connect measured 2.02 s on native Windows, so with a 2 s deadline "refused"
// and "timed out" may collapse into one outcome: callers must not claim to
// know which.
//
// NETWORK INTERFACES (arsh per-interface discovery). sys_net_ifaces(out, max)
// fills up to `max` 16-byte records at `out`, IPv4 only, one per address:
//   +0 u32 addr  +4 u32 netmask  +8 u32 broadcast  +12 u32 flags
// addresses in NETWORK byte order exactly as they sit in a sockaddr_in's
// sin_addr (the bytes sys_sendto/sys_recvfrom carry at sa+4: 127.0.0.1 is the
// bytes 7F 00 00 01, so load32 reads 0x0100007F on a little-endian CPU);
// flags bit 0 UP, bit 1 BROADCAST-capable, bit 2 LOOPBACK. broadcast is 0 when
// bit 1 is clear. Returns the count written (0..max) or -errno. Interfaces past
// `max` are DROPPED, and so is anything past the first 64 addresses the OS
// reports (one fixed buffer per call): pass max >= 64 to see every one there is.
//   - Linux/Android: SIOCGIFCONF (0x8912) on an AF_INET datagram socket, then
//     per entry SIOCGIFFLAGS (0x8913), SIOCGIFNETMASK (0x891b) and, when the
//     interface can broadcast, SIOCGIFBRDADDR (0x8919). struct ifreq is 40
//     bytes on 64-bit Linux (name[16] + a 24-byte union); each query is sent
//     with the SIOCGIFCONF entry's own AF_INET address, so a device with two
//     addresses gets each address's own mask (devinet_ioctl matches label AND
//     address). An entry whose device or address vanished between the list and
//     the query (-ENODEV, -EADDRNOTAVAIL) is skipped, not an error.
//   - Windows: WSAIoctl(SIO_GET_INTERFACE_LIST 0x4004747F) on an AF_INET
//     socket: an array of 76-byte INTERFACE_INFO (u_long iiFlags, then three
//     24-byte sockaddr_gen: address +4, broadcast +28, netmask +52; sin_addr is
//     at +4 inside each). IFF_UP/BROADCAST/LOOPBACK are 1/2/4, the record's own
//     bits. The broadcast is COMPUTED from the address and mask, (addr & mask)
//     | ~mask, when IFF_BROADCAST is set: Windows has been seen to report
//     255.255.255.255 in iiBroadcastAddress (EPICS pvAccess 59a65ce), which is
//     the one value a per-interface sender must not use. Every other iiFlags
//     bit (IFF_POINTTOPOINT 8, IFF_MULTICAST 16 -- real Windows sets 16 on
//     every interface) is masked off. /31 AND /32: a mask with 31 or more one
//     bits has NO directed broadcast (RFC 3021; the formula would give the
//     point-to-point peer, or the address itself -- a Tailscale /32 is
//     IFF_BROADCAST on Windows 11), so the record's broadcast is 0 and bit 1
//     is CLEARED. _kr_sys_w32_ifrec does the conversion; it is plain
//     arithmetic, run on Linux too by the suite. 65+ addresses make the call
//     fail -EFAULT (Windows will not truncate).
//   - THE OSes DIFFER on /31 and /32: Linux reports what the kernel has
//     configured (SIOCGIFBRDADDR, and IFF_BROADCAST from the DEVICE), so a /32
//     on a broadcast-capable device reads bit 1 set with whatever broadcast
//     was configured (0.0.0.0 unless `brd` was given). A caller sending
//     directed broadcasts skips a record whose broadcast is 0 or its own addr.
//   - macOS, the bare-metal arch ids and none: -ENOSYS.
// sys_ioctl(fd, req, arg) is the raw Unix ioctl (-ENOSYS on Windows, whose
// ioctlsocket codes differ, and on macOS and none).
//
// Irreducible Linux/Windows differences (documented, not translated):
//   - listen() on an UNBOUND socket: Linux autobinds a port (0), Windows -EINVAL;
//   - getsockname() on an unbound socket: Linux 0 (0.0.0.0:0), Windows -EINVAL;
//   - connect() to 0.0.0.0: Linux treats it as loopback, Windows -EADDRNOTAVAIL;
//     so a portable caller binds before listening and never connects to 0.0.0.0;
//   - once a peer's reset has been reported, later sends read -EPIPE on Linux
//     but keep reading -ECONNRESET on Windows;
//   - a keepalive failure on recv reads -EAGAIN on Windows (see recv below);
//   - WSAENOTSOCK reads -EBADF (a file handle passed as a socket too);
//   - setsockopt supports SO_REUSEADDR, SO_RCVTIMEO and SO_BROADCAST only on
//     Windows;
//   - IPv4 only on Windows (AF_INET6 is 10 on Linux, 23 on Windows);
//   - timeouts have the Windows timer's granularity (~15.6 ms);
//   - a send on an UNCONNECTED datagram socket: Linux -EDESTADDRREQ (-89),
//     Windows -EPIPE (-32) -- the send map's ENOTCONN -> EPIPE is TCP's reading
//     and cannot see the socket type (sys_send is for TCP; a datagram goes
//     through sys_sendto, which carries its address);
//   - shutdown() on a LISTENING socket: Linux 0, Windows -ENOTCONN (-107);
//   - connect()/bind() with a short addrlen (< 16): Linux -EINVAL (-22),
//     Windows -EFAULT (-14);
//   - getsockname() with a too-short length: Linux 0 and the length is
//     updated to 16, Windows -EFAULT (-14) and the length is left alone;
//   - socket(AF_INET, <unknown type>, 0): Linux -EINVAL (-22), Windows
//     -ESOCKTNOSUPPORT (-94);
//   - sys_recv(s, buf, 0) is 0 at once on both, but on a CLOSED handle Linux
//     says -EBADF and Windows 0 (the length is checked before the handle).
// A portable caller passes 16-byte sockaddrs and lengths and a real socket
// type, so none of these is reached by correct code.
//
// Private helpers carry the `_kr_` prefix. This file does not import args.kr
// (see args.kr: importing sys.kr must not introduce cli_argc / cli_argv).

import "win32.kr"

// Syscall number for operation `k` on this (arch, os), 0 when there is none.
//   0 socket  1 connect  2 bind  3 listen  4 accept  5 getsockname
//   6 shutdown  7 setsockopt  8 close  9 ppoll  10 getrandom  11 sendto
//   12 recvfrom  13 fcntl  14 getsockopt
//   15 mkdir(at)  16 rename(at)  17 chmod/fchmodat  18 stat/newfstatat
//   19 ioctl
// Linux and Android share a table per architecture (1/8 = x86_64, 2/7 = arm64).
fn _kr_sys_nr(u64 k) -> u64 {
    u64 a = get_arch_id()
    if a == 1 || a == 8 {
        if k == 0 { return 41 }
        if k == 1 { return 42 }
        if k == 2 { return 49 }
        if k == 3 { return 50 }
        if k == 4 { return 43 }
        if k == 5 { return 51 }
        if k == 6 { return 48 }
        if k == 7 { return 54 }
        if k == 8 { return 3 }
        if k == 9 { return 271 }
        if k == 10 { return 318 }
        if k == 11 { return 44 }
        if k == 12 { return 45 }
        if k == 13 { return 72 }
        if k == 14 { return 55 }
        if k == 15 { return 83 }
        if k == 16 { return 82 }
        if k == 17 { return 90 }
        if k == 18 { return 4 }
        if k == 19 { return 16 }
        return 0
    }
    if a == 2 || a == 7 {
        if k == 0 { return 198 }
        if k == 1 { return 203 }
        if k == 2 { return 200 }
        if k == 3 { return 201 }
        if k == 4 { return 202 }
        if k == 5 { return 204 }
        if k == 6 { return 210 }
        if k == 7 { return 208 }
        if k == 8 { return 57 }
        if k == 9 { return 73 }
        if k == 10 { return 278 }
        if k == 11 { return 206 }
        if k == 12 { return 207 }
        if k == 13 { return 25 }
        if k == 14 { return 209 }
        if k == 15 { return 34 }
        if k == 16 { return 38 }
        if k == 17 { return 53 }
        if k == 18 { return 79 }
        if k == 19 { return 29 }
        return 0
    }
    return 0
}

// --- Windows helpers (called only from the os==2 arms) -------------------------

// recv result: a count, 0 on EOF, or -errno. A receive timeout set with
// SO_RCVTIMEO fails on Windows with WSAETIMEDOUT and on Linux with EAGAIN; the
// Linux reading is the contract, so WSAETIMEDOUT -> -EAGAIN HERE (connect keeps
// -ETIMEDOUT). Irreducible: a keepalive failure also surfaces as WSAETIMEDOUT
// on a recv, where Linux says ETIMEDOUT -- it reads -EAGAIN too.
// WSAESHUTDOWN on a recv arises only after our OWN shutdown(SHUT_RD/RDWR),
// which Linux reads as end of stream: 0 (EOF) HERE. A send keeps it as -EPIPE
// (_kr_w32_send_errno).
fn _kr_sys_w32_recv_ret(u64 r) -> int64 {
    if (r & 0xFFFFFFFF) != 0xFFFFFFFF { return r & 0xFFFFFFFF }
    u64 w = _kr_w32_WSAGetLastError() & 0xFFFFFFFF
    if w == 10060 { return 0 - 11 }
    if w == 10058 { return 0 }
    return 0 - _kr_w32_errno(w)
}

// send result: a count, or -errno (send's own map: _kr_w32_send_errno).
fn _kr_sys_w32_send_ret(u64 r) -> int64 {
    if (r & 0xFFFFFFFF) != 0xFFFFFFFF { return r & 0xFFFFFFFF }
    return 0 - _kr_w32_send_errno(_kr_w32_WSAGetLastError() & 0xFFFFFFFF)
}

// setsockopt with LINUX option numbers and value shapes (the sys_* contract),
// translated to Windows'. Supported in v1 -- what KernRift and ApexRift use:
//   SOL_SOCKET(1) SO_REUSEADDR(2): Linux's meaning (rebind past TIME_WAIT) is
//     Windows' DEFAULT; Windows' own SO_REUSEADDR means something else -- it
//     lets a second socket bind a port that is in use, even listening (port
//     stealing). So the option is accepted, its int length checked, and it is
//     applied as SO_REUSEADDR = 0 (which also checks the handle), never as 1.
//   SOL_SOCKET(1) SO_RCVTIMEO(20): Linux takes a 16-byte timeval, Windows a
//     DWORD of milliseconds (SO_RCVTIMEO 0x1006); converted, rounding up.
//     optlen < 16 -> -EINVAL and tv_usec >= 1000000 -> -EDOM, as on Linux.
//   SOL_SOCKET(1) SO_BROADCAST(6): Winsock SO_BROADCAST 0x0020, a 4-byte
//     BOOL from the caller's int; optlen < 4 -> -EINVAL.
// Every other (level, option) -> -ENOPROTOOPT: refused loudly rather than
// passed through, because Windows numbers the same options differently
// (0x1001 is Windows' SO_SNDBUF) and the value shapes differ too.
fn _kr_sys_w32_setsockopt(u64 sock, u64 level, u64 name, u64 val, u64 len) -> int64 {
    u8[8] v
    if level != 1 { return 0 - 92 }
    if name == 2 {
        if len < 4 { return 0 - 22 }
        store32(v, 0)
        return _kr_w32_ret32(_kr_w32_setsockopt(sock, 0xFFFF, 4, v, 4))
    }
    if name == 20 {
        if len < 16 { return 0 - 22 }
        if load64(val + 8) >= 1000000 { return 0 - 33 }
        store32(v, _kr_w32_ms_of_timeval(val))
        return _kr_w32_ret32(_kr_w32_setsockopt(sock, 0xFFFF, 0x1006, v, 4))
    }
    if name == 6 {
        if len < 4 { return 0 - 22 }
        u64 b = 0
        if load32(val) != 0 { b = 1 }
        store32(v, b)
        return _kr_w32_ret32(_kr_w32_setsockopt(sock, 0xFFFF, 0x0020, v, 4))
    }
    return 0 - 92
}

// --- sockets -------------------------------------------------------------------

// Start the network stack EXPLICITLY: 0 when sockets are usable, or -errno.
// Optional -- every socket call starts it on first use -- but a caller that
// wants to tell "the machine's network stack would not start" from "this
// socket/connect failed" calls this first: sys_socket reports both as one
// -errno. Windows: WSAStartup(2.2) once (the same start-once routine every
// socket call runs, so it never starts twice); a failure leaves it unstarted
// and a later call retries. Linux/Android: nothing to start, 0. macOS and the
// bare-metal arch ids: -ENOSYS, as every socket call there is. none: -ENOSYS.
fn sys_net_init() -> int64 {
    if get_target_os() == 2 {
        return _kr_w32_ensure()
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        if _kr_sys_nr(0) == 0 { return 0 - 38 }
        return 0
    }
}

fn sys_socket(u64 domain, u64 stype, u64 proto) -> int64 {
    if get_target_os() == 2 {
        int64 e = _kr_w32_ensure()
        if e < 0 { return e }
        return _kr_w32_sock(_kr_w32_socket(domain, stype, proto))
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(0)
        if nr == 0 { return 0 - 38 }
        return syscall_raw(nr, domain, stype, proto, 0, 0, 0)
    }
}

fn sys_connect(u64 sock, u64 sa, u64 len) -> int64 {
    if get_target_os() == 2 {
        int64 e = _kr_w32_ensure()
        if e < 0 { return e }
        return _kr_w32_ret32(_kr_w32_connect(sock, sa, len))
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(1)
        if nr == 0 { return 0 - 38 }
        return syscall_raw(nr, sock, sa, len, 0, 0, 0)
    }
}

fn sys_bind(u64 sock, u64 sa, u64 len) -> int64 {
    if get_target_os() == 2 {
        int64 e = _kr_w32_ensure()
        if e < 0 { return e }
        return _kr_w32_ret32(_kr_w32_bind(sock, sa, len))
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(2)
        if nr == 0 { return 0 - 38 }
        return syscall_raw(nr, sock, sa, len, 0, 0, 0)
    }
}

fn sys_listen(u64 sock, u64 backlog) -> int64 {
    if get_target_os() == 2 {
        int64 e = _kr_w32_ensure()
        if e < 0 { return e }
        return _kr_w32_ret32(_kr_w32_listen(sock, backlog))
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(3)
        if nr == 0 { return 0 - 38 }
        return syscall_raw(nr, sock, backlog, 0, 0, 0, 0)
    }
}

// Accept one connection; the peer address is not returned.
fn sys_accept(u64 sock) -> int64 {
    if get_target_os() == 2 {
        int64 e = _kr_w32_ensure()
        if e < 0 { return e }
        return _kr_w32_sock(_kr_w32_accept(sock, 0, 0))
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(4)
        if nr == 0 { return 0 - 38 }
        return syscall_raw(nr, sock, 0, 0, 0, 0, 0)
    }
}

// sa: buffer for a sockaddr; lenptr: pointer to a 32-bit in/out length.
fn sys_getsockname(u64 sock, u64 sa, u64 lenptr) -> int64 {
    if get_target_os() == 2 {
        int64 e = _kr_w32_ensure()
        if e < 0 { return e }
        return _kr_w32_ret32(_kr_w32_getsockname(sock, sa, lenptr))
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(5)
        if nr == 0 { return 0 - 38 }
        return syscall_raw(nr, sock, sa, lenptr, 0, 0, 0)
    }
}

// how: 0 receive, 1 send (SHUT_WR), 2 both.
fn sys_shutdown(u64 sock, u64 how) -> int64 {
    if get_target_os() == 2 {
        int64 e = _kr_w32_ensure()
        if e < 0 { return e }
        return _kr_w32_ret32(_kr_w32_shutdown(sock, how))
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(6)
        if nr == 0 { return 0 - 38 }
        return syscall_raw(nr, sock, how, 0, 0, 0, 0)
    }
}

fn sys_setsockopt(u64 sock, u64 level, u64 name, u64 val, u64 len) -> int64 {
    if get_target_os() == 2 {
        int64 e = _kr_w32_ensure()
        if e < 0 { return e }
        return _kr_sys_w32_setsockopt(sock, level, name, val, len)
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(7)
        if nr == 0 { return 0 - 38 }
        return syscall_raw(nr, sock, level, name, val, len, 0)
    }
}

fn sys_sock_close(u64 sock) -> int64 {
    if get_target_os() == 2 {
        int64 e = _kr_w32_ensure()
        if e < 0 { return e }
        return _kr_w32_ret32(_kr_w32_closesocket(sock))
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(8)
        if nr == 0 { return 0 - 38 }
        return syscall_raw(nr, sock, 0, 0, 0, 0, 0)
    }
}

// Single-shot send / receive: a count, 0 on EOF, or -errno.
// sys_send on Linux/Android is sendto(fd, buf, len, MSG_NOSIGNAL, NULL, 0): a
// send to a peer that closed returns -EPIPE instead of killing the process
// with SIGPIPE -- the same result Windows gives for the same condition. It
// stays pipe-compatible (spec C3): on a non-socket fd sendto says -ENOTSOCK
// and the call falls back to write(2), the file_write builtin. (A pipe write
// can still raise SIGPIPE: that is a pipe's semantics, not a socket's.) macOS
// has no sockets in v1 (sys_socket is -ENOSYS), so it writes directly.
// sys_recv is read(2) on every Unix (a receive never raises SIGPIPE).
fn sys_send(u64 sock, u64 buf, u64 len) -> int64 {
    if get_target_os() == 2 {
        int64 e = _kr_w32_ensure()
        if e < 0 { return e }
        u64 n = len
        if n > 0x7FFFFFFF { n = 0x7FFFFFFF }
        return _kr_sys_w32_send_ret(_kr_w32_send(sock, buf, n, 0))
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(11)
        if nr == 0 { return file_write(sock, buf, len) }
        int64 r = syscall_raw(nr, sock, buf, len, 0x4000, 0, 0)
        if r == 0 - 88 { return file_write(sock, buf, len) }
        return r
    }
}

fn sys_recv(u64 sock, u64 buf, u64 len) -> int64 {
    if get_target_os() == 2 {
        int64 e = _kr_w32_ensure()
        if e < 0 { return e }
        // A zero-length recv is 0 at once on Linux (read(fd, buf, 0)), idle
        // socket or not; Winsock's recv(s, buf, 0) instead WAITS for data
        // (or SO_RCVTIMEO), forever with no timeout armed. A caller whose
        // remaining length reaches 0 would hang on Windows only. Closed
        // handle: Linux -EBADF, here 0 (listed above).
        if len == 0 { return 0 }
        u64 n = len
        if n > 0x7FFFFFFF { n = 0x7FFFFFFF }
        return _kr_sys_w32_recv_ret(_kr_w32_recv(sock, buf, n, 0))
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        return file_read(sock, buf, len)
    }
}

// 1 = readable (data, EOF or error pending), 0 = timeout, -errno. SOCKET ONLY.
// timeout_ms == 0xFFFFFFFF blocks forever.
fn sys_wait_readable(u64 sock, u64 timeout_ms) -> int64 {
    if get_target_os() == 2 {
        int64 e = _kr_w32_ensure()
        if e < 0 { return e }
        u8[520] fds
        u8[8] tv
        _kr_w32_fdset_one(fds, sock)
        u64 tvp = 0
        if timeout_ms != 0xFFFFFFFF {
            u64 ms = timeout_ms
            if ms > 0xFFFFFFFE { ms = 0xFFFFFFFE }
            _kr_w32_timeval(tv, ms)
            tvp = tv
        }
        int64 r = _kr_w32_ret32(_kr_w32_select(0, fds, 0, 0, tvp))
        if r > 0 { return 1 }
        return r
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(9)
        if nr == 0 { return 0 - 38 }
        u8[8] pfd
        u8[16] ts
        store32(pfd, sock)
        store16(pfd + 4, 1)
        store16(pfd + 6, 0)
        u64 tsp = 0
        if timeout_ms != 0xFFFFFFFF {
            store64(ts, timeout_ms / 1000)
            store64(ts + 8, (timeout_ms % 1000) * 1000000)
            tsp = ts
        }
        int64 r = syscall_raw(nr, pfd, 1, tsp, 0, 8, 0)
        if r > 0 {
            // POLLNVAL (0x20): the fd is not open. Windows' select says
            // WSAENOTSOCK -> -EBADF for the same call, and so does this.
            if (load16(pfd + 6) & 0x20) != 0 { return 0 - 9 }
            return 1
        }
        return r
    }
}

// --- entropy -------------------------------------------------------------------

// Fill buf with len random bytes. 1 = filled, 0 = failed.
fn sys_random(u64 buf, u64 len) -> u64 {
    if get_target_os() == 2 {
        // BCryptGenRandom(NULL, buf, ULONG len, BCRYPT_USE_SYSTEM_PREFERRED_RNG):
        // NTSTATUS 0 = success. ULONG is 32 bits, so a larger request is
        // filled in 1 GiB pieces (defensive: no row allocates 4 GiB to prove it).
        u64 got = 0
        while got < len {
            u64 n = len - got
            if n > 0x40000000 { n = 0x40000000 }
            if (_kr_w32_BCryptGenRandom(0, buf + got, n, 2) & 0xFFFFFFFF) != 0 { return 0 }
            got = got + n
        }
        return 1
    } else if get_target_os() == 4 {
        return 0
    } else {
        u64 nr = _kr_sys_nr(10)
        if nr == 0 { return 0 }
        u64 got = 0
        while got < len {
            int64 r = syscall_raw(nr, buf + got, len - got, 0, 0, 0, 0)
            if r <= 0 { return 0 }
            got = got + r
        }
        return 1
    }
}

// --- files and directories (spec S1/S2) ------------------------------------------

// 1 when this arch has only the *at file calls (arm64: mkdirat is 34), else 0.
// Read from the table, NOT from get_arch_id(): _kr_sys_nr stays the one reader.
fn _kr_sys_at() -> u64 {
    if _kr_sys_nr(15) == 34 { return 1 }
    return 0
}

fn sys_last_errno(u64 r) -> u64 {
    if get_target_os() == 2 {
        return _kr_w32_file_errno(_kr_w32_GetLastError() & 0xFFFFFFFF)
    } else if get_target_os() == 4 {
        return 38
    } else {
        if r > 0xFFFFFFFFFFFFF000 { return 0 - r }
        return 0
    }
}

// 0, or -errno (-EEXIST when it is already there). Windows ignores `mode`.
fn sys_mkdir(u64 path, u64 mode) -> int64 {
    if get_target_os() == 2 {
        if (_kr_w32_CreateDirectoryA(path, 0) & 0xFFFFFFFF) != 0 { return 0 }
        return 0 - _kr_w32_file_errno(_kr_w32_GetLastError() & 0xFFFFFFFF)
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(15)
        if nr == 0 { return 0 - 38 }
        if _kr_sys_at() != 0 { return syscall_raw(nr, 0xFFFFFFFFFFFFFF9C, path, mode, 0, 0, 0) }
        return syscall_raw(nr, path, mode, 0, 0, 0, 0)
    }
}

// 0, or -errno. Replaces an existing `to` (see the header for the guarantee).
fn sys_rename(u64 from, u64 to) -> int64 {
    if get_target_os() == 2 {
        // MOVEFILE_REPLACE_EXISTING (1) | MOVEFILE_WRITE_THROUGH (8)
        if (_kr_w32_MoveFileExA(from, to, 9) & 0xFFFFFFFF) != 0 { return 0 }
        return 0 - _kr_w32_file_errno(_kr_w32_GetLastError() & 0xFFFFFFFF)
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(16)
        if nr == 0 { return 0 - 38 }
        if _kr_sys_at() != 0 { return syscall_raw(nr, 0xFFFFFFFFFFFFFF9C, from, 0xFFFFFFFFFFFFFF9C, to, 0, 0) }
        return syscall_raw(nr, from, to, 0, 0, 0, 0)
    }
}

// 0, or -errno. Windows: 0 and does nothing (no ACL work).
fn sys_chmod(u64 path, u64 mode) -> int64 {
    if get_target_os() == 2 {
        return 0
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(17)
        if nr == 0 { return 0 - 38 }
        if _kr_sys_at() != 0 { return syscall_raw(nr, 0xFFFFFFFFFFFFFF9C, path, mode, 0, 0, 0) }
        return syscall_raw(nr, path, mode, 0, 0, 0, 0)
    }
}

// The st_mode bits, or -errno. Windows: -ENOSYS (there is no mode).
fn sys_file_mode(u64 path) -> int64 {
    if get_target_os() == 2 {
        return 0 - 38
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(18)
        if nr == 0 { return 0 - 38 }
        u8[144] st
        int64 r = 0
        u64 off = 24
        if _kr_sys_at() != 0 {
            r = syscall_raw(nr, 0xFFFFFFFFFFFFFF9C, path, st, 0, 0, 0)
            off = 16
        } else {
            r = syscall_raw(nr, path, st, 0, 0, 0, 0)
        }
        if r < 0 { return r }
        return load32(st + off)
    }
}

// --- datagrams and the timed connect (spec S3/S4) --------------------------------

fn sys_sendto(u64 sock, u64 buf, u64 len, u64 sa, u64 salen) -> int64 {
    if get_target_os() == 2 {
        int64 e = _kr_w32_ensure()
        if e < 0 { return e }
        u64 n = len
        if n > 0x7FFFFFFF { n = 0x7FFFFFFF }
        return _kr_sys_w32_send_ret(_kr_w32_sendto(sock, buf, n, 0, sa, salen))
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(11)
        if nr == 0 { return 0 - 38 }
        return syscall_raw(nr, sock, buf, len, 0x4000, sa, salen)
    }
}

// salenptr: pointer to a 32-bit in/out length (16 for an IPv4 sockaddr).
fn sys_recvfrom(u64 sock, u64 buf, u64 len, u64 sa, u64 salenptr) -> int64 {
    if get_target_os() == 2 {
        int64 e = _kr_w32_ensure()
        if e < 0 { return e }
        u64 n = len
        if n > 0x7FFFFFFF { n = 0x7FFFFFFF }
        return _kr_sys_w32_recv_ret(_kr_w32_recvfrom(sock, buf, n, 0, sa, salenptr))
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(12)
        if nr == 0 { return 0 - 38 }
        return syscall_raw(nr, sock, buf, len, 0, sa, salenptr)
    }
}

// Step 3: 1 writable, 2 exception (Linux POLLERR/POLLHUP; Windows exceptfds,
// where a failed non-blocking connect is signalled), 0 timeout, -errno.
fn _kr_sys_wait_connect(u64 sock, u64 ms) -> int64 {
    u64 t = ms
    if t > 0xFFFFFFFE { t = 0xFFFFFFFE }
    if get_target_os() == 2 {
        u8[520] wfds
        u8[520] efds
        u8[8] tv
        _kr_w32_fdset_one(wfds, sock)
        _kr_w32_fdset_one(efds, sock)
        _kr_w32_timeval(tv, t)
        int64 r = _kr_w32_ret32(_kr_w32_select(0, 0, wfds, efds, tv))
        if r < 0 { return r }
        if r == 0 { return 0 }
        if load32(efds) != 0 { return 2 }
        return 1
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(9)
        if nr == 0 { return 0 - 38 }
        u8[8] pfd
        u8[16] ts
        store32(pfd, sock)
        store16(pfd + 4, 4)
        store16(pfd + 6, 0)
        store64(ts, t / 1000)
        store64(ts + 8, (t % 1000) * 1000000)
        int64 r = syscall_raw(nr, pfd, 1, ts, 0, 8, 0)
        if r < 0 { return r }
        if r == 0 { return 0 }
        if (load16(pfd + 6) & 0x18) != 0 { return 2 }
        return 1
    }
}

// Step 4: the connect's own result. The POSITIVE Linux errno (0 = connected),
// or -errno when getsockopt itself failed.
fn _kr_sys_sock_error(u64 sock) -> int64 {
    u8[8] ev
    u8[8] evl
    store32(ev, 0)
    store32(evl, 4)
    if get_target_os() == 2 {
        int64 g = _kr_w32_ret32(_kr_w32_getsockopt(sock, 0xFFFF, 0x1007, ev, evl))
        if g < 0 { return g }
        u64 w = load32(ev)
        if w == 0 { return 0 }
        return _kr_w32_errno(w)
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(14)
        if nr == 0 { return 0 - 38 }
        int64 g = syscall_raw(nr, sock, 1, 4, ev, evl, 0)
        if g < 0 { return g }
        return load32(ev)
    }
}

// Steps 3-4 together: 0 connected, -ETIMEDOUT, or -errno. An exception with no
// recorded error is -EIO: never "connected".
fn _kr_sys_connect_outcome(u64 sock, u64 ms) -> int64 {
    int64 w = _kr_sys_wait_connect(sock, ms)
    if w < 0 { return w }
    if w == 0 { return 0 - 110 }
    int64 se = _kr_sys_sock_error(sock)
    if se < 0 { return se }
    if se != 0 { return 0 - se }
    if w == 2 { return 0 - 5 }
    return 0
}

fn sys_connect_timeout(u64 sock, u64 sa, u64 salen, u64 ms) -> int64 {
    if get_target_os() == 2 {
        int64 e = _kr_w32_ensure()
        if e < 0 { return e }
        u8[8] arg
        store32(arg, 1)
        // step 1: FIONBIO = 0x8004667E, 1 = non-blocking
        int64 r = _kr_w32_ret32(_kr_w32_ioctlsocket(sock, 0x8004667E, arg))
        if r < 0 { return r }
        // step 2: WSAEWOULDBLOCK reads -EAGAIN through the map; -EINPROGRESS too
        r = _kr_w32_ret32(_kr_w32_connect(sock, sa, salen))
        if r == 0 - 11 || r == 0 - 115 { r = _kr_sys_connect_outcome(sock, ms) }
        // step 5: blocking again, on every path
        store32(arg, 0)
        int64 rr = _kr_w32_ret32(_kr_w32_ioctlsocket(sock, 0x8004667E, arg))
        if rr < 0 { return rr }
        return r
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 fnr = _kr_sys_nr(13)
        u64 cnr = _kr_sys_nr(1)
        if fnr == 0 { return 0 - 38 }
        // step 1: F_GETFL (3), then F_SETFL (4) with O_NONBLOCK (0x800, both arches)
        int64 fl = syscall_raw(fnr, sock, 3, 0, 0, 0, 0)
        if fl < 0 { return fl }
        int64 r = syscall_raw(fnr, sock, 4, fl | 0x800, 0, 0, 0)
        if r < 0 { return r }
        // step 2: -EINPROGRESS (115) is in progress; -EAGAIN is accepted too
        r = syscall_raw(cnr, sock, sa, salen, 0, 0, 0)
        if r == 0 - 115 || r == 0 - 11 { r = _kr_sys_connect_outcome(sock, ms) }
        // step 5: the remembered flags, on every path
        int64 rr = syscall_raw(fnr, sock, 4, fl, 0, 0, 0)
        if rr < 0 { return rr }
        return r
    }
}

// --- network interfaces (see the header) -----------------------------------------

fn sys_ioctl(u64 fd, u64 req, u64 arg) -> int64 {
    if get_target_os() == 2 {
        return 0 - 38
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(19)
        if nr == 0 { return 0 - 38 }
        return syscall_raw(nr, fd, req, arg, 0, 0, 0)
    }
}

fn _kr_sys_ifrec(u64 out, u64 i, u64 addr, u64 mask, u64 bcast, u64 flags) {
    u64 p = out + i * 16
    store32(p, addr)
    store32(p + 4, mask)
    store32(p + 8, bcast)
    store32(p + 12, flags)
}

// The directed broadcast of addr/mask, in the same (network) byte order.
fn _kr_sys_bcast_of(u64 addr, u64 mask) -> u64 {
    return (addr & mask) | (mask ^ 0xFFFFFFFF)
}

// The number of one bits in the low 32 bits of m (byte-order independent).
fn _kr_sys_ones32(u64 m) -> u64 {
    u64 v = m & 0xFFFFFFFF
    u64 n = 0
    while v != 0 { n = n + (v & 1)  v = v >> 1 }
    return n
}

// Windows: INTERFACE_INFO at `ie` -> record k of `out` (see the header: flags
// bits 0..2 only; the broadcast computed, and none for /31 and /32).
fn _kr_sys_w32_ifrec(u64 ie, u64 out, u64 k) {
    u64 f = load32(ie) & 7
    u64 a = load32(ie + 8)
    u64 m = load32(ie + 56)
    u64 b = 0
    if (f & 2) != 0 {
        if _kr_sys_ones32(m) >= 31 { f = f & 5 } else { b = _kr_sys_bcast_of(a, m) }
    }
    _kr_sys_ifrec(out, k, a, m, b, f)
}

// Linux: one SIOCGIF* query about the SIOCGIFCONF entry `e`, answered in rq.
fn _kr_sys_ifq(u64 s, u64 req, u64 e, u64 rq) -> int64 {
    u64 j = 0
    while j < 40 { store8(rq + j, load8(e + j))  j = j + 1 }
    return sys_ioctl(s, req, rq)
}

fn sys_net_ifaces(u64 out, u64 max) -> int64 {
    if get_target_os() == 2 {
        int64 e = _kr_w32_ensure()
        if e < 0 { return e }
        int64 s = _kr_w32_sock(_kr_w32_socket(2, 2, 0))
        if s < 0 { return s }
        u8[4864] buf
        u8[8] nb
        store32(nb, 0)
        // 64 x INTERFACE_INFO (76 bytes). The result is read BEFORE the close,
        // which would overwrite WSAGetLastError.
        int64 r = _kr_w32_ret32(_kr_w32_WSAIoctl(s, 0x4004747F, 0, 0, buf, 4864, nb, 0, 0))
        _kr_w32_closesocket(s)
        if r < 0 { return r }
        u64 n = load32(nb) / 76
        u64 k = 0
        u64 i = 0
        while i < n && k < max {
            _kr_sys_w32_ifrec(buf + i * 76, out, k)
            k = k + 1
            i = i + 1
        }
        return k
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        if _kr_sys_nr(19) == 0 { return 0 - 38 }
        int64 s = sys_socket(2, 2, 0)
        if s < 0 { return s }
        u8[2560] buf
        u8[16] ifc
        u8[40] rq
        // struct ifconf: int ifc_len, 4 bytes of padding, char *ifc_buf.
        store32(ifc, 2560)
        store32(ifc + 4, 0)
        store64(ifc + 8, buf)
        int64 r = sys_ioctl(s, 0x8912, ifc)
        if r < 0 {
            sys_sock_close(s)
            return r
        }
        u64 n = load32(ifc) / 40
        u64 k = 0
        u64 i = 0
        while i < n && k < max {
            u64 ie = buf + i * 40
            if load16(ie + 16) == 2 {
                u64 a = load32(ie + 20)
                int64 q = _kr_sys_ifq(s, 0x8913, ie, rq)
                u64 lf = load16(rq + 16)
                u64 m = 0
                u64 b = 0
                if q >= 0 {
                    q = _kr_sys_ifq(s, 0x891B, ie, rq)
                    m = load32(rq + 20)
                }
                // Linux IFF_UP 0x1, IFF_BROADCAST 0x2, IFF_LOOPBACK 0x8.
                u64 f = lf & 3
                if (lf & 8) != 0 { f = f | 4 }
                if q >= 0 && (f & 2) != 0 {
                    q = _kr_sys_ifq(s, 0x8919, ie, rq)
                    b = load32(rq + 20)
                }
                if q >= 0 {
                    _kr_sys_ifrec(out, k, a, m, b, f)
                    k = k + 1
                } else if q != 0 - 19 && q != 0 - 99 {
                    sys_sock_close(s)
                    return q
                }
            }
            i = i + 1
        }
        sys_sock_close(s)
        return k
    }
}

// --- stdio, exit, time (builtins; the compiler maps them per OS) ---------------

fn sys_write(u64 fd, u64 buf, u64 len) -> int64 {
    return file_write(fd, buf, len)
}

fn sys_read(u64 fd, u64 buf, u64 len) -> int64 {
    return file_read(fd, buf, len)
}

fn sys_exit(u64 code) {
    exit(code)
}

fn sys_time_ns() -> u64 {
    return time_ns()
}
