// KernRift Standard Library -- Portable system layer
//
// sys_*: sockets, readiness wait, entropy, stdio, exit, time. One API, three
// OS families (spec C2/C3):
//   - Unix (Linux, Android, macOS): raw syscalls, numbers per (arch, os);
//   - Windows: the `_kr_w32_` externs of win32.kr (Winsock 2.2, started on the
//     first socket call; WSAGetLastError mapped to the same Linux errno values;
//     setsockopt takes Linux option numbers and is translated -- see
//     _kr_sys_w32_setsockopt for the supported set);
//   - ApexRift none (os 4): no sockets or entropy yet -- -ENOSYS.
//
// Contract: socket/fd results are >= 0 or -errno; byte counts; 0 is EOF.
// Every OS split below is the CANONICAL LITERAL CHAIN
//     if get_target_os() == 2 { windows } else if get_target_os() == 4 { none } else { unix }
// -- the compiler prunes the arms that cannot run on the target, so a Windows
// build never sees a syscall_raw and a Linux build never sees a Win32 extern.
// get_arch_id() is used only inside the Unix arm, to pick the numbers.
//
// macOS (arch 5/6) returns -ENOSYS for sockets, readiness wait and entropy:
// it is unproven in v1 and has no ppoll/getrandom, and Linux numbers must never
// be inherited there. Arch ids 9..12 (bare metal) get -ENOSYS the same way.
//
// Private helpers carry the `_kr_` prefix. This file does not import args.kr
// (see args.kr: importing sys.kr must not introduce cli_argc / cli_argv).

import "win32.kr"

// Syscall number for operation `k` on this (arch, os), 0 when there is none.
//   0 socket  1 connect  2 bind  3 listen  4 accept  5 getsockname
//   6 shutdown  7 setsockopt  8 close  9 ppoll  10 getrandom
// Linux and Android share a table per architecture (1/8 = x86_64, 2/7 = arm64).
fn _kr_sys_nr(u64 k) -> u64 {
    u64 a = get_arch_id()
    if a == 1 || a == 8 {
        if k == 0 { return 41 }
        if k == 1 { return 42 }
        if k == 2 { return 49 }
        if k == 3 { return 50 }
        if k == 4 { return 43 }
        if k == 5 { return 51 }
        if k == 6 { return 48 }
        if k == 7 { return 54 }
        if k == 8 { return 3 }
        if k == 9 { return 271 }
        if k == 10 { return 318 }
        return 0
    }
    if a == 2 || a == 7 {
        if k == 0 { return 198 }
        if k == 1 { return 203 }
        if k == 2 { return 200 }
        if k == 3 { return 201 }
        if k == 4 { return 202 }
        if k == 5 { return 204 }
        if k == 6 { return 210 }
        if k == 7 { return 208 }
        if k == 8 { return 57 }
        if k == 9 { return 73 }
        if k == 10 { return 278 }
        return 0
    }
    return 0
}

// --- Windows helpers (called only from the os==2 arms) -------------------------

// send/recv result: a count, or -errno. A receive (or send) timeout set with
// SO_RCVTIMEO / SO_SNDTIMEO fails on Windows with WSAETIMEDOUT and on Linux with
// EAGAIN; the Linux reading is the contract, so WSAETIMEDOUT -> -EAGAIN HERE
// (connect keeps -ETIMEDOUT). Irreducible: a keepalive failure also surfaces as
// WSAETIMEDOUT on a recv, where Linux says ETIMEDOUT -- it reads -EAGAIN too.
fn _kr_sys_w32_io(u64 r) -> int64 {
    if (r & 0xFFFFFFFF) != 0xFFFFFFFF { return r & 0xFFFFFFFF }
    u64 w = _kr_w32_WSAGetLastError() & 0xFFFFFFFF
    if w == 10060 { return 0 - 11 }
    return 0 - _kr_w32_errno(w)
}

// setsockopt with LINUX option numbers and value shapes (the sys_* contract),
// translated to Windows'. Supported in v1 -- what KernRift and ApexRift use:
//   SOL_SOCKET(1) SO_REUSEADDR(2): Linux's meaning (rebind past TIME_WAIT) is
//     Windows' DEFAULT; Windows' own SO_REUSEADDR means something else -- it
//     lets a second socket bind a port that is in use, even listening (port
//     stealing). So the option is accepted, its int length checked, and it is
//     applied as SO_REUSEADDR = 0 (which also checks the handle), never as 1.
//   SOL_SOCKET(1) SO_RCVTIMEO(20): Linux takes a 16-byte timeval, Windows a
//     DWORD of milliseconds (SO_RCVTIMEO 0x1006); converted, rounding up.
//     optlen < 16 -> -EINVAL and tv_usec >= 1000000 -> -EDOM, as on Linux.
// Every other (level, option) -> -ENOPROTOOPT: refused loudly rather than
// passed through, because Windows numbers the same options differently
// (0x1001 is Windows' SO_SNDBUF) and the value shapes differ too.
fn _kr_sys_w32_setsockopt(u64 sock, u64 level, u64 name, u64 val, u64 len) -> int64 {
    u8[8] v
    if level != 1 { return 0 - 92 }
    if name == 2 {
        if len < 4 { return 0 - 22 }
        store32(v, 0)
        return _kr_w32_ret32(_kr_w32_setsockopt(sock, 0xFFFF, 4, v, 4))
    }
    if name == 20 {
        if len < 16 { return 0 - 22 }
        if load64(val + 8) >= 1000000 { return 0 - 33 }
        store32(v, _kr_w32_ms_of_timeval(val))
        return _kr_w32_ret32(_kr_w32_setsockopt(sock, 0xFFFF, 0x1006, v, 4))
    }
    return 0 - 92
}

// --- sockets -------------------------------------------------------------------

fn sys_socket(u64 domain, u64 stype, u64 proto) -> int64 {
    if get_target_os() == 2 {
        int64 e = _kr_w32_ensure()
        if e < 0 { return e }
        return _kr_w32_sock(_kr_w32_socket(domain, stype, proto))
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(0)
        if nr == 0 { return 0 - 38 }
        return syscall_raw(nr, domain, stype, proto, 0, 0, 0)
    }
}

fn sys_connect(u64 sock, u64 sa, u64 len) -> int64 {
    if get_target_os() == 2 {
        int64 e = _kr_w32_ensure()
        if e < 0 { return e }
        return _kr_w32_ret32(_kr_w32_connect(sock, sa, len))
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(1)
        if nr == 0 { return 0 - 38 }
        return syscall_raw(nr, sock, sa, len, 0, 0, 0)
    }
}

fn sys_bind(u64 sock, u64 sa, u64 len) -> int64 {
    if get_target_os() == 2 {
        int64 e = _kr_w32_ensure()
        if e < 0 { return e }
        return _kr_w32_ret32(_kr_w32_bind(sock, sa, len))
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
        u64 nr = _kr_sys_nr(2)
        if nr == 0 { return 0 - 38 }
        return syscall_raw(nr, sock, sa, len, 0, 0, 0)
    }
}

fn sys_listen(u64 sock, u64 backlog) -> int64 {
    if get_target_os() == 2 {
        int64 e = _kr_w32_ensure()
        if e < 0 { return e }
        return _kr_w32_ret32(_kr_w32_listen(sock, backlog))
    } else if get_target_os() == 4 {
        return 0 - 38
    } else {
