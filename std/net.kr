// KernRift Standard Library — Network Operations
//
// TCP/UDP sockets on every hosted OS. Every socket function DELEGATES to the
// portable layer in sys.kr (spec C5) -- one implementation, so the per-OS
// numbers and the Windows translation live in one place:
//   - Linux / Android: raw syscalls (sys.kr's per-arch table);
//   - Windows: Winsock through win32.kr's `_kr_w32_` externs (no Win32 name
//     is injected into the importer: a program's own `send` or `select` still
//     compiles and is still its own);
//   - macOS: -ENOSYS (38) in v1 -- unproven, and Linux numbers must never be
//     inherited there (the old net.kr called them, silently wrong);
//   - ApexRift none (os 4): -ENOSYS (38) at run time.
// Results are sys.kr's: a socket or count >= 0, or -errno (as a u64 here).
// net_send is sys_send: on Linux sendto(MSG_NOSIGNAL), so a send to a closed
// peer returns -EPIPE (-32) instead of killing the process with SIGPIPE, and a
// non-socket fd (a pipe) is still written to. net_recv is sys_recv: read(2)
// on Unix, recv() on Windows.

import "sys.kr"

// --- sockets ---

// Create a socket. domain: 2=AF_INET. type: 1=SOCK_STREAM, 2=SOCK_DGRAM
fn net_socket(u64 domain, u64 sock_type, u64 protocol) -> u64 {
    return sys_socket(domain, sock_type, protocol)
}

// Bind socket to address
fn net_bind(u64 fd, u64 addr, u64 addr_len) -> u64 {
    return sys_bind(fd, addr, addr_len)
}

// Listen for connections
fn net_listen(u64 fd, u64 backlog) -> u64 {
    return sys_listen(fd, backlog)
}

// Accept connection (returns new fd)
fn net_accept(u64 fd) -> u64 {
    return sys_accept(fd)
}

// Connect to address
fn net_connect(u64 fd, u64 addr, u64 addr_len) -> u64 {
    return sys_connect(fd, addr, addr_len)
}

// Send data (returns bytes sent)
fn net_send(u64 fd, u64 buf, u64 len) -> u64 {
    return sys_send(fd, buf, len)
}

// Receive data (returns bytes received)
fn net_recv(u64 fd, u64 buf, u64 len) -> u64 {
    return sys_recv(fd, buf, len)
}

// Close socket
fn net_close(u64 fd) {
    sys_sock_close(fd)
}

// Set socket option (Linux option numbers; see sys_setsockopt for the subset
// Windows translates)
fn net_setsockopt(u64 fd, u64 level, u64 optname, u64 optval, u64 optlen) -> u64 {
    return sys_setsockopt(fd, level, optname, optval, optlen)
}

// --- address helpers ---

// Convert port to network byte order (big-endian, 16-bit)
fn net_htons(u64 port) -> u64 {
    u64 lo = port & 255
    u64 hi = (port >> 8) & 255
    return (lo << 8) | hi
}

// Host to network byte order, 32-bit. Needed for sin_addr: a packed IP
// literal like 0x7F000001 (127.0.0.1) reads left-to-right in host order and
// must be byte-reversed before it goes on the wire.
// Note the parenthesisation: in KernRift `|` binds TIGHTER than `<<`, so
// `b0 << 24 | b1 << 16` would parse as `b0 << (24 | b1) << 16`.
fn net_htonl(u64 ip) -> u64 {
    u64 b0 = ip & 255
    u64 b1 = (ip >> 8) & 255
    u64 b2 = (ip >> 16) & 255
    u64 b3 = (ip >> 24) & 255
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

// Build sockaddr_in for IPv4.
// ip: 4 bytes packed in host order (e.g., 0x7F000001 = 127.0.0.1)
// port: port number in host byte order
// Returns pointer to 16-byte sockaddr_in (caller must dealloc with net_addr_free)
fn net_addr_ipv4(u64 ip, u64 port) -> u64 {
    u64 addr = alloc(16)
    // Zero the whole struct
    memset(addr, 0, 16)
    // sin_family = AF_INET (2) at offset 0 as u16
    u16 family = 2
    store16(addr, family)
    // sin_port at offset 2 as u16 (network byte order)
    u64 nport = net_htons(port)
    u16 p16 = nport
    u64 port_ptr = addr + 2
    store16(port_ptr, p16)
    // sin_addr at offset 4 as u32, converted from the host-order argument this
    // function documents. It previously stored `ip` raw, which contradicted
    // both the header comment above and STDLIB.md, and made the documented
    // 0x7F000001 resolve to 1.0.0.127 -- while the port two bytes earlier WAS
    // converted, so one struct carried one field in each byte order.
    u64 nip = net_htonl(ip)
    u32 ip32 = nip
    u64 ip_ptr = addr + 4
    store32(ip_ptr, ip32)
    return addr
}

// Free a sockaddr allocated by net_addr_ipv4
fn net_addr_free(u64 addr) {
    dealloc(addr)
}
