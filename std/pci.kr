// KernRift Standard Library — PCI configuration space (x86_64)
//
// A FACADE. The contents of this file moved out in two directions when arm64
// needed PCI:
//
//     std/pci_port.kr   the 0xCF8/0xCFC transport      (x86_64 only)
//     std/pci_core.kr   enumeration, BAR decoding, identity -- no transport
//
// Importing this file gets you both, so every existing x86 caller is unchanged
// and the usage below still holds. An arm64 caller imports std/pci_ecam.kr and
// std/pci_core.kr instead, and calls pci_ecam_init(base, size) once with the
// window read from the device tree.
//
// FREESTANDING-SAFE: port I/O only, no allocation.
//
// x86_64 only, because std/pci_port.kr is. Importing THIS file from an arm64
// build links (unreferenced x86 functions are dropped) but any config access
// reaches `outl` and fails to assemble -- import the ECAM pair instead.
//
//     import "std/pci.kr"
//     u64 bdf = pci_find_device(0x8086, 0x100E)     // an e1000
//     if bdf != PCI_NOT_FOUND {
//         u64 bar0 = pci_bar(pci_bdf_bus(bdf), pci_bdf_dev(bdf),
//                            pci_bdf_fn(bdf), 0)
//     }

import "pci_port.kr"
import "pci_core.kr"
