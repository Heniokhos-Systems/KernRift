// KernRift Standard Library — PCI configuration space over legacy port I/O
//
// The x86 transport for std/pci_core.kr: the 0xCF8 address / 0xCFC data pair
// that every PC-compatible chipset implements, needing no ACPI tables, no
// interrupts and no allocation.
//
// Same six `pci_config_*` names as std/pci_ecam.kr, so a caller switches
// transports by switching the import -- the same split as std/fw_cfg.kr vs
// std/fw_cfg_mmio.kr, and std/uart_16550.kr vs std/uart_pl011.kr.
//
// FREESTANDING-SAFE: port I/O only, no allocation.
//
// x86_64 ONLY, and that is enforced by the assembler rather than by
// convention: an arm64 build that REACHES `outl` fails with "unrecognized asm
// instruction out dx, eax". An arm64 build that merely imports this module
// links fine, because unreferenced functions are dropped -- which is why the
// facade in std/pci.kr must not be the arm64 entry point. Measured with krc
// --arch=arm64, not assumed.
//
// Do not import this directly on x86: import std/pci.kr, which pairs this with
// std/pci_core.kr.

import "x86.kr"

// The two ports. Writing an address word to 0xCF8 selects a dword of some
// device's 256-byte configuration space; 0xCFC then reads or writes it.
const u64 PCI_CONFIG_ADDRESS = 0xCF8
const u64 PCI_CONFIG_DATA    = 0xCFC

// --- address word -------------------------------------------------------------

// The 0xCF8 selector: enable bit, bus, device, function, dword offset.
//
// WRITE IT EXACTLY LIKE THIS. In KernRift `&`, `|` and `^` bind TIGHTER than
// `+` and `<<` (the reverse of C), so the C spelling
// `0x80000000 | bus << 16 | dev << 11 | fn << 8 | off & 0xFC` parses as
// `0x80000000 | bus` shifted and masked into oblivion -- measured, it
// evaluates to 0x0 and every read returns the host bridge. With the shifts
// parenthesised, (0,3,0,0) -> 0x80001800 and (0,1,3,0x2C) -> 0x80000B2C.
//
// The low two bits of `off` are cleared because the mechanism is dword-based;
// sub-dword reads put them back on the DATA port instead (below).
fn pci_config_addr(u64 bus, u64 dev, u64 func, u64 off) -> u64 {
    return 0x80000000 | (bus << 16) | (dev << 11) | (func << 8) | (off & 0xFC)
}

// --- transport contract ---------------------------------------------------------

// How many buses this transport can reach. The port mechanism encodes 8 bits
// of bus number and returns all-ones for an absent device anywhere in that
// range, so the full 256 are safe to probe. std/pci_ecam.kr cannot say the
// same, which is the entire reason this function exists.
fn pci_bus_count() -> u64 { return 256 }

// --- configuration reads and writes -------------------------------------------

fn pci_config_read32(u64 bus, u64 dev, u64 func, u64 off) -> u64 {
    outl(PCI_CONFIG_ADDRESS, pci_config_addr(bus, dev, func, off))
    return inl(PCI_CONFIG_DATA) & 0xFFFFFFFF
}

// A 16-bit field is read from the DATA port OFFSET BY the low address bits --
// 0xCFC for the low half of the dword, 0xCFE for the high half. Reading the
// aligned dword and returning its low 16 bits instead would report the vendor
// ID for every even offset, so `pci_device_id` (offset 2) would come back as
// the vendor.
fn pci_config_read16(u64 bus, u64 dev, u64 func, u64 off) -> u64 {
    outl(PCI_CONFIG_ADDRESS, pci_config_addr(bus, dev, func, off))
    return inw(PCI_CONFIG_DATA + (off & 3)) & 0xFFFF
}

fn pci_config_read8(u64 bus, u64 dev, u64 func, u64 off) -> u64 {
    outl(PCI_CONFIG_ADDRESS, pci_config_addr(bus, dev, func, off))
    return inb(PCI_CONFIG_DATA + (off & 3)) & 0xFF
}

fn pci_config_write32(u64 bus, u64 dev, u64 func, u64 off, u64 val) {
    outl(PCI_CONFIG_ADDRESS, pci_config_addr(bus, dev, func, off))
    outl(PCI_CONFIG_DATA, val & 0xFFFFFFFF)
}

fn pci_config_write16(u64 bus, u64 dev, u64 func, u64 off, u64 val) {
    outl(PCI_CONFIG_ADDRESS, pci_config_addr(bus, dev, func, off))
    outw(PCI_CONFIG_DATA + (off & 3), val & 0xFFFF)
}

fn pci_config_write8(u64 bus, u64 dev, u64 func, u64 off, u64 val) {
    outl(PCI_CONFIG_ADDRESS, pci_config_addr(bus, dev, func, off))
    outb(PCI_CONFIG_DATA + (off & 3), val & 0xFF)
}
